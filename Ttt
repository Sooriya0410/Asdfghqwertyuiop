        resp = self.client.session(0x03)
        self.assertEqual(resp[:2], b"\x50\x03")
        self.assertEqual(self._frames(0x7E0)[0], bytes.fromhex("021003CCCCCCCCCC"))
        self.assertTrue(all(len(f) == 8 for f in self._frames(0x7E8)))

