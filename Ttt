class DiagClient:
    def __init__(self, transport: DiagTransport, protocol: str = "UDS",
                 log: Optional[Callable[..., None]] = None):
        self.transport = transport
        self.protocol = "KWP2000" if protocol.upper().startswith("KWP") else "UDS"
        self._log_cb = log

    def _log(self, text: str, level: str = "INFO") -> None:
        if self._log_cb:
            self._log_cb(text, level)

    def request(self, payload: bytes, expect_response: Optional[bool] = None) -> Optional[bytes]:
        payload = bytes(payload)
        if not payload:
            raise ValueError("Empty request")
        if expect_response is None:
            expect_response = not is_suppressed_request(payload)
        self._log(f"TX  {hexs(payload)}   ({service_name(payload[0])})")
        t0 = time.monotonic()
        try:
            resp = self.transport.request(payload, expect_response=expect_response)
        except DiagError as exc:
            self._log(f"ERR {exc}", "ERROR")
            raise
        dt = (time.monotonic() - t0) * 1000.0
        if resp is None:
            self._log("    (positive response suppressed)")
            return None
        self._log(f"RX  {hexs(resp)}   [{dt:.0f} ms]")
        if len(resp) >= 3 and resp[0] == 0x7F:
            exc = NegativeResponse(resp[1], resp[2])
            self._log(f"NRC {exc}", "WARN")
            raise exc
        if resp[0] != ((payload[0] + 0x40) & 0xFF):
            raise DiagError(f"Unexpected response SID 0x{resp[0]:02X} for request 0x{payload[0]:02X}")
        return resp

    def session(self, sub: int) -> Optional[bytes]:
        return self.request(bytes([0x10, sub & 0xFF]))

    def ecu_reset(self, sub: int = 0x01) -> Optional[bytes]:
        return self.request(bytes([0x11, sub & 0xFF]))

    def dtc_setting(self, on: bool) -> Optional[bytes]:
        return self.request(bytes([0x85, 0x01 if on else 0x02]))

    def tester_present(self, payload: bytes, functional: bool = False) -> None:
        self.transport.send_only(bytes(payload), functional=functional)

    def read_dtc_count(self, mask: int) -> Tuple[int, int, int]:
        return parse_uds_dtc_count(self.request(bytes([0x19, 0x01, mask & 0xFF])) or b"")

    def read_dtcs(self, mask: int) -> Tuple[int, List[DtcRecord], int]:
        return parse_uds_dtc_list(self.request(bytes([0x19, 0x02, mask & 0xFF])) or b"")

    def read_supported_dtcs(self) -> Tuple[int, List[DtcRecord], int]:
        return parse_uds_dtc_list(self.request(b"\x19\x0A") or b"")

    def read_snapshot(self, dtc: int, record: int = 0xFF) -> bytes:
        return self.request(bytes([0x19, 0x04]) + dtc.to_bytes(3, "big") + bytes([record])) or b""

    def read_extended_data(self, dtc: int, record: int = 0xFF) -> bytes:
        return self.request(bytes([0x19, 0x06]) + dtc.to_bytes(3, "big") + bytes([record])) or b""

    def clear_dtcs(self, group: Optional[int] = None) -> Optional[bytes]:
        if self.protocol == "KWP2000":
            g = 0xFF00 if group is None else group
            return self.request(bytes([0x14]) + g.to_bytes(2, "big"))
        g = 0xFFFFFF if group is None else group
        return self.request(bytes([0x14]) + g.to_bytes(3, "big"))

    def kwp_read_dtcs(self, status: int = 0x02, group: int = 0xFF00) -> Tuple[int, List[DtcRecord]]:
        return parse_kwp_dtc_list(self.request(bytes([0x18, status & 0xFF]) + group.to_bytes(2, "big")) or b"")


class TesterPresentThread(threading.Thread):
    def __init__(self, client: DiagClient, payload: bytes, period_s: float, functional: bool = False,
                 log: Optional[Callable[..., None]] = None):
        super().__init__(name="TesterPresent", daemon=True)
        if period_s < 0.05:
            raise ValueError("Tester present period must be >= 50 ms")
        if not payload:
            raise ValueError("Tester present payload is empty")
        self.client = client
        self.payload = bytes(payload)
        self.period_s = period_s
        self.functional = functional
        self._log_cb = log
        self.sent = 0
        self._stop_evt = threading.Event()

    def start(self) -> "TesterPresentThread":  # type: ignore[override]
        super().start()
        return self

    def _log(self, text: str, level: str = "INFO") -> None:
        if self._log_cb:
            self._log_cb(text, level)

    def run(self) -> None:
        failing = False
        while not self._stop_evt.wait(self.period_s):
            try:
                self.client.tester_present(self.payload, self.functional)
                self.sent += 1
                if failing:
                    failing = False
                    self._log("Tester present recovered")
            except Exception as exc:
                if not failing:
                    failing = True
                    self._log(f"Tester present failed: {exc}", "WARN")

    def stop(self) -> None:
        self._stop_evt.set()


