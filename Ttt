def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(description=f"{APP_NAME} v{APP_VERSION}")
    ap.add_argument("--selftest", action="store_true", help="run the built-in test suite and exit")
    ap.add_argument("--selftest-gui", action="store_true", help="also run a GUI smoke test (needs a display)")
    ap.add_argument("-v", "--verbose", action="store_true", help="verbose test output")
    args = ap.parse_args(argv)
    if args.selftest or args.selftest_gui:
        return run_selftests(verbosity=2 if args.verbose else 1, gui=args.selftest_gui)
    if tk is None:
        print("tkinter is not available in this Python installation")
        return 2
    if sys.platform == "win32":
        try:
            import ctypes
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except Exception:
            pass
    app = ControlPanelApp()
    app.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())

