        path, n = self.monitor.stop_logging()
        if path:
            self.events.log("CAN", f"Recording stopped: {n} frames in {path}")
            self.lbl_log.config(text=f"Last recording: {path} ({n} frames)", foreground=GREY)

    def _mon_clear(self) -> None:
        self.monitor.clear()
        self.tv_mon.delete(*self.tv_mon.get_children())
        self._mon_keys.clear()
        self._clear_text(self.txt_trace)
        self._last_total = 0

    def _trace_filter(self) -> Optional[set]:
        text = self.s("mon_filter")
        if not text:
            return None
        try:
            return {parse_hex_int(t) for t in re.split(r"[\s,;]+", text) if t}
        except ValueError:
            return None

    def _refresh_monitor(self) -> None:
        try:
            self._refresh_monitor_once()
        except Exception as exc:
            self.events.log("APP", f"Monitor refresh error: {exc}", "ERROR")
        finally:
            self.after(500, self._refresh_monitor)

    def _refresh_monitor_once(self) -> None:
        tv = self.tv_mon
        for st in self.monitor.snapshot():
            key = (channel_label(st.channel), st.extended, st.arb_id)
            iid = f"{key[0]}|{int(key[1])}|{key[2]}"
            vals = (key[0], format_can_id(st.arb_id, st.extended), st.direction, st.dlc, hexs(st.data),
                    st.count, f"{st.cycle_ms:.1f}" if st.count > 1 else "")
            if tv.exists(iid):
                tv.item(iid, values=vals)
            else:
                idx = bisect.bisect(self._mon_keys, key)
                self._mon_keys.insert(idx, key)
                tv.insert("", idx, iid=iid, values=vals)
        entries = self.monitor.drain_trace(600)
        if entries and not self.b("mon_pause"):
            flt = self._trace_filter()
            lines = [format_trace_entry(e, self.monitor.t0) for e in entries if flt is None or e[2] in flt]
            self._append(self.txt_trace, lines, max_lines=3000)
        now = time.monotonic()
        total = self.monitor.total
        rate = max(0.0, (total - self._last_total) / max(1e-3, now - self._last_rate_t))
        self._last_total, self._last_rate_t = total, now
        self.periodic = [p for p in self.periodic if p.is_alive()]
        rec = ""
        if self.monitor.is_logging:
            rec = f"   |   recording: {self.monitor.logged} frames"
            self.lbl_log.config(text=f"Recording -> {self.monitor.log_path}   ({self.monitor.logged} frames)")
        self.lbl_mon.config(text=f"Frames: {total}   Rate: {rate:.0f}/s   Error frames: {self.monitor.error_frames}   "
                                 f"IDs: {len(self._mon_keys)}   Cyclic TX: {len(self.periodic)}{rec}")
        if self.bus.is_open:
            names = ", ".join(channel_label(c) for c in self.bus.channels)
            self.lbl_st_bus.config(text=f"Bus: {names}  {rate:.0f} fr/s{'  REC' if self.monitor.is_logging else ''}",
                                   foreground=GREEN)

    def _tx_channel(self, text: str) -> Any:
        if self.bus.interface == "vector":
            idx = int(text) - 1
            if idx not in self.bus.channels:
                opened = ", ".join(channel_label(c) for c in self.bus.channels)
                raise ValueError(f"CAN{idx + 1} is not open (open: {opened})")
            return idx
        return None

    def _tx_build(self) -> Any:
        if not self.bus.is_open:
            raise RuntimeError("Open the bus first")
        ext, fd = self.b("tx_ext"), self.b("tx_fd")
        arb = parse_hex_int(self.s("tx_id"), 29 if ext else 11)
        data = parse_hex_bytes(self.s("tx_data"))
        if not fd and len(data) > 8:
            raise ValueError("Classic CAN carries at most 8 data bytes (enable FD for more)")
        if fd:
            data += b"\x00" * (fd_length_ceil(len(data)) - len(data))
        return self.bus.make_message(arbitration_id=arb, is_extended_id=ext, data=data, is_fd=fd,
                                     bitrate_switch=fd and self.b("tx_brs"), channel=self._tx_channel(self.s("tx_ch")))

    def _tx_once(self) -> None:
        try:
            msg = self._tx_build()
            self.bus.send(msg)
        except Exception as exc:
            self.events.log("CAN", f"Send failed: {exc}", "ERROR")
            return
        self.events.log("CAN", f"TX {channel_label(msg.channel)} {format_can_id(msg.arbitration_id, msg.is_extended_id)} "
                               f"[{len(msg.data)}] {hexs(msg.data)}")

    def _tx_cyclic(self) -> None:
        try:
            msg = self._tx_build()
            period = self.fnum("tx_period", "Cycle time") / 1000.0
            sender = PeriodicSender(self.bus, msg, period,
                                    on_error=lambda e: self.events.log("CAN", f"Cyclic TX stopped: {e}", "ERROR"))
        except Exception as exc:
            self.events.log("CAN", f"Cyclic send failed: {exc}", "ERROR")
            return
        sender.start()
        self.periodic.append(sender)
        self.events.log("CAN", f"Cyclic TX {format_can_id(msg.arbitration_id, msg.is_extended_id)} every "
                               f"{period * 1000:g} ms started")

    def _tx_stop_all(self, quiet: bool = False) -> None:
        n = len(self.periodic)
        for p in self.periodic:
            p.stop()
        self.periodic.clear()
        if n and not quiet:
            self.events.log("CAN", f"{n} cyclic transmission(s) stopped")

