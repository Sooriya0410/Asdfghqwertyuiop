    def test_tcp_transport(self):
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.bind(("127.0.0.1", 0))
        srv.listen(1)
        port = srv.getsockname()[1]
        received: List[str] = []

        def serve() -> None:
            conn, _ = srv.accept()
            buf = b""
            with conn:
                while True:
                    chunk = conn.recv(1024)
                    if not chunk:
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        cmd = line.decode().strip()
                        received.append(cmd)
                        if cmd.endswith("?"):
                            conn.sendall(b"13.480\r\n")
        th = threading.Thread(target=serve, daemon=True)
        th.start()
        psu = Rs52Psu(TcpPsuTransport("127.0.0.1", port, timeout=1.0),
                      PsuConfig(cmd_meas_voltage="MEAS:VOLT?", inter_cmd_delay=0))
        psu.connect()
        psu.set_voltage(13.5)
        psu.output(True)
        self.assertEqual(psu.measure()[0], 13.48)
        psu.disconnect(output_off=True)
        th.join(2)
        srv.close()
        self.assertEqual(received, ["SO:VO 13.50", "OUTP 1", "MEAS:VOLT?", "OUTP 0"])


