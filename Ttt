class SimpleFrame:
    """Minimal stand-in for can.Message (tests / loopback hub)."""

    __slots__ = ("arbitration_id", "is_extended_id", "data", "is_fd", "bitrate_switch", "channel",
                 "is_rx", "is_error_frame", "is_remote_frame", "timestamp", "dlc")

    def __init__(self, arbitration_id: int = 0, is_extended_id: bool = False, data: Iterable[int] = b"",
                 is_fd: bool = False, bitrate_switch: bool = False, channel: Any = None, is_rx: bool = True,
                 is_error_frame: bool = False, is_remote_frame: bool = False,
                 timestamp: Optional[float] = None):
        self.arbitration_id = arbitration_id
        self.is_extended_id = is_extended_id
        self.data = bytearray(data)
        self.dlc = len(self.data)
        self.is_fd = is_fd
        self.bitrate_switch = bitrate_switch
        self.channel = channel
        self.is_rx = is_rx
        self.is_error_frame = is_error_frame
        self.is_remote_frame = is_remote_frame
        self.timestamp = time.time() if timestamp is None else timestamp


class LoopbackHub:
    """In-memory bus with the BusManager API; every frame goes to every subscriber."""

    def __init__(self):
        self._subs: List[Callable[[Any], None]] = []
        self._lock = threading.Lock()
        self.sent: List[SimpleFrame] = []
        self.is_open = True
        self.interface = "loopback"
        self.channels: List[Any] = [None]

    def subscribe(self, cb: Callable[[Any], None]) -> None:
        with self._lock:
            self._subs.append(cb)

    def unsubscribe(self, cb: Callable[[Any], None]) -> None:
        with self._lock:
            if cb in self._subs:
                self._subs.remove(cb)

    def make_message(self, **kw: Any) -> SimpleFrame:
        return SimpleFrame(**kw)

    def send(self, msg: Any) -> None:
        msg.timestamp = time.time()
        with self._lock:
            self.sent.append(msg)
            subs = list(self._subs)
        for cb in subs:
            cb(msg)


class BusManager:
    """Owns one python-can bus (all channels) and fans received frames out to subscribers."""

    def __init__(self):
        self.bus: Any = None
        self.interface: Optional[str] = None
        self.channels: List[Any] = []
        self._subs: List[Callable[[Any], None]] = []
        self._subs_lock = threading.Lock()
        self._send_lock = threading.Lock()
        self._rx_thread: Optional[threading.Thread] = None
        self._stop_evt = threading.Event()
        self.on_error: Optional[Callable[[str], None]] = None
        self.rx_count = 0

    @property
    def is_open(self) -> bool:
        return self.bus is not None

    def open(self, interface: str, channels: Sequence[Any], app_name: Optional[str] = "CANalyzer",
             fd: bool = False, bitrate: Optional[int] = None, data_bitrate: Optional[int] = None,
             receive_own: bool = True) -> None:
        if can is None:
            raise RuntimeError("python-can is not installed: pip install python-can")
        if self.bus is not None:
            raise RuntimeError("CAN bus is already open")
        if not channels:
            raise ValueError("No channel selected")
        kw: Dict[str, Any] = {"interface": interface}
        if interface == "vector":
            kw.update(channel=list(channels), app_name=app_name or None, fd=fd,
                      receive_own_messages=receive_own)
        elif interface == "virtual":
            kw.update(channel=str(channels[0]), receive_own_messages=receive_own)
        else:
            kw.update(channel=channels[0], fd=fd, receive_own_messages=receive_own)
        if bitrate:
            kw["bitrate"] = int(bitrate)
        if fd and data_bitrate:
            kw["data_bitrate"] = int(data_bitrate)
        self.bus = can.Bus(**kw)
        self.interface = interface
        self.channels = list(channels) if interface == "vector" else [str(channels[0])]
        self._stop_evt.clear()
        self._rx_thread = threading.Thread(target=self._rx_loop, name="CAN-RX", daemon=True)
        self._rx_thread.start()

    def close(self) -> None:
        self._stop_evt.set()
        if self._rx_thread is not None:
            self._rx_thread.join(timeout=2.0)
            self._rx_thread = None
        with self._send_lock:
            bus, self.bus = self.bus, None
            if bus is not None:
                try:
                    bus.shutdown()
                except Exception:
                    pass
        self.interface = None
        self.channels = []

    def subscribe(self, cb: Callable[[Any], None]) -> None:
        with self._subs_lock:
            self._subs.append(cb)

    def unsubscribe(self, cb: Callable[[Any], None]) -> None:
        with self._subs_lock:
            if cb in self._subs:
                self._subs.remove(cb)

    def make_message(self, **kw: Any) -> Any:
        if can is None:
            raise RuntimeError("python-can is not installed")
        return can.Message(**kw)

    def send(self, msg: Any) -> None:
        with self._send_lock:
            if self.bus is None:
                raise RuntimeError("CAN bus is not open")
            self.bus.send(msg, timeout=0.2)

    def _report(self, text: str) -> None:
        if self.on_error:
            try:
                self.on_error(text)
            except Exception:
                pass

    def _rx_loop(self) -> None:
        errors = 0
        while not self._stop_evt.is_set():
            bus = self.bus
            if bus is None:
                break
            try:
                msg = bus.recv(0.1)
            except Exception as exc:
                errors += 1
                if errors <= 5:
                    self._report(f"Receive error: {exc}")
                if errors > 100:
                    self._report("Too many receive errors - receive thread stopped")
                    break
                time.sleep(0.2)
                continue
            if msg is None:
                continue
            errors = 0
            self.rx_count += 1
            with self._subs_lock:
                subs = list(self._subs)
            for cb in subs:
                try:
                    cb(msg)
                except Exception as exc:
                    self._report(f"Frame handler error: {exc}")


class PeriodicSender(threading.Thread):
    """Cyclic transmission of one frame through BusManager.send()."""

    def __init__(self, bus: Any, msg: Any, period_s: float,
                 on_error: Optional[Callable[[Exception], None]] = None):
        super().__init__(name=f"TX-0x{msg.arbitration_id:X}", daemon=True)
        if period_s < 0.001:
            raise ValueError("Cycle time must be >= 1 ms")
        self.bus = bus
        self.msg = msg
        self.period_s = period_s
        self.on_error = on_error
        self.sent = 0
        self._stop_evt = threading.Event()

    def run(self) -> None:
        next_t = time.monotonic()
        while not self._stop_evt.is_set():
            try:
                self.bus.send(self.msg)
                self.sent += 1
            except Exception as exc:
                if self.on_error:
                    self.on_error(exc)
                break
            next_t += self.period_s
            delay = next_t - time.monotonic()
            if delay < 0:
                next_t = time.monotonic()
                delay = 0
            if self._stop_evt.wait(delay):
                break

    def stop(self) -> None:
        self._stop_evt.set()


@dataclass
class MsgStat:
    channel: Any
    arb_id: int
    extended: bool
    count: int = 0
    dlc: int = 0
    data: bytes = b""
    last_ts: float = 0.0
    cycle_ms: float = 0.0
    is_fd: bool = False
    direction: str = "Rx"


TraceEntry = Tuple[float, Any, int, bool, str, int, bytes, bool, bool]


def format_trace_entry(e: TraceEntry, t0: Optional[float]) -> str:
    ts, ch, arb, ext, direction, dlc, data, fd, err = e
    rel = ts - t0 if t0 is not None else ts
    if err:
        return f"{rel:12.6f}  {channel_label(ch):<6} {'ErrorFrame':>10}"
    return (f"{rel:12.6f}  {channel_label(ch):<6} {format_can_id(arb, ext):>10}  {direction:<2} "
            f"{'FD ' if fd else '   '}[{dlc:>2}]  {hexs(data)}")


class CanMonitor:
    """Per-ID statistics, trace buffer and file recording for every received frame."""

    def __init__(self, bus: Any):
        self._lock = threading.Lock()
        self._logger_lock = threading.Lock()
        self.stats: Dict[Tuple[Any, int, bool], MsgStat] = {}
        self._trace: "collections.deque[TraceEntry]" = collections.deque(maxlen=5000)
        self.total = 0
        self.error_frames = 0
        self.t0: Optional[float] = None
        self._logger: Any = None
        self.log_path: Optional[str] = None
        self.logged = 0
        self.log_errors = 0
        bus.subscribe(self.on_message)

    @property
    def is_logging(self) -> bool:
        return self._logger is not None

    def on_message(self, msg: Any) -> None:
        with self._logger_lock:
            if self._logger is not None:
                try:
                    self._logger.on_message_received(msg)
                    self.logged += 1
                except Exception:
                    self.log_errors += 1
        err = bool(getattr(msg, "is_error_frame", False))
        ch = getattr(msg, "channel", None)
        ts = float(getattr(msg, "timestamp", 0.0) or 0.0)
        arb = -1 if err else int(msg.arbitration_id)
        ext = False if err else bool(msg.is_extended_id)
        data = b"" if err else bytes(msg.data)
        direction = "Rx" if getattr(msg, "is_rx", True) else "Tx"
        fd = bool(getattr(msg, "is_fd", False))
        with self._lock:
            if self.t0 is None:
                self.t0 = ts
            self.total += 1
            if err:
                self.error_frames += 1
            key = (ch, arb, ext)
            st = self.stats.get(key)
            if st is None:
                st = MsgStat(channel=ch, arb_id=arb, extended=ext)
                self.stats[key] = st
            if st.count:
                dt = (ts - st.last_ts) * 1000.0
                st.cycle_ms = dt if st.count == 1 else 0.8 * st.cycle_ms + 0.2 * dt
            st.count += 1
            st.dlc = int(getattr(msg, "dlc", len(data)))
            st.data = data
            st.last_ts = ts
            st.is_fd = fd
            st.direction = direction
            self._trace.append((ts, ch, arb, ext, direction, st.dlc, data, fd, err))

    def snapshot(self) -> List[MsgStat]:
        with self._lock:
            return [dataclasses.replace(s) for s in self.stats.values()]

    def drain_trace(self, limit: int = 500) -> List[TraceEntry]:
        out: List[TraceEntry] = []
        with self._lock:
            while self._trace and len(out) < limit:
                out.append(self._trace.popleft())
        return out

    def clear(self) -> None:
        with self._lock:
            self.stats.clear()
            self._trace.clear()
            self.total = 0
            self.error_frames = 0
            self.t0 = None

    def start_logging(self, path: str) -> None:
        if can is None:
            raise RuntimeError("python-can is not installed")
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        with self._logger_lock:
            if self._logger is not None:
                raise RuntimeError(f"Already recording to {self.log_path}")
            self._logger = can.Logger(path)
            self.log_path = path
            self.logged = 0
            self.log_errors = 0

    def stop_logging(self) -> Tuple[Optional[str], int]:
        with self._logger_lock:
            lg, self._logger = self._logger, None
            path, n = self.log_path, self.logged
        if lg is not None:
            try:
                lg.stop()
            except Exception:
                pass
            return path, n
        return None, 0


