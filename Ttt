    def fnum(self, key: str, what: str) -> float:
        try:
            v = float(self.s(key).replace(",", "."))
        except ValueError:
            raise ValueError(f"{what}: '{self.s(key)}' is not a number") from None
        if not math.isfinite(v):
            raise ValueError(f"{what} must be finite")
        return v

    def run_bg(self, src: str, action: str, fn: Callable[[], Any], on_ok: Optional[Callable] = None,
               on_err: Optional[Callable] = None) -> None:
        def worker() -> None:
            try:
                res = fn()
            except Exception as exc:
                self.ui_q.put(("err", src, action, exc, on_err))
                return
            self.ui_q.put(("ok", src, action, res, on_ok))
        threading.Thread(target=worker, name=f"{src}:{action}", daemon=True).start()

    def track(self, src: str, action: str, fut: "concurrent.futures.Future[Any]",
              on_ok: Optional[Callable] = None, on_err: Optional[Callable] = None) -> None:
        def done(f: "concurrent.futures.Future[Any]") -> None:
            try:
                res = f.result()
            except BaseException as exc:
                self.ui_q.put(("err", src, action, exc, on_err))
                return
            self.ui_q.put(("ok", src, action, res, on_ok))
        fut.add_done_callback(done)

    def ui(self, fn: Callable, *args: Any) -> None:
        """Run fn(*args) on the Tk thread (safe from any thread)."""
        self.ui_q.put(("call", "", "", args, fn))

    def _pump_ui(self) -> None:
        try:
            for _ in range(300):
                try:
                    kind, src, action, payload, cb = self.ui_q.get_nowait()
                except queue.Empty:
                    break
                try:
                    if kind == "ok":
                        if cb:
                            cb(payload)
                    elif kind == "call":
                        cb(*payload)
                    elif cb:  # error with own handler
                        cb(payload)
                    else:
                        level = "WARN" if isinstance(payload, NegativeResponse) else "ERROR"
                        self.events.log(src, f"{action} failed: {payload}", level)
                except Exception as exc:
                    self.events.log("APP", f"UI update after '{action}' failed: {exc}", "ERROR")
            for level, source, line in self.events.drain(400):
                short = line[11:]
                self._append(self.txt_events, [short], level)
                if source in ("DIAG", "DTC", "SEQ"):
                    self._append(self.txt_diag, [short], level)
        finally:
            self.after(100, self._pump_ui)

    def _event_listener(self, level: str, source: str, text: str) -> None:
        # runs in any thread - only plain attributes are touched here
        if not self._mirror or level == "DEBUG" or source not in ("PSU", "DTC", "SEQ"):
            return
        if not self.canalyzer.connected:
            return
        line = f"[Panel][{source}] {text}"
        self.canalyzer.submit(lambda w: w.app.UI.Write.Output(line) if w.app is not None else None)

