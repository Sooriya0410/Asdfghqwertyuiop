        self.assertEqual((len(recs), left, avail), (14, 0, 0xFF))
        fcs = [f for f in self._frames(0x7E0) if f[0] >> 4 == 3]
        self.assertEqual(len(fcs), 1)

    def test_multi_frame_request_and_session_nrc(self):
        new_vin = b"TESTVIN0123456789"
        with self.assertRaises(NegativeResponse) as cm:
            self.client.request(b"\x2E\xF1\x90" + new_vin)
