        """Independent left-to-right row (widgets keep their own widths, no shared grid columns)."""
        frame = ttk.Frame(parent)
        frame.grid(row=row, column=0, columnspan=40, sticky="w")
        for it in items:
            w = ttk.Label(parent, text=it) if isinstance(it, str) else it
            w.pack(in_=frame, side="left", padx=3, pady=pady)
            w.lift()
        return frame

    def _make_text(self, parent: Any, height: int = 8) -> Tuple[Any, Any]:
        frame = ttk.Frame(parent)
        txt = tk.Text(frame, height=height, wrap="none", font=("Consolas", 9), state="disabled",
                      background="#fbfbfb", borderwidth=1, relief="solid")
        ys = ttk.Scrollbar(frame, orient="vertical", command=txt.yview)
        xs = ttk.Scrollbar(frame, orient="horizontal", command=txt.xview)
        txt.configure(yscrollcommand=ys.set, xscrollcommand=xs.set)
        txt.grid(row=0, column=0, sticky="nsew")
        ys.grid(row=0, column=1, sticky="ns")
        xs.grid(row=1, column=0, sticky="ew")
        frame.rowconfigure(0, weight=1)
        frame.columnconfigure(0, weight=1)
        txt.tag_configure("WARN", foreground=AMBER)
        txt.tag_configure("ERROR", foreground=RED)
        txt.tag_configure("DEBUG", foreground=GREY)
        return frame, txt

    @staticmethod
    def _append(txt: Any, lines: Sequence[str], level: str = "INFO", max_lines: int = 3000) -> None:
        if not lines:
            return
        at_end = txt.yview()[1] >= 0.999
        txt.configure(state="normal")
        txt.insert("end", "\n".join(lines) + "\n", level)
        n = int(txt.index("end-1c").split(".")[0])
        if n > max_lines:
            txt.delete("1.0", f"{n - max_lines}.0")
        txt.configure(state="disabled")
        if at_end:
            txt.see("end")

    @staticmethod
    def _clear_text(txt: Any) -> None:
        txt.configure(state="normal")
        txt.delete("1.0", "end")
        txt.configure(state="disabled")

