    # --------------------------------------------------------- TRACE32 logic
    def _t32_browse_dll(self) -> None:
        path = filedialog.askopenfilename(title="TRACE32 remote API library",
                                          filetypes=[("TRACE32 API", "t32api*.dll libt32api*.so"), ("All files", "*.*")])
        if path:
            self.var("t32_dll", "").set(path)

    def _t32_detect_dll(self) -> None:
        found = find_t32_api()
        if not found:
            self.events.log("T32", "No TRACE32 API library found - select it manually (T32 installation: "
                                   "bin\\windows64\\t32api64.dll)", "WARN")
            return
        self.var("t32_dll", "").set(found[0])
        self.events.log("T32", f"Found: {', '.join(found[:4])}")

    def _t32_connect(self) -> None:
        if self.t32 and self.t32.connected:
            self.events.log("T32", "Already connected", "WARN")
            return
        try:
            if self.s("t32_backend") == "Simulated":
                iface: T32Interface = T32SimInterface()
            else:
                iface = T32DllInterface(self.s("t32_dll"), self.s("t32_node") or "localhost",
                                        int(self.s("t32_port") or "20000"), int(self.s("t32_packlen") or "1024"))
        except Exception as exc:
            self.events.log("T32", f"Connect: {exc}", "ERROR")
            return

        def ok(_: Any) -> None:
            self.t32 = iface
            self.events.log("T32", f"Connected ({iface.name})")
            self.lbl_t32.config(text=f"Connected - {iface.name}", foreground=GREEN)
            if self.s("t32_backend") == "Simulated" and not self.t32_vars:
                for sym in T32SimInterface.DEMO_SYMBOLS:
                    self.t32_vars.append(T32VarSpec(sym))
                self._t32_refresh_vars()
        self.run_bg("T32", "Connect", iface.connect, ok)

    def _t32_disconnect(self) -> None:
        self._t32_monitor_stop(quiet=True)
        iface, self.t32 = self.t32, None
        if iface is None:
            return
        try:
            iface.disconnect()
            self.events.log("T32", "Disconnected")
        except Exception as exc:
            self.events.log("T32", f"Disconnect: {exc}", "WARN")
        self.lbl_t32.config(text="Not connected", foreground=GREY)
        self.lbl_st_t32.config(text="T32: not connected", foreground=GREY)

    def _t32_ready(self) -> Optional[T32Interface]:
        if self.t32 is None or not self.t32.connected:
            self.events.log("T32", "Connect to TRACE32 first", "ERROR")
            return None
        return self.t32

    def _t32_simple(self, label: str, action: Callable[[T32Interface], Any]) -> None:
        iface = self._t32_ready()
        if iface:
            self.run_bg("T32", label, lambda: action(iface),
                        lambda _: self.events.log("T32", f"{label} sent"))

    def _t32_command(self, evaluate: bool) -> None:
        iface = self._t32_ready()
        cmd = self.s("t32_cmd")
        if not iface or not cmd:
            if iface:
                self.events.log("T32", "Enter a command", "ERROR")
            return

        def job() -> str:
            if evaluate:
                value, text = iface.evaluate(cmd)
                return f"Eval {cmd} = {text}"
            msg = iface.cmd(cmd)
            return f"{cmd} -> {msg or 'OK'}"
        self.run_bg("T32", "Command", job, lambda t: (self.lbl_t32_cmd.config(text=t), self.events.log("T32", t)))

    def _t32_write_var(self) -> None:
        iface = self._t32_ready()
        text = self.s("t32_write")
        if not iface or "=" not in text:
            if iface:
                self.events.log("T32", "Use symbol=value, e.g. gCounter=0", "ERROR")
            return
        symbol, value = text.split("=", 1)
        self.run_bg("T32", "Write variable", lambda: iface.write_variable(symbol.strip(), value.strip()),
                    lambda _: self.events.log("T32", f"{symbol.strip()} := {value.strip()}"))

    def _t32_run_script(self) -> None:
        iface = self._t32_ready()
        if not iface:
            return
        path = filedialog.askopenfilename(title="PRACTICE script", filetypes=[("PRACTICE script", "*.cmm"), ("All", "*.*")])
        if not path:
            return
        self.run_bg("T32", "Run script", lambda: iface.cmd(f'DO "{path}"'),
                    lambda _: self.events.log("T32", f"Script started: {path}"))

    def _t32_symbol_info(self) -> None:
        iface = self._t32_ready()
        sym = self.s("t32_sym")
        if not iface or not sym:
            if iface:
                self.events.log("T32", "Enter a symbol", "ERROR")
            return

        def ok(info: Tuple[int, int]) -> None:
            addr, size = info
            self.lbl_t32_cmd.config(text=f"{sym}: address 0x{addr:08X}, size {size} byte(s)")
            self.events.log("T32", f"Symbol {sym}: address 0x{addr:08X}, size {size}")
        self.run_bg("T32", "Symbol info", lambda: iface.symbol_info(sym), ok)

    def _t32_read_memory(self) -> None:
        iface = self._t32_ready()
        if not iface:
            return
        text = self.s("t32_sym")
        try:
            length = int(self.s("t32_len") or "16")
        except ValueError:
            self.events.log("T32", "Byte count must be a number", "ERROR")
            return

        def job() -> str:
            try:
                address = parse_hex_int(text)
            except ValueError:
                address, _size = iface.symbol_info(text)
            data = iface.read_memory(address, length)
            lines = [f"Memory at 0x{address:08X} ({len(data)} bytes)"]
            for off in range(0, len(data), 16):
                chunk = data[off:off + 16]
                lines.append(f"  0x{address + off:08X}  {hexs(chunk):<48}  {ascii_preview(chunk) or ''}")
            return "\n".join(lines)
        self.run_bg("T32", "Read memory", job,
                    lambda text_out: [self.events.log("T32", line) for line in text_out.splitlines()])

    # -- variable list --------------------------------------------------------
    def _t32_refresh_vars(self, values: Optional[Dict[str, str]] = None, changed: Sequence[str] = ()) -> None:
        tv = self.tv_t32
        existing = set(tv.get_children())
        for i, spec in enumerate(self.t32_vars):
            iid = str(i)
            mon = self.t32_monitor
            value = (values or {}).get(spec.symbol) or (mon.last.get(spec.symbol, "") if mon else "")
            count = mon.change_count.get(spec.symbol, 0) if mon else 0
            last = mon.last_change.get(spec.symbol) if mon else None
            last_text = _dt.datetime.fromtimestamp(last).strftime("%H:%M:%S.%f")[:-3] if last else ""
            tags = ("off",) if not spec.enabled else (("changed",) if spec.symbol in changed else ())
            row = (spec.symbol, spec.fmt, value, count, last_text, "yes" if spec.enabled else "no")
            if iid in existing:
                tv.item(iid, values=row, tags=tags)
                existing.discard(iid)
            else:
                tv.insert("", "end", iid=iid, values=row, tags=tags)
        for iid in existing:
            tv.delete(iid)
        if self.t32_monitor:
            self.t32_monitor.set_variables(self.t32_vars)

    def _t32_add_var(self) -> None:
        sym = self.s("t32_newvar")
        if not sym:
            self.events.log("T32", "Enter a symbol name, e.g. BswM_CurrentState or Global.gCounter", "ERROR")
            return
        if any(s.symbol == sym for s in self.t32_vars):
            self.events.log("T32", f"'{sym}' is already in the list", "WARN")
            return
        self.t32_vars.append(T32VarSpec(sym, self.s("t32_fmt") or "auto"))
        self.var("t32_newvar", "").set("")
        self._t32_refresh_vars()
        self.events.log("T32", f"Monitoring '{sym}'")

    def _t32_selected_var(self) -> Optional[int]:
        sel = self.tv_t32.selection()
        if not sel:
            self.events.log("T32", "Select a variable in the list first", "ERROR")
            return None
        idx = int(sel[0])
        return idx if 0 <= idx < len(self.t32_vars) else None

    def _t32_remove_var(self) -> None:
        idx = self._t32_selected_var()
        if idx is None:
            return
        spec = self.t32_vars.pop(idx)
        self._t32_refresh_vars()
        self.events.log("T32", f"'{spec.symbol}' removed")

    def _t32_toggle_var(self) -> None:
        idx = self._t32_selected_var()
        if idx is None:
            return
        spec = self.t32_vars[idx]
        self.t32_vars[idx] = T32VarSpec(spec.symbol, spec.fmt, not spec.enabled)
        self._t32_refresh_vars()

    def _t32_clear_vars(self) -> None:
        self.t32_vars.clear()
        self._t32_refresh_vars()
        self._t32_draw_chart()

    def _t32_load_vars(self) -> None:
        path = filedialog.askopenfilename(title="Variable list (symbol, format, enabled)",
                                          filetypes=[("Text / CSV", "*.txt *.csv"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, encoding="utf-8-sig") as fh:
                specs = [s for s in (T32VarSpec.from_text(line) for line in fh) if s is not None]
        except Exception as exc:
            self.events.log("T32", f"Loading the list failed: {exc}", "ERROR")
            return
        known = {s.symbol for s in self.t32_vars}
        self.t32_vars.extend(s for s in specs if s.symbol not in known)
        self._t32_refresh_vars()
        self.events.log("T32", f"{len(specs)} variable(s) loaded from {path}")

    def _t32_save_vars(self) -> None:
        if not self.t32_vars:
            self.events.log("T32", "The variable list is empty", "WARN")
            return
        path = filedialog.asksaveasfilename(title="Save variable list", defaultextension=".txt",
                                            initialfile="t32_variables.txt",
                                            filetypes=[("Text", "*.txt"), ("CSV", "*.csv")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write("# symbol\tformat\tenabled\n")
                fh.write("\n".join(s.to_text() for s in self.t32_vars) + "\n")
        except Exception as exc:
            self.events.log("T32", f"Saving failed: {exc}", "ERROR")
            return
        self.events.log("T32", f"Variable list saved to {path}")

    def _t32_browse_dir(self) -> None:
        path = filedialog.askdirectory(title="Recording folder", initialdir=self.s("t32_dir") or self.log_dir)
        if path:
            self.var("t32_dir", self.log_dir).set(path)

    # -- monitoring -----------------------------------------------------------
    def _t32_monitor_toggle(self) -> None:
        if self.t32_monitor:
            self._t32_monitor_stop()
        else:
            self._t32_monitor_start()

    def _t32_monitor_start(self) -> None:
        iface = self._t32_ready()
        if not iface:
            return
        if not [s for s in self.t32_vars if s.enabled]:
            self.events.log("T32", "Add at least one variable first", "ERROR")
            return
        try:
            period = self.fnum("t32_period", "Sample period") / 1000.0
        except ValueError as exc:
            self.events.log("T32", str(exc), "ERROR")
            return
        mon = T32Monitor(iface, period,
                         on_sample=lambda t, values, changed: self.ui(self._t32_sample, values, changed),
                         on_error=lambda msg: self.ui(self.events.log, "T32", msg, "WARN"))
        mon.set_variables(self.t32_vars)
        if self.b("t32_record"):
            path = os.path.join(self.s("t32_dir") or self.log_dir, f"t32_{now_stamp()}.csv")
            try:
                mon.start_recording(path, changes_only=self.b("t32_changes_only"))
            except Exception as exc:
                self.events.log("T32", f"Recording failed: {exc}", "ERROR")
                return
            self.events.log("T32", f"Recording {len(mon._header)} variable(s) to {path}")
        self.t32_monitor = mon.start()
        self.btn_t32_mon.config(text="Stop monitoring")
        self.events.log("T32", f"Monitoring {len([s for s in self.t32_vars if s.enabled])} variable(s) "
                               f"every {period * 1000:.0f} ms")

    def _t32_monitor_stop(self, quiet: bool = False) -> None:
        mon, self.t32_monitor = self.t32_monitor, None
        if mon is None:
            return
        mon.stop()
        mon.join(timeout=2.0)
        path, rows = mon.stop_recording()
        self.btn_t32_mon.config(text="Start monitoring")
        if not quiet:
            self.events.log("T32", f"Monitoring stopped after {mon.samples} sample(s), {mon.changes} change(s)")
            if path:
                self.events.log("T32", f"Recording closed: {rows} row(s) in {path}")
        self.lbl_t32_mon.config(text=f"Stopped - {mon.samples} samples, {mon.changes} changes", foreground=GREY)
        self._t32_last_mon = mon  # keep the history for the chart

    def _t32_sample(self, values: Dict[str, str], changed: Sequence[str]) -> None:
        self._t32_refresh_vars(values, changed)
        for sym in changed:
            self.events.log("T32", f"{sym} = {values.get(sym, '')}")

    def _t32_poll(self) -> None:
        try:
            iface = self.t32
            if iface is not None and iface.connected and not self._t32_busy:
                self._t32_busy = True

                def job() -> Tuple[str, str]:
                    try:
                        return iface.state()[1], iface.practice_state()
                    finally:
                        self._t32_busy = False
                self.run_bg("T32", "State", job, self._t32_show_state, on_err=self._t32_state_err)
            mon = self.t32_monitor
            if mon is not None:
                rec = f", recording {mon.rows} row(s)" if mon.recording else ""
                self.lbl_t32_mon.config(text=f"Monitoring: {mon.samples} samples, {mon.changes} changes{rec}",
                                        foreground=GREEN)
                self._t32_draw_chart()
        finally:
            self.after(1000, self._t32_poll)

    def _t32_show_state(self, state: Tuple[str, str]) -> None:
        self._t32_err = None
        cpu, practice = state
        iface = self.t32
        self.lbl_t32.config(text=f"Connected - {iface.name if iface else ''}   |   {cpu}   |   PRACTICE: {practice}",
                            foreground=GREEN if "running" in cpu.lower() else AMBER)
        self.lbl_st_t32.config(text=f"T32: {cpu}", foreground=GREEN)

    def _t32_state_err(self, exc: BaseException) -> None:
        msg = str(exc)
        if msg != self._t32_err:
            self.events.log("T32", f"State: {msg}", "WARN")
        self._t32_err = msg

    # -- strip chart ----------------------------------------------------------
    def _t32_chart_source(self) -> Tuple[str, List[Tuple[float, float]]]:
        mon = self.t32_monitor or getattr(self, "_t32_last_mon", None)
        sel = self.tv_t32.selection()
        if mon is None or not sel:
            return "", []
        idx = int(sel[0])
        if not (0 <= idx < len(self.t32_vars)):
            return "", []
        sym = self.t32_vars[idx].symbol
        points = [(t, v) for t, v, _text in mon.history.get(sym, ()) if v is not None]
        return sym, points[-600:]

    def _t32_draw_chart(self) -> None:
        cv = self.cv_t32
        cv.delete("all")
        w, h = max(cv.winfo_width(), 10), max(cv.winfo_height(), 10)
        sym, points = self._t32_chart_source()
        if len(points) < 2:
            cv.create_text(w // 2, h // 2, fill="#8a929b", font=("Segoe UI", 9),
                           text="select a variable and start monitoring" if not sym else f"{sym}: no numeric samples yet")
            return
        pad_l, pad_r, pad_t, pad_b = 54, 8, 16, 18
        xs = [p[0] for p in points]
        ys = [p[1] for p in points]
        t_min, t_max = xs[0], xs[-1]
        y_min, y_max = min(ys), max(ys)
        if y_max - y_min < 1e-9:
            y_min, y_max = y_min - 0.5, y_max + 0.5
        if t_max - t_min < 1e-9:
            t_max = t_min + 1e-9
        plot_w, plot_h = max(1, w - pad_l - pad_r), max(1, h - pad_t - pad_b)

        def to_xy(t: float, v: float) -> Tuple[float, float]:
            return (pad_l + (t - t_min) / (t_max - t_min) * plot_w,
                    pad_t + (1 - (v - y_min) / (y_max - y_min)) * plot_h)

        for frac in (0.0, 0.5, 1.0):
            y = pad_t + frac * plot_h
            cv.create_line(pad_l, y, w - pad_r, y, fill="#2b3139")
            cv.create_text(pad_l - 5, y, anchor="e", fill="#8a929b", font=("Consolas", 8),
                           text=f"{y_max - frac * (y_max - y_min):.3g}")
        coords: List[float] = []
        for t, v in points:
            x, y = to_xy(t, v)
            coords.extend((x, y))
        cv.create_line(*coords, fill="#4ec9b0", width=2)
        last_x, last_y = to_xy(*points[-1])
        cv.create_oval(last_x - 3, last_y - 3, last_x + 3, last_y + 3, fill="#4ec9b0", outline="")
        cv.create_text(pad_l, pad_t - 6, anchor="w", fill="#d7dde3", font=("Segoe UI", 9),
                       text=f"{sym}   last: {points[-1][1]:g}")
        cv.create_text(w - pad_r, h - 4, anchor="se", fill="#8a929b", font=("Consolas", 8),
                       text=f"{t_max - t_min:.1f} s window, {len(points)} samples")

