class TestIsoTpVariants(unittest.TestCase):
    def _pair(self, cfg: IsoTpConfig, bs: int = 0, stmin: int = 0) -> Tuple[LoopbackHub, SimulatedEcu, IsoTpTransport]:
        hub = LoopbackHub()
        ecu = SimulatedEcu(hub, cfg, bs=bs, stmin=stmin).start()
        tp = IsoTpTransport(hub, cfg)
        self.addCleanup(ecu.stop)
        self.addCleanup(tp.close)
        return hub, ecu, tp

    def test_ecu_block_size(self):
        cfg = IsoTpConfig(p2_ms=500)
        hub, ecu, tp = self._pair(cfg, bs=2, stmin=1)
        c = DiagClient(tp)
        c.session(0x03)
        self.assertEqual(c.request(b"\x2E\xF1\x90" + b"A" * 17), b"\x6E\xF1\x90")
        fcs = [m for m in hub.sent if m.arbitration_id == 0x7E8 and m.data[0] >> 4 == 3]
        self.assertEqual(len(fcs), 1)  # 20 bytes = FF(6) + 2 CF -> one block
        with self.assertRaises(NegativeResponse) as cm:  # 43 bytes = FF + 6 CF -> FC, 2 CF, FC, 2 CF, FC, 2 CF
