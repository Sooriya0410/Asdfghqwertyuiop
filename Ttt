    def _cn_connect(self) -> None:
        progid = self.s("cn_progid") or CanalyzerController.DEFAULT_PROGID
        self.events.log("CANALYZER", f"Connecting to {progid} (CANalyzer starts if it is not running)...")
        self._cn("Connect", self.canalyzer.connect(progid), self._cn_connected)

    def _cn_connected(self, info: Dict[str, Any]) -> None:
        self._last_poll_err = None
        self.events.log("CANALYZER", f"Connected: {info.get('version')} - configuration "
                                     f"'{info.get('config_name') or '-'}'")
        self._cn_show_info(info)
        self._cn_log_refresh(quiet=True)
        self._diag_detect_ecus(auto=True)

    def _cn_show_info(self, info: Dict[str, Any]) -> None:
        self.lbl_cn_version.config(text=f"Version: {info.get('version', '-')}")
        mod = "  (modified)" if info.get("modified") else ""
        self.lbl_cn_config.config(text=f"Configuration: {info.get('config') or '-'}{mod}")
        running = bool(info.get("running"))
        self.lbl_cn_state.config(text="Measurement: RUNNING" if running else "Measurement: stopped",
                                 foreground=GREEN if running else RED)
        self.lbl_st_cn.config(text=f"CANalyzer: {'measurement running' if running else 'connected'}",
                              foreground=GREEN if running else AMBER)
        self._on_running(running)

    def _cn_reset_labels(self) -> None:
        self.lbl_cn_version.config(text="Version: -")
        self.lbl_cn_state.config(text="Measurement: -", foreground=GREY)
        self.lbl_cn_config.config(text="Configuration: -")
        self.lbl_st_cn.config(text="CANalyzer: not connected", foreground=GREY)
        self._last_running = None

    def _on_running(self, running: bool) -> None:
        prev, self._last_running = self._last_running, running
        if prev is not None and prev != running:
            self.events.log("CANALYZER", "Measurement started" if running else "Measurement stopped")
        if running and prev is not True and self.b("cn_auto_bus") and not self.bus.is_open and can is not None:
            self._bus_open(auto=True)
        if not running and prev is True and self.b("cn_auto_stoplog") and self.monitor.is_logging:
            self._log_stop()

    def _poll_status(self) -> None:
        try:
            if self.canalyzer.connected and not self._info_busy:
                self._info_busy = True
                fut = self.canalyzer.info()

                def done(f: "concurrent.futures.Future[Any]") -> None:
                    self._info_busy = False
                    try:
                        info = f.result()
                    except BaseException as exc:
                        self.ui(self._cn_poll_error, exc)
                        return
                    self.ui(self._cn_show_info, info)
                fut.add_done_callback(done)
            self._win_check_alive()
        finally:
            self.after(1000, self._poll_status)

    def _cn_poll_error(self, exc: BaseException) -> None:
        msg = str(exc)
        if not self.canalyzer.connected:
            self.events.log("CANALYZER", f"Connection lost: {msg}", "ERROR")
            self._cn_reset_labels()
        elif msg != self._last_poll_err:
            self.events.log("CANALYZER", f"Status poll: {msg}", "WARN")
        self._last_poll_err = msg

    def _cn_disconnect(self) -> None:
        def ok(_: Any) -> None:
            self._cn_reset_labels()
            self.events.log("CANALYZER", "COM connection released (CANalyzer keeps running)")
        self._cn("Disconnect", self.canalyzer.disconnect(), ok)

