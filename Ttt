class EcuModel:
    """Small UDS/KWP server model with a fault memory."""

    LOW_VOLTAGE_DTC = 0xF00316   # U3003-16 supply voltage below threshold
    HIGH_VOLTAGE_DTC = 0xF00317  # U3003-17 supply voltage above threshold

    def __init__(self):
        self._lock = threading.Lock()
        self.dtcs: Dict[int, int] = {0x9A1B17: 0x09, 0xC15587: 0x2F, 0x012345: 0x24, 0x5A0213: 0x50}
        self.session = 0x01
        self.vin = b"WVWZZZ1JZXW000001"
        self.powered = True
        self.requests = 0

    def on_supply(self, voltage: float, output: bool) -> None:
        with self._lock:
            self.powered = bool(output) and voltage >= 6.0
            if self.powered and voltage < 9.0:
                self.dtcs[self.LOW_VOLTAGE_DTC] = 0x2F
            if self.powered and voltage > 16.0:
                self.dtcs[self.HIGH_VOLTAGE_DTC] = 0x2F

    def handle(self, req: bytes) -> List[bytes]:
        with self._lock:
            return self._handle(bytes(req))

    def _records(self, mask: Optional[int] = None) -> List[Tuple[int, int]]:
        items = sorted(self.dtcs.items())
        if mask is not None:
            items = [(c, s) for c, s in items if s & mask]
        return items

    @staticmethod
    def _pack(items: List[Tuple[int, int]]) -> bytes:
        return b"".join(c.to_bytes(3, "big") + bytes([s]) for c, s in items)

    def _handle(self, req: bytes) -> List[bytes]:
        if not self.powered or not req:
            return []
        self.requests += 1
        sid = req[0]

        def nrc(code: int) -> List[bytes]:
            return [bytes([0x7F, sid, code])]

        if sid == 0x10:
            if len(req) != 2:
                return nrc(0x13)
            sub = req[1] & 0x7F
            if sub not in (0x01, 0x02, 0x03):
                return nrc(0x12)
            self.session = sub
            return [] if req[1] & 0x80 else [bytes([0x50, sub, 0x00, 0x32, 0x01, 0xF4])]
        if sid == 0x11:
            if len(req) != 2:
                return nrc(0x13)
            sub = req[1] & 0x7F
            if sub not in (0x01, 0x02, 0x03):
                return nrc(0x12)
            self.session = 0x01
            return [] if req[1] & 0x80 else [bytes([0x51, sub])]
        if sid == 0x3E:
            if len(req) != 2:
                return nrc(0x13)
            sub = req[1] & 0x7F
            if sub not in (0x00, 0x01, 0x02):
                return nrc(0x12)
            if (req[1] & 0x80) or req[1] == 0x02:
                return []
            return [bytes([0x7E, sub])]
        if sid == 0x85:
            if len(req) < 2:
                return nrc(0x13)
            return [] if req[1] & 0x80 else [bytes([0xC5, req[1] & 0x7F])]
        if sid == 0x19:
            if len(req) < 2:
                return nrc(0x13)
            sub = req[1]
            if sub in (0x01, 0x02):
                if len(req) != 3:
                    return nrc(0x13)
                sel = self._records(req[2])
                if sub == 0x01:
                    return [bytes([0x59, 0x01, 0xFF, 0x01, (len(sel) >> 8) & 0xFF, len(sel) & 0xFF])]
                return [bytes([0x59, 0x02, 0xFF]) + self._pack(sel)]
            if sub == 0x0A:
                if len(req) != 2:
                    return nrc(0x13)
                return [bytes([0x59, 0x0A, 0xFF]) + self._pack(self._records())]
            if sub in (0x04, 0x06):
                if len(req) != 6:
                    return nrc(0x13)
                code = int.from_bytes(req[2:5], "big")
                if code not in self.dtcs:
                    return nrc(0x31)
                head = bytes([0x59, sub]) + req[2:5] + bytes([self.dtcs[code]])
                if sub == 0x04:
                    body = bytes([0x01, 0x02, 0xDD, 0x01, 0x00, 0x2A, 0xF4, 0x0D, 0x05])
                else:
                    body = bytes([0x01, 0x05, 0x02, 0x10])
                return [bytes([0x7F, 0x19, 0x78]), head + body]
            return nrc(0x12)
        if sid == 0x14:
            if len(req) == 4:
                group = int.from_bytes(req[1:4], "big")
                if group == 0xFFFFFF:
                    self.dtcs.clear()
                elif group in self.dtcs:
                    del self.dtcs[group]
                else:
                    return nrc(0x31)
                return [bytes([0x7F, 0x14, 0x78]), bytes([0x54])]
            if len(req) == 3:  # KWP2000: 14 <group hi> <group lo>
                self.dtcs.clear()
                return [bytes([0x54]) + req[1:3]]
            return nrc(0x13)
        if sid == 0x18:  # KWP2000 ReadDiagnosticTroubleCodesByStatus
            if len(req) != 4:
                return nrc(0x13)
            recs = self._records()
            body = b"".join(((c >> 8) & 0xFFFF).to_bytes(2, "big") + bytes([s]) for c, s in recs)
            return [bytes([0x58, len(recs) & 0xFF]) + body]
        if sid == 0x22:
            if len(req) != 3:
                return nrc(0x13)
            did = (req[1] << 8) | req[2]
            if did == 0xF190:
                return [b"\x62\xF1\x90" + self.vin]
            if did == 0xF187:
                return [b"\x62\xF1\x87" + b"SIM-ECU-0001"]
            return nrc(0x31)
        if sid == 0x2E:
            if len(req) < 4:
                return nrc(0x13)
            did = (req[1] << 8) | req[2]
            if did != 0xF190:
                return nrc(0x31)
            if len(req) != 3 + 17:
                return nrc(0x13)
            if self.session != 0x03:
                return nrc(0x7F)
            self.vin = bytes(req[3:])
            return [b"\x6E\xF1\x90"]
        return nrc(0x11)


class SimulatedEcu:
    """ISO-TP server around an EcuModel (IDs mirrored from the tester config)."""

    def __init__(self, bus: Any, tester_cfg: IsoTpConfig, model: Optional[EcuModel] = None,
                 bs: int = 0, stmin: int = 0, pending_delay: float = 0.05):
        ecu_cfg = IsoTpConfig(tx_id=tester_cfg.rx_id, rx_id=tester_cfg.tx_id, extended=tester_cfg.extended,
                              channel=None, fd=tester_cfg.fd, brs=tester_cfg.brs, padding=tester_cfg.padding,
                              bs=bs, stmin=stmin, functional_id=None,
                              n_bs_ms=tester_cfg.n_bs_ms, n_cr_ms=tester_cfg.n_cr_ms)
        self.tp = IsoTpTransport(bus, ecu_cfg)
        self.model = model or EcuModel()
        self.pending_delay = pending_delay
        self.requests: List[bytes] = []
        self._stop_evt = threading.Event()
        self._thread = threading.Thread(target=self._run, name="SimECU", daemon=True)

    def start(self) -> "SimulatedEcu":
        self._thread.start()
        return self

    def stop(self) -> None:
        self._stop_evt.set()
        if self._thread.is_alive():
            self._thread.join(timeout=2.0)
        self.tp.close()

    def _run(self) -> None:
        while not self._stop_evt.is_set():
            try:
                pdu = self.tp._recv_pdu(time.monotonic() + 0.1)
            except IsoTpError:
                continue
            if pdu is None:
                continue
            self.requests.append(pdu)
            for resp in self.model.handle(pdu):
                if self._stop_evt.is_set():
                    break
                try:
                    self.tp._send_pdu(resp)
                except (IsoTpError, RuntimeError):
                    break
                if len(resp) >= 3 and resp[0] == 0x7F and resp[2] == 0x78:
                    time.sleep(self.pending_delay)


