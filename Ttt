    # -------------------------------------------------------- diagnostics logic
    def _isotp_cfg(self) -> IsoTpConfig:
        ext, fd = self.b("dg_ext"), self.b("dg_fd")
        bits = 29 if ext else 11
        channel = None
        if self.bus.interface == "vector":
            idx = int(self.s("dg_ch")) - 1
            if idx not in self.bus.channels:
                raise ValueError(f"Diagnostic channel CAN{idx + 1} is not open in the bus monitor")
            channel = idx
        pad, func = self.s("dg_pad"), self.s("dg_func")
        return IsoTpConfig(tx_id=parse_hex_int(self.s("dg_tx"), bits), rx_id=parse_hex_int(self.s("dg_rx"), bits),
                           extended=ext, channel=channel, fd=fd, brs=fd and self.b("dg_brs"),
                           padding=parse_hex_int(pad, 8) if pad else None,
                           bs=int(self.s("dg_bs") or "0", 0), stmin=int(self.s("dg_stmin") or "0", 0),
                           functional_id=parse_hex_int(func, bits) if func else None,
                           p2_ms=int(self.s("dg_p2") or "1000"), p2star_ms=int(self.s("dg_p2s") or "5000"))

    def _cdd_browse(self) -> None:
        path = filedialog.askopenfilename(title="Diagnostic description",
                                          filetypes=[("Diagnostic description", "*.cdd *.odx *.pdx *.odx-d"),
                                                     ("CANdela diagnostic description", "*.cdd"), ("All files", "*.*")])
        if path:
            self.var("dg_cdd", "").set(path)

    def _cdd_add(self) -> None:
        path = self.s("dg_cdd")
        if not self.canalyzer.connected:
            self.events.log("DIAG", "Connect to CANalyzer first (CANalyzer tab)", "ERROR")
            return
        if not path:
            self.events.log("DIAG", "Select a .cdd / .odx file first", "ERROR")
            return

        def ok(descriptions: List[Tuple[int, str]]) -> None:
            self.events.log("DIAG", f"Diagnostic description added: {os.path.basename(path)}")
            for i, name in descriptions:
                self.events.log("DIAG", f"  {i}: {name}")
            self.events.log("DIAG", "Save the configuration in CANalyzer to keep it; if the ECU does not show up, "
                                    "restart the measurement.")
            self._diag_detect_ecus(auto=True)
        self.track("DIAG", "Add diagnostic description",
                   self.canalyzer.add_cdd(path, self.s("dg_cdd_bus") or "CAN", self.s("dg_cdd_ecu")), ok)

    def _cdd_list(self) -> None:
        if not self.canalyzer.connected:
            self.events.log("DIAG", "Connect to CANalyzer first (CANalyzer tab)", "ERROR")
            return

        def ok(descriptions: List[Tuple[int, str]]) -> None:
            if not descriptions:
                self.events.log("DIAG", "No diagnostic description in the configuration", "WARN")
            for i, name in descriptions:
                self.events.log("DIAG", f"Diagnostic description {i}: {name}")
        self.track("DIAG", "List diagnostic descriptions", self.canalyzer.list_cdds(), ok)

    def _diag_source_changed(self) -> None:
        if self.s("dg_transport") == "CANalyzer COM":
            self.frm_isotp.grid_remove()
        else:
            self.frm_isotp.grid()

    def _diag_detect_ecus(self, auto: bool = False) -> None:
        if not self.canalyzer.connected:
            if not auto:
                self.events.log("DIAG", "Connect to CANalyzer first (CANalyzer tab)", "ERROR")
            return
        self.track("DIAG", "Detect ECUs", self.canalyzer.list_ecus(),
                   lambda ecus: self._diag_ecus_found(ecus, auto), on_err=(lambda exc: None) if auto else None)

    def _diag_ecus_found(self, ecus: List[Tuple[str, str]], auto: bool) -> None:
        names = [name for _, name in ecus]
        self.cb_ecu.configure(values=names)
        if not names:
            self.events.log("DIAG", "No diagnostic ECU in the CANalyzer configuration - add a diagnostic description "
                                    "(CDD/ODX) in CANalyzer, or use the source 'Python ISO-TP'", "WARN")
            return
        self.events.log("DIAG", f"ECUs in the configuration: {', '.join(f'{n}/{d}' for n, d in ecus)}")
        if self.s("dg_ecu") not in names:
            self.var("dg_ecu", "").set(names[0])
        if auto and self.diag is None and self.s("dg_transport") == "CANalyzer COM":
            self._diag_connect()

    def _diag_connect(self) -> None:
        self._diag_disconnect(quiet=True)
        mode, proto = self.s("dg_transport"), self.s("dg_proto") or "UDS"
        try:
            if mode == "CANalyzer COM":
                if not self.canalyzer.connected:
                    raise RuntimeError("Connect to CANalyzer first (CANalyzer tab)")
                ecu = self.s("dg_ecu")
                if not ecu:
                    raise RuntimeError("No ECU selected - press 'Detect ECUs'")
                tr: DiagTransport = ComDiagTransport(self.canalyzer, ecu,
                                                     self.fnum("dg_com_timeout", "COM timeout"))
                desc = f"CANalyzer diagnostics, ECU '{ecu}'"
            else:
                if not self.bus.is_open:
                    raise RuntimeError("Open the CAN bus first (Bus monitor tab)")
                cfg = self._isotp_cfg()
                tr = IsoTpTransport(self.bus, cfg)
                desc = (f"ISO-TP {channel_label(cfg.channel)}  Tx 0x{cfg.tx_id:X} / Rx 0x{cfg.rx_id:X}"
                        f"{'  FD' if cfg.fd else ''}")
                if self.bus.interface == "virtual" and self.b("mon_demo_ecu"):
                    self._start_sim_ecu(cfg)
        except Exception as exc:
            self.events.log("DIAG", f"Connect failed: {exc}", "ERROR")
            return
        self.diag_transport = tr
        self.diag = DiagClient(tr, proto, log=lambda t, lvl="INFO": self.events.log("DIAG", t, lvl))
        self.lbl_diag.config(text=f"Connected: {desc}  [{self.diag.protocol}]", foreground=GREEN)
        self.lbl_st_diag.config(text=f"Diag: {self.diag.protocol}", foreground=GREEN)
        self.events.log("DIAG", f"Diagnostic channel ready - {desc}, {self.diag.protocol}")

    def _diag_disconnect(self, quiet: bool = False) -> None:
        if self.tp_thread:
            self.tp_thread.stop()
            self.tp_thread = None
            self.btn_tp.config(text="Start tester present")
        if self.diag_transport:
            self.diag_transport.close()
            if not quiet:
                self.events.log("DIAG", "Diagnostic channel closed")
        self.diag_transport = None
        self.diag = None
        self._stop_sim_ecu()
        self.lbl_diag.config(text="Not connected", foreground=GREY)
        self.lbl_st_diag.config(text="Diag: not connected", foreground=GREY)

    def _start_sim_ecu(self, cfg: IsoTpConfig) -> None:
        self._stop_sim_ecu()
        sim_bus = BusManager()
        sim_bus.open("virtual", [self.bus.channels[0]], receive_own=False)
        self.sim_bus = sim_bus
        self.sim_ecu = SimulatedEcu(sim_bus, cfg, model=self.demo_model).start()
        self.events.log("DIAG", f"Demo ECU answers on 0x{cfg.rx_id:X} (virtual bus). With the simulated power "
                                "supply it switches off below 6 V and stores U3003-16/-17 for under/over voltage.")

    def _stop_sim_ecu(self) -> None:
        if self.sim_ecu:
            self.sim_ecu.stop()
            self.sim_ecu = None
        if self.sim_bus:
            self.sim_bus.close()
            self.sim_bus = None

    def _diag_job(self, action: str, fn: Callable[[DiagClient], Any], on_ok: Optional[Callable] = None) -> None:
        client = self.diag
        if client is None:
            self.events.log("DIAG", "Not connected - press Connect in 'Diagnostic connection'", "ERROR")
            return
        self.run_bg("DIAG", action, lambda: fn(client), on_ok)

    def _tp_toggle(self) -> None:
        if self.tp_thread:
            self.tp_thread.stop()
            self.tp_thread = None
            self.btn_tp.config(text="Start tester present")
            self.events.log("DIAG", "Tester present stopped")
            return
        if self.diag is None:
            self.events.log("DIAG", "Connect the diagnostic channel first", "ERROR")
            return
        try:
            payload = parse_hex_bytes(self.s("dg_tp"))
            period = self.fnum("dg_tp_period", "Tester present period") / 1000.0
            self.tp_thread = TesterPresentThread(self.diag, payload, period, self.b("dg_tp_func"),
                                                 log=lambda t, lvl="INFO": self.events.log("DIAG", t, lvl)).start()
        except Exception as exc:
            self.events.log("DIAG", f"Tester present: {exc}", "ERROR")
            return
        self.btn_tp.config(text="Stop tester present")
        self.events.log("DIAG", f"Tester present [{hexs(payload)}] every {period * 1000:g} ms")

    def _diag_session(self, sub: int) -> None:
        def ok(resp: Optional[bytes]) -> None:
            if resp and len(resp) >= 6:
                p2 = (resp[2] << 8) | resp[3]
                p2s = ((resp[4] << 8) | resp[5]) * 10
                self.events.log("DIAG", f"Session 0x{sub:02X} active (ECU P2 {p2} ms, P2* {p2s} ms)")
            else:
                self.events.log("DIAG", f"Session 0x{sub:02X} active")
        self._diag_job(f"Session 0x{sub:02X}", lambda c: c.session(sub), ok)

    def _diag_reset(self) -> None:
        if messagebox.askyesno(APP_NAME, "Send ECU hard reset (11 01)?"):
            self._diag_job("ECU reset", lambda c: c.ecu_reset(0x01),
                           lambda _: self.events.log("DIAG", "ECU reset acknowledged"))

    def _diag_dtc_setting(self, on: bool) -> None:
        self._diag_job("ControlDTCSetting", lambda c: c.dtc_setting(on),
                       lambda _: self.events.log("DIAG", f"DTC setting {'ON' if on else 'OFF'}"))

    def _raw_send(self) -> None:
        text = self.s("dg_raw")
        if not text:
            self.events.log("DIAG", "Enter hex bytes (22 F1 90) or a request qualifier", "ERROR")
            return
        try:
            payload = parse_hex_bytes(text)
        except ValueError:
            payload = b""
        transport = self.diag_transport
        if not payload and not isinstance(transport, ComDiagTransport):
            self.events.log("DIAG", "Request qualifiers need the source 'CANalyzer COM'; enter hex bytes instead",
                            "ERROR")
            return

        def job(c: DiagClient) -> str:
            if payload:
                try:
                    resp = c.request(payload)
                except NegativeResponse as exc:
                    return f"- {exc}"
                if resp is None:
                    return "(positive response suppressed)"
                extra = ascii_preview(resp[3:]) if resp[0] == 0x62 else ""
                return f"+ {hexs(resp)}" + (f'   "{extra}"' if extra else "")
            self.events.log("DIAG", f"TX  {text}   (request qualifier of the diagnostic description)")
            resp = transport.request_qualifier(text)  # type: ignore[union-attr]
            if resp is None:
                return "(no response)"
            self.events.log("DIAG", f"RX  {hexs(resp)}")
            if len(resp) >= 3 and resp[0] == 0x7F:
                return f"- {NegativeResponse(resp[1], resp[2])}"
            extra = ascii_preview(resp[3:]) if resp[0] == 0x62 else ""
            return f"+ {hexs(resp)}" + (f'   "{extra}"' if extra else "")
        self._diag_job("Diagnostic command", job, lambda t: self.lbl_raw.config(text=t, foreground="black"))

    def _mask(self) -> int:
        text = self.s("dg_mask")
        return parse_hex_int(text.split()[0] if text else "FF", 8)

    def _dtc_reader(self) -> Callable[[], Tuple[List[DtcRecord], str]]:
        client = self.diag
        if client is None:
            raise RuntimeError("Diagnostics not connected")
        if client.protocol == "KWP2000":
            status = parse_hex_int(self.s("dg_kwp_status") or "02", 8)
            group = parse_hex_int(self.s("dg_kwp_group") or "FF00", 16)

            def read_kwp() -> Tuple[List[DtcRecord], str]:
                n, recs = client.kwp_read_dtcs(status, group)
                return recs, f"KWP2000 18 {status:02X} {group:04X}: {len(recs)} DTC(s) (ECU reported {n})"
            return read_kwp
        mask = self._mask()

        def read_uds() -> Tuple[List[DtcRecord], str]:
            avail, recs, leftover = client.read_dtcs(mask)
            extra = f", {leftover} trailing byte(s) ignored" if leftover else ""
            return recs, f"19 02 mask 0x{mask:02X}: {len(recs)} DTC(s), availability mask 0x{avail:02X}{extra}"
        return read_uds

    def _dtc_read(self) -> None:
        try:
            reader = self._dtc_reader()
        except Exception as exc:
            self.events.log("DIAG", f"Read DTCs: {exc}", "ERROR")
            return
        self.run_bg("DIAG", "Read DTCs", reader, self._dtc_show)

    def _dtc_show(self, result: Tuple[List[DtcRecord], str]) -> None:
        recs, summary = result
        self.last_dtcs = list(recs)
        self.tv_dtc.delete(*self.tv_dtc.get_children())
        for i, r in enumerate(recs):
            tags = ("active",) if (r.width == 3 and r.status & 0x01) else ()
            self.tv_dtc.insert("", "end", iid=str(i), tags=tags,
                               values=(i + 1, r.hex, r.sae, f"0x{r.status:02X}", r.status_flags(),
                                       self.dtc_texts.get(r.code, "")))
        self.lbl_dtc.config(text=summary, foreground=RED if recs else GREEN)
        self.events.log("DTC", summary)
        for r in recs[:200]:
            text = self.dtc_texts.get(r.code, "")
            self.events.log("DTC", f"  {r.hex}  {r.sae:<9} status 0x{r.status:02X} [{r.status_flags() or '-'}]"
                                   f"{'  ' + text if text else ''}")

    def _dtc_count(self) -> None:
        if self.diag and self.diag.protocol != "UDS":
            self.events.log("DIAG", "DTC count (19 01) is a UDS service", "ERROR")
            return
        mask = self._mask()

        def ok(r: Tuple[int, int, int]) -> None:
            avail, fmt, count = r
            text = f"19 01 mask 0x{mask:02X}: {count} DTC(s) (format 0x{fmt:02X}, availability 0x{avail:02X})"
            self.lbl_dtc.config(text=text, foreground=RED if count else GREEN)
            self.events.log("DTC", text)
        self._diag_job("DTC count", lambda c: c.read_dtc_count(mask), ok)

    def _dtc_supported(self) -> None:
        if self.diag and self.diag.protocol != "UDS":
            self.events.log("DIAG", "Supported DTCs (19 0A) is a UDS service", "ERROR")
            return

        def job(c: DiagClient) -> Tuple[List[DtcRecord], str]:
            avail, recs, _ = c.read_supported_dtcs()
            return recs, f"19 0A: {len(recs)} supported DTC(s), availability mask 0x{avail:02X}"
        self._diag_job("Supported DTCs", job, self._dtc_show)

    def _dtc_selected(self) -> Optional[DtcRecord]:
        sel = self.tv_dtc.selection()
        if not sel:
            self.events.log("DIAG", "Select a DTC in the list first", "ERROR")
            return None
        idx = int(sel[0])
        return self.last_dtcs[idx] if 0 <= idx < len(self.last_dtcs) else None

    def _dtc_data(self, sub: int) -> None:
        rec = self._dtc_selected()
        if rec is None:
            return
        if rec.width != 3:
            self.events.log("DIAG", "Snapshot / extended data need a UDS DTC", "ERROR")
            return

        def job(c: DiagClient) -> str:
            resp = c.read_snapshot(rec.code) if sub == 0x04 else c.read_extended_data(rec.code)
            return format_dtc_data_response(resp)
        self._diag_job("Snapshot" if sub == 0x04 else "Extended data", job,
                       lambda text: [self.events.log("DTC", line) for line in text.splitlines()])

    def _dtc_clear(self) -> None:
        if not messagebox.askyesno(APP_NAME, "Clear the complete fault memory of the ECU?"):
            return

        def ok(_: Any) -> None:
            self.events.log("DTC", "Fault memory cleared")
            self.tv_dtc.delete(*self.tv_dtc.get_children())
            self.last_dtcs = []
            self.lbl_dtc.config(text="Fault memory cleared - read again to verify", foreground=GREEN)
        self._diag_job("Clear DTCs", lambda c: c.clear_dtcs(), ok)

    def _dtc_export(self) -> None:
        if not self.last_dtcs:
            self.events.log("DTC", "Nothing to export - read the fault memory first", "WARN")
            return
        path = filedialog.asksaveasfilename(title="Export DTCs", defaultextension=".xlsx",
                                            initialfile=f"dtc_{now_stamp()}.xlsx",
                                            filetypes=[("Excel workbook", "*.xlsx"), ("CSV", "*.csv")])
        if not path:
            return
        psu = self.psu
        psu_txt = "not connected"
        if psu and psu.connected:
            psu_txt = f"output {'ON' if psu.output_on else 'OFF'}, set {psu.voltage_set if psu.voltage_set is not None else '-'} V"
        meta = {"Exported": _dt.datetime.now().isoformat(timespec="seconds"),
                "Tool": f"{APP_NAME} v{APP_VERSION}",
                "Diagnostic channel": self.lbl_diag.cget("text"),
                "Result": self.lbl_dtc.cget("text"),
                "Power supply": psu_txt,
                "CANalyzer": self.lbl_cn_config.cget("text")}
        try:
            export_dtcs(path, self.last_dtcs, meta, self.dtc_texts)
        except Exception as exc:
            self.events.log("DTC", f"Export failed: {exc}", "ERROR")
            return
        self.events.log("DTC", f"{len(self.last_dtcs)} DTC(s) exported to {path}")

    def _dtc_load_texts(self) -> None:
        path = filedialog.askopenfilename(title="DTC texts: column A = DTC (hex or SAE), column B = description",
                                          filetypes=[("Excel / CSV", "*.xlsx *.csv"), ("All files", "*.*")])
        if not path:
            return
        try:
            self.dtc_texts = load_dtc_texts(path)
        except Exception as exc:
            self.events.log("DTC", f"Loading DTC texts failed: {exc}", "ERROR")
            return
        self.events.log("DTC", f"{len(self.dtc_texts)} DTC text(s) loaded from {path}")
        for i, r in enumerate(self.last_dtcs):
            if self.tv_dtc.exists(str(i)):
                self.tv_dtc.set(str(i), "desc", self.dtc_texts.get(r.code, ""))

    def _seq_power_cycle_read(self) -> None:
        psu = self.psu
        if not (psu and psu.connected):
            self.events.log("SEQ", "Connect the power supply first (Power supply tab)", "ERROR")
            return
        if self._psu_busy_seq:
            self.events.log("SEQ", "A power supply sequence is already running", "WARN")
            return
        try:
            reader = self._dtc_reader()
            off_s = self.fnum("psu_cycle_off", "Off time")
            boot_s = self.fnum("dg_boot", "Boot wait")
        except Exception as exc:
            self.events.log("SEQ", f"Power-cycle + read: {exc}", "ERROR")
            return
        self.psu_abort.clear()
        self._psu_busy_seq = True

        def job() -> Tuple[List[DtcRecord], str]:
            try:
                self.events.log("SEQ", f"Power cycle: OFF {off_s:g} s, boot wait {boot_s:g} s, then read fault memory")
                if not psu.power_cycle(off_s, self.psu_abort):
                    raise RuntimeError("aborted")
                self.ui(self._psu_show_state)
                if self.psu_abort.wait(boot_s):
                    raise RuntimeError("aborted")
                return reader()
            finally:
                self._psu_busy_seq = False
        self.run_bg("SEQ", "Power-cycle + read DTCs", job, self._dtc_show)

