    def _log_start(self) -> None:
        if not self.bus.is_open:
            self.events.log("CAN", "Open the bus before starting a recording", "ERROR")
            return
        fmt = self.s("mon_log_fmt") or "blf"
        path = os.path.join(self.s("mon_log_dir") or self.log_dir, f"can_{now_stamp()}.{fmt}")
