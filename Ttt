    def _cn_quit(self) -> None:
        if not self.canalyzer.connected:
            self.events.log("CANALYZER", "Not connected", "WARN")
            return
        if not messagebox.askyesno(APP_NAME, "Stop the measurement and quit CANalyzer?\n"
                                             "Unsaved configuration changes are lost."):
            return

        def ok(_: Any) -> None:
            self._cn_reset_labels()
            self.events.log("CANALYZER", "CANalyzer closed")
        self._cn("Quit", self.canalyzer.quit_app(), ok)

