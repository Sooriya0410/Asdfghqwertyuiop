_SAE_RE = re.compile(r"^([PCBU])([0-3])([0-9A-F])([0-9A-F]{2})(?:-?([0-9A-F]{2}))?$")


def dtc_to_sae(code: int) -> str:
    """24-bit UDS DTC -> SAE J2012 text incl. failure type byte (0x9A1B17 -> B1A1B-17)."""
    hi, mid, lo = (code >> 16) & 0xFF, (code >> 8) & 0xFF, code & 0xFF
    return f"{'PCBU'[hi >> 6]}{(hi >> 4) & 0x3:X}{hi & 0xF:X}{mid:02X}-{lo:02X}"


def dtc2_to_sae(code: int) -> str:
    """16-bit KWP2000 DTC -> SAE text (0x1234 -> P1234)."""
    hi, lo = (code >> 8) & 0xFF, code & 0xFF
    return f"{'PCBU'[hi >> 6]}{(hi >> 4) & 0x3:X}{hi & 0xF:X}{lo:02X}"


def sae_to_dtc(text: str) -> int:
    m = _SAE_RE.match((text or "").strip().upper())
    if not m:
        raise ValueError(f"Not an SAE DTC: {text!r}")
    hi = ("PCBU".index(m.group(1)) << 6) | (int(m.group(2)) << 4) | int(m.group(3), 16)
    mid = int(m.group(4), 16)
    lo = int(m.group(5), 16) if m.group(5) else 0
    return (hi << 16) | (mid << 8) | lo


def parse_dtc_text(text: str) -> Optional[int]:
    """'0x9A1B17', '9A1B17', 'B1A1B-17', 'B1A1B17', 'P0123', '1234' (KWP) -> int or None."""
    t = (text or "").strip().upper().replace(" ", "")
    if not t:
        return None
    m = re.fullmatch(r"(?:0X)?([0-9A-F]{4}|[0-9A-F]{6})", t)
    if m:
        return int(m.group(1), 16)
    try:
        return sae_to_dtc(t)
    except ValueError:
        return None


@dataclass(frozen=True)
class DtcRecord:
    code: int
    status: int
    width: int = 3  # bytes: 3 = UDS, 2 = KWP2000

    @property
    def hex(self) -> str:
        return f"{self.code:0{self.width * 2}X}"

    @property
    def sae(self) -> str:
        return dtc_to_sae(self.code) if self.width == 3 else dtc2_to_sae(self.code)

    def status_flags(self, sep: str = " ") -> str:
        if self.width != 3:
            return ""
        return sep.join(short for bit, short, _ in DTC_STATUS_BITS if self.status & bit)


def decode_status(status: int) -> List[str]:
    return [name for bit, _, name in DTC_STATUS_BITS if status & bit]


def parse_uds_dtc_count(resp: bytes) -> Tuple[int, int, int]:
    """59 01 <availMask> <formatId> <countHi> <countLo> -> (avail, fmt, count)."""
    if len(resp) < 6 or resp[0] != 0x59 or resp[1] not in (0x01, 0x07, 0x11, 0x12):
        raise DiagError(f"Unexpected DTC count response: {hexs(resp)}")
    return resp[2], resp[3], (resp[4] << 8) | resp[5]


def parse_uds_dtc_list(resp: bytes) -> Tuple[int, List[DtcRecord], int]:
    """59 02|0A|0F|13|15|17 <availMask> [DTC(3) status]* -> (avail, records, leftover)."""
    if len(resp) < 3 or resp[0] != 0x59:
        raise DiagError(f"Unexpected DTC list response: {hexs(resp[:8])}")
    body = resp[3:]
    n, leftover = divmod(len(body), 4)
    recs = [DtcRecord(int.from_bytes(body[i * 4:i * 4 + 3], "big"), body[i * 4 + 3]) for i in range(n)]
    return resp[2], recs, leftover


def parse_kwp_dtc_list(resp: bytes) -> Tuple[int, List[DtcRecord]]:
    """58 <n> [DTC_hi DTC_lo status]* -> (reported n, records)."""
    if len(resp) < 2 or resp[0] != 0x58:
        raise DiagError(f"Unexpected KWP2000 DTC response: {hexs(resp[:8])}")
    n = resp[1]
    body = resp[2:]
    count = min(n, len(body) // 3)
    recs = [DtcRecord(int.from_bytes(body[i * 3:i * 3 + 2], "big"), body[i * 3 + 2], width=2)
            for i in range(count)]
    return n, recs


def format_dtc_data_response(resp: bytes) -> str:
    """Readable text for 59 04 (snapshot) / 59 06 (extended data) responses."""
    if len(resp) < 6 or resp[0] != 0x59:
        return f"Unexpected response: {hexs(resp)}"
    sub = resp[1]
    rec = DtcRecord(int.from_bytes(resp[2:5], "big"), resp[5])
    kind = {0x04: "Snapshot", 0x06: "Extended data"}.get(sub, f"Sub-function 0x{sub:02X}")
    body = resp[6:]
    lines = [f"{kind} for {rec.hex} ({rec.sae}), status 0x{rec.status:02X} [{rec.status_flags() or '-'}]"]
    if not body:
        lines.append("    no record stored")
    elif sub == 0x04 and len(body) >= 2:
        lines.append(f"    record 0x{body[0]:02X}, {body[1]} identifier(s), raw: {hexs(body[2:])}")
    elif sub == 0x06:
        lines.append(f"    record 0x{body[0]:02X}, raw: {hexs(body[1:])}")
    else:
        lines.append(f"    raw: {hexs(body)}")
    lines.append("    (DID/record layouts are ECU specific; decode with the CDD/ODX)")
    return "\n".join(lines)


