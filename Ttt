def now_stamp() -> str:
    return _dt.datetime.now().strftime("%Y%m%d_%H%M%S")


def hexs(data: Iterable[int]) -> str:
    return " ".join(f"{b:02X}" for b in data)


_HEX_SPLIT = re.compile(r"[\s,;\-]+")


def parse_hex_bytes(text: str) -> bytes:
    """'19 02 FF', '1902FF', '0x19,0x2,0xFF', '19-02-ff' -> b'\\x19\\x02\\xff'."""
    s = (text or "").strip()
    if not s:
        return b""
    out = bytearray()
    for tok in _HEX_SPLIT.split(s):
        if not tok:
            continue
        t = tok[2:] if tok[:2].lower() == "0x" else tok
        if not t or not re.fullmatch(r"[0-9A-Fa-f]+", t):
            raise ValueError(f"Invalid hex byte token: {tok!r}")
        if len(t) == 1:
            t = "0" + t
        if len(t) % 2:
            raise ValueError(f"Odd number of hex digits in {tok!r}")
        out.extend(bytes.fromhex(t))
    return bytes(out)


def parse_hex_int(text: str, max_bits: Optional[int] = None) -> int:
    """Hex value with or without 0x prefix ('7E0', '0x18DA10F1')."""
    t = (text or "").strip()
    if t[:2].lower() == "0x":
        t = t[2:]
    if not t or not re.fullmatch(r"[0-9A-Fa-f]+", t):
        raise ValueError(f"Invalid hex value: {text!r}")
    v = int(t, 16)
    if max_bits is not None and v >= (1 << max_bits):
        raise ValueError(f"0x{v:X} does not fit into {max_bits} bits")
    return v


def parse_channel_list(text: str) -> List[int]:
    """'1,2,4-6' (CANalyzer numbering, 1 = CAN1) -> [0, 1, 3, 4, 5] (0-based)."""
    result: List[int] = []
    for part in re.split(r"[\s,;]+", (text or "").strip()):
        if not part:
            continue
        m = re.fullmatch(r"(\d+)-(\d+)", part)
        if m:
            a, b = int(m.group(1)), int(m.group(2))
            if a < 1 or b < a:
                raise ValueError(f"Invalid channel range {part!r}")
            numbers: Iterable[int] = range(a, b + 1)
        elif part.isdigit():
            a = int(part)
            if a < 1:
                raise ValueError("Channel numbers start at 1 (CAN1)")
            numbers = [a]
        else:
            raise ValueError(f"Invalid channel {part!r} (use e.g. 1,2 or 1-4)")
        for c in numbers:
            if c - 1 not in result:
                result.append(c - 1)
    if not result:
        raise ValueError("No CAN channel given")
    return result


