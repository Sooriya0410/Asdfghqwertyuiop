class T32DllInterface(T32Interface):
    """Classic TRACE32 remote API (t32api64.dll / t32api.dll) over TCP."""

    name = "TRACE32 API"

    def __init__(self, dll_path: str, node: str = "localhost", port: int = 20000, packlen: int = 1024):
        super().__init__()
        self.dll_path = dll_path
        self.node = node or "localhost"
        self.port = int(port)
        self.packlen = int(packlen)
        self.api: Any = None

    def _decl(self) -> None:
        import ctypes as ct
        api = self.api
        api.T32_Config.argtypes = [ct.c_char_p, ct.c_char_p]
        api.T32_Config.restype = ct.c_int
        api.T32_Init.restype = ct.c_int
        api.T32_Attach.argtypes = [ct.c_int]
        api.T32_Attach.restype = ct.c_int
        api.T32_Ping.restype = ct.c_int
        api.T32_Exit.restype = ct.c_int
        api.T32_Cmd.argtypes = [ct.c_char_p]
        api.T32_Cmd.restype = ct.c_int
        api.T32_GetState.argtypes = [ct.POINTER(ct.c_int)]
        api.T32_GetState.restype = ct.c_int
        api.T32_EvalGet.argtypes = [ct.POINTER(ct.c_uint32)]
        api.T32_EvalGet.restype = ct.c_int
        api.T32_GetMessage.argtypes = [ct.c_char_p, ct.POINTER(ct.c_uint16)]
        api.T32_GetMessage.restype = ct.c_int
        api.T32_ReadVariableValue.argtypes = [ct.c_char_p, ct.POINTER(ct.c_uint32), ct.POINTER(ct.c_uint32)]
        api.T32_ReadVariableValue.restype = ct.c_int
        for name in ("T32_ReadVariableString", "T32_GetSymbol", "T32_ReadMemory", "T32_GetPracticeState"):
            fn = getattr(api, name, None)
            if fn is None:
                continue
            if name == "T32_ReadVariableString":
                fn.argtypes = [ct.c_char_p, ct.c_char_p, ct.c_int]
            elif name == "T32_GetSymbol":
                fn.argtypes = [ct.c_char_p, ct.POINTER(ct.c_uint32), ct.POINTER(ct.c_uint32), ct.POINTER(ct.c_uint32)]
            elif name == "T32_ReadMemory":
                fn.argtypes = [ct.c_uint32, ct.c_int, ct.POINTER(ct.c_ubyte), ct.c_int]
            else:
                fn.argtypes = [ct.POINTER(ct.c_int)]
            fn.restype = ct.c_int

    @staticmethod
    def _ck(rc: int, what: str) -> None:
        if rc != 0:
            raise T32Error(f"{what} failed (TRACE32 error {rc})")

    def connect(self) -> None:
        import ctypes as ct
        with self._lock:
            if self.connected:
                return
            if not self.dll_path or not os.path.isfile(self.dll_path):
                raise T32Error(f"TRACE32 API library not found: {self.dll_path or '(no path)'}")
            try:
                self.api = ct.cdll.LoadLibrary(self.dll_path)
            except OSError as exc:
                raise T32Error(f"Cannot load {self.dll_path}: {exc} "
                               f"(use t32api64.dll with 64-bit Python, t32api.dll with 32-bit Python)") from exc
            self._decl()
            self._ck(self.api.T32_Config(b"NODE=", self.node.encode()), "T32_Config NODE")
            self._ck(self.api.T32_Config(b"PORT=", str(self.port).encode()), "T32_Config PORT")
            self._ck(self.api.T32_Config(b"PACKLEN=", str(self.packlen).encode()), "T32_Config PACKLEN")
            if self.api.T32_Init() != 0:
                raise T32Error("T32_Init failed - start TRACE32 and enable the API port in its config file "
                               "(RCL=NETASSIST, PORT=20000, PACKLEN=1024)")
            if self.api.T32_Attach(T32_DEV_ICD) != 0:
                self.api.T32_Exit()
                raise T32Error("T32_Attach failed - no debugger instance on that port")
            if self.api.T32_Ping() != 0:
                self.api.T32_Exit()
                raise T32Error("TRACE32 does not answer (ping failed)")
            self.connected = True

    def disconnect(self) -> None:
        with self._lock:
            if self.api is not None and self.connected:
                try:
                    self.api.T32_Exit()
                except Exception:
                    pass
            self.connected = False
            self.api = None

    def _require(self) -> Any:
        if not self.connected or self.api is None:
            raise T32Error("Not connected to TRACE32")
        return self.api

    def state(self) -> Tuple[int, str]:
        import ctypes as ct
        with self._lock:
            api = self._require()
            st = ct.c_int(-1)
            self._ck(api.T32_GetState(ct.byref(st)), "T32_GetState")
            return st.value, T32_STATES.get(st.value, f"state {st.value}")

    def practice_state(self) -> str:
        import ctypes as ct
        fn = getattr(self.api, "T32_GetPracticeState", None) if self.api else None
        if fn is None:
            return "-"
        with self._lock:
            st = ct.c_int(-1)
            if fn(ct.byref(st)) != 0:
                return "-"
            return T32_PRACTICE_STATES.get(st.value, str(st.value))

    def message(self) -> str:
        import ctypes as ct
        with self._lock:
            api = self._require()
            buf = ct.create_string_buffer(256)
            mode = ct.c_uint16(0)
            if api.T32_GetMessage(buf, ct.byref(mode)) != 0:
                return ""
            return buf.value.decode("latin-1").strip()

    def cmd(self, command: str) -> str:
        with self._lock:
            api = self._require()
            rc = api.T32_Cmd(command.encode("latin-1"))
            text = self.message()
            if rc != 0:
                raise T32Error(f"'{command}' rejected (error {rc}){': ' + text if text else ''}")
            return text

    def evaluate(self, expression: str) -> Tuple[int, str]:
        import ctypes as ct
        with self._lock:
            api = self._require()
            self.cmd(f"Eval {expression}")
            val = ct.c_uint32(0)
            self._ck(api.T32_EvalGet(ct.byref(val)), "T32_EvalGet")
            return val.value, f"{val.value} / 0x{val.value:X}"

    def read_variable(self, symbol: str, fmt: str = "auto") -> Tuple[str, Optional[float]]:
        import ctypes as ct
        with self._lock:
            api = self._require()
            fn = getattr(api, "T32_ReadVariableString", None)
            if fn is not None:
                buf = ct.create_string_buffer(512)
                if fn(symbol.encode("latin-1"), buf, 512) == 0:
                    return format_t32_text(buf.value.decode("latin-1").strip(), fmt)
            lo, hi = ct.c_uint32(0), ct.c_uint32(0)
            rc = api.T32_ReadVariableValue(symbol.encode("latin-1"), ct.byref(lo), ct.byref(hi))
            if rc != 0:
                raise T32Error(f"'{symbol}' not readable (error {rc}) - check the symbol name and that the "
                               f"program/debug symbols are loaded")
            return format_t32_raw((hi.value << 32) | lo.value, fmt)

    def symbol_info(self, symbol: str) -> Tuple[int, int]:
        import ctypes as ct
        with self._lock:
            api = self._require()
            fn = getattr(api, "T32_GetSymbol", None)
            if fn is None:
                raise T32Error("T32_GetSymbol is not available in this API library")
            addr, size, access = ct.c_uint32(0), ct.c_uint32(0), ct.c_uint32(0)
            rc = fn(symbol.encode("latin-1"), ct.byref(addr), ct.byref(size), ct.byref(access))
            if rc != 0:
                raise T32Error(f"Symbol '{symbol}' not found (error {rc})")
            return addr.value, size.value

    def read_memory(self, address: int, length: int, access: int = 0) -> bytes:
        import ctypes as ct
        with self._lock:
            api = self._require()
            fn = getattr(api, "T32_ReadMemory", None)
            if fn is None:
                raise T32Error("T32_ReadMemory is not available in this API library")
            length = max(1, min(int(length), 4096))
            buf = (ct.c_ubyte * length)()
            rc = fn(ct.c_uint32(int(address)), ct.c_int(int(access)), buf, ct.c_int(length))
            if rc != 0:
                raise T32Error(f"Reading {length} byte(s) at 0x{address:X} failed (error {rc})")
            return bytes(bytearray(buf))


class T32SimInterface(T32Interface):
    """Software TRACE32 for the demo mode and the self-tests."""

    name = "simulated TRACE32"
    DEMO_SYMBOLS = ("BswM_CurrentState", "Adc_BatteryVoltage", "Os_Counter", "Dem_EventStatus", "SwVersion")

    def __init__(self) -> None:
        super().__init__()
        self.t0 = time.monotonic()
        self.running = True
        self.commands: List[str] = []
        self.memory = bytes(range(256))

    def connect(self) -> None:
        self.connected = True
        self.t0 = time.monotonic()

    def disconnect(self) -> None:
        self.connected = False

    def _t(self) -> float:
        return time.monotonic() - self.t0

    def state(self) -> Tuple[int, str]:
        if not self.connected:
            return 0, T32_STATES[0]
        return (3, T32_STATES[3]) if self.running else (2, T32_STATES[2])

    def practice_state(self) -> str:
        return "not running"

    def cmd(self, command: str) -> str:
        if not self.connected:
            raise T32Error("Not connected to TRACE32")
        self.commands.append(command)
        low = command.strip().lower()
        if low.startswith("go"):
            self.running = True
        elif low.startswith(("break", "b::break")):
            self.running = False
        return f"{command} (simulated)"

    def evaluate(self, expression: str) -> Tuple[int, str]:
        self.cmd(f"Eval {expression}")
        value = abs(hash(expression)) % 0x10000
        return value, f"{value} / 0x{value:X}"

    def read_variable(self, symbol: str, fmt: str = "auto") -> Tuple[str, Optional[float]]:
        if not self.connected:
            raise T32Error("Not connected to TRACE32")
        s = symbol.strip()
        low = s.lower()
        t = self._t()
        if "version" in low:
            return format_t32_text("1.2.3", fmt if fmt != "auto" else "string")
        if "voltage" in low or "adc" in low:
            return format_t32_text(f"{13.5 + 0.4 * math.sin(t):.3f}", fmt)
        if "counter" in low or "tick" in low:
            return format_t32_raw(int(t * 100), fmt)
        if "state" in low or "mode" in low:
            return format_t32_raw(int(t) % 4, fmt)
        if "dem" in low or "dtc" in low or "event" in low:
            return format_t32_raw((int(t) // 3) % 2, fmt)
        raise T32Error(f"symbol '{symbol}' not found (the simulator knows: {', '.join(self.DEMO_SYMBOLS)})")

    def symbol_info(self, symbol: str) -> Tuple[int, int]:
        self.read_variable(symbol)
        return 0x70000000 + (abs(hash(symbol)) % 0x1000) * 4, 4

    def read_memory(self, address: int, length: int, access: int = 0) -> bytes:
        start = address % 256
        data = (self.memory * 32)[start:start + max(1, min(int(length), 4096))]
        return data


@dataclass
class T32VarSpec:
    symbol: str
    fmt: str = "auto"
    enabled: bool = True

    def to_text(self) -> str:
        return f"{self.symbol}\t{self.fmt}\t{int(self.enabled)}"

    @staticmethod
    def from_text(line: str) -> Optional["T32VarSpec"]:
        parts = [p.strip() for p in re.split(r"[\t;,]", line.strip()) if p.strip()]
        if not parts or parts[0].startswith("#"):
            return None
        fmt = parts[1].lower() if len(parts) > 1 and parts[1].lower() in T32_FORMATS else "auto"
        enabled = True if len(parts) < 3 else parts[2] not in ("0", "off", "false", "no")
        return T32VarSpec(parts[0], fmt, enabled)


class T32Monitor(threading.Thread):
    """Polls TRACE32 variables, keeps a history for plotting and records them to CSV."""

    def __init__(self, iface: T32Interface, period_s: float = 0.2,
                 on_sample: Optional[Callable[[float, Dict[str, str], List[str]], None]] = None,
                 on_error: Optional[Callable[[str], None]] = None, history_len: int = 5000):
        super().__init__(name="T32-Monitor", daemon=True)
        self.iface = iface
        self.period_s = max(0.02, float(period_s))
        self.on_sample = on_sample
        self.on_error = on_error
        self.history_len = history_len
        self.history: Dict[str, "collections.deque[Tuple[float, Optional[float], str]]"] = {}
        self.last: Dict[str, str] = {}
        self.last_change: Dict[str, float] = {}
        self.change_count: Dict[str, int] = {}
        self.samples = 0
        self.changes = 0
        self.rows = 0
        self.csv_path: Optional[str] = None
        self.record_changes_only = False
        self.t0: Optional[float] = None
        self._specs: List[T32VarSpec] = []
        self._header: List[str] = []
        self._csv: Any = None
        self._fh: Any = None
        self._lock = threading.Lock()
        self._stop_evt = threading.Event()

    # -- configuration --------------------------------------------------------
    def set_variables(self, specs: Sequence[T32VarSpec]) -> None:
        with self._lock:
            self._specs = list(specs)
            for spec in self._specs:
                self.history.setdefault(spec.symbol, collections.deque(maxlen=self.history_len))

    @property
    def recording(self) -> bool:
        return self._csv is not None

    def start_recording(self, path: str, changes_only: bool = False) -> None:
        with self._lock:
            if self._csv is not None:
                raise RuntimeError(f"Already recording to {self.csv_path}")
            os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
            self._header = [s.symbol for s in self._specs if s.enabled]
            self._fh = open(path, "w", newline="", encoding="utf-8-sig")
            self._csv = csv.writer(self._fh)
            self._csv.writerow(["timestamp", "time_s"] + self._header + ["changed"])
            self.csv_path = path
            self.record_changes_only = changes_only
            self.rows = 0

    def stop_recording(self) -> Tuple[Optional[str], int]:
        with self._lock:
            fh, self._csv, self._fh = self._fh, None, None
            path, rows = self.csv_path, self.rows
        if fh is not None:
            try:
                fh.close()
            except Exception:
                pass
            return path, rows
        return None, 0

    # -- sampling -------------------------------------------------------------
    def sample_once(self) -> Tuple[float, Dict[str, str], List[str]]:
        with self._lock:
            specs = [s for s in self._specs if s.enabled]
        values: Dict[str, str] = {}
        numbers: Dict[str, Optional[float]] = {}
        changed: List[str] = []
        for spec in specs:
            try:
                text, num = self.iface.read_variable(spec.symbol, spec.fmt)
            except Exception as exc:
                text, num = f"<{exc}>", None
            values[spec.symbol] = text
            numbers[spec.symbol] = num
            if self.last.get(spec.symbol) != text:
                changed.append(spec.symbol)
                self.last[spec.symbol] = text
                self.change_count[spec.symbol] = self.change_count.get(spec.symbol, 0) + 1
        now = time.time()
        with self._lock:
            if self.t0 is None:
                self.t0 = now
            self.samples += 1
            self.changes += len(changed)
            for sym in values:
                dq = self.history.setdefault(sym, collections.deque(maxlen=self.history_len))
                dq.append((now, numbers[sym], values[sym]))
            for sym in changed:
                self.last_change[sym] = now
            self._write_row(now, values, changed)
        return now, values, changed

    def _write_row(self, now: float, values: Dict[str, str], changed: List[str]) -> None:
        if self._csv is None:
            return
        if self.record_changes_only and not changed:
            return
        row = [_dt.datetime.fromtimestamp(now).isoformat(timespec="milliseconds"),
               f"{now - (self.t0 or now):.3f}"]
        row += [values.get(sym, "") for sym in self._header]
        row.append(" ".join(changed))
        try:
            self._csv.writerow(row)
            self._fh.flush()
            self.rows += 1
        except Exception as exc:
            if self.on_error:
                self.on_error(f"Recording failed: {exc}")

    def run(self) -> None:
        while not self._stop_evt.is_set():
            started = time.monotonic()
            try:
                now, values, changed = self.sample_once()
            except Exception as exc:
                if self.on_error:
                    self.on_error(str(exc))
                if self._stop_evt.wait(self.period_s):
                    break
                continue
            if self.on_sample:
                try:
                    self.on_sample(now, values, changed)
                except Exception:
                    pass
            delay = self.period_s - (time.monotonic() - started)
            if self._stop_evt.wait(max(0.0, delay)):
                break

    def start(self) -> "T32Monitor":  # type: ignore[override]
        super().start()
        return self

    def stop(self) -> None:
        self._stop_evt.set()


