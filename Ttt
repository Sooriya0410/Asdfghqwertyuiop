# =============================================================================
# 8. CANalyzer COM automation (dedicated STA worker thread)
# =============================================================================
_RPC_GONE = {-2147023174, -2147417848, -2147023170}  # RPC server unavailable / disconnected / call failed


def _pump() -> None:
    if pythoncom is not None:
        try:
            pythoncom.PumpWaitingMessages()
        except Exception:
            pass


def _is_server_gone(exc: BaseException) -> bool:
    hr = getattr(exc, "hresult", None)
    if hr is None and getattr(exc, "args", None) and isinstance(exc.args[0], int):
        hr = exc.args[0]
    return hr in _RPC_GONE


def _com_bytes(data: bytes) -> Any:
    if _win32 is not None and pythoncom is not None:
        return _win32.VARIANT(pythoncom.VT_ARRAY | pythoncom.VT_UI1, bytes(data))
    return list(data)


class ComWorker(threading.Thread):
    """All COM calls run here (single-threaded apartment, message pump)."""

    def __init__(self):
        super().__init__(name="COM-Worker", daemon=True)
        self._q: "queue.Queue[Any]" = queue.Queue()
        self._stop_evt = threading.Event()
        self.app: Any = None

    def run(self) -> None:
        com_init = pythoncom is not None
        if com_init:
            pythoncom.CoInitialize()
        try:
            while not self._stop_evt.is_set():
                try:
                    item = self._q.get(timeout=0.05)
                except queue.Empty:
                    _pump()
                    continue
                if item is None:
                    break
                fn, fut = item
                if not fut.set_running_or_notify_cancel():
                    continue
                try:
                    fut.set_result(fn(self))
                except BaseException as exc:
                    fut.set_exception(exc)
        finally:
            self.app = None
            while True:
                try:
                    item = self._q.get_nowait()
                except queue.Empty:
                    break
                if item is not None and not item[1].done():
                    item[1].set_exception(RuntimeError("COM worker stopped"))
            if com_init:
                try:
                    pythoncom.CoUninitialize()
                except Exception:
                    pass

    def submit(self, fn: Callable[["ComWorker"], Any]) -> "concurrent.futures.Future[Any]":
        fut: "concurrent.futures.Future[Any]" = concurrent.futures.Future()
        if self._stop_evt.is_set() or not self.is_alive():
            fut.set_exception(RuntimeError("COM worker is not running"))
            return fut
        self._q.put((fn, fut))
        return fut

    def stop(self) -> None:
        self._stop_evt.set()
        self._q.put(None)


class CanalyzerController:
    """High level CANalyzer operations; every method returns a Future."""

    DEFAULT_PROGID = "CANalyzer.Application"

    def __init__(self, dispatch_factory: Optional[Callable[[str], Any]] = None):
        self._factory = dispatch_factory or self._default_dispatch
        self.worker = ComWorker()
        self.worker.start()
        self.connected = False

    @staticmethod
    def _default_dispatch(progid: str) -> Any:
        if _win32 is None:
            raise RuntimeError("pywin32 is not available (Windows only): pip install pywin32")
        return _win32.Dispatch(progid)

    def submit(self, fn: Callable[[ComWorker], Any]) -> "concurrent.futures.Future[Any]":
        return self.worker.submit(fn)

    def shutdown(self) -> None:
        self.worker.stop()

    @staticmethod
    def _app(w: ComWorker) -> Any:
        if w.app is None:
            raise RuntimeError("Not connected to CANalyzer")
        return w.app

    @staticmethod
    def _wait(pred: Callable[[], bool], timeout: float, what: str) -> None:
        deadline = time.monotonic() + timeout
        while not pred():
            if time.monotonic() > deadline:
                raise TimeoutError(f"Timeout after {timeout:g} s waiting for {what}")
            _pump()
            time.sleep(0.1)

    # -- connection -----------------------------------------------------------
    def connect(self, progid: str = DEFAULT_PROGID) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            w.app = self._factory(progid)
            self.connected = True
            return self._info(w)
        return self.submit(job)

    def disconnect(self) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> bool:
            w.app = None
            self.connected = False
            return True
        return self.submit(job)

    def info(self) -> "concurrent.futures.Future[Any]":
        return self.submit(self._info)

    def _info(self, w: ComWorker) -> Dict[str, Any]:
        app = self._app(w)
        try:
            running = bool(app.Measurement.Running)
        except Exception as exc:
            if _is_server_gone(exc):
                w.app = None
                self.connected = False
            raise RuntimeError(f"CANalyzer not reachable: {exc}") from exc
        ver = _safe(lambda: str(app.Version.FullName), "")
        if not ver:
            ver = _safe(lambda: f"{app.Version.Major}.{app.Version.Minor}.{app.Version.Build}", "?")
        return {
            "version": ver,
            "config": _safe(lambda: str(app.Configuration.FullName), ""),
            "config_name": _safe(lambda: str(app.Configuration.Name), ""),
            "modified": bool(_safe(lambda: app.Configuration.Modified, False)),
            "running": running,
            "visible": bool(_safe(lambda: app.Visible, True)),
        }

    def toggle_visible(self) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> bool:
            app = self._app(w)
            app.Visible = not bool(app.Visible)
            return bool(app.Visible)
        return self.submit(job)

    def quit_app(self, timeout: float = 60.0) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> bool:
            app = self._app(w)
            m = app.Measurement
            if bool(m.Running):
                m.Stop()
                self._wait(lambda: not bool(m.Running), timeout, "measurement stop")
            app.Quit()
            w.app = None
            self.connected = False
            return True
        return self.submit(job)

    # -- configuration --------------------------------------------------------
    def open_config(self, path: str, timeout: float = 60.0) -> "concurrent.futures.Future[Any]":
        path = os.path.abspath(path)

        def job(w: ComWorker) -> Dict[str, Any]:
            if not os.path.isfile(path):
                raise FileNotFoundError(f"Configuration not found: {path}")
            app = self._app(w)
            m = app.Measurement
            if bool(m.Running):
                m.Stop()
                self._wait(lambda: not bool(m.Running), timeout, "measurement stop")
            app.Open(path, False, False)
            return self._info(w)
        return self.submit(job)

    def save_config(self) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            self._app(w).Configuration.Save()
            return self._info(w)
        return self.submit(job)

    def save_config_as(self, path: str) -> "concurrent.futures.Future[Any]":
        path = os.path.abspath(path)

        def job(w: ComWorker) -> Dict[str, Any]:
            app = self._app(w)
            major = int(_safe(lambda: app.Version.Major, 0) or 0)
            minor = int(_safe(lambda: app.Version.Minor, 0) or 0)
            app.Configuration.SaveAs(path, major, minor, False)
            return self._info(w)
        return self.submit(job)

    # -- measurement ------------------------------------------------------------
    def start_measurement(self, timeout: float = 60.0) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            m = self._app(w).Measurement
            if not bool(m.Running):
                m.Start()
                self._wait(lambda: bool(m.Running), timeout, "measurement start (check CAPL/compile errors)")
            return self._info(w)
        return self.submit(job)

    def stop_measurement(self, timeout: float = 60.0) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            m = self._app(w).Measurement
            if bool(m.Running):
                m.Stop()
                self._wait(lambda: not bool(m.Running), timeout, "measurement stop")
            return self._info(w)
        return self.submit(job)

    def restart_measurement(self, timeout: float = 60.0) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            m = self._app(w).Measurement
            if bool(m.Running):
                m.Stop()
                self._wait(lambda: not bool(m.Running), timeout, "measurement stop")
            m.Start()
            self._wait(lambda: bool(m.Running), timeout, "measurement start")
            return self._info(w)
        return self.submit(job)

    def compile_capl(self) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            capl = self._app(w).CAPL
            capl.Compile()
            r = _safe(lambda: capl.CompileResult)
            if r is None:
                return {"result": 0, "error": "", "node": "", "file": ""}
            return {"result": int(_safe(lambda: r.result, 0) or 0),
                    "error": str(_safe(lambda: r.errorMessage, "") or ""),
                    "node": str(_safe(lambda: r.nodeName, "") or ""),
                    "file": str(_safe(lambda: r.sourceFile, "") or "")}
        return self.submit(job)

    # -- system variables / signals -------------------------------------------
    @staticmethod
    def _sysvar(app: Any, path: str) -> Any:
        parts = [p.strip() for p in (path or "").split("::") if p.strip()]
        if len(parts) < 2:
            raise ValueError("System variable must be 'Namespace::Variable' (nested: 'A::B::Var')")
        ns = app.System.Namespaces.Item(parts[0])
        for p in parts[1:-1]:
            ns = ns.Namespaces.Item(p)
        return ns.Variables.Item(parts[-1])

    def get_sysvar(self, path: str) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._sysvar(self._app(w), path).Value)

    def set_sysvar(self, path: str, text: str) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Any:
            var = self._sysvar(self._app(w), path)
            var.Value = coerce_like(_safe(lambda: var.Value), text)
            return var.Value
        return self.submit(job)

    def get_signal(self, channel: int, message: str, signal: str) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> Dict[str, Any]:
            sig = self._app(w).GetBus("CAN").GetSignal(int(channel), message, signal)
            return {"value": _safe(lambda: sig.Value), "raw": _safe(lambda: sig.RawValue),
                    "online": _safe(lambda: bool(sig.IsOnline))}
        return self.submit(job)

    # -- write window -----------------------------------------------------------
    def write_output(self, text: str) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._app(w).UI.Write.Output(str(text)))

    def clear_write(self) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._app(w).UI.Write.Clear())

    def read_write_text(self) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: str(self._app(w).UI.Write.Text))

    # -- native logging blocks ------------------------------------------------
    @staticmethod
    def _logging(app: Any) -> Any:
        return app.Configuration.OnlineSetup.LoggingCollection

    def _list_logging(self, app: Any) -> List[Tuple[int, str]]:
        coll = self._logging(app)
        return [(i, str(_safe(lambda i=i: coll.Item(i).FullName, "?"))) for i in range(1, int(coll.Count) + 1)]

    def list_logging_blocks(self) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._list_logging(self._app(w)))

    def set_logging_file(self, index: int, path: str) -> "concurrent.futures.Future[Any]":
        path = os.path.abspath(path)

        def job(w: ComWorker) -> List[Tuple[int, str]]:
            app = self._app(w)
            if bool(app.Measurement.Running):
                raise RuntimeError("Stop the measurement before changing the logging file")
            self._logging(app).Item(int(index)).FullName = path
            return self._list_logging(app)
        return self.submit(job)

    def add_logging_block(self, path: str) -> "concurrent.futures.Future[Any]":
        path = os.path.abspath(path)

        def job(w: ComWorker) -> List[Tuple[int, str]]:
            app = self._app(w)
            if bool(app.Measurement.Running):
                raise RuntimeError("Stop the measurement before adding a logging block")
            self._logging(app).Add(path)
            return self._list_logging(app)
        return self.submit(job)

    def logging_trigger(self, index: int, start: bool) -> "concurrent.futures.Future[Any]":
        def job(w: ComWorker) -> bool:
            trig = self._logging(self._app(w)).Item(int(index)).Trigger
            if start:
                trig.Start()
            else:
                trig.Stop()
            return True
        return self.submit(job)

    # -- diagnostics ------------------------------------------------------------
    @staticmethod
    def _find_diagnostic(app: Any, ecu: str) -> Any:
        try:
            nets = app.Networks
            count = int(nets.Count)
        except Exception as exc:
            raise DiagError("This CANalyzer exposes no diagnostic COM objects - use 'Python ISO-TP'") from exc
        for i in range(1, count + 1):
            try:
                return nets.Item(i).Devices.Item(ecu).Diagnostic
            except Exception:
                continue
        raise DiagError(f"ECU qualifier '{ecu}' not found - check the CANalyzer diagnostic configuration "
                        f"or use 'Python ISO-TP'")

    def list_ecus(self) -> "concurrent.futures.Future[Any]":
        """ECUs of the loaded configuration that have a diagnostic description: [(network, ecu), ...]."""
        def job(w: ComWorker) -> List[Tuple[str, str]]:
            app = self._app(w)
            try:
                nets = app.Networks
                net_count = int(nets.Count)
            except Exception as exc:
                raise DiagError("This CANalyzer exposes no diagnostic COM objects - use 'Python ISO-TP'") from exc
            found: List[Tuple[str, str]] = []
            for i in range(1, net_count + 1):
                net = _safe(lambda i=i: nets.Item(i))
                if net is None:
                    continue
                net_name = str(_safe(lambda: net.Name, f"Network{i}") or f"Network{i}")
                devices = _safe(lambda: net.Devices)
                if devices is None:
                    continue
                for j in range(1, int(_safe(lambda: devices.Count, 0) or 0) + 1):
                    dev = _safe(lambda j=j: devices.Item(j))
                    if dev is None:
                        continue
                    name = str(_safe(lambda: dev.Name, "") or "")
                    if name and _safe(lambda: dev.Diagnostic) is not None:
                        found.append((net_name, name))
            return found
        return self.submit(job)

    def _diag_exec(self, w: ComWorker, ecu: str, factory: Callable[[Any], Any],
                   expect_response: bool, timeout: float) -> Optional[bytes]:
        app = self._app(w)
        if not bool(_safe(lambda: app.Measurement.Running, False)):
            raise DiagError("CANalyzer measurement is not running")
        diag = self._find_diagnostic(app, ecu)
        req = factory(diag)
        req.Send()
        deadline = time.monotonic() + timeout
        while bool(req.Pending):
            if time.monotonic() > deadline:
                raise DiagTimeout(f"CANalyzer: no response within {timeout:g} s")
            _pump()
            time.sleep(0.005)
        if not expect_response:
            return None
        responses = req.Responses
        if int(responses.Count) < 1:
            raise DiagTimeout("CANalyzer: request finished without a response")
        return bytes(bytearray(responses.Item(1).Stream))

    @staticmethod
    def _descriptions(app: Any) -> Any:
        try:
            return app.Configuration.GeneralSetup.DiagnosticsSetup.DiagnosticDescriptions
        except Exception as exc:
            raise RuntimeError("This CANalyzer version does not expose the diagnostic descriptions over COM - "
                               "add the CDD in CANalyzer (Diagnostics > Diagnostic/ISO TP configuration)") from exc

    def _list_cdds(self, app: Any) -> List[Tuple[int, str]]:
        coll = self._descriptions(app)
        out: List[Tuple[int, str]] = []
        for i in range(1, int(_safe(lambda: coll.Count, 0) or 0) + 1):
            item = _safe(lambda i=i: coll.Item(i))
            name = str(_safe(lambda: item.FullName, "") or _safe(lambda: item.Name, "") or "?")
            out.append((i, name))
        return out

    def list_cdds(self) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._list_cdds(self._app(w)))

    def add_cdd(self, path: str, bus: str = "CAN", ecu: str = "") -> "concurrent.futures.Future[Any]":
        """Add a .cdd / .odx / .pdx diagnostic description to the loaded configuration."""
        path = os.path.abspath(path)

        def job(w: ComWorker) -> List[Tuple[int, str]]:
            if not os.path.isfile(path):
                raise FileNotFoundError(f"Diagnostic description not found: {path}")
            app = self._app(w)
            if bool(_safe(lambda: app.Measurement.Running, False)):
                raise RuntimeError("Stop the measurement before adding a diagnostic description")
            coll = self._descriptions(app)
            attempts: List[Tuple[Any, ...]] = []
            if ecu.strip():
                attempts.append((path, bus, ecu.strip()))
            attempts += [(path, bus), (path,)]
            errors: List[str] = []
            for args in attempts:
                try:
                    coll.Add(*args)
                    return self._list_cdds(app)
                except Exception as exc:
                    errors.append(f"Add({len(args)} argument(s)): {exc}")
            raise RuntimeError("CANalyzer refused the diagnostic description - " + " | ".join(errors))
        return self.submit(job)

    def diag_request(self, ecu: str, payload: bytes, expect_response: bool = True,
                     timeout: float = 5.0) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._diag_exec(
            w, ecu, lambda d: d.CreateRequestFromStream(_com_bytes(payload)), expect_response, timeout))

    def diag_request_named(self, ecu: str, qualifier: str,
                           timeout: float = 5.0) -> "concurrent.futures.Future[Any]":
        return self.submit(lambda w: self._diag_exec(
            w, ecu, lambda d: d.CreateRequest(qualifier), True, timeout))


# =============================================================================
# 8b. Embedding CANalyzer's floating windows into this panel (Windows only)
#     The user makes a CANalyzer window floating (drag the window tab out of the
#     main frame). It then is a normal top level window of the CANalyzer process
#     and can be re-parented into a Tk frame with SetParent(). Detaching puts it
#     back exactly where it was.
# =============================================================================
_user32: Any = None
_kernel32: Any = None
if sys.platform == "win32":  # pragma: no cover - Windows only
    try:
        import ctypes
        from ctypes import wintypes
        _user32 = ctypes.windll.user32
        _kernel32 = ctypes.windll.kernel32
    except Exception:
        _user32 = _kernel32 = None

GWL_STYLE, GWL_EXSTYLE = -16, -20
WS_CHILD, WS_POPUP = 0x40000000, 0x80000000
WS_CAPTION, WS_THICKFRAME, WS_SYSMENU, WS_VISIBLE = 0x00C00000, 0x00040000, 0x00080000, 0x10000000
WS_MINIMIZEBOX, WS_MAXIMIZEBOX, WS_BORDER, WS_DLGFRAME = 0x00020000, 0x00010000, 0x00800000, 0x00400000
SWP_NOSIZE, SWP_NOMOVE, SWP_NOZORDER, SWP_FRAMECHANGED, SWP_SHOWWINDOW = 0x0001, 0x0002, 0x0004, 0x0020, 0x0040
SW_HIDE, SW_SHOWNORMAL, SW_SHOW, SW_RESTORE = 0, 1, 5, 9


@dataclass
class WindowInfo:
    hwnd: int
    title: str
    cls: str
    pid: int
    docked: bool = False

    @property
    def label(self) -> str:
        return f"{'docked | ' if self.docked else ''}{self.title}   [{self.cls}]  0x{self.hwnd:X}"

    def matches(self, keywords: Sequence[str]) -> bool:
        t = f"{self.title} {self.cls}".lower()
        return any(k.lower() in t for k in keywords)


class Win32Windows:
    """Finds the windows of the running CANalyzer process."""

    HOST_PREFIXES = ("canalyzer", "canoe")
    _ready = False
    _get_long: Any = None
    _set_long: Any = None

    @staticmethod
    def available() -> bool:
        return _user32 is not None

    @classmethod
    def _check(cls) -> None:
        if not cls.available():
            raise RuntimeError("Embedding CANalyzer windows works on Windows only")
        if not cls._ready:
            cls._init()

    @classmethod
    def _init(cls) -> None:  # pragma: no cover - Windows only
        u = _user32
        u.EnumWindows.argtypes = [ctypes.c_void_p, wintypes.LPARAM]
        u.EnumChildWindows.argtypes = [wintypes.HWND, ctypes.c_void_p, wintypes.LPARAM]
        u.GetWindowTextW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
        u.GetWindowTextLengthW.argtypes = [wintypes.HWND]
        u.GetClassNameW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
        u.GetWindowThreadProcessId.argtypes = [wintypes.HWND, ctypes.POINTER(wintypes.DWORD)]
        u.GetWindowThreadProcessId.restype = wintypes.DWORD
        u.IsWindowVisible.argtypes = [wintypes.HWND]
        u.IsWindow.argtypes = [wintypes.HWND]
        u.SetParent.argtypes = [wintypes.HWND, wintypes.HWND]
        u.SetParent.restype = wintypes.HWND
        u.GetParent.argtypes = [wintypes.HWND]
        u.GetParent.restype = wintypes.HWND
        u.SetWindowPos.argtypes = [wintypes.HWND, wintypes.HWND, ctypes.c_int, ctypes.c_int,
                                   ctypes.c_int, ctypes.c_int, ctypes.c_uint]
        u.MoveWindow.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, wintypes.BOOL]
        u.ShowWindow.argtypes = [wintypes.HWND, ctypes.c_int]
        u.GetWindowRect.argtypes = [wintypes.HWND, ctypes.POINTER(wintypes.RECT)]
        u.AttachThreadInput.argtypes = [wintypes.DWORD, wintypes.DWORD, wintypes.BOOL]
        u.SetForegroundWindow.argtypes = [wintypes.HWND]
        cls._get_long = getattr(u, "GetWindowLongPtrW", u.GetWindowLongW)
        cls._set_long = getattr(u, "SetWindowLongPtrW", u.SetWindowLongW)
        cls._get_long.argtypes = [wintypes.HWND, ctypes.c_int]
        cls._get_long.restype = ctypes.c_ssize_t
        cls._set_long.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_ssize_t]
        cls._set_long.restype = ctypes.c_ssize_t
        cls._ready = True

    @classmethod
    def _enum(cls, parent: Optional[int] = None) -> List[WindowInfo]:  # pragma: no cover - Windows only
        cls._check()
        found: List[WindowInfo] = []
        proto = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)

        def collect(hwnd: Any, _lparam: Any) -> bool:
            try:
                if not _user32.IsWindowVisible(hwnd):
                    return True
                n = _user32.GetWindowTextLengthW(hwnd)
                title = ""
                if n:
                    buf = ctypes.create_unicode_buffer(n + 1)
                    _user32.GetWindowTextW(hwnd, buf, n + 1)
                    title = buf.value
                cbuf = ctypes.create_unicode_buffer(256)
                _user32.GetClassNameW(hwnd, cbuf, 256)
                pid = wintypes.DWORD()
                _user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                found.append(WindowInfo(int(hwnd), title, cbuf.value, int(pid.value), docked=parent is not None))
            except Exception:
                pass
            return True

        callback = proto(collect)
        if parent is None:
            _user32.EnumWindows(callback, 0)
        else:
            _user32.EnumChildWindows(wintypes.HWND(parent), callback, 0)
        return found

    @classmethod
    def main_windows(cls) -> List[WindowInfo]:
        return [w for w in cls._enum() if w.title.lower().startswith(cls.HOST_PREFIXES)]

    @classmethod
    def list_candidates(cls, include_docked: bool = False) -> List[WindowInfo]:
        """All windows of the CANalyzer process that can be embedded here."""
        tops = cls._enum()
        mains = [w for w in tops if w.title.lower().startswith(cls.HOST_PREFIXES)]
        if not mains:
            raise RuntimeError("No running CANalyzer found - start CANalyzer (and connect on the CANalyzer tab) first")
        pids = {w.pid for w in mains}
        main_hwnds = {w.hwnd for w in mains}
        out = [w for w in tops if w.pid in pids and w.hwnd not in main_hwnds and w.title.strip()]
        if include_docked:
            seen = {w.hwnd for w in out} | main_hwnds
            for m in mains:
                for c in cls._enum(m.hwnd):
                    if c.hwnd not in seen and c.title.strip():
                        out.append(c)
                        seen.add(c.hwnd)
        return out


class EmbeddedWindow:
    """One CANalyzer window re-parented into a Tk frame (restored on detach)."""

    def __init__(self, info: WindowInfo, container_hwnd: int):
        Win32Windows._check()
        self.info = info
        self.hwnd = int(info.hwnd)
        self.container = int(container_hwnd)
        h = wintypes.HWND(self.hwnd)
        if not _user32.IsWindow(h):
            raise RuntimeError("The window no longer exists - refresh the list")
        self.old_parent = int(_user32.GetParent(h) or 0)
        self.old_style = int(Win32Windows._get_long(h, GWL_STYLE))
        rect = wintypes.RECT()
        _user32.GetWindowRect(h, ctypes.byref(rect))
        self.old_rect = (rect.left, rect.top, max(200, rect.right - rect.left), max(150, rect.bottom - rect.top))
        self.attached = False

    def alive(self) -> bool:
        try:
            return bool(_user32.IsWindow(wintypes.HWND(self.hwnd)))
        except Exception:
            return False

    def attach(self, width: int = 0, height: int = 0) -> None:
        h = wintypes.HWND(self.hwnd)
        style = (self.old_style & ~(WS_POPUP | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU
                                    | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_BORDER | WS_DLGFRAME)) | WS_CHILD | WS_VISIBLE
        Win32Windows._set_long(h, GWL_STYLE, style)
        if not _user32.SetParent(h, wintypes.HWND(self.container)):
            Win32Windows._set_long(h, GWL_STYLE, self.old_style)
            raise RuntimeError("SetParent failed - start this panel and CANalyzer with the same user rights "
                               "(both normal or both as administrator)")
        self.attached = True
        _user32.SetWindowPos(h, None, 0, 0, max(1, int(width)), max(1, int(height)),
                             SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_NOZORDER)
        _user32.ShowWindow(h, SW_SHOW)
        self._attach_input(True)

    def resize(self, width: int, height: int) -> None:
        if self.attached and width > 1 and height > 1 and self.alive():
            _user32.MoveWindow(wintypes.HWND(self.hwnd), 0, 0, int(width), int(height), True)

    def detach(self) -> None:
        if not self.attached:
            return
        self.attached = False
        self._attach_input(False)
        if not self.alive():
            return
        h = wintypes.HWND(self.hwnd)
        Win32Windows._set_long(h, GWL_STYLE, self.old_style)
        _user32.SetParent(h, wintypes.HWND(self.old_parent) if self.old_parent else None)
        x, y, w, hgt = self.old_rect
        _user32.SetWindowPos(h, None, x, y, w, hgt, SWP_FRAMECHANGED | SWP_SHOWWINDOW | SWP_NOZORDER)
        _user32.ShowWindow(h, SW_SHOW)

    def _attach_input(self, attach: bool) -> None:
        try:
            tid = _user32.GetWindowThreadProcessId(wintypes.HWND(self.hwnd), None)
            _user32.AttachThreadInput(wintypes.DWORD(tid), wintypes.DWORD(_kernel32.GetCurrentThreadId()),
                                      wintypes.BOOL(attach))
        except Exception:
            pass


# =============================================================================
# 8c. TRACE32 remote API: attach to a running TRACE32, run commands, read
#     variables and record them with time stamps
# =============================================================================
T32_DEV_ICD = 1
T32_STATES = {0: "System down", 1: "System up (no CPU access)", 2: "CPU stopped", 3: "CPU running"}
T32_FORMATS = ("auto", "dec", "hex", "float", "double", "string")
T32_PRACTICE_STATES = {0: "not running", 1: "running", 2: "dialog open"}


class T32Error(Exception):
    """Any TRACE32 remote API problem."""


def find_t32_api() -> List[str]:
    """Likely locations of the TRACE32 remote API library."""
    names = ("t32api64.dll", "t32api.dll") if ctypes_is_64bit() else ("t32api.dll", "t32api64.dll")
    bases: List[str] = []
    for env in ("T32SYS", "T32TMP", "T32ID"):
        v = os.environ.get(env)
        if v:
            bases.append(v)
    bases += [r"C:\T32", r"C:\t32", r"C:\Program Files\T32", r"C:\Program Files (x86)\T32", "/opt/t32"]
    subs = (("bin", "windows64"), ("bin", "windows"), ("bin", "pc_linux64"), ("demo", "api", "capi"), ())
    out: List[str] = []
    for base in bases:
        for sub in subs:
            for name in names + ("libt32api64.so", "libt32api.so"):
                path = os.path.join(base, *sub, name)
                if os.path.isfile(path) and path not in out:
                    out.append(path)
    return out


def ctypes_is_64bit() -> bool:
    return sys.maxsize > 2 ** 32


def t32_text_to_number(text: str) -> Optional[float]:
    """Best effort numeric value of what TRACE32 printed ('0x1F', '42.', '13.500', '1F')."""
    t = (text or "").strip().rstrip(".")
    if not t:
        return None
    m = re.fullmatch(r"([-+]?)0[xX]([0-9A-Fa-f]+)", t)
    if m:
        return float(int(m.group(2), 16)) * (-1.0 if m.group(1) == "-" else 1.0)
    try:
        return float(int(t, 10))
    except ValueError:
        pass
    try:
        return float(t)
    except ValueError:
        pass
    m = re.fullmatch(r"([-+]?)([0-9A-Fa-f]+)[hH]?", t)
    if m:
        try:
            return float(int(m.group(2), 16)) * (-1.0 if m.group(1) == "-" else 1.0)
        except ValueError:
            return None
    return parse_first_float(t)


def format_t32_text(text: str, fmt: str) -> Tuple[str, Optional[float]]:
    num = t32_text_to_number(text)
    if fmt in ("auto", "string") or num is None:
        return text, num
    if fmt == "hex":
        return (f"0x{int(num):X}", num) if float(num).is_integer() else (text, num)
    if fmt == "dec":
        return (str(int(num)), num) if float(num).is_integer() else (f"{num:g}", num)
    return f"{num:g}", num


def format_t32_raw(value: int, fmt: str) -> Tuple[str, Optional[float]]:
    if fmt == "hex":
        return f"0x{value:X}", float(value)
    if fmt == "float":
        f = struct.unpack("<f", (value & 0xFFFFFFFF).to_bytes(4, "little"))[0]
        return f"{f:g}", f
    if fmt == "double":
        d = struct.unpack("<d", (value & 0xFFFFFFFFFFFFFFFF).to_bytes(8, "little"))[0]
        return f"{d:g}", d
    return str(value), float(value)


