class _Obj:
    def __init__(self, **kw: Any):
        self.__dict__.update(kw)


class _FakeColl:
    """COM-like collection: .Count, .Item(1-based index or name), .Add(path)."""

    def __init__(self, items: Optional[Dict[str, Any]] = None):
        self._items: Dict[str, Any] = dict(items or {})

    @property
    def Count(self) -> int:
        return len(self._items)

    def Item(self, key: Any) -> Any:
        if isinstance(key, int):
            return list(self._items.values())[key - 1]
        if key not in self._items:
            raise KeyError(key)
        return self._items[key]

    def Add(self, path: str) -> Any:
        obj = _Obj(FullName=path, Trigger=_FakeTrigger())
        self._items[str(len(self._items) + 1)] = obj
        return obj


