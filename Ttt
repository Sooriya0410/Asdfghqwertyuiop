# 10. DTC export / DTC text import
# =============================================================================
DTC_EXPORT_HEADER = ["#", "DTC (hex)", "SAE", "Status", "Status bits", "Description"]


def dtc_rows(records: Sequence[DtcRecord], texts: Optional[Dict[int, str]] = None) -> List[List[Any]]:
    texts = texts or {}
    return [[i, r.hex, r.sae, f"0x{r.status:02X}", r.status_flags(), texts.get(r.code, "")]
            for i, r in enumerate(records, 1)]


def export_dtcs(path: str, records: Sequence[DtcRecord], meta: Dict[str, str],
                texts: Optional[Dict[int, str]] = None) -> None:
    rows = dtc_rows(records, texts)
    if path.lower().endswith(".xlsx"):
        if openpyxl is None:
            raise RuntimeError("openpyxl is not installed - export as .csv or pip install openpyxl")
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = "DTCs"
        ws.append(DTC_EXPORT_HEADER)
        for cell in ws[1]:
            cell.font = _XlFont(bold=True)
        for r in rows:
            ws.append(r)
        for col, width in zip("ABCDEF", (5, 12, 12, 9, 28, 50)):
            ws.column_dimensions[col].width = width
        ws.freeze_panes = "A2"
        info = wb.create_sheet("Info")
        for k, v in meta.items():
            info.append([k, v])
        info.column_dimensions["A"].width = 26
        info.column_dimensions["B"].width = 90
        wb.save(path)
        return
    with open(path, "w", newline="", encoding="utf-8-sig") as fh:
        w = csv.writer(fh)
        for k, v in meta.items():
            w.writerow([f"# {k}", v])
        w.writerow(DTC_EXPORT_HEADER)
        w.writerows(rows)


def load_dtc_texts(path: str) -> Dict[int, str]:
    """Two columns: DTC (hex '9A1B17' or SAE 'B1A1B-17'), description. Header rows are skipped."""
    rows: List[List[str]] = []
    if path.lower().endswith((".xlsx", ".xlsm")):
        if openpyxl is None:
            raise RuntimeError("openpyxl is not installed")
        wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
        try:
            for r in wb.active.iter_rows(values_only=True):
                rows.append(["" if c is None else str(c) for c in r])
        finally:
            wb.close()
    else:
        with open(path, "r", newline="", encoding="utf-8-sig") as fh:
            rows = [list(r) for r in csv.reader(fh)]
    out: Dict[int, str] = {}
    for r in rows:
        if len(r) < 2:
            continue
        code = parse_dtc_text(r[0])
        if code is not None:
            out[code] = r[1].strip()
    return out


