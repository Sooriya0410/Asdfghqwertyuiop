class DiagTransport:
    name = "base"

    def request(self, payload: bytes, expect_response: bool = True,
                timeout: Optional[float] = None) -> Optional[bytes]:
        raise NotImplementedError

    def send_only(self, payload: bytes, functional: bool = False) -> None:
        self.request(payload, expect_response=False)

    def close(self) -> None:
        pass


@dataclass
class IsoTpConfig:
    tx_id: int = 0x7E0
    rx_id: int = 0x7E8
    extended: bool = False
    channel: Any = None            # python-can channel (0 = CAN1) or None = any
    fd: bool = False
    brs: bool = False
    padding: Optional[int] = 0xCC  # None = no padding (classic CAN only)
    bs: int = 0                    # block size we announce in our FlowControl
    stmin: int = 0                 # STmin byte we announce in our FlowControl
    functional_id: Optional[int] = 0x7DF
    p2_ms: int = 1000
    p2star_ms: int = 5000
    n_bs_ms: int = 1000
    n_cr_ms: int = 1000
    wft_max: int = 10

    def validate(self) -> None:
        bits = 29 if self.extended else 11
        lim = 1 << bits
        for name in ("tx_id", "rx_id"):
            v = getattr(self, name)
            if not 0 <= v < lim:
                raise ValueError(f"{name} 0x{v:X} out of range for {bits}-bit identifiers")
        if self.functional_id is not None and not 0 <= self.functional_id < lim:
            raise ValueError(f"functional_id 0x{self.functional_id:X} out of range for {bits}-bit identifiers")
        if self.tx_id == self.rx_id:
            raise ValueError("Tx and Rx identifiers must differ")
        if self.padding is not None and not 0 <= self.padding <= 0xFF:
            raise ValueError("Padding must be a byte value")
        if not (0 <= self.bs <= 0xFF and 0 <= self.stmin <= 0xFF):
            raise ValueError("BS and STmin must be byte values")
        if self.brs and not self.fd:
            raise ValueError("Bit rate switch requires CAN FD")
        if self.p2_ms <= 0 or self.p2star_ms <= 0:
            raise ValueError("P2 / P2* must be > 0")


VALID_FD_LENGTHS = (0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 24, 32, 48, 64)


def fd_length_ceil(n: int) -> int:
    for size in VALID_FD_LENGTHS:
        if size >= n:
            return size
    raise ValueError(f"CAN FD payload too long: {n} bytes")


def decode_stmin(raw: int) -> float:
    if 0 <= raw <= 0x7F:
        return raw / 1000.0
    if 0xF1 <= raw <= 0xF9:
        return (raw - 0xF0) / 10000.0
    return 0.127  # reserved values -> use the maximum (ISO 15765-2)


class IsoTpTransport(DiagTransport):
    """ISO 15765-2 (normal addressing) on top of a BusManager-like object.

    The bus object needs: subscribe(cb), unsubscribe(cb), send(msg),
    make_message(**kw). Works for classic CAN (8 byte) and CAN FD (64 byte).
    """

    name = "Python ISO-TP"

    def __init__(self, bus: Any, cfg: IsoTpConfig):
        cfg.validate()
        self.bus = bus
        self.cfg = cfg
        self._rxq: "queue.Queue[bytes]" = queue.Queue()
        self._lock = threading.RLock()
        self._closed = False
        bus.subscribe(self._on_frame)

    @property
    def max_dl(self) -> int:
        return 64 if self.cfg.fd else 8

    def close(self) -> None:
        if not self._closed:
            self._closed = True
            try:
                self.bus.unsubscribe(self._on_frame)
            except Exception:
                pass

    # -- frame level ---------------------------------------------------------
    def _on_frame(self, msg: Any) -> None:
        cfg = self.cfg
        if getattr(msg, "is_error_frame", False) or getattr(msg, "is_remote_frame", False):
            return
        if msg.arbitration_id != cfg.rx_id or bool(msg.is_extended_id) != cfg.extended:
            return
        ch = getattr(msg, "channel", None)
        if cfg.channel is not None and ch is not None and ch != cfg.channel:
            return
        self._rxq.put(bytes(msg.data))

    def _flush(self) -> None:
        while True:
            try:
                self._rxq.get_nowait()
            except queue.Empty:
                return

    def _tx(self, payload: bytes, arb_id: Optional[int] = None) -> None:
        cfg = self.cfg
        data = bytes(payload)
        if cfg.fd:
            target = fd_length_ceil(len(data))
            if cfg.padding is not None:
                target = max(target, 8)
            fill = cfg.padding if cfg.padding is not None else 0x00
            data += bytes([fill]) * (target - len(data))
        elif cfg.padding is not None:
            data += bytes([cfg.padding]) * (8 - len(data))
        msg = self.bus.make_message(
            arbitration_id=cfg.tx_id if arb_id is None else arb_id,
            is_extended_id=cfg.extended, data=data, is_fd=cfg.fd,
            bitrate_switch=bool(cfg.fd and cfg.brs), channel=cfg.channel)
        self.bus.send(msg)

    def _send_fc(self, flow_status: int = 0) -> None:
        self._tx(bytes([0x30 | flow_status, self.cfg.bs & 0xFF, self.cfg.stmin & 0xFF]))

    # -- PDU level -----------------------------------------------------------
    def _wait_fc(self) -> Tuple[int, float]:
        cfg = self.cfg
        waits = 0
        deadline = time.monotonic() + cfg.n_bs_ms / 1000.0
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise IsoTpError("N_Bs timeout: no FlowControl from ECU")
            try:
                d = self._rxq.get(timeout=remaining)
            except queue.Empty:
                raise IsoTpError("N_Bs timeout: no FlowControl from ECU") from None
            if not d or (d[0] >> 4) != 0x3:
                continue
            fs = d[0] & 0x0F
            if fs == 0:
                bs = d[1] if len(d) > 1 else 0
                st = d[2] if len(d) > 2 else 0
                return bs, decode_stmin(st)
            if fs == 1:
                waits += 1
                if waits > cfg.wft_max:
                    raise IsoTpError("Too many FlowControl WAIT frames")
                deadline = time.monotonic() + cfg.n_bs_ms / 1000.0
                continue
            if fs == 2:
                raise IsoTpError("FlowControl OVERFLOW: request too long for the ECU buffer")
            raise IsoTpError(f"Invalid FlowControl status {fs}")

    def _send_pdu(self, payload: bytes, arb_id: Optional[int] = None, functional: bool = False) -> None:
        n = len(payload)
        mdl = self.max_dl
        sf_max = 7 if mdl == 8 else mdl - 2
        if n == 0:
            raise ValueError("Empty PDU")
        if n <= 7:
            self._tx(bytes([n]) + payload, arb_id)
            return
        if n <= sf_max:  # CAN FD single frame with escape length byte
            self._tx(bytes([0x00, n]) + payload, arb_id)
            return
        if functional:
            raise IsoTpError("Functional addressing supports single frames only")
        pci = bytes([0x10 | (n >> 8), n & 0xFF]) if n <= 0xFFF else bytes([0x10, 0x00]) + n.to_bytes(4, "big")
        first = mdl - len(pci)
        self._tx(pci + payload[:first], arb_id)
        pos, sn, in_block = first, 1, 0
        cf_len = mdl - 1
        bs, stmin = self._wait_fc()
        while pos < n:
            if bs and in_block >= bs:
                bs, stmin = self._wait_fc()
                in_block = 0
            chunk = payload[pos:pos + cf_len]
            self._tx(bytes([0x20 | sn]) + chunk, arb_id)
            pos += len(chunk)
            sn = (sn + 1) & 0x0F
            in_block += 1
            if pos < n and stmin > 0:
                time.sleep(stmin)

    def _recv_pdu(self, deadline: float) -> Optional[bytes]:
        cfg = self.cfg
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            try:
                d = self._rxq.get(timeout=remaining)
            except queue.Empty:
                return None
            if not d:
                continue
            pci = d[0] >> 4
            if pci == 0x0:  # single frame
                ln = d[0] & 0x0F
                if ln == 0:
                    if len(d) < 3:
                        continue
                    ln = d[1]
                    data = d[2:2 + ln]
                else:
                    data = d[1:1 + ln]
                if ln == 0 or len(data) < ln:
                    continue
                return bytes(data)
            if pci == 0x1:  # first frame
                if len(d) < 2:
                    continue
                ln = ((d[0] & 0x0F) << 8) | d[1]
                off = 2
                if ln == 0:
                    if len(d) < 6:
                        continue
                    ln = int.from_bytes(d[2:6], "big")
                    off = 6
                buf = bytearray(d[off:])
                self._send_fc(0)
                expected_sn, in_block = 1, 0
                while len(buf) < ln:
                    try:
                        c = self._rxq.get(timeout=cfg.n_cr_ms / 1000.0)
                    except queue.Empty:
                        raise IsoTpError(f"N_Cr timeout: received {len(buf)} of {ln} bytes") from None
                    if not c:
                        continue
                    kind = c[0] >> 4
                    if kind == 0x3:
                        continue
                    if kind != 0x2:
                        raise IsoTpError("Unexpected single/first frame during multi-frame reception")
                    sn = c[0] & 0x0F
                    if sn != expected_sn:
                        raise IsoTpError(f"Wrong sequence number {sn} (expected {expected_sn})")
                    expected_sn = (expected_sn + 1) & 0x0F
                    buf.extend(c[1:])
                    in_block += 1
                    if cfg.bs and in_block >= cfg.bs and len(buf) < ln:
                        self._send_fc(0)
                        in_block = 0
                return bytes(buf[:ln])
            # stray consecutive frame / flow control -> ignore

    # -- request / response ---------------------------------------------------
    def request(self, payload: bytes, expect_response: bool = True,
                timeout: Optional[float] = None) -> Optional[bytes]:
        payload = bytes(payload)
        if not payload:
            raise ValueError("Empty diagnostic request")
        if self._closed:
            raise DiagError("ISO-TP transport is closed")
        with self._lock:
            self._flush()
            self._send_pdu(payload)
            if not expect_response:
                return None
            sid = payload[0]
            p2 = timeout if timeout is not None else self.cfg.p2_ms / 1000.0
            deadline = time.monotonic() + p2
            while True:
                pdu = self._recv_pdu(deadline)
                if pdu is None:
                    more = " ..." if len(payload) > 4 else ""
                    raise DiagTimeout(f"No response to [{hexs(payload[:4])}{more}] within {p2 * 1000:.0f} ms")
                if len(pdu) >= 3 and pdu[0] == 0x7F and pdu[1] == sid:
                    if pdu[2] == 0x78:  # response pending -> extend to P2*
                        p2 = self.cfg.p2star_ms / 1000.0
                        deadline = time.monotonic() + p2
                        continue
                    return pdu
                if pdu[0] == ((sid + 0x40) & 0xFF):
                    return pdu
                # unrelated / late response -> keep waiting

    def send_only(self, payload: bytes, functional: bool = False) -> None:
        if self._closed:
            raise DiagError("ISO-TP transport is closed")
        with self._lock:
            self._flush()
            arb = self.cfg.functional_id if (functional and self.cfg.functional_id is not None) else None
            self._send_pdu(bytes(payload), arb_id=arb, functional=functional)


class ComDiagTransport(DiagTransport):
    """Diagnostics through CANalyzer's diagnostic COM objects (needs an ECU qualifier)."""

    name = "CANalyzer COM"

    def __init__(self, controller: "CanalyzerController", ecu_qualifier: str, timeout_s: float = 5.0):
        if not (ecu_qualifier or "").strip():
            raise ValueError("ECU qualifier is required for CANalyzer COM diagnostics")
        self.controller = controller
        self.ecu = ecu_qualifier.strip()
        self.timeout_s = timeout_s
        self._lock = threading.Lock()

    def request(self, payload: bytes, expect_response: bool = True,
                timeout: Optional[float] = None) -> Optional[bytes]:
        t = timeout if timeout is not None else self.timeout_s
        with self._lock:
            fut = self.controller.diag_request(self.ecu, bytes(payload), expect_response, t)
            return fut.result(timeout=t + 10)

    def request_qualifier(self, qualifier: str, timeout: Optional[float] = None) -> Optional[bytes]:
        """Send a request by its qualifier from the CANalyzer diagnostic description (CDD/ODX)."""
        t = timeout if timeout is not None else self.timeout_s
        with self._lock:
            fut = self.controller.diag_request_named(self.ecu, qualifier, t)
            return fut.result(timeout=t + 10)


