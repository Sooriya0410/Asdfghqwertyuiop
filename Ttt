def _gui_smoke_test() -> None:
    """Build the GUI, drive the demo stack (virtual bus + demo ECU + simulated PSU), close it."""
    tmp = tempfile.mkdtemp(prefix="cp_gui_")
    app = ControlPanelApp(settings_file=os.path.join(tmp, "settings.json"), log_dir=os.path.join(tmp, "logs"))
    try:
        app.withdraw()
        app.var("mon_iface", "vector").set("virtual")
        app.var("mon_channels", "1,2").set(f"gui_{os.getpid()}")
        app.var("psu_type", "Serial").set("Simulated")
        app.var("dg_transport", "CANalyzer COM").set("Python ISO-TP")
        app.var("psu_cmd_measv", "").set("MEAS:VOLT?")

        def spin(sec: float) -> None:
            end = time.monotonic() + sec
            while time.monotonic() < end:
                app.update()
                time.sleep(0.01)
        app._bus_open()
        spin(0.5)
        assert app.bus.is_open, "bus did not open"
        app._diag_connect()
        assert app.diag is not None, "diag did not connect"
        app._dtc_read()
        spin(1.0)
        assert len(app.last_dtcs) == 4, app.last_dtcs
        app._psu_connect()
        spin(0.5)
        assert app.psu and app.psu.connected
        app.var("psu_v", "13.5").set("8.0")
        app._psu_set_v()
        app._psu_output(True)
        spin(1.5)
        assert app.lbl_psu_meas.cget("text").startswith("Readback: 8.000"), app.lbl_psu_meas.cget("text")
        app.var("psu_cycle_off", "2.0").set("0.1")
        app.var("dg_boot", "3.0").set("0.2")
        app._seq_power_cycle_read()
        spin(2.0)
        assert any(r.code == EcuModel.LOW_VOLTAGE_DTC for r in app.last_dtcs), [r.hex for r in app.last_dtcs]
        app._log_start()
        spin(0.3)
        app._tx_once()
        spin(0.7)
        assert app.monitor.total > 0 and app.tv_mon.get_children()
        app._log_stop()
        app._win_refresh()          # no CANalyzer here: must report cleanly, not raise
        app._win_quick("A", ("interactive generator",))
        app._win_detach_all()
        app._diag_detect_ecus()
        spin(0.3)
        app.var("t32_backend", "TRACE32 API").set("Simulated")
        app.var("t32_dir", "").set(os.path.join(tmp, "t32"))
        app.var("t32_period", "200").set("50")
        app._t32_connect()
        spin(0.6)
        assert app.t32 is not None and app.t32.connected, "TRACE32 simulator did not connect"
        assert app.t32_vars, "demo symbols should be added automatically"
        app.var("t32_newvar", "").set("Os_Counter")
        app._t32_add_var()
        app._t32_monitor_start()
        spin(1.0)
        app.tv_t32.selection_set("1")
        spin(0.6)
        assert app.t32_monitor and app.t32_monitor.samples > 3, "no TRACE32 samples"
        app._t32_command(False)
        spin(0.3)
        app._t32_monitor_stop()
        csvs = [f for f in os.listdir(os.path.join(tmp, "t32")) if f.endswith(".csv")]
        assert csvs, "no TRACE32 CSV recording written"
        app._t32_disconnect()
        app._cdd_list()
        spin(0.3)
        assert app.frm_isotp.winfo_manager(), "ISO-TP settings must be visible for the ISO-TP source"
        app.var("dg_transport", "CANalyzer COM").set("CANalyzer COM")
        spin(0.2)
        assert not app.frm_isotp.winfo_ismapped(), "ISO-TP settings must hide for the CANalyzer source"
    finally:
        app._on_close()


def run_selftests(verbosity: int = 1, gui: bool = False) -> int:
    loader = unittest.TestLoader()
    suite = unittest.TestSuite()
    for case in (TestHelpers, TestDtcDecoding, TestEcuModel, TestIsoTp, TestIsoTpVariants, TestMonitor,
                 TestPythonCanVirtual, TestCanalyzerController, TestPowerSupply, TestDiagClientAndTesterPresent,
                 TestWindowEmbedding, TestTrace32, TestExport):
        suite.addTests(loader.loadTestsFromTestCase(case))
    result = unittest.TextTestRunner(verbosity=verbosity).run(suite)
    ok = result.wasSuccessful()
    if gui:
        if tk is None or can is None:
            print("GUI smoke test skipped (needs tkinter and python-can)")
        else:
            try:
                _gui_smoke_test()
                print("GUI smoke test: OK")
            except Exception as exc:
                print(f"GUI smoke test FAILED: {exc!r}")
                ok = False
    return 0 if ok else 1


