    def test_fc_overflow_and_timeout(self):
        hub = LoopbackHub()
        cfg = IsoTpConfig(n_bs_ms=200)
        tp = IsoTpTransport(hub, cfg)
        self.addCleanup(tp.close)

        def responder(msg: Any) -> None:
            if msg.arbitration_id == 0x7E0 and msg.data[0] >> 4 == 1:
                hub.send(SimpleFrame(arbitration_id=0x7E8, data=b"\x32\x00\x00\xCC\xCC\xCC\xCC\xCC"))
        hub.subscribe(responder)
        with self.assertRaises(IsoTpError) as cm:
            tp.request(b"\x2E\xF1\x90" + b"B" * 17)
        self.assertIn("OVERFLOW", str(cm.exception))
        hub.unsubscribe(responder)
        with self.assertRaises(IsoTpError) as cm:
            tp.request(b"\x2E\xF1\x90" + b"B" * 17)
        self.assertIn("N_Bs", str(cm.exception))

