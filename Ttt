        self.assertEqual(format_t32_raw(17, "dec"), ("17", 17.0))

    def test_var_spec_text(self):
        self.assertEqual(T32VarSpec.from_text("gCounter\thex\t0"), T32VarSpec("gCounter", "hex", False))
        self.assertEqual(T32VarSpec.from_text("BswM_State"), T32VarSpec("BswM_State", "auto", True))
        self.assertIsNone(T32VarSpec.from_text("# comment"))
        self.assertIsNone(T32VarSpec.from_text("   "))
        self.assertEqual(T32VarSpec("a", "hex", False).to_text(), "a\thex\t0")

    def test_sim_interface(self):
        self.assertEqual(self.iface.state()[0], 3)
        self.iface.cmd("Break")
        self.assertEqual(self.iface.state()[1], T32_STATES[2])
        self.iface.go()
        self.assertEqual(self.iface.state()[0], 3)
        text, num = self.iface.read_variable("Adc_BatteryVoltage")
        self.assertTrue(12.0 < (num or 0) < 15.0, text)
        self.assertEqual(self.iface.read_variable("SwVersion")[0], "1.2.3")
        self.assertEqual(self.iface.read_variable("Os_Counter", "hex")[0][:2], "0x")
        with self.assertRaises(T32Error):
            self.iface.read_variable("NoSuchSymbol")
        addr, size = self.iface.symbol_info("Os_Counter")
        self.assertEqual(len(self.iface.read_memory(addr, 32)), 32)
        self.assertEqual(self.iface.write_variable("Os_Counter", "0"), "Var.set Os_Counter=0 (simulated)")
        self.iface.disconnect()
        with self.assertRaises(T32Error):
            self.iface.read_variable("Os_Counter")

    def test_dll_interface_errors(self):
        iface = T32DllInterface("/definitely/missing/t32api64.dll")
        with self.assertRaises(T32Error):
            iface.connect()
        with self.assertRaises(T32Error):
            iface.read_variable("x")
        self.assertIsInstance(find_t32_api(), list)

    def test_monitor_sampling_and_change_detection(self):
        mon = T32Monitor(self.iface, period_s=0.02)
        mon.set_variables([T32VarSpec("Os_Counter"), T32VarSpec("SwVersion"), T32VarSpec("Bad_Symbol"),
                           T32VarSpec("Dem_EventStatus", "auto", False)])
        _, values, changed = mon.sample_once()
        self.assertEqual(set(values), {"Os_Counter", "SwVersion", "Bad_Symbol"})
        self.assertEqual(sorted(changed), ["Bad_Symbol", "Os_Counter", "SwVersion"])
        self.assertIn("not found", values["Bad_Symbol"])
        time.sleep(0.05)
        _, values2, changed2 = mon.sample_once()
        self.assertIn("Os_Counter", changed2)
        self.assertNotIn("SwVersion", changed2)
        self.assertEqual(mon.samples, 2)
        self.assertGreaterEqual(mon.change_count["Os_Counter"], 2)
        self.assertEqual(len(mon.history["Os_Counter"]), 2)

    def test_monitor_recording(self):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "t32.csv")
            mon = T32Monitor(self.iface, period_s=0.02)
            mon.set_variables([T32VarSpec("Os_Counter"), T32VarSpec("SwVersion")])
            mon.start_recording(path)
            self.assertTrue(mon.recording)
            with self.assertRaises(RuntimeError):
                mon.start_recording(path)
            mon.start()
            time.sleep(0.3)
            mon.stop()
            mon.join(2)
            closed, rows = mon.stop_recording()
            self.assertEqual(closed, path)
            self.assertGreaterEqual(rows, 5)
            with open(path, encoding="utf-8-sig") as fh:
                table = list(csv.reader(fh))
            self.assertEqual(table[0], ["timestamp", "time_s", "Os_Counter", "SwVersion", "changed"])
            self.assertEqual(len(table) - 1, rows)
            self.assertEqual(table[1][3], "1.2.3")
            self.assertGreater(float(table[-1][1]), 0.0)

            change_path = os.path.join(d, "changes.csv")
            mon2 = T32Monitor(self.iface, period_s=0.02)
            mon2.set_variables([T32VarSpec("SwVersion")])
            mon2.start_recording(change_path, changes_only=True)
            for _ in range(5):
                mon2.sample_once()
            _, rows2 = mon2.stop_recording()
            self.assertEqual(rows2, 1)   # a constant string changes only once (the first sample)


