# 7. RS52 power supply (ASCII over serial / TCP)
# =============================================================================
TERMINATORS: Dict[str, str] = {"CR+LF": "\r\n", "LF": "\n", "CR": "\r"}


@dataclass
class PsuConfig:
    cmd_on: str = "OUTP 1"
    cmd_off: str = "OUTP 0"
    cmd_set_voltage: str = "SO:VO {v:.2f}"
    cmd_meas_voltage: str = ""
    cmd_meas_current: str = ""
    init_cmds: str = ""            # ';' separated, sent after connect
    terminator: str = "\r\n"
    v_min: float = 0.0
    v_max: float = 20.0
    inter_cmd_delay: float = 0.05
    read_reply: bool = False
    query_timeout: float = 1.0

    def validate(self) -> None:
        if not self.cmd_on.strip() or not self.cmd_off.strip():
            raise ValueError("ON and OFF commands must not be empty")
        if "{v" not in self.cmd_set_voltage:
            raise ValueError("Set-voltage template must contain {v}, e.g. 'SO:VO {v:.2f}'")
        try:
            self.cmd_set_voltage.format(v=1.0)
        except (KeyError, IndexError, ValueError) as exc:
            raise ValueError(f"Invalid set-voltage template {self.cmd_set_voltage!r}: {exc}") from None
        if not (math.isfinite(self.v_min) and math.isfinite(self.v_max)) or self.v_min >= self.v_max:
            raise ValueError("Voltage limits: V min must be below V max")
        if self.terminator not in TERMINATORS.values():
            raise ValueError("Terminator must be CR, LF or CR+LF")


class PsuTransport:
    description = "transport"

    def open(self) -> None:
        raise NotImplementedError

    def close(self) -> None:
        raise NotImplementedError

    def write(self, data: bytes) -> None:
        raise NotImplementedError

    def read_until(self, term: bytes, timeout: float) -> bytes:
        raise NotImplementedError

    def flush_input(self) -> None:
        pass


class SerialPsuTransport(PsuTransport):
    def __init__(self, port: str, baudrate: int = 9600, parity: str = "N", stopbits: float = 1,
                 bytesize: int = 8, rtscts: bool = False):
        self.port = port
        self.baudrate = baudrate
        self.parity = parity
        self.stopbits = stopbits
        self.bytesize = bytesize
        self.rtscts = rtscts
        self.ser: Any = None
        self.description = f"serial {port} {baudrate} {bytesize}{parity}{stopbits:g}"

    def open(self) -> None:
        if serial is None:
            raise RuntimeError("pyserial is not installed: pip install pyserial")
        if not self.port:
            raise ValueError("Select a COM port")
        self.ser = serial.Serial(port=self.port, baudrate=self.baudrate, bytesize=self.bytesize,
                                 parity=self.parity, stopbits=self.stopbits, rtscts=self.rtscts,
                                 timeout=0.5, write_timeout=1.0)

    def close(self) -> None:
        if self.ser is not None:
            try:
                self.ser.close()
            finally:
                self.ser = None

    def write(self, data: bytes) -> None:
        if self.ser is None:
            raise RuntimeError("Serial port not open")
        self.ser.write(data)
        self.ser.flush()

    def flush_input(self) -> None:
        if self.ser is not None:
            self.ser.reset_input_buffer()

    def read_until(self, term: bytes, timeout: float) -> bytes:
        if self.ser is None:
            raise RuntimeError("Serial port not open")
        self.ser.timeout = timeout
        return bytes(self.ser.read_until(term))


class TcpPsuTransport(PsuTransport):
    def __init__(self, host: str, port: int, timeout: float = 2.0):
        self.host = host
        self.port = int(port)
        self.timeout = timeout
        self.sock: Optional[socket.socket] = None
        self._buf = bytearray()
        self.description = f"TCP {host}:{port}"

    def open(self) -> None:
        if not self.host:
            raise ValueError("Enter the power supply IP address")
        self.sock = socket.create_connection((self.host, self.port), timeout=self.timeout)
        self._buf.clear()

    def close(self) -> None:
        if self.sock is not None:
            try:
                self.sock.close()
            finally:
                self.sock = None

    def write(self, data: bytes) -> None:
        if self.sock is None:
            raise RuntimeError("TCP connection not open")
        self.sock.settimeout(self.timeout)
        self.sock.sendall(data)

    def flush_input(self) -> None:
        self._buf.clear()
        if self.sock is None:
            return
        self.sock.settimeout(0.0)
        try:
            while self.sock.recv(4096):
                pass
        except (BlockingIOError, socket.timeout, OSError):
            pass
        finally:
            self.sock.settimeout(self.timeout)

    def read_until(self, term: bytes, timeout: float) -> bytes:
        if self.sock is None:
            raise RuntimeError("TCP connection not open")
        deadline = time.monotonic() + timeout
        try:
            while term not in self._buf:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                self.sock.settimeout(remaining)
                try:
                    chunk = self.sock.recv(4096)
                except socket.timeout:
                    break
                if not chunk:
                    break
                self._buf.extend(chunk)
        finally:
            self.sock.settimeout(self.timeout)
        idx = self._buf.find(term)
        if idx < 0:
            data = bytes(self._buf)
            self._buf.clear()
            return data
        data = bytes(self._buf[:idx + len(term)])
        del self._buf[:idx + len(term)]
        return data


class SimulatedPsuTransport(PsuTransport):
    """Understands OUTP 0/1, SO:VO <v> and '?' queries - for demo and tests."""

    description = "simulated RS52"

    def __init__(self):
        self.history: List[str] = []
        self.raw: List[bytes] = []
        self.output = False
        self.voltage = 0.0
        self.is_open = False
        self._out = bytearray()
        self.on_change: Optional[Callable[[], None]] = None

    def open(self) -> None:
        self.is_open = True

    def close(self) -> None:
        self.is_open = False

    def write(self, data: bytes) -> None:
        if not self.is_open:
            raise IOError("Simulated power supply not open")
        self.raw.append(bytes(data))
        for line in re.split(r"[\r\n]+", data.decode("ascii", "replace")):
            line = line.strip()
            if line:
                self.history.append(line)
                self._handle(line)

    def _handle(self, cmd: str) -> None:
        u = cmd.upper()
        m = re.fullmatch(r"OUTP(?:UT)?\s+(ON|OFF|1|0)", u)
        if m:
            self.output = m.group(1) in ("ON", "1")
            self._changed()
            return
        m = re.fullmatch(r"SO:VO\s*([-+]?\d+(?:\.\d+)?)", u)
        if m:
            self.voltage = float(m.group(1))
            self._changed()
            return
        if u.endswith("?"):
            if "CU" in u:
                self._out += f"{0.350 if self.output else 0.0:.3f}\r\n".encode()
            elif "VO" in u or u.startswith("MV"):
                self._out += f"{self.voltage if self.output else 0.0:.3f}\r\n".encode()
            else:
                self._out += b"RS52-SIM,1.0\r\n"

    def _changed(self) -> None:
        if self.on_change:
            try:
                self.on_change()
            except Exception:
                pass

    def flush_input(self) -> None:
        self._out.clear()

    def read_until(self, term: bytes, timeout: float) -> bytes:
        idx = self._out.find(term)
        if idx < 0:
            data = bytes(self._out)
            self._out.clear()
            return data
        data = bytes(self._out[:idx + len(term)])
        del self._out[:idx + len(term)]
        return data


class Rs52Psu:
    """RS52 power supply driver: OUTP 1 / OUTP 0 / SO:VO <v> (all commands configurable)."""

    def __init__(self, transport: PsuTransport, cfg: Optional[PsuConfig] = None,
                 log: Optional[Callable[..., None]] = None):
        self.transport = transport
        self.cfg = cfg or PsuConfig()
        self.cfg.validate()
        self._log_cb = log
        self._lock = threading.Lock()
        self.connected = False
        self.output_on: Optional[bool] = None
        self.voltage_set: Optional[float] = None
        self.last_meas: Tuple[Optional[float], Optional[float]] = (None, None)

    def _log(self, text: str, level: str = "INFO") -> None:
        if self._log_cb:
            self._log_cb(text, level)

    @property
    def _resp_term(self) -> bytes:
        return b"\n" if self.cfg.terminator.endswith("\n") else b"\r"

    def _send_locked(self, cmd: str) -> Optional[str]:
        if not self.connected:
            raise RuntimeError("Power supply is not connected")
        cmd = cmd.strip()
        if not cmd:
            raise ValueError("Empty command")
        self.transport.write((cmd + self.cfg.terminator).encode("ascii"))
        self._log(f"TX {cmd}")
        reply = None
        if self.cfg.read_reply:
            raw = self.transport.read_until(self._resp_term, 0.3)
            if raw:
                reply = raw.decode("ascii", "replace").strip()
                self._log(f"RX {reply}")
        if self.cfg.inter_cmd_delay > 0:
            time.sleep(self.cfg.inter_cmd_delay)
        return reply

    def connect(self) -> None:
        with self._lock:
            if self.connected:
                return
            self.transport.open()
            self.connected = True
            self._log(f"Connected ({self.transport.description})")
            try:
                for c in [x.strip() for x in self.cfg.init_cmds.split(";") if x.strip()]:
                    self._send_locked(c)
            except Exception:
                self.connected = False
                self.transport.close()
                raise

    def disconnect(self, output_off: bool = False) -> None:
        with self._lock:
            if not self.connected:
                return
            try:
                if output_off:
                    self._send_locked(self.cfg.cmd_off)
                    self.output_on = False
            finally:
                self.connected = False
                try:
                    self.transport.close()
                finally:
                    self._log("Disconnected")

    def command(self, cmd: str) -> Optional[str]:
        with self._lock:
            return self._send_locked(cmd)

    def query(self, cmd: str, log: bool = True) -> str:
        with self._lock:
            if not self.connected:
                raise RuntimeError("Power supply is not connected")
            cmd = cmd.strip()
            self.transport.flush_input()
            self.transport.write((cmd + self.cfg.terminator).encode("ascii"))
            raw = self.transport.read_until(self._resp_term, self.cfg.query_timeout)
            if not raw:
                raise TimeoutError(f"No reply to {cmd!r} within {self.cfg.query_timeout:g} s")
            text = raw.decode("ascii", "replace").strip()
            if log:
                self._log(f"TX {cmd} -> RX {text}")
            if self.cfg.inter_cmd_delay > 0:
                time.sleep(self.cfg.inter_cmd_delay)
            return text

    def check_voltage(self, v: float) -> None:
        if not math.isfinite(v):
            raise ValueError("Voltage must be a finite number")
        if v < self.cfg.v_min or v > self.cfg.v_max:
            raise ValueError(f"{v:.3f} V is outside the limits {self.cfg.v_min:g} ... {self.cfg.v_max:g} V")

    def format_set_voltage(self, v: float) -> str:
        self.check_voltage(v)
        return self.cfg.cmd_set_voltage.format(v=v)

    def set_voltage(self, v: float) -> None:
        cmd = self.format_set_voltage(float(v))
        with self._lock:
            self._send_locked(cmd)
            self.voltage_set = float(v)

    def output(self, on: bool) -> None:
        with self._lock:
            self._send_locked(self.cfg.cmd_on if on else self.cfg.cmd_off)
            self.output_on = bool(on)

    def emergency_off(self) -> None:
        last: Optional[Exception] = None
        for _ in range(2):
            try:
                with self._lock:
                    self._send_locked(self.cfg.cmd_off)
                    self.output_on = False
                self._log("EMERGENCY OFF sent", "WARN")
                return
            except Exception as exc:
                last = exc
        assert last is not None
        raise last

    def measure(self) -> Tuple[Optional[float], Optional[float]]:
        v = i = None
        if self.cfg.cmd_meas_voltage.strip():
            v = parse_first_float(self.query(self.cfg.cmd_meas_voltage, log=False))
        if self.cfg.cmd_meas_current.strip():
            i = parse_first_float(self.query(self.cfg.cmd_meas_current, log=False))
        self.last_meas = (v, i)
        return v, i

    def ramp(self, start: float, stop: float, step: float, dwell_s: float,
             stop_event: threading.Event, progress: Optional[Callable[[float], None]] = None) -> int:
        pts = ramp_points(start, stop, step)
        for p in pts:
            self.check_voltage(p)
        self._log(f"Ramp {start:g} -> {stop:g} V, step {step:g} V, dwell {dwell_s * 1000:.0f} ms, {len(pts)} points")
        done = 0
        for v in pts:
            if stop_event.is_set():
                break
            self.set_voltage(v)
            done += 1
            if progress:
                progress(v)
            if stop_event.wait(dwell_s):
                break
        if done < len(pts):
            self._log(f"Ramp aborted after {done} of {len(pts)} points", "WARN")
        else:
            self._log("Ramp finished")
        return done

    def power_cycle(self, off_s: float, stop_event: Optional[threading.Event] = None) -> bool:
        self._log(f"Power cycle: OFF for {off_s:g} s")
        self.output(False)
        if stop_event is not None:
            if stop_event.wait(off_s):
                self._log("Power cycle aborted - output stays OFF", "WARN")
                return False
        else:
            time.sleep(off_s)
        self.output(True)
        return True


