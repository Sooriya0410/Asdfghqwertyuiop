    # ------------------------------------------------------- embedding logic
    def _win_refresh(self, quiet: bool = False) -> List[WindowInfo]:
        if not Win32Windows.available():
            if not quiet:
                self.events.log("WIN", "Embedding CANalyzer windows is a Windows feature", "ERROR")
            return []
        try:
            wins = Win32Windows.list_candidates(include_docked=self.b("win_docked"))
        except Exception as exc:
            if not quiet:
                self.events.log("WIN", f"Window list: {exc}", "ERROR")
            return []
        self._win_list = wins
        values = [w.label for w in wins]
        for slot in self.slots.values():
            slot["combo"].configure(values=values)
        if not quiet:
            self.events.log("WIN", f"{len(wins)} CANalyzer window(s) found"
                                   if wins else "No floating CANalyzer window found - drag a window tab out of the "
                                                "CANalyzer frame first (or tick 'also list docked windows')")
        return wins

    def _win_attach(self, key: str, info: WindowInfo) -> None:
        slot = self.slots[key]
        self._win_detach(key, quiet=True)
        self.nb.select(self.tab_windows)
        self.update_idletasks()
        host = slot["host"]
        try:
            emb = EmbeddedWindow(info, host.winfo_id())
            emb.attach(host.winfo_width(), host.winfo_height())
        except Exception as exc:
            self.events.log("WIN", f"Embedding '{info.title}' failed: {exc}", "ERROR")
            return
        slot["embed"] = emb
        slot["label"].config(text=info.title)
        slot["combo"].set(info.label)
        self.events.log("WIN", f"'{info.title}' embedded in the {key} panel")

    def _win_embed(self, key: str) -> None:
        idx = self.slots[key]["combo"].current()
        if idx < 0 or idx >= len(self._win_list):
            if not self._win_refresh():
                return
            self.events.log("WIN", "Select a window in the list first", "ERROR")
            return
        self._win_attach(key, self._win_list[idx])

    def _win_quick(self, key: str, keywords: Sequence[str]) -> None:
        wins = self._win_refresh(quiet=True)
        if not wins:
            wins = self._win_refresh()
            if not wins:
                return
        for info in wins:
            if info.matches(keywords):
                self._win_attach(key, info)
                return
        self.events.log("WIN", f"No CANalyzer window matching {', '.join(keywords)} - open it in CANalyzer and make "
                               f"it floating, then try again", "WARN")

    def _win_detach(self, key: str, quiet: bool = False) -> None:
        slot = self.slots.get(key)
        if not slot or slot["embed"] is None:
            return
        emb: EmbeddedWindow = slot["embed"]
        try:
            emb.detach()
        except Exception as exc:
            self.events.log("WIN", f"Detaching failed: {exc}", "ERROR")
        slot["embed"] = None
        slot["label"].config(text="empty")
        if not quiet:
            self.events.log("WIN", f"'{emb.info.title}' returned to CANalyzer")

    def _win_detach_all(self, quiet: bool = False) -> None:
        for key in list(self.slots):
            self._win_detach(key, quiet=quiet)

    def _win_resize(self, key: str, width: int, height: int) -> None:
        slot = self.slots.get(key)
        if slot and slot["embed"] is not None:
            try:
                slot["embed"].resize(width, height)
            except Exception:
                pass

    def _win_check_alive(self) -> None:
        for key, slot in self.slots.items():
            emb = slot["embed"]
            if emb is not None and not emb.alive():
                slot["embed"] = None
                slot["label"].config(text="empty")
                self.events.log("WIN", f"'{emb.info.title}' was closed in CANalyzer", "WARN")

