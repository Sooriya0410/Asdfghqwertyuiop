    # ------------------------------------------------------ power supply logic
    def _psu_rescan(self) -> None:
        ports = list_serial_ports()
        self.cb_port.configure(values=ports)
        self.events.log("PSU", f"Serial ports: {', '.join(ports) if ports else 'none found'}")

    def _psu_cfg(self) -> PsuConfig:
        cfg = PsuConfig(cmd_on=self.s("psu_cmd_on"), cmd_off=self.s("psu_cmd_off"),
                        cmd_set_voltage=self.s("psu_cmd_setv"), cmd_meas_voltage=self.s("psu_cmd_measv"),
                        cmd_meas_current=self.s("psu_cmd_measi"), init_cmds=self.s("psu_init"),
                        terminator=TERMINATORS.get(self.s("psu_term"), "\r\n"),
                        v_min=self.fnum("psu_vmin", "V min"), v_max=self.fnum("psu_vmax", "V max"),
                        inter_cmd_delay=self.fnum("psu_delay", "Delay") / 1000.0,
                        read_reply=self.b("psu_read_reply"))
        cfg.validate()
        return cfg

    def _psu_transport(self) -> PsuTransport:
        kind = self.s("psu_type")
        if kind == "Serial":
            stop = 2 if self.s("psu_stop") == "2" else 1
            return SerialPsuTransport(self.s("psu_port"), int(self.s("psu_baud") or "9600"),
                                      parity=self.s("psu_parity") or "N", stopbits=stop)
        if kind == "TCP":
            return TcpPsuTransport(self.s("psu_host"), int(self.s("psu_tcp_port") or "5025"))
        sim = SimulatedPsuTransport()
        sim.on_change = lambda: self.demo_model.on_supply(sim.voltage, sim.output)
        return sim

    def _psu_connect(self) -> None:
        if self.psu and self.psu.connected:
            self.events.log("PSU", "Already connected", "WARN")
            return
        try:
            psu = Rs52Psu(self._psu_transport(), self._psu_cfg(),
                          log=lambda t, lvl="INFO": self.events.log("PSU", t, lvl))
        except Exception as exc:
            self.events.log("PSU", f"Connect: {exc}", "ERROR")
            return

        def ok(_: Any) -> None:
            self.psu = psu
            self._last_psu_err = None
            self.lbl_psu_conn.config(text=f"Connected ({psu.transport.description})", foreground=GREEN)
            self._psu_show_state()
        self.run_bg("PSU", "Connect", psu.connect, ok)

    def _psu_disconnect(self) -> None:
        psu = self.psu
        if psu is None:
            return
        self.psu_abort.set()
        off = self.b("psu_off_on_exit")

        def ok(_: Any) -> None:
            self.psu = None
            self.lbl_psu_conn.config(text="Not connected", foreground=GREY)
            self.lbl_psu_state.config(text="Output: -    Set: -", foreground=GREY)
            self.lbl_psu_meas.config(text="Readback: -")
            self.lbl_st_psu.config(text="PSU: not connected", foreground=GREY)
        self.run_bg("PSU", "Disconnect", lambda: psu.disconnect(output_off=off), ok)

    def _psu_apply(self) -> None:
        try:
            cfg = self._psu_cfg()
        except Exception as exc:
            self.events.log("PSU", f"Command set: {exc}", "ERROR")
            return
        if self.psu:
            self.psu.cfg = cfg
        self.events.log("PSU", f"Command set applied: ON '{cfg.cmd_on}', OFF '{cfg.cmd_off}', "
                               f"set '{cfg.cmd_set_voltage}', limits {cfg.v_min:g}..{cfg.v_max:g} V")

    def _psu_ready(self) -> Optional[Rs52Psu]:
        if not (self.psu and self.psu.connected):
            self.events.log("PSU", "Power supply not connected", "ERROR")
            return None
        return self.psu

    def _psu_show_state(self) -> None:
        psu = self.psu
        if psu is None:
            return
        out = {True: "ON", False: "OFF", None: "unknown"}[psu.output_on]
        vset = f"{psu.voltage_set:.2f} V" if psu.voltage_set is not None else "-"
        color = GREEN if psu.output_on else (RED if psu.output_on is False else GREY)
        self.lbl_psu_state.config(text=f"Output: {out}    Set: {vset}", foreground=color)
        self.lbl_st_psu.config(text=f"PSU: {out} {vset}", foreground=color)

    def _psu_output(self, on: bool) -> None:
        psu = self._psu_ready()
        if psu:
            self.run_bg("PSU", "Output ON" if on else "Output OFF", lambda: psu.output(on),
                        lambda _: self._psu_show_state())

    def _psu_emergency(self) -> None:
        self.psu_abort.set()
        psu = self._psu_ready()
        if psu:
            self.run_bg("PSU", "Emergency off", psu.emergency_off, lambda _: self._psu_show_state())

    def _psu_set_v(self, value: Optional[float] = None) -> None:
        psu = self._psu_ready()
        if not psu:
            return
        try:
            v = float(value) if value is not None else self.fnum("psu_v", "Voltage")
            psu.check_voltage(v)
        except ValueError as exc:
            self.events.log("PSU", f"Set voltage: {exc}", "ERROR")
            return
        self.run_bg("PSU", f"Set {v:.2f} V", lambda: psu.set_voltage(v), lambda _: self._psu_show_state())

    def _psu_preset(self, v: float) -> None:
        self.var("psu_v", "13.5").set(f"{v:g}")
        self._psu_set_v(v)

    def _psu_abort(self) -> None:
        self.psu_abort.set()
        self.events.log("PSU", "Stop requested for ramp / power cycle")

    def _psu_ramp(self) -> None:
        psu = self._psu_ready()
        if not psu:
            return
        if self._psu_busy_seq:
            self.events.log("PSU", "A ramp or power cycle is already running", "WARN")
            return
        try:
            start, stop = self.fnum("psu_r_start", "Start"), self.fnum("psu_r_stop", "Stop")
            step, dwell = self.fnum("psu_r_step", "Step"), self.fnum("psu_r_dwell", "Dwell") / 1000.0
            for p in ramp_points(start, stop, step):
                psu.check_voltage(p)
        except ValueError as exc:
            self.events.log("PSU", f"Ramp: {exc}", "ERROR")
            return
        self.psu_abort.clear()
        self._psu_busy_seq = True

        def progress(v: float) -> None:
            self.ui(lambda: (self.lbl_ramp.config(text=f"Ramp at {v:.2f} V"), self._psu_show_state()))

        def job() -> int:
            try:
                return psu.ramp(start, stop, step, dwell, self.psu_abort, progress)
            finally:
                self._psu_busy_seq = False
        self.run_bg("PSU", "Ramp", job, lambda n: self.lbl_ramp.config(text=f"Ramp done: {n} step(s)"))

    def _psu_cycle(self) -> None:
        psu = self._psu_ready()
        if not psu:
            return
        if self._psu_busy_seq:
            self.events.log("PSU", "A ramp or power cycle is already running", "WARN")
            return
        try:
            off_s = self.fnum("psu_cycle_off", "Off time")
        except ValueError as exc:
            self.events.log("PSU", str(exc), "ERROR")
            return
        self.psu_abort.clear()
        self._psu_busy_seq = True

        def job() -> bool:
            try:
                return psu.power_cycle(off_s, self.psu_abort)
            finally:
                self._psu_busy_seq = False
        self.run_bg("PSU", "Power cycle", job, lambda _: self._psu_show_state())

    def _psu_raw(self, query: bool) -> None:
        psu = self._psu_ready()
        cmd = self.s("psu_raw")
        if not psu or not cmd:
            if psu:
                self.events.log("PSU", "Enter a command", "ERROR")
            return
        if query:
            self.run_bg("PSU", "Query", lambda: psu.query(cmd), lambda r: self.lbl_psu_raw.config(text=f"-> {r}"))
        else:
            self.run_bg("PSU", "Command", lambda: psu.command(cmd),
                        lambda r: self.lbl_psu_raw.config(text=f"-> {r}" if r else "sent"))

    def _poll_psu(self) -> None:
        try:
            psu = self.psu
            if (psu and psu.connected and self.b("psu_poll") and not self._psu_poll_busy
                    and (psu.cfg.cmd_meas_voltage.strip() or psu.cfg.cmd_meas_current.strip())):
                self._psu_poll_busy = True

                def job() -> Tuple[Optional[float], Optional[float]]:
                    try:
                        return psu.measure()
                    finally:
                        self._psu_poll_busy = False
                self.run_bg("PSU", "Readback", job, self._psu_show_meas, on_err=self._psu_poll_err)
        finally:
            self.after(1000, self._poll_psu)

    def _psu_show_meas(self, vi: Tuple[Optional[float], Optional[float]]) -> None:
        self._last_psu_err = None
        v, i = vi
        vs = f"{v:.3f} V" if v is not None else "-"
        is_ = f"{i:.3f} A" if i is not None else "-"
        self.lbl_psu_meas.config(text=f"Readback: {vs}   {is_}")

    def _psu_poll_err(self, exc: BaseException) -> None:
        msg = str(exc)
        if msg != self._last_psu_err:
            self.events.log("PSU", f"Readback failed: {msg}", "WARN")
        self._last_psu_err = msg

    # ------------------------------------------------------------------ misc
    def _open_log_folder(self) -> None:
        os.makedirs(self.log_dir, exist_ok=True)
        try:
            if sys.platform == "win32":
                os.startfile(self.log_dir)  # type: ignore[attr-defined]
            elif sys.platform == "darwin":
                subprocess.Popen(["open", self.log_dir])
            else:
                subprocess.Popen(["xdg-open", self.log_dir])
        except Exception as exc:
            self.events.log("APP", f"Cannot open {self.log_dir}: {exc}", "ERROR")

    def _on_close(self) -> None:
        self.psu_abort.set()
        try:
            self._win_detach_all(quiet=True)
            self._t32_monitor_stop(quiet=True)
            self._t32_disconnect()
            if self.tp_thread:
                self.tp_thread.stop()
            self._tx_stop_all(quiet=True)
            self._log_stop()
            self._diag_disconnect(quiet=True)
            self.bus.close()
            if self.psu and self.psu.connected:
                try:
                    self.psu.disconnect(output_off=self.b("psu_off_on_exit"))
                except Exception as exc:
                    self.events.log("PSU", f"Disconnect on exit failed: {exc}", "ERROR")
            self.canalyzer.shutdown()
            try:
                save_settings(self.settings_file, {k: v.get() for k, v in self._vars.items()})
            except Exception:
                pass
            self.events.log("APP", "Closed")
        finally:
            self.events.close()
            self.destroy()


