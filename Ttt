def service_name(sid: int) -> str:
    return SERVICE_NAMES.get(sid, f"SID 0x{sid:02X}")


def nrc_name(nrc: int) -> str:
    return UDS_NRC.get(nrc, "vehicleManufacturerSpecific" if 0x94 <= nrc <= 0xFE else "reserved")


def is_suppressed_request(payload: bytes) -> bool:
    return len(payload) >= 2 and payload[0] in SPRMIB_SERVICES and bool(payload[1] & 0x80)


class DiagError(Exception):
    """Any diagnostic communication problem."""


class DiagTimeout(DiagError):
    """No (final) response within P2 / P2*."""


class IsoTpError(DiagError):
    """ISO 15765-2 protocol violation or timing error."""


class NegativeResponse(DiagError):
