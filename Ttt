class EventLog:
    """Thread-safe, time-stamped event log written to logs/events_<stamp>.log."""

    def __init__(self, log_dir: Optional[str] = None):
        self._lock = threading.Lock()
        self._queue: "queue.Queue[Tuple[str, str, str]]" = queue.Queue()
        self._listeners: List[Callable[[str, str, str], None]] = []
        self._fh = None
        self.path: Optional[str] = None
        if log_dir:
            os.makedirs(log_dir, exist_ok=True)
            self.path = os.path.join(log_dir, f"events_{now_stamp()}.log")
            self._fh = open(self.path, "a", encoding="utf-8")

    def add_listener(self, cb: Callable[[str, str, str], None]) -> None:
        self._listeners.append(cb)

    def log(self, source: str, text: str, level: str = "INFO") -> str:
        ts = _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
        line = f"{ts} [{level:<5}] [{source}] {text}"
        with self._lock:
            if self._fh:
                try:
                    self._fh.write(line + "\n")
                    self._fh.flush()
                except Exception:
                    pass
        self._queue.put((level, source, line))
        for cb in list(self._listeners):
            try:
                cb(level, source, text)
            except Exception:
                pass
        return line

    def drain(self, limit: int = 1000) -> List[Tuple[str, str, str]]:
        items: List[Tuple[str, str, str]] = []
        while len(items) < limit:
            try:
                items.append(self._queue.get_nowait())
            except queue.Empty:
                break
        return items

    def close(self) -> None:
        with self._lock:
            if self._fh:
                try:
                    self._fh.close()
                except Exception:
                    pass
                self._fh = None


