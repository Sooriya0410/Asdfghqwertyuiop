    # ------------------------------------------------------------ monitor logic
    def _bus_open(self, auto: bool = False) -> None:
        if self.bus.is_open:
            if not auto:
                self.events.log("CAN", "Bus already open", "WARN")
            return
        iface = self.s("mon_iface") or "vector"
        try:
            if iface == "vector":
                channels: List[Any] = parse_channel_list(self.s("mon_channels"))
            else:
                channels = [self.s("mon_channels") or ("vcan0" if iface == "virtual" else "0")]
            bitrate = int(self.s("mon_bitrate")) if self.s("mon_bitrate") else None
            dbitrate = int(self.s("mon_dbitrate")) if self.s("mon_dbitrate") else None
        except ValueError as exc:
            self.events.log("CAN", f"Open bus: {exc}", "ERROR")
            return
        fd, app_name = self.b("mon_fd"), (self.s("mon_app") or None)

        def job() -> List[Any]:
            self.bus.open(iface, channels, app_name=app_name, fd=fd, bitrate=bitrate, data_bitrate=dbitrate)
            return list(self.bus.channels)
        self.run_bg("CAN", "Open bus", job, lambda ch: self._bus_opened(ch, auto))

    def _bus_opened(self, channels: List[Any], auto: bool) -> None:
        names = ", ".join(channel_label(c) for c in channels)
        self.events.log("CAN", f"Bus open ({self.bus.interface}): {names}{' - opened automatically' if auto else ''}")
        self.lbl_st_bus.config(text=f"Bus: {names}", foreground=GREEN)
        if auto and self.b("cn_auto_log"):
            self._log_start()

    def _bus_close(self) -> None:
        self._tx_stop_all(quiet=True)
        if self.monitor.is_logging:
            self._log_stop()
        if isinstance(self.diag_transport, IsoTpTransport):
            self._diag_disconnect()
        self._stop_sim_ecu()
        if self.bus.is_open:
            self.bus.close()
            self.events.log("CAN", "Bus closed")
        self.lbl_st_bus.config(text="Bus: closed", foreground=GREY)

    def _log_browse(self) -> None:
        path = filedialog.askdirectory(title="Recording folder", initialdir=self.s("mon_log_dir") or self.log_dir)
        if path:
