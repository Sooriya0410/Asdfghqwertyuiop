_FLOAT_RE = re.compile(r"[-+]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?")


def parse_first_float(text: str) -> Optional[float]:
    m = _FLOAT_RE.search(text or "")
    return float(m.group(0)) if m else None


def ramp_points(start: float, stop: float, step: float) -> List[float]:
    """Voltage points from start to stop (inclusive) in |step| increments."""
    if not all(math.isfinite(x) for x in (start, stop, step)):
        raise ValueError("Ramp values must be finite numbers")
    if step <= 0:
        raise ValueError("Ramp step must be > 0")
    span = stop - start
    direction = 1.0 if span >= 0 else -1.0
    n = int(math.floor(abs(span) / step + 1e-9))
    if n > 10000:
        raise ValueError("Ramp would have more than 10000 points")
    pts = [round(start + direction * i * step, 6) for i in range(n + 1)]
    if abs(pts[-1] - stop) > 1e-6:
        pts.append(round(stop, 6))
    return pts


def coerce_like(current: Any, text: str) -> Any:
    """Convert GUI text to the type of an existing (system variable) value."""
    t = (text or "").strip()
    if isinstance(current, bool):
        return t.lower() in ("1", "true", "on", "yes")
    if isinstance(current, int):
        return int(t, 0)
    if isinstance(current, float):
        return float(t)
    if isinstance(current, (tuple, list)):
        items = [x for x in re.split(r"[\s,;]+", t) if x]
        if current and isinstance(current[0], float):
            return tuple(float(x) for x in items)
        return tuple(int(x, 0) for x in items)
    if isinstance(current, str):
        return text
    for conv in (lambda s: int(s, 0), float):
        try:
            return conv(t)
        except ValueError:
            pass
    return text


def _safe(fn: Callable[[], Any], default: Any = None) -> Any:
    try:
        return fn()
    except Exception:
        return default


def load_settings(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def save_settings(path: str, data: Dict[str, Any]) -> None:
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
    os.replace(tmp, path)


