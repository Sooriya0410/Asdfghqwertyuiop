#!/usr/bin/env python3
"""
hex_length_filler.py
====================

Expand the 16-bit hex length field found in each Excel row into that many
filled output columns.

Input
-----
The first worksheet of an .xlsx / .xlsm workbook (or the sheet chosen with
--sheet). Every row holds a hex byte sequence such as ``3D 03 10 2B``, either
in one cell or spread across several cells. Only the LAST TWO bytes of the row
are used. By default the first of them is the LSB and the second the MSB:

    3D 03 10 2B   ->  LSB 0x10, MSB 0x2B  ->  0x2B10 = 11024 columns
    ...   10 00   ->  0x0010 =    16 columns
    ...   FF FF   ->  0xFFFF = 65535 columns

Accepted byte spellings: ``10``, ``0x10``, single digits (``3`` -> 0x03) and
run-together pairs (``3D03102B``). Bytes may be separated by spaces, commas,
semicolons, colons, hyphens or pipes. Text that is not a hex byte is ignored
unless it lands in the last two positions, so a label in an earlier column
(e.g. a test-case ID) is harmless. If a comment column sits AFTER the bytes,
restrict the input with --columns.

Output
------
Each output row gets ``length`` cells holding the fill value (default
``0x00``). Output row N belongs to the N-th processed input row; empty or
invalid input rows produce a blank output row so the alignment is kept. A
"Report" sheet lists every input row with its decoded LSB/MSB, length, output
location and status.

Excel column limit
------------------
An .xlsx sheet holds at most 16,384 columns (A..XFD), so FF FF (65,535) cannot
fit on one row of one sheet. Choose the behaviour with --overflow:

  split  (default)  Continue the SAME row number on extra sheets named
                    "Bytes 1-16384", "Bytes 16385-32768", ... Row N on every
                    data sheet still belongs to input row N.
  wrap              Continue on the following rows of the same sheet.
  error             Stop before writing anything.

A .csv output has no column limit (one input row = one CSV row of the full
length), but note that Excel only shows the first 16,384 columns of a CSV.

Runs fully offline: no network access, no cloud services, no telemetry.
Dependency: openpyxl  (pip install openpyxl)

Examples
--------
    python hex_length_filler.py input.xlsx
    python hex_length_filler.py input.xlsx -o result.xlsx --force
    python hex_length_filler.py input.xlsx --columns B --skip-rows 1
    python hex_length_filler.py input.xlsx --overflow wrap
    python hex_length_filler.py input.xlsx -o result.csv

Exit codes
----------
    0    success, every row converted
    1    fatal error, nothing written
    2    invalid command-line usage
    3    output written, but one or more input rows were invalid
    130  interrupted (Ctrl+C), nothing written
"""

from __future__ import annotations

import argparse
import csv
import datetime as _dt
import logging
import math
import os
import re
import sys
import tempfile
import time
import zipfile
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Any, Callable, Iterable, Optional, Sequence, Tuple

try:
    from openpyxl import Workbook, load_workbook
    from openpyxl.cell import WriteOnlyCell
    from openpyxl.styles import Font, PatternFill
    from openpyxl.utils import column_index_from_string
    from openpyxl.utils.exceptions import InvalidFileException

    _OPENPYXL_IMPORT_ERROR: Optional[ImportError] = None
except ImportError as _exc:  # pragma: no cover - environment dependent
    _OPENPYXL_IMPORT_ERROR = _exc

__version__ = "1.0.0"

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #
EXCEL_MAX_COLUMNS = 16_384          # A..XFD
EXCEL_MAX_ROWS = 1_048_576
MAX_SPLIT_SHEETS = 64               # guard against absurd --max-columns values
LARGE_JOB_CELLS = 20_000_000        # warn above this many output cells
PROGRESS_INTERVAL_S = 5.0
MAX_ROW_WARNINGS = 20               # cap per-row warnings in the log

INPUT_SUFFIXES = {".xlsx", ".xlsm", ".xltx", ".xltm"}
OUTPUT_SUFFIXES = {".xlsx", ".csv"}

EXIT_OK = 0
EXIT_FATAL = 1
EXIT_USAGE = 2
EXIT_PARTIAL = 3
EXIT_INTERRUPTED = 130

LOG = logging.getLogger("hex_length_filler")


# --------------------------------------------------------------------------- #
# Types
# --------------------------------------------------------------------------- #
class FillerError(Exception):
    """Fatal, user-facing error. The message is logged and the tool exits 1."""


class RowParseError(ValueError):
    """A single input row could not be interpreted."""


class Overflow(str, Enum):
    SPLIT = "split"
    WRAP = "wrap"
    ERROR = "error"


class ByteOrder(str, Enum):
    LITTLE = "little"   # first of the two bytes is the LSB (default)
    BIG = "big"         # first of the two bytes is the MSB


class Status(str, Enum):
    OK = "OK"
    EMPTY = "EMPTY"
    INVALID = "INVALID"


@dataclass(frozen=True)
class RowResult:
    """Outcome of parsing one input row."""

    input_row: int                 # 1-based Excel row number in the input
    raw: str                       # row text as read (cells joined by spaces)
    status: Status
    length: int = 0
    lsb: Optional[int] = None
    msb: Optional[int] = None
    message: str = ""


@dataclass(frozen=True)
class Plan:
    """Validated output layout, computed before anything is written."""

    sheet_titles: Tuple[str, ...]  # data sheets (xlsx only)
    locations: Tuple[str, ...]     # one human-readable location per result
    total_cells: int
    longest: int


@dataclass(frozen=True)
class Config:
    input_path: Path
    output_path: Path
    sheet: Optional[str] = None
    first_col: Optional[int] = None
    last_col: Optional[int] = None
    skip_rows: int = 0
    byte_order: ByteOrder = ByteOrder.LITTLE
    fill: str = "0x00"
    overflow: Overflow = Overflow.SPLIT
    max_columns: int = EXCEL_MAX_COLUMNS
    report: bool = True
    strict: bool = False
    force: bool = False

    @property
    def is_csv(self) -> bool:
        return self.output_path.suffix.lower() == ".csv"

    @property
    def report_csv_path(self) -> Path:
        return self.output_path.with_name(f"{self.output_path.stem}_report.csv")


# --------------------------------------------------------------------------- #
# Parsing
# --------------------------------------------------------------------------- #
_SPLIT_RE = re.compile(r"[\s,;:|\-]+")      # \s also covers non-breaking spaces
_HEX_RE = re.compile(r"[0-9A-Fa-f]+")
_DATE_TYPES = (_dt.date, _dt.time, _dt.timedelta)   # datetime is a date subclass


def _strip_0x(token: str) -> str:
    return token[2:] if token[:2].lower() == "0x" else token


def cell_to_text(value: Any) -> str:
    """Convert a cell value to the text the user typed.

    Excel stores a cell typed as ``10`` as the number 10; its text "10" is
    still read as the hex byte 0x10, which is what the user meant.
    """
    if value is None:
        return ""
    if isinstance(value, _DATE_TYPES):
        raise RowParseError(
            f"cell contains a date/time ({value}); Excel converted the text - "
            "format the input column as Text and re-enter the bytes"
        )
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value).strip()


def tokenize(text: str) -> list[str]:
    """Split row text into byte tokens.

    Run-together hex such as ``3D03102B`` or ``0x102B`` is split into pairs.
    Other pieces are kept verbatim and are only validated if they end up in
    the last two positions.
    """
    tokens: list[str] = []
    for piece in _SPLIT_RE.split(text):
        if not piece:
            continue
        body = _strip_0x(piece)
        if len(body) > 2 and len(body) % 2 == 0 and _HEX_RE.fullmatch(body):
            tokens.extend(body[i:i + 2] for i in range(0, len(body), 2))
        else:
            tokens.append(piece)
    return tokens


def parse_byte(token: str) -> int:
    """Parse one hex byte token (``2B``, ``0x2B``, ``b``) to an int 0..255."""
    body = _strip_0x(token)
    if not body or len(body) > 2 or not _HEX_RE.fullmatch(body):
        raise RowParseError(f"'{token}' is not a valid hex byte (00..FF)")
    return int(body, 16)


def decode_length(tokens: Sequence[str],
                  byte_order: ByteOrder = ByteOrder.LITTLE) -> Tuple[int, int, int]:
    """Return ``(lsb, msb, length)`` from the last two tokens."""
    if len(tokens) < 2:
        raise RowParseError(f"need at least 2 bytes, found {len(tokens)}")
    first, second = parse_byte(tokens[-2]), parse_byte(tokens[-1])
    if byte_order is ByteOrder.LITTLE:
        lsb, msb = first, second
    else:
        msb, lsb = first, second
    return lsb, msb, (msb << 8) | lsb


def parse_row(row_number: int, values: Iterable[Any],
              byte_order: ByteOrder = ByteOrder.LITTLE) -> RowResult:
    """Parse the cell values of one input row into a :class:`RowResult`."""
    try:
        texts = [cell_to_text(v) for v in values]
    except RowParseError as exc:
        return RowResult(row_number, "", Status.INVALID, message=str(exc))

    raw = " ".join(t for t in texts if t)
    if not raw:
        return RowResult(row_number, raw, Status.EMPTY)
    try:
        lsb, msb, length = decode_length(tokenize(raw), byte_order)
    except RowParseError as exc:
        return RowResult(row_number, raw, Status.INVALID, message=str(exc))
    return RowResult(row_number, raw, Status.OK, length=length, lsb=lsb, msb=msb)


# --------------------------------------------------------------------------- #
# Reading
# --------------------------------------------------------------------------- #
def read_rows(cfg: Config) -> list[RowResult]:
    """Read and parse every data row of the input sheet."""
    path = cfg.input_path
    if not path.is_file():
        raise FillerError(f"Input file not found: {path}")
    suffix = path.suffix.lower()
    if suffix == ".xls":
        raise FillerError("Legacy .xls is not supported; save the file as .xlsx in Excel first.")
    if suffix not in INPUT_SUFFIXES:
        raise FillerError(f"Unsupported input type '{path.suffix}'; expected one of "
                          f"{', '.join(sorted(INPUT_SUFFIXES))}.")

    try:
        wb = load_workbook(path, data_only=True)
    except PermissionError as exc:
        raise FillerError(f"Permission denied reading '{path}'.") from exc
    except (InvalidFileException, zipfile.BadZipFile, KeyError, OSError) as exc:
        raise FillerError(f"Cannot read '{path}' as an Excel workbook: {exc}") from exc

    try:
        if cfg.sheet is not None:
            if cfg.sheet not in wb.sheetnames:
                raise FillerError(f"Sheet '{cfg.sheet}' not found. Available: "
                                  f"{', '.join(wb.sheetnames)}")
            ws = wb[cfg.sheet]
        else:
            if not wb.worksheets:
                raise FillerError(f"'{path}' contains no worksheets.")
            ws = wb.worksheets[0]
            if len(wb.worksheets) > 1:
                LOG.warning("Workbook has %d sheets; using the first one, '%s' "
                            "(use --sheet to choose another).", len(wb.worksheets), ws.title)

        start = cfg.skip_rows + 1
        results: list[RowResult] = []
        if ws.max_row >= start:
            rows = ws.iter_rows(min_row=start, max_row=ws.max_row,
                                min_col=cfg.first_col, max_col=cfg.last_col,
                                values_only=True)
            for row_number, values in enumerate(rows, start=start):
                results.append(parse_row(row_number, values, cfg.byte_order))
    finally:
        wb.close()

    # Excel often reports formatted-but-empty rows at the end; drop them.
    while results and results[-1].status is Status.EMPTY:
        results.pop()
    return results


# --------------------------------------------------------------------------- #
# Planning (all limits are checked here, before any output is written)
# --------------------------------------------------------------------------- #
def _span(first: int, last: int) -> str:
    return f"Row {first}" if first == last else f"Rows {first}-{last}"


def plan_xlsx(results: Sequence[RowResult], max_columns: int, overflow: Overflow) -> Plan:
    longest = max((r.length for r in results), default=0)
    total = sum(r.length for r in results)

    if longest > max_columns and overflow is Overflow.ERROR:
        worst = next(r for r in results if r.length > max_columns)
        raise FillerError(
            f"Input row {worst.input_row} needs {worst.length} columns but a sheet row "
            f"holds at most {max_columns}. Use --overflow split, --overflow wrap, "
            "or a .csv output."
        )

    locations: list[str] = []
    if overflow is Overflow.WRAP or longest <= max_columns:
        titles: Tuple[str, ...] = ("Output",)
        next_row = 1
        for r in results:
            used = max(1, math.ceil(r.length / max_columns))
            loc = _span(next_row, next_row + used - 1)
            locations.append(loc + (" (blank)" if r.length == 0 else ""))
            next_row += used
        if next_row - 1 > EXCEL_MAX_ROWS:
            raise FillerError(f"Wrapped output needs {next_row - 1:,} rows; Excel allows "
                              f"{EXCEL_MAX_ROWS:,}. Use --overflow split or a .csv output.")
    else:  # SPLIT across sheets, same row number on each
        parts = math.ceil(longest / max_columns)
        if parts > MAX_SPLIT_SHEETS:
            raise FillerError(f"Split output would need {parts} sheets (limit "
                              f"{MAX_SPLIT_SHEETS}). Increase --max-columns or use "
                              "--overflow wrap.")
        titles = tuple(
            f"Bytes {p * max_columns + 1}-{min((p + 1) * max_columns, longest)}"
            for p in range(parts)
        )
        for n, r in enumerate(results, start=1):
            used = math.ceil(r.length / max_columns)
            if used == 0:
                locations.append(f"Row {n} (blank)")
            elif used == 1:
                locations.append(f"Row {n}")
            else:
                locations.append(f"Row {n}, sheets 1-{used}")

    return Plan(titles, tuple(locations), total, longest)


def plan_csv(results: Sequence[RowResult]) -> Plan:
    locations = tuple(f"Row {n}" + (" (blank)" if r.length == 0 else "")
                      for n, r in enumerate(results, start=1))
    return Plan((), locations,
                sum(r.length for r in results),
                max((r.length for r in results), default=0))


# --------------------------------------------------------------------------- #
# Writing
# --------------------------------------------------------------------------- #
class _Progress:
    """Logs progress at most every PROGRESS_INTERVAL_S seconds."""

    def __init__(self, total: int) -> None:
        self.total = total
        self.done = 0
        self._last = time.monotonic()

    def tick(self) -> None:
        self.done += 1
        now = time.monotonic()
        if now - self._last >= PROGRESS_INTERVAL_S:
            LOG.info("  ... %d / %d rows written (%.0f%%)", self.done, self.total,
                     100.0 * self.done / max(1, self.total))
            self._last = now


def _default_file_mode() -> int:
    mask = os.umask(0)
    os.umask(mask)
    return 0o666 & ~mask


def _atomic_write(target: Path, writer: Callable[[Path], None]) -> None:
    """Write via a temp file in the target folder, then rename into place.

    A crash or Ctrl+C never leaves a half-written output file behind.
    """
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.stem}.", suffix=target.suffix,
                                    dir=str(target.parent))
    os.close(fd)
    tmp = Path(tmp_name)
    try:
        writer(tmp)
        try:  # mkstemp creates 0600 files; give the output normal permissions
            os.chmod(tmp, _default_file_mode())
        except OSError:
            pass
        os.replace(tmp, target)
    except PermissionError as exc:
        raise FillerError(f"Cannot write '{target}': permission denied. If the file is "
                          "open in Excel, close it and run again.") from exc
    except OSError as exc:
        raise FillerError(f"Cannot write '{target}': {exc}") from exc
    finally:
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:
                pass


REPORT_HEADERS = ("Input Row", "Input Data", "LSB", "MSB", "Length (dec)",
                  "Length (hex)", "Output Location", "Status", "Message")
REPORT_WIDTHS = (10, 36, 7, 7, 13, 13, 22, 10, 60)


def _report_values(r: RowResult, location: str) -> list[Any]:
    ok = r.status is Status.OK
    return [
        r.input_row,
        r.raw,
        f"0x{r.lsb:02X}" if ok else "",
        f"0x{r.msb:02X}" if ok else "",
        r.length if ok else "",
        f"0x{r.length:04X}" if ok else "",
        location,
        r.status.value,
        r.message,
    ]


def _write_report_sheet(wb: "Workbook", results: Sequence[RowResult], plan: Plan) -> None:
    ws = wb.create_sheet("Report")
    for idx, width in enumerate(REPORT_WIDTHS, start=1):
        ws.column_dimensions[chr(64 + idx)].width = width
    ws.freeze_panes = "A2"

    bold = Font(bold=True)
    header = []
    for title in REPORT_HEADERS:
        cell = WriteOnlyCell(ws, value=title)
        cell.font = bold
        header.append(cell)
    ws.append(header)

    invalid_fill = PatternFill("solid", fgColor="FFC7CE")
    for r, loc in zip(results, plan.locations):
        row = []
        for value in _report_values(r, loc):
            cell = WriteOnlyCell(ws, value=value)
            if isinstance(value, str):
                cell.data_type = "s"           # never interpret input text as a formula
            if r.status is Status.INVALID:
                cell.fill = invalid_fill
            row.append(cell)
        ws.append(row)


def write_xlsx(results: Sequence[RowResult], plan: Plan, cfg: Config) -> None:
    def _writer(tmp: Path) -> None:
        wb = Workbook(write_only=True)        # streams rows; constant memory
        sheets = [wb.create_sheet(title) for title in plan.sheet_titles]
        progress = _Progress(len(results))
        step = cfg.max_columns
        single_sheet = len(sheets) == 1

        for r in results:
            if single_sheet:
                ws = sheets[0]
                if r.length == 0:
                    ws.append([])             # keep row alignment
                for start in range(0, r.length, step):
                    ws.append([cfg.fill] * min(step, r.length - start))
            else:                             # split: same row on every sheet
                for part, ws in enumerate(sheets):
                    count = min(step, r.length - part * step)
                    ws.append([cfg.fill] * count if count > 0 else [])
            progress.tick()

        if cfg.report:
            _write_report_sheet(wb, results, plan)
        wb.save(str(tmp))

    _atomic_write(cfg.output_path, _writer)


def write_csv(results: Sequence[RowResult], plan: Plan, cfg: Config) -> None:
    def _data_writer(tmp: Path) -> None:
        progress = _Progress(len(results))
        with open(tmp, "w", newline="", encoding="utf-8") as fh:
            writer = csv.writer(fh)
            for r in results:
                writer.writerow([cfg.fill] * r.length)
                progress.tick()

    def _report_writer(tmp: Path) -> None:
        with open(tmp, "w", newline="", encoding="utf-8-sig") as fh:
            writer = csv.writer(fh)
            writer.writerow(REPORT_HEADERS)
            for r, loc in zip(results, plan.locations):
                writer.writerow(_report_values(r, loc))

    _atomic_write(cfg.output_path, _data_writer)
    if cfg.report:
        _atomic_write(cfg.report_csv_path, _report_writer)


# --------------------------------------------------------------------------- #
# Orchestration
# --------------------------------------------------------------------------- #
def _shorten(text: str, limit: int = 60) -> str:
    return text if len(text) <= limit else text[:limit - 3] + "..."


def _check_output_paths(cfg: Config) -> None:
    out = cfg.output_path
    if out.suffix.lower() not in OUTPUT_SUFFIXES:
        raise FillerError(f"Output must end in .xlsx or .csv (got '{out.name}').")
    targets = [out] + ([cfg.report_csv_path] if cfg.is_csv and cfg.report else [])
    for target in targets:
        if target.resolve() == cfg.input_path.resolve():
            raise FillerError("Output path is the input file; refusing to overwrite it.")
        if target.exists() and not cfg.force:
            raise FillerError(f"'{target}' already exists. Use --force to overwrite.")
        if target.is_dir():
            raise FillerError(f"'{target}' is a directory.")


def run(cfg: Config) -> int:
    """Execute a conversion. Returns an exit code; raises FillerError on fatal errors."""
    t0 = time.monotonic()
    if not cfg.fill:
        raise FillerError("--fill must not be empty.")
    if cfg.fill.startswith("="):
        raise FillerError("--fill must not start with '=' (Excel would treat it as a formula).")
    _check_output_paths(cfg)

    LOG.info("Reading %s", cfg.input_path)
    results = read_rows(cfg)
    if not results:
        raise FillerError("No data rows found in the input sheet.")

    ok = sum(r.status is Status.OK for r in results)
    empty = sum(r.status is Status.EMPTY for r in results)
    invalid = [r for r in results if r.status is Status.INVALID]

    for r in invalid[:MAX_ROW_WARNINGS]:
        LOG.warning("Input row %d invalid: %s  [data: '%s']", r.input_row, r.message,
                    _shorten(r.raw))
    if len(invalid) > MAX_ROW_WARNINGS:
        LOG.warning("... and %d more invalid rows (see the report).",
                    len(invalid) - MAX_ROW_WARNINGS)
    if invalid and cfg.strict:
        raise FillerError(f"{len(invalid)} invalid row(s) and --strict is set; nothing written.")

    plan = plan_csv(results) if cfg.is_csv else plan_xlsx(results, cfg.max_columns, cfg.overflow)

    LOG.info("Rows: %d total, %d OK, %d empty, %d invalid. Longest row: %d columns. "
             "Cells to write: %s", len(results), ok, empty, len(invalid), plan.longest,
             f"{plan.total_cells:,}")
    if len(plan.sheet_titles) > 1:
        LOG.info("Rows longer than %d columns continue on the same row of %d sheets: %s",
                 cfg.max_columns, len(plan.sheet_titles), ", ".join(plan.sheet_titles))
    if cfg.is_csv and plan.longest > EXCEL_MAX_COLUMNS:
        LOG.warning("CSV rows up to %d columns: Excel will display only the first %d.",
                    plan.longest, EXCEL_MAX_COLUMNS)
    if plan.total_cells > LARGE_JOB_CELLS:
        LOG.warning("Large job (%s cells): this can take several minutes and produce a "
                    "large file.", f"{plan.total_cells:,}")

    LOG.info("Writing %s", cfg.output_path)
    if cfg.is_csv:
        write_csv(results, plan, cfg)
    else:
        write_xlsx(results, plan, cfg)

    LOG.info("Done in %.1f s -> %s", time.monotonic() - t0, cfg.output_path)
    if cfg.is_csv and cfg.report:
        LOG.info("Report -> %s", cfg.report_csv_path)
    return EXIT_PARTIAL if invalid else EXIT_OK


# --------------------------------------------------------------------------- #
# Command line
# --------------------------------------------------------------------------- #
def _non_negative_int(text: str) -> int:
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"'{text}' is not an integer") from None
    if value < 0:
        raise argparse.ArgumentTypeError("must be 0 or greater")
    return value


def _max_columns(text: str) -> int:
    value = _non_negative_int(text)
    if not 1 <= value <= EXCEL_MAX_COLUMNS:
        raise argparse.ArgumentTypeError(f"must be between 1 and {EXCEL_MAX_COLUMNS}")
    return value


def _column_range(text: str) -> Tuple[int, int]:
    match = re.fullmatch(r"\s*([A-Za-z]{1,3})\s*(?::\s*([A-Za-z]{1,3})\s*)?", text)
    if not match:
        raise argparse.ArgumentTypeError(f"'{text}' is not a column like B or B:E")
    try:
        first = column_index_from_string(match.group(1).upper())
        last = column_index_from_string((match.group(2) or match.group(1)).upper())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from None
    if first > last:
        raise argparse.ArgumentTypeError(f"'{text}': first column is after the last")
    return first, last


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="hex_length_filler",
        description="Read the last two hex bytes of each Excel row as a 16-bit length "
                    "(LSB first) and write that many filled cells per output row.",
        epilog="Examples:\n"
               "  python hex_length_filler.py input.xlsx\n"
               "  python hex_length_filler.py input.xlsx -o result.xlsx --force\n"
               "  python hex_length_filler.py input.xlsx --columns B --skip-rows 1\n"
               "  python hex_length_filler.py input.xlsx --overflow wrap\n"
               "  python hex_length_filler.py input.xlsx -o result.csv",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("input", type=Path, help="input workbook (.xlsx / .xlsm)")
    parser.add_argument("-o", "--output", type=Path,
                        help="output .xlsx or .csv (default: <input>_filled.xlsx)")
    parser.add_argument("--sheet", help="input sheet name (default: first sheet)")
    parser.add_argument("--columns", type=_column_range, metavar="COLS",
                        help="read only these input columns, e.g. B or B:E (default: whole row)")
    parser.add_argument("--skip-rows", type=_non_negative_int, default=0, metavar="N",
                        help="ignore the first N input rows, e.g. a header (default: 0)")
    parser.add_argument("--byte-order", choices=[e.value for e in ByteOrder],
                        default=ByteOrder.LITTLE.value,
                        help="order of the two length bytes: little = LSB first "
                             "(default), big = MSB first")
    parser.add_argument("--fill", default="0x00",
                        help="text written into every output cell (default: 0x00)")
    parser.add_argument("--overflow", choices=[e.value for e in Overflow],
                        default=Overflow.SPLIT.value,
                        help="rows longer than --max-columns: split = same row on extra "
                             "sheets (default), wrap = following rows, error = abort")
    parser.add_argument("--max-columns", type=_max_columns, default=EXCEL_MAX_COLUMNS,
                        metavar="N",
                        help=f"columns per sheet row, 1..{EXCEL_MAX_COLUMNS} "
                             f"(default: {EXCEL_MAX_COLUMNS}, the Excel limit)")
    parser.add_argument("--no-report", action="store_true",
                        help="do not write the Report sheet (or <output>_report.csv)")
    parser.add_argument("--strict", action="store_true",
                        help="abort without writing anything if any row is invalid")
    parser.add_argument("-f", "--force", action="store_true",
                        help="overwrite existing output files")
    verbosity = parser.add_mutually_exclusive_group()
    verbosity.add_argument("-v", "--verbose", action="store_true", help="debug logging")
    verbosity.add_argument("-q", "--quiet", action="store_true", help="warnings and errors only")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    return parser


def config_from_args(args: argparse.Namespace) -> Config:
    first_col, last_col = args.columns if args.columns else (None, None)
    output = args.output or args.input.with_name(f"{args.input.stem}_filled.xlsx")
    return Config(
        input_path=args.input,
        output_path=output,
        sheet=args.sheet,
        first_col=first_col,
        last_col=last_col,
        skip_rows=args.skip_rows,
        byte_order=ByteOrder(args.byte_order),
        fill=args.fill,
        overflow=Overflow(args.overflow),
        max_columns=args.max_columns,
        report=not args.no_report,
        strict=args.strict,
        force=args.force,
    )


def _configure_logging(verbose: bool, quiet: bool) -> None:
    level = logging.DEBUG if verbose else logging.WARNING if quiet else logging.INFO
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)-7s %(message)s",
                                           datefmt="%H:%M:%S"))
    LOG.handlers[:] = [handler]
    LOG.setLevel(level)
    LOG.propagate = False


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    _configure_logging(args.verbose, args.quiet)

    if _OPENPYXL_IMPORT_ERROR is not None:
        LOG.error("openpyxl is required: pip install openpyxl (%s)", _OPENPYXL_IMPORT_ERROR)
        return EXIT_FATAL
    try:
        return run(config_from_args(args))
    except FillerError as exc:
        LOG.error("%s", exc)
        return EXIT_FATAL
    except KeyboardInterrupt:
        LOG.error("Interrupted; nothing written.")
        return EXIT_INTERRUPTED
    except Exception:  # pragma: no cover - last-resort guard
        LOG.exception("Unexpected error; nothing written.")
        return EXIT_FATAL


if __name__ == "__main__":
    sys.exit(main())
