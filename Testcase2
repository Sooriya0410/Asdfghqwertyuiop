def _style_header(ws, ncols: int, color: str = "1F4E78") -> None:
    from openpyxl.styles import Alignment, Font, PatternFill
    fill = PatternFill("solid", fgColor=color)
    for c in range(1, ncols + 1):
        cell = ws.cell(row=1, column=c)
        cell.font = Font(bold=True, color="FFFFFF")
        cell.fill = fill
        cell.alignment = Alignment(vertical="center", wrap_text=True)
    ws.freeze_panes = "A2"


def _set_widths(ws, widths: Sequence[float]) -> None:
    from openpyxl.utils import get_column_letter
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w


def _fill_changes_sheet(ws, changes: Sequence[Change]) -> None:
    from openpyxl.styles import Alignment
    ws.append(CHANGE_COLUMNS)
    wrap = Alignment(wrap_text=True, vertical="top")
    for ch in changes:
        ws.append([ch.cid, ch.file, ch.kind, ch.status, ", ".join(ch.functions) or FILE_SCOPE,
                   ch.old_lines, ch.new_lines, xl_text(ch.old_code, 8000), xl_text(ch.new_code, 8000),
                   xl_text(ch.note)])
        if len(changes) <= 3000:
            r = ws.max_row
            ws.cell(row=r, column=8).alignment = wrap
            ws.cell(row=r, column=9).alignment = wrap
    _style_header(ws, len(CHANGE_COLUMNS))
    _set_widths(ws, [10, 46, 9, 11, 30, 11, 11, 60, 60, 28])
    if changes:
        ws.auto_filter.ref = ws.dimensions


def write_changes_excel(path: str, cs: Optional[ChangeSet]) -> None:
    """Write the files-changed Excel.  cs=None writes an empty template with two example rows."""
    openpyxl = require_openpyxl()
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Changes"
    if cs is None:
        demo = [
            Change(cid="C0001", file="Bsw/WdgM/WdgM.c", kind="C", status="Modified",
                   functions=["WdgM_MainFunction"], old_start=120, old_end=124, new_start=120, new_end=127,
                   old_code="if (aliveCnt < WDGM_MIN_ALIVE) { ... }", new_code="if (aliveCnt < cfg->minAlive) { ... }",
                   note="example row - delete it"),
            Change(cid="C0002", file="PowerMgr.h", kind="H", status="Modified", new_start=42, new_end=42,
                   note="example row - only File and New Lines given"),
        ]
        _fill_changes_sheet(ws, demo)
    else:
        _fill_changes_sheet(ws, cs.changes)
        wf = wb.create_sheet("Files")
        wf.append(["File", "File Type", "Status", "Lines Added", "Lines Removed", "Changed Blocks",
                   "Functions Changed", "Note"])
        for f in cs.files:
            wf.append([f.file, f.kind, f.status, f.added, f.removed, f.hunks,
                       xl_text(", ".join(f.functions)), f.note])
        _style_header(wf, 8)
        _set_widths(wf, [50, 10, 11, 12, 13, 14, 70, 26])
        if cs.files:
            wf.auto_filter.ref = wf.dimensions
        wi = wb.create_sheet("Run Info")
        wi.append(["Item", "Value"])
        wi.append(["Old sandbox", cs.old_root])
        wi.append(["New sandbox", cs.new_root])
        wi.append(["Created", now_iso()])
        for k, v in cs.stats.items():
            wi.append([k, v])
        _style_header(wi, 2)
        _set_widths(wi, [24, 80])
    wr = wb.create_sheet("ReadMe")
    for row in _README_ROWS:
        wr.append(list(row))
    _set_widths(wr, [120])
    wb.save(path)


def read_changes_excel(path: str, sbx: Optional[SandboxIndex] = None,
                       user_patterns: Sequence[str] = ()) -> ChangeSet:
    """Load a files-changed Excel (written by this tool or filled by hand)."""
    openpyxl = require_openpyxl()
    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
    try:
        sheets = list(wb.worksheets)
        sheets.sort(key=lambda w: 0 if w.title.strip().lower() == "changes" else 1)
        found = None
        for ws in sheets:
            if ws.title.strip().lower() in ("readme", "files", "run info"):
                continue
            if hasattr(ws, "reset_dimensions"):
                ws.reset_dimensions()                  # some exports store a wrong sheet size
            rows = []
            for r, row in enumerate(ws.iter_rows(values_only=True), 1):
                rows.append(row)
                if r >= 20:
                    break
            for r, row in enumerate(rows):
                heads = [norm_header(c) for c in row]
                if any(h in _CHANGE_ALIASES["file"] for h in heads):
                    found = (ws, r, heads)
                    break
            if found:
                break
        if not found:
            raise ValueError("No column named 'File' was found in '%s'.\n"
                             "Use the 'Template' button to see the expected format." % os.path.basename(path))
        ws, hdr_row, heads = found
        col: Dict[str, int] = {}
        for name, aliases in _CHANGE_ALIASES.items():
            for i, h in enumerate(heads):
                if h in aliases and name not in col:
                    col[name] = i

        def get(row: Sequence[Any], name: str) -> Any:
            i = col.get(name)
            return row[i] if i is not None and i < len(row) else None

        cs = ChangeSet(source=os.path.abspath(path), new_root=sbx.root if sbx else "")
        files: Dict[str, FileChange] = {}
        for r, row in enumerate(ws.iter_rows(values_only=True)):
            if r <= hdr_row:
                continue
            fname = get(row, "file")
            if fname is None or not str(fname).strip():
                continue
            fname = str(fname).strip().replace("\\", "/")
            rel = (sbx.resolve(fname) if sbx else None) or fname
            kind = str(get(row, "kind") or "").strip().upper()
            if kind not in ("C", "H", "USER"):
                kind = (sbx.kind_of(rel) if sbx else None) or file_kind(rel, ["*"]) or "USER"
            st_raw = str(get(row, "status") or "").strip().lower()
            status = "Added" if st_raw.startswith(("add", "new")) else \
                "Deleted" if st_raw.startswith(("del", "rem")) else "Modified"
            fn_raw = str(get(row, "function") or "").strip()
            no_func = fn_raw.lower() in (FILE_SCOPE, "file scope", "-", "none", "n/a")
            fnames = [] if no_func else [x for x in re.split(r"[,;\s]+", fn_raw) if x]
            fnames = [x[:-2] if x.endswith("()") else x for x in fnames]
            old_spec = parse_line_spec(get(row, "old_lines"))
            new_spec = parse_line_spec(get(row, "new_lines"))
            for a_name, b_name, spec in (("old_start", "old_end", old_spec), ("new_start", "new_end", new_spec)):
                if not spec and get(row, a_name) is not None:
                    try:
                        a = int(float(str(get(row, a_name))))
                        b = int(float(str(get(row, b_name) or a)))
                        spec.append((a, max(a, b)))
                    except ValueError:
                        pass
            old_code = str(get(row, "old_code") or "")
            new_code = str(get(row, "new_code") or "")
            note = str(get(row, "note") or "")
            cid = str(get(row, "cid") or "").strip()
            made: List[Change] = []

            def mk(a: int, b: int, fns: List[str], code: str, nt: str) -> Change:
                ch = Change(cid=cid, file=rel, kind=kind, status=status, functions=list(fns), note=nt)
                if status == "Deleted":
                    ch.old_start, ch.old_end, ch.old_code = a, b, code or old_code
                else:
                    ch.new_start, ch.new_end, ch.new_code = a, b, code
                    ch.old_code = old_code
                    if old_spec:
                        ch.old_start, ch.old_end = old_spec[0]
                return ch

            def src(a: int, b: int) -> str:
                if sbx and status != "Deleted":
                    ls = sbx.lines(rel)
                    if ls and a >= 1:
                        return _cap_lines(ls[a - 1:b])
                return ""

            if new_spec and status != "Deleted":
                for n_i, (a, b) in enumerate(new_spec):
                    code = new_code if (n_i == 0 and new_code) else src(a, b)
                    fns = fnames or ([f.name for f in sbx.funcs_in_range(rel, a, b)] if sbx and not no_func else [])
                    made.append(mk(a, b, fns, code, note))
            elif fnames:
                for fn in fnames:
                    f = sbx.find_func(fn, rel) if sbx else None
                    if f is not None and f.file == rel and status != "Deleted":
                        made.append(mk(f.lead, f.end, [fn], new_code or src(f.lead, f.end), note))
                    else:
                        made.append(mk(old_spec[0][0] if old_spec else 0, old_spec[0][1] if old_spec else 0,
                                       [fn], new_code, note))
            elif old_spec or new_code or old_code:
                a, b = old_spec[0] if old_spec else (0, 0)
                ch = Change(cid=cid, file=rel, kind=kind, status=status, old_start=a, old_end=b,
                            old_code=old_code, new_code=new_code, note=note)
                made.append(ch)
            else:
                fl = sbx.funcs_by_file.get(rel, []) if sbx else []
                if fl and status != "Deleted":
                    for f in fl:
                        made.append(mk(f.lead, f.end, [f.name], src(f.lead, f.end), note or "whole file"))
                else:
                    n_lines = len(sbx.lines(rel)) if sbx else 0
                    made.append(mk(1 if n_lines else 0, n_lines, [], src(1, min(n_lines, 300)),
                                   note or "whole file"))
            cs.changes += made
            fc = files.setdefault(rel, FileChange(rel, kind, status))
            fc.hunks += len(made)
            for ch in made:
                if ch.new_end >= ch.new_start > 0:
                    fc.added += ch.new_end - ch.new_start + 1
                if ch.old_end >= ch.old_start > 0:
                    fc.removed += ch.old_end - ch.old_start + 1
                for fn in ch.functions:
                    if fn not in fc.functions:
                        fc.functions.append(fn)
        cs.files = list(files.values())
        seen_ids: Set[str] = set()
        for n, ch in enumerate(cs.changes, 1):
            if not ch.cid or ch.cid in seen_ids:
                ch.cid = "C%04d" % n
                while ch.cid in seen_ids:
                    ch.cid += "x"
            seen_ids.add(ch.cid)
        cs.stats = {"changed_files": len(cs.files), "changes": len(cs.changes),
                    "c_files": sum(1 for f in cs.files if f.kind == "C"),
                    "h_files": sum(1 for f in cs.files if f.kind == "H"),
                    "user_files": sum(1 for f in cs.files if f.kind == "USER")}
        return cs
    finally:
        wb.close()


