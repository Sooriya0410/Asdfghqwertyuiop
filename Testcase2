# 5. SANDBOX COMPARISON  (which files / which lines changed)
# ============================================================================
@dataclass
class Change:
    """One changed block of lines (a diff hunk, or one function of an added file)."""
    cid: str = ""
    file: str = ""
    kind: str = "C"                  # C / H / USER
    status: str = "Modified"         # Modified / Added / Deleted
    functions: List[str] = field(default_factory=list)
    old_start: int = 0
    old_end: int = 0
    new_start: int = 0
    new_end: int = 0
    old_code: str = ""
    new_code: str = ""
    note: str = ""

    @property
    def old_lines(self) -> str:
        return fmt_range(self.old_start, self.old_end)

    @property
    def new_lines(self) -> str:
        return fmt_range(self.new_start, self.new_end)

    def label(self) -> str:
        fn = ", ".join(f + "()" for f in self.functions[:3])
        if len(self.functions) > 3:
            fn += " +%d" % (len(self.functions) - 3)
        parts = [self.file]
        if fn:
            parts.append(fn)
        if self.new_lines:
            parts.append("L" + self.new_lines)
        elif self.old_lines:
            parts.append("old L" + self.old_lines)
        return "  ::  ".join(parts)


@dataclass
class FileChange:
    file: str
    kind: str
    status: str
    added: int = 0
    removed: int = 0
    hunks: int = 0
    functions: List[str] = field(default_factory=list)
    note: str = ""


@dataclass
class ChangeSet:
    changes: List[Change] = field(default_factory=list)
    files: List[FileChange] = field(default_factory=list)
    stats: Dict[str, Any] = field(default_factory=dict)
    old_root: str = ""
    new_root: str = ""
    source: str = ""

    def renumber(self) -> None:
        for n, ch in enumerate(self.changes, 1):
            ch.cid = "C%04d" % n


def diff_ranges(a: List[str], b: List[str], ignore_ws: bool = True) -> List[Tuple[str, int, int, int, int]]:
    """Line diff.  Returns [(tag, i1, i2, j1, j2)] for changed blocks only
    (0-based, half open - same meaning as difflib opcodes)."""
    if ignore_ws:
        na = [" ".join(x.split()) for x in a]
        nb = [" ".join(x.split()) for x in b]
    else:
        na, nb = a, b
    n, m = len(na), len(nb)
    p = 0
    lim = min(n, m)
    while p < lim and na[p] == nb[p]:
        p += 1
    s = 0
    while s < lim - p and na[n - 1 - s] == nb[m - 1 - s]:
        s += 1
    ca, cb = na[p:n - s], nb[p:m - s]
    if not ca and not cb:
        return []
    if not ca:
        ops = [("insert", p, p, p, m - s)]
    elif not cb:
        ops = [("delete", p, n - s, p, p)]
    elif len(ca) * len(cb) > 4000000000:        # two huge, heavily changed files: one block
        ops = [("replace", p, n - s, p, m - s)]
    else:
        sm = difflib.SequenceMatcher(None, ca, cb, autojunk=(len(ca) + len(cb) > 20000))
        ops = [(t, i1 + p, i2 + p, j1 + p, j2 + p) for t, i1, i2, j1, j2 in sm.get_opcodes() if t != "equal"]
    if ignore_ws:
        ops = [o for o in ops if any(na[o[1]:o[2]]) or any(nb[o[3]:o[4]])]
    return ops


def _same_bytes(a: str, b: str, chunk: int = 1 << 20) -> bool:
    """True when two files of equal size have identical content (read in 1 MB blocks)."""
    with open(a, "rb") as fa, open(b, "rb") as fb:
        while True:
            x = fa.read(chunk)
            if x != fb.read(chunk):
                return False
            if not x:
                return True


def _cap_lines(lines: Sequence[str], cap: int = 400) -> str:
    if len(lines) > cap:
        return "\n".join(lines[:cap]) + "\n... [%d more lines]" % (len(lines) - cap)
    return "\n".join(lines)


def _overlap(funcs: Sequence[Sequence[Any]], a: int, b: int) -> List[Sequence[Any]]:
    return [f for f in funcs if f[1] <= b and f[3] >= a]


def _same_code(a: Sequence[str], b: Sequence[str]) -> bool:
    return "".join("".join(x.split()) for x in a) == "".join("".join(x.split()) for x in b)


def _file_as_changes(rel: str, kind: str, status: str, text: Optional[str], is_new: bool) -> Tuple[List[Change], FileChange]:
    """An added (or deleted) file: one change per function plus one for the file scope."""
    fc = FileChange(rel, kind, status)
    if text is None:
        fc.note = "binary file"
        return [Change(file=rel, kind=kind, status=status, note="binary file")], fc
    lines = split_lines(text)
    n = len(lines)
    if is_new:
        fc.added = n
    else:
        fc.removed = n
    funcs: List[List[Any]] = []
    if os.path.splitext(rel.lower())[1] in C_LIKE_EXT and len(text) <= MAX_FILE_BYTES:
        try:
            funcs = parse_c(text)["f"]
        except Exception:
            funcs = []
    fc.functions = [f[0] for f in funcs]
    out: List[Change] = []

    def mk(a: int, b: int, code: str, fnames: List[str], note: str) -> Change:
        ch = Change(file=rel, kind=kind, status=status, functions=fnames, note=note)
        if is_new:
            ch.new_start, ch.new_end, ch.new_code = a, b, code
        else:
            ch.old_start, ch.old_end, ch.old_code = a, b, code
        return ch

    word = "new file" if is_new else "deleted file"
    if not funcs:
        out.append(mk(1, n, _cap_lines(lines, 300), [], word))
    else:
        covered = [False] * (n + 2)
        for f in funcs:
            a, b = f[1], min(f[3], n)
            for i in range(a, b + 1):
                covered[i] = True
            out.append(mk(a, b, _cap_lines(lines[a - 1:b]), [f[0]], word))
        rest = [lines[i - 1] for i in range(1, n + 1) if not covered[i] and lines[i - 1].strip()]
        if rest:
            out.insert(0, mk(1, n, _cap_lines(rest, 200), [], word + " - file scope (outside functions)"))
    fc.hunks = len(out)
    return out, fc


def compare_sandboxes(old_root: str, new_root: str, user_patterns: Sequence[str],
                      exclude_dirs: Sequence[str], ignore_ws: bool = True,
                      progress: ProgressFn = None,
                      new_table: Optional[Dict[str, Tuple[str, str, str]]] = None) -> ChangeSet:
    """Compare two sandboxes and return every changed file and changed line block."""
    t0 = time.time()
    _progress(progress, "Scanning old sandbox ...")
    old_tab = scan_tree(old_root, user_patterns, exclude_dirs)
    _progress(progress, "Scanning new sandbox ...")
    new_tab = new_table if new_table is not None else scan_tree(new_root, user_patterns, exclude_dirs)
    cs = ChangeSet(old_root=os.path.abspath(old_root), new_root=os.path.abspath(new_root), source="compare")
    keys = sorted(set(old_tab) | set(new_tab))
    total = max(1, len(keys))
    same = ws_only = 0
    for n, key in enumerate(keys):
        if n % 100 == 0:
            _progress(progress, "Comparing files: %d / %d" % (n, total), n / total)
        o, nw = old_tab.get(key), new_tab.get(key)
        if o is None and nw is not None:
            chs, fc = _file_as_changes(nw[0], nw[2], "Added", read_text_file(nw[1]), True)
            cs.changes += chs
            cs.files.append(fc)
            continue
        if nw is None and o is not None:
            chs, fc = _file_as_changes(o[0], o[2], "Deleted", read_text_file(o[1]), False)
            cs.changes += chs
            cs.files.append(fc)
            continue
        assert o is not None and nw is not None
        rel, kind = nw[0], nw[2]
        try:
            sa, sb = os.path.getsize(o[1]), os.path.getsize(nw[1])
            if sa == sb and _same_bytes(o[1], nw[1]):
                same += 1
                continue
            if max(sa, sb) > MAX_FILE_BYTES:
                note = "file larger than %d MB changed - not compared line by line" % (MAX_FILE_BYTES >> 20)
                cs.changes.append(Change(file=rel, kind=kind, status="Modified", note=note))
                cs.files.append(FileChange(rel, kind, "Modified", hunks=1, note=note))
                continue
            with open(o[1], "rb") as fh:
                da = fh.read()
            with open(nw[1], "rb") as fh:
                db = fh.read()
        except OSError as exc:
            cs.files.append(FileChange(rel, kind, "Modified", note="could not read: %s" % exc))
            continue
        ta, tb = decode_bytes(da), decode_bytes(db)
        if ta is None or tb is None:
            cs.changes.append(Change(file=rel, kind=kind, status="Modified", note="binary file changed"))
            cs.files.append(FileChange(rel, kind, "Modified", hunks=1, note="binary file changed"))
            continue
        la, lb = split_lines(ta), split_lines(tb)
        ops = diff_ranges(la, lb, ignore_ws)
        if not ops:
            ws_only += 1
            continue
        fa: List[List[Any]] = []
        fb: List[List[Any]] = []
        ca: List[str] = []
        cb: List[str] = []
        if os.path.splitext(key)[1] in C_LIKE_EXT and max(len(da), len(db)) <= MAX_FILE_BYTES:
            try:
                pa, pb = parse_c(ta, True), parse_c(tb, True)
                fa, fb = pa["f"], pb["f"]
                ca, cb = split_lines(pa["code"]), split_lines(pb["code"])
            except Exception:
                fa, fb, ca, cb = [], [], [], []
        fc = FileChange(rel, kind, "Modified")
        touched: Dict[str, None] = {}
        for tag, i1, i2, j1, j2 in ops:
            fc.removed += i2 - i1
            fc.added += j2 - j1
            note = ""
            if ca and cb and _same_code(ca[i1:i2], cb[j1:j2]):
                note = "comment-only change"
            new_f = _overlap(fb, j1 + 1, j2) if j2 > j1 else _overlap(fb, j1 + 1, j1 + 1)
            old_f = _overlap(fa, i1 + 1, i2) if i2 > i1 else []
            pieces: List[Change] = []
            if tag == "insert" and len(new_f) > 1:
                for f in new_f:
                    a, b = max(f[1], j1 + 1), min(f[3], j2)
                    pieces.append(Change(file=rel, kind=kind, functions=[f[0]], new_start=a, new_end=b,
                                         new_code=_cap_lines(lb[a - 1:b]), note=note or "new function"))
            elif tag == "delete" and len(old_f) > 1:
                for f in old_f:
                    a, b = max(f[1], i1 + 1), min(f[3], i2)
                    pieces.append(Change(file=rel, kind=kind, functions=[f[0]], old_start=a, old_end=b,
                                         new_start=j1 + 1 if j1 < len(lb) else len(lb), new_end=0,
                                         old_code=_cap_lines(la[a - 1:b]), note=note or "removed function"))
            else:
                names = list(dict.fromkeys([f[0] for f in new_f] + [f[0] for f in old_f]))
                ch = Change(file=rel, kind=kind, functions=names, note=note)
                if i2 > i1:
                    ch.old_start, ch.old_end, ch.old_code = i1 + 1, i2, _cap_lines(la[i1:i2])
                if j2 > j1:
                    ch.new_start, ch.new_end, ch.new_code = j1 + 1, j2, _cap_lines(lb[j1:j2])
                else:
                    ch.new_start = min(j1 + 1, max(1, len(lb)))      # position of the deletion
                pieces.append(ch)
            for ch in pieces:
                ch.status = "Modified"
                for fn in ch.functions:
                    touched[fn] = None
            cs.changes += pieces
            fc.hunks += len(pieces)
        fc.functions = list(touched)
        cs.files.append(fc)
    cs.renumber()
    by_kind = Counter((f.kind, f.status) for f in cs.files)
    cs.stats = {
        "files_compared": len(keys), "identical": same, "whitespace_only": ws_only,
        "changed_files": len(cs.files), "changes": len(cs.changes),
        "c_files": sum(v for (k, _s), v in by_kind.items() if k == "C"),
        "h_files": sum(v for (k, _s), v in by_kind.items() if k == "H"),
        "user_files": sum(v for (k, _s), v in by_kind.items() if k == "USER"),
        "added": sum(v for (_k, s), v in by_kind.items() if s == "Added"),
        "deleted": sum(v for (_k, s), v in by_kind.items() if s == "Deleted"),
        "modified": sum(v for (_k, s), v in by_kind.items() if s == "Modified"),
        "seconds": round(time.time() - t0, 2),
    }
    _progress(progress, "Comparison finished: %d changed files, %d changed blocks"
              % (len(cs.files), len(cs.changes)), 1.0)
    return cs


