def enforce_offline() -> None:
    """Disable network sockets for this process.  The tool never needs them;
    this makes "never connects to the internet" a hard guarantee instead of a
    promise."""
    try:
        import socket
    except Exception:           # pragma: no cover - socket module missing
        return
    if getattr(socket, "_stcm_offline", False):
        return

    _real = socket.socket

    class _BlockedSocket(_real):                      # type: ignore[misc, valid-type]
        def __init__(self, *a, **k):                  # noqa: D401
            raise OSError("Network access is disabled: %s is offline by design." % APP_NAME)

    def _blocked(*a, **k):
        raise OSError("Network access is disabled: %s is offline by design." % APP_NAME)

    socket.socket = _BlockedSocket                    # type: ignore[misc]
    socket.create_connection = _blocked               # type: ignore[assignment]
    socket.getaddrinfo = _blocked                     # type: ignore[assignment]
    socket._stcm_offline = True                       # type: ignore[attr-defined]


