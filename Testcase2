W_NEW, W_OLD, W_FUNC, W_DOC, W_BODYCMT, W_BODY = 3.0, 2.2, 3.0, 2.0, 1.2, 0.5
W_FILE, W_DIR, W_CALLER1, W_CALLER2, W_USER, W_INCLUDER = 1.6, 0.7, 1.0, 0.5, 0.8, 0.5
W_REF = 3.0
MAX_Q_TERMS, MAX_Q_RAWS = 80, 40


@dataclass
class Query:
    label: str = ""
    terms: Dict[str, float] = field(default_factory=dict)      # stemmed word -> weight (~0..1.4)
    raws: Dict[str, float] = field(default_factory=dict)       # literal identifier / number -> weight
    prov: Dict[str, str] = field(default_factory=dict)         # token -> where it came from
    surf: Dict[str, str] = field(default_factory=dict)         # stem -> word as written
    keys: List[Tuple[str, float]] = field(default_factory=list)  # memory keys (line / function / symbol / file)
    context: List[str] = field(default_factory=list)           # analysis notes for the user
    code: str = ""
    comp: Set[str] = field(default_factory=set)                # terms that are only joins of identifier parts


class _QueryBuilder:
    def __init__(self, sbx: Optional[SandboxIndex]):
        self.sbx = sbx
        self.w: Dict[str, float] = {}
        self.cnt: Dict[str, int] = {}
        self.r: Dict[str, float] = {}
        self.prov: Dict[str, str] = {}
        self.surf: Dict[str, str] = {}
        self.keys: Dict[str, float] = {}
        self.context: List[str] = []
        self.plain: Set[str] = set()
        self.comp: Set[str] = set()

    def add(self, text: str, weight: float, source: str) -> None:
        if not text:
            return
        for kind, tok, sf in iter_tokens(text):
            if kind != "r":
                wt = weight
                if kind == "c":
                    wt = 0.6 * weight
                    self.comp.add(tok)
                else:
                    self.plain.add(tok)
                cur = self.w.get(tok)
                if cur is None or wt > cur:
                    self.w[tok] = wt
                    self.prov[tok] = source
                    self.surf[tok] = sf
                self.cnt[tok] = self.cnt.get(tok, 0) + 1
            else:
                if weight > self.r.get(tok, 0.0):
                    self.r[tok] = weight
                    self.prov[tok] = source

    def key(self, name: str, spec: float) -> None:
        if spec > self.keys.get(name, 0.0):
            self.keys[name] = spec

    def finish(self, label: str, code: str = "") -> Query:
        sbx = self.sbx
        terms: Dict[str, float] = {}
        for t, w in self.w.items():
            v = w * (1.0 + min(0.4, 0.1 * (self.cnt.get(t, 1) - 1))) / W_REF
            if sbx is not None:
                v *= sbx.tok_factor(t)
            terms[t] = round(v, 4)
        top = sorted(terms.items(), key=lambda kv: (-kv[1], kv[0]))[:MAX_Q_TERMS]
        raws = sorted(((r, round(w / W_REF, 4)) for r, w in self.r.items()),
                      key=lambda kv: (-kv[1], kv[0]))[:MAX_Q_RAWS]
        keys = sorted(self.keys.items(), key=lambda kv: (-kv[1], kv[0]))
        q = Query(label=label, terms=dict(top), raws=dict(raws), keys=[(k, round(s, 3)) for k, s in keys],
                  context=self.context, code=code)
        q.prov = {t: self.prov.get(t, "") for t in list(q.terms) + list(q.raws)}
        q.surf = {t: self.surf.get(t, t) for t in q.terms}
        q.comp = {t for t in q.terms if t in self.comp and t not in self.plain}
        return q


_RE_SHORT_NAME = re.compile(r"<SHORT-NAME>\s*([^<\s]+)\s*</SHORT-NAME>", re.I)


def _symbols_in(text: str, limit: int = 30) -> List[str]:
    """Identifiers worth following through the sandbox (macros, signals, typed names)."""
    out: Dict[str, None] = {}
    for ident in _RE_IDENT.findall(text):
        if ident in C_KEYWORDS:
            continue
        if is_complex_identifier(ident) or (len(ident) >= 4 and ident.isupper()):
            out[ident] = None
            if len(out) >= limit:
                break
    return list(out)


def _line_keys(code: str, limit: int = 25) -> List[str]:
    keys: List[str] = []
    for line in code.split("\n"):
        norm = " ".join(line.split())
        if len(norm) >= 8 and _RE_IDENT.search(norm) and not norm.startswith("... ["):
            keys.append("line:" + sha1_short(norm, 12))
            if len(keys) >= limit:
                break
    return keys


def pretty_key(key: str) -> str:
    kind, _, val = key.partition(":")
    return {"line": "this exact code line", "func": "function %s()" % val, "sym": "identifier %s" % val,
            "file": "file %s" % val, "mod": "folder %s" % val}.get(kind, key)


