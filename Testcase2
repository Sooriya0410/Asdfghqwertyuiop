        self.assertGreaterEqual(o[missed.key].conf, LEVEL_MED)
        self.assertGreater(o[missed.key].feats["link"], 0.5)
        self.assertNotIn(wrong.key, o)
        # ... but the rejection does not leak into other functions
        full = eng.match(eng.query_for_change(_change("PwrMgr_CheckOverVolt") if False else
                                              next(c for c in _ctx()["cs"].changes if c.file.endswith("PwrMgr_Cfg.h"))),
                         threshold=0.0, limit=None, only={wrong.idx})
        self.assertEqual(full[0].feats["neg"], 0.0)

