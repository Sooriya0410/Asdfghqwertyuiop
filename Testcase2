    def _fill_train_changes(self) -> None:
        t = self.tree_tq
        t.delete(*t.get_children(""))
        if not self.cs:
            return
        for ch in self.cs.changes:
            t.insert("", "end", iid=ch.cid, values=(ch.cid, ch.label()),
                     tags=("done",) if ch.cid in self.t_done else ())

    def _with_engine(self, then: Callable[[], None]) -> None:
        """Run 'then' on the GUI thread once test cases (and sandbox) are loaded."""
        inp = self.inputs()
        if not inp["tc"]:
            messagebox.showinfo(APP_NAME, "Select the test-case Excel first.")
            return
        fresh = False
        if self.engine is not None and os.path.isfile(inp["tc"]):
            sig = (os.path.abspath(inp["tc"]), os.path.getmtime(inp["tc"]), os.path.getsize(inp["tc"]))
            sbx_ok = (not inp["new"]) or self._sbx_sig == (
                os.path.abspath(inp["new"]), tuple(inp["patterns"]), tuple(inp["exclude"]))
            fresh = sig == self._tc_sig and sbx_ok
        if fresh:
            then()
            return
        self.run_bg("Loading test cases", lambda p: self._prepare(inp, p, True, True), lambda _r: then())

    def act_train_text(self) -> None:
        text = self.txt_input.get("1.0", "end").strip("\n")
        if not text.strip():
            messagebox.showinfo(APP_NAME, "Type or paste a code line, a function name or a snippet first.")
            return

        def go() -> None:
            assert self.engine is not None
            self.t_cid = ""
            self._show_training(self.engine.query_for_text(text), "Input: " + text.strip().split("\n")[0][:100])

        self._with_engine(go)

    def train_on_change(self, ch: Change) -> None:
        def go() -> None:
            assert self.engine is not None
            self.t_cid = ch.cid
            if self.tree_tq.exists(ch.cid):
                self.tree_tq.selection_set(ch.cid)
                self.tree_tq.see(ch.cid)
            self._show_training(self.engine.query_for_change(ch), "Change %s:  %s" % (ch.cid, ch.label()),
                                self._change_segments(ch, None))

        self._with_engine(go)

    def act_train_queue(self) -> None:
        sel = self.tree_tq.selection()
        if not sel or not self.cs:
            messagebox.showinfo(APP_NAME, "Load changes in the WORKING window first, then select one here.")
            return
        ch = next((c for c in self.cs.changes if c.cid == sel[0]), None)
        if ch:
            self.train_on_change(ch)

    def act_train_next(self) -> None:
        if not self.cs or not self.cs.changes:
            messagebox.showinfo(APP_NAME, "Load changes in the WORKING window first.")
            return
        ids = [c.cid for c in self.cs.changes]
        start = ids.index(self.t_cid) + 1 if self.t_cid in ids else 0
        order = ids[start:] + ids[:start]
        nxt = next((c for c in order if c not in self.t_done), None)
        if nxt is None:
            messagebox.showinfo(APP_NAME, "Every loaded change has been trained in this session.")
            return
        self.train_on_change(next(c for c in self.cs.changes if c.cid == nxt))

    def _show_training(self, q: Query, title: str, intro: Optional[List[Tuple[str, str]]] = None,
                       after_learning: bool = False) -> None:
        assert self.engine is not None
        thr = self.threshold()
        if self.v_weak.get():
            thr = min(thr, 0.06)
        self.t_query = q
        self.t_matches = self.engine.match(q, thr)
        self.t_verdicts = {}
        self.t_expected = []
        self.t_intro = intro or ([("Input\n", "h"), (q.code + "\n", "code")] if q.code else [])
        if q.context:
            self.t_intro = list(self.t_intro) + [("\nSandbox analysis\n", "h")] + [("  " + c + "\n", "") for c in q.context]
        self.lst_exp.delete(0, "end")
        self.v_mark.set(-1)
        self.v_note.set("")
        self.lbl_tq.configure(text="2  Model's answer%s - mark every test case Right or Wrong"
                              % (" AFTER learning" if after_learning else ""))
        self.lbl_tq2.configure(text="%s    ->  %d test case(s)" % (title, len(self.t_matches)))
        self._fill_train_tree()
        self._fill(self.txt_train, self.t_intro)
        kids = self.tree_tr.get_children("")
        if kids and not after_learning:
            self.tree_tr.selection_set(kids[0])
            self.tree_tr.focus(kids[0])
            self.tree_tr.focus_set()

    def _fill_train_tree(self) -> None:
        t = self.tree_tr
        keep = t.selection()
        t.delete(*t.get_children(""))
        names = {"R": "RIGHT", "W": "WRONG"}
        for m in self.t_matches:
            v = self.t_verdicts.get(m.tc.key, "")
            t.insert("", "end", iid=str(m.tc.idx), tags=(v or m.level,), values=(
                names.get(v, ""), m.tc.tc_id, "%d%%" % round(m.conf * 100), m.level, m.tc.headline()))
        keep = [k for k in keep if t.exists(k)]
        if keep:
            t.selection_set(keep)

    def _set_verdict(self, v: str, all_rows: bool = False) -> str:
        if self.store is None:
            return "break"
        rows = self.tree_tr.get_children("") if all_rows else self.tree_tr.selection()
        for iid in rows:
            key = self.store.cases[int(iid)].key
            if v:
                self.t_verdicts[key] = v
            else:
                self.t_verdicts.pop(key, None)
        self._fill_train_tree()
        if not all_rows and len(rows) == 1:               # jump to the next row: fast keyboard rating
            nxt = self.tree_tr.next(rows[0])
            if nxt:
                self.tree_tr.selection_set(nxt)
                self.tree_tr.focus(nxt)
                self.tree_tr.see(nxt)
        return "break"

    def _cycle_verdict(self) -> None:
        sel = self.tree_tr.selection()
        if not sel or self.store is None:
            return
        key = self.store.cases[int(sel[0])].key
        cur = self.t_verdicts.get(key, "")
        nxt = {"": "R", "R": "W", "W": ""}[cur]
        if nxt:
            self.t_verdicts[key] = nxt
        else:
            self.t_verdicts.pop(key, None)
        self._fill_train_tree()

    def _on_train_select(self, _evt: Any = None) -> None:
        sel = self.tree_tr.selection()
        if not sel or self.store is None:
            return
        idx = int(sel[-1])
        m = next((x for x in self.t_matches if x.tc.idx == idx), None)
        self._fill(self.txt_train, self._tc_segments(self.store.cases[idx], m))

    def act_search(self) -> None:
        def go() -> None:
            assert self.engine is not None
            self.t_search_hits = self.engine.search(self.v_search.get(), 80)
            self.lst_hits.delete(0, "end")
            for tc in self.t_search_hits:
                self.lst_hits.insert("end", "%s   %s" % (tc.tc_id, tc.headline(90)))
            if not self.t_search_hits:
                self.lst_hits.insert("end", "(nothing found)")

        self._with_engine(go)

    def _on_hit_select(self, _evt: Any = None) -> None:
        sel = self.lst_hits.curselection()
        if sel and sel[0] < len(self.t_search_hits):
            self._fill(self.txt_train, self._tc_segments(self.t_search_hits[sel[0]], None))

    def act_add_expected(self) -> None:
        sel = self.lst_hits.curselection()
        if not sel or sel[0] >= len(self.t_search_hits):
            return
        if self.t_query is None:
            messagebox.showinfo(APP_NAME, "First ask the model (step 1), then add the expected test cases.")
            return
        tc = self.t_search_hits[sel[0]]
        if any(m.tc.key == tc.key for m in self.t_matches):
            self.t_verdicts[tc.key] = "R"                 # it was shown - simply mark it Right
            self._fill_train_tree()
            return
        if tc.key not in self.t_expected:
            self.t_expected.append(tc.key)
            self.lst_exp.insert("end", "%s   %s" % (tc.tc_id, tc.headline(80)))

    def act_remove_expected(self) -> None:
        sel = self.lst_exp.curselection()
        if sel:
            del self.t_expected[sel[0]]
            self.lst_exp.delete(sel[0])

    def act_save_training(self) -> None:
        if self.engine is None or self.t_query is None:
            messagebox.showinfo(APP_NAME, "Nothing to save yet - first ask the model (step 1).")
            return
        mark = int(self.v_mark.get())
        if mark < 0:
            messagebox.showinfo(APP_NAME, "Give marks from 0 to 10 for the model's answer (step 4).")
            return
        if not self.t_verdicts and not self.t_expected and 0 < mark < 10:
            if not messagebox.askyesno(APP_NAME, "You did not mark any test case Right / Wrong and added no "
                                                 "expected test case.\n\nSave the marks only?"):
                return
        q = self.t_query
        try:
            s = self.engine.feedback(q, self.t_matches, dict(self.t_verdicts), list(self.t_expected),
                                     mark, self.v_note.get().strip())
        except Exception as exc:                           # noqa: BLE001
            self._show_error("Save training", exc, traceback.format_exc())
            return
        if self.t_cid:
            self.t_done.add(self.t_cid)
            if self.tree_tq.exists(self.t_cid):
                self.tree_tq.item(self.t_cid, tags=("done",))
        st = self.model.stats()
        msg = "Saved (session %d): %d right, %d wrong, %d missed test case(s) learned.  Average of last 20 marks: %.1f" % (
            st["sessions"], s["right"], s["wrong"], s["missing"], st["avg_mark_last20"] or 0.0)
        title = self.lbl_tq2.cget("text").split("    ->")[0]
        self._show_training(q, title, self.t_intro_base(), after_learning=True)
        self.lbl_learned.configure(text=msg + "   The list above is the model's NEW answer.")
        if self.results:
            msg += "   (WORKING window: press 'Find test cases' again to use what was learned.)"
        self.set_status(msg)
        self.refresh_model_tab()

    def t_intro_base(self) -> Optional[List[Tuple[str, str]]]:
        if self.t_cid and self.cs:
            ch = next((c for c in self.cs.changes if c.cid == self.t_cid), None)
            if ch:
                return self._change_segments(ch, None)
        return None

