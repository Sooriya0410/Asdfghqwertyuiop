    def _browse_dir(self, var: Any) -> None:
        d = filedialog.askdirectory(initialdir=var.get() or None, title="Select folder")
        if d:
            var.set(os.path.normpath(d))

    def _browse_file(self, var: Any, types: Sequence[Tuple[str, str]]) -> None:
        start = os.path.dirname(var.get()) if var.get() else None
        f = filedialog.askopenfilename(initialdir=start, filetypes=list(types), title="Select file")
        if f:
            var.set(os.path.normpath(f))

    def inputs(self) -> Dict[str, Any]:
        return {"new": self.v_new.get().strip().strip('"'), "old": self.v_old.get().strip().strip('"'),
                "changes": self.v_changes.get().strip().strip('"'), "tc": self.v_tc.get().strip().strip('"'),
                "patterns": split_patterns(self.v_patterns.get()), "exclude": split_patterns(self.v_exclude.get()),
                "ignore_ws": bool(self.v_ignore_ws.get()), "ignore_cmt": bool(self.v_ignore_cmt.get()),
                "thr": self.threshold()}

    def threshold(self) -> float:
        return max(0.02, min(0.9, float(self.v_thr.get()) / 100.0))

    # ---- status bar + background jobs -----------------------------------------------
    def _build_status(self) -> None:
        bar = ttk.Frame(self.root)
        bar.pack(fill="x", side="bottom", padx=8, pady=(0, 6))
        self.pb = ttk.Progressbar(bar, length=220, mode="determinate", maximum=1000)
        self.pb.pack(side="left")
        self.lbl_status = ttk.Label(bar, text="", anchor="w")
        self.lbl_status.pack(side="left", fill="x", expand=True, padx=8)
        ttk.Label(bar, text="OFFLINE - no network access", style="Ok.TLabel").pack(side="right")

    def set_status(self, msg: str) -> None:
        self.lbl_status.configure(text=msg)

    def run_bg(self, title: str, func: Callable[[ProgressFn], Any], on_done: Callable[[Any], None]) -> None:
        if self.busy:
            self.set_status("Please wait - another task is still running ...")
            return
        self.busy = True
        for b in self._action_buttons:
            b.configure(state="disabled")
        self.set_status(title + " ...")

        def cb(msg: str, frac: float) -> None:
            self.q.put(("progress", msg, frac))

        def worker() -> None:
            try:
                res = func(cb)
                self.q.put(("done", on_done, res))
            except Exception as exc:                       # noqa: BLE001
                self.q.put(("error", title, exc, traceback.format_exc()))

        threading.Thread(target=worker, daemon=True).start()

    def _poll(self) -> None:
        try:
            while True:
                item = self.q.get_nowait()
                kind = item[0]
                if kind == "progress":
                    self.set_status(item[1])
                    if item[2] is not None and item[2] >= 0:
                        self.pb.configure(mode="determinate")
                        self.pb["value"] = int(item[2] * 1000)
                elif kind in ("done", "error"):
                    self.busy = False
                    self.pb["value"] = 0
                    for b in self._action_buttons:
                        b.configure(state="normal")
                    if self._store_reloaded:
                        self._store_reloaded = False
                        self._forget_old_testcases()
                    if kind == "done":
                        try:
                            item[1](item[2])
                        except Exception as exc:           # noqa: BLE001
                            self._show_error("Display", exc, traceback.format_exc())
                    else:
                        self._show_error(item[1], item[2], item[3])
        except queue.Empty:
            pass
        self.root.after(70, self._poll)

    def _forget_old_testcases(self) -> None:
        """A different test-case file was loaded: drop results and ratings of the old one."""
        self.results, self.res_by_cid, self.summary = [], {}, []
        self.t_query, self.t_matches, self.t_verdicts, self.t_expected = None, [], {}, []
        self.t_search_hits = []
        for tree in (self.tree_tc, self.tree_tr):
            tree.delete(*tree.get_children(""))
        self.lst_hits.delete(0, "end")
        self.lst_exp.delete(0, "end")
        self._fill(self.txt_why, [])
        self._fill(self.txt_train, [])
        self._fill_change_tree()

    def _show_error(self, title: str, exc: BaseException, tb: str) -> None:
        self.set_status("%s failed: %s" % (title, exc))
        if isinstance(exc, (UserError, ValueError, RuntimeError, OSError)):
            messagebox.showerror(title, str(exc))
            return
        try:
            with open(self.model.dir / "error.log", "a", encoding="utf-8") as fh:
                fh.write("\n[%s] %s\n%s\n" % (now_iso(), title, tb))
        except OSError:
            pass
        messagebox.showerror(title, "%s\n\nDetails were written to error.log in the model folder." % exc)

    def _prepare(self, inp: Dict[str, Any], progress: ProgressFn, need_tc: bool, need_sbx: bool,
                 force_sbx: bool = False) -> None:
        """(background thread) load test cases / analyse the sandbox when needed."""
        if need_tc:
            path = inp["tc"]
            if not path:
                raise UserError("Select the test-case Excel first (field 'Test-case Excel').")
            if not os.path.isfile(path):
                raise UserError("Test-case file not found:\n%s" % path)
            sig = (os.path.abspath(path), os.path.getmtime(path), os.path.getsize(path))
            if self.store is None or sig != self._tc_sig:
                store = TestCaseStore.load(path, progress)
                index = TCIndex(store, progress)
                self._store_reloaded = self.store is not None
                self.store, self.index, self._tc_sig, self.engine = store, index, sig, None
        if need_sbx and inp["new"]:
            if not os.path.isdir(inp["new"]):
                raise UserError("New sandbox folder not found:\n%s" % inp["new"])
            sig = (os.path.abspath(inp["new"]), tuple(inp["patterns"]), tuple(inp["exclude"]))
            if self.sbx is None or sig != self._sbx_sig or force_sbx:
                self.sbx = SandboxIndex.build(inp["new"], inp["patterns"], inp["exclude"],
                                              self.model.cache_dir, progress)
                self._sbx_sig = sig
        if self.store is not None and self.index is not None:
            if self.engine is None:
                self.engine = Engine(self.model, self.store, self.index, self.sbx)
            else:
                self.engine.sbx = self.sbx

