class T11_Gui(unittest.TestCase):
    """Drives the real GUI (hidden window) through compare -> find -> train -> save."""

    def test_full_flow(self):
        try:
            _import_tk()
            probe = tk.Tk()
            probe.destroy()
        except Exception as exc:                         # no tkinter or no display
            self.skipTest("GUI not available here: %s" % exc)
        c = _ctx()
        c["n"] += 1
        app = App(Path(c["tmp"]) / ("model_%d" % c["n"]))
        app.root.withdraw()
        seen: List[str] = []
        saved = (messagebox.showinfo, messagebox.showerror, messagebox.showwarning, messagebox.askyesno,
                 filedialog.asksaveasfilename)
        messagebox.showinfo = lambda *a, **k: seen.append("info: %s" % (a[1] if len(a) > 1 else ""))
        messagebox.showerror = lambda *a, **k: seen.append("ERROR: %s" % (a[1] if len(a) > 1 else ""))
        messagebox.showwarning = lambda *a, **k: seen.append("warn: %s" % (a[1] if len(a) > 1 else ""))
        messagebox.askyesno = lambda *a, **k: True
        out = os.path.join(c["tmp"], "gui_results.xlsx")
        chg = os.path.join(c["tmp"], "gui_changes.xlsx")
        target = {"path": out}
        filedialog.asksaveasfilename = lambda *a, **k: target["path"]

        def pump(timeout: float = 60.0) -> None:
            end = time.time() + timeout
            app.root.update()
            while app.busy or not app.q.empty():
                app.root.update()
                time.sleep(0.01)
                self.assertLess(time.time(), end, "GUI task timed out")
            app.root.update()

        try:
            app.v_new.set(c["demo"]["new"])
            app.v_old.set(c["demo"]["old"])
            app.v_tc.set(c["demo"]["testcases"])
            app.act_compare()
            pump()
            self.assertEqual(len(app.tree_ch.get_children("")), len(c["cs"].changes) + 1)
            app.act_find()
            pump()
            self.assertEqual(app.tree_ch.selection(), ("ALL",))
            self.assertEqual(len(app.tree_tc.get_children("")), len(app.summary))
            self.assertIn("Why this test case", app.txt_why.get("1.0", "end"))
            cid = _change("PwrMgr_CheckUnderVolt").cid
            app.tree_ch.selection_set(cid)
            pump()
            self.assertIn("uvDbncCycles", app.txt_code.get("1.0", "end"))
            self.assertIn("PwrMgr_MainFunction", app.txt_code.get("1.0", "end"))
            app.act_save_results()
            pump()
            self.assertTrue(os.path.isfile(out))
            # files-changed Excel: save it, then load it back instead of comparing
            target["path"] = chg
            app.act_save_changes()
            pump()
            app.v_changes.set(chg)
            app.act_load_changes()
            pump()
            self.assertEqual(len(app.cs.changes), len(c["cs"].changes))
            self.assertEqual(app.results, [])
            app.act_find()
            pump()
            self.assertEqual(len(app.results), len(c["cs"].changes))
            app.tree_ch.selection_set(cid)
            pump()
            # training: change from the list
            app.act_train_selected()
            pump()
            rows = app.tree_tr.get_children("")
            self.assertGreater(len(rows), 10)
            app.tree_tr.selection_set(rows[0])
            app._set_verdict("R")
            app.tree_tr.selection_set(rows[1])
            app._set_verdict("W")
            app.v_search.set("door lock activation")
            app.act_search()
            pump()
            app.lst_hits.selection_set(0)
            app.act_add_expected()
            self.assertEqual(len(app.t_expected), 1)
            expected_key = app.t_expected[0]
            app.v_mark.set(4)
            app.act_save_training()
            pump()
            self.assertEqual(len(app.model.history), 1)
            self.assertIn(expected_key, [m.tc.key for m in app.t_matches])        # new answer contains it
            self.assertIn(cid, app.t_done)
            # training: free text
            app.txt_input.insert("1.0", "WdgM_AliveCnt[se] = 0U;")
            app.act_train_text()
            pump()
            self.assertGreater(len(app.t_matches), 5)
            app._set_verdict("R", True)
            app.v_mark.set(9)
            app.act_save_training()
            pump()
            self.assertEqual(len(app.model.history), 2)
            app.act_train_next()
            pump()
            # model window
            app.v_ga.set("uvlo")
            app.v_gm.set("under voltage lockout")
            app.act_gloss_add()
            self.assertIn("uvlo", app.model.glossary.user)
            app.tree_hist.selection_set(app.tree_hist.get_children("")[0])
            app.act_delete_sessions()
            pump()
            self.assertEqual(len(app.model.history), 1)
            app.act_retrain()
            pump()
            self.assertEqual(len(app.model.history), 1)
            self.assertFalse([s for s in seen if s.startswith("ERROR")], seen)
            app._on_close()
            self.assertTrue((app.model.dir / "settings.json").is_file())
        finally:
            (messagebox.showinfo, messagebox.showerror, messagebox.showwarning, messagebox.askyesno,
             filedialog.asksaveasfilename) = saved
            try:
                app.root.destroy()
            except Exception:
                pass


def run_selftest() -> int:
    """Run every self-test.  Uses only temporary folders - the real model is not touched."""
    print("%s %s - self-test (Python %s)" % (APP_NAME, APP_VERSION, sys.version.split()[0]))
    loader = unittest.TestLoader()
    suite = unittest.TestSuite()
    for cls in (T01_Text, T02_CParser, T03_Compare, T04_ChangesExcel, T05_TestCases, T06_Matching,
                T07_Learning, T08_Offline, T09_Results, T10_LearningCurve, T11_Gui):
        suite.addTests(loader.loadTestsFromTestCase(cls))
    try:
        result = unittest.TextTestRunner(verbosity=2).run(suite)
    finally:
        tmp = _TEST_CTX.get("tmp")
        _TEST_CTX.clear()
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
    ok = result.wasSuccessful()
    print("\nSELF-TEST %s: %d tests, %d failures, %d errors, %d skipped" % (
        "PASSED" if ok else "FAILED", result.testsRun, len(result.failures), len(result.errors), len(result.skipped)))
    return 0 if ok else 1

