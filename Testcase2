def run_headless(args: argparse.Namespace, model_dir: Path) -> int:
    """Run without GUI:  compare (or load changes) -> find test cases -> write Excel."""
    last = [0.0]

    def progress(msg: str, frac: float) -> None:
        if time.time() - last[0] > 1.0 or frac >= 1.0:
            last[0] = time.time()
            print("  " + msg)

    pats = split_patterns(args.patterns or DEFAULT_USER_PATTERNS)
    excl = split_patterns(args.exclude or DEFAULT_EXCLUDE_DIRS)
    model = Model(model_dir)
    sbx = SandboxIndex.build(args.new, pats, excl, model.cache_dir, progress) if args.new else None
    if args.changes:
        cs = read_changes_excel(args.changes, sbx, pats)
    else:
        cs = compare_sandboxes(args.old, args.new, pats, excl, not args.keep_ws, progress,
                               new_table=sbx.table if sbx else None)
    print("Changes: %d files, %d changed blocks" % (len(cs.files), len(cs.changes)))
    if args.changes_out:
        write_changes_excel(args.changes_out, cs)
        print("Written: %s" % args.changes_out)
    if not args.testcases:
        return 0
    store = TestCaseStore.load(args.testcases, progress)
    for w in store.warnings:
        print("Note: " + w)
    eng = Engine(model, store, sandbox=sbx, progress=progress)
    thr = args.threshold if args.threshold else model.threshold
    results = analyze_changes(eng, cs.changes, thr, progress, not args.with_comments)
    out = args.out or "test_cases_to_run.xlsx"
    write_results_excel(out, results, cs, eng, thr)
    summary = summarize_results(results)
    print("Test cases to run: %d of %d   (model: %d training sessions)" % (
        len(summary), len(store), len(model.history)))
    print("Written: %s" % out)
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="sandbox_tc_mapper",
        description="%s %s - compares two sandboxes and finds the test cases to run. Fully offline." % (
            APP_NAME, APP_VERSION))
    ap.add_argument("--selftest", action="store_true", help="run the built-in self-test suite and exit")
    ap.add_argument("--benchmark", action="store_true", help="simulated training on demo data (shows learning)")
    ap.add_argument("--make-demo", metavar="DIR", help="create demo sandboxes and 3000+ demo test cases in DIR")
    ap.add_argument("--model-dir", help="folder for the trained model data (default %s)" % DEFAULT_MODEL_DIR)
    ap.add_argument("--old", help="old sandbox (baseline)")
    ap.add_argument("--new", help="new sandbox")
    ap.add_argument("--changes", help="files-changed Excel (instead of --old)")
    ap.add_argument("--testcases", help="test-case Excel (column 'Text')")
    ap.add_argument("--out", help="result Excel to write (headless mode)")
    ap.add_argument("--changes-out", help="also write the files-changed Excel here (headless mode)")
    ap.add_argument("--threshold", type=float, help="minimum confidence 0..1 (default: value stored in the model)")
    ap.add_argument("--patterns", help="user file patterns, e.g. \"*.arxml;*.dbc\"")
    ap.add_argument("--exclude", help="folders to ignore, e.g. \".git;build\"")
    ap.add_argument("--keep-ws", action="store_true", help="report white-space-only changes too")
    ap.add_argument("--with-comments", action="store_true", help="find test cases for comment-only changes too")
    args = ap.parse_args(argv)

    if ENFORCE_OFFLINE:
        enforce_offline()
    if args.selftest:
        return run_selftest()
    if args.benchmark:
        run_benchmark()
        return 0
    if args.make_demo:
        demo = make_demo(args.make_demo)
        write_changes_excel(os.path.join(os.path.abspath(args.make_demo), "files_changed_template.xlsx"), None)
        print("Demo data written to %s\n  old sandbox : %s\n  new sandbox : %s\n  test cases  : %s" % (
            os.path.abspath(args.make_demo), demo["old"], demo["new"], demo["testcases"]))
        return 0
    model_dir, note = resolve_model_dir(args.model_dir)
    headless = bool((args.old and args.new) or (args.changes and (args.testcases or args.changes_out)))
    if headless:
        try:
            return run_headless(args, model_dir)
        except (ValueError, RuntimeError, OSError) as exc:
            print("ERROR: %s" % exc, file=sys.stderr)
            return 2
    try:
        run_gui(model_dir, note)
    except ImportError as exc:
        print("The GUI needs tkinter (part of the standard Python installer on Windows): %s" % exc, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
