_RE_SECTION = re.compile(
    r"(?im)(?:^|(?<=[\n.;]))[ \t>*#\-\d.)\]]*"
    r"(?:(?P<pre>pre[\s\-_]*conditions?|pre[\s\-_]*requisites?|initial\s+conditions?|initial\s+state"
    r"|test\s+set[\s\-]*up|set[\s\-]*up)"
    r"|(?P<proc>test\s+procedures?|test\s+steps?|test\s+sequence|test\s+actions?|test\s+description"
    r"|procedures?|steps?|actions?)"
    r"|(?P<exp>expected\s+test\s+results?|expected\s+results?|expected\s+behaviou?r|expected\s+outcomes?"
    r"|expected\s+outputs?|expected\s+response|pass\s+criteria|acceptance\s+criteria|expected))"
    r"\s*\**\s*(?:[:\uff1a=]|-(?=\s)|$)")
_ID_HEADERS = ["testcaseid", "tcid", "testid", "id", "objectidentifier", "objectid", "identifier",
               "absolutenumber", "key", "testcasename", "testcase", "name", "reqid"]
_TEXT_HEADERS_FALLBACK = ["objecttext", "testcasetext", "testtext", "testcase", "testcases", "description"]


def split_sections(text: str) -> Tuple[str, str, str, str]:
    """Split a test case into (title, precondition, procedure, expected result).
    When no section headings are found, everything is treated as procedure."""
    marks = [(m.start(), m.end(), m.lastgroup) for m in _RE_SECTION.finditer(text)]
    if not marks:
        return "", "", text.strip(), ""
    parts = {"pre": [], "proc": [], "exp": []}  # type: Dict[str, List[str]]
    for i, (_s, e, kind) in enumerate(marks):
        nxt = marks[i + 1][0] if i + 1 < len(marks) else len(text)
        body = text[e:nxt].strip()
        if body and kind:
            parts[kind].append(body)
    title = text[:marks[0][0]].strip()
    return title, "\n".join(parts["pre"]), "\n".join(parts["proc"]), "\n".join(parts["exp"])


@dataclass
class TestCase:
    idx: int
    key: str            # stable key used by the trained model
    tc_id: str          # what the user sees
    row: int            # Excel row
    text: str
    title: str = ""
    pre: str = ""
    proc: str = ""
    exp: str = ""
    fp: str = ""        # fingerprint of the text (re-links training when rows move)
    meta: Dict[str, str] = field(default_factory=dict)

    def headline(self, n: int = 110) -> str:
        src = self.title or self.text
        for line in src.split("\n"):
            line = line.strip()
            if line:
                return line if len(line) <= n else line[: n - 1] + "..."
        return ""


class TestCaseStore:
    def __init__(self) -> None:
        self.cases: List[TestCase] = []
        self.by_key: Dict[str, int] = {}
        self.by_fp: Dict[str, int] = {}
        self.path = ""
        self.sheet = ""
        self.id_column = ""
        self.warnings: List[str] = []

    def __len__(self) -> int:
        return len(self.cases)

    def _add(self, tc_id: Optional[str], row: int, text: str, meta: Optional[Dict[str, str]] = None) -> None:
        text = text.replace("_x000D_", "").replace("\r\n", "\n").replace("\r", "\n").strip()
        if not text:
            return
        fp = sha1_short(" ".join(text.lower().split()))
        if tc_id:
            key = "id:" + tc_id
            shown = tc_id
        else:
            key = "fp:" + fp
            shown = "Row %d" % row
        n = 2
        base = key
        while key in self.by_key:
            key = "%s#%d" % (base, n)
            n += 1
        title, pre, proc, exp = split_sections(text)
        idx = len(self.cases)
        self.cases.append(TestCase(idx, key, shown, row, text, title, pre, proc, exp, fp, meta or {}))
        self.by_key[key] = idx
        self.by_fp.setdefault(fp, idx)

    @classmethod
    def from_texts(cls, texts: Sequence[str], ids: Optional[Sequence[str]] = None) -> "TestCaseStore":
        self = cls()
        for i, t in enumerate(texts):
            self._add(ids[i] if ids else None, i + 2, t)
        return self

    @classmethod
    def load(cls, path: str, progress: ProgressFn = None) -> "TestCaseStore":
        """Read the test-case file.  The column named 'Text' holds one test case per row."""
        self = cls()
        self.path = os.path.abspath(path)
        ext = os.path.splitext(path)[1].lower()
        _progress(progress, "Reading test cases ...")
        tables: List[Tuple[str, List[Sequence[Any]]]] = []
        if ext in (".csv", ".txt"):
            with open(path, "r", encoding="utf-8-sig", errors="replace", newline="") as fh:
                tables.append(("csv", [tuple(r) for r in csv.reader(fh)]))
        elif ext == ".xls":
            raise ValueError("Old '.xls' files are not supported - please save the file as '.xlsx'.")
        else:
            openpyxl = require_openpyxl()
            wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
            try:
                for ws in wb.worksheets:
                    if hasattr(ws, "reset_dimensions"):
                        ws.reset_dimensions()          # some exports store a wrong sheet size
                    tables.append((ws.title, [tuple(r) for r in ws.iter_rows(values_only=True)]))
            finally:
                wb.close()
        chosen = None
        for exact in (True, False):
            for title, rows in tables:
                for r, row in enumerate(rows[:40]):
                    heads = [norm_header(c) for c in row]
                    if exact and "text" in heads:
                        chosen = (title, rows, r, heads.index("text"), heads)
                    elif not exact:
                        for alt in _TEXT_HEADERS_FALLBACK:
                            if alt in heads:
                                chosen = (title, rows, r, heads.index(alt), heads)
                                self.warnings.append("No column named 'Text' - using column '%s'."
                                                     % row[heads.index(alt)])
                                break
                    if chosen:
                        break
                if chosen:
                    break
            if chosen:
                break
        if not chosen:
            raise ValueError("No column named 'Text' was found in '%s'." % os.path.basename(path))
        title, rows, hdr, tcol, heads = chosen
        self.sheet = title
        if len(tables) > 1:
            self.warnings.append("The file has %d sheets - using sheet '%s'." % (len(tables), title))
        idcol = -1
        for want in _ID_HEADERS:
            if want in heads and heads.index(want) != tcol:
                idcol = heads.index(want)
                self.id_column = str(rows[hdr][idcol])
                break
        for r in range(hdr + 1, len(rows)):
            row = rows[r]
            if tcol >= len(row) or row[tcol] is None:
                continue
            text = str(row[tcol])
            tc_id = None
            if 0 <= idcol < len(row) and row[idcol] is not None:
                v = row[idcol]
                if isinstance(v, float) and v.is_integer():
                    v = int(v)
                tc_id = str(v).strip() or None
            meta = {}
            for c, h in enumerate(rows[hdr]):
                if c not in (tcol, idcol) and h is not None and c < len(row) and row[c] not in (None, ""):
                    meta[str(h)] = str(row[c])[:200]
                    if len(meta) >= 8:
                        break
            self._add(tc_id, r + 1, text, meta)
        if not self.cases:
            raise ValueError("Column 'Text' is empty in '%s'." % os.path.basename(path))
        if idcol < 0:
            self.warnings.append("No ID column found - test cases are named by Excel row number.")
        return self


def _trigrams(w: str) -> List[str]:
    w2 = "^" + w + "$"
    return [w2[i:i + 3] for i in range(len(w2) - 2)]


def _subseq_span(q: str, t: str) -> int:
    """Length of the shortest prefix of t that contains q as a subsequence (0 = none)."""
    i = 0
    for pos, ch in enumerate(t):
        if ch == q[i]:
            i += 1
            if i == len(q):
                return pos + 1
    return 0


class TCIndex:
    """Inverted index over all test cases (field-weighted BM25 + literal identifier index)."""
    K1 = 0.9
    B = 0.5
    FIELDS = (("title", 1.4, 1), ("pre", 0.8, 2), ("proc", 1.0, 4), ("exp", 1.0, 8))
    FIELD_NAMES = ((1, "title"), (2, "precondition"), (4, "procedure"), (8, "expected result"))

    def __init__(self, store: TestCaseStore, progress: ProgressFn = None):
        self.store = store
        n_docs = len(store)
        post: Dict[str, List[Tuple[int, float]]] = defaultdict(list)
        rawpost: Dict[str, List[int]] = defaultdict(list)
        self.doc_terms: List[Dict[str, Tuple[float, int]]] = []
        self.doc_raws: List[Dict[str, int]] = []
        lengths: List[float] = []
        surf: Dict[str, Dict[str, int]] = {}
        for tc in store.cases:
            if tc.idx % 500 == 0:
                _progress(progress, "Indexing test cases: %d / %d" % (tc.idx, n_docs), tc.idx / max(1, n_docs))
            terms: Dict[str, List[float]] = {}
            raws: Dict[str, int] = {}
            length = 0.0
            for fname, fw, bit in self.FIELDS:
                txt = getattr(tc, fname)
                if not txt:
                    continue
                for kind, tok, sf in iter_tokens(txt):
                    if kind != "r":
                        w_tok = fw if kind == "w" else 0.5 * fw       # compounds count half
                        e = terms.get(tok)
                        if e is None:
                            terms[tok] = [w_tok, bit]
                        else:
                            e[0] += w_tok
                            e[1] = int(e[1]) | bit
                        if kind == "w":
                            length += 1.0
                        sc = surf.get(tok)
                        if sc is None:
                            sc = surf[tok] = {}
                        if len(sc) < 6 or sf in sc:
                            sc[sf] = sc.get(sf, 0) + 1
                    else:
                        raws[tok] = raws.get(tok, 0) | bit
            for t, e in terms.items():
                post[t].append((tc.idx, e[0]))
            for r in raws:
                rawpost[r].append(tc.idx)
            self.doc_terms.append({t: (e[0], int(e[1])) for t, e in terms.items()})
            self.doc_raws.append(raws)
            lengths.append(length)
        self.post = dict(post)
        self.rawpost = dict(rawpost)
        self.n_docs = n_docs
        avg = (sum(lengths) / n_docs) if n_docs else 1.0
        avg = avg or 1.0
        self.dl_norm = [self.K1 * (1.0 - self.B + self.B * ln / avg) for ln in lengths]
        df_ref = max(1.0, n_docs / 100.0)      # words rarer than 1 % of the test cases are "fully specific"
        idf_ref = math.log(1.0 + max(0.5, n_docs - df_ref + 0.5) / (df_ref + 0.5))

        def _idf(df: int) -> float:
            return max(0.02, min(1.0, math.log(1.0 + (n_docs - df + 0.5) / (df + 0.5)) / idf_ref))

        self.idf = {t: _idf(len(p)) for t, p in self.post.items()}
        self.rawidf = {t: _idf(len(p)) for t, p in self.rawpost.items()}
        self.surface = {t: max(sc.items(), key=lambda kv: (kv[1], -len(kv[0])))[0] for t, sc in surf.items()}
        # fuzzy vocabulary lookup
        self._tri: Dict[str, List[str]] = defaultdict(list)
        self._first: Dict[str, List[str]] = defaultdict(list)
        for t in self.idf:
            if len(t) >= 4 and t.isalpha():
                for g in set(_trigrams(t)):
                    self._tri[g].append(t)
                self._first[t[0]].append(t)
        self._fz_cache: Dict[Tuple[str, bool], List[Tuple[str, float]]] = {}
        self._top_cache: Dict[int, List[str]] = {}

    def fuzzy(self, q: str, allow_abbrev: bool = True) -> List[Tuple[str, float]]:
        """Vocabulary words that look like q: truncations (volt -> voltage),
        near spellings and consonant abbreviations (chkpt -> checkpoint)."""
        ck = (q, allow_abbrev)
        hit = self._fz_cache.get(ck)
        if hit is not None:
            return hit
        out: Dict[str, float] = {}
        ln = len(q)
        if ln >= 4 and q.isalpha():
            grams = set(_trigrams(q))
            counts: Dict[str, int] = {}
            for g in grams:
                for t in self._tri.get(g, ()):
                    counts[t] = counts.get(t, 0) + 1
            for t, c in counts.items():
                if t == q:
                    continue
                lt = len(t)
                if t.startswith(q):
                    ratio = ln / lt
                    if ratio < 0.45:
                        continue
                    s = 0.35 + 0.30 * ratio
                elif q.startswith(t):
                    ratio = lt / ln
                    if ratio < 0.5:
                        continue
                    s = 0.30 + 0.30 * ratio
                else:
                    dice = 2.0 * c / (len(grams) + lt)
                    if dice < 0.62 or t[:3] != q[:3]:
                        continue
                    s = 0.30 + 0.5 * (dice - 0.62)
                out[t] = s
        if allow_abbrev and 3 <= ln <= 6 and q.isalpha() and sum(ch in _VOWELS for ch in q) <= 1:
            ab: List[Tuple[float, str]] = []
            for t in self._first.get(q[0], ()):
                if len(t) >= ln + 2 and t not in out:
                    span = _subseq_span(q, t)
                    if span and ln / span >= 0.4:
                        ab.append((0.15 + 0.20 * ln / span, t))
            ab.sort(key=lambda x: (-x[0], len(x[1]), x[1]))
            for s, t in ab[:3]:
                out[t] = s
        res = sorted(out.items(), key=lambda kv: (-kv[1], kv[0]))[:6]
        self._fz_cache[ck] = res
        return res

    def top_terms(self, doc: int, k: int = 10) -> List[str]:
        """The k most characteristic words of a test case (used to learn associations)."""
        hit = self._top_cache.get(doc)
        if hit is None:
            dt = self.doc_terms[doc]
            nm = self.dl_norm[doc]
            ranked = sorted(dt.items(), key=lambda kv: (-(self.idf[kv[0]] * kv[1][0] / (kv[1][0] + nm)), kv[0]))
            hit = [t for t, _ in ranked if len(t) >= 3 and not t.isdigit()][:16]
            self._top_cache[doc] = hit
        return hit[:k]

    def field_names(self, mask: int) -> str:
        return ", ".join(nm for bit, nm in self.FIELD_NAMES if mask & bit) or "text"


