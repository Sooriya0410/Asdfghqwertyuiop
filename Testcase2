        results, cs, eng, thr = self.results, self.cs, self.engine, self.threshold()
        self.run_bg("Saving results Excel", lambda p: (write_results_excel(f, results, cs, eng, thr), f)[1],
                    lambda path: self.set_status("Saved: %s" % path))

