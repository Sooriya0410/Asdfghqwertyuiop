def _demo_case_text(rnd: random.Random, tpl: Dict[str, Any], name: str = "") -> str:
    vals = {"vn": rnd.choice(["12.0", "13.5", "14.0"]), "vl": rnd.choice(["6.0", "6.5", "8.5", "9.0"]),
            "vh": rnd.choice(["16.5", "17.0", "18.0"]), "t": rnd.choice([50, 100, 200, 500, 1000, 2000, 5000]),
            "n": rnd.randint(1, 3), "f": name, "F": name.capitalize()}
    title = rnd.choice(tpl["titles"]).format(**vals)
    pre = rnd.sample(tpl["pre"], 2)
    steps = rnd.sample(tpl["steps"], 3)
    exp = rnd.sample(tpl["exp"], 2)
    style = rnd.random()
    if style < 0.70:
        h = ("Precondition:", "Test Procedure:", "Expected Result:")
    elif style < 0.88:
        h = ("Pre-condition", "Test Steps", "Expected Test Result")
    elif style < 0.95:
        h = ("PRECONDITIONS:", "PROCEDURE:", "EXPECTED RESULTS:")
    else:
        return (title + ". " + " ".join(pre + steps + exp)).format(**vals)
    lines = [title, h[0]] + ["- " + p for p in pre] + [h[1]]
    lines += ["%d. %s" % (i + 1, s) for i, s in enumerate(steps)]
    lines += [h[2]] + ["- " + e for e in exp]
    return "\n".join(lines).format(**vals)


def _demo_module_source(path: str, feats: Sequence[Dict[str, Any]]) -> str:
    mod = os.path.splitext(os.path.basename(path))[0]
    up = mod.upper()
    out = ["/* %s.c - demo module generated by %s */" % (mod, APP_NAME), '#include "%s.h"' % mod,
           '#include "Dem.h"', '#include "Std_Types.h"', "",
           "static uint8 %s_InitDone = 0U;" % mod, "static uint16 %s_Counter = 0U;" % mod, "",
           "/* Initialises the module variables. */", "void %s_Init(void)" % mod, "{",
           "    %s_InitDone = 1U;" % mod, "    %s_Counter = 0U;" % mod, "}", ""]
    for n, f in enumerate(feats):
        out.append("/* %s */" % f["doc"])
        if n % 2 == 0:
            out.append("FUNC(void, %s_CODE) %s(void)" % (up, f["func"]))
        else:
            out.append("void %s(void)" % f["func"])
        out.append("{")
        out += ["    " + ln for ln in f["body"]]
        out += ["}", ""]
    out += ["/* Cyclic function called by the scheduler. */", "void %s_MainFunction(void)" % mod, "{",
            "    if (%s_InitDone != 0U)" % mod, "    {"]
    out += ["        %s();" % f["func"] for f in feats]
    out += ["        %s_Counter++;" % mod, "    }", "}", "",
            "uint16 %s_GetCounter(void)" % mod, "{", "    return %s_Counter;" % mod, "}", ""]
    return "\n".join(out)


def _write(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)


def make_demo(target: str, n_cases: int = 3120, seed: int = 7) -> Dict[str, Any]:
    """Create  <target>/sandbox_old, <target>/sandbox_new  and  <target>/test_cases.xlsx.
    Returns the paths and the 'truth' (which demo test cases belong to which feature)."""
    openpyxl = require_openpyxl()
    rnd = random.Random(seed)
    target = os.path.abspath(target)
    old, new = os.path.join(target, "sandbox_old"), os.path.join(target, "sandbox_new")
    for d in (old, new):
        if os.path.isdir(d):
            shutil.rmtree(d)
    by_file: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for f in _DEMO_FEATURES:
        by_file[f["file"]].append(f)
    files: Dict[str, str] = {}
    for path, feats in by_file.items():
        mod = os.path.splitext(os.path.basename(path))[0]
        files[path] = _demo_module_source(path, feats)
        files[path[:-2] + ".h"] = "\n".join(
            ["#ifndef %s_H" % mod.upper(), "#define %s_H" % mod.upper(), '#include "Std_Types.h"', "",
             "void %s_Init(void);" % mod, "void %s_MainFunction(void);" % mod]
            + ["void %s(void);" % f["func"] for f in feats] + ["", "#endif", ""])
    files["Bsw/PwrMgr/PwrMgr_Cfg.h"] = "\n".join([
        "#ifndef PWRMGR_CFG_H", "#define PWRMGR_CFG_H", "",
        "#define PWR_UV_THR_MV        9000U   /* undervoltage threshold */",
        "#define PWR_UV_DBNC_CYCLES   50U",
        "#define PWR_OV_THR_MV        16000U  /* overvoltage threshold */",
        "#define PWR_OV_DBNC_CYCLES   20U", "", "#endif", ""])
    mods = [os.path.splitext(os.path.basename(p))[0] for p in by_file]
    files["App/Scheduler/Scheduler.c"] = "\n".join(
        ["/* Task scheduler */"] + ['#include "%s.h"' % m for m in mods] + ['#include "PwrMgr_Cfg.h"', "",
         "/* 10 ms task: runs every module main function. */", "void Task_10ms(void)", "{"]
        + ["    %s_MainFunction();" % m for m in mods] + ["}", "", "void Task_Init(void)", "{"]
        + ["    %s_Init();" % m for m in mods] + ["}", ""])
    files["Legacy/HornCtrl.c"] = "\n".join([
        "/* Horn control (obsolete) */", "void HornCtrl_Activate(void)", "{", "    Dio_WriteChannel(DIO_CH_HORN, 1U);",
        "}", ""])
    files["Config/EcuC.arxml"] = "\n".join([
        '<?xml version="1.0" encoding="UTF-8"?>', "<AUTOSAR>", "  <ECUC-CONTAINER-VALUE>",
        "    <SHORT-NAME>NmGlobalConfig</SHORT-NAME>", "    <PARAMETER>",
        "      <SHORT-NAME>NmWaitBusSleepTime</SHORT-NAME>", "      <VALUE>1.5</VALUE>", "    </PARAMETER>",
        "  </ECUC-CONTAINER-VALUE>", "</AUTOSAR>", ""])
    new_files = dict(files)

    def edit(path: str, a: str, b: str) -> None:
        assert a in new_files[path], (path, a)
        new_files[path] = new_files[path].replace(a, b, 1)

    edit("Bsw/PwrMgr/PwrMgr.c", "if (PwrMgr_UvDbncCnt >= PWR_UV_DBNC_CYCLES)",
         "if (PwrMgr_UvDbncCnt > PwrMgr_Cfg.uvDbncCycles)")
    edit("Bsw/PwrMgr/PwrMgr_Cfg.h", "#define PWR_OV_THR_MV        16000U", "#define PWR_OV_THR_MV        16500U")
    edit("Bsw/WdgM/WdgM.c", "if (WdgM_AliveCnt[se] < WDGM_MIN_ALIVE_IND)",
         "if ((WdgM_AliveCnt[se] + WdgM_FailedRefCycleTol) < WDGM_MIN_ALIVE_IND)")
    edit("Bsw/Dcm/Dcm_Rdbi.c", "/* Cyclic function called by the scheduler. */",
         "/* ReadDataByIdentifier 0xF18C: returns the ECU serial number. */\n"
         "void Dcm_Rdbi_F18C_EcuSerial(void)\n{\n    NvM_ReadBlock(NVM_BLOCK_SERIAL, respData);\n"
         "    *respLen = DCM_SERIAL_LENGTH;\n}\n\n/* Cyclic function called by the scheduler. */")
    edit("Bsw/Dcm/Dcm_SecAcc.c", "Dcm_SecAcc_DelayTmr = 10000U;",
         "Dcm_SecAcc_DelayTmr = DCM_SECACC_DELAY_MS * Dcm_SecAcc_FailCnt;")
    edit("Bsw/NvM/NvM_Cal.c", "/* Initialises the module variables. */", "/* Initialises all module variables at start-up. */")
    edit("Com/CanRx.c", "if (CanRx_VehSpd_TmrMs > 100U)", "if (CanRx_VehSpd_TmrMs > 250U)")
    edit("Config/EcuC.arxml", "<VALUE>1.5</VALUE>", "<VALUE>2.0</VALUE>")
    new_files["App/FanCtrl/FanCtrl.c"] = new_files["App/FanCtrl/FanCtrl.c"].replace("    ", "\t")   # white space only
    del new_files["Legacy/HornCtrl.c"]
    old_files = {k: v for k, v in files.items() if not k.startswith("App/TempMon/")}                # added in 'new'
    for root, table in ((old, old_files), (new, new_files)):
        for rel, text in table.items():
            _write(os.path.join(root, rel), text)

    # ---- test cases ----
    topics: List[Tuple[str, Dict[str, Any], str]] = [(f["key"], f, "") for f in _DEMO_FEATURES]
    topics += [("x:" + d, _DISTRACTOR_TPL, d) for d in _DEMO_DISTRACTORS]
    rows: List[Tuple[str, str, str]] = []
    truth: Dict[str, List[str]] = defaultdict(list)
    n = 0
    while len(rows) < n_cases:
        key, tpl, name = topics[n % len(topics)]
        n += 1
        tc_id = "TC-%05d" % n
        rows.append((tc_id, _demo_case_text(rnd, tpl, name), rnd.choice(["High", "Medium", "Low"])))
        truth[key].append(tc_id)
    order = list(range(len(rows)))
    rnd.shuffle(order)
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "TestCases"
    ws.append(["ID", "Text", "Priority"])
    for i in order:
        ws.append(list(rows[i]))
    tc_path = os.path.join(target, "test_cases.xlsx")
    wb.save(tc_path)
    expected = {  # which feature each demo change belongs to: (file, function or '') -> feature keys
        ("Bsw/PwrMgr/PwrMgr.c", "PwrMgr_CheckUnderVolt"): ["uv"],
        ("Bsw/PwrMgr/PwrMgr_Cfg.h", ""): ["ov"],
        ("Bsw/WdgM/WdgM.c", "WdgM_MainFunction"): ["wdg"],
        ("Bsw/Dcm/Dcm_Rdbi.c", "Dcm_Rdbi_F18C_EcuSerial"): ["rdbi"],
        ("Bsw/Dcm/Dcm_SecAcc.c", "Dcm_SecAcc_CompareKey"): ["sec"],
        ("Com/CanRx.c", "CanRx_VehSpd_TimeoutChk"): ["rxto"],
        ("Config/EcuC.arxml", ""): ["nm"],
        ("App/TempMon/TempMon.c", "TempMon_PlausChk"): ["temp"],
    }
    return {"old": old, "new": new, "testcases": tc_path, "truth": dict(truth), "expected": expected,
            "features": {f["key"]: f for f in _DEMO_FEATURES}}


def demo_truth_for(change: Change, demo: Dict[str, Any]) -> Optional[Set[str]]:
    """Ground truth (set of test-case IDs) for a demo change, None when not defined."""
    keys: List[str] = []
    for (file, func), feats in demo["expected"].items():
        if change.file == file and (not func or func in change.functions):
            keys += feats
    if not keys:
        return None
    out: Set[str] = set()
    for k in keys:
        out.update(demo["truth"][k])
    return out


def run_benchmark(target: Optional[str] = None, rounds: int = 3, verbose: bool = True) -> Dict[str, Any]:
    """Simulated trainer on the demo data: shows how the answers improve with training.
    Per change the 'trainer' rates only 24 listed test cases (strongest, weakest and a few
    in between) and names 3 missed ones - like a human with limited time would."""
    tmp = target or tempfile.mkdtemp(prefix="stcm_bench_")
    demo = make_demo(tmp)
    model = Model(Path(tmp) / "model")
    pats, excl = split_patterns(DEFAULT_USER_PATTERNS), split_patterns(DEFAULT_EXCLUDE_DIRS)
    sbx = SandboxIndex.build(demo["new"], pats, excl, model.cache_dir)
    cs = compare_sandboxes(demo["old"], demo["new"], pats, excl, True, new_table=sbx.table)
    store = TestCaseStore.load(demo["testcases"])
    eng = Engine(model, store, sandbox=sbx)
    id2key = {tc.tc_id: tc.key for tc in store.cases}
    report: Dict[str, Any] = {"rounds": []}

    def measure(rd: int) -> None:
        rows = []
        acc = {"recall": [], "precision": [], "recall_hm": [], "precision_hm": []}  # type: Dict[str, List[float]]
        for ch in cs.changes:
            truth = demo_truth_for(ch, demo)
            if truth is None or ch.note.startswith("comment-only"):
                continue
            ms = eng.match(eng.query_for_change(ch), explain=False)
            got = {m.tc.tc_id for m in ms}
            hm = {m.tc.tc_id for m in ms if m.conf >= LEVEL_MED}
            tp, tph = len(got & truth), len(hm & truth)
            acc["recall"].append(tp / len(truth))
            acc["precision"].append(tp / len(got) if got else 1.0)
            acc["recall_hm"].append(tph / len(truth))
            acc["precision_hm"].append(tph / len(hm) if hm else 1.0)
            rows.append((ch.label(), tp, len(got), len(truth), tph, len(hm)))
        entry: Dict[str, Any] = {k: sum(v) / max(1, len(v)) for k, v in acc.items()}
        entry.update({"round": rd, "rows": rows})
        report["rounds"].append(entry)

    t0 = time.time()
    measure(0)
    for rd in range(1, rounds + 1):
        for ch in cs.changes:
            truth = demo_truth_for(ch, demo)
            if truth is None:
                continue
            q = eng.query_for_change(ch)
            shown = eng.match(q)
            if len(shown) > 24:        # 10 strongest, 6 weakest, 8 spread over the middle
                mid = shown[10:-6]
                rated = shown[:10] + shown[-6:] + [mid[int(i * len(mid) / 8)] for i in range(8)]
            else:
                rated = shown
            verdicts = {m.tc.key: ("R" if m.tc.tc_id in truth else "W") for m in rated}
            got = {m.tc.tc_id for m in shown}
            missed = sorted(truth - got)[:3]
            tp = len(got & truth)
            f1 = 2 * tp / (len(got) + len(truth)) if got else 0.0
            eng.feedback(q, shown, verdicts, [id2key[i] for i in missed], min(9, int(round(10 * f1))))
        measure(rd)
    report["seconds"] = time.time() - t0
    report["testcases"] = len(store)
    if verbose:
        print("Benchmark on demo data: %d test cases, %d changes, simulated trainer" % (len(store), len(cs.changes)))
        for rr in report["rounds"]:
            print("  after %d training round(s):  all listed: recall %5.1f %%  precision %5.1f %%   |   "
                  "High+Medium only: recall %5.1f %%  precision %5.1f %%" % (
                      rr["round"], rr["recall"] * 100, rr["precision"] * 100,
                      rr["recall_hm"] * 100, rr["precision_hm"] * 100))
            for label, tp, got, tot, tph, nh in rr["rows"]:
                print("      %-66s found %3d of %3d (listed %3d)   High+Medium: %3d right of %3d" % (
                    label[:66], tp, tot, got, tph, nh))
        print("  time: %.1f s" % report["seconds"])
    if target is None:
        shutil.rmtree(tmp, ignore_errors=True)
    return report


