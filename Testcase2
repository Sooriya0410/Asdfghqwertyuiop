    def _build_style(self) -> None:
        st = ttk.Style(self.root)
        try:
            if os.name != "nt" and "clam" in st.theme_names():
                st.theme_use("clam")
        except Exception:
            pass
        import tkinter.font as tkfont
        base = tkfont.nametofont("TkDefaultFont")
        self.f_base = base
        self.f_bold = base.copy()
        self.f_bold.configure(weight="bold")
        self.f_head = base.copy()
        self.f_head.configure(weight="bold", size=base.cget("size") + 1)
        self.f_mono = tkfont.nametofont("TkFixedFont")
        st.configure("Treeview", rowheight=int(base.metrics("linespace") * 1.45))
        st.configure("Treeview.Heading", font=self.f_bold)
        st.configure("Go.TButton", font=self.f_bold)
        st.configure("Head.TLabel", font=self.f_head)
        st.configure("Dim.TLabel", foreground="#666666")
        st.configure("Ok.TLabel", foreground="#1b7a2f", font=self.f_bold)

        def fixed_map(option: str) -> List[Any]:
            # work-around for the Tk 8.6.9 bug that ignores Treeview row colours
            return [e for e in st.map("Treeview", query_opt=option) if e[:2] != ("!disabled", "!selected")]

        st.map("Treeview", foreground=fixed_map("foreground"), background=fixed_map("background"))

    def _tree(self, parent: Any, cols: Sequence[Tuple[Any, ...]], height: int = 8, multi: bool = False,
              stretch: Optional[str] = None) -> Any:
        fr = ttk.Frame(parent)
        stretch = stretch or cols[-1][0]
        tree = ttk.Treeview(fr, columns=[c[0] for c in cols], show="headings", height=height,
                            selectmode="extended" if multi else "browse")
        for c in cols:
            cid, head, width = c[0], c[1], c[2]
            anchor = c[3] if len(c) > 3 else "w"
            tree.heading(cid, text=head, command=lambda t=tree, k=cid: self._sort_tree(t, k))
            tree.column(cid, width=width, minwidth=30, anchor=anchor, stretch=(cid == stretch))
        vs = ttk.Scrollbar(fr, orient="vertical", command=tree.yview)
        hs = ttk.Scrollbar(fr, orient="horizontal", command=tree.xview)
        tree.configure(yscrollcommand=vs.set, xscrollcommand=hs.set)
        tree.grid(row=0, column=0, sticky="nsew")
        vs.grid(row=0, column=1, sticky="ns")
        hs.grid(row=1, column=0, sticky="ew")
        fr.rowconfigure(0, weight=1)
        fr.columnconfigure(0, weight=1)
        for lv, col in COL_LEVEL.items():
            tree.tag_configure(lv, background=col)
        tree.tag_configure("R", background=COL_RIGHT)
        tree.tag_configure("W", background=COL_WRONG)
        tree.tag_configure("all", font=self.f_bold)
        tree.tag_configure("done", foreground="#1b7a2f")
        tree.frame = fr                                    # type: ignore[attr-defined]
        tree._sort_state = {}                              # type: ignore[attr-defined]
        return tree

    def _sort_tree(self, tree: Any, col: str) -> None:
        rev = not tree._sort_state.get(col, True)
        tree._sort_state[col] = rev

        def keyf(iid: str) -> Tuple[int, Any]:
            v = tree.set(iid, col)
            try:
                return (0, float(str(v).replace("%", "")))
            except ValueError:
                return (1, str(v).lower())

        fixed = [i for i in tree.get_children("") if i == "ALL"]
        rest = sorted((i for i in tree.get_children("") if i != "ALL"), key=keyf, reverse=rev)
        for n, iid in enumerate(fixed + rest):
            tree.move(iid, "", n)

    def _text(self, parent: Any, mono: bool = False, height: int = 8, width: int = 40) -> Any:
        fr = ttk.Frame(parent)
        txt = tk.Text(fr, wrap="word" if not mono else "none", height=height, width=width, relief="flat", borderwidth=0,
                      font=self.f_mono if mono else self.f_base, padx=8, pady=6, background="#ffffff")
        vs = ttk.Scrollbar(fr, orient="vertical", command=txt.yview)
        txt.configure(yscrollcommand=vs.set)
        txt.grid(row=0, column=0, sticky="nsew")
        vs.grid(row=0, column=1, sticky="ns")
        if mono:
            hs = ttk.Scrollbar(fr, orient="horizontal", command=txt.xview)
            txt.configure(xscrollcommand=hs.set)
            hs.grid(row=1, column=0, sticky="ew")
        fr.rowconfigure(0, weight=1)
        fr.columnconfigure(0, weight=1)
        txt.tag_configure("h", font=self.f_head, spacing1=6, spacing3=3)
        txt.tag_configure("b", font=self.f_bold)
        txt.tag_configure("dim", foreground="#666666")
        txt.tag_configure("code", font=self.f_mono)
        txt.tag_configure("add", font=self.f_mono, background="#e3f6e5")
        txt.tag_configure("del", font=self.f_mono, background="#fbe3e3")
        txt.tag_configure("trained", foreground="#1b5e9a", font=self.f_bold)
        txt.configure(state="disabled")
        txt.frame = fr                                     # type: ignore[attr-defined]
        return txt

    @staticmethod
    def _fill(txt: Any, segments: Sequence[Tuple[str, str]]) -> None:
        txt.configure(state="normal")
        txt.delete("1.0", "end")
        for text, tag in segments:
            if tag:
                txt.insert("end", text, tag)
            else:
                txt.insert("end", text)
        txt.configure(state="disabled")
        txt.yview_moveto(0.0)

