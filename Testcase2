        self.assertGreater(after[shown[0].tc.key].conf, shown[0].conf)
        self.assertNotIn(wrong.key, after)                                   # rejected for this function
        # a different line of the same function keeps what was learned
        other = Change(file=ch.file, kind="C", functions=list(ch.functions), new_start=ch.new_start + 2,
                       new_end=ch.new_start + 2, new_code="        PwrMgr_State = PWR_STATE_UV;")
