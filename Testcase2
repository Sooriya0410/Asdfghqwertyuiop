        probe = "if (CanRx_VehSpd_Qual == VEHSPD_QUAL_INVALID) { CanRx_VehSpd_Dbnc++; }"     # not in the sandbox
        before = eng.match(eng.query_for_text(probe), threshold=0.0, limit=None)
        b_conf = {m.tc.tc_id: m.conf for m in before}
        q = eng.query_for_change(_change("CanRx_VehSpd_TimeoutChk"))
        shown = eng.match(q)
        verdicts = {m.tc.key: ("R" if m.tc.tc_id in truth else "W") for m in shown[:25]}
