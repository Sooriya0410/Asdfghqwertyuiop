    def act_template(self) -> None:
        f = filedialog.asksaveasfilename(defaultextension=".xlsx", initialfile="files_changed_template.xlsx",
                                         filetypes=[("Excel", "*.xlsx")], title="Save template")
        if not f:
            return
        try:
            write_changes_excel(f, None)
            self.set_status("Template written: %s" % f)
            messagebox.showinfo(APP_NAME, "Template written:\n%s\n\nFill the sheet 'Changes' "
                                          "(only the column 'File' is mandatory) and load it here." % f)
        except Exception as exc:                           # noqa: BLE001
            self._show_error("Template", exc, traceback.format_exc())

    def act_compare(self) -> None:
        inp = self.inputs()
        if not inp["old"] or not inp["new"]:
            messagebox.showinfo(APP_NAME, "Select both sandboxes first:\n'Old sandbox (baseline)' and 'New sandbox'.")
            return
        for k in ("old", "new"):
            if not os.path.isdir(inp[k]):
                messagebox.showerror(APP_NAME, "Folder not found:\n%s" % inp[k])
                return

        def job(progress: ProgressFn) -> ChangeSet:
            self._prepare(inp, progress, need_tc=False, need_sbx=True, force_sbx=True)
            assert self.sbx is not None
            return compare_sandboxes(inp["old"], inp["new"], inp["patterns"], inp["exclude"], inp["ignore_ws"],
                                     progress, new_table=self.sbx.table)

        self.run_bg("Comparing sandboxes", job, self._changes_ready)

    def act_load_changes(self) -> None:
        inp = self.inputs()
        if not inp["changes"]:
            self._browse_file(self.v_changes, [("Excel", "*.xlsx *.xlsm"), ("All files", "*.*")])
            inp = self.inputs()
            if not inp["changes"]:
                return
        if not os.path.isfile(inp["changes"]):
            messagebox.showerror(APP_NAME, "File not found:\n%s" % inp["changes"])
            return

        def job(progress: ProgressFn) -> ChangeSet:
            self._prepare(inp, progress, need_tc=False, need_sbx=True, force_sbx=True)
            _progress(progress, "Reading files-changed Excel ...")
            return read_changes_excel(inp["changes"], self.sbx, inp["patterns"])

        self.run_bg("Loading files-changed Excel", job, self._changes_ready)

    def _changes_ready(self, cs: ChangeSet) -> None:
        self.cs = cs
        self.results, self.res_by_cid, self.summary = [], {}, []
        self.t_done.clear()
        self._fill_change_tree()
        s = cs.stats
        self.lbl_changes.configure(text="Changes: %d files, %d changed blocks" % (len(cs.files), len(cs.changes)))
        extra = ""
        if "identical" in s:
            extra = "   |   %d identical, %d white-space only   |   %.1f s" % (
                s.get("identical", 0), s.get("whitespace_only", 0), s.get("seconds", 0.0))
        self.lbl_changes2.configure(text="C files: %d   H files: %d   user files: %d%s" % (
            s.get("c_files", 0), s.get("h_files", 0), s.get("user_files", 0), extra))
        note = ""
        if self.sbx is not None:
            note = "  Sandbox analysed: %d functions in %d files." % (self.sbx.n_funcs, len(self.sbx.funcs_by_file))
        self.set_status("Changes loaded.%s  Step 2: press 'Find test cases'." % note)
        self._fill_train_changes()
        if not cs.changes:
            messagebox.showinfo(APP_NAME, "No differences were found.")

    def _fill_change_tree(self) -> None:
        t = self.tree_ch
        t.delete(*t.get_children(""))
        if not self.cs:
            return
        t.insert("", "end", iid="ALL", values=("ALL", len(self.summary) if self.results else "",
                                               "ALL CHANGES - every test case to run", "", "", "", ""), tags=("all",))
        for ch in self.cs.changes:
            res = self.res_by_cid.get(ch.cid)
            t.insert("", "end", iid=ch.cid, values=(
                ch.cid, len(res.matches) if res else "", ch.file, ", ".join(ch.functions) or "-",
                ch.new_lines or ("old " + ch.old_lines if ch.old_lines else ""), ch.kind, ch.status))
        if self.results:
            t.selection_set("ALL")
            t.focus("ALL")

    def act_find(self) -> None:
        inp = self.inputs()
        if not inp["tc"]:
            messagebox.showinfo(APP_NAME, "Select the test-case Excel first.")
            return
        have_cs = self.cs is not None
        if not have_cs and not ((inp["old"] and inp["new"]) or inp["changes"]):
            messagebox.showinfo(APP_NAME, "Step 1 is missing: compare two sandboxes or load a files-changed Excel.")
            return
        cs_holder: Dict[str, Any] = {"cs": self.cs}

        def job(progress: ProgressFn) -> Tuple[ChangeSet, List[ChangeResult]]:
            self._prepare(inp, progress, need_tc=True, need_sbx=True, force_sbx=not have_cs)
            cs = cs_holder["cs"]
            if cs is None:
                if inp["changes"] and os.path.isfile(inp["changes"]):
                    cs = read_changes_excel(inp["changes"], self.sbx, inp["patterns"])
                else:
                    cs = compare_sandboxes(inp["old"], inp["new"], inp["patterns"], inp["exclude"],
                                           inp["ignore_ws"], progress,
                                           new_table=self.sbx.table if self.sbx else None)
            assert self.engine is not None
            return cs, analyze_changes(self.engine, cs.changes, inp["thr"], progress, inp["ignore_cmt"])

        def done(res: Tuple[ChangeSet, List[ChangeResult]]) -> None:
            cs, results = res
            if cs is not self.cs:
                self._changes_ready(cs)
            self.results = results
            self.res_by_cid = {r.change.cid: r for r in results}
            self.summary = summarize_results(results)
            self._fill_change_tree()
            self._fill_train_changes()
            n_hi = sum(1 for a in self.summary if a["conf"] >= LEVEL_HIGH)
            n_md = sum(1 for a in self.summary if LEVEL_MED <= a["conf"] < LEVEL_HIGH)
            warn = ""
            if self.store and self.store.warnings:
                warn = "   Note: " + " ".join(self.store.warnings)
            self.set_status("Done: %d test cases to run for %d changes  (%d high, %d medium, %d possible) "
                            "out of %d test cases.%s" % (len(self.summary), len(results), n_hi, n_md,
                                                         len(self.summary) - n_hi - n_md,
                                                         len(self.store) if self.store else 0, warn))

        self.run_bg("Finding test cases", job, done)

    def _selected_change(self) -> Optional[Change]:
        sel = self.tree_ch.selection()
        if not sel or sel[0] == "ALL" or not self.cs:
            return None
        for ch in self.cs.changes:
            if ch.cid == sel[0]:
                return ch
        return None

    def _on_change_select(self, _evt: Any = None) -> None:
        sel = self.tree_ch.selection()
        t = self.tree_tc
        t.delete(*t.get_children(""))
        self._fill(self.txt_why, [])
        if not sel:
            return
        if sel[0] == "ALL":
            self.lbl_tcs.configure(text="All test cases to run: %d" % len(self.summary))
            for a in self.summary:
                tc = a["tc"]
                lv = level_of(a["conf"])
                t.insert("", "end", iid=str(tc.idx), tags=(lv,), values=(
                    tc.tc_id, "%d%%" % round(a["conf"] * 100), lv, len(a["changes"]), tc.headline()))
            seg = [("All changes\n", "h")]
            if self.cs:
                for f in self.cs.files:
                    seg.append(("%-8s %-5s %s   (+%d / -%d lines, %d blocks)\n" % (
                        f.status, f.kind, f.file, f.added, f.removed, f.hunks), "code"))
            self._fill(self.txt_code, seg)
        else:
            ch = self._selected_change()
            if ch is None:
                return
            res = self.res_by_cid.get(ch.cid)
            n = len(res.matches) if res else 0
            self.lbl_tcs.configure(text="Test cases for %s: %d%s" % (
                ch.cid, n, "" if res else "   (press 'Find test cases')"))
            if res:
                for m in res.matches:
                    t.insert("", "end", iid=str(m.tc.idx), tags=(m.level,), values=(
                        m.tc.tc_id, "%d%%" % round(m.conf * 100), m.level, "", m.tc.headline()))
            self._fill(self.txt_code, self._change_segments(ch, res.query if res else None))
        kids = t.get_children("")
        if kids:
            t.selection_set(kids[0])

    def _change_segments(self, ch: Change, q: Optional[Query]) -> List[Tuple[str, str]]:
        seg: List[Tuple[str, str]] = [("%s   %s\n" % (ch.cid, ch.file), "h")]
        seg.append(("Type %s   Status %s   Function: %s\n" % (
            ch.kind, ch.status, ", ".join(ch.functions) or "(file scope)"), ""))
        seg.append(("New lines: %s    Old lines: %s%s\n" % (
            ch.new_lines or "-", ch.old_lines or "-", ("    Note: " + ch.note) if ch.note else ""), ""))
        if q and q.context:
            seg.append(("\nSandbox analysis\n", "h"))
            for line in q.context:
                seg.append(("  " + line + "\n", ""))
        if ch.old_code:
            seg.append(("\nOld code (lines %s)\n" % (ch.old_lines or "-"), "h"))
            seg += [("- " + ln + "\n", "del") for ln in ch.old_code.split("\n")]
        if ch.new_code:
            seg.append(("\nNew code (lines %s)\n" % (ch.new_lines or "-"), "h"))
            seg += [("+ " + ln + "\n", "add") for ln in ch.new_code.split("\n")]
        return seg

    def _tc_segments(self, tc: TestCase, m: Optional[Match], extra: Sequence[Tuple[str, str]] = ()) -> List[Tuple[str, str]]:
        seg: List[Tuple[str, str]] = []
        if m is not None:
            seg.append(("%s    confidence %d %%  (%s)\n" % (tc.tc_id, round(m.conf * 100), m.level), "h"))
        else:
            seg.append(("%s\n" % tc.tc_id, "h"))
        seg += list(extra)
        if m is not None:
            seg.append(("Why this test case\n", "b"))
            if not m.reasons:
                seg.append(("  (weak overall similarity)\n", "dim"))
            for r in (m.reasons or []):
                seg.append(("  - " + r + "\n", "trained" if r.startswith(("TRAINED", "Learned", "Counter")) else ""))
            ev = "   ".join("%s %.2f" % (lab, m.feats.get(k, 0.0)) for k, lab in FEAT_LABEL if m.feats.get(k, 0.0) >= 0.005)
            seg.append(("  Evidence (0..1):  %s\n" % (ev or "-"), "dim"))
        seg.append(("\nTest case  (Excel row %d)\n" % tc.row, "b"))
        if tc.pre or tc.exp or tc.title:
            if tc.title:
                seg.append((tc.title + "\n", ""))
            for name, body in (("Precondition", tc.pre), ("Test procedure", tc.proc), ("Expected result", tc.exp)):
                if body:
                    seg.append((name + "\n", "b"))
                    seg.append((body + "\n", ""))
        else:
            seg.append((tc.text + "\n", ""))
        if tc.meta:
            seg.append(("\n" + "   |   ".join("%s: %s" % kv for kv in tc.meta.items()) + "\n", "dim"))
        return seg

    def _on_tc_select(self, _evt: Any = None) -> None:
        sel = self.tree_tc.selection()
        if not sel or self.store is None:
            return
        idx = int(sel[0])
        tc = self.store.cases[idx]
        csel = self.tree_ch.selection()
        if csel and csel[0] == "ALL":
            a = next((x for x in self.summary if x["tc"].idx == idx), None)
            if a is None:
                return
            chs = sorted(a["changes"], key=lambda x: -x[1])
            extra: List[Tuple[str, str]] = [("Hit by %d change(s)\n" % len(chs), "b")]
            for c, cf in chs[:25]:
                extra.append(("  %s  %s   (%d %%)\n" % (c.cid, c.label(), round(cf * 100)), ""))
            if len(chs) > 25:
                extra.append(("  ... +%d more\n" % (len(chs) - 25), "dim"))
            extra.append(("Reasons below are for the strongest change (%s).\n" % a["best_change"].cid, "dim"))
            best_res = self.res_by_cid.get(a["best_change"].cid)
            if best_res and self.engine:
                self.engine.explain_matches(best_res.query, [a["best"]])
            self._fill(self.txt_why, self._tc_segments(tc, a["best"], extra))
        else:
            res = self.res_by_cid.get(csel[0]) if csel else None
            m = next((x for x in res.matches if x.tc.idx == idx), None) if res else None
            if m is not None and res and self.engine:
                self.engine.explain_matches(res.query, [m])
            self._fill(self.txt_why, self._tc_segments(tc, m))

