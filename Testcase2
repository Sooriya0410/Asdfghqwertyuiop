        after = eng.match(eng.query_for_text(probe), threshold=0.0, limit=None)
        a_conf = {m.tc.tc_id: m.conf for m in after}
        unseen = [i for i in truth if ("id:" + i) not in verdicts]
        self.assertGreater(len(unseen), 20)
        gain = sum(a_conf.get(i, 0.0) - b_conf.get(i, 0.0) for i in unseen) / len(unseen)
        self.assertGreater(gain, 0.10)                                       # never-rated test cases rise too
        self.assertTrue(any(m.feats["assoc"] > 0.2 for m in after if m.tc.tc_id in unseen))
        top = [m.tc.tc_id for m in after[:15]]
        self.assertGreaterEqual(sum(1 for i in top if i in truth), 14)

