def resolve_model_dir(cli_value: Optional[str] = None) -> Tuple[Path, str]:
    """Return (model_dir, note).  Order: --model-dir, pointer file, D:\\model\\data,
    then <script folder>/model/data when the D: drive does not exist."""
    note = ""
    script_dir = Path(os.path.abspath(sys.argv[0] or ".")).parent
    pointer = Path.home() / ".sandbox_tc_mapper.json"
    candidates: List[str] = []
    if cli_value:
        candidates.append(cli_value)
    try:
        if pointer.is_file():
            saved = json.loads(pointer.read_text(encoding="utf-8")).get("model_dir")
            if saved:
                candidates.append(saved)
    except Exception:
        pass
    candidates.append(DEFAULT_MODEL_DIR)
    for cand in candidates:
        if os.name != "nt" and re.match(r"^[A-Za-z]:[\\/]", cand):
            continue                              # Windows path on a non-Windows PC
        try:
            p = Path(cand)
            p.mkdir(parents=True, exist_ok=True)
            probe = p / ".write_test"
            probe.write_text("ok", encoding="utf-8")
            probe.unlink()
            return p, note
        except Exception:
            note = "Could not use '%s' - " % cand
    fallback = script_dir / "model" / "data"
    fallback.mkdir(parents=True, exist_ok=True)
    return fallback, (note + "using '%s' instead." % fallback) if note or os.name == "nt" else ""


def remember_model_dir(path: Path) -> None:
    try:
        atomic_write_text(Path.home() / ".sandbox_tc_mapper.json",
                          json.dumps({"model_dir": str(path)}, indent=1))
    except Exception:
        pass


