        if not self.cs:
            messagebox.showinfo(APP_NAME, "Nothing to save yet - compare the sandboxes first.")
            return
        f = filedialog.asksaveasfilename(defaultextension=".xlsx", filetypes=[("Excel", "*.xlsx")],
                                         initialfile="files_changed_%s.xlsx" % _dt.date.today().isoformat())
        if not f:
            return
        cs = self.cs
        self.run_bg("Saving changes Excel", lambda p: (write_changes_excel(f, cs), f)[1],
                    lambda path: self.set_status("Saved: %s" % path))

