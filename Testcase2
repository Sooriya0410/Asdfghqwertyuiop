        wrong = shown[3].tc
        s = eng.feedback(q, shown, {shown[0].tc.key: "R", wrong.key: "W"}, [missed.key], 4, "unit test")
        self.assertEqual((s["right"], s["wrong"], s["missing"]), (1, 1, 1))
        after = {m.tc.key: m for m in eng.match(eng.query_for_change(ch))}
