ProgressFn = Optional[Callable[[str, float], None]]      # (message, fraction 0..1 or -1)


def _progress(cb: ProgressFn, msg: str, frac: float = -1.0) -> None:
    if cb:
        try:
            cb(msg, frac)
        except Exception:
            pass


def file_kind(name: str, user_patterns: Sequence[str]) -> Optional[str]:
    """'C' for *.c, 'H' for *.h, 'USER' for a user pattern, None = not tracked."""
    low = name.lower()
    ext = os.path.splitext(low)[1]
    if ext == ".c":
        return "C"
    if ext == ".h":
        return "H"
    for pat in user_patterns:
        if fnmatch.fnmatchcase(low, pat.lower()):
            return "USER"
    return None


def scan_tree(root: str, user_patterns: Sequence[str], exclude_dirs: Sequence[str]) -> Dict[str, Tuple[str, str, str]]:
    """Walk a sandbox.  Returns {relative path lower-case: (relative path, absolute path, kind)}."""
    out: Dict[str, Tuple[str, str, str]] = {}
    root = os.path.abspath(root)
    ex = [e.lower() for e in exclude_dirs]
    for dp, dns, fns in os.walk(root):
        dns[:] = [d for d in dns if not any(fnmatch.fnmatchcase(d.lower(), e) for e in ex)]
        for fn in fns:
            kind = file_kind(fn, user_patterns)
            if kind:
                ab = os.path.join(dp, fn)
                rel = os.path.relpath(ab, root).replace("\\", "/")
                out[rel.lower()] = (rel, ab, kind)
    return out


def decode_bytes(data: bytes) -> Optional[str]:
    """Bytes -> text with normalised line ends.  None for binary content."""
    if data[:2] in (b"\xff\xfe", b"\xfe\xff"):
        try:
            text = data.decode("utf-16")
        except UnicodeDecodeError:
            return None
    elif b"\x00" in data[:8192]:
        return None
    else:
        try:
            text = data.decode("utf-8-sig")
        except UnicodeDecodeError:
            text = data.decode("cp1252", "replace")
    if "\r" in text:
        text = text.replace("\r\n", "\n").replace("\r", "\n")
    return text


def read_text_file(path: str) -> Optional[str]:
    try:
        with open(path, "rb") as fh:
            return decode_bytes(fh.read())
    except OSError:
        return None


def split_lines(text: str) -> List[str]:
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return lines


# ---- C parsing ---------------------------------------------------------------
_RE_CS = re.compile(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'', re.S)
_RE_NONNL = re.compile(r"[^\n]")
_RE_NL = re.compile(r"\n")
_RE_PP = re.compile(r"^[ \t]*#[^\n]*(?:\\\n[^\n]*)*", re.M)
_RE_PP_KIND = re.compile(r"[ \t]*#[ \t]*([A-Za-z]+)")
_RE_PP_DEFINE = re.compile(r"[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)")
_RE_INCLUDE = re.compile(r'^[ \t]*#[ \t]*include[ \t]*[<"]([^>"\n]+)[>"]', re.M)
_RE_BRACE = re.compile(r"[{};]")
_RE_IDENT = re.compile(r"(?<![0-9A-Za-z_])[A-Za-z_]\w*")
_RE_CALL = re.compile(r"(?<![0-9A-Za-z_])([A-Za-z_]\w*)\s*\(")
_RE_TRANSPARENT = re.compile(r'(?:\bextern\s*"?\s*"?\s*$)|(?:\bnamespace\b[^;{}()]*$)')
_RE_CMT_DECOR = re.compile(r"/\*+!?<?|\*+/|//+[/!<]*|^[ \t]*\*+", re.M)
_RE_CMT_TAGS = re.compile(r"[@\\](?:brief|param(?:\[[a-z,]*\])?|return|returns|retval|note|details|file|author|date|version|fn|pre|post|see|ingroup)\b")
_RE_CMT_RULE = re.compile(r"[=\-#*_~+]{3,}")
_ATTR_WORDS = {"__attribute__", "__declspec", "__asm__", "asm", "__attribute", "noexcept", "throw"}
_TASK_MACROS = {"ISR", "TASK", "ALARMCALLBACK", "INTERRUPT", "CAT1_ISR", "CAT2_ISR"}
_FUNC_BLOCK_WORDS = C_KEYWORDS | {"__except", "__finally"}


def strip_c(text: str) -> Tuple[str, List[Tuple[int, str]]]:
    """Blank out comments and string contents (same length, same line breaks).
    Returns (code, [(offset, comment text), ...])."""
    comments: List[Tuple[int, str]] = []

    def rep(m: "re.Match[str]") -> str:
        s = m.group(0)
        c0 = s[0]
        if c0 == "/":
            comments.append((m.start(), s))
            return _RE_NONNL.sub(" ", s) if "\n" in s else " " * len(s)
        return c0 + " " * (len(s) - 2) + c0

    return _RE_CS.sub(rep, text), comments


def clean_comment(s: str) -> str:
    s = _RE_CMT_DECOR.sub(" ", s)
    s = _RE_CMT_TAGS.sub(" ", s)
    s = _RE_CMT_RULE.sub(" ", s)
    return " ".join(s.split())


def _blank_pp(code: str, skip_else: bool) -> Tuple[str, List[Tuple[str, int]]]:
    """Blank preprocessor lines (so macro bodies never disturb brace matching).
    With skip_else=True the #else/#elif branches are blanked too, which keeps
    braces balanced in files like   #if A  void f(int a) {  #else  void f(void) {  #endif."""
    pieces: List[str] = []
    defines: List[Tuple[str, int]] = []
    pos = 0
    stack: List[bool] = []          # True = this #if level started a skipped region
    skip_from = -1
    for m in _RE_PP.finditer(code):
        d = m.group(0)
        km = _RE_PP_KIND.match(d)
        kind = km.group(1) if km else ""
        start, end = m.start(), m.end()
        if skip_from < 0:
            pieces.append(code[pos:start])
        if kind == "define":
            dm = _RE_PP_DEFINE.match(d)
            if dm:
                defines.append((dm.group(1), start))
        if skip_else:
            if kind in ("if", "ifdef", "ifndef"):
                stack.append(False)
            elif kind in ("else", "elif"):
                if stack and skip_from < 0:
                    stack[-1] = True
                    skip_from = start
            elif kind == "endif":
                if stack:
                    owner = stack.pop()
                    if owner and skip_from >= 0:
                        pieces.append(_RE_NONNL.sub(" ", code[skip_from:start]))
                        skip_from = -1
        if skip_from < 0:
            pieces.append(_RE_NONNL.sub(" ", d))
            pos = end
    if skip_from >= 0:
        pieces.append(_RE_NONNL.sub(" ", code[skip_from:]))
    else:
        pieces.append(code[pos:])
    return "".join(pieces), defines


def _func_from_header(header: str) -> Tuple[Optional[str], int]:
    """'static FUNC(void, CODE) Foo_Init(void)' -> ('Foo_Init', offset of first char)."""
    h = header.rstrip()
    name: Optional[str] = None
    for _ in range(4):
        if not h.endswith(")"):
            return None, 0
        depth = 0
        i = len(h) - 1
        while i >= 0:
            c = h[i]
            if c == ")":
                depth += 1
            elif c == "(":
                depth -= 1
                if depth == 0:
                    break
            i -= 1
        if i < 0:
            return None, 0
        j = i - 1
        while j >= 0 and h[j] in " \t\n":
            j -= 1
        k = j
        while k >= 0 and (h[k].isalnum() or h[k] == "_"):
            k -= 1
        cand = h[k + 1: j + 1]
        if not cand or cand[0].isdigit():
            return None, 0
        if cand in _ATTR_WORDS:
            h = h[: k + 1].rstrip()
            continue
        if cand in _FUNC_BLOCK_WORDS:
            return None, 0
        if cand in _TASK_MACROS:
            arg = h[i + 1: len(h) - 1].strip()
            if re.fullmatch(r"[A-Za-z_]\w*", arg):
                cand = arg
        name = cand
        break
    if not name:
        return None, 0
    return name, len(header) - len(header.lstrip())


def _scan_functions(st: str) -> Tuple[List[Tuple[str, int, int, int, int]], bool]:
    """Find function bodies by brace matching at file scope.
    Returns ([(name, lead offset, header offset, body offset, end offset)], balanced)."""
    funcs: List[Tuple[str, int, int, int, int]] = []
    depth = 0
    tdepth = 0
    seg = 0
    cur: Optional[Tuple[str, int, int, int]] = None
    balanced = True
    for m in _RE_BRACE.finditer(st):
        pos = m.start()
        ch = st[pos]
        if ch == ";":
            if depth == 0:
                seg = pos + 1
        elif ch == "{":
            if depth == 0:
                header = st[seg:pos]
                name, hstart = _func_from_header(header)
                if name:
                    cur = (name, seg, seg + hstart, pos)
                    depth = 1
                elif _RE_TRANSPARENT.search(header):
                    tdepth += 1
                    seg = pos + 1
                else:
                    cur = None
                    depth = 1
            else:
                depth += 1
        else:
            if depth == 0:
                if tdepth:
                    tdepth -= 1
                else:
                    balanced = False
                seg = pos + 1
            else:
                depth -= 1
                if depth == 0:
                    if cur:
                        funcs.append((cur[0], cur[1], cur[2], cur[3], pos))
                    cur = None
                    seg = pos + 1
    if depth != 0:
        balanced = False
    return funcs, balanced


def parse_c(text: str, keep_code: bool = False) -> Dict[str, Any]:
    """Parse one C-like file.  Returns a JSON-friendly dict:
       f: [[name, lead line, start line, end line, [calls], [identifiers], doc, comments], ...]
       i: [included files]   d: [[macro name, line], ...]   n: line count"""
    code, comments = strip_c(text)
    line_starts = [0] + [m.end() for m in _RE_NL.finditer(text)]

    def line_of(off: int) -> int:
        return bisect.bisect_right(line_starts, off)

    st, defines = _blank_pp(code, False)
    spans, ok = _scan_functions(st)
    if not ok:
        st2, _ = _blank_pp(code, True)
        spans2, ok2 = _scan_functions(st2)
        if ok2 or len(spans2) > len(spans):
            spans = spans2

    c_offs = [c[0] for c in comments]
    funcs: List[List[Any]] = []
    for name, lead, hdr, body, end in spans:
        a = bisect.bisect_left(c_offs, lead)
        b = bisect.bisect_left(c_offs, hdr)
        c = bisect.bisect_right(c_offs, end)
        # doc comment = up to 3 comments directly above the header (nothing but
        # white space in between, at most one blank line)
        doc_idx: List[int] = []
        nxt = hdr
        i = b - 1
        while i >= a and len(doc_idx) < 3:
            off, txt = comments[i]
            gap = code[off + len(txt):nxt]
            if gap.strip() or gap.count("\n") > 2:
                break
            doc_idx.append(i)
            nxt = off
            i -= 1
        doc_idx.reverse()
        doc = " ".join(p for p in (clean_comment(comments[x][1]) for x in doc_idx) if p)[-500:]
        lead_line = line_of(comments[doc_idx[0]][0]) if doc_idx else line_of(hdr)
        body_cmt = " ".join(clean_comment(x[1]) for x in comments[b:c])[:700]
        body_code = code[body:end + 1]
        idents = set(_RE_IDENT.findall(body_code)) - C_KEYWORDS
        calls = set(_RE_CALL.findall(body_code)) - C_KEYWORDS
        calls.discard(name)
        if len(idents) > 1500:
            idents = set(sorted(idents)[:1500])
        funcs.append([name, min(lead_line, line_of(hdr)), line_of(hdr), line_of(end),
                      sorted(calls), sorted(idents), doc, body_cmt])
    out: Dict[str, Any] = {
        "f": funcs,
        "i": _RE_INCLUDE.findall(text),
        "d": [[n, line_of(off)] for n, off in defines],
        "n": len(line_starts),
    }
    if keep_code:
        out["code"] = code
    return out


class FuncInfo:
    """One C function found in the sandbox."""
    __slots__ = ("name", "file", "lead", "start", "end", "calls", "idents", "doc", "comments")

    def __init__(self, file: str, rec: Sequence[Any]):
        self.file = file
        self.name = rec[0]
        self.lead = int(rec[1])
        self.start = int(rec[2])
        self.end = int(rec[3])
        self.calls = frozenset(map(sys.intern, rec[4]))        # interned: every name is stored once
        self.idents = frozenset(map(sys.intern, rec[5]))
        self.doc = rec[6]
        self.comments = rec[7]

    def __repr__(self) -> str:
        return "FuncInfo(%s @ %s:%d-%d)" % (self.name, self.file, self.start, self.end)


def _ident_stems(ident: str) -> Set[str]:
    """Word stems of one identifier (fast path of iter_tokens for a single name)."""
    words, comps = split_identifier(ident)
    return {stem(p) for p in words + comps
            if len(p) >= 2 and not p.isdigit() and p not in STOPWORDS and not p.startswith("0x")}


class SandboxIndex:
    """Whole-sandbox knowledge: every function, who calls whom, who includes what,
    and how common every identifier is (rare identifiers are stronger evidence)."""
    CACHE_VERSION = 5

    def __init__(self, root: str):
        self.root = os.path.abspath(root)
        self.table: Dict[str, Tuple[str, str, str]] = {}
        self.funcs_by_file: Dict[str, List[FuncInfo]] = {}
        self._leads: Dict[str, List[int]] = {}
        self.defines: Dict[str, List[Tuple[str, int]]] = {}
        self.func_by_name: Dict[str, List[FuncInfo]] = defaultdict(list)
        self.all_funcs: List[FuncInfo] = []
        self.callers: Dict[str, List[FuncInfo]] = defaultdict(list)
        self.includers: Dict[str, List[str]] = defaultdict(list)
        self.ident_df: Counter = Counter()
        self.tok_df: Counter = Counter()
        self.n_funcs = 0
        self._by_base: Dict[str, List[str]] = defaultdict(list)
        self._lines_cache: Dict[str, List[str]] = {}
        self.parse_seconds = 0.0
        self.cache_hits = 0

    # ---- construction --------------------------------------------------------
    @classmethod
    def build(cls, root: str, user_patterns: Sequence[str], exclude_dirs: Sequence[str],
              cache_dir: Optional[Path] = None, progress: ProgressFn = None,
              table: Optional[Dict[str, Tuple[str, str, str]]] = None) -> "SandboxIndex":
        t0 = time.time()
        self = cls(root)
        _progress(progress, "Scanning sandbox folders ...")
        self.table = table if table is not None else scan_tree(root, user_patterns, exclude_dirs)
        # analysis cache: one text line per file (path, size, time stamp, parsed result).
        # Unchanged files are not parsed again; lines are streamed, so memory stays small.
        cache_path: Optional[Path] = None
        old_lines: Dict[str, Tuple[str, str, str]] = {}
        header = "STCM-SANDBOX-CACHE %d" % cls.CACHE_VERSION
        out_fh = None
        tmp_path: Optional[Path] = None
        if cache_dir is not None:
            cache_path = Path(cache_dir) / ("sandbox_%s.jsonl" % sha1_short(self.root.lower(), 12))
            try:
                if cache_path.is_file():
                    with open(cache_path, "r", encoding="utf-8") as fh:
                        if fh.readline().rstrip("\n") == header:
                            for line in fh:
                                parts = line.rstrip("\n").split("\t", 3)
                                if len(parts) == 4:
                                    old_lines[parts[0]] = (parts[1], parts[2], parts[3])
                tmp_path = cache_path.with_name(cache_path.name + ".tmp")
                out_fh = open(tmp_path, "w", encoding="utf-8", newline="\n")
                out_fh.write(header + "\n")
            except OSError:
                out_fh = None
        items = [(k, v) for k, v in sorted(self.table.items())
                 if os.path.splitext(k)[1] in C_LIKE_EXT]
        total = max(1, len(items))
        dirty = False
        includes: Dict[str, List[str]] = {}
        for n, (key, (rel, ab, _kind)) in enumerate(items):
            if n % 50 == 0:
                _progress(progress, "Analysing sandbox: %d / %d files" % (n, total), n / total)
            try:
                stt = os.stat(ab)
            except OSError:
                continue
            ent = old_lines.get(key)
            parsed = None
            blob = ""
            if ent and ent[0] == str(stt.st_size) and ent[1] == str(stt.st_mtime_ns):
                try:
                    parsed = json.loads(ent[2])
                    blob = ent[2]
                    self.cache_hits += 1
                except ValueError:
                    parsed = None
            if parsed is None:
                dirty = True
                parsed = {"f": [], "i": [], "d": [], "n": 0}
                if stt.st_size <= MAX_FILE_BYTES:
                    text = read_text_file(ab)
                    if text is not None:
                        try:
                            parsed = parse_c(text)
                        except Exception:
                            parsed = {"f": [], "i": [], "d": [], "n": text.count("\n") + 1}
                blob = json.dumps(parsed, separators=(",", ":"))
            if out_fh is not None and "\t" not in key and "\n" not in key:
                try:
                    out_fh.write("%s\t%d\t%d\t%s\n" % (key, stt.st_size, stt.st_mtime_ns, blob))
                except OSError:
                    out_fh = None
            fl = [FuncInfo(rel, r) for r in parsed["f"]]
            fl.sort(key=lambda f: f.lead)
            self.funcs_by_file[rel] = fl
            self._leads[rel] = [f.lead for f in fl]
            self.defines[rel] = [(d[0], d[1]) for d in parsed["d"]]
            includes[rel] = parsed["i"]
        if tmp_path is not None and cache_path is not None:
            try:
                if out_fh is not None:
                    out_fh.close()
                    if dirty or len(old_lines) != len(items) or not cache_path.is_file():
                        os.replace(tmp_path, cache_path)
                    else:
                        tmp_path.unlink()
                elif tmp_path.is_file():
                    tmp_path.unlink()
            except OSError:
                pass
        old_lines.clear()
        _progress(progress, "Building call graph ...", 1.0)
        for key, (rel, _ab, _k) in self.table.items():
            self._by_base[os.path.basename(key)].append(rel)
        for rel, fl in self.funcs_by_file.items():
            for f in fl:
                self.func_by_name[f.name].append(f)
                self.all_funcs.append(f)
        for f in self.all_funcs:
            for c in f.calls:
                if c in self.func_by_name:
                    self.callers[c].append(f)
            self.ident_df.update(f.idents)
        # how common is every word of the code base: estimated from the identifier counts,
        # on a sample when the sandbox has a huge number of different identifiers
        tok_df = self.tok_df
        step = max(1, len(self.ident_df) // 150000)
        for n, (ident, df) in enumerate(self.ident_df.items()):
            if n % step == 0:
                for st_ in _ident_stems(ident):
                    tok_df[st_] += df * step
        for rel, incs in includes.items():
            for inc in incs:
                self.includers[os.path.basename(inc.replace("\\", "/")).lower()].append(rel)
        self.n_funcs = len(self.all_funcs)
        self.parse_seconds = time.time() - t0
        return self

    # ---- queries -------------------------------------------------------------
    def resolve(self, name: str) -> Optional[str]:
        """Find a file of the sandbox from a full / partial path or just a file name."""
        raw = name.strip().replace("\\", "/").lower()
        root_l = self.root.replace("\\", "/").lower().rstrip("/") + "/"
        if raw.startswith(root_l):
            raw = raw[len(root_l):]
        key = re.sub(r"^(?:\./)+", "", raw).lstrip("/")
        if not key:
            return None
        if key in self.table:
            return self.table[key][0]
        tails = [v[0] for k, v in self.table.items() if k.endswith("/" + key)]
        if len(tails) == 1:
            return tails[0]
        base = self._by_base.get(os.path.basename(key), [])
        if len(base) == 1:
            return base[0]
        if tails:
            return sorted(tails)[0]
        if base:
            return sorted(base)[0]
        return None

    def abs_path(self, rel: str) -> Optional[str]:
        ent = self.table.get(rel.lower())
        return ent[1] if ent else None

    def kind_of(self, rel: str) -> Optional[str]:
        ent = self.table.get(rel.lower())
        return ent[2] if ent else None

    def lines(self, rel: str) -> List[str]:
        if rel in self._lines_cache:
            return self._lines_cache[rel]
        ab = self.abs_path(rel)
        text = read_text_file(ab) if ab else None
        lines = split_lines(text) if text else []
        if len(self._lines_cache) > 64:
            self._lines_cache.clear()
        self._lines_cache[rel] = lines
        return lines

    def enclosing(self, rel: str, line: int) -> Optional[FuncInfo]:
        fl = self.funcs_by_file.get(rel)
        if not fl:
            return None
        i = bisect.bisect_right(self._leads[rel], line) - 1
        if i >= 0 and fl[i].lead <= line <= fl[i].end:
            return fl[i]
        return None

    def funcs_in_range(self, rel: str, a: int, b: int) -> List[FuncInfo]:
        return [f for f in self.funcs_by_file.get(rel, ()) if f.lead <= b and f.end >= a]

    def find_func(self, name: str, prefer_file: Optional[str] = None) -> Optional[FuncInfo]:
        cands = self.func_by_name.get(name)
        if not cands:
            return None
        if prefer_file:
            for f in cands:
                if f.file == prefer_file:
                    return f
        return cands[0]

    def callers_of(self, name: str, depth: int = 2, cap: int = 12) -> List[Tuple[int, FuncInfo]]:
        """Breadth-first walk up the call graph: [(level, caller), ...]."""
        out: List[Tuple[int, FuncInfo]] = []
        seen = {name}
        frontier = [name]
        for level in range(1, depth + 1):
            nxt: List[str] = []
            count = 0
            for nm in frontier:
                for f in self.callers.get(nm, ()):
                    if f.name in seen:
                        continue
                    seen.add(f.name)
                    if count < cap:
                        out.append((level, f))
                        nxt.append(f.name)
                        count += 1
            frontier = nxt
            if not frontier:
                break
        return out

    def users_of(self, idents: Set[str]) -> Dict[str, List[FuncInfo]]:
        """Which functions reference each of the given identifiers (macro, type, variable)."""
        out: Dict[str, List[FuncInfo]] = defaultdict(list)
        if not idents:
            return out
        for f in self.all_funcs:
            hit = f.idents & idents
            for h in hit:
                out[h].append(f)
        return out

    def includers_of(self, rel: str, depth: int = 3) -> List[str]:
        """Files that include the given header, directly or through other headers."""
        seen: Set[str] = set()
        frontier = [rel]
        for _ in range(depth):
            nxt: List[str] = []
            for r in frontier:
                for inc in self.includers.get(os.path.basename(r).lower(), ()):
                    if inc not in seen and inc != rel:
                        seen.add(inc)
                        if inc.lower().endswith((".h", ".hpp", ".hh", ".hxx")):
                            nxt.append(inc)
            frontier = nxt
            if not frontier:
                break
        return sorted(seen)

    def tok_factor(self, stem_: str) -> float:
        """1.0 for a word that is rare in the code base, down to 0.35 for words used everywhere."""
        if self.n_funcs < 20:
            return 1.0
        df = min(self.tok_df.get(stem_, 0), self.n_funcs)
        return 0.35 + 0.65 * (1.0 - math.log1p(df) / math.log1p(self.n_funcs))

    def ident_spec(self, ident: str) -> float:
        """Specificity of an identifier: 1.0 = used in one place, ~0 = used everywhere."""
        if self.n_funcs < 20:
            return 0.7
        df = self.ident_df.get(ident, 0)
        return max(0.05, 1.0 - math.log1p(df) / math.log1p(self.n_funcs))


