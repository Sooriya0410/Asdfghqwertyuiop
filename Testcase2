def _parse_glossary_text(text: str) -> Dict[str, List[str]]:
    out: Dict[str, List[str]] = {}
    for line in text.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            out[k.strip().lower()] = [x.strip() for x in v.split("|") if x.strip()]
    return out


BUILTIN_GLOSSARY = _parse_glossary_text(_BUILTIN_GLOSSARY_TEXT)


class Glossary:
    """Bidirectional abbreviation <-> meaning map (built-in + taught by the user)."""

    FWD = 0.75

    def __init__(self, user: Optional[Dict[str, List[str]]] = None):
        self.user: Dict[str, List[str]] = {k.lower(): list(v) for k, v in (user or {}).items()}
        self.map: Dict[str, Dict[str, float]] = {}
        self._build()

    def _build(self) -> None:
        mp: Dict[str, Dict[str, float]] = defaultdict(dict)

        def put(a: str, b: str, s: float) -> None:
            if a != b and s > mp[a].get(b, 0.0):
                mp[a][b] = s

        for source in (BUILTIN_GLOSSARY, self.user):
            for abbr, meanings in source.items():
                a_stems = [t for t in dict.fromkeys(word_stems(abbr)) if len(t) >= 2]
                if not a_stems:
                    a_stems = [abbr.lower()]
                a_main = a_stems[0]
                for meaning in meanings:
                    m_stems = list(dict.fromkeys(word_stems(meaning)))
                    if not m_stems:
                        continue
                    fwd = self.FWD / math.sqrt(len(m_stems))
                    for ms in m_stems:
                        put(a_main, ms, fwd)
                        put(ms, a_main, self.FWD if len(m_stems) == 1 else 0.30)
        self.map = dict(mp)

    def __contains__(self, stem_: str) -> bool:
        return stem_ in self.map

    def expand(self, stem_: str) -> Iterable[Tuple[str, float]]:
        return self.map.get(stem_, {}).items()

    def teach(self, abbr: str, meaning: str) -> None:
        abbr = abbr.strip().lower()
        meaning = meaning.strip()
        if not abbr or not meaning:
            return
        lst = self.user.setdefault(abbr, [])
        if meaning.lower() not in [m.lower() for m in lst]:
            lst.append(meaning)
        self._build()

    def forget(self, abbr: str, meaning: Optional[str] = None) -> None:
        abbr = abbr.strip().lower()
        if abbr in self.user:
            if meaning is None:
                del self.user[abbr]
            else:
                self.user[abbr] = [m for m in self.user[abbr] if m.lower() != meaning.lower()]
                if not self.user[abbr]:
                    del self.user[abbr]
            self._build()


