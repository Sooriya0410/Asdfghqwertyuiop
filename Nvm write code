EXCEL_MAX_COLUMNS = 16_384          # A..XFD
EXCEL_MAX_ROWS = 1_048_576
MAX_SPLIT_SHEETS = 64               # guard against absurd --max-columns values
LARGE_JOB_CELLS = 20_000_000        # warn above this many output cells
PROGRESS_INTERVAL_S = 5.0
MAX_ROW_WARNINGS = 20               # cap per-row warnings in the log

