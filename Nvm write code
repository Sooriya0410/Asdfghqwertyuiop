    # ------------------------------------------------------------ file pick
    def _start_dir(self) -> str:
        for text in (self.var_input.get(), self.var_output.get()):
            path = _clean_path(text)
            if path is not None and path.parent.is_dir():
                return str(path.parent)
        return str(Path.home())

    def _browse_input(self) -> None:
        chosen = filedialog.askopenfilename(
            parent=self.root, title="Select input Excel workbook",
            initialdir=self._start_dir(),
            filetypes=[("Excel workbooks", "*.xlsx *.xlsm *.xltx *.xltm"),
                       ("All files", "*.*")])
        if chosen:
            self.var_input.set(chosen)
            self._on_input_changed()

    def _browse_output(self) -> None:
        current = _clean_path(self.var_output.get())
        chosen = filedialog.asksaveasfilename(
            parent=self.root, title="Save output as",
            initialdir=str(current.parent) if current and current.parent.is_dir()
            else self._start_dir(),
            initialfile=current.name if current else "",
            defaultextension=".xlsx",
            filetypes=[("Excel workbook", "*.xlsx"),
                       ("CSV - no column limit", "*.csv")])
        if chosen:
            self.var_output.set(chosen)
            self._confirmed_output = Path(chosen)   # the dialog asked about overwriting
            self._auto_output = None

    def _on_input_changed(self) -> None:
        if self.worker is not None and self.worker.is_alive():
            return
        path = _clean_path(self.var_input.get())
        if path is None or _same_path(path, self._loaded_input):
            return
        self._loaded_input = None
        self.cmb_sheet["values"] = ()
        self.var_sheet.set("")
        if not path.is_file():
            self.var_status.set(f"Input not found: {path}")
            return
        try:
            names = list_sheet_names(path)
        except FillerError as exc:
            self.var_status.set(str(exc))
            return
        if not names:
            self.var_status.set(f"{path.name} contains no worksheets.")
            return
        self._loaded_input = path
        self.cmb_sheet["values"] = names
        self.var_sheet.set(names[0])

        current = self.var_output.get().strip()
        if not current or current == self._auto_output:
            suggestion = str(path.with_name(f"{path.stem}_filled.xlsx"))
            self.var_output.set(suggestion)
            self._auto_output = suggestion
        hint = "" if len(names) == 1 else "  Choose the sheet to read."
        self.var_status.set(f"Loaded {path.name}: {len(names)} sheet(s).{hint}")

    # ------------------------------------------------------------ validation
    def _invalid(self, message: str, widget: Any) -> None:
        messagebox.showerror("Check the settings", message, parent=self.root)
        widget.focus_set()

    def _collect_config(self) -> Optional[Config]:
        """Validate the form; returns None (after telling the user) if invalid."""
        self._on_input_changed()
        inp = _clean_path(self.var_input.get())
        if inp is None or not inp.is_file():
            self._invalid("Select an existing input Excel workbook.", self.ent_input)
            return None

        out = _clean_path(self.var_output.get())
        if out is None:
            self._invalid("Choose where to save the output.", self.ent_output)
            return None
        if not out.suffix:
            out = out.with_suffix(".xlsx")
        if out.suffix.lower() not in OUTPUT_SUFFIXES:
            self._invalid("The output file must end in .xlsx or .csv.", self.ent_output)
            return None
        if not out.is_absolute():
            out = inp.parent / out              # relative names go next to the input
        self.var_output.set(str(out))

        first_col = last_col = None
        if self.var_columns.get().strip():
            try:
                first_col, last_col = _column_range(self.var_columns.get())
            except argparse.ArgumentTypeError as exc:
                self._invalid(f"Read columns: {exc}", self.ent_output)
                return None

        try:
            skip = int(self.var_skip.get().strip())
            if skip < 0:
                raise ValueError
        except ValueError:
            self._invalid("Skip header rows must be a whole number, 0 or more.",
                          self.ent_input)
            return None

        try:
            max_cols = int(self.var_max_cols.get().strip())
            if not 1 <= max_cols <= EXCEL_MAX_COLUMNS:
                raise ValueError
        except ValueError:
            self._invalid(f"Max columns per row must be between 1 and {EXCEL_MAX_COLUMNS}.",
                          self.ent_input)
            return None

        fill = self.var_fill.get()
        if not fill.strip():
            self._invalid("The fill value must not be empty.", self.ent_input)
            return None

        cfg = Config(
            input_path=inp,
            output_path=out,
            sheet=self.var_sheet.get() or None,
            first_col=first_col,
            last_col=last_col,
            skip_rows=skip,
            byte_order=ByteOrder(self.var_byte_order.get()),
            fill=fill,
            overflow=_LABEL_TO_OVERFLOW.get(self.var_overflow.get(), Overflow.SPLIT),
            max_columns=max_cols,
            report=self.var_report.get(),
            strict=self.var_strict.get(),
        )

        targets = output_targets(cfg)
        existing = [t for t in targets if t.exists()]
        unconfirmed = [t for t in existing if not _same_path(t, self._confirmed_output)]
        if unconfirmed:
            names = "\n".join(f"  {t}" for t in unconfirmed)
            if not messagebox.askyesno("Replace files?",
                                       f"These files already exist and will be replaced:"
                                       f"\n\n{names}\n\nContinue?",
                                       icon="warning", parent=self.root):
                return None
        if existing:
            cfg = Config(**{**cfg.__dict__, "force": True})
        return cfg

    # ------------------------------------------------------------------- run
    def _start(self) -> None:
        if self.worker is not None and self.worker.is_alive():
            return
        cfg = self._collect_config()
        if cfg is None:
            return
        self._clear_log()
        self.cancel_event.clear()
        self.last_summary = None
        self._set_running(True)
        self.progress.stop()
        self.progress.configure(mode="determinate", value=0)
        self.var_progress.set("")
        self.var_status.set("Working…")
        self.worker = threading.Thread(target=self._worker, args=(cfg,),
                                       name="hex-length-filler", daemon=True)
        self.worker.start()

    def _worker(self, cfg: Config) -> None:
        last: dict = {"key": None}

        def on_progress(phase: str, done: int, total: int) -> None:
            key = (phase, int(100 * done / max(1, total)))
            if key != last["key"]:            # throttle: one message per percent
                last["key"] = key
                self.queue.put(("progress", phase, done, total))

        try:
            summary = run(cfg, progress_cb=on_progress, cancel=self.cancel_event)
            self.queue.put(("done", summary))
        except OperationCancelled as exc:
            LOG.warning("%s", exc)
            self.queue.put(("cancelled", None))
        except FillerError as exc:
            LOG.error("%s", exc)
            self.queue.put(("failed", str(exc)))
        except Exception as exc:  # pragma: no cover - last-resort guard
            LOG.exception("Unexpected error; nothing written.")
            self.queue.put(("failed", f"Unexpected error: {exc}"))

    def _cancel(self) -> None:
        if self.worker is not None and self.worker.is_alive():
            self.cancel_event.set()
            self.btn_cancel.state(["disabled"])
            self.var_status.set("Cancelling…")

    def _poll_queue(self) -> None:
        if self._destroyed:
            return
        try:
            while True:
                item = self.queue.get_nowait()
                kind = item[0]
                if kind == "log":
                    self._append_log(item[1], item[2])
                elif kind == "progress":
                    self._show_progress(*item[1:])
                else:
                    self._finish(kind, item[1])
                    if self._destroyed:
                        return
        except queue.Empty:
            pass
        self.root.after(GUI_POLL_MS, self._poll_queue)

    def _show_progress(self, phase: str, done: int, total: int) -> None:
        if phase in ("read", "save"):
            if str(self.progress.cget("mode")) != "indeterminate":
                self.progress.configure(mode="indeterminate")
                self.progress.start(15)
            if phase == "read":
                self.var_progress.set("Reading input…")
            else:
                self.var_progress.set("Saving file…")
                self.btn_cancel.state(["disabled"])   # final step cannot be interrupted
        else:
            if str(self.progress.cget("mode")) != "determinate":
                self.progress.stop()
                self.progress.configure(mode="determinate")
            pct = int(100 * done / max(1, total))
            self.progress["value"] = pct
            self.var_progress.set(f"{pct}%  ({done:,} / {total:,} rows)")

    def _finish(self, kind: str, payload: Any) -> None:
        self.progress.stop()
        self.progress.configure(mode="determinate")
        self._set_running(False)
        if self._closing:
            self._destroy()
            return

        if kind == "done":
            s: RunSummary = payload
            self.last_summary = s
            self.progress["value"] = 100
            self.var_progress.set("100%")
            self.btn_open.state(["!disabled"])
            self.btn_folder.state(["!disabled"])
            self._append_log(logging.INFO, f"Output saved: {s.output_path}", tag="ok")
            text = (f"Done in {s.elapsed_s:.1f} s: {s.ok} row(s) converted, "
                    f"{s.total_cells:,} cells → {s.output_path.name}")
            if s.invalid:
                self.var_status.set(text + f"  ({s.invalid} invalid row(s) left blank)")
                where = "the report file" if s.report_path else (
                    "the Report sheet" if self.var_report.get() else "the log")
                messagebox.showwarning(
                    "Finished with warnings",
                    f"The output was written, but {s.invalid} input row(s) could not be "
                    f"read and were left blank.\n\nSee {where} for details.",
                    parent=self.root)
            else:
                self.var_status.set(text)
        elif kind == "cancelled":
            self.progress["value"] = 0
            self.var_progress.set("")
            self.var_status.set("Cancelled; nothing written.")
        else:
            self.progress["value"] = 0
            self.var_progress.set("")
            self.var_status.set("Failed; nothing written. See the log.")
            messagebox.showerror("Conversion failed", str(payload), parent=self.root)

    def _set_running(self, running: bool) -> None:
        flag = ["disabled"] if running else ["!disabled"]
        for widget in self._inputs:
            widget.state(flag)
        self.btn_run.state(flag)
        self.btn_cancel.state(["!disabled"] if running else ["disabled"])
        if running:
            self.btn_open.state(["disabled"])
            self.btn_folder.state(["disabled"])

    # ------------------------------------------------------------------- log
    def _append_log(self, levelno: int, text: str, tag: str = "") -> None:
        if not tag:
            tag = "error" if levelno >= logging.ERROR else (
                "warn" if levelno >= logging.WARNING else "")
        self.txt_log.configure(state="normal")
        self.txt_log.insert("end", text + "\n", tag)
        self.txt_log.see("end")
        self.txt_log.configure(state="disabled")

    def _clear_log(self) -> None:
        self.txt_log.configure(state="normal")
        self.txt_log.delete("1.0", "end")
        self.txt_log.configure(state="disabled")

    # ----------------------------------------------------------- open / quit
    def _open_output(self) -> None:
        self._open(reveal=False)

    def _open_folder(self) -> None:
        self._open(reveal=True)

    def _open(self, reveal: bool) -> None:
        if self.last_summary is None:
            return
        path = self.last_summary.output_path
        if not path.exists():
            messagebox.showerror("File not found", f"{path} no longer exists.", parent=self.root)
            return
        try:
            _open_in_os(path, reveal=reveal)
        except Exception as exc:
            messagebox.showerror("Cannot open", f"Could not open {path}:\n{exc}", parent=self.root)

    def _on_close(self) -> None:
        if self.worker is not None and self.worker.is_alive():
            if not messagebox.askyesno("Conversion running",
                                       "A conversion is still running. Cancel it and close?",
                                       parent=self.root):
                return
            self._closing = True
            self._cancel()
            return
        self._destroy()

    def _destroy(self) -> None:
        self._destroyed = True
        LOG.removeHandler(self.log_handler)
        self.root.destroy()


def launch_gui(initial_input: Optional[Path] = None,
               initial_output: Optional[Path] = None) -> int:
    hint = "Use the command line instead:  python hex_length_filler.py INPUT.xlsx\n"
    if tk is None:
        sys.stderr.write(f"The GUI needs tkinter, which this Python lacks "
                         f"({_TK_IMPORT_ERROR}).\n{hint}")
        return EXIT_FATAL
    _enable_windows_dpi_awareness()
    try:
        root = tk.Tk()
    except tk.TclError as exc:
        sys.stderr.write(f"Cannot open the GUI ({exc}).\n{hint}")
        return EXIT_FATAL
    if _OPENPYXL_IMPORT_ERROR is not None:
        root.withdraw()
        messagebox.showerror("Missing dependency",
                             "openpyxl is required.\n\nInstall it with:\n    pip install openpyxl",
                             parent=root)
        root.destroy()
        return EXIT_FATAL
    FillerApp(root, initial_input, initial_output)
    root.mainloop()
    return EXIT_OK


