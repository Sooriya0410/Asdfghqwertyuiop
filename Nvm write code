# Command line
# --------------------------------------------------------------------------- #
def _non_negative_int(text: str) -> int:
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"'{text}' is not an integer") from None
    if value < 0:
        raise argparse.ArgumentTypeError("must be 0 or greater")
    return value


def _max_columns(text: str) -> int:
    value = _non_negative_int(text)
    if not 1 <= value <= EXCEL_MAX_COLUMNS:
        raise argparse.ArgumentTypeError(f"must be between 1 and {EXCEL_MAX_COLUMNS}")
    return value


def _column_range(text: str) -> Tuple[int, int]:
    match = re.fullmatch(r"\s*([A-Za-z]{1,3})\s*(?::\s*([A-Za-z]{1,3})\s*)?", text)
    if not match:
        raise argparse.ArgumentTypeError(f"'{text}' is not a column like B or B:E")
    try:
        first = column_index_from_string(match.group(1).upper())
        last = column_index_from_string((match.group(2) or match.group(1)).upper())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from None
    if first > last:
        raise argparse.ArgumentTypeError(f"'{text}': first column is after the last")
    return first, last


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="hex_length_filler",
        description="Read the last two hex bytes of each Excel row as a 16-bit length "
                    "(LSB first) and write that many filled cells per output row. "
                    "Run without arguments to open the GUI.",
        epilog="Examples:\n"
               "  python hex_length_filler.py                       (GUI)\n"
               "  python hex_length_filler.py input.xlsx\n"
               "  python hex_length_filler.py input.xlsx -o result.xlsx --force\n"
               "  python hex_length_filler.py input.xlsx --columns B --skip-rows 1\n"
               "  python hex_length_filler.py input.xlsx --overflow wrap\n"
               "  python hex_length_filler.py input.xlsx -o result.csv",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("input", type=Path, nargs="?",
                        help="input workbook (.xlsx / .xlsm); omit to open the GUI")
    parser.add_argument("-o", "--output", type=Path,
                        help="output .xlsx or .csv (default: <input>_filled.xlsx)")
    parser.add_argument("--gui", action="store_true",
                        help="open the GUI (pre-filled with INPUT/--output if given)")
    parser.add_argument("--sheet", help="input sheet name (default: first sheet)")
    parser.add_argument("--columns", type=_column_range, metavar="COLS",
                        help="read only these input columns, e.g. B or B:E (default: whole row)")
    parser.add_argument("--skip-rows", type=_non_negative_int, default=0, metavar="N",
                        help="ignore the first N input rows, e.g. a header (default: 0)")
    parser.add_argument("--byte-order", choices=[e.value for e in ByteOrder],
                        default=ByteOrder.LITTLE.value,
                        help="order of the two length bytes: little = LSB first "
                             "(default), big = MSB first")
    parser.add_argument("--fill", default="0x00",
                        help="text written into every output cell (default: 0x00)")
    parser.add_argument("--overflow", choices=[e.value for e in Overflow],
                        default=Overflow.SPLIT.value,
                        help="rows longer than --max-columns: split = same row on extra "
                             "sheets (default), wrap = following rows, error = abort")
    parser.add_argument("--max-columns", type=_max_columns, default=EXCEL_MAX_COLUMNS,
                        metavar="N",
                        help=f"columns per sheet row, 1..{EXCEL_MAX_COLUMNS} "
                             f"(default: {EXCEL_MAX_COLUMNS}, the Excel limit)")
    parser.add_argument("--no-report", action="store_true",
                        help="do not write the Report sheet (or <output>_report.csv)")
    parser.add_argument("--strict", action="store_true",
                        help="abort without writing anything if any row is invalid")
    parser.add_argument("-f", "--force", action="store_true",
                        help="overwrite existing output files")
    verbosity = parser.add_mutually_exclusive_group()
    verbosity.add_argument("-v", "--verbose", action="store_true", help="debug logging")
    verbosity.add_argument("-q", "--quiet", action="store_true", help="warnings and errors only")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    return parser


def config_from_args(args: argparse.Namespace) -> Config:
    first_col, last_col = args.columns if args.columns else (None, None)
    output = args.output or args.input.with_name(f"{args.input.stem}_filled.xlsx")
    return Config(
        input_path=args.input,
        output_path=output,
        sheet=args.sheet,
        first_col=first_col,
        last_col=last_col,
        skip_rows=args.skip_rows,
        byte_order=ByteOrder(args.byte_order),
        fill=args.fill,
        overflow=Overflow(args.overflow),
        max_columns=args.max_columns,
        report=not args.no_report,
        strict=args.strict,
        force=args.force,
    )


def _configure_logging(verbose: bool, quiet: bool) -> None:
    level = logging.DEBUG if verbose else logging.WARNING if quiet else logging.INFO
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter(LOG_FORMAT, datefmt=LOG_DATEFMT))
    LOG.handlers[:] = [handler]
    LOG.setLevel(level)
    LOG.propagate = False


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        return launch_gui()
    args = build_parser().parse_args(argv)
    if args.gui or args.input is None:
        return launch_gui(args.input, args.output)

    _configure_logging(args.verbose, args.quiet)
    if _OPENPYXL_IMPORT_ERROR is not None:
        LOG.error("openpyxl is required: pip install openpyxl (%s)", _OPENPYXL_IMPORT_ERROR)
        return EXIT_FATAL
    try:
        return run(config_from_args(args)).exit_code
    except FillerError as exc:
        LOG.error("%s", exc)
        return EXIT_FATAL
    except KeyboardInterrupt:
        LOG.error("Interrupted; nothing written.")
        return EXIT_INTERRUPTED
    except Exception:  # pragma: no cover - last-resort guard
        LOG.exception("Unexpected error; nothing written.")
        return EXIT_FATAL


if __name__ == "__main__":
    sys.exit(main())
