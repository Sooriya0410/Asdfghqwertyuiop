GUI_POLL_MS = 100

OVERFLOW_LABELS = {
    Overflow.SPLIT: "Split: same row continues on extra sheets",
    Overflow.WRAP: "Wrap: continue on the following rows",
    Overflow.ERROR: "Stop with an error",
}
_LABEL_TO_OVERFLOW = {label: mode for mode, label in OVERFLOW_LABELS.items()}


class _QueueLogHandler(logging.Handler):
    """Forwards log records from any thread to the GUI queue."""

    def __init__(self, target: "queue.Queue[tuple]") -> None:
        super().__init__()
        self._target = target

    def emit(self, record: logging.LogRecord) -> None:
        try:
            self._target.put(("log", record.levelno, self.format(record)))
        except Exception:  # pragma: no cover
            self.handleError(record)


def _open_in_os(path: Path, reveal: bool = False) -> None:
    """Open a file, or show it in the file manager, using local OS commands only."""
    if sys.platform.startswith("win"):
        if reveal:
            subprocess.Popen(["explorer", f"/select,{path}"])
        else:
            os.startfile(str(path))  # type: ignore[attr-defined]
    elif sys.platform == "darwin":
        subprocess.Popen(["open", "-R", str(path)] if reveal else ["open", str(path)])
    else:
        subprocess.Popen(["xdg-open", str(path.parent if reveal else path)])


def _enable_windows_dpi_awareness() -> None:
    """Sharp text on scaled Windows displays (no effect elsewhere)."""
    if sys.platform.startswith("win"):
        try:
            import ctypes
            ctypes.windll.shcore.SetProcessDpiAwareness(1)  # type: ignore[attr-defined]
        except Exception:
            pass


def _clean_path(text: str) -> Optional[Path]:
    """Path from an entry; tolerates the quotes added by Windows 'Copy as path'."""
    text = text.strip().strip('"').strip("'").strip()
    return Path(text).expanduser() if text else None


def _same_path(a: Optional[Path], b: Optional[Path]) -> bool:
    if a is None or b is None:
        return False
    try:
        return a.resolve() == b.resolve()
    except OSError:
        return a == b


