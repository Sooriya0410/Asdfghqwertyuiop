# --------------------------------------------------------------------------- #
# Types
# --------------------------------------------------------------------------- #
class FillerError(Exception):
    """Fatal, user-facing error. The message is shown and nothing is written."""


class OperationCancelled(FillerError):
    """The user cancelled a running conversion."""


class RowParseError(ValueError):
    """A single input row could not be interpreted."""


class Overflow(str, Enum):
    SPLIT = "split"
    WRAP = "wrap"
    ERROR = "error"


class ByteOrder(str, Enum):
    LITTLE = "little"   # first of the two bytes is the LSB (default)
    BIG = "big"         # first of the two bytes is the MSB


class Status(str, Enum):
    OK = "OK"
    EMPTY = "EMPTY"
    INVALID = "INVALID"


# progress callback: (phase, done, total); phase is "read", "write" or "save"
ProgressCallback = Callable[[str, int, int], None]


@dataclass(frozen=True)
class RowResult:
    """Outcome of parsing one input row."""

    input_row: int                 # 1-based Excel row number in the input
    raw: str                       # row text as read (cells joined by spaces)
    status: Status
    length: int = 0
    lsb: Optional[int] = None
    msb: Optional[int] = None
    message: str = ""


@dataclass(frozen=True)
class Plan:
    """Validated output layout, computed before anything is written."""

    sheet_titles: Tuple[str, ...]  # data sheets (xlsx only)
    locations: Tuple[str, ...]     # one human-readable location per result
    total_cells: int
    longest: int


@dataclass(frozen=True)
class Config:
    input_path: Path
    output_path: Path
    sheet: Optional[str] = None
    first_col: Optional[int] = None
    last_col: Optional[int] = None
    skip_rows: int = 0
    byte_order: ByteOrder = ByteOrder.LITTLE
    fill: str = "0x00"
    overflow: Overflow = Overflow.SPLIT
    max_columns: int = EXCEL_MAX_COLUMNS
    report: bool = True
    strict: bool = False
    force: bool = False

    @property
    def is_csv(self) -> bool:
        return self.output_path.suffix.lower() == ".csv"

    @property
    def report_csv_path(self) -> Path:
        return self.output_path.with_name(f"{self.output_path.stem}_report.csv")


@dataclass(frozen=True)
class RunSummary:
    output_path: Path
    report_path: Optional[Path]    # separate report file (CSV output only)
    rows: int
    ok: int
    empty: int
    invalid: int
    total_cells: int
    longest: int
    data_sheets: int
    elapsed_s: float

    @property
    def exit_code(self) -> int:
        return EXIT_PARTIAL if self.invalid else EXIT_OK


# --------------------------------------------------------------------------- #
# Parsing
# --------------------------------------------------------------------------- #
_SPLIT_RE = re.compile(r"[\s,;:|\-]+")      # \s also covers non-breaking spaces
_HEX_RE = re.compile(r"[0-9A-Fa-f]+")
_DATE_TYPES = (_dt.date, _dt.time, _dt.timedelta)   # datetime is a date subclass


def _strip_0x(token: str) -> str:
    return token[2:] if token[:2].lower() == "0x" else token


def cell_to_text(value: Any) -> str:
    """Convert a cell value to the text the user typed.

    Excel stores a cell typed as ``10`` as the number 10; its text "10" is
    still read as the hex byte 0x10, which is what the user meant.
    """
    if value is None:
        return ""
    if isinstance(value, _DATE_TYPES):
        raise RowParseError(
            f"cell contains a date/time ({value}); Excel converted the text - "
            "format the input column as Text and re-enter the bytes"
        )
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value).strip()


def tokenize(text: str) -> list[str]:
    """Split row text into byte tokens.

    Run-together hex such as ``3D03102B`` or ``0x102B`` is split into pairs.
    Other pieces are kept verbatim and are only validated if they end up in
    the last two positions.
    """
    tokens: list[str] = []
    for piece in _SPLIT_RE.split(text):
        if not piece:
            continue
        body = _strip_0x(piece)
        if len(body) > 2 and len(body) % 2 == 0 and _HEX_RE.fullmatch(body):
            tokens.extend(body[i:i + 2] for i in range(0, len(body), 2))
        else:
            tokens.append(piece)
    return tokens


def parse_byte(token: str) -> int:
    """Parse one hex byte token (``2B``, ``0x2B``, ``b``) to an int 0..255."""
    body = _strip_0x(token)
    if not body or len(body) > 2 or not _HEX_RE.fullmatch(body):
        raise RowParseError(f"'{token}' is not a valid hex byte (00..FF)")
    return int(body, 16)


def decode_length(tokens: Sequence[str],
                  byte_order: ByteOrder = ByteOrder.LITTLE) -> Tuple[int, int, int]:
    """Return ``(lsb, msb, length)`` from the last two tokens."""
    if len(tokens) < 2:
        raise RowParseError(f"need at least 2 bytes, found {len(tokens)}")
    first, second = parse_byte(tokens[-2]), parse_byte(tokens[-1])
    if byte_order is ByteOrder.LITTLE:
        lsb, msb = first, second
    else:
        msb, lsb = first, second
    return lsb, msb, (msb << 8) | lsb


def parse_row(row_number: int, values: Iterable[Any],
              byte_order: ByteOrder = ByteOrder.LITTLE) -> RowResult:
    """Parse the cell values of one input row into a :class:`RowResult`."""
    try:
        texts = [cell_to_text(v) for v in values]
    except RowParseError as exc:
        return RowResult(row_number, "", Status.INVALID, message=str(exc))

    raw = " ".join(t for t in texts if t)
    if not raw:
        return RowResult(row_number, raw, Status.EMPTY)
    try:
        lsb, msb, length = decode_length(tokenize(raw), byte_order)
    except RowParseError as exc:
        return RowResult(row_number, raw, Status.INVALID, message=str(exc))
    return RowResult(row_number, raw, Status.OK, length=length, lsb=lsb, msb=msb)


# --------------------------------------------------------------------------- #
# Reading
# --------------------------------------------------------------------------- #
def _open_input_workbook(path: Path, read_only: bool):
    if not path.is_file():
        raise FillerError(f"Input file not found: {path}")
    suffix = path.suffix.lower()
    if suffix == ".xls":
        raise FillerError("Legacy .xls is not supported; save the file as .xlsx in Excel first.")
    if suffix not in INPUT_SUFFIXES:
        raise FillerError(f"Unsupported input type '{path.suffix}'; expected one of "
                          f"{', '.join(sorted(INPUT_SUFFIXES))}.")
    try:
        return load_workbook(path, read_only=read_only, data_only=True)
    except PermissionError as exc:
        raise FillerError(f"Permission denied reading '{path}'.") from exc
    except (InvalidFileException, zipfile.BadZipFile, KeyError, OSError) as exc:
        raise FillerError(f"Cannot read '{path}' as an Excel workbook: {exc}") from exc


def list_sheet_names(path: Path) -> list[str]:
    """Return the worksheet names of a workbook (fast, read-only)."""
    wb = _open_input_workbook(path, read_only=True)
    try:
        return [ws.title for ws in wb.worksheets]
    finally:
        wb.close()


def read_rows(cfg: Config) -> list[RowResult]:
    """Read and parse every data row of the input sheet."""
    wb = _open_input_workbook(cfg.input_path, read_only=False)
    try:
        if cfg.sheet is not None:
            if cfg.sheet not in wb.sheetnames:
                raise FillerError(f"Sheet '{cfg.sheet}' not found. Available: "
                                  f"{', '.join(wb.sheetnames)}")
            ws = wb[cfg.sheet]
        else:
            if not wb.worksheets:
                raise FillerError(f"'{cfg.input_path}' contains no worksheets.")
            ws = wb.worksheets[0]
            if len(wb.worksheets) > 1:
                LOG.warning("Workbook has %d sheets; using the first one, '%s' "
                            "(choose another with --sheet).", len(wb.worksheets), ws.title)

        start = cfg.skip_rows + 1
        results: list[RowResult] = []
        if ws.max_row >= start:
            rows = ws.iter_rows(min_row=start, max_row=ws.max_row,
                                min_col=cfg.first_col, max_col=cfg.last_col,
                                values_only=True)
            for row_number, values in enumerate(rows, start=start):
                results.append(parse_row(row_number, values, cfg.byte_order))
    finally:
        wb.close()

    # Excel often reports formatted-but-empty rows at the end; drop them.
    while results and results[-1].status is Status.EMPTY:
        results.pop()
    return results


# --------------------------------------------------------------------------- #
# Planning (all limits are checked here, before any output is written)
# --------------------------------------------------------------------------- #
def _span(first: int, last: int) -> str:
    return f"Row {first}" if first == last else f"Rows {first}-{last}"


def plan_xlsx(results: Sequence[RowResult], max_columns: int, overflow: Overflow) -> Plan:
    longest = max((r.length for r in results), default=0)
    total = sum(r.length for r in results)

    if longest > max_columns and overflow is Overflow.ERROR:
        worst = next(r for r in results if r.length > max_columns)
        raise FillerError(
            f"Input row {worst.input_row} needs {worst.length} columns but a sheet row "
            f"holds at most {max_columns}. Choose split or wrap for long rows, "
            "or save as .csv."
        )

    locations: list[str] = []
    if overflow is Overflow.WRAP or longest <= max_columns:
        titles: Tuple[str, ...] = ("Output",)
        next_row = 1
        for r in results:
            used = max(1, math.ceil(r.length / max_columns))
            loc = _span(next_row, next_row + used - 1)
            locations.append(loc + (" (blank)" if r.length == 0 else ""))
            next_row += used
        if next_row - 1 > EXCEL_MAX_ROWS:
            raise FillerError(f"Wrapped output needs {next_row - 1:,} rows; Excel allows "
                              f"{EXCEL_MAX_ROWS:,}. Use split for long rows or save as .csv.")
    else:  # SPLIT across sheets, same row number on each
        parts = math.ceil(longest / max_columns)
        if parts > MAX_SPLIT_SHEETS:
            raise FillerError(f"Split output would need {parts} sheets (limit "
                              f"{MAX_SPLIT_SHEETS}). Increase the max columns per row "
                              "or use wrap.")
        titles = tuple(
            f"Bytes {p * max_columns + 1}-{min((p + 1) * max_columns, longest)}"
            for p in range(parts)
        )
        for n, r in enumerate(results, start=1):
            used = math.ceil(r.length / max_columns)
            if used == 0:
                locations.append(f"Row {n} (blank)")
            elif used == 1:
                locations.append(f"Row {n}")
            else:
                locations.append(f"Row {n}, sheets 1-{used}")

    return Plan(titles, tuple(locations), total, longest)


def plan_csv(results: Sequence[RowResult]) -> Plan:
    locations = tuple(f"Row {n}" + (" (blank)" if r.length == 0 else "")
                      for n, r in enumerate(results, start=1))
    return Plan((), locations,
                sum(r.length for r in results),
                max((r.length for r in results), default=0))


# --------------------------------------------------------------------------- #
# Writing
# --------------------------------------------------------------------------- #
class _Progress:
    """Per-row progress: callback, cancellation check and periodic log line."""

    def __init__(self, total: int, callback: Optional[ProgressCallback] = None,
                 cancel: Optional[threading.Event] = None) -> None:
        self.total = total
        self.done = 0
        self._callback = callback
        self._cancel = cancel
        self._last_log = time.monotonic()

    def check_cancel(self) -> None:
        if self._cancel is not None and self._cancel.is_set():
            raise OperationCancelled("Cancelled by user; nothing written.")

    def tick(self) -> None:
        self.done += 1
        self.check_cancel()
        if self._callback is not None:
            self._callback("write", self.done, self.total)
        now = time.monotonic()
        if now - self._last_log >= PROGRESS_INTERVAL_S:
            LOG.info("  ... %d / %d rows written (%.0f%%)", self.done, self.total,
                     100.0 * self.done / max(1, self.total))
            self._last_log = now

    def saving(self) -> None:
        self.check_cancel()
        LOG.info("Saving workbook (final compression step) ...")
        if self._callback is not None:
            self._callback("save", self.done, self.total)


def _default_file_mode() -> int:
    mask = os.umask(0)
    os.umask(mask)
    return 0o666 & ~mask


def _atomic_write(target: Path, writer: Callable[[Path], None]) -> None:
    """Write via a temp file in the target folder, then rename into place.

    A crash, Ctrl+C or Cancel never leaves a half-written output file behind.
    """
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.stem}.", suffix=target.suffix,
                                    dir=str(target.parent))
    os.close(fd)
    tmp = Path(tmp_name)
    try:
        writer(tmp)
        try:  # mkstemp creates 0600 files; give the output normal permissions
            os.chmod(tmp, _default_file_mode())
        except OSError:
            pass
        os.replace(tmp, target)
    except PermissionError as exc:
        raise FillerError(f"Cannot write '{target}': permission denied. If the file is "
                          "open in Excel, close it and run again.") from exc
    except OSError as exc:
        raise FillerError(f"Cannot write '{target}': {exc}") from exc
    finally:
        if tmp.exists():
            try:
                tmp.unlink()
            except OSError:
                pass


REPORT_HEADERS = ("Input Row", "Input Data", "LSB", "MSB", "Length (dec)",
                  "Length (hex)", "Output Location", "Status", "Message")
REPORT_WIDTHS = (10, 36, 7, 7, 13, 13, 22, 10, 60)


def _report_values(r: RowResult, location: str) -> list[Any]:
    ok = r.status is Status.OK
    return [
        r.input_row,
        r.raw,
        f"0x{r.lsb:02X}" if ok else "",
        f"0x{r.msb:02X}" if ok else "",
        r.length if ok else "",
        f"0x{r.length:04X}" if ok else "",
        location,
        r.status.value,
        r.message,
    ]


def _write_report_sheet(wb: "Workbook", results: Sequence[RowResult], plan: Plan) -> None:
    ws = wb.create_sheet("Report")
    for idx, width in enumerate(REPORT_WIDTHS, start=1):
        ws.column_dimensions[chr(64 + idx)].width = width
    ws.freeze_panes = "A2"

    bold = Font(bold=True)
    header = []
    for title in REPORT_HEADERS:
        cell = WriteOnlyCell(ws, value=title)
        cell.font = bold
        header.append(cell)
    ws.append(header)

    invalid_fill = PatternFill("solid", fgColor="FFC7CE")
    for r, loc in zip(results, plan.locations):
        row = []
        for value in _report_values(r, loc):
            cell = WriteOnlyCell(ws, value=value)
            if isinstance(value, str):
                cell.data_type = "s"           # never interpret input text as a formula
            if r.status is Status.INVALID:
                cell.fill = invalid_fill
            row.append(cell)
        ws.append(row)


def write_xlsx(results: Sequence[RowResult], plan: Plan, cfg: Config,
               progress: _Progress) -> None:
    def _writer(tmp: Path) -> None:
        wb = Workbook(write_only=True)        # streams rows; constant memory
        sheets = [wb.create_sheet(title) for title in plan.sheet_titles]
        step = cfg.max_columns
        single_sheet = len(sheets) == 1

        for r in results:
            if single_sheet:
                ws = sheets[0]
                if r.length == 0:
                    ws.append([])             # keep row alignment
                for start in range(0, r.length, step):
                    ws.append([cfg.fill] * min(step, r.length - start))
            else:                             # split: same row on every sheet
                for part, ws in enumerate(sheets):
                    count = min(step, r.length - part * step)
                    ws.append([cfg.fill] * count if count > 0 else [])
            progress.tick()

        if cfg.report:
            _write_report_sheet(wb, results, plan)
        progress.saving()
        wb.save(str(tmp))

    _atomic_write(cfg.output_path, _writer)


def write_csv(results: Sequence[RowResult], plan: Plan, cfg: Config,
              progress: _Progress) -> None:
    def _data_writer(tmp: Path) -> None:
        with open(tmp, "w", newline="", encoding="utf-8") as fh:
            writer = csv.writer(fh)
            for r in results:
                writer.writerow([cfg.fill] * r.length)
                progress.tick()

    def _report_writer(tmp: Path) -> None:
        with open(tmp, "w", newline="", encoding="utf-8-sig") as fh:
            writer = csv.writer(fh)
            writer.writerow(REPORT_HEADERS)
            for r, loc in zip(results, plan.locations):
                writer.writerow(_report_values(r, loc))

    _atomic_write(cfg.output_path, _data_writer)
    if cfg.report:
        _atomic_write(cfg.report_csv_path, _report_writer)


# --------------------------------------------------------------------------- #
# Orchestration
# --------------------------------------------------------------------------- #
def _shorten(text: str, limit: int = 60) -> str:
    return text if len(text) <= limit else text[:limit - 3] + "..."


def output_targets(cfg: Config) -> list[Path]:
    """Every file a run with this config will create or replace."""
    return [cfg.output_path] + ([cfg.report_csv_path] if cfg.is_csv and cfg.report else [])


def _check_output_paths(cfg: Config) -> None:
    out = cfg.output_path
    if out.suffix.lower() not in OUTPUT_SUFFIXES:
        raise FillerError(f"Output must end in .xlsx or .csv (got '{out.name}').")
    for target in output_targets(cfg):
        if target.resolve() == cfg.input_path.resolve():
            raise FillerError("Output path is the input file; refusing to overwrite it.")
        if target.is_dir():
            raise FillerError(f"'{target}' is a directory.")
        if target.exists() and not cfg.force:
            raise FillerError(f"'{target}' already exists. Use --force to overwrite.")


def run(cfg: Config, progress_cb: Optional[ProgressCallback] = None,
        cancel: Optional[threading.Event] = None) -> RunSummary:
    """Execute one conversion.

    Raises FillerError (or its subclass OperationCancelled) on fatal errors;
    in every such case nothing is written.
    """
    t0 = time.monotonic()
    if not cfg.fill:
        raise FillerError("The fill value must not be empty.")
    if cfg.fill.startswith("="):
        raise FillerError("The fill value must not start with '=' (Excel would treat it "
                          "as a formula).")
    _check_output_paths(cfg)

    if progress_cb is not None:
        progress_cb("read", 0, 0)
    LOG.info("Reading %s", cfg.input_path)
    results = read_rows(cfg)
    if not results:
        raise FillerError("No data rows found in the input sheet.")

    ok = sum(r.status is Status.OK for r in results)
    empty = sum(r.status is Status.EMPTY for r in results)
    invalid = [r for r in results if r.status is Status.INVALID]

    for r in invalid[:MAX_ROW_WARNINGS]:
        LOG.warning("Input row %d invalid: %s  [data: '%s']", r.input_row, r.message,
                    _shorten(r.raw))
    if len(invalid) > MAX_ROW_WARNINGS:
        LOG.warning("... and %d more invalid rows (see the report).",
                    len(invalid) - MAX_ROW_WARNINGS)
    if invalid and cfg.strict:
        raise FillerError(f"{len(invalid)} invalid row(s) and strict mode is on; "
                          "nothing written.")

    plan = plan_csv(results) if cfg.is_csv else plan_xlsx(results, cfg.max_columns, cfg.overflow)

    LOG.info("Rows: %d total, %d OK, %d empty, %d invalid. Longest row: %d columns. "
             "Cells to write: %s", len(results), ok, empty, len(invalid), plan.longest,
             f"{plan.total_cells:,}")
    if len(plan.sheet_titles) > 1:
        LOG.info("Rows longer than %d columns continue on the same row of %d sheets: %s",
                 cfg.max_columns, len(plan.sheet_titles), ", ".join(plan.sheet_titles))
    if cfg.is_csv and plan.longest > EXCEL_MAX_COLUMNS:
        LOG.warning("CSV rows up to %d columns: Excel will display only the first %d.",
                    plan.longest, EXCEL_MAX_COLUMNS)
    if plan.total_cells > LARGE_JOB_CELLS:
        LOG.warning("Large job (%s cells): this can take several minutes and produce a "
                    "large file.", f"{plan.total_cells:,}")

    progress = _Progress(len(results), progress_cb, cancel)
    progress.check_cancel()
    LOG.info("Writing %s", cfg.output_path)
    if cfg.is_csv:
        write_csv(results, plan, cfg, progress)
    else:
        write_xlsx(results, plan, cfg, progress)

    summary = RunSummary(
        output_path=cfg.output_path,
        report_path=cfg.report_csv_path if cfg.is_csv and cfg.report else None,
        rows=len(results), ok=ok, empty=empty, invalid=len(invalid),
        total_cells=plan.total_cells, longest=plan.longest,
        data_sheets=len(plan.sheet_titles), elapsed_s=time.monotonic() - t0,
    )
    LOG.info("Done in %.1f s -> %s", summary.elapsed_s, cfg.output_path)
    if summary.report_path is not None:
        LOG.info("Report -> %s", summary.report_path)
    return summary


