# ════════════════════════════════════════════════════════════════════════════
#  Per-message context: base values, mux, payload builder
# ════════════════════════════════════════════════════════════════════════════
class MsgContext:
    def __init__(self, msg: Message, cfg: GenConfig) -> None:
        self.msg, self.cfg = msg, cfg
        self.by_name = {s.name: s for s in msg.signals}
        self.nbits = msg.length * 8
        self.fits = {s.name: s.length > 0 and all(0 <= p < self.nbits for p in bits_of(s)) for s in msg.signals}
        self.bounds = {s.name: compute_bounds(s) for s in msg.signals if not s.is_float}
        self.switches = [s for s in msg.signals if s.is_switch]
        self.switch_names = {s.name for s in self.switches}
        self.mux_map: Dict[str, Dict[int, List[Signal]]] = {}
        for s in msg.signals:
            if s.mux_parent:
                for v in s.mux_values[:256]:
                    self.mux_map.setdefault(s.mux_parent, {}).setdefault(v, []).append(s)
        self.dbc_init: Dict[str, Any] = {}
        self.base: Dict[str, Any] = {}
        self.init_note: Dict[str, str] = {}
        for s in msg.signals:
            self._init_value(s)
        self.default_sel: Dict[str, int] = {}
        for sw in self.switches:
            vals = sorted(self.mux_map.get(sw.name, {}))
            iv = int(self.dbc_init[sw.name])
            sel = iv if (iv in vals or not vals) else vals[0]
            self.default_sel[sw.name] = sel
            self.base[sw.name] = sel
        used: Set[int] = set()
        for s in msg.signals:
            used.update(p for p in bits_of(s) if 0 <= p < self.nbits)
        self.used_bits = used
        self.unused_bits = [p for p in range(self.nbits) if p not in used]

    def _init_value(self, s: Signal) -> None:
        v = s.attr("GenSigStartValue")
        if s.is_float:
            try:
                f = float(v) if v not in (None, "") else 0.0
            except (TypeError, ValueError):
                f = 0.0
            self.dbc_init[s.name] = self.base[s.name] = f
            return
        b = self.bounds[s.name]
        try:
            r = int(Decimal(str(v))) if v not in (None, "") else 0
        except (InvalidOperation, ValueError):
            r = 0
        self.dbc_init[s.name] = r
        base = r
        if not b.in_type(r):
            base = max(b.tmin, min(b.tmax, r))
            self.init_note[s.name] = f"GenSigStartValue {r} not representable in {s.length} bit"
        if b.valid and not b.ok(base):
            fb = 0 if b.ok(0) else b.r_pmin
            self.init_note[s.name] = (f"GenSigStartValue raw {r} outside valid range [{b.lo}..{b.hi}] – "
                                      f"raw {fb} used as base value in other tests")
            base = fb
        self.base[s.name] = base

    # ── mux helpers ──────────────────────────────────────────────────────
    def chain_selection(self, sig: Signal) -> Dict[str, int]:
        sel: Dict[str, int] = {}
        cur: Optional[Signal] = sig
        for _ in range(16):
            if cur is None or not cur.mux_parent:
                break
            sel.setdefault(cur.mux_parent, cur.mux_values[0] if cur.mux_values else 0)
            cur = self.by_name.get(cur.mux_parent)
        return sel

    def is_active(self, sig: Signal, sel: Dict[str, int], depth: int = 0) -> bool:
        if not sig.mux_parent:
            return True
        if depth > 16:
            return False
        parent = self.by_name.get(sig.mux_parent)
        if parent is None:
            return True
        return sel.get(parent.name) in sig.mux_values and self.is_active(parent, sel, depth + 1)

    def full_selection(self, sel: Optional[Dict[str, int]] = None) -> Dict[str, int]:
        s = dict(self.default_sel)
        if sel:
            s.update(sel)
        return s

    def sel_note(self, sel: Dict[str, int]) -> str:
        return ("Multiplexor: " + ", ".join(f"{k}={v}" for k, v in sel.items()) + ". ") if sel else ""

    # ── payload ──────────────────────────────────────────────────────────
    def build(self, values: Optional[Dict[str, Any]] = None, sel: Optional[Dict[str, int]] = None,
              fill: Optional[int] = None, use_base: bool = True) -> bytearray:
        fill = self.cfg.padding_byte if fill is None else fill
        data = bytearray([fill & 0xFF] * self.msg.length)
        s = self.full_selection(sel)
        if values:
            for k, v in values.items():
                if k in self.switch_names:
                    s[k] = int(v)
        vals: Dict[str, Any] = dict(self.base) if use_base else {}
        vals.update(s)
        if values:
            vals.update(values)
        for sig in self.msg.signals:
            if sig.name in vals and self.is_active(sig, s):
                encode_into(data, sig, vals[sig.name])
        return data

    def decode_all(self, data: Sequence[int]) -> List[Tuple[Signal, Any, bool]]:
        sel = {sw.name: int(decode_from(data, sw)) for sw in self.switches}
        out = []
        for s in self.msg.signals:
            if not self.fits[s.name] or not self.is_active(s, sel):
                continue
            raw = decode_from(data, s)
            if s.is_float:
                f = float(raw)
                ok = not (math.isnan(f) or math.isinf(f))
                if ok and not (s.minimum == 0 and s.maximum == 0):
                    ok = s.minimum <= s.phys(f) <= s.maximum
            else:
                ok = self.bounds[s.name].ok(raw)
            out.append((s, raw, ok))
        return out

    def fmt(self, s: Signal, raw: Any) -> str:
        p = dec_str(s.phys(raw))
        u = f" {s.unit}" if s.unit else ""
        lab = ""
        if not s.is_float and s.choices and int(raw) in s.choices:
            lab = f" '{s.choices[int(raw)]}'"
        if s.is_float:
            return f"{p}{u}"
        return f"{p}{u}{lab} (raw {raw}/{raw_hex(s, raw)})"


# ════════════════════════════════════════════════════════════════════════════
#  Test case builder (numbering, defaults, steps text)
# ════════════════════════════════════════════════════════════════════════════
class TcBuilder:
    def __init__(self, ctx: MsgContext, direction: str) -> None:
        self.ctx, self.msg, self.cfg = ctx, ctx.msg, ctx.cfg
        self.direction = direction
        self.items: List[TestCase] = []
        self._codes: Set[str] = set()
        m = self.msg
        self.idtag = f"{m.frame_id:08X}" if m.is_extended else f"{m.frame_id:03X}"
        self.def_mode = "MONITOR" if direction == "TX" else ("CYCLIC" if m.cycle_time > 0 else "SINGLE")

    def add(self, code: str, category: str, group: str, title: str, *, signal: Optional[Signal] = None,
            raw: Any = None, intended: Any = None, payload: Any = None, tx_mode: Optional[str] = None,
            cycle: Any = None, duration: Any = None, gap: Any = None, reps: Any = None,
            can_id: Optional[str] = None, id_format: Optional[str] = None, frame: Optional[str] = None,
            brs: Optional[str] = None, dlc: Any = None, data_len: Any = None, precondition: str = "",
            steps: str = "", expected: str = "", trace: str = "", note: str = "", applicable: bool = True,
            reason: str = "", sel: Optional[Dict[str, int]] = None, violation: str = "",
            why: str = "") -> Optional[TestCase]:
        if not applicable and not self.cfg.include_na_rows:
            return None
        if not violation and category == NEG:
            violation = f"Other – {group}"  # safety net; the self-test asserts this never happens
        m, cfg = self.msg, self.cfg
        mode = tx_mode or self.def_mode
        if payload is None:
            payloads: List[bytes] = []
        elif isinstance(payload, (bytes, bytearray)):
            payloads = [bytes(payload)]
        else:
            payloads = [bytes(p) for p in payload]
        frame = frame or m.frame_type
        if data_len is None:
            data_len = len(payloads[0]) if payloads else m.length
        if dlc is None:
            dlc = length_to_dlc(int(data_len)) if isinstance(data_len, int) else m.dlc_code
        if brs is None:
            brs = ("1" if m.brs else "0") if frame == "CAN FD" else "-"
        timed = mode in ("CYCLIC", "GAP", "STOP", "SEQUENCE", "JITTER", "MONITOR")
        if cycle is None:
            cycle = m.cycle_time if m.cycle_time > 0 else (cfg.event_interval_ms if timed and mode != "MONITOR" else "-")
        if duration is None:
            duration = cfg.stim_duration_ms if mode in ("CYCLIC", "GAP", "STOP", "JITTER", "MONITOR") else "-"
        if gap is None:
            gap = "-"
        if reps is None:
            reps = cfg.burst_count if mode == "BURST" else (1 if mode == "SEQUENCE" else "-")
        code_u = code
        k = 2
        while code_u in self._codes:
            code_u = f"{code}~{k}"
            k += 1
        self._codes.add(code_u)
        tc = TestCase(
            tc_id=f"TC_{self.idtag}_{len(self.items) + 1:04d}", message=m.name, code=code_u, category=category,
            group=group, title=title, direction="DUT Tx (verify)" if self.direction == "TX" else "DUT Rx (stimulus)",
            can_id=can_id or m.id_hex, id_format=id_format or m.id_format, frame=frame, brs=brs, dlc=dlc,
            data_len=data_len, tx_mode=mode, cycle_ms=cycle, duration_ms=duration, gap_ms=gap, repetitions=reps,
            payload=" | ".join(hexs(p) for p in payloads) if payloads else ("-" if mode in ("MONITOR", "NONE") else ""),
            applicable="Yes" if applicable else "No", reason=reason, trace=trace, note=note)
        if signal is not None:
            tc.signal = signal.name
            tc.unit = signal.unit
            if raw is not None:
                tc.raw_dec = xl_num(Decimal(repr(float(raw)))) if signal.is_float else int(raw)
                tc.raw_hex = raw_hex(signal, raw)
                tc.intended_phys = intended if intended is not None else signal.phys(raw)
            if payloads and self.ctx.fits.get(signal.name) and \
                    all(p < len(payloads[0]) * 8 for p in bits_of(signal)):
                tc.decoded_phys = signal.phys(decode_from(payloads[0], signal))
        mux_txt = self.ctx.sel_note(sel or {})
        if self.direction == "TX":
            base_pre = "DUT powered (KL15 ON), network awake, DUT transmitting. Bus logging active."
        else:
            base_pre = "DUT powered (KL15 ON), network awake, fault memory cleared, rest-bus simulation running."
        tc.precondition = (precondition or base_pre) + (" " + mux_txt if mux_txt else "")
        tc.steps = steps or self._steps(tc)
        tc.expected = expected
        tc.violation = violation or NO_VIOLATION
        tc.why = why
        self.items.append(tc)
        return tc

    def na(self, code: str, group: str, title: str, reason: str, signal: Optional[Signal] = None,
           violation: str = "") -> None:
        self.add(code, NEG, group, title, signal=signal, applicable=False, reason=reason,
                 expected="Not applicable – see N/A Reason.", steps="-", tx_mode="-", cycle="-",
                 duration="-", payload=None, violation=violation,
                 why=f"Violation cannot be produced for this definition: {reason}")

    def _steps(self, tc: TestCase) -> str:
        fr = f"ID {tc.can_id} ({tc.id_format}, {tc.frame}" + (f", BRS={tc.brs}" if tc.frame == "CAN FD" else "") \
             + f", DLC {tc.dlc})"
        mode = tc.tx_mode
        if mode == "CYCLIC":
            s2 = f"Transmit {fr} with Payload every {tc.cycle_ms} ms for {tc.duration_ms} ms."
        elif mode == "SINGLE":
            s2 = f"Transmit {fr} with Payload once."
        elif mode == "BURST":
            s2 = f"Transmit {tc.repetitions} frames {fr} back-to-back (minimum inter-frame space)."
        elif mode == "GAP":
            s2 = (f"Transmit {fr} every {tc.cycle_ms} ms for {tc.duration_ms} ms, interrupt for {tc.gap_ms} ms, "
                  f"then resume for {tc.duration_ms} ms.")
        elif mode == "STOP":
            s2 = f"Transmit {fr} every {tc.cycle_ms} ms for {tc.duration_ms} ms, then stop and observe {tc.gap_ms} ms."
        elif mode == "NONE":
            s2 = f"Start the DUT with {fr} never transmitted; observe for {tc.gap_ms} ms."
        elif mode == "SEQUENCE":
            n = tc.payload.count("|") + 1
            s2 = (f"Transmit the {n} payload(s) in order on {fr}, one every {tc.cycle_ms} ms "
                  f"(repeat {tc.repetitions}x), then continue with nominal frames.")
        elif mode == "JITTER":
            s2 = f"Transmit {fr} alternating intervals {tc.cycle_ms} ms for {tc.duration_ms} ms."
        else:
            s2 = f"Do not stimulate {tc.message}. Record DUT frames on {tc.can_id} for ≥ {tc.duration_ms} ms."
        if self.direction == "TX":
            s3 = "Evaluate the recorded frames against the Expected Result."
        elif tc.signal:
            s3 = (f"Read the DUT-internal value of {tc.signal} (XCP / debugger / diagnostic DID) and "
                  f"check fault memory (DTCs) and Rx/E2E status.")
        else:
            s3 = "Observe DUT reaction: decoded signal values, Rx indication/timeout status, DTCs, ECU resets."
        return f"1. Establish precondition.\n2. {s2}\n3. {s3}"


# ════════════════════════════════════════════════════════════════════════════
#  Test case generator
# ════════════════════════════════════════════════════════════════════════════
class TestCaseGenerator:
    def __init__(self, db: Database, cfg: GenConfig) -> None:
        self.db, self.cfg = db, cfg
        self.all_ids = {(m.frame_id, m.is_extended) for m in db.messages}
        self.counter_re = re.compile(cfg.counter_regex, re.I)
        self.crc_re = re.compile(cfg.crc_regex, re.I)
        self.special_re = re.compile(cfg.special_regex, re.I)
        self.j1939_net = "J1939" in str(attr_get(db.network_attrs, "ProtocolType", default="")).upper()

    # ── classification ───────────────────────────────────────────────────
    def direction(self, msg: Message) -> str:
        dut = self.cfg.dut_node
        if not dut:
            return "RX"
        if dut in msg.transmitters:
            return "TX"
        if dut in msg.receivers:
            return "RX"
        return "NA"

    @staticmethod
    def classify(msg: Message) -> str:
        if any(is_yes(msg.attr(a, default="")) for a in ("DiagRequest", "DiagResponse", "DiagState",
                                                           "DiagUUDTResponse", "DiagConnection")) or \
                re.search(r"(?i)(^(diag|uds|xcp|ccp|obd)|_(diag|uds)(req|resp|res)?$|diagreq|diagres|diag_req|diag_res)",
                          msg.name):
            return "Diagnostic"
        if any(is_yes(msg.attr(a, default="")) for a in ("NmMessage", "NmAsrMessage")) or \
                re.search(r"(?i)(^nm_|_nm$|^nm\d|^nmasr)", msg.name):
            return "NM"
        return "Application"

    def is_j1939(self, msg: Message) -> bool:
        vff = str(msg.attr("VFrameFormat", default="")).upper()
        return self.j1939_net or "J1939" in vff or any(s.has_explicit("SPN") for s in msg.signals)

    def message_status(self, msg: Message) -> Tuple[bool, str, str]:
        """(selected, direction, status text)"""
        flt = self.cfg.message_filter.strip()
        if flt:
            ids = [x for x in re.split(r"[,\s;]+", flt) if re.fullmatch(r"(?i)0x[0-9a-f]+", x)]
            if ids:
                if not any(int(x, 16) == msg.frame_id for x in ids):
                    return False, "", "Skipped – not in ID filter"
            else:
                try:
                    if not re.search(flt, msg.name, re.I):
                        return False, "", "Skipped – name filter"
                except re.error:
                    if flt.lower() not in msg.name.lower():
                        return False, "", "Skipped – name filter"
        cls = self.classify(msg)
        if self.cfg.skip_diag and cls == "Diagnostic":
            return False, "", "Skipped – diagnostic message"
        d = self.direction(msg)
        if d == "NA":
            if self.cfg.include_unrelated:
                return True, "RX", "Generated (not related to DUT – treated as stimulus)"
            return False, "", f"Skipped – {self.cfg.dut_node} neither sends nor receives"
        return True, d, "Generated"

    # ── timeouts ────────────────────────────────────────────────────────
    def signal_timeout(self, s: Signal) -> Tuple[Optional[int], str]:
        """Rx timeout of a signal: DUT-specific (BA_REL_ / GenSigTimeoutTime_<Node>) → generic → max over receivers."""
        dut = self.cfg.dut_node
        cand: List[Tuple[int, str]] = []
        rel = attr_get(s.rel_attributes, "GenSigTimeoutTime", "GenSigTimeOutTime")
        for node, v in (rel or {}).items():
            if pos_int(v):
                if dut and node.lower() == dut.lower():
                    return pos_int(v), f"BA_REL_ GenSigTimeoutTime ({node})"
                cand.append((pos_int(v), f"BA_REL_ GenSigTimeoutTime ({node})"))
        for k, v in s.attributes.items():
            if k.lower().startswith("gensigtimeouttime_") and pos_int(v):
                node = k.split("_", 1)[1]
                if dut and node.lower() == dut.lower():
                    return pos_int(v), k
                cand.append((pos_int(v), k))
        v = pos_int(s.attr("GenSigTimeoutTime", "GenSigTimeOutTime", "GenSigTimeout"))
        if v:
            return v, "GenSigTimeoutTime"
        if cand and not dut:
            best = max(cand)
            return best[0], best[1] + (" – max over receivers" if len(cand) > 1 else "")
        return None, ""

    def timeouts_of(self, msg: Message) -> Dict[int, Tuple[List[str], str]]:
        dut = self.cfg.dut_node
        sigs = msg.signals
        if dut and dut in msg.receivers:
            sigs = [s for s in msg.signals if dut in s.receivers]
        out: Dict[int, Tuple[List[str], str]] = {}
        for s in sigs:
            to, src = self.signal_timeout(s)
            if to:
                out.setdefault(to, ([], src))[0].append(s.name)
        if not out and msg.cycle_time > 0:
            to = int(round(msg.cycle_time * self.cfg.timeout_factor))
            out[to] = ([s.name for s in sigs],
                       f"ASSUMED {self.cfg.timeout_factor:g} x cycle (no GenSigTimeoutTime for "
                       f"{dut or 'any receiver'} in DBC)")
        return dict(sorted(out.items()))

    # ── main entry ──────────────────────────────────────────────────────
    def generate(self, msg: Message, direction: str) -> List[TestCase]:
        ctx = MsgContext(msg, self.cfg)
        T = TcBuilder(ctx, direction)
        if direction == "TX":
            self._tx_tests(T, ctx)
            return T.items
        self._rx_frame_tests(T, ctx)
        self._rx_dlc_tests(T, ctx)
        self._rx_timing_tests(T, ctx)
        self._rx_timeout_tests(T, ctx)
        self._rx_event_tests(T, ctx)
        for s in msg.signals:
            self._rx_signal_tests(T, ctx, s)
        self._rx_mux_tests(T, ctx)
        if self.cfg.include_e2e:
            self._rx_e2e_tests(T, ctx)
        if self.cfg.include_layout:
            self._rx_msg_layout_tests(T, ctx)
        if self.cfg.include_combination:
            self._rx_combination_tests(T, ctx)
        return T.items

    # ── RX: frame format ────────────────────────────────────────────────
    def _rx_frame_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m = ctx.msg
        base = ctx.build()
        cyc = f"{m.cycle_time} ms" if m.cycle_time else "event"
        T.add("FRM.NOMINAL", PASS, "Frame", "Nominal frame – all signals at initial values", payload=base,
              expected=(f"DUT receives {m.name}; every signal decodes to its initial value; no DLC/timeout/E2E "
                        f"error; no DTC; no ECU reset."),
              trace=f"{m.id_hex} {m.id_format} {m.frame_type}, DLC {m.dlc_code}, {cyc}")
        if m.is_extended:
            if m.frame_id <= 0x7FF:
                T.add("FRM.WRONG_IDE", NEG, "Frame", "Same ID value sent as 11-bit Standard frame", payload=base,
                      can_id=f"0x{m.frame_id:03X}", id_format="Standard", violation=V_IDE,
                      why=(f"{m.name} is defined with a 29-bit Extended ID; the same ID number is sent with an 11-bit "
                           f"Standard identifier (IDE bit wrong)."),
                      expected=(f"Frame not accepted as {m.name} (IDE mismatch, filtered by CAN controller/CanIf); "
                                f"signals keep previous values; timeout reaction once timeout elapses."))
            else:
                T.na("FRM.WRONG_IDE", "Frame", "ID sent with opposite IDE", "Extended ID > 0x7FF has no 11-bit equivalent",
                     violation=V_IDE)
        else:
            T.add("FRM.WRONG_IDE", NEG, "Frame", "Same ID value sent as 29-bit Extended frame", payload=base,
                  can_id=f"0x{m.frame_id:08X}", id_format="Extended", violation=V_IDE,
                  why=(f"{m.name} is defined with an 11-bit Standard ID; the same ID number is sent as a 29-bit "
                       f"Extended identifier (IDE bit wrong)."),
                  expected=(f"Frame not accepted as {m.name} (IDE mismatch, filtered by CAN controller/CanIf); "
                            f"signals keep previous values; timeout reaction once timeout elapses."))
        if m.is_fd:
            if m.length <= 8:
                T.add("FRM.FD_AS_CLASSIC", NEG, "Frame", "CAN FD message sent as classic CAN frame", payload=base,
                      frame="CAN", brs="-", violation=V_FDF,
                      why=f"{m.name} is defined as CAN FD; it is sent as a classic CAN frame (FDF bit = 0).",
                      expected=("Accepted only if CanIfRxPduCanIdType allows classic frames (STANDARD_CAN / "
                                "EXTENDED_CAN); rejected for *_FD_CAN. Verify against the DUT CanIf configuration."))
            else:
                T.add("FRM.FD_AS_CLASSIC", NEG, "Frame", "CAN FD message sent as classic CAN frame (8 bytes)",
                      payload=base[:8], frame="CAN", brs="-", violation=V_FDF,
                      why=(f"{m.name} is defined as CAN FD with {m.length} bytes; a classic CAN frame (FDF = 0) can "
                           f"carry only 8 bytes."),
                      expected=(f"Classic frame carries only 8 of {m.length} bytes: PDU rejected (frame format / "
                                f"DLC check); no signal update; timeout reaction once timeout elapses."))
            T.add("FRM.BRS_TOGGLE", CORNER, "Frame", f"BRS bit {'cleared' if m.brs else 'set'}", payload=base,
                  brs="0" if m.brs else "1",
                  expected=("Frame accepted (BRS only changes the data-phase bit rate; bus must be configured for "
                            "it); all signals decoded correctly."))
        else:
            T.add("FRM.CLASSIC_AS_FD", NEG, "Frame", "Classic CAN message sent as CAN FD frame", payload=base,
                  frame="CAN FD", brs="0", violation=V_FDF,
                  why=f"{m.name} is defined as classic CAN; it is sent as a CAN FD frame (FDF bit = 1).",
                  expected=("Accepted only if CanIfRxPduCanIdType = STANDARD_CAN/EXTENDED_CAN (mixed); rejected for "
                            "*_NO_FD_CAN. Verify against the DUT CanIf configuration; no reset."))
            T.add("FRM.RTR", NEG, "Frame", "Remote frame (RTR) on the message ID", payload=b"", frame="CAN RTR",
                  dlc=m.dlc_code, data_len=0, tx_mode="SINGLE", cycle="-", duration="-", violation=V_RTR,
                  why=f"{m.name} is a data frame; a remote frame (RTR = 1, no data bytes) is sent on its ID.",
                  expected=("Remote frame is not treated as data: no signal update, no Rx indication; DUT does not "
                            "answer unless RTR handling is specified."))
        lim = 0x1FFFFFFF if m.is_extended else 0x7FF
        for delta, code in ((-1, "FRM.ID_MINUS_1"), (1, "FRM.ID_PLUS_1")):
            nid = m.frame_id + delta
            nid_s = f"0x{nid:08X}" if m.is_extended else f"0x{nid:03X}"
            if not 0 <= nid <= lim:
                T.na(code, "Frame", f"Payload on neighbour ID {nid_s}", "Neighbour ID outside identifier range",
                     violation=V_ID)
            elif (nid, m.is_extended) in self.all_ids:
                T.na(code, "Frame", f"Payload on neighbour ID {nid_s}", "Neighbour ID is used by another DBC message",
                     violation=V_ID)
            else:
                T.add(code, NEG, "Frame", f"Same payload on undefined neighbour ID {nid_s}", payload=base, can_id=nid_s,
                      violation=V_ID,
                      why=f"ID {nid_s} is not defined in the DBC; the payload of {m.name} is sent on it.",
                      expected=(f"Frame ignored by DUT (acceptance filtering): no update of {m.name} signals, "
                                f"no reaction, no DTC, no reset."))

    # ── RX: DLC / length ────────────────────────────────────────────────
    def _rx_dlc_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m = ctx.msg
        L = m.length
        base = ctx.build()
        pad = bytes([self.cfg.padding_byte & 0xFF])
        shorter = [x for x in CANFD_LENGTHS if x < L] if m.is_fd else list(range(0, L))
        for n in shorter:
            trunc = [s.name for s in m.signals if ctx.fits[s.name] and max(bits_of(s)) >= n * 8]
            T.add(f"DLC.SHORT_{n}", NEG, "Length/DLC", f"DLC {length_to_dlc(n)} ({n} B) shorter than defined {L} B",
                  payload=base[:n], data_len=n, violation=V_DLC,
                  why=(f"Frame carries {n} of the {L} defined data bytes (DLC {length_to_dlc(n)} instead of "
                       f"{m.dlc_code}); {len(trunc)} signal(s) truncated" + (f": {shorten(trunc, 6)}." if trunc else ".")),
                  expected=(f"Received length {n} < configured {L}: CanIf DLC check fails → PDU discarded "
                            f"(DET CANIF_E_INVALID_DLC if enabled); signals keep last valid values; no Rx indication; "
                            f"persistent condition → timeout reaction. No reset."),
                  trace="Truncated signals: " + (shorten(trunc) if trunc else "none"))
        longer = [x for x in CANFD_LENGTHS if x > L] if m.is_fd else list(range(L + 1, 9))
        for n in longer:
            T.add(f"DLC.LONG_{n}", CORNER, "Length/DLC", f"DLC {length_to_dlc(n)} ({n} B) longer than defined {L} B",
                  payload=base + pad * (n - L), data_len=n,
                  expected=("Frame accepted (received length ≥ configured length, AUTOSAR CanIf); extra bytes "
                            "ignored; all signals decode unchanged. (If OEM spec demands strict DLC → rejected.)"))
        if not m.is_fd:
            full = base + pad * (8 - L)
            T.add("DLC.CODE_15", CORNER, "Length/DLC", "Classic CAN DLC code 15 (> 8) with 8 data bytes",
                  payload=full, dlc=15, data_len=8,
                  expected=("ISO 11898-1: DLC 9…15 means 8 data bytes → frame handled like DLC 8"
                            + (" (accepted)." if L <= 8 else ".")),
                  note="Sender tool must allow DLC > 8 on classic CAN (CAPL: msg.dlc = 15).")

    # ── RX: timing ──────────────────────────────────────────────────────
    def _rx_timing_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m, cfg = ctx.msg, self.cfg
        cyc = m.cycle_time
        if cyc <= 0:
            T.na("TIM.CYCLE", "Timing", "Cycle time tolerance", "No GenMsgCycleTime – event/spontaneous message",
                 violation=V_CYCLE)
            return
        res = max(1, cfg.time_res_ms)
        lo_b, hi_b = tol_bounds(cyc, cfg.cycle_tol_pct)
        lo_b = max(res, lo_b)
        min_to = min(self.timeouts_of(m) or {0: None})
        base = ctx.build()
        tr = f"GenMsgCycleTime = {cyc} ms, tolerance ±{cfg.cycle_tol_pct:g} %"
        T.add("TIM.TOL_LOW", CORNER, "Timing", f"Cycle at lower tolerance limit {lo_b} ms", payload=base, cycle=lo_b,
              expected="Frames accepted; values processed; no timing/timeout error; no DTC.", trace=tr)
        T.add("TIM.TOL_HIGH", CORNER, "Timing", f"Cycle at upper tolerance limit {hi_b} ms", payload=base, cycle=hi_b,
              expected="Frames accepted; values processed; no timeout; no DTC.", trace=tr)
        fast = max(res, lo_b - res)
        tol_txt = f"{cfg.cycle_tol_pct:g} %"
        T.add("TIM.FAST_VIOLATION", NEG, "Timing", f"Cycle {fast} ms – faster than tolerance", payload=base,
              cycle=fast, violation=V_FAST,
              why=(f"Interval {fast} ms is below the lower tolerance limit {lo_b} ms (GenMsgCycleTime {cyc} ms "
                   f"− {tol_txt})."),
              expected=("All frames processed without overload/queue overflow; values correct; no false timeout. "
                        "If Rx cycle monitoring is specified → deviation reported."), trace=tr)
        slow = hi_b + res
        exp = ("No timeout as long as interval < timeout; values processed. If Rx cycle monitoring is specified → "
               "deviation reported.")
        if min_to and slow >= min_to:
            exp = f"Interval {slow} ms ≥ timeout {min_to} ms → timeout reaction expected between frames."
        T.add("TIM.SLOW_VIOLATION", NEG, "Timing", f"Cycle {slow} ms – slower than tolerance", payload=base,
              cycle=slow, expected=exp, trace=tr, violation=V_SLOW,
              why=(f"Interval {slow} ms is above the upper tolerance limit {hi_b} ms (GenMsgCycleTime {cyc} ms "
                   f"+ {tol_txt})."))
        T.add("TIM.JITTER", CORNER, "Timing", f"Alternating {lo_b}/{hi_b} ms intervals (max jitter)", payload=base,
              tx_mode="JITTER", cycle=f"{lo_b}/{hi_b}",
              expected="Jitter inside tolerance tolerated: no timeout, no error, values processed.", trace=tr)
        T.add("TIM.BURST", NEG, "Timing", f"Burst of {cfg.burst_count} back-to-back frames", payload=base,
              tx_mode="BURST", cycle="-", violation=V_BURST,
              why=(f"{cfg.burst_count} frames sent back-to-back (minimum inter-frame space) instead of one frame "
                   f"every {cyc} ms."),
              expected=("DUT handles burst: last value applied, no Rx buffer overflow side effects, no reset, "
                        "no DTC."), trace=tr)

    # ── RX: timeout ─────────────────────────────────────────────────────
    def _rx_timeout_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m, res = ctx.msg, max(1, self.cfg.time_res_ms)
        tos = self.timeouts_of(m)
        if not tos:
            T.na("TO.TIMEOUT", "Timeout", "Reception timeout", "No GenSigTimeoutTime and no cycle time",
                 violation=V_TO_GAP)
            return
        base = ctx.build()
        subs = []
        for s in m.signals:
            tv = s.attr("GenSigTimeoutValue")
            if s.has_explicit("GenSigTimeoutValue") and tv is not None:
                subs.append(f"{s.name}={dec_str(s.phys(tv)) if not s.is_float else tv}")
        sub_txt = ("substitute values " + shorten(subs)) if subs else "timeout/substitute or last-valid values per Com config"
        for to, (names, src) in tos.items():
            sigs = shorten(names)
            tr = f"Timeout {to} ms from {src}; signals: {sigs}"
            T.add(f"TO.BELOW_{to}", CORNER, "Timeout", f"Transmission gap {to - res} ms (just below timeout {to} ms)",
                  payload=base, tx_mode="GAP", gap=to - res,
                  expected=f"No timeout reaction for {sigs}; values stay valid; no DTC.", trace=tr)
            T.add(f"TO.AT_{to}", CORNER, "Timeout", f"Transmission gap exactly {to} ms (timeout boundary)",
                  payload=base, tx_mode="GAP", gap=to,
                  expected=("Boundary: record detection. Timeout may be reported only within [timeout, timeout + one "
                            "DUT Rx task period]; no earlier detection."), trace=tr)
            T.add(f"TO.ABOVE_{to}", NEG, "Timeout", f"Transmission gap {to + res} ms (just above timeout {to} ms)",
                  payload=base, tx_mode="GAP", gap=to + res, violation=V_TO_GAP,
                  why=f"Reception gap {to + res} ms exceeds the Rx timeout {to} ms ({src}) by {res} ms.",
                  expected=(f"Timeout detected for {sigs} (tolerance one DUT Rx task period); {sub_txt}; recovers "
                            f"after transmission resumes."), trace=tr)
            T.add(f"TO.STOP_{to}", NEG, "Timeout", f"Message stopped permanently (timeout {to} ms)", payload=base,
                  tx_mode="STOP", gap=to * 3, violation=V_TO_STOP,
                  why=f"Transmission stops permanently; the Rx timeout {to} ms ({src}) elapses.",
                  expected=(f"Timeout reaction for {sigs}: {sub_txt}; Rx-timeout flag/DTC set per spec; no reset."),
                  trace=tr)
            T.add(f"TO.RECOVERY_{to}", PASS, "Timeout", f"Recovery after timeout ({to} ms)", payload=base,
                  tx_mode="GAP", gap=to * 2,
                  expected=("After transmission resumes: values valid within ≤ 2 cycles, timeout status cleared, "
                            "DTC healed/aging per spec."), trace=tr)
        max_to = max(tos)
        T.add("TO.STARTUP", NEG, "Timeout", "Message never received after DUT start-up", payload=None,
              tx_mode="NONE", gap=max_to * 3, violation=V_TO_START,
              why=(f"{m.name} is never sent after DUT start-up; the first-reception timeout (up to {max_to} ms) "
                   f"elapses."),
              expected=("Start-up (first) timeout reaction: initial/substitute values used, Rx-timeout status and DTC "
                        "per spec (AUTOSAR ComFirstTimeout); no reset."),
              trace=f"Max timeout {max_to} ms")

    # ── RX: event / spontaneous ─────────────────────────────────────────
    def _rx_event_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m = ctx.msg
        if not m.is_spontaneous:
            return
        base = ctx.build()
        st = m.send_type
        T.add("EVT.SINGLE", PASS, "Event", "Single spontaneous frame", payload=base, tx_mode="SINGLE",
              expected="DUT processes the event frame immediately; values applied; no error.",
              trace=f"GenMsgSendType = {st}")
        T.add("EVT.REPEAT", CORNER, "Event", "Identical event frame repeated 3x", payload=base, tx_mode="BURST",
              reps=3, expected=("Idempotent processing: edge-triggered functions fire once only; no error."),
              trace=f"GenMsgSendType = {st}")
        delay = pos_int(m.attr("GenMsgDelayTime"))
        if delay:
            alt = self._alternate_payload(ctx)
            res = max(1, self.cfg.time_res_ms)
            T.add("EVT.MIN_DELAY", CORNER, "Event", f"Two different event frames {delay} ms apart (GenMsgDelayTime)",
                  payload=[base, alt], tx_mode="SEQUENCE", cycle=delay,
                  expected="Both frames processed in order; final value = second frame.",
                  trace=f"GenMsgDelayTime = {delay} ms")
            if delay - res > 0:
                T.add("EVT.BELOW_DELAY", NEG, "Event", f"Two event frames {delay - res} ms apart (< GenMsgDelayTime)",
                      payload=[base, alt], tx_mode="SEQUENCE", cycle=delay - res, violation=V_EVT,
                      why=(f"Two event frames {delay - res} ms apart, shorter than the minimum gap "
                           f"GenMsgDelayTime = {delay} ms."),
                      expected="Robust reception: both processed or last value applied; no error, no reset.",
                      trace=f"GenMsgDelayTime = {delay} ms")

    def _alternate_payload(self, ctx: MsgContext) -> bytearray:
        for s in ctx.msg.signals:
            if s.is_float or not ctx.fits[s.name] or s.is_switch or s.mux_parent:
                continue
            b = ctx.bounds[s.name]
            cur = ctx.base[s.name]
            for cand in (b.r_pmax, b.r_pmin, (b.lo + b.hi) // 2):
                if b.ok(cand) and cand != cur:
                    return ctx.build({s.name: cand})
        return ctx.build()

    # ── RX: per-signal ──────────────────────────────────────────────────
    def _rx_signal_tests(self, T: TcBuilder, ctx: MsgContext, s: Signal) -> None:
        if not ctx.fits[s.name]:
            T.na(f"SIG.{s.name}", "Range", f"{s.name}: all signal tests",
                 "Signal bit positions exceed the message length – DBC layout error (see DBC_Audit)", signal=s,
                 violation=V_DBC)
            return
        if s.is_float:
            self._rx_float_tests(T, ctx, s)
            return
        b = ctx.bounds[s.name]
        if s.factor == 0 or not b.valid:
            T.na(f"SIG.{s.name}", "Range", f"{s.name}: range tests", "; ".join(b.notes), signal=s, violation=V_DBC)
            return
        sel = ctx.chain_selection(s)
        u = f" {s.unit}" if s.unit else ""
        tr = (f"{s.ref} {s.name}: {s.start}|{s.length}@{s.byte_order} {s.value_type}, ({dec_str(s.factor)},"
              f"{dec_str(s.offset)}) [{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}")
        if b.notes:
            tr += " | " + "; ".join(b.notes)

        def add(code: str, cat: str, title: str, raw: int, expected: str, group: str = "Range", **kw: Any) -> None:
            T.add(f"SIG.{s.name}.{code}", cat, group, f"{s.name}: {title}", signal=s, raw=raw,
                  payload=kw.pop("payload", None) or ctx.build({s.name: raw}, sel), expected=expected, trace=tr,
                  sel=sel, **kw)

        ok_exp = lambda r: (f"DUT decodes {s.name} = {ctx.fmt(s, r)}; value processed by the application; no error/"
                            f"DTC; no reset.")
        # initial value
        r0 = ctx.dbc_init[s.name]
        seen: Set[int] = set()
        if b.ok(r0):
            add("INIT", PASS, f"initial value (GenSigStartValue) {dec_str(s.phys(r0))}{u}", r0, ok_exp(r0))
            seen.add(r0)
        elif b.in_type(r0):
            add("INIT", SPECIAL, f"DBC initial value {dec_str(s.phys(r0))}{u} is outside min/max", r0,
                f"DBC inconsistency: initial value {ctx.fmt(s, r0)} violates [{dec_str(s.minimum)}|"
                f"{dec_str(s.maximum)}]. DUT shall handle it as specified (invalid/substitute); clarify with DBC owner.",
                violation=V_INIT,
                why=(f"GenSigStartValue raw {r0} = {dec_str(s.phys(r0))}{u} lies outside the DBC range "
                     f"[{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}."))
        # valid range corners
        zero_x = (Decimal(0) - s.offset) / s.factor
        zero = int(zero_x) if zero_x == zero_x.to_integral_value() else None
        mid = (b.lo + b.hi) // 2
        cands = [("MIN", CORNER, b.r_pmin, "exactly physical minimum"),
                 ("MIN_PLUS_1LSB", CORNER, b.r_pmin + b.step, "minimum + 1 LSB"),
                 ("MID", PASS, mid, "mid-range value"),
                 ("MAX_MINUS_1LSB", CORNER, b.r_pmax - b.step, "maximum − 1 LSB"),
                 ("MAX", CORNER, b.r_pmax, "exactly physical maximum"),
                 ("ZERO", PASS, zero, "physical zero")]
        corner_seen: Set[int] = set()
        for code, cat, raw, label in cands:
            if raw is None or not b.ok(raw):
                continue
            # boundary corners are always tested (even if equal to the initial value);
            # MID / ZERO only when they add a new value
            if (cat == CORNER and raw in corner_seen) or (cat == PASS and (raw in seen or raw in corner_seen)):
                continue
            (corner_seen if cat == CORNER else seen).add(raw)
            add(code, cat, f"{label} = {dec_str(s.phys(raw))}{u}", raw, ok_exp(raw))
        # out of range
        rng = f"[{dec_str(s.phys(b.r_pmin))}|{dec_str(s.phys(b.r_pmax))}]{u}"
        neg_exp = lambda r, why: (f"{s.name} = {ctx.fmt(s, r)} is {why} {rng}. DUT shall detect the invalid value: "
                                  f"apply substitute/default or keep last valid value per SW spec, set invalid "
                                  f"qualifier/DTC if specified; no unintended function; no reset.")
        below, above = b.r_pmin - b.step, b.r_pmax + b.step
        negs: Set[int] = set()
        for code, raw, why, lbl in (("BELOW_MIN", below, "below", "minimum − 1 LSB"),
                                    ("ABOVE_MAX", above, "above", "maximum + 1 LSB")):
            if b.defined and b.in_type(raw):
                label_txt = f" ('{s.choices[raw]}')" if raw in s.choices else ""
                cat = SPECIAL if (raw in s.choices and self.special_re.search(s.choices[raw])) else NEG
                lim = s.minimum if why == "below" else s.maximum
                add(code, cat, f"{lbl} = {dec_str(s.phys(raw))}{u}{label_txt}", raw, neg_exp(raw, f"{why}"),
                    violation=V_BELOW if why == "below" else V_ABOVE,
                    why=(f"{s.name} raw {raw} = {dec_str(s.phys(raw))}{u} is 1 LSB ({dec_str(abs(s.factor))}{u}) "
                         f"{why} the DBC {'minimum' if why == 'below' else 'maximum'} {dec_str(lim)}{u}; valid raw "
                         f"range {b.lo}…{b.hi}."))
                negs.add(raw)
            else:
                reason = ("Min/Max undefined in DBC – whole raw range is valid" if not b.defined else
                          f"DBC {'minimum' if why == 'below' else 'maximum'} equals the raw type limit of the "
                          f"{s.length}-bit {s.value_type.lower()} signal – cannot be violated on the bus")
                T.na(f"SIG.{s.name}.{code}", "Range", f"{s.name}: {lbl}", reason, signal=s,
                     violation=V_BELOW if why == "below" else V_ABOVE)
        for code, raw in (("RAW_TYPE_MAX", b.tmax), ("RAW_TYPE_MIN", b.tmin)):
            if raw in negs or b.ok(raw) or raw in s.choices:
                continue
            negs.add(raw)
            add(code, NEG, f"raw type extreme {raw_hex(s, raw)} = {dec_str(s.phys(raw))}{u}", raw,
                neg_exp(raw, "outside"), violation=V_RAWEXT,
                why=(f"Raw {raw_hex(s, raw)} is the {'largest' if raw == b.tmax else 'smallest'} value the "
                     f"{s.length}-bit {s.value_type.lower()} field can hold; it decodes to {dec_str(s.phys(raw))}{u}, "
                     f"outside [{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}."))
        # enums / special values
        self._rx_enum_tests(T, ctx, s, b, sel, add, ok_exp)
        # layout
        if self.cfg.include_layout:
            self._rx_signal_layout_tests(T, ctx, s, b, sel, tr)
        if self.cfg.include_bitwalk:
            for k in range(s.length):
                raw = unsigned_to_raw(s, 1 << k)
                pos = bits_of(s)[k]
                cat = CORNER if b.ok(raw) else NEG
                add(f"BITWALK_{k}", cat, f"bit-walk: only bit {k} set ({bitpos_str(pos)})", raw,
                    ok_exp(raw) if cat == CORNER else neg_exp(raw, "outside"), group="Layout",
                    violation=V_BITWALK if cat == NEG else "",
                    why=(f"Only bit {k} set → raw {raw} = {dec_str(s.phys(raw))}{u}, outside the valid raw range "
                         f"{b.lo}…{b.hi}." if cat == NEG else ""))

    def _rx_enum_tests(self, T: TcBuilder, ctx: MsgContext, s: Signal, b: RawBounds, sel: Dict[str, int],
                       add: Callable[..., None], ok_exp: Callable[[int], str]) -> None:
        cfg = self.cfg
        u = f" {s.unit}" if s.unit else ""
        iv = s.attr("GenSigInactiveValue")
        ivr: Optional[int] = None
        if iv is not None and (s.has_explicit("GenSigInactiveValue") or pos_int(iv)):
            try:
                ivr = int(Decimal(str(iv)))
            except (InvalidOperation, ValueError):
                ivr = None
        if s.choices:
            items = sorted(s.choices.items())
            for raw, label in items[:cfg.max_enum_cases]:
                if not b.in_type(raw):
                    continue
                also = " – also GenSigInactiveValue" if raw == ivr else ""
                out = not b.ok(raw)
                out_why = (f"Value-table entry raw {raw} '{label}' decodes to {dec_str(s.phys(raw))}{u}, outside "
                           f"[{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}." if out else "")
                if self.special_re.search(label):
                    add(f"ENUM_{raw}", SPECIAL, f"special value '{label}' (raw {raw}){also}", raw,
                        (f"DUT applies the defined reaction for '{label}' (e.g. signal not available / invalid "
                         f"handling, substitute value); no unintended function; no reset."), group="Enum/Special",
                        violation=V_SPECIAL_RANGE if out else "", why=out_why)
                elif b.ok(raw):
                    add(f"ENUM_{raw}", PASS, f"state '{label}' (raw {raw})", raw,
                        f"DUT interprets {s.name} as state '{label}'; corresponding function behaviour; no error.",
                        group="Enum/Special")
                else:
                    add(f"ENUM_{raw}", SPECIAL, f"state '{label}' (raw {raw}) outside DBC min/max", raw,
                        (f"DBC defines '{label}' outside [{dec_str(s.minimum)}|{dec_str(s.maximum)}]: DUT shall "
                         f"apply the specified handling for '{label}'; clarify range with DBC owner."),
                        group="Enum/Special", violation=V_SPECIAL_RANGE, why=out_why)
            undefined: List[int] = []
            in_range = sum(1 for r in s.choices if b.ok(r))
            enum_like = in_range >= 2 and (b.hi - b.lo + 1) <= max(16, 4 * in_range)
            span = range(b.lo, min(b.hi, b.lo + 65536) + 1) if enum_like else range(0)
            for r in span:
                if r not in s.choices:
                    undefined.append(r)
                    break
            for r in (range(b.hi, max(b.lo, b.hi - 65536) - 1, -1) if enum_like else range(0)):
                if r not in s.choices:
                    if r not in undefined:
                        undefined.append(r)
                    break
            for r in undefined:
                add(f"ENUM_UNDEFINED_{r}", NEG, f"undefined state raw {r} (no value-table entry)", r,
                    (f"Raw {r} has no defined meaning: DUT shall treat {s.name} as invalid/unknown state "
                     f"(substitute or last valid), no unintended function; no reset."), group="Enum/Special",
                    violation=V_ENUM,
                    why=(f"Raw {r} lies inside the valid range {b.lo}…{b.hi} but has no value-table entry (defined: "
                         f"{shorten([f'{k}={v}' for k, v in sorted(s.choices.items())], 6)})."))
        if ivr is not None and ivr not in s.choices:
            if b.in_type(ivr):
                add("INACTIVE_VALUE", SPECIAL, f"GenSigInactiveValue raw {ivr} = {dec_str(s.phys(ivr))}{u}", ivr,
                    (f"DUT treats {s.name} as inactive / not requested (GenSigInactiveValue); no function "
                     f"triggered; no error."), group="Enum/Special",
                    violation="" if b.ok(ivr) else V_SPECIAL_RANGE,
                    why="" if b.ok(ivr) else (f"GenSigInactiveValue raw {ivr} decodes to {dec_str(s.phys(ivr))}{u}, "
                                              f"outside [{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}."))
        if self.is_j1939(ctx.msg) and s.length in J1939_SPECIALS and not s.is_signed and not s.choices:
            err, na = J1939_SPECIALS[s.length]
            for code, raw, lbl in (("J1939_ERROR", err, "error indicator"), ("J1939_NOT_AVAILABLE", na, "not available")):
                add(code, SPECIAL, f"J1939 {lbl} raw {raw_hex(s, raw)}", raw,
                    (f"J1939-71 '{lbl}' value: DUT shall not use {s.name} as a valid measurement; apply "
                     f"{lbl} handling (substitute/default), no DTC unless specified; no reset."),
                    group="Enum/Special", violation="" if b.ok(raw) else V_SPECIAL_RANGE,
                    why="" if b.ok(raw) else (f"J1939 {lbl} raw {raw_hex(s, raw)} decodes to "
                                              f"{dec_str(s.phys(raw))}{u}, outside [{dec_str(s.minimum)}|"
                                              f"{dec_str(s.maximum)}]{u}."))

    def _rx_signal_layout_tests(self, T: TcBuilder, ctx: MsgContext, s: Signal, b: RawBounds,
                                sel: Dict[str, int], tr: str) -> None:
        n = s.length
        bits = bits_of(s)
        u = f" {s.unit}" if s.unit else ""

        def add(code: str, cat: str, title: str, raw: Any, payload: bytearray, expected: str, **kw: Any) -> None:
            T.add(f"SIG.{s.name}.{code}", cat, "Layout", f"{s.name}: {title}", signal=s, raw=raw, payload=payload,
                  expected=expected, trace=tr, sel=sel, **kw)

        rng = f"[{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}"

        dec_exp = lambda r: f"DUT decodes {s.name} = {ctx.fmt(s, r)} exactly"
        if n > 1 and b.ok(1):
            add("LSB_CHECK", CORNER, f"start-bit check – only LSB set ({bitpos_str(bits[0])})", 1,
                ctx.build({s.name: 1}, sel), dec_exp(1) + " (verifies start bit / LSB position).")
        msb_raw = unsigned_to_raw(s, 1 << (n - 1))
        if n > 1:
            if b.ok(msb_raw):
                add("MSB_CHECK", CORNER, f"end-bit check – only MSB set ({bitpos_str(bits[-1])})", msb_raw,
                    ctx.build({s.name: msb_raw}, sel), dec_exp(msb_raw) + " (verifies signal length / MSB position).")
            else:
                for k in range(n - 2, 0, -1):
                    r = unsigned_to_raw(s, 1 << k)
                    if b.ok(r):
                        add("HIGH_BIT_CHECK", CORNER, f"highest in-range single bit {k} set ({bitpos_str(bits[k])})",
                            r, ctx.build({s.name: r}, sel), dec_exp(r) + " (verifies upper bit mapping).")
                        break
        ones = unsigned_to_raw(s, (1 << n) - 1)
        p1 = ctx.build({s.name: ones}, sel, fill=0x00, use_base=False)
        add("ISOLATION_ONES", CORNER if b.ok(ones) else NEG, "signal bits all 1, every other bit 0", ones, p1,
            f"{dec_exp(ones)}{'' if b.ok(ones) else ' (out of range → invalid handling)'}; neighbouring signals decode "
            f"as raw 0 – no bit leakage across signal boundaries.", violation="" if b.ok(ones) else V_ISO,
            why="" if b.ok(ones) else (f"All {n} signal bits = 1 → raw {raw_hex(s, ones)} = {dec_str(s.phys(ones))}{u}, "
                                       f"outside the DBC range {rng}."))
        p0 = ctx.build({s.name: 0}, sel, fill=0xFF, use_base=False)
        add("ISOLATION_ZEROS", CORNER if b.ok(0) else NEG, "signal bits all 0, every other bit 1", 0, p0,
            f"{dec_exp(0)}{'' if b.ok(0) else ' (out of range → invalid handling)'}; ones in adjacent bits must not "
            f"influence {s.name}.", violation="" if b.ok(0) else V_ISO,
            why="" if b.ok(0) else f"All {n} signal bits = 0 → raw 0 = {dec_str(s.phys(0))}{u}, outside the DBC range {rng}.")
        pattern = self._asym_pattern(s, b)
        if n > 8 and pattern is not None:
            add("BYTE_ORDER_PATTERN", PASS, f"asymmetric byte pattern {raw_hex(s, pattern)} ({s.byte_order})",
                pattern, ctx.build({s.name: pattern}, sel),
                dec_exp(pattern) + " – a byte-order error in the DUT would show the byte-swapped value.")
            sw = byteswap_raw(s, pattern)
            add("BYTE_SWAP", NEG, f"value {raw_hex(s, pattern)} sent with reversed byte order ({raw_hex(s, sw)})",
                sw, ctx.build({s.name: sw}, sel),
                (f"Sender endianness error simulated: DUT must decode {ctx.fmt(s, sw)} (per DBC {s.byte_order}), NOT "
                 f"{dec_str(s.phys(pattern))}{u}; {'out of range → invalid handling; ' if not b.ok(sw) else ''}"
                 f"no reset."), violation=V_ENDIAN,
                why=(f"Raw {raw_hex(s, pattern)} is transmitted with its bytes in reverse order ({raw_hex(s, sw)}); "
                     f"the DBC defines {s.byte_order} ({'little' if s.byte_order == 'Intel' else 'big'}-endian) "
                     f"byte order."))
        shifted = shifted_signal(s, ctx.nbits)
        test_raw = pattern if pattern is not None else ((b.lo + b.hi) // 2)
        if shifted is not None and b.ok(test_raw):
            data = ctx.build({s.name: test_raw}, sel)
            encode_into(data, s, 0)
            encode_into(data, shifted, test_raw)
            got = decode_from(data, s)
            T.add(f"SIG.{s.name}.BIT_SHIFT", NEG, "Layout", f"{s.name}: value {raw_hex(s, test_raw)} placed 1 bit off",
                  signal=s, raw=got, intended=s.phys(test_raw), payload=data, sel=sel, trace=tr, violation=V_SHIFT,
                  why=(f"Signal written starting at bit {shifted.start} instead of the DBC start bit {s.start} "
                       f"(1-bit offset); a DBC-correct receiver decodes raw {got} instead of {test_raw}."),
                  expected=(f"Layout mismatch simulated: DUT decodes {ctx.fmt(s, got)} instead of "
                            f"{dec_str(s.phys(test_raw))}{u}; adjacent signal may be disturbed → range/plausibility "
                            f"handling; no reset."))

    @staticmethod
    def _asym_pattern(s: Signal, b: RawBounds) -> Optional[int]:
        n = s.length
        nb = (n + 7) // 8
        if nb < 2:
            return None
        p = int.from_bytes(bytes(range(1, nb + 1)), "big") & ((1 << n) - 1)
        cands = [unsigned_to_raw(s, p), b.lo + (b.hi - b.lo) // 3, b.lo + 2 * (b.hi - b.lo) // 3, b.hi - 1, b.lo + 1]
        for c in cands:
            if b.ok(c) and byteswap_raw(s, c) != c:
                return c
        return None

    def _rx_float_tests(self, T: TcBuilder, ctx: MsgContext, s: Signal) -> None:
        sel = ctx.chain_selection(s)
        u = f" {s.unit}" if s.unit else ""
        defined = not (s.minimum == 0 and s.maximum == 0)
        tr = (f"{s.ref} {s.name}: {s.start}|{s.length}@{s.byte_order} {s.value_type}, ({dec_str(s.factor)},"
              f"{dec_str(s.offset)}) [{dec_str(s.minimum)}|{dec_str(s.maximum)}]{u}")
        f32 = s.float_kind == 1

        def raw_of(p: Decimal) -> float:
            return float((p - s.offset) / s.factor) if s.factor != 0 else float(p)

        def add(code: str, cat: str, title: str, raw: float, expected: str, **kw: Any) -> None:
            T.add(f"SIG.{s.name}.{code}", cat, "Range", f"{s.name}: {title}", signal=s, raw=raw,
                  payload=ctx.build({s.name: raw}, sel), expected=expected, trace=tr, sel=sel, **kw)

        ok = lambda r: f"DUT decodes {s.name} = {dec_str(s.phys(r))}{u} (IEEE {'float32' if f32 else 'double'}); processed; no error."
        bad = lambda what: f"{what}: DUT shall reject the value (invalid/substitute per spec), no exception/trap, no reset."
        add("INIT", PASS, "initial value", ctx.dbc_init[s.name], ok(ctx.dbc_init[s.name]))
        if defined:
            span = s.maximum - s.minimum
            delta = span * Decimal("0.01") if span else Decimal(1)
            for code, cat, p in (("MIN", CORNER, s.minimum), ("MID", PASS, (s.minimum + s.maximum) / 2),
                                 ("MAX", CORNER, s.maximum)):
                add(code, cat, f"{code.lower()} = {dec_str(p)}{u}", raw_of(p), ok(raw_of(p)))
            add("BELOW_MIN", NEG, f"min − 1 % of range = {dec_str(s.minimum - delta)}{u}", raw_of(s.minimum - delta),
                bad(f"{dec_str(s.minimum - delta)}{u} below min {dec_str(s.minimum)}"), violation=V_BELOW,
                why=(f"{dec_str(s.minimum - delta)}{u} is below the DBC minimum {dec_str(s.minimum)}{u} by 1 % of "
                     f"the range."))
            add("ABOVE_MAX", NEG, f"max + 1 % of range = {dec_str(s.maximum + delta)}{u}", raw_of(s.maximum + delta),
                bad(f"{dec_str(s.maximum + delta)}{u} above max {dec_str(s.maximum)}"), violation=V_ABOVE,
                why=(f"{dec_str(s.maximum + delta)}{u} is above the DBC maximum {dec_str(s.maximum)}{u} by 1 % of "
                     f"the range."))
        add("NEG_ZERO", CORNER, "negative zero (-0.0)", -0.0, "DUT treats -0.0 as 0; no error.")
        add("DENORMAL", CORNER, "smallest denormal", 1.401298464324817e-45 if f32 else 5e-324,
            "Denormal handled without FPU exception; value ≈ 0.")
        add("NAN", NEG, "NaN", float("nan"), bad("NaN received"), violation=V_FLOAT,
            why="IEEE-754 NaN (not a number) is never a valid physical value.")
        add("POS_INF", NEG, "+Infinity", float("inf"), bad("+Inf received"), violation=V_FLOAT,
            why="IEEE-754 +Infinity is not a finite physical value.")
        add("NEG_INF", NEG, "-Infinity", float("-inf"), bad("-Inf received"), violation=V_FLOAT,
            why="IEEE-754 -Infinity is not a finite physical value.")
        fmax = 3.4028234663852886e38 if f32 else 1.7976931348623157e308
        add("TYPE_MAX", NEG if defined else CORNER, "largest finite value", fmax,
            bad("Largest finite value") if defined else ok(fmax), violation=V_ABOVE if defined else "",
            why=(f"Largest finite IEEE value {fmax:g} is far above the DBC maximum {dec_str(s.maximum)}{u}."
                 if defined else ""))

    # ── RX: multiplexing ───────────────────────────────────────────────
    def _rx_mux_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        for sw in ctx.switches:
            groups = ctx.mux_map.get(sw.name, {})
            if not groups or not ctx.fits[sw.name]:
                continue
            chain = ctx.chain_selection(sw)
            vals = sorted(groups)
            for v in vals[:self.cfg.max_enum_cases]:
                sel = dict(chain)
                sel[sw.name] = v
                names = [x.name for x in groups[v]]
                T.add(f"MUX.{sw.name}.{v}", PASS, "Multiplex", f"Multiplexor {sw.name} = {v}", signal=sw, raw=v,
                      payload=ctx.build({}, sel), sel=sel,
                      expected=(f"DUT decodes multiplexed group {sw.name}={v} ({shorten(names)}) with initial values; "
                                f"signals of other multiplexor values are NOT updated."))
            b = ctx.bounds.get(sw.name)
            undef = None
            if b:
                for r in range(b.tmin, min(b.tmax, b.tmin + 65536) + 1):
                    if r not in groups:
                        undef = r
                        break
            if undef is None:
                T.na(f"MUX.{sw.name}.UNDEFINED", "Multiplex", f"Undefined multiplexor value of {sw.name}",
                     "Every raw value of the multiplexor selects a defined group", violation=V_MUX)
            else:
                sel = dict(chain)
                sel[sw.name] = undef
                T.add(f"MUX.{sw.name}.UNDEFINED", NEG, "Multiplex", f"Undefined multiplexor value {sw.name} = {undef}",
                      signal=sw, raw=undef, payload=ctx.build({sw.name: undef}, sel), sel=sel, violation=V_MUX,
                      why=(f"{sw.name} = {undef} selects no multiplexed group (defined values: "
                           f"{shorten([str(v) for v in vals], 10)})."),
                      expected=("DUT ignores the multiplexed part (no update of any multiplexed signal); "
                                "non-multiplexed signals processed normally; no error/reset."))
            if len(vals) >= 2:
                a, c = vals[0], vals[1]
                seq = [ctx.build({}, {**chain, sw.name: a}), ctx.build({}, {**chain, sw.name: c})]
                T.add(f"MUX.{sw.name}.TOGGLE", CORNER, "Multiplex", f"Multiplexor toggles {a}↔{c} every frame",
                      signal=sw, payload=seq, tx_mode="SEQUENCE", reps=10,
                      expected=("Each group updated only by frames carrying its multiplexor value; no cross-"
                                "contamination; group-specific timeouts not triggered."))

    # ── RX: E2E counter / CRC ──────────────────────────────────────────
    def _rx_e2e_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        for s in ctx.msg.signals:
            if s.is_float or not ctx.fits[s.name] or s.is_switch:
                continue
            b = ctx.bounds[s.name]
            if not b.valid:
                continue
            sel = ctx.chain_selection(s)
            seq = lambda vals: [ctx.build({s.name: v}, sel) for v in vals]
            tr = f"{s.ref} {s.name} detected by name as E2E/alive {'counter' if self.counter_re.search(s.name) else 'CRC'}"
            if self.counter_re.search(s.name) and not self.crc_re.search(s.name) and b.hi - b.lo >= 3:
                lo, hi = b.lo, b.hi
                note = "Combine with valid CRC per E2E profile if the message is E2E protected."
                T.add(f"E2E.{s.name}.INCREMENT", PASS, "E2E/Counter", f"{s.name}: increments by 1 each frame",
                      signal=s, raw=lo, payload=seq([lo, lo + 1, lo + 2, lo + 3]), tx_mode="SEQUENCE", reps=5,
                      sel=sel, trace=tr, note=note, expected="Counter check OK (E2E status OK); data accepted.")
                T.add(f"E2E.{s.name}.WRAP", CORNER, "E2E/Counter", f"{s.name}: wrap-around {hi}→{lo}", signal=s,
                      raw=hi - 1, payload=seq([hi - 1, hi, lo, lo + 1]), tx_mode="SEQUENCE", sel=sel, trace=tr,
                      note=note, expected=f"Wrap from {hi} to {lo} accepted as a valid increment; no error.")
                T.add(f"E2E.{s.name}.FREEZE", NEG, "E2E/Counter", f"{s.name}: frozen (repeated value)", signal=s,
                      raw=lo + 1, payload=seq([lo + 1] * 5), tx_mode="SEQUENCE", sel=sel, trace=tr, note=note,
                      violation=V_CNT_FREEZE,
                      why=f"{s.name} repeats value {lo + 1} for 5 frames; an alive counter must change by +1 every frame.",
                      expected=("Repeated counter detected (E2E REPEATED / alive failure); after configured "
                                "debounce data rejected → substitute value, DTC per spec; no reset."))
                T.add(f"E2E.{s.name}.JUMP", NEG, "E2E/Counter", f"{s.name}: skips one value (+2)", signal=s,
                      raw=lo, payload=seq([lo, lo + 2, lo + 4]), tx_mode="SEQUENCE", sel=sel, trace=tr,
                      note=note, violation=V_CNT_JUMP,
                      why=f"{s.name} goes {lo}→{lo + 2}→{lo + 4}: one value skipped each frame (delta 2 instead of 1).", expected=("Counter jump evaluated against MaxDeltaCounter: OK-SOME-LOST or "
                                           "WRONG-SEQUENCE per E2E configuration; reaction per spec."))
                T.add(f"E2E.{s.name}.BACKWARDS", NEG, "E2E/Counter", f"{s.name}: decrements", signal=s, raw=lo + 2,
                      payload=seq([lo + 2, lo + 1]), tx_mode="SEQUENCE", sel=sel, trace=tr, note=note,
                      violation=V_CNT_BACK, why=f"{s.name} goes {lo + 2}→{lo + 1}: the counter decrements.",
                      expected="Counter decrement detected as wrong sequence; data rejected per spec; no reset.")
                if b.tmax > hi:
                    T.add(f"E2E.{s.name}.INVALID", NEG, "E2E/Counter", f"{s.name}: value {b.tmax} outside {lo}…{hi}",
                          signal=s, raw=b.tmax, payload=seq([b.tmax]), tx_mode="SEQUENCE", sel=sel, trace=tr,
                          violation=V_CNT_INV,
                          why=f"Counter value {b.tmax} lies outside the DBC counter range {lo}…{hi}.",
                          note=note, expected="Invalid counter value rejected (E2E ERROR); data not used; no reset.")
            elif self.crc_re.search(s.name):
                init = ctx.base[s.name]
                mask = (1 << s.length) - 1
                note = ("Sender must compute the CRC per E2E profile (polynomial, Data ID, start value) for every "
                        "frame – Payload shows the CRC field at its initial value.")
                T.add(f"E2E.{s.name}.VALID", PASS, "E2E/CRC", f"{s.name}: correct CRC on every frame", signal=s,
                      raw=init, payload=ctx.build({}, sel), sel=sel, trace=tr, note=note,
                      expected="CRC check OK; data accepted; no E2E error.")
                bad = unsigned_to_raw(s, (int(init) ^ mask) & mask)
                T.add(f"E2E.{s.name}.CORRUPTED", NEG, "E2E/CRC", f"{s.name}: CRC inverted", signal=s, raw=bad,
                      payload=ctx.build({s.name: bad}, sel), sel=sel, trace=tr,
                      note="Compute the valid CRC, then invert all CRC bits before sending.", violation=V_CRC_BAD,
                      why=f"{s.name} carries the bit-inverse of the correct CRC – checksum does not match the data.",
                      expected=("CRC error detected (E2E ERROR); frame data discarded → last valid/substitute value; "
                                "error counter/DTC per spec; no reset."))
                T.add(f"E2E.{s.name}.STATIC", NEG, "E2E/CRC", f"{s.name}: CRC not updated while data changes",
                      signal=s, raw=init, payload=[ctx.build({}, sel), self._alternate_payload(ctx)],
                      tx_mode="SEQUENCE", sel=sel, trace=tr, note="Keep CRC of first frame unchanged for the second.",
                      violation=V_CRC_STATIC,
                      why=f"Data changes in frame 2 but {s.name} keeps the CRC of frame 1.",
                      expected="CRC mismatch on changed data detected; data discarded; no reset.")

    # ── RX: message-level layout ───────────────────────────────────────
    def _rx_msg_layout_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m = ctx.msg
        if ctx.unused_bits:
            data = ctx.build()
            for p in ctx.unused_bits:
                data[p >> 3] |= 1 << (p & 7)
            T.add("LAY.UNUSED_BITS_ONES", CORNER, "Layout", f"All {len(ctx.unused_bits)} unused bits set to 1",
                  payload=data,
                  expected=("Unused/reserved bits ignored: all signals decode to initial values; no error, no DTC."),
                  trace="Unused bits: " + shorten([bitpos_str(p) for p in ctx.unused_bits], 12))
        for code, fill in (("LAY.ALL_00", 0x00), ("LAY.ALL_FF", 0xFF)):
            data = bytearray([fill] * m.length)
            dec = ctx.decode_all(data)
            bad = [s.name for s, _r, ok in dec if not ok]
            vals = [f"{s.name}={dec_str(s.phys(r))}" for s, r, _ok in dec]
            T.add(code, NEG if bad else CORNER, "Layout", f"Payload all 0x{fill:02X}", payload=data,
                  violation=V_PATTERN if bad else "",
                  why=(f"0x{fill:02X} in every byte puts {len(bad)} signal(s) outside min/max: {shorten(bad, 6)}."
                       if bad else ""),
                  expected=(f"Decoded: {shorten(vals, 10)}. "
                            + (f"Out of range: {shorten(bad)} → invalid handling for these; " if bad else "All in range; ")
                            + "other values processed; no reset."))

    # ── RX: combinations ───────────────────────────────────────────────
    def _rx_combination_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        sel = ctx.full_selection()
        sigs = [s for s in ctx.msg.signals if ctx.fits[s.name] and not s.is_switch and ctx.is_active(s, sel)
                and not s.is_float and ctx.bounds[s.name].valid and s.factor != 0]
        if len(sigs) < 2:
            return
        B = ctx.bounds
        combos = [("CMB.ALL_MIN", CORNER, "All signals at physical minimum", {s.name: B[s.name].r_pmin for s in sigs}),
                  ("CMB.ALL_MAX", CORNER, "All signals at physical maximum", {s.name: B[s.name].r_pmax for s in sigs}),
                  ("CMB.ALL_MID", PASS, "All signals at mid-range", {s.name: (B[s.name].lo + B[s.name].hi) // 2 for s in sigs}),
                  ("CMB.ALTERNATE", CORNER, "Alternating min/max per signal",
                   {s.name: (B[s.name].r_pmin if i % 2 == 0 else B[s.name].r_pmax) for i, s in enumerate(sigs)})]
        below = {s.name: B[s.name].r_pmin - B[s.name].step for s in sigs
                 if B[s.name].defined and B[s.name].in_type(B[s.name].r_pmin - B[s.name].step)}
        above = {s.name: B[s.name].r_pmax + B[s.name].step for s in sigs
                 if B[s.name].defined and B[s.name].in_type(B[s.name].r_pmax + B[s.name].step)}
        if len(below) >= 2:
            combos.append(("CMB.ALL_BELOW_MIN", NEG, f"{len(below)} signals below minimum simultaneously", below))
        if len(above) >= 2:
            combos.append(("CMB.ALL_ABOVE_MAX", NEG, f"{len(above)} signals above maximum simultaneously", above))
        for code, cat, title, vals in combos:
            txt = shorten([f"{k}={dec_str(ctx.by_name[k].phys(v))}" for k, v in vals.items()], 10)
            exp = (f"All values accepted and processed together: {txt}; no interaction error; no DTC." if cat != NEG
                   else f"Every listed signal detected invalid independently ({txt}); remaining signals valid; no reset.")
            T.add(code, cat, "Combination", title, payload=ctx.build(vals), expected=exp,
                  violation=V_COMBO if cat == NEG else "",
                  why=(f"{len(vals)} signals simultaneously 1 LSB {'below' if 'BELOW' in code else 'above'} their DBC "
                       f"limit in one frame: {txt}." if cat == NEG else ""))

    # ── TX: DUT transmits ──────────────────────────────────────────────
    def _tx_tests(self, T: TcBuilder, ctx: MsgContext) -> None:
        m, cfg = ctx.msg, self.cfg
        base = ctx.build()
        fr = f"{m.id_hex} ({m.id_format}, {m.frame_type}" + (f", BRS={'1' if m.brs else '0'}" if m.is_fd else "") + ")"
        T.add("TXV.ID_FORMAT", PASS, "Frame", "Identifier & frame format",
              expected=f"DUT transmits {m.name} on {fr} – IDE/FDF/BRS bits exactly as defined.")
        T.add("TXV.DLC", PASS, "Length/DLC", f"DLC = {m.dlc_code} ({m.length} B)",
              expected=f"Every frame has DLC {m.dlc_code} ({m.length} data bytes).")
        if m.cycle_time > 0:
            lo_b, hi_b = tol_bounds(m.cycle_time, cfg.cycle_tol_pct)
            T.add("TXV.CYCLE", PASS, "Timing", f"Cycle time {m.cycle_time} ms ±{cfg.cycle_tol_pct:g} %",
                  duration=max(cfg.stim_duration_ms, m.cycle_time * 100),
                  expected=(f"Mean interval ≈ {m.cycle_time} ms; every interval within [{lo_b}, {hi_b}] ms; no "
                            f"missing frames."))
            T.add("TXV.CYCLE_BUSLOAD", CORNER, "Timing", "Cycle time under high bus load (≥ 70 %)",
                  duration=max(cfg.stim_duration_ms, m.cycle_time * 100),
                  expected=f"Intervals stay within [{lo_b}, {hi_b}] ms (arbitration delays only), no frame lost.",
                  note="Generate background load with lower-priority IDs.")
        sd = pos_int(m.attr("GenMsgStartDelayTime"))
        T.add("TXV.STARTUP", PASS, "Timing", "First frame after start-up / wake-up",
              expected=(f"First frame within {sd} ms after DUT communication start (GenMsgStartDelayTime)." if sd else
                        "Record time of first frame after communication start (no GenMsgStartDelayTime in DBC)."))
        T.add("TXV.INIT_VALUES", PASS, "Init", "Initial signal values in first frames", payload=base,
              expected=("First frame(s) carry GenSigStartValue for all signals, i.e. Payload column (unused bits = "
                        f"0x{cfg.padding_byte:02X} padding)."))
        if m.is_spontaneous:
            delay = pos_int(m.attr("GenMsgDelayTime"))
            reps = pos_int(m.attr("GenMsgNrOfRepetition"))
            fast = pos_int(m.attr("GenMsgCycleTimeFast"))
            exp = "On a trigger event the frame is sent immediately"
            if reps:
                exp += f", followed by {reps} repetitions" + (f" every {fast} ms" if fast else "")
            if delay:
                exp += f"; consecutive event frames are ≥ {delay} ms apart (GenMsgDelayTime)"
            T.add("TXV.EVENT", PASS, "Event", f"Event transmission ({m.send_type})", expected=exp + ".",
                  note="Trigger by changing a DUT input that drives one of the signals.")
        if ctx.unused_bits:
            T.add("TXV.UNUSED_BITS", PASS, "Layout", f"{len(ctx.unused_bits)} unused bits",
                  expected=f"Unused bits always = padding value (0x{cfg.padding_byte:02X} → bits "
                           f"{'1' if cfg.padding_byte & 1 else '0'}), per ComTxIPduUnusedAreasDefault.",
                  trace="Unused bits: " + shorten([bitpos_str(p) for p in ctx.unused_bits], 12))
        T.add("TXV.SLEEP", CORNER, "Timing", "No transmission in bus-sleep / KL15 OFF",
              expected="After network shutdown (NM bus-sleep) no further frames are sent.")
        for s in m.signals:
            if not ctx.fits[s.name]:
                T.na(f"TXV.{s.name}", "Range", f"{s.name}: Tx checks", "Signal exceeds message length (DBC error)", s,
                     violation=V_DBC)
                continue
            sel = ctx.chain_selection(s)
            if s.is_float:
                T.add(f"TXV.{s.name}.RANGE", PASS, "Range", f"{s.name}: always finite and within min/max", signal=s,
                      sel=sel, expected=f"{s.name} never NaN/Inf; within [{dec_str(s.minimum)}|{dec_str(s.maximum)}].")
                continue
            b = ctx.bounds[s.name]
            if not b.valid:
                continue
            u = f" {s.unit}" if s.unit else ""
            T.add(f"TXV.{s.name}.RANGE", PASS, "Range", f"{s.name}: never outside min/max", signal=s, sel=sel,
                  expected=(f"During the whole run raw ∈ [{b.lo}, {b.hi}] → [{dec_str(s.phys(b.r_pmin))}|"
                            f"{dec_str(s.phys(b.r_pmax))}]{u}, except defined special values."))
            for code, raw, lbl in (("MIN", b.r_pmin, "physical minimum"), ("MAX", b.r_pmax, "physical maximum")):
                T.add(f"TXV.{s.name}.{code}", CORNER, "Range", f"{s.name}: drive to {lbl}", signal=s, raw=raw,
                      payload=ctx.build({s.name: raw}, sel), sel=sel,
                      expected=f"Stimulate DUT input so that {s.name} = {ctx.fmt(s, raw)}; frame carries this raw value.",
                      note="Payload = expected frame content with all other signals at initial values.")
            specials = [(r, l) for r, l in s.choices.items() if self.special_re.search(l)]
            iv = s.attr("GenSigInactiveValue")
            if s.has_explicit("GenSigInactiveValue") and iv is not None:
                specials.append((int(Decimal(str(iv))), "GenSigInactiveValue"))
            for r, l in specials[:4]:
                T.add(f"TXV.{s.name}.SPECIAL_{r}", SPECIAL, "Enum/Special", f"{s.name}: sends '{l}' (raw {r})",
                      signal=s, raw=r, payload=ctx.build({s.name: r}, sel), sel=sel,
                      expected=f"When the source is unavailable/faulty/inactive the DUT sends '{l}' = raw {r}.")
            if self.cfg.include_e2e and self.counter_re.search(s.name) and not self.crc_re.search(s.name):
                T.add(f"TXV.{s.name}.COUNTER", PASS, "E2E/Counter", f"{s.name}: alive counter", signal=s, sel=sel,
                      expected=f"Increments by exactly 1 per frame, wraps {b.hi}→{b.lo}, never frozen or skipped.")
            elif self.cfg.include_e2e and self.crc_re.search(s.name):
                T.add(f"TXV.{s.name}.CRC", PASS, "E2E/CRC", f"{s.name}: CRC valid", signal=s, sel=sel,
                      expected="CRC correct on every frame per E2E profile.")
        for sw in ctx.switches:
            vals = sorted(ctx.mux_map.get(sw.name, {}))
            if vals:
                T.add(f"TXV.MUX.{sw.name}", PASS, "Multiplex", f"Multiplexor {sw.name} values", signal=sw,
                      expected=f"Only defined multiplexor values {shorten([str(v) for v in vals], 16)} are sent; "
                               f"each group's signals consistent with its selector.")


