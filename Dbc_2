        def __init__(self) -> None:
            super().__init__()
            self.title(f"{TOOL_NAME}  v{__version__}")
            self.geometry("900x780")
            self.minsize(780, 640)
            self.q: "queue.Queue[Tuple[Any, ...]]" = queue.Queue()
            self.db: Optional[Database] = None
            self.worker: Optional[threading.Thread] = None
            self.last_output = ""
            h = QueueLogHandler(self.q)
            h.setFormatter(logging.Formatter("%(asctime)s  %(levelname)-7s %(message)s", "%H:%M:%S"))
            log.addHandler(h)
            log.setLevel(logging.INFO)
            self._vars()
            self._build()
            self._load_settings()
            self.protocol("WM_DELETE_WINDOW", self._on_close)
            self.after(100, self._poll)

        # ── variables ───────────────────────────────────────────────
        def _vars(self) -> None:
            d = GenConfig()
            self.v_in = tk.StringVar()
            self.v_out = tk.StringVar()
            self.v_dut = tk.StringVar(value=ALL_NODES_LABEL)
            self.v_filter = tk.StringVar()
            self.v_unrel = tk.BooleanVar(value=d.include_unrelated)
            self.v_skipdiag = tk.BooleanVar(value=d.skip_diag)
            self.v_tol = tk.StringVar(value=f"{d.cycle_tol_pct:g}")
            self.v_res = tk.StringVar(value=str(d.time_res_ms))
            self.v_tof = tk.StringVar(value=f"{d.timeout_factor:g}")
            self.v_dur = tk.StringVar(value=str(d.stim_duration_ms))
            self.v_burst = tk.StringVar(value=str(d.burst_count))
            self.v_enum = tk.StringVar(value=str(d.max_enum_cases))
            self.v_pad = tk.StringVar(value=f"0x{d.padding_byte:02X}")
            self.v_na = tk.BooleanVar(value=d.include_na_rows)
            self.v_layout = tk.BooleanVar(value=d.include_layout)
            self.v_e2e = tk.BooleanVar(value=d.include_e2e)
            self.v_combo = tk.BooleanVar(value=d.include_combination)
            self.v_bitwalk = tk.BooleanVar(value=d.include_bitwalk)
            self.v_allsheet = tk.BooleanVar(value=d.consolidated_sheet)
            self.v_csv = tk.BooleanVar(value=d.export_csv)
            self.v_open = tk.BooleanVar(value=True)
            self.v_info = tk.StringVar(value="Select a DBC (or ARXML) file.")
            self.v_status = tk.StringVar(value="Ready")

        # ── layout ──────────────────────────────────────────────────
        def _build(self) -> None:
            style = ttk.Style(self)
            for theme in (("vista", "winnative") if sys.platform.startswith("win") else ("clam",)):
                try:
                    style.theme_use(theme)
                    break
                except tk.TclError:
                    continue
            style.configure("Big.TButton", font=("Segoe UI", 10, "bold"), padding=6)
            P = dict(padx=6, pady=3)
            f = ttk.LabelFrame(self, text=" 1. Input / output ")
            f.pack(fill="x", padx=8, pady=(8, 4))
            ttk.Label(f, text="DBC / ARXML file:").grid(row=0, column=0, sticky="w", **P)
            ttk.Entry(f, textvariable=self.v_in).grid(row=0, column=1, sticky="ew", **P)
            ttk.Button(f, text="Browse…", command=self._browse_in).grid(row=0, column=2, **P)
            ttk.Label(f, text="Output Excel (.xlsx):").grid(row=1, column=0, sticky="w", **P)
            ttk.Entry(f, textvariable=self.v_out).grid(row=1, column=1, sticky="ew", **P)
            ttk.Button(f, text="Save as…", command=self._browse_out).grid(row=1, column=2, **P)
            ttk.Label(f, textvariable=self.v_info, foreground="#44546A").grid(row=2, column=0, columnspan=3,
                                                                               sticky="w", **P)
            f.columnconfigure(1, weight=1)

            s = ttk.LabelFrame(self, text=" 2. Device under test & scope ")
            s.pack(fill="x", padx=8, pady=4)
            ttk.Label(s, text="DUT node:").grid(row=0, column=0, sticky="w", **P)
            self.cb_dut = ttk.Combobox(s, textvariable=self.v_dut, state="readonly", width=40,
                                       values=[ALL_NODES_LABEL])
            self.cb_dut.grid(row=0, column=1, sticky="w", **P)
            ttk.Label(s, text="Message filter (regex on name, or IDs like 0x100,0x12C):").grid(
                row=1, column=0, columnspan=2, sticky="w", **P)
            ttk.Entry(s, textvariable=self.v_filter).grid(row=2, column=0, columnspan=2, sticky="ew", **P)
            ttk.Checkbutton(s, text="Skip diagnostic (UDS/XCP) messages", variable=self.v_skipdiag).grid(
                row=0, column=2, sticky="w", **P)
            ttk.Checkbutton(s, text="Include messages not related to DUT", variable=self.v_unrel).grid(
                row=1, column=2, sticky="w", **P)
            s.columnconfigure(1, weight=1)

            o = ttk.LabelFrame(self, text=" 3. Test generation options ")
            o.pack(fill="x", padx=8, pady=4)
            nums = [("Cycle tolerance [%]", self.v_tol), ("Timing resolution [ms]", self.v_res),
                    ("Timeout = N × cycle (if not in DBC)", self.v_tof), ("Stimulus duration [ms]", self.v_dur),
                    ("Burst frame count", self.v_burst), ("Max enum cases / signal", self.v_enum),
                    ("Padding / unused byte", self.v_pad)]
            for i, (lbl, var) in enumerate(nums):
                r, c = divmod(i, 2)
                ttk.Label(o, text=lbl + ":").grid(row=r, column=c * 2, sticky="w", **P)
                ttk.Entry(o, textvariable=var, width=10).grid(row=r, column=c * 2 + 1, sticky="w", **P)
            checks = [("N/A rows (traceability)", self.v_na), ("Layout / byte-order tests", self.v_layout),
                      ("E2E counter / CRC tests", self.v_e2e), ("Signal combination tests", self.v_combo),
                      ("Bit-walk per signal (large!)", self.v_bitwalk), ("All_TestCases sheet", self.v_allsheet),
                      ("Export CSV", self.v_csv), ("Open Excel when done", self.v_open)]
            cf = ttk.Frame(o)
            cf.grid(row=4, column=0, columnspan=4, sticky="w", **P)
            for i, (lbl, var) in enumerate(checks):
                ttk.Checkbutton(cf, text=lbl, variable=var).grid(row=i // 4, column=i % 4, sticky="w", padx=6, pady=2)

            a = ttk.Frame(self)
            a.pack(fill="x", padx=8, pady=6)
            self.btn_gen = ttk.Button(a, text="▶  Generate test cases", style="Big.TButton", command=self._start)
            self.btn_gen.pack(side="left")
            self.btn_open = ttk.Button(a, text="Open output", command=self._open_out, state="disabled")
            self.btn_open.pack(side="left", padx=6)
            self.pb = ttk.Progressbar(a, mode="determinate", maximum=100)
            self.pb.pack(side="left", fill="x", expand=True, padx=6)
            ttk.Label(self, textvariable=self.v_status, anchor="w").pack(fill="x", padx=10)
            lf = ttk.LabelFrame(self, text=" Log ")
            lf.pack(fill="both", expand=True, padx=8, pady=(4, 8))
            self.txt = ScrolledText(lf, height=12, state="disabled", font=("Consolas", 9), wrap="word")
            self.txt.pack(fill="both", expand=True, padx=4, pady=4)

        # ── actions ─────────────────────────────────────────────────
        def _browse_in(self) -> None:
            p = filedialog.askopenfilename(title="Select DBC / ARXML",
                                           filetypes=[("CAN database", "*.dbc *.arxml"), ("All files", "*.*")])
            if p:
                self.v_in.set(p)
                if not self.v_out.get():
                    self.v_out.set(os.path.splitext(p)[0] + "_CAN_TestCases.xlsx")
                self._load_db(p)

        def _browse_out(self) -> None:
            p = filedialog.asksaveasfilename(title="Output workbook", defaultextension=".xlsx",
                                             filetypes=[("Excel workbook", "*.xlsx")],
                                             initialfile=os.path.basename(self.v_out.get() or "CAN_TestCases.xlsx"))
            if p:
                self.v_out.set(p)

        def _load_db(self, p: str) -> None:
            self.config(cursor="watch")
            self.update_idletasks()
            try:
                self.db = load_database(p)
                nodes = sorted(set(self.db.nodes) | {t for m in self.db.messages for t in m.transmitters})
                self.cb_dut["values"] = [ALL_NODES_LABEL] + nodes
                if self.v_dut.get() not in self.cb_dut["values"]:
                    self.v_dut.set(ALL_NODES_LABEL)
                nsig = sum(len(m.signals) for m in self.db.messages)
                fd = sum(1 for m in self.db.messages if m.is_fd)
                self.v_info.set(f"Loaded: {len(self.db.messages)} messages ({fd} CAN FD), {nsig} signals, "
                                f"{len(nodes)} nodes – {self.db.loader}")
                log.info("Loaded %s", p)
                for w in self.db.warnings[:20]:
                    log.warning(w)
            except Exception as exc:
                self.db = None
                self.v_info.set("Load failed – see log.")
                log.error("Cannot load %s: %s", p, exc)
                messagebox.showerror("Load failed", str(exc))
            finally:
                self.config(cursor="")

        def _cfg(self) -> GenConfig:
            dut = self.v_dut.get()
            pad = self.v_pad.get().strip()
            return GenConfig(
                dut_node="" if dut == ALL_NODES_LABEL else dut, include_unrelated=self.v_unrel.get(),
                skip_diag=self.v_skipdiag.get(), message_filter=self.v_filter.get().strip(),
                cycle_tol_pct=float(self.v_tol.get()), time_res_ms=int(self.v_res.get()),
                timeout_factor=float(self.v_tof.get()), stim_duration_ms=int(self.v_dur.get()),
                burst_count=int(self.v_burst.get()), max_enum_cases=int(self.v_enum.get()),
                padding_byte=int(pad, 16) if pad.lower().startswith("0x") else int(pad),
                include_na_rows=self.v_na.get(), include_layout=self.v_layout.get(), include_e2e=self.v_e2e.get(),
                include_combination=self.v_combo.get(), include_bitwalk=self.v_bitwalk.get(),
                consolidated_sheet=self.v_allsheet.get(), export_csv=self.v_csv.get())

        def _start(self) -> None:
            if self.worker and self.worker.is_alive():
                return
            src, out = self.v_in.get().strip(), self.v_out.get().strip()
            if not src or not os.path.isfile(src):
                messagebox.showwarning("Input", "Select an existing DBC / ARXML file.")
                return
            if not out:
                messagebox.showwarning("Output", "Define the output Excel file.")
                return
            if not out.lower().endswith(".xlsx"):
                out += ".xlsx"
                self.v_out.set(out)
            try:
                cfg = self._cfg()
                if not 0 <= cfg.padding_byte <= 255:
                    raise ValueError("padding byte must be 0x00…0xFF")
            except ValueError as exc:
                messagebox.showerror("Options", f"Invalid option value: {exc}")
                return
            if self.db is None or self.db.source != os.path.abspath(src):
                self._load_db(src)
                if self.db is None:
                    return
            self._save_settings()
            self.btn_gen.config(state="disabled")
            self.btn_open.config(state="disabled")
            self.pb["value"] = 0
            db = self.db

            def work() -> None:
                try:
                    summ = run_pipeline(src, out, cfg, progress=lambda i, n, t: self.q.put(("prog", i, n, t)), db=db)
                    self.q.put(("done", summ))
                except PermissionError:
                    self.q.put(("error", f"Cannot write {out}.\nIs the file open in Excel?"))
                except Exception as exc:
                    log.debug(traceback.format_exc())
                    self.q.put(("error", f"{type(exc).__name__}: {exc}"))

            self.worker = threading.Thread(target=work, daemon=True)
            self.worker.start()

        def _poll(self) -> None:
            try:
                while True:
                    item = self.q.get_nowait()
                    kind = item[0]
                    if kind == "log":
                        self.txt.config(state="normal")
                        self.txt.insert("end", item[1] + "\n")
                        self.txt.see("end")
                        self.txt.config(state="disabled")
                    elif kind == "prog":
                        _k, i, n, t = item
                        self.pb["value"] = 100.0 * i / max(1, n)
                        self.v_status.set(t)
                    elif kind == "done":
                        s = item[1]
                        self.last_output = s["output"]
                        self.pb["value"] = 100
                        self.btn_gen.config(state="normal")
                        self.btn_open.config(state="normal")
                        cats = ", ".join(f"{k} {v}" for k, v in s["by_category"].items())
                        self.v_status.set(f"Done – {s['tests']} test cases in {s['seconds']} s")
                        msg = (f"{s['tests']} test cases for {s['generated']} messages\n({cats})\n\n"
                               f"{sum(s['violations'].values())} violation tests in {len(s['violations'])} "
                               f"violation types (see Violation_Summary)\n\n"
                               f"DBC audit: {s['audit']['ERROR']} errors, {s['audit']['WARNING']} warnings\n\n"
                               f"{s['output']}" + (f"\n{s['csv']}" if s["csv"] else ""))
                        if self.v_open.get():
                            open_path(s["output"])
                        messagebox.showinfo("Generation complete", msg)
                    elif kind == "error":
                        self.btn_gen.config(state="normal")
                        self.v_status.set("Failed")
                        log.error(item[1])
                        messagebox.showerror("Generation failed", item[1])
            except queue.Empty:
                pass
            self.after(100, self._poll)

        def _open_out(self) -> None:
            if self.last_output:
                open_path(self.last_output)

        # ── settings persistence ────────────────────────────────────
        def _settings_vars(self) -> Dict[str, Any]:
            return {k: v for k, v in vars(self).items() if k.startswith("v_") and k not in ("v_info", "v_status")}

        def _save_settings(self) -> None:
            try:
                with open(SETTINGS_FILE, "w", encoding="utf-8") as fh:
                    json.dump({k: v.get() for k, v in self._settings_vars().items()}, fh, indent=1)
            except OSError:
                pass

        def _load_settings(self) -> None:
            try:
                with open(SETTINGS_FILE, encoding="utf-8") as fh:
                    data = json.load(fh)
            except (OSError, ValueError):
                return
            for k, var in self._settings_vars().items():
                if k in data:
                    try:
                        var.set(data[k])
                    except tk.TclError:
                        pass
            if self.v_in.get() and os.path.isfile(self.v_in.get()):
                self.after(200, lambda: self._load_db(self.v_in.get()))

        def _on_close(self) -> None:
            self._save_settings()
            self.destroy()

    App().mainloop()
    return 0


