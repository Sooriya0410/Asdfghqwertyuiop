def violation_counts(tests: Iterable[TestCase]) -> Dict[str, Dict[str, int]]:
    """{violation label: {NEGATIVE, SPECIAL, N/A, Total}} in taxonomy order."""
    out: Dict[str, Dict[str, int]] = {}
    for t in tests:
        if not t.violation or t.violation == NO_VIOLATION:
            continue
        d = out.setdefault(t.violation, {NEG: 0, SPECIAL: 0, "N/A": 0, "Total": 0})
        if t.applicable != "Yes":
            d["N/A"] += 1
        else:
            d[SPECIAL if t.category == SPECIAL else NEG] += 1
            d["Total"] += 1
    order = {k: i for i, k in enumerate(VIOLATIONS)}
    return dict(sorted(out.items(), key=lambda kv: (order.get(kv[0], 999), kv[0])))


@dataclass
class MessageResult:
    msg: Message
    direction: str
    cls: str
    status: str
    tests: List[TestCase]
    sheet: str = ""


class ExcelReportWriter:
    def __init__(self, db: Database, cfg: GenConfig, gen: TestCaseGenerator, results: List[MessageResult],
                 findings: List[Finding]) -> None:
        from openpyxl.styles import Alignment, Border, Font, PatternFill, Side  # noqa: F401
        from openpyxl.cell.cell import ILLEGAL_CHARACTERS_RE
        self.db, self.cfg, self.gen, self.results, self.findings = db, cfg, gen, results, findings
        self._illegal = ILLEGAL_CHARACTERS_RE
        thin = Side(style="thin", color="BFBFBF")
        self.border = Border(left=thin, right=thin, top=thin, bottom=thin)
        self.hdr_font = Font(bold=True, color="FFFFFF")
        self.hdr_fill = PatternFill("solid", fgColor="1F3864")
        self.sec_fill = PatternFill("solid", fgColor="2F5496")
        self.sec_font = Font(bold=True, color="FFFFFF", size=12)
        self.title_font = Font(bold=True, size=14, color="1F3864")
        self.bold = Font(bold=True)
        self.wrap = Alignment(wrap_text=True, vertical="top")
        self.top = Alignment(vertical="top")
        self.center = Alignment(horizontal="center", vertical="center", wrap_text=True)
        self.fills = {k: PatternFill("solid", fgColor=v) for k, v in CAT_FILL.items()}
        self.na_fill = PatternFill("solid", fgColor="D9D9D9")
        self.label_fill = PatternFill("solid", fgColor="D6DCE4")
        self.unused_fill = PatternFill("solid", fgColor="F2F2F2")
        self.err_fill = PatternFill("solid", fgColor="FF9999")
        self.sig_fills = [PatternFill("solid", fgColor=c) for c in SIGNAL_COLORS]
        self.left = Alignment(horizontal="left", vertical="top", wrap_text=True)
        self._style_cache: Dict[Tuple[int, int, int, bool], Any] = {}
        self._scratch: Any = None
        self.sev_fill = {"ERROR": PatternFill("solid", fgColor="FFC7CE"),
                         "WARNING": PatternFill("solid", fgColor="FFEB9C"),
                         "INFO": PatternFill("solid", fgColor="DDEBF7")}

    # ── cell helpers ─────────────────────────────────────────────────────
    def put(self, ws: Any, r: int, c: int, v: Any, font: Any = None, fill: Any = None, align: Any = None,
            border: bool = True) -> Any:
        v = xl_num(v)
        if isinstance(v, str):
            v = self._illegal.sub("", v)
            if len(v) > 32000:
                v = v[:32000] + "…"
        cell = ws.cell(row=r, column=c, value=v)
        if isinstance(v, str) and v.startswith("="):
            cell.data_type = "s"
        key = (id(font), id(fill), id(align), border)
        sa = self._style_cache.get(key)
        if sa is None:
            # Style a detached scratch cell once per combination, then reuse its StyleArray:
            # avoids openpyxl's expensive per-cell style hashing (≈10x faster on large DBCs).
            from openpyxl.cell.cell import Cell
            if self._scratch is None:
                self._scratch = Cell(ws, row=1, column=1)
            sc = self._scratch
            sc._style = copy.copy(cell._style)
            if font is not None:
                sc.font = font
            if fill is not None:
                sc.fill = fill
            if align is not None:
                sc.alignment = align
            if border:
                sc.border = self.border
            sa = copy.copy(sc._style)
            self._style_cache[key] = sa
        cell._style = copy.copy(sa)
        return cell

    def header(self, ws: Any, r: int, headers: Sequence[str], c0: int = 1) -> None:
        for i, h in enumerate(headers):
            self.put(ws, r, c0 + i, h, self.hdr_font, self.hdr_fill, self.center)

    def section(self, ws: Any, r: int, text: str, width: int = 9) -> None:
        from openpyxl.utils import get_column_letter
        self.put(ws, r, 1, text, self.sec_font, self.sec_fill, border=False)
        for c in range(2, width + 1):
            ws.cell(row=r, column=c).fill = self.sec_fill
        ws.merge_cells(f"A{r}:{get_column_letter(width)}{r}")

    @staticmethod
    def sheet_title(msg: Message, used: Set[str]) -> str:
        base = f"{msg.id_hex[2:]}_{msg.name}"
        base = re.sub(r"[\[\]:*?/\\']", "_", base)[:31]
        name, i = base, 2
        while name.lower() in used or name.lower() in ("summary", "violation_summary", "message_index",
                                                         "dbc_audit", "all_testcases", "legend", "history"):
            suf = f"~{i}"
            name = base[:31 - len(suf)] + suf
            i += 1
        used.add(name.lower())
        return name

    # ── workbook ─────────────────────────────────────────────────────────
    def write(self, path: str, progress: Optional[Callable[[int, int, str], None]] = None) -> None:
        from openpyxl import Workbook
        wb = Workbook()
        wb.remove(wb.active)
        used: Set[str] = set()
        for r in self.results:
            if r.status.startswith("Generated"):
                r.sheet = self.sheet_title(r.msg, used)
        ws_sum = wb.create_sheet("Summary")
        ws_vio = wb.create_sheet("Violation_Summary")
        ws_idx = wb.create_sheet("Message_Index")
        ws_aud = wb.create_sheet("DBC_Audit")
        ws_all = wb.create_sheet("All_TestCases") if self.cfg.consolidated_sheet else None
        ws_leg = wb.create_sheet("Legend")
        gen_results = [r for r in self.results if r.sheet]
        total = len(gen_results)
        for i, r in enumerate(gen_results, 1):
            if progress:
                progress(i, total, f"Writing sheet {r.sheet}")
            self._message_sheet(wb.create_sheet(r.sheet), r)
        if ws_all is not None:
            if progress:
                progress(total, total, "Writing All_TestCases")
            self._all_sheet(ws_all)
        self._index_sheet(ws_idx)
        self._violation_sheet(ws_vio)
        self._audit_sheet(ws_aud)
        self._legend_sheet(ws_leg)
        self._summary_sheet(ws_sum)
        wb.active = 0
        if progress:
            progress(total, total, "Saving workbook")
        wb.save(path)

    # ── per-message sheet ────────────────────────────────────────────────
    def _message_sheet(self, ws: Any, res: MessageResult) -> None:
        from openpyxl.utils import get_column_letter
        m, gen = res.msg, self.gen
        ctx = MsgContext(m, self.cfg)
        for i, (_h, _a, w, _wr) in enumerate(TC_COLUMNS, 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        ws.sheet_properties.tabColor = "70AD47" if res.direction == "RX" else "4472C4"
        r = 1
        self.put(ws, r, 1, f"{m.name}  —  send on CAN ID {m.id_hex} ({m.id_format}, {m.frame_type}, DLC {m.dlc_code})",
                 self.title_font, border=False)
        r += 1
        c = self.put(ws, r, 1, "← Message_Index", border=False)
        c.hyperlink = "#'Message_Index'!A1"
        c.style = "Hyperlink"
        r += 2
        # 1. definition
        self.section(ws, r, "1. Message definition")
        r += 1
        defs: List[Tuple[str, Any]] = [
            ("Message Name", m.name), ("CAN ID (hex)", m.id_hex), ("CAN ID (dec)", m.frame_id),
            ("ID Format", m.id_format), ("Frame Type", m.frame_type),
            ("BRS", ("1" if m.brs else "0") if m.is_fd else "-"),
            ("Length [bytes]", m.length), ("DLC code", m.dlc_code),
            ("Cycle Time [ms]", m.cycle_time or "- (not cyclic)"), ("Send Type", m.send_type or "-"),
            ("Transmitter(s)", ", ".join(m.transmitters) or "-"), ("Receiver(s)", ", ".join(m.receivers) or "-"),
            ("DUT", self.cfg.dut_node or "(all messages treated as DUT Rx)"),
            ("DUT Direction", "DUT receives → stimulus tests" if res.direction == "RX" else "DUT transmits → verification tests"),
            ("Message Class", res.cls), ("Signals", len(m.signals)),
            ("Unused bits", f"{len(ctx.unused_bits)} of {ctx.nbits}"),
        ]
        if gen.is_j1939(m) and m.is_extended:
            fid = m.frame_id
            pf, ps = (fid >> 16) & 0xFF, (fid >> 8) & 0xFF
            pgn = ((fid >> 8) & 0x3FF00) | (ps if pf >= 240 else 0)
            defs.append(("J1939", f"Priority {(fid >> 26) & 7}, PGN {pgn} (0x{pgn:04X}), "
                                  f"{'DA ' + str(ps) + ', ' if pf < 240 else ''}SA 0x{fid & 0xFF:02X}"))
        tos = gen.timeouts_of(m)
        if tos:
            defs.append(("Rx timeouts used", "; ".join(f"{k} ms ({v[1]})" for k, v in tos.items())))
        vc = violation_counts(res.tests)
        defs.append(("Violations tested", " | ".join(f"{k}: {v['Total']}" for k, v in vc.items() if v["Total"])
                     or "-"))
        defs.append(("Comment", m.comment or "-"))
        for k in sorted(m.attributes, key=str.lower):
            v = m.attributes[k]
            defs.append((f"Attr: {k}", f"{dec_str(v) if isinstance(v, Decimal) else v}"
                                        + ("" if k in m.explicit_attrs else "  (default)")))
        for k, nodes in m.rel_attributes.items():
            defs.append((f"Attr: {k} (per node)", "; ".join(f"{n}={v}" for n, v in nodes.items())))
        for label, val in defs:
            self.put(ws, r, 1, label, self.bold, self.label_fill, self.top)
            self.put(ws, r, 2, val, align=self.left)
            for cc in range(3, 10):
                ws.cell(row=r, column=cc).border = self.border
            ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=9)
            r += 1
        r += 1
        # 2. layout grid
        self.section(ws, r, "2. Message layout (byte × bit) – S# = signal reference, LSB/MSB marked")
        r += 1
        self.header(ws, r, ["Byte \\ Bit"] + [str(b) for b in range(7, -1, -1)])
        r += 1
        cell_map: Dict[int, List[Tuple[int, str]]] = {}
        max_pos = ctx.nbits - 1
        for idx, s in enumerate(m.signals):
            bits = bits_of(s)
            if not bits:
                continue
            max_pos = max(max_pos, max(bits))
            for k, p in enumerate(bits):
                mark = "" if len(bits) == 1 else (" LSB" if k == 0 else (" MSB" if k == len(bits) - 1 else ""))
                cell_map.setdefault(p, []).append((idx, s.ref + mark))
        for byte in range(max_pos // 8 + 1):
            beyond = byte >= m.length
            self.put(ws, r, 1, f"Byte {byte}" + ("  ⚠ beyond DLC" if beyond else ""), self.bold,
                     self.err_fill if beyond else self.label_fill)
            for col, bit in enumerate(range(7, -1, -1), 2):
                p = byte * 8 + bit
                entries = cell_map.get(p)
                if entries:
                    txt = "/".join(e[1] for e in entries)
                    fill = self.err_fill if beyond else self.sig_fills[entries[0][0] % len(self.sig_fills)]
                    self.put(ws, r, col, txt, fill=fill, align=self.center)
                else:
                    self.put(ws, r, col, "·", fill=self.err_fill if beyond else self.unused_fill, align=self.center)
            r += 1
        r += 1
        # 3. signals
        self.section(ws, r, "3. Signal definitions")
        r += 1
        extra = sorted({k for s in m.signals for k in s.attributes if k not in SIG_STD_ATTRS
                        and k.lower() not in {a.lower() for a in SIG_STD_ATTRS}}, key=str.lower)
        heads = ["Signal Name", "Ref", "Start Bit", "Length [Bit]", "Byte Order", "Value Type", "Initial Value (phys)",
                 "Factor", "Offset", "Minimum", "Maximum", "Unit", "GenSigILSupport", "GenSigTimeoutTime [ms]",
                 "GenSigInactiveValue", "GenSigStartValue (raw)", "GenSigSendType", "SigType", "SPN", "Raw Type Range",
                 "Valid Raw Range", "Bits (LSB→MSB)", "Multiplexing", "Receivers", "Detected Role", "Value Table",
                 "Comment"] + extra
        self.header(ws, r, heads)
        r += 1
        for idx, s in enumerate(m.signals):
            init = ctx.dbc_init[s.name]
            b = ctx.bounds.get(s.name)
            to_parts = []
            rel = attr_get(s.rel_attributes, "GenSigTimeoutTime", "GenSigTimeOutTime")
            if rel:
                to_parts += [f"{v} ({n})" for n, v in rel.items()]
            for k, v in s.attributes.items():
                if k.lower().startswith("gensigtimeouttime_"):
                    to_parts.append(f"{v} ({k.split('_', 1)[1]})")
            tv = s.attr("GenSigTimeoutTime", "GenSigTimeOutTime")
            if tv is not None and (pos_int(tv) or not to_parts):
                to_parts.insert(0, dec_str(tv) if isinstance(tv, Decimal) else str(tv))
            mux = ("Multiplexor" if s.is_switch else "") + \
                  (f"{' & ' if s.is_switch else ''}{s.mux_parent} = {shorten([str(v) for v in s.mux_values], 6)}"
                   if s.mux_parent else "")
            bits = bits_of(s)
            row = [s.name, s.ref, s.start, s.length, s.byte_order, s.value_type,
                   s.phys(init) if not s.is_float else s.phys(init), s.factor, s.offset, s.minimum, s.maximum, s.unit,
                   s.attr("GenSigILSupport", default=""), " | ".join(to_parts),
                   s.attr("GenSigInactiveValue", default=""), s.attr("GenSigStartValue", default=""),
                   s.attr("GenSigSendType", default=""), s.attr("SigType", default=""), s.attr("SPN", default=""),
                   "IEEE" if s.is_float else f"{b.tmin} … {b.tmax}",
                   "-" if s.is_float else (f"{b.lo} … {b.hi}" if b.valid else "none"),
                   f"{bitpos_str(bits[0])} → {bitpos_str(bits[-1])}" if bits else "-",
                   mux or "-", ", ".join(s.receivers) or "-", self._role(s),
                   "; ".join(f"{k}={v}" for k, v in sorted(s.choices.items())) or "-", s.comment]
            row += [s.attributes.get(k, "") for k in extra]
            fill = self.sig_fills[idx % len(self.sig_fills)]
            for cidx, v in enumerate(row, 1):
                if isinstance(v, Decimal):
                    v = xl_num(v)
                self.put(ws, r, cidx, v, fill=fill if cidx <= 2 else None, align=self.wrap)
            r += 1
        r += 1
        # 4. tests
        n = sum(1 for t in res.tests if t.applicable == "Yes")
        self.section(ws, r, f"4. Test cases – {n} applicable ({res.direction == 'RX' and 'send on ' + m.id_hex or 'DUT transmits ' + m.id_hex})")
        r += 1
        hdr_row = r
        self.header(ws, r, [h for h, *_ in TC_COLUMNS])
        r += 1
        first = r
        for tc in res.tests:
            self._tc_row(ws, r, tc, TC_COLUMNS)
            r += 1
        if res.tests:
            last_col = get_column_letter(len(TC_COLUMNS))
            ws.auto_filter.ref = f"A{hdr_row}:{last_col}{r - 1}"
            self._result_validation(ws, [h for h, *_ in TC_COLUMNS].index("Result") + 1, first, r - 1)

    def _role(self, s: Signal) -> str:
        roles = []
        if s.is_switch:
            roles.append("Multiplexor")
        if self.cfg.include_e2e and self.gen.crc_re.search(s.name):
            roles.append("CRC / checksum")
        elif self.cfg.include_e2e and self.gen.counter_re.search(s.name):
            roles.append("Alive counter")
        if s.is_float:
            roles.append("IEEE float")
        return ", ".join(roles) or "-"

    def _tc_row(self, ws: Any, r: int, tc: TestCase, cols: Sequence[Tuple[str, str, float, bool]]) -> None:
        na = tc.applicable != "Yes"
        for c, (_h, attr, _w, wrap) in enumerate(cols, 1):
            v = getattr(tc, attr)
            fill = None
            if attr == "category":
                fill = self.na_fill if na else self.fills.get(tc.category)
                if na:
                    v = "N/A"
            elif na and attr in ("tc_id", "title", "applicable"):
                fill = self.na_fill
            self.put(ws, r, c, v, fill=fill, align=self.wrap if wrap else self.top)

    def _result_validation(self, ws: Any, col: int, r1: int, r2: int) -> None:
        from openpyxl.formatting.rule import CellIsRule
        from openpyxl.styles import PatternFill
        from openpyxl.utils import get_column_letter
        from openpyxl.worksheet.datavalidation import DataValidation
        L = get_column_letter(col)
        dv = DataValidation(type="list", formula1='"PASS,FAIL,NOT RUN,BLOCKED,N/A"', allow_blank=True)
        ws.add_data_validation(dv)
        dv.add(f"{L}{r1}:{L}{r2}")
        rng = f"{L}{r1}:{L}{r2}"
        ws.conditional_formatting.add(rng, CellIsRule(operator="equal", formula=['"PASS"'],
                                                      fill=PatternFill("solid", fgColor="63BE7B")))
        ws.conditional_formatting.add(rng, CellIsRule(operator="equal", formula=['"FAIL"'],
                                                      fill=PatternFill("solid", fgColor="F8696B")))

    # ── consolidated sheet ───────────────────────────────────────────────
    def _all_sheet(self, ws: Any) -> None:
        from openpyxl.utils import get_column_letter
        cols = [TC_COLUMNS[0], ("Message", "message", 24, False)] + TC_COLUMNS[1:]
        for i, (_h, _a, w, _wr) in enumerate(cols, 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        self.header(ws, 1, [h for h, *_ in cols])
        r = 2
        for res in self.results:
            for tc in res.tests:
                self._tc_row(ws, r, tc, cols)
                r += 1
        ws.freeze_panes = "C2"
        if r > 2:
            ws.auto_filter.ref = f"A1:{get_column_letter(len(cols))}{r - 1}"
            self._result_validation(ws, [h for h, *_ in cols].index("Result") + 1, 2, r - 1)

    # ── index ────────────────────────────────────────────────────────────
    def _index_sheet(self, ws: Any) -> None:
        from openpyxl.utils import get_column_letter
        heads = ["#", "Message", "CAN ID (hex)", "CAN ID (dec)", "ID Format", "Frame", "Length [B]", "DLC",
                 "Cycle [ms]", "Send Type", "Transmitter(s)", "Receiver(s)", "Class", "DUT Direction", "Status",
                 "Signals", "Tests", PASS, CORNER, NEG, SPECIAL, "N/A", "Sheet"]
        widths = [5, 28, 13, 12, 10, 8, 10, 6, 10, 24, 18, 28, 12, 15, 34, 8, 8, 8, 9, 10, 9, 7, 30]
        for i, w in enumerate(widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        self.header(ws, 1, heads)
        for i, res in enumerate(self.results, 1):
            m = res.msg
            cnt = {c: sum(1 for t in res.tests if t.category == c and t.applicable == "Yes") for c in CATEGORIES}
            na = sum(1 for t in res.tests if t.applicable != "Yes")
            dirn = {"RX": "DUT Rx (stimulus)", "TX": "DUT Tx (verify)"}.get(res.direction, "-")
            row = [i, m.name, m.id_hex, m.frame_id, m.id_format, m.frame_type, m.length, m.dlc_code,
                   m.cycle_time or "-", m.send_type or "-", ", ".join(m.transmitters) or "-",
                   ", ".join(m.receivers) or "-", res.cls, dirn, res.status, len(m.signals),
                   sum(cnt.values()), cnt[PASS], cnt[CORNER], cnt[NEG], cnt[SPECIAL], na, res.sheet or "-"]
            for c, v in enumerate(row, 1):
                cell = self.put(ws, i + 1, c, v, align=self.top)
                if c == len(row) and res.sheet:
                    cell.hyperlink = f"#'{res.sheet}'!A1"
                    cell.style = "Hyperlink"
                    cell.border = self.border
            if not res.sheet:
                for c in range(1, len(row) + 1):
                    ws.cell(row=i + 1, column=c).fill = self.na_fill
        ws.freeze_panes = "C2"
        ws.auto_filter.ref = f"A1:{get_column_letter(len(heads))}{len(self.results) + 1}"

    # ── violation summary ───────────────────────────────────────────────
    def _violation_sheet(self, ws: Any) -> None:
        from openpyxl.utils import get_column_letter
        for i, w in enumerate([46, 70, 11, 11, 11, 9, 11, 24], 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        all_tc = [t for x in self.results for t in x.tests]
