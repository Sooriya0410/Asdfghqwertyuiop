def to_dec(tok: Any, default: Optional[Decimal] = Decimal(0)) -> Optional[Decimal]:
    """Parse a DBC number token into Decimal (exact, no float rounding)."""
    if isinstance(tok, Decimal):
        return tok
    if tok is None:
        return default
    s = str(tok).strip().strip('"')
    if not s:
        return default
    try:
        return Decimal(s)
    except InvalidOperation:
        try:
            return Decimal(repr(float(s)))
        except ValueError:
            return default


def dec_str(d: Any) -> str:
    """Human-readable number without exponent / trailing zeros."""
    if d is None or d == "":
        return ""
    if isinstance(d, float):
        if math.isnan(d) or math.isinf(d):
            return str(d)
        d = Decimal(repr(d))
    if not isinstance(d, Decimal):
        return str(d)
    if d.is_nan():
        return "NaN"
    if d.is_infinite():
        return "+Inf" if d > 0 else "-Inf"
    if d != 0 and (abs(d) < Decimal("1e-6") or abs(d) >= Decimal("1e16")):
        return format(d.normalize(), "E")
    s = format(d.normalize(), "f")
    return "0" if s == "-0" else s


def xl_num(v: Any) -> Any:
    """Convert a value into something openpyxl writes nicely."""
    if isinstance(v, Decimal):
        if v.is_nan() or v.is_infinite():
            return dec_str(v)
        if v == v.to_integral_value():
            iv = int(v)
            return iv if abs(iv) < 10 ** 15 else dec_str(v)
        return float(v)
    if isinstance(v, float) and (math.isnan(v) or math.isinf(v)):
        return dec_str(v)
    return v


def is_yes(v: Any) -> bool:
    return str(v).strip().lower() in ("1", "yes", "true", "y", "on")


def attr_get(attrs: Dict[str, Any], *names: str, default: Any = None) -> Any:
    """Case-insensitive attribute lookup (DBCs differ: GenSigTimeoutTime / GenSigTimeOutTime)."""
    if not attrs:
        return default
    low = {k.lower(): v for k, v in attrs.items()}
    for n in names:
        v = low.get(n.lower())
        if v is not None and v != "":
            return v
    return default


def pos_int(v: Any) -> Optional[int]:
    """Return int(v) if it is a positive number, else None."""
    try:
        d = Decimal(str(v))
        return int(d) if d > 0 else None
    except (InvalidOperation, ValueError, TypeError):
        return None


def length_to_dlc(n: int) -> int:
    """Byte length -> DLC code (ISO 11898-1 / CAN FD)."""
    if n <= 8:
        return n
    for i, L in enumerate(CANFD_LENGTHS):
        if L >= n:
            return i
    return 15


def tol_bounds(cycle_ms: int, tol_pct: float) -> Tuple[int, int]:
    """Cycle-time tolerance window in whole ms (Decimal math: 100 ms ±10 % → 90…110, not 111)."""
    c, t = Decimal(cycle_ms), Decimal(str(tol_pct)) / 100
    return (int((c * (1 - t)).to_integral_value(rounding=ROUND_FLOOR)),
            int((c * (1 + t)).to_integral_value(rounding=ROUND_CEILING)))


def hexs(data: Sequence[int]) -> str:
    return " ".join(f"{b:02X}" for b in data)


def bitpos_str(p: int) -> str:
    return f"B{p // 8}.b{p % 8}"


def shorten(items: Sequence[str], n: int = 8) -> str:
    items = list(items)
    return ", ".join(items[:n]) + (f", … (+{len(items) - n})" if len(items) > n else "")


