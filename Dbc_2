@dataclass
class AttrDef:
    name: str
    obj: str                      # "", BU_, BO_, SG_, EV_, BU_SG_REL_, BU_BO_REL_ ...
    vtype: str                    # INT HEX FLOAT STRING ENUM
    minimum: Any = None
    maximum: Any = None
    enum: List[str] = field(default_factory=list)
    default: Any = None

    def coerce(self, token: str) -> Any:
        t = token.strip()
        quoted = len(t) >= 2 and t[0] == '"' and t[-1] == '"'
        if quoted:
            t = t[1:-1]
        if self.vtype == "ENUM":
            if quoted and t in self.enum:
                return t
            try:
                idx = int(Decimal(t))
                if 0 <= idx < len(self.enum):
                    return self.enum[idx]
            except (InvalidOperation, ValueError):
                pass
            return t
        if self.vtype in ("INT", "HEX"):
            try:
                return int(Decimal(t))
            except (InvalidOperation, ValueError):
                return t
        if self.vtype == "FLOAT":
            d = to_dec(t, None)
            return d if d is not None else t
        return t


def guess_value(token: str) -> Any:
    t = token.strip()
    if len(t) >= 2 and t[0] == '"' and t[-1] == '"':
        return t[1:-1]
    d = to_dec(t, None)
    if d is None:
        return t
    return int(d) if d == d.to_integral_value() else d


@dataclass
class Signal:
    name: str
    start: int
    length: int
    byte_order: str                       # "Intel" | "Motorola"
    is_signed: bool
    factor: Decimal
    offset: Decimal
    minimum: Decimal
    maximum: Decimal
    unit: str = ""
    receivers: List[str] = field(default_factory=list)
    mux_indicator: str = ""               # "", "M", "m3", "m3M"
    mux_parent: Optional[str] = None
    mux_values: List[int] = field(default_factory=list)
    is_switch: bool = False
    choices: Dict[int, str] = field(default_factory=dict)
    comment: str = ""
    attributes: Dict[str, Any] = field(default_factory=dict)
    explicit_attrs: Set[str] = field(default_factory=set)
    rel_attributes: Dict[str, Dict[str, Any]] = field(default_factory=dict)
    float_kind: int = 0                   # 0 = integer, 1 = IEEE float32, 2 = IEEE double
    ref: str = ""

    @property
    def is_float(self) -> bool:
        return self.float_kind in (1, 2)

    @property
    def value_type(self) -> str:
        if self.float_kind == 1:
            return "IEEE Float"
        if self.float_kind == 2:
            return "IEEE Double"
        return "Signed" if self.is_signed else "Unsigned"

    @property
    def raw_type_min(self) -> int:
        return -(1 << (self.length - 1)) if (self.is_signed and self.length > 0) else 0

    @property
    def raw_type_max(self) -> int:
        if self.length <= 0:
            return 0
        return (1 << (self.length - 1)) - 1 if self.is_signed else (1 << self.length) - 1

    def phys(self, raw: Any) -> Decimal:
        if self.is_float:
            return Decimal(repr(float(raw))) * self.factor + self.offset
        return Decimal(int(raw)) * self.factor + self.offset

    def attr(self, *names: str, default: Any = None) -> Any:
        return attr_get(self.attributes, *names, default=default)

    def has_explicit(self, name: str) -> bool:
        return name.lower() in {a.lower() for a in self.explicit_attrs}


@dataclass
class Message:
    frame_id: int
    name: str
    length: int
    transmitters: List[str] = field(default_factory=list)
    is_extended: bool = False
    is_fd: bool = False
    brs: bool = False
    signals: List[Signal] = field(default_factory=list)
    comment: str = ""
    attributes: Dict[str, Any] = field(default_factory=dict)
    explicit_attrs: Set[str] = field(default_factory=set)
    rel_attributes: Dict[str, Dict[str, Any]] = field(default_factory=dict)
    dbc_raw_id: int = 0
    notes: List[str] = field(default_factory=list)

    def attr(self, *names: str, default: Any = None) -> Any:
        return attr_get(self.attributes, *names, default=default)

    @property
    def id_hex(self) -> str:
        return f"0x{self.frame_id:08X}" if self.is_extended else f"0x{self.frame_id:03X}"

    @property
    def id_format(self) -> str:
        return "Extended" if self.is_extended else "Standard"

    @property
    def frame_type(self) -> str:
        return "CAN FD" if self.is_fd else "CAN"

    @property
    def dlc_code(self) -> int:
        return length_to_dlc(self.length)

    @property
    def cycle_time(self) -> int:
        return pos_int(self.attr("GenMsgCycleTime")) or 0

    @property
    def send_type(self) -> str:
        return str(self.attr("GenMsgSendType", default="") or "")

    @property
    def is_spontaneous(self) -> bool:
        st = self.send_type.lower()
        return any(k in st for k in ("spontan", "onchange", "onwrite", "event"))

    @property
    def is_cyclic(self) -> bool:
        st = self.send_type.lower()
        if self.cycle_time <= 0:
            return False
        if "cyclic" in st or "ifactive" in st:
            return True
        return not self.is_spontaneous

    @property
    def receivers(self) -> List[str]:
        out: List[str] = []
        for s in self.signals:
            for r in s.receivers:
                if r not in out:
                    out.append(r)
        return out

    def sig(self, name: str) -> Optional[Signal]:
        for s in self.signals:
            if s.name == name:
                return s
        return None


