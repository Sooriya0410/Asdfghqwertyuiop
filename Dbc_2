def write_csv(path: str, results: List[MessageResult]) -> None:
    cols = [TC_COLUMNS[0], ("Message", "message", 0, False)] + TC_COLUMNS[1:]
    with open(path, "w", newline="", encoding="utf-8-sig") as fh:
        w = csv.writer(fh)
        w.writerow([h for h, *_ in cols])
        for res in results:
            for tc in res.tests:
                w.writerow([dec_str(v) if isinstance(v, Decimal) else v for v in
                            (getattr(tc, a) for _h, a, *_ in cols)])


def run_pipeline(input_path: str, output_path: str, cfg: GenConfig,
                 progress: Optional[Callable[[int, int, str], None]] = None,
                 db: Optional[Database] = None) -> Dict[str, Any]:
    t0 = _dt.datetime.now()
    if db is None:
        log.info("Loading %s", input_path)
        db = load_database(input_path)
    log.info("Database: %d messages, %d nodes (%s)", len(db.messages), len(db.nodes), db.loader)
    if cfg.dut_node and db.nodes and cfg.dut_node not in db.nodes:
        log.warning("DUT node '%s' is not defined in BU_ (%s)", cfg.dut_node, ", ".join(db.nodes))
    gen = TestCaseGenerator(db, cfg)
    findings = DbcAuditor(db, gen).run()
    results: List[MessageResult] = []
    total = len(db.messages)
    for i, m in enumerate(db.messages, 1):
        sel, d, status = gen.message_status(m)
        tests: List[TestCase] = []
        if sel:
            try:
                tests = gen.generate(m, d)
            except Exception as exc:  # keep going, record failure
                log.error("Generation failed for %s: %s", m.name, exc)
                log.debug(traceback.format_exc())
                status = f"ERROR – {exc}"
                findings.append(Finding("ERROR", "Generator", m.name, m.id_hex, "", f"Test generation failed: {exc}"))
        results.append(MessageResult(m, d, gen.classify(m), status, tests))
        if progress:
            progress(i, total * 2, f"Generated {m.name} ({len(tests)} tests)")
    out_dir = os.path.dirname(os.path.abspath(output_path))
    os.makedirs(out_dir, exist_ok=True)
    writer = ExcelReportWriter(db, cfg, gen, results, findings)
    gen_count = sum(1 for r in results if r.status.startswith("Generated"))
    writer.write(output_path, (lambda i, n, t: progress(total + int(i * total / max(1, n)), total * 2, t))
                 if progress else None)
    csv_path = ""
    if cfg.export_csv:
        csv_path = os.path.splitext(os.path.abspath(output_path))[0] + "_TestCases.csv"
        write_csv(csv_path, results)
    all_tc = [t for r in results for t in r.tests]
    summary = {
        "output": os.path.abspath(output_path), "csv": csv_path, "messages": total, "generated": gen_count,
        "tests": sum(1 for t in all_tc if t.applicable == "Yes"),
        "na": sum(1 for t in all_tc if t.applicable != "Yes"),
        "by_category": {c: sum(1 for t in all_tc if t.category == c and t.applicable == "Yes") for c in CATEGORIES},
        "violations": {k: v["Total"] for k, v in violation_counts(all_tc).items() if v["Total"]},
        "audit": {s: sum(1 for f in findings if f.severity == s) for s in ("ERROR", "WARNING", "INFO")},
        "seconds": round((_dt.datetime.now() - t0).total_seconds(), 1),
    }
    log.info("Done: %d test cases (%s) for %d messages in %.1f s → %s", summary["tests"],
             ", ".join(f"{k} {v}" for k, v in summary["by_category"].items()), gen_count, summary["seconds"],
             summary["output"])
    return summary


