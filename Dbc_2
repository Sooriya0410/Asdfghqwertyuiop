                row = [res.msg.name, label, res.msg.id_hex, d[NEG], d[SPECIAL], d["Total"], d["N/A"], res.sheet]
                for c, v in enumerate(row, 1):
                    cell = self.put(ws, r, c, v, align=self.top)
                    if c == 8:
