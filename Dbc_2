_Q = r'"((?:[^"\\]|\\.)*)"'


class DbcParser:
    """Robust, dependency-free Vector DBC parser (attributes, relations, mux, FD)."""

    _IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
    _WS = re.compile(r"\s*")
    _BO = re.compile(r"BO_\s+(\d+)\s+(\w+)\s*:\s*(\d+)\s*(\w+)?")
    _SG = re.compile(
        r"SG_\s+(?P<name>\w+)\s*(?P<mux>M|m\d+M?)?\s*:\s*(?P<start>\d+)\s*\|\s*(?P<len>\d+)\s*@\s*"
        r"(?P<order>[01])\s*(?P<sign>[+-])\s*\(\s*(?P<factor>[^,\s]+)\s*,\s*(?P<offset>[^)\s]+)\s*\)\s*"
        r"\[\s*(?P<min>[^|\s]*)\s*\|\s*(?P<max>[^\]\s]*)\s*\]\s*" r'"(?P<unit>(?:[^"\\]|\\.)*)"' r"\s*(?P<rx>.*)$")
    _CM = re.compile(r"CM_\s+(?:(BU_)\s+(\w+)\s+|(BO_)\s+(\d+)\s+|(SG_)\s+(\d+)\s+(\w+)\s+|(EV_)\s+(\w+)\s+)?"
                     + _Q, re.S)
    _BADEF = re.compile(r"BA_DEF_\s+(BU_|BO_|SG_|EV_)?\s*\"([^\"]+)\"\s+(INT|HEX|FLOAT|STRING|ENUM)\s*(.*)", re.S)
    _BADEFREL = re.compile(r"BA_DEF_REL_\s+(BU_SG_REL_|BU_BO_REL_|BU_EV_REL_)\s*\"([^\"]+)\"\s+"
                           r"(INT|HEX|FLOAT|STRING|ENUM)\s*(.*)", re.S)
    _BADEFDEF = re.compile(r"BA_DEF_DEF_(?:REL_)?\s+\"([^\"]+)\"\s+(.*)", re.S)
    _BA = re.compile(r"BA_\s+\"([^\"]+)\"\s+(?:(BU_)\s+(\w+)\s+|(BO_)\s+(\d+)\s+|(SG_)\s+(\d+)\s+(\w+)\s+|"
                     r"(EV_)\s+(\w+)\s+)?(.*)", re.S)
    _BAREL_SG = re.compile(r"BA_REL_\s+\"([^\"]+)\"\s+BU_SG_REL_\s+(\w+)\s+SG_\s+(\d+)\s+(\w+)\s+(.*)", re.S)
    _BAREL_BO = re.compile(r"BA_REL_\s+\"([^\"]+)\"\s+BU_BO_REL_\s+(\w+)\s+(\d+)\s+(.*)", re.S)
    _VAL = re.compile(r"VAL_\s+(\d+)\s+(\w+)\s+(.*)", re.S)
    _VALPAIR = re.compile(r"(-?\d+)\s+" + _Q)
    _VALTYPE = re.compile(r"SIG_VALTYPE_\s+(\d+)\s+(\w+)\s*:?\s*(\d)")
    _TXBU = re.compile(r"BO_TX_BU_\s+(\d+)\s*:\s*(.*)", re.S)
    _MULVAL = re.compile(r"SG_MUL_VAL_\s+(\d+)\s+(\w+)\s+(\w+)\s+(.*)", re.S)

    _STMT_KW = {"CM_", "BA_DEF_", "BA_DEF_DEF_", "BA_", "BA_DEF_REL_", "BA_DEF_DEF_REL_", "BA_REL_", "VAL_",
                "VAL_TABLE_", "SIG_VALTYPE_", "BO_TX_BU_", "SG_MUL_VAL_", "EV_", "ENVVAR_DATA_", "SGTYPE_",
                "SGTYPE_VAL_", "BA_DEF_SGTYPE_", "BA_SGTYPE_", "SIG_TYPE_REF_", "SIG_GROUP_",
                "SIGTYPE_VALTYPE_", "CAT_DEF_", "CAT_", "FILTER", "EV_DATA_", "BU_SG_REL_", "BU_EV_REL_",
                "BU_BO_REL_"}

    def __init__(self) -> None:
        self.db = Database()
        self._msgs: Dict[int, Message] = {}
        self._order: List[int] = []
        self._ba: List[Tuple[str, str, Tuple[str, ...], str]] = []
        self._barel: List[Tuple[str, str, Tuple[str, ...], str]] = []
        self._defaults: Dict[str, str] = {}
        self._comments: List[Tuple[str, Tuple[str, ...], str]] = []
        self._vals: Dict[Tuple[int, str], Dict[int, str]] = {}
        self._valtypes: Dict[Tuple[int, str], int] = {}
        self._txbu: Dict[int, List[str]] = {}
        self._mulval: Dict[Tuple[int, str], Tuple[str, List[int]]] = {}

    # ── entry points ──────────────────────────────────────────────────────
    def parse_file(self, path: str) -> Database:
        with open(path, "rb") as fh:
            raw = fh.read()
        text = None
        for enc in ("utf-8-sig", "cp1252", "latin-1"):
            try:
                text = raw.decode(enc)
                break
            except UnicodeDecodeError:
                continue
        db = self.parse_text(text or "")
        db.source = os.path.abspath(path)
        db.sha256 = hashlib.sha256(raw).hexdigest()
        return db

    def parse_text(self, text: str) -> Database:
        text = text.replace("\r\n", "\n").replace("\r", "\n")
        i, n = 0, len(text)
        current: Optional[Message] = None
        while i < n:
            i = self._WS.match(text, i).end()
            if i >= n:
                break
            m = self._IDENT.match(text, i)
            if not m:
                j = text.find("\n", i)
                i = n if j < 0 else j + 1
                continue
            kw = m.group(0)
            if kw == "NS_":
                nxt = re.compile(r"^[ \t]*BS_", re.M).search(text, m.end())
                i = nxt.start() if nxt else n
                continue
            if kw in ("BO_", "SG_", "BU_", "VERSION", "BS_"):
                j = text.find("\n", i)
                line = text[i:(n if j < 0 else j)].strip()
                i = n if j < 0 else j + 1
                if kw == "BO_":
                    current = self._on_bo(line)
                elif kw == "SG_":
                    self._on_sg(line, current)
                else:
                    current = None
                    if kw == "BU_":
                        mm = re.match(r"BU_\s*:(.*)", line)
                        if mm:
                            self.db.nodes = [x for x in re.split(r"[\s,]+", mm.group(1).strip()) if x]
                    elif kw == "VERSION":
                        mm = re.match(r"VERSION\s+" + _Q, line)
                        self.db.version = mm.group(1) if mm else ""
                continue
            current = None
            if kw in self._STMT_KW:
                stmt, i = self._read_statement(text, i)
                try:
                    self._on_statement(kw, stmt)
                except Exception as exc:  # never abort on one bad line
                    self.db.warnings.append(f"Could not parse '{stmt[:80]}…': {exc}")
            else:
                j = text.find("\n", i)
                i = n if j < 0 else j + 1
        self._finalize()
        return self.db

    # ── scanning ──────────────────────────────────────────────────────────
    @staticmethod
    def _read_statement(text: str, i: int) -> Tuple[str, int]:
        j, n, inq = i, len(text), False
        while j < n:
            c = text[j]
            if inq:
                if c == "\\" and j + 1 < n:
                    j += 2
                    continue
                if c == '"':
                    inq = False
            elif c == '"':
                inq = True
            elif c == ";":
                return text[i:j], j + 1
            j += 1
        return text[i:], n

    @staticmethod
    def _unescape(s: str) -> str:
        return s.replace('\\"', '"').replace("\\\\", "\\")

    # ── line handlers ─────────────────────────────────────────────────────
    def _on_bo(self, line: str) -> Optional[Message]:
        m = self._BO.match(line)
        if not m:
            self.db.warnings.append(f"Unparsed BO_ line: {line[:80]}")
            return None
        raw_id = int(m.group(1))
        tx = m.group(4) or ""
        msg = Message(frame_id=raw_id & 0x1FFFFFFF, name=m.group(2), length=int(m.group(3)),
                      transmitters=[] if tx.lower() in PLACEHOLDER_NODES else [tx],
                      is_extended=bool(raw_id & 0x80000000), dbc_raw_id=raw_id)
        if raw_id in self._msgs:
            self.db.warnings.append(f"Duplicate BO_ id {raw_id} ({msg.name}) – later definition kept")
        else:
            self._order.append(raw_id)
        self._msgs[raw_id] = msg
        return msg

    def _on_sg(self, line: str, msg: Optional[Message]) -> None:
        m = self._SG.match(line)
        if not m:
            self.db.warnings.append(f"Unparsed SG_ line: {line[:100]}")
            return
        if msg is None:
            self.db.warnings.append(f"Signal {m.group('name')} outside a BO_ block – ignored")
            return
        rx = [r for r in re.split(r"[,\s]+", m.group("rx").strip()) if r and r.lower() not in PLACEHOLDER_NODES]
        sig = Signal(name=m.group("name"), start=int(m.group("start")), length=int(m.group("len")),
                     byte_order="Intel" if m.group("order") == "1" else "Motorola",
                     is_signed=m.group("sign") == "-", factor=to_dec(m.group("factor"), Decimal(1)),
                     offset=to_dec(m.group("offset")), minimum=to_dec(m.group("min")),
                     maximum=to_dec(m.group("max")), unit=self._unescape(m.group("unit")), receivers=rx,
                     mux_indicator=m.group("mux") or "")
        mux = sig.mux_indicator
        if mux == "M":
            sig.is_switch = True
        elif mux:
            mm = re.match(r"m(\d+)(M?)", mux)
            sig.mux_values = [int(mm.group(1))]
            sig.is_switch = bool(mm.group(2))
        msg.signals.append(sig)

    def _on_statement(self, kw: str, stmt: str) -> None:
        if kw == "CM_":
            m = self._CM.match(stmt)
            if m:
                txt = self._unescape(m.group(10))
                if m.group(1):
                    self._comments.append(("BU_", (m.group(2),), txt))
                elif m.group(3):
                    self._comments.append(("BO_", (m.group(4),), txt))
                elif m.group(5):
                    self._comments.append(("SG_", (m.group(6), m.group(7)), txt))
                elif not m.group(8):
                    self.db.comment = txt
        elif kw == "BA_DEF_":
            m = self._BADEF.match(stmt)
            if m:
                self._add_def(self.db.attr_defs, m.group(1) or "", m.group(2), m.group(3), m.group(4))
        elif kw == "BA_DEF_REL_":
            m = self._BADEFREL.match(stmt)
            if m:
                self._add_def(self.db.rel_attr_defs, m.group(1), m.group(2), m.group(3), m.group(4))
        elif kw in ("BA_DEF_DEF_", "BA_DEF_DEF_REL_"):
            m = self._BADEFDEF.match(stmt)
            if m:
                self._defaults[m.group(1)] = m.group(2).strip()
        elif kw == "BA_":
            m = self._BA.match(stmt)
            if m:
                name, val = m.group(1), m.group(11).strip()
                if m.group(2):
                    self._ba.append((name, "BU_", (m.group(3),), val))
                elif m.group(4):
                    self._ba.append((name, "BO_", (m.group(5),), val))
                elif m.group(6):
                    self._ba.append((name, "SG_", (m.group(7), m.group(8)), val))
                elif not m.group(9):
                    self._ba.append((name, "", (), val))
        elif kw == "BA_REL_":
            m = self._BAREL_SG.match(stmt)
            if m:
                self._barel.append((m.group(1), "SG", (m.group(2), m.group(3), m.group(4)), m.group(5).strip()))
            else:
                m = self._BAREL_BO.match(stmt)
                if m:
                    self._barel.append((m.group(1), "BO", (m.group(2), m.group(3)), m.group(4).strip()))
        elif kw == "VAL_":
            m = self._VAL.match(stmt)
            if m:
                self._vals[(int(m.group(1)), m.group(2))] = {
                    int(k): self._unescape(v) for k, v in self._VALPAIR.findall(m.group(3))}
        elif kw == "SIG_VALTYPE_":
            m = self._VALTYPE.match(stmt)
            if m:
                self._valtypes[(int(m.group(1)), m.group(2))] = int(m.group(3))
        elif kw == "BO_TX_BU_":
            m = self._TXBU.match(stmt)
            if m:
                self._txbu[int(m.group(1))] = [x for x in re.split(r"[,\s]+", m.group(2).strip())
                                               if x and x.lower() not in PLACEHOLDER_NODES]
        elif kw == "SG_MUL_VAL_":
            m = self._MULVAL.match(stmt)
            if m:
                vals: List[int] = []
                for a, b in re.findall(r"(\d+)\s*-\s*(\d+)", m.group(4)):
                    a_i, b_i = int(a), int(b)
                    vals.extend(range(a_i, min(b_i, a_i + 1023) + 1))
                self._mulval[(int(m.group(1)), m.group(2))] = (m.group(3), vals)

    @staticmethod
    def _add_def(target: Dict[str, AttrDef], obj: str, name: str, vtype: str, rest: str) -> None:
        d = AttrDef(name=name, obj=obj, vtype=vtype)
        rest = rest.strip()
        if vtype == "ENUM":
            d.enum = [DbcParser._unescape(x) for x in re.findall(_Q, rest)]
        elif vtype in ("INT", "HEX", "FLOAT"):
            nums = rest.split()
            if len(nums) >= 2:
                d.minimum, d.maximum = to_dec(nums[0], None), to_dec(nums[1], None)
        target[name] = d

    # ── post-processing ───────────────────────────────────────────────────
    def _finalize(self) -> None:
        db = self.db
        for name, tok in self._defaults.items():
            d = db.attr_defs.get(name) or db.rel_attr_defs.get(name)
            if d:
                d.default = d.coerce(tok)
        defaults = {k: {d.name: d.default for d in db.attr_defs.values() if d.obj == k and d.default is not None}
                    for k in ("", "BU_", "BO_", "SG_")}
        db.network_attrs = dict(defaults[""])
        for m in self._msgs.values():
            m.attributes = dict(defaults["BO_"])
            for s in m.signals:
                s.attributes = dict(defaults["SG_"])

        def coerce(name: str, tok: str, rel: bool = False) -> Any:
            d = (db.rel_attr_defs if rel else db.attr_defs).get(name)
            return d.coerce(tok) if d else guess_value(tok)

        for name, kind, key, tok in self._ba:
            val = coerce(name, tok)
            if kind == "":
                db.network_attrs[name] = val
            elif kind == "BU_":
                db.node_attrs.setdefault(key[0], {})[name] = val
            elif kind == "BO_":
                msg = self._msgs.get(int(key[0]))
                if msg:
                    msg.attributes[name] = val
                    msg.explicit_attrs.add(name)
            elif kind == "SG_":
                msg = self._msgs.get(int(key[0]))
                sig = msg.sig(key[1]) if msg else None
                if sig:
                    sig.attributes[name] = val
                    sig.explicit_attrs.add(name)
        for name, kind, key, tok in self._barel:
            val = coerce(name, tok, rel=True)
            if kind == "SG":
                msg = self._msgs.get(int(key[1]))
                sig = msg.sig(key[2]) if msg else None
                if sig:
                    sig.rel_attributes.setdefault(name, {})[key[0]] = val
            else:
                msg = self._msgs.get(int(key[1]))
                if msg:
                    msg.rel_attributes.setdefault(name, {})[key[0]] = val
        for kind, key, txt in self._comments:
            if kind == "BU_":
                db.node_comments[key[0]] = txt
            elif kind == "BO_":
                msg = self._msgs.get(int(key[0]))
                if msg:
                    msg.comment = txt
            elif kind == "SG_":
                msg = self._msgs.get(int(key[0]))
                sig = msg.sig(key[1]) if msg else None
                if sig:
                    sig.comment = txt

        bus_fd = "FD" in str(db.network_attrs.get("BusType", "")).upper()
        # Vector stores names > 32 characters in System*LongSymbol attributes
        node_map = {n: str(v) for n, a in db.node_attrs.items()
                    for v in [attr_get(a, "SystemNodeLongSymbol")] if v}
        db.nodes = [node_map.get(n, n) for n in db.nodes]
        db.node_comments = {node_map.get(k, k): v for k, v in db.node_comments.items()}
        for raw_id in self._order:
            msg = self._msgs[raw_id]
            if msg.name.upper().startswith("VECTOR__INDEPENDENT_SIG_MSG"):
                continue
            for tx in self._txbu.get(raw_id, []):
                if tx not in msg.transmitters:
                    msg.transmitters.append(tx)
            vff = str(msg.attr("VFrameFormat", default="") or "").upper()
            if "FD" in vff:
                msg.is_fd = True
            if "EXTENDED" in vff or "J1939" in vff:
                msg.is_extended = True
            if msg.length > 8 and not msg.is_fd:
                msg.is_fd = True
                msg.notes.append("Length > 8 bytes but VFrameFormat is not CAN FD – treated as CAN FD"
                                 + (" (BusType = CAN FD)" if bus_fd else ""))
            if msg.is_fd:
                brs = msg.attr("CANFD_BRS")
                msg.brs = True if brs is None else is_yes(brs)
            for s in msg.signals:
                s.float_kind = self._valtypes.get((raw_id, s.name), 0)
                s.choices = self._vals.get((raw_id, s.name), {})
                mv = self._mulval.get((raw_id, s.name))
                if mv:
                    s.mux_parent, s.mux_values = mv
            plain_switches = [s for s in msg.signals if s.mux_indicator == "M"]
            any_switch = [s for s in msg.signals if s.is_switch]
            default_switch = (plain_switches or any_switch or [None])[0]
            for s in msg.signals:
                if s.mux_values and s.mux_parent is None and default_switch is not None and s is not default_switch:
                    s.mux_parent = default_switch.name
            msg.signals.sort(key=lambda s: (min(bits_of(s)) if s.length > 0 else 0,
                                            s.mux_values[0] if s.mux_values else -1))
            long_msg = msg.attr("SystemMessageLongSymbol")
            if long_msg:
                msg.name = str(long_msg)
            msg.transmitters = [node_map.get(t, t) for t in msg.transmitters]
            sig_map: Dict[str, str] = {}
            for s in msg.signals:
                long_sig = s.attr("SystemSignalLongSymbol")
                if long_sig:
                    sig_map[s.name] = str(long_sig)
                    s.name = str(long_sig)
                s.receivers = [node_map.get(r, r) for r in s.receivers]
                s.rel_attributes = {k: {node_map.get(n, n): v for n, v in d.items()}
                                    for k, d in s.rel_attributes.items()}
            for s in msg.signals:
                if s.mux_parent in sig_map:
                    s.mux_parent = sig_map[s.mux_parent]
            for i, s in enumerate(msg.signals, 1):
                s.ref = f"S{i}"
            db.messages.append(msg)
        db.messages.sort(key=lambda m: (m.is_extended, m.frame_id))


# ════════════════════════════════════════════════════════════════════════════
#  ARXML / generic loader (cantools adapter)
# ════════════════════════════════════════════════════════════════════════════
def load_via_cantools(path: str) -> Database:
    try:
        import cantools  # type: ignore
    except ImportError as exc:
        raise RuntimeError("ARXML input needs the 'cantools' package (pip install cantools), "
                           "or export a DBC from your ARXML tool.") from exc
    cdb = cantools.database.load_file(path, strict=False)
    db = Database(source=os.path.abspath(path), loader=f"cantools {cantools.__version__}")
    with open(path, "rb") as fh:
        db.sha256 = hashlib.sha256(fh.read()).hexdigest()
    db.nodes = [n.name for n in getattr(cdb, "nodes", [])]
    for cm in cdb.messages:
        msg = Message(frame_id=cm.frame_id, name=cm.name, length=cm.length,
                      transmitters=[s for s in (cm.senders or []) if s.lower() not in PLACEHOLDER_NODES],
                      is_extended=bool(cm.is_extended_frame), is_fd=bool(getattr(cm, "is_fd", False)),
                      comment=str(cm.comment or ""))
        msg.brs = msg.is_fd
        if cm.cycle_time:
            msg.attributes["GenMsgCycleTime"] = int(cm.cycle_time)
        if getattr(cm, "send_type", None):
            msg.attributes["GenMsgSendType"] = str(cm.send_type)
        for cs in cm.signals:
            raw_init = getattr(cs, "raw_initial", None)
            if raw_init is None:
                raw_init = getattr(cs, "initial", None)
            s = Signal(name=cs.name, start=cs.start, length=cs.length,
                       byte_order="Intel" if cs.byte_order == "little_endian" else "Motorola",
                       is_signed=bool(cs.is_signed), factor=to_dec(repr(cs.scale), Decimal(1)),
                       offset=to_dec(repr(cs.offset)),
                       minimum=to_dec(repr(cs.minimum)) if cs.minimum is not None else Decimal(0),
                       maximum=to_dec(repr(cs.maximum)) if cs.maximum is not None else Decimal(0),
                       unit=cs.unit or "", receivers=[r for r in (cs.receivers or [])
                                                      if r.lower() not in PLACEHOLDER_NODES],
                       comment=str(cs.comment or ""))
            s.float_kind = (2 if cs.length == 64 else 1) if cs.is_float else 0
            s.choices = {int(k): str(v) for k, v in (cs.choices or {}).items()}
            if raw_init is not None:
                s.attributes["GenSigStartValue"] = raw_init
                s.explicit_attrs.add("GenSigStartValue")
            if cs.is_multiplexer:
                s.is_switch = True
                s.mux_indicator = "M"
            if cs.multiplexer_ids:
                s.mux_values = list(cs.multiplexer_ids)
                s.mux_parent = cs.multiplexer_signal
                s.mux_indicator = f"m{s.mux_values[0]}" + ("M" if s.is_switch else "")
            msg.signals.append(s)
        msg.signals.sort(key=lambda s: (min(bits_of(s)) if s.length > 0 else 0,
                                        s.mux_values[0] if s.mux_values else -1))
        for i, s in enumerate(msg.signals, 1):
            s.ref = f"S{i}"
        db.messages.append(msg)
    db.messages.sort(key=lambda m: (m.is_extended, m.frame_id))
    return db


def load_database(path: str, engine: str = "auto") -> Database:
    ext = os.path.splitext(path)[1].lower()
    if engine == "cantools" or ext in (".arxml", ".xml", ".kcd", ".sym"):
        return load_via_cantools(path)
    return DbcParser().parse_file(path)


# ════════════════════════════════════════════════════════════════════════════
#  Bit layout & encoding
# ════════════════════════════════════════════════════════════════════════════
@lru_cache(maxsize=131072)
def signal_bit_positions(start: int, length: int, intel: bool) -> Tuple[int, ...]:
    """Sawtooth bit positions (byte*8 + bit, bit0 = LSB of the byte), ordered LSB → MSB."""
    if length <= 0:
        return ()
    if intel:
        return tuple(range(start, start + length))
    pos, out = start, []
    for _ in range(length):
        out.append(pos)
        pos = pos + 15 if pos % 8 == 0 else pos - 1
    out.reverse()
    return tuple(out)


def bits_of(sig: Signal) -> Tuple[int, ...]:
    return signal_bit_positions(sig.start, sig.length, sig.byte_order == "Intel")


def raw_to_unsigned(sig: Signal, raw: Any) -> int:
    if sig.float_kind == 1:
        f = float(raw)
        if not math.isnan(f) and abs(f) > 3.4028234663852886e38:
            f = math.copysign(math.inf, f)  # beyond float32 range → ±Inf (what an IEEE cast would give)
        return struct.unpack("<I", struct.pack("<f", f))[0]
    if sig.float_kind == 2:
        return struct.unpack("<Q", struct.pack("<d", float(raw)))[0]
    return int(raw) & ((1 << sig.length) - 1)


def unsigned_to_raw(sig: Signal, u: int) -> Any:
    if sig.float_kind == 1:
        return struct.unpack("<f", struct.pack("<I", u & 0xFFFFFFFF))[0]
    if sig.float_kind == 2:
        return struct.unpack("<d", struct.pack("<Q", u & 0xFFFFFFFFFFFFFFFF))[0]
    if sig.is_signed and sig.length > 0 and u & (1 << (sig.length - 1)):
        return u - (1 << sig.length)
    return u


def encode_into(data: bytearray, sig: Signal, raw: Any) -> None:
    """Write raw value into payload according to DBC layout (bits beyond payload are dropped)."""
    u = raw_to_unsigned(sig, raw)
    nbits = len(data) * 8
    for i, p in enumerate(bits_of(sig)):
        if 0 <= p < nbits:
            if (u >> i) & 1:
                data[p >> 3] |= (1 << (p & 7))
            else:
                data[p >> 3] &= ~(1 << (p & 7)) & 0xFF


def decode_from(data: Sequence[int], sig: Signal) -> Any:
    u, nbits = 0, len(data) * 8
    for i, p in enumerate(bits_of(sig)):
        if 0 <= p < nbits and (data[p >> 3] >> (p & 7)) & 1:
            u |= 1 << i
    return unsigned_to_raw(sig, u)


def raw_hex(sig: Signal, raw: Any) -> str:
    if raw is None or raw == "":
        return ""
    u = raw_to_unsigned(sig, raw)
    nd = max(1, (sig.length + 3) // 4) if not sig.is_float else (8 if sig.float_kind == 1 else 16)
    return f"0x{u:0{nd}X}"


def byteswap_raw(sig: Signal, raw: int) -> int:
    nb = (sig.length + 7) // 8
    mask = (1 << sig.length) - 1
    u = int(raw) & mask
    sw = int.from_bytes(u.to_bytes(nb, "big")[::-1], "big") & mask
    return unsigned_to_raw(sig, sw)


def shifted_signal(sig: Signal, nbits: int) -> Optional[Signal]:
    """Same signal moved one bit towards higher significance in the frame (layout mismatch)."""
    if sig.byte_order == "Intel":
        ns = replace(sig, start=sig.start + 1)
    else:
        lin = (sig.start // 8) * 8 + (7 - sig.start % 8) + 1
        ns = replace(sig, start=(lin // 8) * 8 + (7 - lin % 8))
    return ns if max(bits_of(ns)) < nbits else None


# ════════════════════════════════════════════════════════════════════════════
#  Value ranges
# ════════════════════════════════════════════════════════════════════════════
@dataclass
class RawBounds:
    tmin: int
    tmax: int
    lo: int
    hi: int
    r_pmin: int          # raw value at physical minimum
    r_pmax: int          # raw value at physical maximum
    step: int            # raw delta for +1 LSB in physical direction
    defined: bool        # DBC min/max defined (not 0|0)
    valid: bool
    notes: List[str] = field(default_factory=list)

    def ok(self, raw: Optional[int]) -> bool:
        return raw is not None and self.lo <= raw <= self.hi

    def in_type(self, raw: Optional[int]) -> bool:
        return raw is not None and self.tmin <= raw <= self.tmax


def compute_bounds(sig: Signal) -> RawBounds:
    tmin, tmax = sig.raw_type_min, sig.raw_type_max
    notes: List[str] = []
    f = sig.factor
    if f == 0:
        return RawBounds(tmin, tmax, tmin, tmax, tmin, tmax, 1, False, False, ["Factor is 0 – physical value undefined"])
    defined = not (sig.minimum == 0 and sig.maximum == 0)
    if defined and sig.minimum > sig.maximum:
        notes.append("Min > Max in DBC – raw type range used")
        defined = False
    if defined:
        a = (sig.minimum - sig.offset) / f
        b = (sig.maximum - sig.offset) / f
        lo_x, hi_x = (a, b) if f > 0 else (b, a)
        lo = int(lo_x.to_integral_value(rounding=ROUND_CEILING))
        hi = int(hi_x.to_integral_value(rounding=ROUND_FLOOR))
        if lo != lo_x or hi != hi_x:
            notes.append("Physical min/max not on the factor grid – nearest valid raw values used")
        if lo < tmin:
            notes.append(f"DBC range extends below raw type minimum {tmin} – clamped")
            lo = tmin
        if hi > tmax:
            notes.append(f"DBC range extends above raw type maximum {tmax} – clamped")
            hi = tmax
    else:
        lo, hi = tmin, tmax
        if not notes:
            notes.append("Min/Max undefined in DBC (0|0) – full raw range treated as valid")
    valid = lo <= hi
    if not valid:
        notes.append("No raw value satisfies DBC min/max")
    if f > 0:
        return RawBounds(tmin, tmax, lo, hi, lo, hi, 1, defined, valid, notes)
    return RawBounds(tmin, tmax, lo, hi, hi, lo, -1, defined, valid, notes)


