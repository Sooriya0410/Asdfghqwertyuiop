# ════════════════════════════════════════════════════════════════════════════
class DbcAuditor:
    def __init__(self, db: Database, gen: TestCaseGenerator) -> None:
        self.db, self.gen = db, gen
        self.findings: List[Finding] = []

    def add(self, sev: str, check: str, m: Optional[Message], s: Optional[Signal], detail: str) -> None:
        self.findings.append(Finding(sev, check, m.name if m else "", m.id_hex if m else "", s.name if s else "", detail))

    def run(self) -> List[Finding]:
        for w in self.db.warnings:
            self.add("WARNING", "Parser", None, None, w)
        seen: Dict[Tuple[int, bool], Message] = {}
        for m in self.db.messages:
            key = (m.frame_id, m.is_extended)
            if key in seen:
                self.add("ERROR", "Duplicate CAN ID", m, None, f"Same ID as {seen[key].name}")
            seen[key] = m
            self._message(m)
        order = {"ERROR": 0, "WARNING": 1, "INFO": 2}
        self.findings.sort(key=lambda f: (order.get(f.severity, 3), f.can_id, f.signal))
        return self.findings

    def _message(self, m: Message) -> None:
        for n in m.notes:
            self.add("WARNING", "Frame format", m, None, n)
        if not m.signals:
            self.add("WARNING", "Empty message", m, None, "Message has no signals")
        if not m.transmitters:
            self.add("WARNING", "Transmitter", m, None, "No transmitter node (Vector__XXX)")
        if not m.is_extended and m.frame_id > 0x7FF:
            self.add("ERROR", "Identifier", m, None, f"Standard ID {m.id_hex} > 0x7FF")
        if m.is_fd and m.length not in CANFD_LENGTHS:
            self.add("ERROR", "Length", m, None, f"Length {m.length} B is not a valid CAN FD length")
        if not m.is_fd and m.length > 8:
            self.add("ERROR", "Length", m, None, f"Classic CAN length {m.length} > 8")
        st = m.send_type.lower()
        if "cyclic" in st and m.cycle_time <= 0:
            self.add("WARNING", "Cycle time", m, None, f"GenMsgSendType '{m.send_type}' but no GenMsgCycleTime")
        ctx = MsgContext(m, self.gen.cfg)
        nbits = m.length * 8
        owners: Dict[int, List[Signal]] = {}
        for s in m.signals:
            for p in bits_of(s):
                owners.setdefault(p, []).append(s)
        reported: Set[Tuple[str, str]] = set()
        for p, sigs in owners.items():
            for i in range(len(sigs)):
                for j in range(i + 1, len(sigs)):
                    a, b = sigs[i], sigs[j]
                    if self._exclusive(ctx, a, b):
                        continue
                    k = (a.name, b.name)
                    if k not in reported:
                        reported.add(k)
                        self.add("ERROR", "Signal overlap", m, a, f"Overlaps {b.name} (first at {bitpos_str(p)})")
        for s in m.signals:
            bits = bits_of(s)
            if s.length <= 0:
                self.add("ERROR", "Length", m, s, "Signal length 0")
                continue
            if max(bits) >= nbits:
                self.add("ERROR", "Exceeds DLC", m, s, f"Highest bit {bitpos_str(max(bits))} beyond {m.length} B payload")
            if s.float_kind == 1 and s.length != 32 or s.float_kind == 2 and s.length != 64:
                self.add("ERROR", "Float length", m, s, f"{s.value_type} with length {s.length}")
            if s.factor == 0:
                self.add("ERROR", "Factor", m, s, "Factor = 0")
                continue
            if s.is_signed and s.length == 1:
                self.add("INFO", "Signed 1 bit", m, s, "1-bit signed signal (range -1..0)")
            if s.is_float:
                continue
            b = ctx.bounds[s.name]
            for note in b.notes:
                sev = "INFO" if note.startswith("Min/Max undefined") else "WARNING"
                self.add(sev, "Range", m, s, note)
            if s.name in ctx.init_note:
                self.add("WARNING", "Initial value", m, s, ctx.init_note[s.name])
            iv = s.attr("GenSigInactiveValue")
            if s.has_explicit("GenSigInactiveValue") and iv is not None:
                try:
                    if not b.in_type(int(Decimal(str(iv)))):
                        self.add("WARNING", "Inactive value", m, s, f"GenSigInactiveValue {iv} not representable")
                except (InvalidOperation, ValueError):
                    pass
            for r in s.choices:
                if not b.in_type(r):
                    self.add("WARNING", "Value table", m, s, f"Value {r} '{s.choices[r]}' not representable")
            if not s.receivers:
                self.add("INFO", "Receivers", m, s, "Signal has no receiver node")
            to, src = self.gen.signal_timeout(s)
            if to and m.cycle_time and to < m.cycle_time:
                self.add("WARNING", "Timeout", m, s, f"Timeout {to} ms ({src}) < cycle time {m.cycle_time} ms")

    @staticmethod
    def _exclusive(ctx: MsgContext, a: Signal, b: Signal) -> bool:
        if a.mux_parent and b.mux_parent and a.mux_parent == b.mux_parent:
            return not (set(a.mux_values) & set(b.mux_values))
        if a.is_switch and b.mux_parent == a.name or b.is_switch and a.mux_parent == b.name:
            return False
        return False


