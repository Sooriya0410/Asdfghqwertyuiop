def _mk(start: int, length: int, intel: bool, signed: bool = False, kind: int = 0) -> Signal:
    s = Signal("T", start, length, "Intel" if intel else "Motorola", signed, Decimal(1), Decimal(0),
               Decimal(0), Decimal(0))
    s.float_kind = kind
    return s


class SelfTests(unittest.TestCase):
    db: Database

    @classmethod
    def setUpClass(cls) -> None:
        cls.db = DbcParser().parse_text(DEMO_DBC)

    # bit packing
    def test_intel_known_vector(self) -> None:
        d = bytearray(8)
        encode_into(d, _mk(0, 16, True), 0x1234)
        self.assertEqual(d[:2], bytearray([0x34, 0x12]))

    def test_motorola_known_vector(self) -> None:
        d = bytearray(8)
        encode_into(d, _mk(7, 16, False), 0x1234)
        self.assertEqual(d[:2], bytearray([0x12, 0x34]))

    def test_motorola_cross_byte(self) -> None:
        d = bytearray(8)
        encode_into(d, _mk(4, 12, False), 0xABC)
        self.assertEqual(d[:2], bytearray([0x15, 0x78]))

    def test_roundtrip_random(self) -> None:
        rnd = random.Random(1234)
        for _ in range(3000):
            L = rnd.choice([8, 64])
            n = rnd.randint(1, 32)
            intel = rnd.random() < 0.5
            signed = rnd.random() < 0.5
            start = rnd.randint(0, L * 8 - 1)
            s = _mk(start, n, intel, signed)
            if max(bits_of(s)) >= L * 8 or min(bits_of(s)) < 0:
                continue
            v = rnd.randint(s.raw_type_min, s.raw_type_max)
            d = bytearray(rnd.getrandbits(8) for _ in range(L))
            before = bytes(d)
            encode_into(d, s, v)
            self.assertEqual(decode_from(d, s), v)
            others = set(range(L * 8)) - set(bits_of(s))
            for p in others:
                self.assertEqual((d[p >> 3] >> (p & 7)) & 1, (before[p >> 3] >> (p & 7)) & 1)

    def test_signed_and_float(self) -> None:
        d = bytearray(8)
        s = _mk(3, 12, True, True)
        encode_into(d, s, -5)
        self.assertEqual(decode_from(d, s), -5)
        f = _mk(0, 32, True, True, kind=1)
        encode_into(d, f, 1.5)
        self.assertEqual(decode_from(d, f), 1.5)

    def test_bounds(self) -> None:
        s = _mk(0, 16, True)
        s.factor, s.maximum = Decimal("0.25"), Decimal(16000)
        b = compute_bounds(s)
        self.assertEqual((b.lo, b.hi, b.r_pmin, b.r_pmax), (0, 64000, 0, 64000))
        s.factor, s.minimum, s.maximum = Decimal(-1), Decimal(-10), Decimal(10)
        b = compute_bounds(s)
        self.assertEqual((b.r_pmin, b.r_pmax, b.step), (10, 0, -1))  # raw ≥ 0 → phys ≤ 0, clamped
        s = _mk(0, 8, True, True)
        s.factor, s.minimum, s.maximum = Decimal(1), Decimal(-200), Decimal(200)
        b = compute_bounds(s)
        self.assertEqual((b.lo, b.hi), (-128, 127))

