        self.put(ws, r, 1, "Violation summary – why each negative test is negative", self.title_font, border=False)
        r += 2
        self.section(ws, r, "1. Count per violation type (all messages)", 8)
        r += 1
        self.header(ws, r, ["Violation type", "Meaning", NEG, SPECIAL, "Total", "N/A", "Messages", "Example TC"])
        r += 1
        for label, d in vc.items():
            msgs = {t.message for t in all_tc if t.violation == label and t.applicable == "Yes"}
            ex = next((t.tc_id for t in all_tc if t.violation == label and t.applicable == "Yes"), "-")
            row = [label, VIOLATIONS.get(label, ""), d[NEG], d[SPECIAL], d["Total"], d["N/A"], len(msgs), ex]
            for c, v in enumerate(row, 1):
