def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="can_testcase_generator",
                                description=f"{TOOL_NAME} v{__version__} – DBC/ARXML → CAN test case workbook")
    p.add_argument("input", nargs="?", help="DBC or ARXML file (omit to start the GUI)")
    p.add_argument("-o", "--output", help="output .xlsx (default: <input>_CAN_TestCases.xlsx)")
    p.add_argument("--dut", default="", help="DUT node name (BU_); empty = every message is DUT-Rx stimulus")
    p.add_argument("--filter", default="", help="regex on message name, or IDs like '0x100,0x12C'")
    p.add_argument("--tol", type=float, default=10.0, help="cycle-time tolerance in %% (default 10)")
    p.add_argument("--res", type=int, default=1, help="timing resolution in ms (default 1)")
    p.add_argument("--timeout-factor", type=float, default=3.0, help="timeout = N x cycle when DBC has none")
    p.add_argument("--duration", type=int, default=2000, help="stimulus duration in ms (default 2000)")
    p.add_argument("--burst", type=int, default=20, help="frames per burst test (default 20)")
    p.add_argument("--max-enum", type=int, default=32, help="max value-table entries tested per signal")
    p.add_argument("--padding", default="0x00", help="padding byte for unused bits (default 0x00)")
    p.add_argument("--no-na", action="store_true", help="omit N/A rows")
    p.add_argument("--no-layout", action="store_true", help="omit layout/byte-order tests")
    p.add_argument("--no-e2e", action="store_true", help="omit counter/CRC tests")
    p.add_argument("--no-combo", action="store_true", help="omit signal combination tests")
    p.add_argument("--bitwalk", action="store_true", help="add a bit-walk test for every signal bit")
    p.add_argument("--include-diag", action="store_true", help="also generate for diagnostic messages")
    p.add_argument("--include-unrelated", action="store_true", help="include messages the DUT neither sends nor receives")
    p.add_argument("--no-csv", action="store_true", help="do not write the CSV export")
    p.add_argument("--no-all-sheet", action="store_true", help="do not write the All_TestCases sheet")
    p.add_argument("--engine", choices=["auto", "cantools"], default="auto", help="force the cantools loader")
    p.add_argument("--list-nodes", action="store_true", help="list nodes/messages and exit")
    p.add_argument("--selftest", action="store_true", help="run the built-in self-test suite")
    p.add_argument("--demo", metavar="XLSX", help="write the demo DBC next to XLSX and generate from it")
    p.add_argument("--gui", action="store_true", help="start the GUI")
    p.add_argument("-v", "--verbose", action="store_true")
    return p


def cfg_from_args(a: argparse.Namespace) -> GenConfig:
    pad = a.padding.strip()
    return GenConfig(dut_node=a.dut, include_unrelated=a.include_unrelated, skip_diag=not a.include_diag,
                     message_filter=a.filter, cycle_tol_pct=a.tol, time_res_ms=a.res, timeout_factor=a.timeout_factor,
                     stim_duration_ms=a.duration, burst_count=a.burst, max_enum_cases=a.max_enum,
                     padding_byte=int(pad, 16) if pad.lower().startswith("0x") else int(pad),
                     include_na_rows=not a.no_na, include_layout=not a.no_layout, include_e2e=not a.no_e2e,
                     include_combination=not a.no_combo, include_bitwalk=a.bitwalk,
                     consolidated_sheet=not a.no_all_sheet, export_csv=not a.no_csv)


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        return launch_gui()
    a = build_arg_parser().parse_args(argv)
    logging.basicConfig(level=logging.DEBUG if a.verbose else logging.INFO,
                        format="%(asctime)s %(levelname)-7s %(message)s", datefmt="%H:%M:%S")
    if a.gui:
        return launch_gui()
    if a.selftest:
        return run_selftest()
    if a.demo:
        out = os.path.abspath(a.demo)
        dbc = os.path.splitext(out)[0] + "_demo.dbc"
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(dbc, "w", encoding="utf-8") as fh:
            fh.write(DEMO_DBC)
        cfg = cfg_from_args(a)
        if not a.dut:
            cfg.dut_node = "IPC"
        run_pipeline(dbc, out, cfg, progress=None)
        print(f"Demo DBC : {dbc}\nWorkbook : {out}")
        return 0
    if not a.input:
        build_arg_parser().print_help()
        return 2
    db = load_database(a.input, a.engine)
    if a.list_nodes:
        print(f"Nodes: {', '.join(db.nodes)}")
        for m in db.messages:
            print(f"  {m.id_hex:>11}  {m.name:<32} DLC {m.dlc_code:<2} {m.frame_type:<6} "
                  f"cycle {m.cycle_time or '-':<5} Tx {','.join(m.transmitters) or '-'}  ({len(m.signals)} signals)")
        return 0
    out = a.output or os.path.splitext(a.input)[0] + "_CAN_TestCases.xlsx"

    def cli_progress(i: int, n: int, t: str) -> None:
        pct = int(100 * i / max(1, n))
        sys.stderr.write(f"\r[{pct:3d}%] {t[:70]:<70}")
        if i >= n:
            sys.stderr.write("\n")

    s = run_pipeline(a.input, out, cfg_from_args(a), progress=cli_progress, db=db)
    sys.stderr.write("\n")
    print(json.dumps(s, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
