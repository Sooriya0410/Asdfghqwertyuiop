        tot = [sum(d[k] for d in vc.values()) for k in (NEG, SPECIAL, "Total", "N/A")]
        for c, v in enumerate(["TOTAL", ""] + tot + ["", ""], 1):
            self.put(ws, r, c, v, self.bold, self.label_fill)
        r += 3
        self.section(ws, r, "2. Count per message and violation type (applicable tests)", 8)
        r += 1
        hdr = r
        self.header(ws, r, ["Message", "Violation type", "CAN ID", NEG, SPECIAL, "Total", "N/A", "Sheet"])
        r += 1
