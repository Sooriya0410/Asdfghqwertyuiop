    def test_dut_timeouts(self) -> None:
        ems = next(m for m in self.db.messages if m.name == "EMS_EngineData")
        tos = TestCaseGenerator(self.db, GenConfig(dut_node="IPC")).timeouts_of(ems)
        self.assertEqual(sorted(tos), [500, 1000])  # ESP-only ThrottlePos timeout must not leak in
