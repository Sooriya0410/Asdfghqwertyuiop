        self.assertIn("E2E.EMS_AliveCounter.WRAP", tcs)
        self.assertIn("E2E.EMS_CRC.CORRUPTED", tcs)
        self.assertEqual(tcs["DLC.SHORT_7"].data_len, 7)
        self.assertEqual(tcs["TIM.TOL_LOW"].cycle_ms, 9)
        self.assertEqual(tcs["TIM.TOL_HIGH"].cycle_ms, 11)
        self.assertIn("TO.ABOVE_500", tcs)  # max over receivers (no DUT)
        self.assertEqual(tol_bounds(100, 10), (90, 110))
        self.assertEqual(tol_bounds(15, 10), (13, 17))

    def test_excel_roundtrip(self) -> None:
        from openpyxl import load_workbook
        with tempfile.TemporaryDirectory() as td:
            dbc = os.path.join(td, "demo.dbc")
            with open(dbc, "w", encoding="utf-8") as fh:
                fh.write(DEMO_DBC)
            out = os.path.join(td, "out.xlsx")
            summ = run_pipeline(dbc, out, GenConfig(dut_node="IPC"))
            self.assertGreater(summ["tests"], 100)
            wb = load_workbook(out, read_only=True)
            self.assertEqual(wb.sheetnames[:6], ["Summary", "Violation_Summary", "Message_Index", "DBC_Audit",
                                                 "All_TestCases", "Legend"])
            self.assertEqual(len(wb.sheetnames), 6 + summ["generated"])
            labels = [r[0] for r in wb["Summary"].iter_rows(values_only=True) if r]
            self.assertNotIn("SHA-256", labels)
            self.assertIn("Range – above DBC maximum", labels)
            self.assertGreater(summ["violations"]["Range – above DBC maximum"], 0)
            self.assertTrue(os.path.exists(summ["csv"]))

    def test_cross_check_cantools(self) -> None:
        try:
            import cantools  # type: ignore
        except ImportError:
            self.skipTest("cantools not installed")
        cdb = cantools.database.load_string(DEMO_DBC, "dbc", strict=False)
        rnd = random.Random(7)
        for m in self.db.messages:
            cm = cdb.get_message_by_name(m.name)
            ctx = MsgContext(m, GenConfig())
            for _ in range(50):
                vals: Dict[str, Any] = {}
                for s in m.signals:
                    if not ctx.fits[s.name] or s.mux_parent:
                        continue
                    if s.is_float:
                        vals[s.name] = rnd.uniform(-100, 100)
                    else:
                        vals[s.name] = rnd.randint(s.raw_type_min, s.raw_type_max)
                if any(not ctx.fits[s.name] for s in m.signals) or ctx.switches:
                    continue
                mine = ctx.build(vals, use_base=False)
                theirs = cm.encode(vals, scaling=False, strict=False, padding=False)
                self.assertEqual(bytes(mine), bytes(theirs), m.name)


def run_selftest() -> int:
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(SelfTests)
    res = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if res.wasSuccessful() else 1


