    # generator
    def test_generator_consistency(self) -> None:
        cfg = GenConfig(dut_node="IPC", skip_diag=False, include_bitwalk=True)
        gen = TestCaseGenerator(self.db, cfg)
        ids: Set[str] = set()
        n_rx = n_tx = 0
        for m in self.db.messages:
            sel, d, _st = gen.message_status(m)
            if not sel:
                continue
            tcs = gen.generate(m, d)
            self.assertTrue(tcs, m.name)
            n_rx += d == "RX"
            n_tx += d == "TX"
            for t in tcs:
                self.assertNotIn(t.tc_id, ids)
                ids.add(t.tc_id)
                self.assertIn(t.category, CATEGORIES)
                if t.category == NEG:
                    self.assertIn(t.violation, VIOLATIONS, t.code)
                    self.assertTrue(t.why, t.code)
                if t.violation != NO_VIOLATION:
                    self.assertIn(t.violation, VIOLATIONS, t.code)
                if t.applicable == "Yes" and t.signal and t.raw_dec != "" and t.decoded_phys != "" \
                        and "BIT_SHIFT" not in t.code and t.tx_mode != "MONITOR" and "NAN" not in t.code:
                    self.assertEqual(Decimal(str(t.intended_phys)), Decimal(str(t.decoded_phys)), t.code)
        self.assertGreater(n_rx, 0)
        self.assertGreater(n_tx, 0)

    def test_specific_cases(self) -> None:
        gen = TestCaseGenerator(self.db, GenConfig())
        ems = next(m for m in self.db.messages if m.name == "EMS_EngineData")
        tcs = {t.code: t for t in gen.generate(ems, "RX")}
        self.assertEqual(tcs["SIG.EngSpeed.MAX"].raw_dec, 64000)
        self.assertEqual(tcs["SIG.EngSpeed.MIN"].raw_dec, 0)            # kept although == initial value
        self.assertFalse(any(c.startswith("SIG.EngSpeed.ENUM_UNDEFINED") for c in tcs))  # SNA-only table
        bcm = next(m for m in self.db.messages if m.name == "BCM_LightStatus")
        bcm_codes = {t.code for t in gen.generate(bcm, "RX")}
        self.assertTrue({"SIG.TurnIndSts.ENUM_UNDEFINED_4", "SIG.TurnIndSts.ENUM_UNDEFINED_6"} <= bcm_codes)
        self.assertEqual(tcs["SIG.EngSpeed.ABOVE_MAX"].raw_dec, 64001)
        self.assertEqual(tcs["SIG.EngSpeed.ABOVE_MAX"].category, NEG)
        self.assertEqual(tcs["SIG.EngSpeed.ABOVE_MAX"].violation, V_ABOVE)
        self.assertIn("16000", tcs["SIG.EngSpeed.ABOVE_MAX"].why)
        self.assertEqual(tcs["SIG.EngSpeed.BELOW_MIN"].violation, V_BELOW)       # N/A row still typed
        self.assertEqual(tcs["SIG.EngSpeed.ENUM_65535"].violation, V_SPECIAL_RANGE)
        self.assertEqual(tcs["SIG.EngSpeed.MAX"].violation, NO_VIOLATION)
        self.assertEqual(tcs["TIM.SLOW_VIOLATION"].violation, V_SLOW)
        self.assertEqual(tcs["SIG.EngSpeed.BELOW_MIN"].applicable, "No")
        self.assertEqual(tcs["SIG.ThrottlePos.INIT"].category, SPECIAL)
