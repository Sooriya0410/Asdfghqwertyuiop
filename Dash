@dataclass(frozen=True)
class Dimension:
    """Static description of one graph.

    ``order``/``colors`` define a fixed-value graph; ``order is None`` makes the
    graph data-driven (values discovered from the data, coloured from ``palette``).

    ``need_all`` / ``need_any`` drive the per-bar "no data" behaviour: a bar is
    drawn as "no data" when, for that date's workbook(s), not all of ``need_all``
    are present, or (when ``need_any`` is non-empty) none of ``need_any`` are.
    """
    key: str
    title: str
    row_field: str                                  # processed column to count
    scope: str                                      # "all" | "category" | "work"
    order: Optional[Tuple[str, ...]] = None         # fixed order, or None=dynamic
    colors: Optional[Dict[str, str]] = None         # fixed colours, or None
    palette: Optional[Tuple[str, ...]] = None       # palette for dynamic dims
    full_width: bool = False                         # span both grid columns
    need_all: Tuple[str, ...] = ()                   # canon cols that must exist
    need_any: Tuple[str, ...] = ()                   # at least one must exist


@dataclass
class Domain:
    """Everything that distinguishes one dashboard tab from the other."""
    key: str
    title: str
    root: str
    dimensions: "OrderedDict[str, Dimension]"
    dimension_order: Tuple[str, ...]
    processor: Callable[[pd.DataFrame, str, dt.date, str],
                        Tuple[pd.DataFrame, Set[str]]]
    processed_columns: Tuple[str, ...]
    aliases: Dict[str, str]
    category_canon: str
    target_categories: Tuple[str, ...]
    target_label: str
    keep_default_na: bool = True


