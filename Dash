def _install_basic_auth(server) -> None:
    from flask import request, Response
    if not DASH_PASSWORD:
        log.warning("RT_PASSWORD is blank - the dashboard is NOT locked.")
        return
    exp_user = DASH_USERNAME.encode("utf-8")
    exp_pass = DASH_PASSWORD.encode("utf-8")

    def _ok(u, p):
        return (hmac.compare_digest((u or "").encode("utf-8"), exp_user)
                and hmac.compare_digest((p or "").encode("utf-8"), exp_pass))

    @server.before_request
    def _require_login():
        auth = request.authorization
        if auth is None or not _ok(auth.username, auth.password):
            return Response("Access denied. A username and password are required.",
                            401, {"WWW-Authenticate": 'Basic realm="RT Dashboard"'})

    log.info("Login protection ENABLED (username '%s').", DASH_USERNAME)


def create_app(domains: List[Domain], stores: Dict[str, "DataStore"]) -> "Dash":
    if not _DASH_AVAILABLE:
        raise RuntimeError("Dash is not installed. Run:\n"
                           "    pip install dash plotly pandas numpy openpyxl")
    app = Dash(__name__, suppress_callback_exceptions=True, update_title=None)
    app.title = "RT Traceability Dashboard"
    app.layout = lambda: serve_layout(domains, stores)
    register_global_callbacks(app, domains)
    for d in domains:
        register_domain_callbacks(app, d, stores[d.key])
    _install_basic_auth(app.server)
    return app


def parse_args(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="RT Requirements & Test-Case Traceability Dashboard",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    p.add_argument("--root", default=DEFAULT_RT_ROOT,
                   help="Requirements root (one sub-folder per project).")
    p.add_argument("--tc-root", default=DEFAULT_TC_ROOT,
                   help="Test-Case root (one sub-folder per module).")
    p.add_argument("--host", default="0.0.0.0", help="Host/interface to bind.")
    p.add_argument("--port", default=8050, type=int, help="Port to serve on.")
    p.add_argument("--demo", action="store_true",
                   help="Generate sample data under both roots, then serve.")
    p.add_argument("--selftest", action="store_true",
                   help="Run internal logic assertions and exit.")
    p.add_argument("--rendercheck", action="store_true",
                   help="Headless proof that graphs render, then exit.")
    p.add_argument("--debug", action="store_true", help="(ignored for serving)")
    p.add_argument("--verbose", action="store_true", help="DEBUG logging.")
    return p.parse_args(argv)


def get_lan_ip() -> str:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        try:
            s.close()
        except Exception:
            pass


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_args(argv)
    if args.verbose:
        logging.getLogger().setLevel(logging.DEBUG)

    if args.selftest:
        return run_selftest()

    req_root, tc_root = args.root, args.tc_root
    if args.demo:
        os.makedirs(req_root, exist_ok=True)
        generate_demo_data(req_root)
        os.makedirs(tc_root, exist_ok=True)
        generate_tc_demo_data(tc_root)

    if args.rendercheck:
        return run_render_check(req_root, tc_root)

    domains = build_domains(req_root, tc_root)
    stores: Dict[str, DataStore] = {}
    for d in domains:
        if not os.path.isdir(d.root):
            log.warning("[%s] root does not exist yet: %s",
                        d.title, os.path.abspath(d.root))
        s = DataStore(d)
        s.scan()
        stores[d.key] = s
        log.info("[%s] diagnostics:\n%s", d.title, s.diagnostics())

    app = create_app(domains, stores)
    host, port, lan_ip = args.host, args.port, get_lan_ip()

    if args.debug:
        log.warning("--debug ignored for network serving (RCE risk on 0.0.0.0).")

    log.info("=" * 70)
    log.info("RT Dashboard listening on %s:%d", host, port)
    log.info("  On this PC      :  http://127.0.0.1:%d", port)
    log.info("  Share this link :  http://%s:%d", lan_ip, port)
    if DASH_PASSWORD:
        log.info("  Login required  :  username '%s'", DASH_USERNAME)
    log.info("Press Ctrl+C to stop.")
    log.info("=" * 70)

    try:
        from werkzeug.serving import run_simple
    except Exception:
        run_simple = None
    if run_simple is not None:
        run_simple(host, port, app.server, threaded=True,
                   use_reloader=False, use_debugger=False)
    else:  # pragma: no cover
        run = getattr(app, "run", None) or getattr(app, "run_server")
        run(host=host, port=port, debug=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())

