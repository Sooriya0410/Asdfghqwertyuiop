                for d in domains]

    app.clientside_callback(
        """
        function(value) {
            setTimeout(function(){ window.dispatchEvent(new Event('resize')); }, 60);
            return value;
        }
        """,
        Output("_resize_kick", "data"),
        Input("domain-tabs", "value"),
    )


def register_domain_callbacks(app: "Dash", domain: Domain,
                              store: "DataStore") -> None:
    """Wire every interaction for one dashboard tab (all ids domain-prefixed)."""
    dk = domain.key
    dim_order = domain.dimension_order

    # (1) Rebuild folder tabs + status + error whenever data-version changes.
    @app.callback(
        Output(did(dk, "folder-tabs"), "children"),
        Output(did(dk, "folder-tabs"), "value"),
        Output(did(dk, "status-line"), "children"),
        Output(did(dk, "error-line"), "children"),
        Input(did(dk, "data-version"), "data"),
        State(did(dk, "folder-tabs"), "value"),
    )
    def _refresh_tabs(_version, current_value):
        folders = store.folder_names()
        children, value = build_tabs(folders, current_value)
        if store.total_files() == 0:
            err = ("No workbooks found for this dashboard.\n"
                   "------------------------------------------------------------\n"
                   + store.diagnostics(sample_reads=False)
                   + "\n------------------------------------------------------------\n"
                   f"Expected layout:  <root>/<Name>/<DD-MON-YY>.xlsx\n"
                   f"Each file needs a 'Category' column including "
                   f"{domain.target_label}.\n"
                   "Point the app at your data with --root / --tc-root (or the "
                   "RT_ROOT / TC_ROOT env vars), then press 'Refresh data'.")
        else:
            err = ""
        return children, value, store.summary(), err

    # (2) Refresh button -> rescan disk, bump version, clear filter.
    @app.callback(
        Output(did(dk, "data-version"), "data"),
        Output(did(dk, "active-filter"), "data", allow_duplicate=True),
        Input(did(dk, "refresh-btn"), "n_clicks"),
        prevent_initial_call=True,
    )
    def _do_refresh(n_clicks):
        if not n_clicks:
            raise PreventUpdate
        log.info("[%s] manual refresh #%s", dk, n_clicks)
        store.scan()
        return int(n_clicks), None

    # (3) Enable/disable the custom-date picker based on the mode.
    @app.callback(
        Output(did(dk, "custom-dates"), "disabled"),
        Input(did(dk, "mode-dd"), "value"),
    )
    def _toggle_custom(mode):
        return mode != MODE_CUSTOM

    # (4) Populate custom-date options for the selected folder (cheap: no reads).
    @app.callback(
        Output(did(dk, "custom-dates"), "options"),
        Input(did(dk, "folder-tabs"), "value"),
        Input(did(dk, "data-version"), "data"),
    )
    def _custom_options(folder, _version):
        dates = store.folder_dates(folder) if folder else []
        recent = sorted(set(dates), reverse=True)[:CUSTOM_DATE_OPTION_CAP]
        return [{"label": fmt_date(d), "value": fmt_date(d)} for d in recent]

    # (5) Reset custom-date selection when the folder changes.
    @app.callback(
        Output(did(dk, "custom-dates"), "value"),
        Input(did(dk, "folder-tabs"), "value"),
        prevent_initial_call=True,
    )
    def _reset_custom(_folder):
        return []

    # (6) Cross-filter: clicks, Clear, folder switches.
    @app.callback(
        Output(did(dk, "active-filter"), "data"),
        [Input(graph_id(dk, k), "clickData") for k in dim_order]
        + [Input(did(dk, "clear-btn"), "n_clicks"),
           Input(did(dk, "folder-tabs"), "value")],
        State(did(dk, "active-filter"), "data"),
        prevent_initial_call=True,
    )
    def _cross_filter(*args):
        n_dims = len(dim_order)
        click_payloads = args[:n_dims]
        folder_value = args[n_dims + 1]
        current = args[n_dims + 2]

        trigger = ctx.triggered_id
        if trigger in (did(dk, "folder-tabs"), did(dk, "clear-btn")):
            return None

        dim_key = None
        payload = None
        for key, cdata in zip(dim_order, click_payloads):
            if trigger == graph_id(dk, key):
                dim_key, payload = key, cdata
                break
        if dim_key is None or not payload:
            raise PreventUpdate
        try:
            point = payload["points"][0]
            period_key, _label, value = point["customdata"]
        except (KeyError, IndexError, TypeError, ValueError):
            raise PreventUpdate

        candidate = {"folder": folder_value, "period_key": period_key,
                     "dim": dim_key, "value": value}
        return None if current == candidate else candidate

    # (7) Main render -> all figures + info. Fires on load; never raises.
    @app.callback(
        [Output(graph_id(dk, k), "figure") for k in dim_order]
        + [Output(did(dk, "controls-info"), "children")],
        Input(did(dk, "folder-tabs"), "value"),
        Input(did(dk, "mode-dd"), "value"),
        Input(did(dk, "custom-dates"), "value"),
        Input(did(dk, "active-filter"), "data"),
        Input(did(dk, "data-version"), "data"),
    )
    def _render(folder, mode, custom_dates, active_filter, _version):
        try:
            fig_list, info = render_domain(domain, store, folder, mode,
                                           custom_dates, active_filter)
            return fig_list + [info]
        except Exception as exc:  # never leave graphs stuck on 'Loading...'
            log.exception("[%s] render failed", dk)
            return ([empty_figure(domain.dimensions[k].title, "render error")
                     for k in dim_order] + [f"Error: {exc}"])


