_NUM_DATE_RE = re.compile(r"(\d{1,2})[-_.\s](\d{1,2})[-_.\s](\d{2,4})")
_ALPHA_DATE_RE = re.compile(r"(\d{1,2})[-_.\s]([A-Za-z]{3,})[-_.\s](\d{2,4})")


def parse_date_from_filename(filename: str) -> Optional[dt.date]:
    """Extract a :class:`datetime.date` from a workbook file name.

    Primary contract is ``DD-MON-YY`` (26-OCT-26); ``DD-MM-YYYY`` and several
    separators / 2-digit years are also tolerated, both as a whole-stem parse and
    via an embedded-token regex fallback.
    """
    stem = os.path.splitext(os.path.basename(filename))[0].strip()

    # 1) Whole-stem parse against every accepted format.
    for fmt in FILENAME_DATE_FORMATS:
        try:
            return dt.datetime.strptime(stem, fmt).date()
        except ValueError:
            continue

    # 2) Alpha-month token embedded in the name (e.g. report_26-OCT-26_final).
    m = _ALPHA_DATE_RE.search(stem)
    if m:
        token = f"{int(m.group(1)):02d}-{m.group(2)}-{m.group(3)}"
        for fmt in ("%d-%b-%y", "%d-%b-%Y"):
            try:
                return dt.datetime.strptime(token, fmt).date()
            except ValueError:
                continue

    # 3) Numeric token embedded in the name (e.g. report_31-12-2025_final).
    m = _NUM_DATE_RE.search(stem)
    if m:
        token = f"{int(m.group(1)):02d}-{int(m.group(2)):02d}-{m.group(3)}"
        for fmt in ("%d-%m-%Y", "%d-%m-%y"):
            try:
                return dt.datetime.strptime(token, fmt).date()
            except ValueError:
                continue
    return None


def is_temp_or_hidden(path: str) -> bool:
    """True for Office lock files (``~$...``) and hidden dot-files."""
    name = os.path.basename(path)
    return name.startswith("~$") or name.startswith(".")


def discover_folders(root: str) -> List[str]:
    """Sorted list of immediate sub-folder names inside *root* (one per tab)."""
    if not os.path.isdir(root):
        log.warning("Root directory does not exist: %s", os.path.abspath(root))
        return []
    out = []
    try:
        entries = sorted(os.listdir(root))
    except OSError as exc:
        log.warning("Cannot list root %s: %s", root, exc)
        return []
    for entry in entries:
        full = os.path.join(root, entry)
        if os.path.isdir(full):
            out.append(entry)
    return out


def discover_workbooks(root: str, folder: str) -> List[Tuple[str, dt.date]]:
    """Find every dated workbook inside ``root/folder`` (no reading).

    Returns ``(absolute_path, date)`` sorted by date ascending.  Undated and
    temp/hidden files are skipped.  This is deliberately cheap so it scales to
    thousands of files.
    """
    folder_path = os.path.join(root, folder)
    results: List[Tuple[str, dt.date]] = []
    if not os.path.isdir(folder_path):
        return results
    try:
        entries = sorted(os.listdir(folder_path))
    except OSError as exc:
        log.warning("Cannot list folder %s: %s", folder_path, exc)
        return results
    for entry in entries:
        full = os.path.join(folder_path, entry)
        if is_temp_or_hidden(full) or not os.path.isfile(full):
            continue
        if os.path.splitext(entry)[1].lower() not in EXCEL_EXTENSIONS:
            continue
        file_date = parse_date_from_filename(entry)
        if file_date is None:
            log.debug("Skipping (no parseable date): %s", full)
            continue
        results.append((full, file_date))
    results.sort(key=lambda item: item[1])
    return results


def _read_excel_with_engine(path: str, ext: str,
                            keep_default_na: bool = True) -> pd.DataFrame:
    """Read a single workbook (first sheet), choosing the best engine."""
    ext = ext.lower()

    if ext == ".csv":
        for sep in (",", ";", "\t"):
            try:
                df = pd.read_csv(path, sep=sep, dtype=object,
                                 keep_default_na=keep_default_na,
                                 na_filter=keep_default_na, engine="python")
                if df.shape[1] > 1:
                    return df
            except Exception:
                continue
        return pd.read_csv(path, dtype=object, keep_default_na=keep_default_na,
                           na_filter=keep_default_na)

    if ext in (".xlsx", ".xlsm", ".xltx", ".xltm"):
        engine_plan: List[Optional[str]] = ["openpyxl", None]
    elif ext == ".xls":
        engine_plan = ["xlrd", None, "openpyxl"]
    elif ext == ".xlsb":
        engine_plan = ["pyxlsb", None]
    else:
        engine_plan = [None, "openpyxl", "xlrd", "pyxlsb"]

    last_error: Optional[Exception] = None
    for engine in engine_plan:
        try:
            return pd.read_excel(path, sheet_name=0, dtype=object, engine=engine,
                                 keep_default_na=keep_default_na)
        except ImportError as exc:
            last_error = exc
            log.debug("Engine %r unavailable for %s (%s)", engine, path, exc)
            continue
        except Exception as exc:
            last_error = exc
            log.debug("Engine %r failed for %s (%s)", engine, path, exc)
            continue
    raise RuntimeError(f"Could not read workbook {path!r} with any available "
                       f"engine. Last error: {last_error}")


def read_workbook(path: str, keep_default_na: bool = True) -> pd.DataFrame:
    """Read one workbook into a DataFrame with original headers.

    ``keep_default_na=False`` keeps strings such as ``N/A`` literal (so the
    Test-Case Status graph can tell a real ``N/A`` from a truly empty cell).
    """
    ext = os.path.splitext(path)[1].lower()
    df = _read_excel_with_engine(path, ext, keep_default_na=keep_default_na)
    if df is None:
        raise RuntimeError(f"Workbook {path!r} produced no data frame")
    return df.dropna(axis=0, how="all")


def build_canonical_column_map(columns: Sequence[Any],
                               aliases: Optional[Dict[str, str]] = None
                               ) -> Dict[str, str]:
    """Map canonical-key -> actual-source-column for one workbook."""
    aliases = aliases if aliases is not None else COLUMN_ALIASES
    mapping: Dict[str, str] = {}
    for col in columns:
        canon = aliases.get(normalize_header(col))
        if canon and canon not in mapping:
            mapping[canon] = col
    return mapping


# =========================================================================== #
#  SECTION 4 - PER-CELL CLASSIFICATION LOGIC                                   #
# =========================================================================== #

# ---- Requirements (unchanged behaviour) ----------------------------------- #
def is_target_category(value: Any) -> bool:
    return normalize_text(value) in TARGET_CATEGORIES


def bucket_status(value: Any) -> str:
    s = normalize_text(value)
    if s == STATUS_CREATED:
        return STATUS_CREATED
    if s == STATUS_SPECIFIED:
        return STATUS_SPECIFIED
    if s == STATUS_ACCEPTED:
        return STATUS_ACCEPTED
    return STATUS_OTHERS


def apply_threshold(value: Any) -> float:
    try:
        v = float(value)
    except (TypeError, ValueError):
        return 0.0
    if math.isnan(v):
        return 0.0
    return v if v >= COUNT_THRESHOLD else 0.0


def compute_traceability(pass_count: float, fail_count: float,
                         trace_count: float) -> str:
    if fail_count != 0:
        return "Fail"
    if pass_count != 0:
        return "Pass"
    return "Not Tested"


def normalize_existing_traceability(value: Any) -> str:
    s = normalize_text(value)
    if s == "":
        return ""
    if "fail" in s:
        return "Fail"
    if "pass" in s:
        return "Pass"
    if ("not" in s and "test" in s) or s in ("nt", "untested", "not_tested"):
        return "Not Tested"
    return str(value).strip()


def classify_validation(value: Any) -> str:
    return "Not Validated" if is_blank(value) else "Validated"


def bucket_asil(value: Any) -> str:
    if is_blank(value):
        return "blank"
    s = normalize_text(value)
    if "qm" in s:
        return "QM"
    if s == "tbd":
        return "tbd"
    return "ASIL"


def classify_cal(value: Any) -> str:
    if is_blank(value):
        return CAL_BLANK_LABEL
    return str(value).strip()


# ---- Test-Case classification --------------------------------------------- #
def is_tc_target_category(value: Any) -> bool:
    """Only 'Software Test Level 1' rows are processed on the Test-Case tab."""
    return normalize_text(value) == "software test level 1"


def bucket_tc_status(value: Any) -> str:
    s = normalize_text(value)
    if s == "":
        return "blank"
    if s == "accepted":
        return "accepted"
    if s == "created":
        return "created"
    if s == "deleted":
        return "deleted"
    if s in ("n/a", "na"):
        return "n/a"
    if s == "specified":
        return "specified"
    return "other"


def bucket_tc_result(value: Any) -> str:
    s = normalize_text(value)
    if s == "":
        return "blank"
    t = s.replace("_", " ").replace("-", " ")
    if "fail" in s:
        return "Failed"
    if "pass" in s:
        return "Passed"
    if "skip" in s:
        return "Skipped"
    if "not run" in t or "notrun" in s:
        return "Not run"
    return "other"


def bucket_tc_type(value: Any) -> str:
    s = normalize_text(value)
    if s == "":
        return "blank"
    if "manual" in s:
        return "Manual"
    if "auto" in s:                 # matches "automated" / "automatic"
        return "Automated"
    return "other"


def tc_set_or_not(value: Any) -> str:
    """'Set' when the cell holds anything, else 'Not Set'."""
    return "Not Set" if is_blank(value) else "Set"


def tc_dynamic_value(value: Any) -> str:
    """ASIL / CAL value as a trimmed string, or the blank label if empty."""
    if is_blank(value):
        return CAL_BLANK_LABEL
    return str(value).strip()


def bucket_tc_regression(value: Any) -> str:
    s = normalize_text(value)
    if s == "":
        return "blank"
    if s == "false":
        return "False"
    if "pass" in s:
        return "Pass"
    return "NIL"


# =========================================================================== #
#  SECTION 5 - WORKBOOK -> PROCESSED ROW FRAME                                 #
# =========================================================================== #

def _series_for(df: pd.DataFrame, mapping: Dict[str, str], canon: str,
                default: Any = np.nan) -> pd.Series:
    """Source Series for a canonical key, or a default-filled one if absent."""
    col = mapping.get(canon)
    if col is None or col not in df.columns:
        return pd.Series([default] * len(df), index=df.index)
    return df[col]


def process_workbook(raw: pd.DataFrame, folder: str, file_date: dt.date,
                     source_file: str) -> Tuple[pd.DataFrame, Set[str]]:
    """Requirements: raw workbook -> (tidy FR/NFR rows, present-column set)."""
    if raw is None or raw.empty:
        return pd.DataFrame(columns=PROCESSED_COLUMNS), set()

    mapping = build_canonical_column_map(raw.columns, COLUMN_ALIASES)
    present: Set[str] = set(mapping.keys())

    category = _series_for(raw, mapping, CANON_CATEGORY)
    is_target_mask = category.map(is_target_category).to_numpy(dtype=bool)
    if not is_target_mask.any():
        return pd.DataFrame(columns=PROCESSED_COLUMNS), present

    status = _series_for(raw, mapping, CANON_STATUS)
    validated_by = _series_for(raw, mapping, CANON_VALIDATED_BY)
    cal = _series_for(raw, mapping, CANON_CAL)
    asil = _series_for(raw, mapping, CANON_ASIL)
    pass_raw = _series_for(raw, mapping, CANON_PASS, default=0)
    fail_raw = _series_for(raw, mapping, CANON_FAIL, default=0)
    trace_raw = _series_for(raw, mapping, CANON_TRACE, default=0)
    had_traceability = CANON_TRACEABILITY in mapping
    trace_existing = _series_for(raw, mapping, CANON_TRACEABILITY, default="")

    status_bucket = status.map(bucket_status)
    in_work_mask = is_target_mask & status_bucket.isin(WORK_STATUSES).to_numpy(bool)

    pass_v = pass_raw.map(apply_threshold)
    fail_v = fail_raw.map(apply_threshold)
    trace_v = trace_raw.map(apply_threshold)

    if had_traceability:
        trace_bucket = trace_existing.map(normalize_existing_traceability)
    else:
        trace_bucket = pd.Series(
            [compute_traceability(p, f, t)
             for p, f, t in zip(pass_v.to_numpy(), fail_v.to_numpy(),
                                 trace_v.to_numpy())],
            index=raw.index,
        )

    out = pd.DataFrame({
        "folder": folder,
        "date": file_date,
        "source_file": os.path.basename(source_file),
        "status_bucket": status_bucket.to_numpy(),
        "in_work": in_work_mask,
        "validation": validated_by.map(classify_validation).to_numpy(),
        "traceability_bucket": trace_bucket.to_numpy(),
        "asil_bucket": asil.map(bucket_asil).to_numpy(),
        "cal_value": cal.map(classify_cal).to_numpy(),
        "pass_count": pass_v.to_numpy(),
        "fail_count": fail_v.to_numpy(),
        "trace_count": trace_v.to_numpy(),
    }, index=raw.index)
    out = out.loc[is_target_mask].reset_index(drop=True)
    return out, present


def process_test_case_workbook(raw: pd.DataFrame, folder: str,
                               file_date: dt.date, source_file: str
                               ) -> Tuple[pd.DataFrame, Set[str]]:
    """Test-Case: raw workbook -> (tidy 'Software Test Level 1' rows, present)."""
    if raw is None or raw.empty:
        return pd.DataFrame(columns=TC_PROCESSED_COLUMNS), set()

    mapping = build_canonical_column_map(raw.columns, TC_COLUMN_ALIASES)
    present: Set[str] = set(mapping.keys())

    category = _series_for(raw, mapping, TC_CANON_CATEGORY)
    is_target = category.map(is_tc_target_category).to_numpy(dtype=bool)
    if not is_target.any():
        return pd.DataFrame(columns=TC_PROCESSED_COLUMNS), present

    status = _series_for(raw, mapping, TC_CANON_STATUS)
    last_result = _series_for(raw, mapping, TC_CANON_LAST_RESULT)
    tc_type = _series_for(raw, mapping, TC_CANON_TYPE)
    test_crit = _series_for(raw, mapping, TC_CANON_TEST_CRITERIA)
    validated = _series_for(raw, mapping, TC_CANON_VALIDATED)
    responsible = _series_for(raw, mapping, TC_CANON_RESPONSIBLE)
    asil = _series_for(raw, mapping, TC_CANON_ASIL)
    cal = _series_for(raw, mapping, TC_CANON_CAL)
    regression = _series_for(raw, mapping, TC_CANON_REGRESSION)

    out = pd.DataFrame({
        "folder": folder,
        "date": file_date,
        "source_file": os.path.basename(source_file),
        "status_value": status.map(bucket_tc_status).to_numpy(),
        "result_value": last_result.map(bucket_tc_result).to_numpy(),
        "type_value": tc_type.map(bucket_tc_type).to_numpy(),
        "test_criteria_set": test_crit.map(tc_set_or_not).to_numpy(),
        "validated_set": validated.map(tc_set_or_not).to_numpy(),
        "responsible_set": responsible.map(tc_set_or_not).to_numpy(),
        "asil_value": asil.map(tc_dynamic_value).to_numpy(),
        "cal_value": cal.map(tc_dynamic_value).to_numpy(),
        "regression_value": regression.map(bucket_tc_regression).to_numpy(),
    }, index=raw.index)
    out = out.loc[is_target].reset_index(drop=True)
    return out, present


