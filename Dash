_WS_RE = re.compile(r"\s+")


def normalize_text(value: Any) -> str:
    """Lower-cased, whitespace-collapsed, stripped string ('' for NaN/None)."""
    if value is None:
        return ""
    if isinstance(value, float) and math.isnan(value):
        return ""
    try:
        text = str(value)
    except Exception:
        return ""
    text = text.replace("\u00a0", " ")             # non-breaking space -> space
    text = _WS_RE.sub(" ", text).strip().lower()
    if text in ("nan", "none", "null", "<na>"):
        return ""
    return text


def normalize_header(value: Any) -> str:
    """Normalise a column header for alias matching (same rules as cells)."""
    return normalize_text(value)


def is_blank(value: Any) -> bool:
    """True when a cell should be treated as empty/blank."""
    return normalize_text(value) == ""


