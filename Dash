#  SECTION 8 - PERIOD BUILDING (daily / weekly / monthly / custom)            #
# =========================================================================== #

MODE_DAILY = "daily"
MODE_WEEKLY = "weekly"
MODE_MONTHLY = "monthly"
MODE_CUSTOM = "custom"

MODE_OPTIONS = [
    {"label": "Daily (last 10 days)", "value": MODE_DAILY},
    {"label": "Weekly (last 10 weeks - Sat/Fri)", "value": MODE_WEEKLY},
    {"label": "Monthly (last 10 months - last day)", "value": MODE_MONTHLY},
    {"label": "Custom (pick 1-10 dates)", "value": MODE_CUSTOM},
]


@dataclass(frozen=True)
class Period:
    """One bar: a label plus the (single) date it represents."""
    key: str
    label: str
    dates: Tuple[dt.date, ...]
    kind: str


def _take_last(items: List[Any], n: int) -> List[Any]:
    return items[-n:] if len(items) > n else items


def build_daily_periods(dates: List[dt.date], today: dt.date) -> List[Period]:
    """Up to the 10 most-recent available days (<= today), one bar each."""
    usable = _take_last([d for d in sorted(set(dates)) if d <= today], MAX_BARS)
    return [Period(key=f"d:{d.isoformat()}", label=fmt_date(d), dates=(d,),
                   kind=MODE_DAILY) for d in usable]


def build_weekly_periods(dates: List[dt.date], today: dt.date) -> List[Period]:
    """Up to 10 most-recent ISO weeks, each represented by ONE day.

    The representative day is that week's Saturday; if there is no file for the
    Saturday, the Friday is used instead; if neither exists the week is skipped.
    """
    available = {d for d in dates if d <= today}
    # Group available dates into ISO weeks (so we only consider weeks with data).
    weeks: "OrderedDict[Tuple[int, int], None]" = OrderedDict()
    for d in sorted(available):
        iso = d.isocalendar()
        weeks[(iso[0], iso[1])] = None

    periods: List[Period] = []
    for (iso_year, iso_week) in sorted(weeks.keys()):
        saturday = dt.date.fromisocalendar(iso_year, iso_week, 6)
        friday = dt.date.fromisocalendar(iso_year, iso_week, 5)
        if saturday in available and saturday <= today:
            rep = saturday
        elif friday in available and friday <= today:
            rep = friday
        else:
            continue                      # neither Sat nor Fri has a file
        periods.append(Period(
            key=f"w:{iso_year}-{iso_week:02d}", label=fmt_date(rep),
            dates=(rep,), kind=MODE_WEEKLY,
        ))
    return _take_last(periods, MAX_BARS)


def build_monthly_periods(dates: List[dt.date], today: dt.date) -> List[Period]:
    """Up to 10 most-recent months, each represented by its LAST available day."""
    available = [d for d in sorted(set(dates)) if d <= today]
    months: "OrderedDict[Tuple[int, int], dt.date]" = OrderedDict()
    for d in available:
        months[(d.year, d.month)] = d     # last write wins -> latest day in month

    ordered = sorted(months.keys())
    ordered = _take_last(ordered, MAX_BARS)
    return [Period(key=f"m:{y}-{mn:02d}", label=fmt_date(months[(y, mn)]),
                   dates=(months[(y, mn)],), kind=MODE_MONTHLY)
            for (y, mn) in ordered]


def _parse_iso(token: str) -> Optional[dt.date]:
    try:
        return dt.date.fromisoformat(str(token))
    except (ValueError, TypeError):
        return None


def build_custom_periods(dates: List[dt.date],
                         selected: Optional[Sequence[str]]) -> List[Period]:
    """One bar per user-selected date (1-10)."""
    if not selected:
        return []
    available = set(dates)
    chosen: List[dt.date] = []
    for token in selected:
        d = parse_date_from_filename(str(token)) or _parse_iso(token)
        if d is not None and d in available:
            chosen.append(d)
    chosen = _take_last(sorted(set(chosen)), MAX_BARS)
    return [Period(key=f"c:{d.isoformat()}", label=fmt_date(d), dates=(d,),
                   kind=MODE_CUSTOM) for d in chosen]


def build_periods(dates: List[dt.date], mode: str, today: dt.date,
                  custom: Optional[Sequence[str]] = None) -> List[Period]:
    if mode == MODE_WEEKLY:
        return build_weekly_periods(dates, today)
    if mode == MODE_MONTHLY:
        return build_monthly_periods(dates, today)
    if mode == MODE_CUSTOM:
        return build_custom_periods(dates, custom)
    return build_daily_periods(dates, today)


