def run_selftest() -> int:
    log.info("=" * 70)
    log.info("RUNNING SELF-TEST")
    log.info("=" * 70)
    failures: List[str] = []
    today = dt.date.today()

    # --- Requirements: ASIL worked example -------------------------------- #
    asil_rows, _ = process_workbook(_known_asil_frame(), "T", today, "a.xlsx")
    ac = segment_counts(asil_rows, DIMENSIONS[DIM_ASIL])
    _assert(ac.get("QM") == 4, f"REQ ASIL QM==4 (got {ac.get('QM')})", failures)
    _assert(ac.get("tbd") == 1, f"REQ ASIL tbd==1 (got {ac.get('tbd')})", failures)
    _assert(ac.get("blank") == 2, f"REQ ASIL blank==2 (got {ac.get('blank')})", failures)
    _assert(ac.get("ASIL") == 3, f"REQ ASIL ASIL==3 (got {ac.get('ASIL')})", failures)

    # --- Requirements: threshold + traceability --------------------------- #
    tr, _ = process_workbook(_known_trace_frame(), "T", today, "t.xlsx")
    got = list(tr["traceability_bucket"])
    exp = ["Pass", "Not Tested", "Fail", "Fail", "Not Tested", "Not Tested", "Pass"]
    _assert(got == exp, f"REQ traceability {got}=={exp}", failures)
    _assert(float(tr.loc[1, "pass_count"]) == 0.0, "REQ 0.5 clamped to 0", failures)
    _assert(float(tr.loc[3, "fail_count"]) == 0.95, "REQ 0.95 retained", failures)

    # --- Requirements: existing traceability honoured --------------------- #
    ex = _known_trace_frame(); ex["Traceability"] = ["Pass"] * 7
    exr, _ = process_workbook(ex, "T", today, "e.xlsx")
    _assert(set(exr["traceability_bucket"]) == {"Pass"},
            "REQ existing Traceability used as-is", failures)

    # --- Test-Case: row filter + each graph ------------------------------- #
    tcr, present = process_test_case_workbook(_tc_known_frame(), "M", today, "m.xlsx")
    _assert(len(tcr) == 5, f"TC keeps only STL1 rows (got {len(tcr)})", failures)
    sc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_STATUS])
    _assert(all(sc.get(k) == 1 for k in
                ("accepted", "created", "deleted", "n/a", "specified")),
            f"TC status one each (got {sc})", failures)
    rc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_RESULT])
    _assert(rc.get("Passed") == 1 and rc.get("Failed") == 1 and rc.get("blank") == 1,
            f"TC result buckets (got {rc})", failures)
    yc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_TYPE])
    _assert(yc.get("Manual") == 2 and yc.get("Automated") == 2 and yc.get("blank") == 1,
            f"TC type Manual==2,Automated==2,blank==1 (got {yc})", failures)
    cc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_TESTCRIT])
    _assert(cc.get("Set") == 2 and cc.get("Not Set") == 3,
            f"TC criteria Set==2,NotSet==3 (got {cc})", failures)
    vc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_VALUATION])
    _assert(vc.get("Set") == 2 and vc.get("Not Set") == 3,
            f"TC valuation Set==2,NotSet==3 (got {vc})", failures)
    uc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_RESPONSIBLE])
    _assert(uc.get("Set") == 1 and uc.get("Not Set") == 4,
            f"TC responsible Set==1,NotSet==4 (got {uc})", failures)
    gc = segment_counts(tcr, TC_DIMENSIONS[TC_DIM_REGRESSION])
    _assert(gc.get("Pass") == 2 and gc.get("False") == 1 and gc.get("NIL") == 1
            and gc.get("blank") == 1, f"TC regression (got {gc})", failures)
    av, acol = resolve_dimension_values(TC_DIMENSIONS[TC_DIM_ASIL], tcr)
    _assert("A" in av and len(acol) == len(av) and all(c in av for c in ("A", "B", "C")),
            f"TC ASIL dynamic values (got {av})", failures)
    cv, _ccol = resolve_dimension_values(TC_DIMENSIONS[TC_DIM_CAL], tcr)
    _assert("CAL1" in cv and CAL_BLANK_LABEL in cv, f"TC CAL values (got {cv})", failures)
    _assert(TC_CANON_ASIL in present and TC_CANON_TYPE in present,
            "TC presence set includes ASIL & Test Case Type", failures)

    # --- Test-Case: missing column -> that graph has no presence ---------- #
    noasil = _tc_known_frame().drop(columns=["ASIL"])
    _, present2 = process_test_case_workbook(noasil, "M", today, "m2.xlsx")
    _assert(TC_CANON_ASIL not in present2 and TC_CANON_STATUS in present2,
            "TC missing ASIL column reflected in presence", failures)
    _assert(_bar_has_no_data(TC_DIMENSIONS[TC_DIM_ASIL], present2) is True,
            "TC ASIL bar flagged no-data when column absent", failures)
    _assert(_bar_has_no_data(TC_DIMENSIONS[TC_DIM_STATUS], present2) is False,
            "TC Status bar NOT flagged when its column present", failures)

    # --- Date parsing (DD-MON-YY and legacy) ------------------------------ #
    _assert(parse_date_from_filename("26-OCT-26.xlsx") == dt.date(2026, 10, 26),
            "parse 26-OCT-26", failures)
    _assert(parse_date_from_filename("05-jan-26.xlsx") == dt.date(2026, 1, 5),
            "parse 05-jan-26 (lowercase)", failures)
    _assert(parse_date_from_filename("31-12-2025.xlsx") == dt.date(2025, 12, 31),
            "parse legacy 31-12-2025", failures)
    _assert(fmt_date(dt.date(2026, 10, 26)) == "26-OCT-26", "fmt 26-OCT-26", failures)

    # --- Weekly (Sat else Fri) / Monthly (last day) ----------------------- #
    sat = dt.date(2026, 10, 17)   # a Saturday
    fri = dt.date(2026, 10, 16)   # the Friday before it
    wk = build_weekly_periods([fri, sat, dt.date(2026, 10, 14)], dt.date(2026, 10, 20))
    _assert(len(wk) == 1 and wk[0].dates == (sat,),
            f"weekly picks Saturday (got {[fmt_date(x) for p in wk for x in p.dates]})",
            failures)
    wk2 = build_weekly_periods([fri, dt.date(2026, 10, 14)], dt.date(2026, 10, 20))
    _assert(len(wk2) == 1 and wk2[0].dates == (fri,),
            "weekly falls back to Friday when Saturday missing", failures)
    wk3 = build_weekly_periods([dt.date(2026, 10, 13), dt.date(2026, 10, 14)],
                               dt.date(2026, 10, 20))
    _assert(len(wk3) == 0, "weekly skips week with neither Sat nor Fri", failures)
    mdates = [dt.date(2026, 10, 3), dt.date(2026, 10, 20), dt.date(2026, 10, 28),
              dt.date(2026, 9, 15)]
    mo = build_monthly_periods(mdates, dt.date(2026, 10, 31))
    oct_bar = [p for p in mo if p.dates[0].month == 10]
    _assert(oct_bar and oct_bar[0].dates == (dt.date(2026, 10, 28),),
            "monthly picks last day of month", failures)

    # --- Figures build headlessly (both domains, incl. cross-filter) ------ #
    daily = build_daily_periods([today - dt.timedelta(days=i) for i in range(5)], today)
    pres = {p.dates[0]: set(TC_COLUMN_ALIASES.values()) for p in daily}
    try:
        tc_domain = build_domains("x", "y")[1]
        figs = build_all_figures(tc_domain, "M", tcr, daily[:3], None,
                                 {d: set(TC_COLUMN_ALIASES.values())
                                  for p in daily[:3] for d in p.dates})
        _assert(len(figs) == 9 and all(isinstance(f, go.Figure) for f in figs.values()),
                "TC builds all 9 figures", failures)
    except Exception as exc:
        _assert(False, f"TC figure build raised: {exc}", failures)

    log.info("=" * 70)
    if failures:
        log.error("SELF-TEST FAILED: %d assertion(s)", len(failures))
        for f in failures:
            log.error("   - %s", f)
        return 1
    log.info("SELF-TEST PASSED: all assertions green")
    log.info("=" * 70)
    return 0


def _walk_component_ids(component, acc: List[str]) -> None:
    """Collect every component id in a Dash layout tree (for a uniqueness audit)."""
    cid = getattr(component, "id", None)
    if isinstance(cid, str):
        acc.append(cid)
    children = getattr(component, "children", None)
    if children is None:
        return
    if isinstance(children, (list, tuple)):
        for ch in children:
            if hasattr(ch, "children") or hasattr(ch, "id"):
                _walk_component_ids(ch, acc)
    elif hasattr(children, "children") or hasattr(children, "id"):
        _walk_component_ids(children, acc)


def _figure_bar_count(fig) -> int:
    data = fig.get("data", []) if isinstance(fig, dict) else getattr(fig, "data", [])
    total = 0
    for tr in data:
        t = tr.get("type") if isinstance(tr, dict) else getattr(tr, "type", "")
        if t == "bar":
            total += 1
    return total


def _figure_is_loading(fig) -> bool:
    if isinstance(fig, dict):
        anns = fig.get("layout", {}).get("annotations", []) or []
        texts = [a.get("text", "") for a in anns]
    else:
        anns = list(getattr(fig.layout, "annotations", []) or [])
        texts = [getattr(a, "text", "") for a in anns]
    return "Loading..." in texts


def run_render_check(req_root: str, tc_root: str) -> int:
    """Headless proof the graphs populate (never stuck on 'Loading...').

    Three independent checks:
      1. The real Dash app builds and every component id is UNIQUE (duplicate ids
         are the classic cause of a dead callback graph / stuck graphs).
      2. Each domain's render callback is registered and outputs one figure per
         graph (so every graph is actually wired).
      3. The exact render logic (render_domain) returns real bar-bearing figures,
         with none left on the 'Loading...' placeholder, for every view mode.
    """
    if not _DASH_AVAILABLE:
        log.error("Dash not available; cannot run render check.")
        return 1
    log.info("=" * 70)
    log.info("RUNNING RENDER CHECK (headless)")
    log.info("=" * 70)
    failures: List[str] = []
    domains = build_domains(req_root, tc_root)
    stores = {d.key: DataStore(d) for d in domains}
    for s in stores.values():
        s.scan()
    app = create_app(domains, stores)

    # (1) Unique component ids in the rendered layout.
    ids: List[str] = []
    _walk_component_ids(app.layout(), ids)
    dupes = sorted({i for i in ids if ids.count(i) > 1})
    _assert(not dupes, f"all component ids unique (dupes: {dupes})", failures)

    # (2) Every graph is an output of some registered callback.
    outputs = set()
    for cid in app.callback_map.keys():
        for part in cid.replace("[", "").replace("]", "").split("..."):
            outputs.add(part.strip(" ."))   # Dash joins multi-outputs as ..a...b..
    for d in domains:
        for k in d.dimension_order:
            want = graph_id(d.key, k) + ".figure"
            _assert(want in outputs, f"[{d.key}] graph '{k}' is a callback output",
                    failures)

    # (3) render_domain yields populated figures for every mode.
    for d in domains:
        folders = stores[d.key].folder_names()
        if not folders:
            _assert(False, f"[{d.key}] no folders discovered (demo written?)", failures)
            continue
        folder = folders[0]
        for mode in (MODE_DAILY, MODE_WEEKLY, MODE_MONTHLY):
            try:
                figs, _info = render_domain(d, stores[d.key], folder, mode, [], None)
            except Exception as exc:
                _assert(False, f"[{d.key}/{mode}] render raised: {exc}", failures)
                continue
            _assert(len(figs) == len(d.dimension_order),
                    f"[{d.key}/{mode}] one figure per graph", failures)
            bar_counts = [_figure_bar_count(f) for f in figs]
            _assert(sum(bar_counts) > 0,
                    f"[{d.key}/{mode}] figures contain bars (counts={bar_counts})",
                    failures)
            stuck = [k for k, f in zip(d.dimension_order, figs) if _figure_is_loading(f)]
            _assert(not stuck, f"[{d.key}/{mode}] none stuck on Loading ({stuck})",
                    failures)
        # Custom mode with a real date populates too.
        ds = stores[d.key].folder_dates(folder)
        if ds:
            figs, _ = render_domain(d, stores[d.key], folder, MODE_CUSTOM,
                                    [fmt_date(ds[-1])], None)
            _assert(sum(_figure_bar_count(f) for f in figs) > 0,
                    f"[{d.key}/custom] figures contain bars", failures)
        # Cross-filter path also builds without error.
        try:
            af = {"folder": folder, "period_key": "d:x",
                  "dim": d.dimension_order[0], "value": "created"}
            render_domain(d, stores[d.key], folder, MODE_DAILY, [], af)
            _assert(True, f"[{d.key}] cross-filter render builds", failures)
        except Exception as exc:
            _assert(False, f"[{d.key}] cross-filter raised: {exc}", failures)

    log.info("=" * 70)
    if failures:
        log.error("RENDER CHECK FAILED: %d issue(s)", len(failures))
        for f in failures:
            log.error("   - %s", f)
        return 1
    log.info("RENDER CHECK PASSED: graphs populate on load")
    log.info("=" * 70)
    return 0


