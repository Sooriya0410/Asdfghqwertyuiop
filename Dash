#  SECTION 9 - AGGREGATION & CROSS-FILTER COUNTING                            #
# =========================================================================== #

def _scope_mask(df: pd.DataFrame, scope: str) -> pd.Series:
    """Boolean mask selecting the rows a dimension is allowed to see.

    ``work`` uses the ``in_work`` flag (Requirements only); ``all``/``category``
    select every retained row.
    """
    if scope == "work" and "in_work" in df.columns:
        return df["in_work"].astype(bool)
    return pd.Series(True, index=df.index)


def period_rows(folder_rows: pd.DataFrame, period: Period) -> pd.DataFrame:
    if folder_rows is None or folder_rows.empty:
        return folder_rows
    return folder_rows[folder_rows["date"].isin(set(period.dates))]


def segment_counts(rows: pd.DataFrame, dim: Dimension,
                   restrict_field: Optional[str] = None,
                   restrict_value: Optional[str] = None) -> Dict[str, int]:
    if rows is None or rows.empty or dim.row_field not in rows.columns:
        return {}
    df = rows
    if restrict_field is not None and restrict_value is not None:
        if restrict_field not in df.columns:
            return {}
        df = df[df[restrict_field] == restrict_value]
        if df.empty:
            return {}
    df = df[_scope_mask(df, dim.scope)]
    if df.empty:
        return {}
    counts = df[dim.row_field].value_counts()
    return {str(k): int(v) for k, v in counts.items()}


def apply_cross_filter(rows: pd.DataFrame, source_dim: Dimension,
                       value: Any) -> pd.DataFrame:
    if rows is None or rows.empty or source_dim.row_field not in rows.columns:
        return rows
    df = rows[_scope_mask(rows, source_dim.scope)]
    return df[df[source_dim.row_field] == value]


def discover_dynamic_values(folder_rows: pd.DataFrame, dim: Dimension) -> List[str]:
    """Distinct values of a dynamic dimension (sorted; blank label last)."""
    if folder_rows is None or folder_rows.empty or dim.row_field not in folder_rows.columns:
        return []
    df = folder_rows[_scope_mask(folder_rows, dim.scope)]
    if df.empty:
        return []
    vals = {str(v) for v in df[dim.row_field].dropna().tolist() if str(v) != ""}
    return sorted(vals, key=lambda s: (s == CAL_BLANK_LABEL, s.lower()))


def resolve_dimension_values(dim: Dimension, folder_rows: pd.DataFrame
                             ) -> Tuple[List[str], Dict[str, str]]:
    """(ordered values, colour map) for a dimension - fixed or data-driven."""
    if dim.order is not None:
        return list(dim.order), dict(dim.colors or {})
    values = discover_dynamic_values(folder_rows, dim)
    palette = dim.palette or CAL_PALETTE
    colors = {v: palette[i % len(palette)] for i, v in enumerate(values)}
    return values, colors


