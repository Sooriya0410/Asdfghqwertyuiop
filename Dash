GRAPH_HEIGHT = 330
GRID_COLOR = "#ECECEC"
AXIS_COLOR = "#444444"
FONT_FAMILY = "Segoe UI, Roboto, Helvetica, Arial, sans-serif"


def empty_figure(title: str, message: str = "No data") -> go.Figure:
    fig = go.Figure()
    fig.update_layout(
        title=dict(text=title, x=0.5, xanchor="center",
                   font=dict(size=16, family=FONT_FAMILY)),
        height=GRAPH_HEIGHT,
        margin=dict(l=45, r=12, t=44, b=40),
        xaxis=dict(visible=False), yaxis=dict(visible=False),
        plot_bgcolor="white", paper_bgcolor="white", showlegend=False,
        annotations=[dict(text=message, x=0.5, y=0.5, xref="paper", yref="paper",
                          showarrow=False, font=dict(size=14, color="#888888"))],
    )
    return fig


def _period_present(presence: Dict[dt.date, Set[str]], period: Period) -> Set[str]:
    out: Set[str] = set()
    for d in period.dates:
        out |= presence.get(d, set())
    return out


def _bar_has_no_data(dim: Dimension, present: Set[str]) -> bool:
    """True when a dimension's required columns are absent for a bar's file(s)."""
    if any(c not in present for c in dim.need_all):
        return True
    if dim.need_any and not any(c in present for c in dim.need_any):
        return True
    return False


def build_stacked_figure(folder: str, folder_rows: pd.DataFrame,
                         periods: List[Period], dim_key: str,
                         active_filter: Optional[Dict[str, Any]],
                         dimensions: "OrderedDict[str, Dimension]",
                         presence: Dict[dt.date, Set[str]]) -> go.Figure:
    """Build one dimension's stacked-bar figure.

    Honours: fixed narrow bars on a 10-slot axis; no legend; exact colours;
    click-to-cross-filter (selected bar recomputed for the clicked subset, the
    rest dimmed); a total printed on top of every bar; and a per-bar "no data"
    note when this graph's source column is missing from that date's workbook.
    """
    dim = dimensions[dim_key]
    values, colors = resolve_dimension_values(dim, folder_rows)

    if not periods:
        return empty_figure(dim.title, "No data for this selection")

    n = len(periods)
    xs = list(range(n))
    tick_labels = [p.label for p in periods]

    # Cross-filter state pointed at THIS folder?
    active_on = bool(active_filter) and active_filter.get("folder") == folder
    sel_period_key = active_filter.get("period_key") if active_on else None
    src_dim: Optional[Dimension] = None
    restrict_value = None
    filter_descr = ""
    if active_on:
        src_dim = dimensions.get(active_filter.get("dim", ""))
        if src_dim is not None:
            restrict_value = active_filter.get("value")
            filter_descr = f"{src_dim.title} = {restrict_value}"

    # Per-period counts, opacity and no-data flags.
    per_counts: List[Dict[str, int]] = []
    per_opacity: List[float] = []
    per_nodata: List[bool] = []
    for p in periods:
        present = _period_present(presence, p)
        nodata = _bar_has_no_data(dim, present)
        per_nodata.append(nodata)
        if nodata:
            per_counts.append({})
            per_opacity.append(0.28 if active_on else 1.0)
            continue
        prows = period_rows(folder_rows, p)
        if active_on and src_dim is not None and p.key == sel_period_key:
            sel_rows = apply_cross_filter(prows, src_dim, restrict_value)
            per_counts.append(segment_counts(sel_rows, dim))
            per_opacity.append(1.0)
        else:
            per_counts.append(segment_counts(prows, dim))
            per_opacity.append(0.28 if active_on else 1.0)

    fig = go.Figure()
    for value in values:
        ys = [counts.get(value, 0) for counts in per_counts]
        if sum(ys) == 0 and dim.order is None:
            continue   # skip entirely-absent dynamic values (keeps hover lean)
        fig.add_trace(go.Bar(
            x=xs, y=ys, width=BAR_WIDTH, name=str(value),
            marker=dict(color=colors.get(value, "#999999"),
                        opacity=per_opacity,
                        line=dict(width=0.5, color="rgba(0,0,0,0.35)")),
            customdata=[[p.key, p.label, value] for p in periods],
            hovertemplate=("<b>%{customdata[2]}</b><br>%{customdata[1]}"
                           "<br>count = %{y}<extra></extra>"),
        ))

    # Annotations: optional filter note, per-bar totals, per-bar "no data".
    annotations: List[dict] = []
    if active_on and filter_descr:
        annotations.append(dict(
            text=f"filtered: {filter_descr}", x=1.0, y=1.06, xref="paper",
            yref="paper", xanchor="right", showarrow=False,
            font=dict(size=11, color="#1f77b4"),
        ))

    totals = [int(sum(c.values())) for c in per_counts]
    max_total = max(totals) if totals else 0
    for i, p in enumerate(periods):
        if per_nodata[i]:
            annotations.append(dict(
                x=i, y=0, xref="x", yref="y", text="no data", showarrow=False,
                xanchor="center", yanchor="bottom", yshift=4, textangle=-90,
                font=dict(size=10, color="#B91C1C"),
            ))
            continue
        if totals[i] > 0:
            is_sel = active_on and p.key == sel_period_key
            annotations.append(dict(
                x=i, y=totals[i], xref="x", yref="y", text=str(totals[i]),
                showarrow=False, xanchor="center", yanchor="bottom", yshift=3,
                font=dict(size=11, family=FONT_FAMILY,
                          color="#111827" if (not active_on or is_sel) else "#9CA3AF"),
            ))

    # Transparent headroom point so top labels are never clipped (keeps zoom).
    if max_total > 0:
        fig.add_trace(go.Scatter(
            x=[(n - 1) / 2.0 if n > 0 else 0], y=[max_total * 1.16],
            mode="markers", marker=dict(size=0, opacity=0),
            hoverinfo="skip", showlegend=False,
        ))

    fig.update_layout(
        barmode="stack", bargap=0.35,
        title=dict(text=dim.title, x=0.5, xanchor="center",
                   font=dict(size=16, family=FONT_FAMILY)),
        height=GRAPH_HEIGHT, margin=dict(l=48, r=12, t=46, b=70),
        showlegend=False, plot_bgcolor="white", paper_bgcolor="white",
        font=dict(family=FONT_FAMILY, size=12, color=AXIS_COLOR),
        annotations=annotations, uirevision=f"{folder}:{dim_key}",
        xaxis=dict(tickmode="array", tickvals=xs, ticktext=tick_labels,
                   range=[-0.5, MAX_BARS - 0.5], showgrid=False, zeroline=False,
                   ticks="outside", ticklen=4, tickangle=0, automargin=True,
                   color=AXIS_COLOR),
        yaxis=dict(title=dict(text="Count", font=dict(size=12)),
                   rangemode="tozero", showgrid=True, gridcolor=GRID_COLOR,
                   zeroline=True, zerolinecolor=GRID_COLOR, ticks="outside",
                   ticklen=4, automargin=True, color=AXIS_COLOR),
    )
    return fig


def build_all_figures(domain: Domain, folder: str, folder_rows: pd.DataFrame,
                      periods: List[Period],
                      active_filter: Optional[Dict[str, Any]],
                      presence: Dict[dt.date, Set[str]]) -> Dict[str, go.Figure]:
    return {k: build_stacked_figure(folder, folder_rows, periods, k,
                                    active_filter, domain.dimensions, presence)
            for k in domain.dimension_order}


def render_domain(domain: Domain, store: "DataStore", folder: Optional[str],
                  mode: Optional[str], custom_dates: Optional[Sequence[str]],
                  active_filter: Optional[Dict[str, Any]],
                  today: Optional[dt.date] = None
                  ) -> Tuple[List[go.Figure], str]:
    """Pure render: decide periods, lazily read only the needed files, build the
    figures + info string.  Shared by the Dash callback and the render self-check
    so the exact code that populates the graphs is directly testable (this is what
    guarantees the graphs are never stuck on the 'Loading...' placeholder).
    """
    order = domain.dimension_order
    if today is None:
        today = dt.date.today()

    if not folder or folder == NO_FOLDERS_VALUE:
        msg = (f"No folders under {os.path.abspath(store.root)} - "
               "see the diagnostics above.")
        return ([empty_figure(domain.dimensions[k].title, "No folders found")
                 for k in order], msg)

    dates = store.folder_dates(folder)
    periods = build_periods(dates, mode or MODE_DAILY, today, custom_dates)

    n_files = store.folder_file_count(folder)
    if n_files == 0:
        reason: Optional[str] = f"No workbooks found in folder '{folder}'."
    elif not periods:
        if mode == MODE_CUSTOM and not custom_dates:
            reason = "Custom view: pick one or more dates above."
        else:
            reason = "Files found, but none are dated on/before today."
    else:
        reason = None

    if reason is not None:
        return ([empty_figure(domain.dimensions[k].title, reason)
                 for k in order], reason)

    needed: Set[dt.date] = set()
    for p in periods:
        needed.update(p.dates)
    loaded = store.load_dates(folder, sorted(needed))

    af = (active_filter if (active_filter
                            and active_filter.get("folder") == folder) else None)
    figures = build_all_figures(domain, folder, loaded.rows, periods, af,
                                loaded.presence)
    fig_list = [figures[k] for k in order]

    mode_label = {MODE_DAILY: "daily", MODE_WEEKLY: "weekly",
                  MODE_MONTHLY: "monthly", MODE_CUSTOM: "custom"}.get(mode, "daily")
    info = f"{len(periods)} bar(s) - {mode_label} view"
    if af:
        rdim = domain.dimensions.get(af["dim"])
        if rdim:
            info += f"  |  filter: {rdim.title} = {af['value']}"
    if loaded.errors:
        info += f"  |  {len(loaded.errors)} file error(s)"
    return fig_list, info


