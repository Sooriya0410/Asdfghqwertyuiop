def _clamp01(x: float) -> float:
    return 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)


def _generate_blue_shades(n: int = 30) -> Tuple[str, ...]:
    """Return *n* ordered, visually distinct shades of blue.

    Used for the Test-Case ASIL and CAL graphs, which may have up to 30 distinct
    values.  Because the assignment is "sorted value -> index -> shade", the same
    value always receives the same shade across every bar in a tab.
    """
    shades: List[str] = []
    for i in range(n):
        t = i / float(max(1, n - 1))           # 0 .. 1
        hue = 0.58 + 0.06 * t                   # ~209deg .. 230deg (stays blue)
        light = 0.86 - 0.60 * t                 # light -> dark
        sat = 0.45 + 0.45 * t                   # soft -> rich
        r, g, b = colorsys.hls_to_rgb(hue, _clamp01(light), _clamp01(sat))
        shades.append("#%02X%02X%02X" % (int(round(r * 255)),
                                         int(round(g * 255)),
                                         int(round(b * 255))))
    return tuple(shades)


