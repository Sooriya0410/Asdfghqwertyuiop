def build_domains(req_root: str, tc_root: str) -> List[Domain]:
    """Construct the two dashboards' Domain descriptions for the given roots."""
    requirements = Domain(
        key="requirements", title="Requirements", root=req_root,
        dimensions=DIMENSIONS, dimension_order=DIMENSION_ORDER,
        processor=process_workbook, processed_columns=PROCESSED_COLUMNS,
        aliases=COLUMN_ALIASES, category_canon=CANON_CATEGORY,
        target_categories=TARGET_CATEGORIES,
        target_label="Functional Requirement / Non-Functional Requirement",
        keep_default_na=True,
    )
    test_case = Domain(
        key="test_case", title="Test Case", root=tc_root,
        dimensions=TC_DIMENSIONS, dimension_order=TC_DIMENSION_ORDER,
        processor=process_test_case_workbook,
        processed_columns=TC_PROCESSED_COLUMNS,
        aliases=TC_COLUMN_ALIASES, category_canon=TC_CANON_CATEGORY,
        target_categories=("software test level 1",),
        target_label="Software Test Level 1",
        keep_default_na=False,
    )
    return [requirements, test_case]


# =========================================================================== #
#  SECTION 7 - DATA STORE (lazy discovery + on-demand parallel reads)          #
# =========================================================================== #

@dataclass
class LoadedDates:
    """Rows + per-date column presence for a specific set of requested dates."""
    rows: pd.DataFrame
    presence: Dict[dt.date, Set[str]]
    errors: List[str] = field(default_factory=list)


class DataStore:
    """Owns a domain's files and serves rows on demand.

    Discovery (which files exist and their dates) is cheap and done eagerly.
    Reading/processing a workbook is expensive, so it is deferred until a view
    asks for a particular date, then cached by (mtime, size).  This is what lets
    a folder with thousands of workbooks render instantly: any view needs at most
    ~10 files.
    """

    def __init__(self, domain: Domain) -> None:
        self.domain = domain
        self.root = domain.root
        self._lock = threading.RLock()
        #: folder -> list of (path, date), sorted by date
        self._folder_files: "OrderedDict[str, List[Tuple[str, dt.date]]]" = OrderedDict()
        #: folder -> date -> list of paths for that date
        self._date_index: Dict[str, Dict[dt.date, List[str]]] = {}
        #: path -> (signature, processed_frame, present_set)
        self._file_cache: Dict[str, Tuple[Tuple[float, int], pd.DataFrame, Set[str]]] = {}
        self.last_scanned: Optional[dt.datetime] = None
        self.scan_count: int = 0

    # --------------------------------------------------------------------- #
    #  Discovery (cheap)                                                     #
    # --------------------------------------------------------------------- #
    def scan(self) -> None:
        """(Re)discover folders and files on disk.  Reads no workbook content."""
        with self._lock:
            t0 = time.time()
            folder_names = discover_folders(self.root)
            new_files: "OrderedDict[str, List[Tuple[str, dt.date]]]" = OrderedDict()
            new_index: Dict[str, Dict[dt.date, List[str]]] = {}
            seen: Set[str] = set()

            for folder in folder_names:
                files = discover_workbooks(self.root, folder)
                new_files[folder] = files
                idx: Dict[dt.date, List[str]] = {}
                for path, d in files:
                    idx.setdefault(d, []).append(path)
                    seen.add(path)
                new_index[folder] = idx

            # Drop cache entries for files no longer present.
            for stale in [p for p in self._file_cache if p not in seen]:
                self._file_cache.pop(stale, None)

            self._folder_files = new_files
            self._date_index = new_index
            self.last_scanned = dt.datetime.now()
            self.scan_count += 1
            n_files = sum(len(v) for v in new_files.values())
            log.info("[%s] discovered %d folder(s), %d file(s) in %.3fs (scan #%d)",
                     self.domain.key, len(new_files), n_files,
                     time.time() - t0, self.scan_count)

    # --------------------------------------------------------------------- #
    #  Read API (expensive, lazy, cached, parallel)                         #
    # --------------------------------------------------------------------- #
    @staticmethod
    def _signature(path: str) -> Tuple[float, int]:
        st = os.stat(path)
        return (st.st_mtime, st.st_size)

    def _read_one(self, folder: str, path: str, file_date: dt.date
                  ) -> Tuple[pd.DataFrame, Set[str], Optional[str]]:
        """Read+process one file (cached).  Returns (frame, present, error)."""
        try:
            sig = self._signature(path)
        except OSError as exc:
            return (pd.DataFrame(columns=self.domain.processed_columns), set(),
                    f"{os.path.basename(path)}: stat failed ({exc})")

        cached = self._file_cache.get(path)
        if cached is not None and cached[0] == sig:
            return cached[1], cached[2], None

        try:
            raw = read_workbook(path, keep_default_na=self.domain.keep_default_na)
            frame, present = self.domain.processor(raw, folder, file_date, path)
        except Exception as exc:
            log.warning("[%s] failed to process %s: %s",
                        self.domain.key, path, exc)
            empty = pd.DataFrame(columns=self.domain.processed_columns)
            # Cache the failure so a broken file is not retried every render.
            self._file_cache[path] = (sig, empty, set())
            return empty, set(), f"{os.path.basename(path)}: {exc}"

        self._file_cache[path] = (sig, frame, present)
        return frame, present, None

    def load_dates(self, folder: str, dates: Sequence[dt.date]) -> LoadedDates:
        """Read+process ONLY the files for the requested dates (in parallel)."""
        with self._lock:
            idx = dict(self._date_index.get(folder, {}))
        # Build the concrete read list (path, date) for the requested dates.
        jobs: List[Tuple[str, str, dt.date]] = []
        for d in dates:
            for path in idx.get(d, []):
                jobs.append((folder, path, d))

        frames: List[pd.DataFrame] = []
        presence: Dict[dt.date, Set[str]] = {d: set() for d in dates}
        errors: List[str] = []

        if not jobs:
            empty = pd.DataFrame(columns=self.domain.processed_columns)
            return LoadedDates(rows=empty, presence=presence, errors=errors)

        def _do(job: Tuple[str, str, dt.date]):
            fld, pth, dte = job
            frame, present, err = self._read_one(fld, pth, dte)
            return dte, frame, present, err

        if len(jobs) == 1:
            results = [_do(jobs[0])]
        else:
            with cf.ThreadPoolExecutor(max_workers=READ_WORKERS) as ex:
                results = list(ex.map(_do, jobs))

        for dte, frame, present, err in results:
            presence.setdefault(dte, set()).update(present)
            if frame is not None and not frame.empty:
                frames.append(frame)
            if err:
                errors.append(f"[{folder}] {err}")

        if frames:
            rows = pd.concat(frames, ignore_index=True)
            rows["date"] = pd.to_datetime(rows["date"]).dt.date
        else:
            rows = pd.DataFrame(columns=self.domain.processed_columns)
        return LoadedDates(rows=rows, presence=presence, errors=errors)

    # --------------------------------------------------------------------- #
    #  Light metadata queries (no reading)                                  #
    # --------------------------------------------------------------------- #
    def folder_names(self) -> List[str]:
        with self._lock:
            return list(self._folder_files.keys())

    def folder_dates(self, folder: str) -> List[dt.date]:
        with self._lock:
            return sorted(self._date_index.get(folder, {}).keys())

    def folder_file_count(self, folder: str) -> int:
        with self._lock:
            return len(self._folder_files.get(folder, []))

    def total_files(self) -> int:
        with self._lock:
            return sum(len(v) for v in self._folder_files.values())

    def summary(self) -> str:
        when = self.last_scanned.strftime("%Y-%m-%d %H:%M:%S") if self.last_scanned else "never"
        with self._lock:
            n_folders = len(self._folder_files)
            n_files = sum(len(v) for v in self._folder_files.values())
        return (f"Scanning: {os.path.abspath(self.root)}  |  "
                f"{n_folders} folder(s), {n_files} file(s)  |  "
                f"last scanned: {when}")

    # --------------------------------------------------------------------- #
    #  Diagnostics - explain why a folder may look empty.                   #
    # --------------------------------------------------------------------- #
    def _column_report(self, path: str) -> List[str]:
        out: List[str] = []
        try:
            raw = read_workbook(path, keep_default_na=self.domain.keep_default_na)
        except Exception as exc:
            return [f"        (could not open {os.path.basename(path)}: {exc})"]
        cols = [str(c) for c in raw.columns]
        mapping = build_canonical_column_map(raw.columns, self.domain.aliases)
        out.append(f"        headers in file : {cols}")
        out.append(f"        recognised cols : "
                   f"{mapping if mapping else '(NONE recognised!)'}")
        if self.domain.category_canon not in mapping:
            out.append("        >> No 'Category' column was recognised. Rows are "
                       f"kept only where Category is {self.domain.target_label}. "
                       "Rename your column to 'Category'.")
            return out
        catcol = mapping[self.domain.category_canon]
        sample = sorted({normalize_text(v) for v in raw[catcol].tolist()
                         if normalize_text(v)})[:12]
        out.append(f"        Category values : {sample}")
        if not any(v in self.domain.target_categories for v in sample):
            out.append("        >> None of the Category values match "
                       f"{self.domain.target_label}, so every row is filtered "
                       "out. Fix the Category values (or check the file).")
        return out

    def diagnostics(self, sample_reads: bool = True) -> str:
        """Human-readable report of what was found on disk for this domain."""
        lines: List[str] = []
        lines.append(f"Scanned root (absolute): {os.path.abspath(self.root)}")
        lines.append(f"  folder exists on disk : {os.path.isdir(self.root)}")
        with self._lock:
            folders = list(self._folder_files.items())
        if not folders:
            lines.append("  No project sub-folders were found under the root.")
            lines.append("  Expected layout:  <root>/<Name>/<DD-MON-YY>.xlsx")
            return "\n".join(lines)
        for name, files in folders:
            dates = sorted({d for _, d in files})
            rng = (f"{fmt_date(dates[0])} .. {fmt_date(dates[-1])}"
                   if dates else "no dated files")
            lines.append(f"  [{name}] files={len(files)}  dates={rng}")
            if sample_reads and files:
                # Read just the newest file to explain a possibly-empty folder.
                newest = max(files, key=lambda it: it[1])[0]
                frame, _present, err = self._read_one(name, newest,
                                                      max(d for _, d in files))
                if err:
                    lines.append(f"      ! newest file error: {err}")
                elif frame is None or frame.empty:
                    lines.append("      -> newest file matched 0 rows. Inspecting:")
                    lines.extend(self._column_report(newest))
        return "\n".join(lines)


