def register_global_callbacks(app: "Dash", domains: List[Domain]) -> None:
    """Top-level: toggle panel visibility + nudge Plotly to resize on switch."""

    @app.callback(
        [Output(did(d.key, "panel"), "style") for d in domains],
        Input("domain-tabs", "value"),
