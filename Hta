        def set_steps(self, steps: List[SeqStep]) -> None:
            self.steps = steps
            self.table.setRowCount(len(steps))
            for r, st in enumerate(steps):
                vals = [st.step, "Y" if st.enabled else "N", st.action, st.target, st.value, "", "", st.comment, ""]
                for c, v in enumerate(vals):
                    it = QtWidgets.QTableWidgetItem(str(v))
                    if not st.enabled:
                        it.setForeground(QtGui.QBrush(_COL["grey"]))
                    self.table.setItem(r, c, it)
            self.summary.setText(f"{len(steps)} steps ({sum(1 for s in steps if s.enabled)} enabled)")

        def reset_results(self) -> None:
            for r in range(self.table.rowCount()):
                for c in (5, 6, 8):
                    self.table.item(r, c).setText("")
                    self.table.item(r, c).setBackground(QtGui.QBrush(QtGui.QColor("white")))
                self.table.item(r, 7).setText(self.steps[r].comment)

        def on_step(self, payload: Tuple[int, SeqStep, StepResult]) -> None:
            i, st, r = payload
            if i >= self.table.rowCount():
                return
            self.table.item(i, 3).setText(r.target or st.target)
            self.table.item(i, 5).setText(r.actual)
            self.table.item(i, 6).setText(r.verdict)
            self.table.item(i, 6).setBackground(QtGui.QBrush(_VERDICT_QCOL.get(r.verdict, QtGui.QColor("white"))))
            if r.message:
                self.table.item(i, 7).setText(r.message)
            self.table.item(i, 8).setText(f"{r.duration_ms:.0f}" if r.duration_ms else "")
            self.table.scrollToItem(self.table.item(i, 0))

