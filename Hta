    ("On_Fail", "CONTINUE (default) or STOP the sequence when the step fails."),
    ("Name#2", "Widgets sharing a name on one tab are addressed as Name#2, Name#3 ..."),
]


def _xl_styles() -> SimpleNamespace:
    return SimpleNamespace(
        hfill=PatternFill("solid", fgColor="1F3864"), hfont=Font(bold=True, color="FFFFFF"),
        center=Alignment(horizontal="center", vertical="center", wrap_text=True),
        bold=Font(bold=True), input_fill=PatternFill("solid", fgColor="FFF2CC"),
        ro_fill=PatternFill("solid", fgColor="EDEDED"), grey=Font(color="808080"),
        crit=Font(bold=True, color="C00000"), link=Font(color="0563C1", underline="single"),
        title=Font(bold=True, size=16, color="1F3864"))


def sanitize_sheet_name(name: str, used: set) -> str:
    s = re.sub(r"[\[\]:*?/\\]", "_", str(name)).strip("' ") or "Tab"
    s = s[:31]
    base, i = s, 2
    while s.lower() in used or s.lower() in RESERVED_SHEETS:
        suf = f"_{i}"
        s = base[:31 - len(suf)] + suf
        i += 1
    used.add(s.lower())
    return s


def _excel_value(w: Widget, attr: str) -> Any:
    v = getattr(w, attr)
    if attr == "critical":
        return "Y" if v else ""
    if attr in ("current", "set_value"):
        s = str(v or "").strip()
        if _PURE_NUM_RE.match(s):
            f = float(s)
            return int(f) if f.is_integer() and abs(f) < 1e15 else f
        return s or None
    if attr == "raw":
        return (v or "")[:32000] or None
    if v is None or v == "":
        return None
    return v


def _cell_str(v: Any) -> str:
    if v is None:
        return ""
    if isinstance(v, float):
        return fmt_num(v)
    return str(v).strip()


def _write_tab_sheet(ws: Any, widgets: Sequence[Widget]) -> None:
    st = _xl_styles()
    ws.append([h for h, _, _ in EXCEL_COLUMNS])
    for w in widgets:
        ws.append([_excel_value(w, a) for _, a, _ in EXCEL_COLUMNS])
    ncol = len(EXCEL_COLUMNS)
    for i, (_, _, width) in enumerate(EXCEL_COLUMNS, 1):
        c = ws.cell(1, i)
        c.font, c.fill, c.alignment = st.hfont, st.hfill, st.center
        ws.column_dimensions[get_column_letter(i)].width = width
    ws.row_dimensions[1].height = 22
    ws.freeze_panes = "C2"
    ws.auto_filter.ref = f"A1:{get_column_letter(ncol)}{max(2, len(widgets) + 1)}"
    col = {a: i for i, (_, a, _) in enumerate(EXCEL_COLUMNS, 1)}
    groups: Dict[tuple, List[int]] = defaultdict(list)
    for r, w in enumerate(widgets, 2):
        ws.cell(r, col["name"]).font = st.bold
        sc = ws.cell(r, col["set_value"])
        if w.writable:
            sc.fill = st.input_fill
            opts = w.option_list()
            if opts:
                labels = [l for l, _ in opts]
                f = '"' + ",".join(labels) + '"'
                if all('"' not in l and "," not in l for l in labels) and len(f) <= 255:
                    groups[("list", f)].append(r)
            elif w.min is not None or w.max is not None:
                groups[("dec", w.min, w.max)].append(r)
        else:
            sc.fill = st.ro_fill
            for c in range(1, ncol + 1):
                if c != col["name"]:
                    ws.cell(r, c).font = st.grey
        if w.critical:
            ws.cell(r, col["critical"]).font = st.crit
        for a in ("instance", "access", "critical", "wtype"):
            ws.cell(r, col[a]).alignment = Alignment(horizontal="center")
    letter = get_column_letter(col["set_value"])
    for sig, rows in groups.items():
        if sig[0] == "list":
            dv = DataValidation(type="list", formula1=sig[1], allow_blank=True)
            dv.error = "Choose one of: " + sig[1].strip('"')
        else:
            _, mn, mx = sig
            if mn is not None and mx is not None:
                dv = DataValidation(type="decimal", operator="between", formula1=repr(float(mn)),
                                    formula2=repr(float(mx)), allow_blank=True)
            elif mn is not None:
                dv = DataValidation(type="decimal", operator="greaterThanOrEqual",
                                    formula1=repr(float(mn)), allow_blank=True)
            else:
                dv = DataValidation(type="decimal", operator="lessThanOrEqual",
                                    formula1=repr(float(mx)), allow_blank=True)
            dv.error = f"Allowed range: {fmt_num(mn) or '-inf'} .. {fmt_num(mx) or '+inf'}"
        dv.errorTitle, dv.showErrorMessage = "HTA limit", True
        for r in rows:
            dv.add(f"{letter}{r}")
        ws.add_data_validation(dv)


