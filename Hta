        def _add(self, path: str, note: str = "") -> None:
            for i in range(self.list.count()):
                if self.list.item(i).data(Qt.ItemDataRole.UserRole) == path:
                    return
            it = QtWidgets.QListWidgetItem(path + (f"   [{note}]" if note else ""))
            it.setData(Qt.ItemDataRole.UserRole, path)
            self.list.addItem(it)

        def _add_files(self) -> None:
            exts = " ".join(f"*{e}" for e in self.s.extensions())
            fns, _ = QtWidgets.QFileDialog.getOpenFileNames(self, "HTA layout files", "",
                                                            f"Layouts ({exts});;All files (*)")
            for f in fns:
                self._add(f)

        def _add_folder(self) -> None:
            d = QtWidgets.QFileDialog.getExistingDirectory(self, "Folder with HTA layout files")
            if d:
                self._add(d, "folder")

        def _auto_find(self) -> None:
            self.btn_auto.setEnabled(False)
            self.btn_auto.setText("Searching ...")
            s = self.s
            self.submit(lambda: find_layout_files(default_search_dirs(s), s.extensions()), self._found)

        def _found(self, res: Any) -> None:
            try:
                self.btn_auto.setEnabled(True)
                self.btn_auto.setText("Auto-find")
            except RuntimeError:  # dialog already closed
                return
            if isinstance(res, Exception):
                QtWidgets.QMessageBox.warning(self, "Auto-find", str(res))
                return
            for p, n in res[:50]:
                self._add(str(p), f"{n} widgets")
            if not res:
                QtWidgets.QMessageBox.information(
                    self, "Auto-find", "No layout files found automatically.\n"
                    "Use 'Add folder...' on HTA's installation / project folder, or use the live scan.")

        def _remove(self) -> None:
            for it in self.list.selectedItems():
                self.list.takeItem(self.list.row(it))

        def _browse(self) -> None:
            fn, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Output workbook", self.out.text(), "Excel (*.xlsx)")
            if fn:
                self.out.setText(fn if fn.lower().endswith(".xlsx") else fn + ".xlsx")

        def config(self) -> dict:
            return {"sources": [self.list.item(i).data(Qt.ItemDataRole.UserRole) for i in range(self.list.count())],
                    "live": self.chk_live.isChecked(),
                    "dialogs": self.cmb_dlg.currentText() if self.chk_dlg.isChecked() else "",
                    "out": self.out.text().strip()}

        def accept(self) -> None:
            c = self.config()
            if not (c["sources"] or c["live"] or c["dialogs"]):
                QtWidgets.QMessageBox.warning(self, "Extract", "Add a layout file/folder or tick a live option.")
                return
            if not c["out"]:
                QtWidgets.QMessageBox.warning(self, "Extract", "Choose an output file.")
                return
            super().accept()

    class SettingsDialog(QtWidgets.QDialog):
        def __init__(self, parent: QtWidgets.QWidget, settings: Settings):
            super().__init__(parent)
            self.setWindowTitle("Settings")
            self.resize(640, 640)
            outer = QtWidgets.QVBoxLayout(self)
            area = QtWidgets.QScrollArea()
            area.setWidgetResizable(True)
            inner = QtWidgets.QWidget()
            form = QtWidgets.QFormLayout(inner)
            self.editors: Dict[str, QtWidgets.QWidget] = {}
            for f in fields(Settings):
                val = getattr(settings, f.name)
                if isinstance(val, bool):
                    ed = QtWidgets.QCheckBox()
                    ed.setChecked(val)
                elif isinstance(val, int):
                    ed = QtWidgets.QSpinBox()
                    ed.setRange(0, 600000)
                    ed.setValue(val)
                elif isinstance(val, float):
                    ed = QtWidgets.QDoubleSpinBox()
                    ed.setDecimals(9)
                    ed.setRange(0, 1e6)
                    ed.setValue(val)
                elif f.name == "write_method":
                    ed = QtWidgets.QComboBox()
                    ed.addItems(["keyboard", "pattern", "auto"])
                    ed.setCurrentText(val)
                else:
                    ed = QtWidgets.QLineEdit(str(val))
                ed.setToolTip(SETTINGS_HELP.get(f.name, ""))
                lab = QtWidgets.QLabel(f.name)
                lab.setToolTip(SETTINGS_HELP.get(f.name, ""))
                form.addRow(lab, ed)
                self.editors[f.name] = ed
            area.setWidget(inner)
            outer.addWidget(area)
            outer.addWidget(QtWidgets.QLabel(f"Saved to {Settings.file()}  (hover a field for help)"))
            bb = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.StandardButton.Ok
                                            | QtWidgets.QDialogButtonBox.StandardButton.Cancel)
            bb.accepted.connect(self.accept)
            bb.rejected.connect(self.reject)
            outer.addWidget(bb)

        def apply_to(self, s: Settings) -> None:
            new = {}
            for name, ed in self.editors.items():
                if isinstance(ed, QtWidgets.QCheckBox):
                    new[name] = ed.isChecked()
                elif isinstance(ed, (QtWidgets.QSpinBox, QtWidgets.QDoubleSpinBox)):
                    new[name] = ed.value()
                elif isinstance(ed, QtWidgets.QComboBox):
                    new[name] = ed.currentText()
                else:
                    new[name] = ed.text()
            for k in ("window_title_re", "critical_regex", "property_menu_regex", "property_dialog_title_re"):
                re.compile(new[k])  # raises re.error with a clear message
            for k, v in new.items():
                setattr(s, k, v)

