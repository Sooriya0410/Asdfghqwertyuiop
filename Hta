class JobWorker(threading.Thread):
    def __init__(self, notify: Callable[[Callable[[Any], None], Any], None]):
        super().__init__(name="hta-worker", daemon=True)
        self.q: "queue.Queue[Tuple[Optional[Callable[[], Any]], Optional[Callable[[Any], None]]]]" = queue.Queue()
        self.notify = notify
        self.busy = False

    def submit(self, fn: Callable[[], Any], callback: Optional[Callable[[Any], None]] = None) -> None:
        self.q.put((fn, callback))

    def run(self) -> None:
        _ensure_com()
        while True:
            fn, cb = self.q.get()
            if fn is None:
                return
            self.busy = True
            try:
                res: Any = fn()
            except Exception as e:
                log.error("%s: %s", type(e).__name__, e)
                log.debug(traceback.format_exc())
                res = e
            finally:
                self.busy = False
            if cb is not None:
                try:
                    self.notify(cb, res)
                except Exception:
                    log.exception("notify failed")

    @property
    def pending(self) -> int:
        return self.q.qsize() + (1 if self.busy else 0)

    def shutdown(self) -> None:
        self.q.put((None, None))


