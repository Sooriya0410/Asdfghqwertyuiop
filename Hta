            if w.step:
                bits.append(f"<b>Step</b> {fmt_num(w.step)}")
            if w.options:
                bits.append(f"<b>Options</b> {_html.escape(w.options)}")
            if w.path:
                bits.append(f"<b>Path</b> {_html.escape(w.path)}")
            if w.x is not None:
                bits.append(f"<b>Pos</b> {w.x},{w.y} &nbsp;<b>Size</b> {w.w}x{w.h}")
            if w.group:
                bits.append(f"<b>Group</b> {_html.escape(w.group)}")
            bits.append(f"<b>Source</b> {_html.escape(w.source or '-')}")
            self.info.setText("<br>".join(bits))
            self.btn_press.setVisible(w.wtype in ("Button", "CheckBox"))
