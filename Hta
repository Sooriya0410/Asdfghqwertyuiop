def _decimals_for(w: Widget) -> int:
    d = max(decimals_in(fmt_num(w.step)) if w.step else 0, decimals_in(w.current),
            decimals_in(fmt_num(w.min)), decimals_in(fmt_num(w.max)))
    if d == 0 and w.step is None:
        d = 2
    return min(d, 6)


