    class SignalModel(QtCore.QAbstractTableModel):
        COLS = ["Name", "Type", "Min", "Max", "Unit", "Current", "Set Value", "Status", "Path"]
        SET_COL = 6

        def __init__(self, widgets: Sequence[Widget], on_edit: Callable[[Widget], None]):
            super().__init__()
            self.rows = list(widgets)
            self.on_edit = on_edit
            self._row_of = {w: i for i, w in enumerate(self.rows)}
            self._bold = QtGui.QFont()
            self._bold.setBold(True)

        def rowCount(self, parent=QtCore.QModelIndex()) -> int:
            return 0 if parent.isValid() else len(self.rows)

        def columnCount(self, parent=QtCore.QModelIndex()) -> int:
            return 0 if parent.isValid() else len(self.COLS)

        def headerData(self, section, orientation, role=Qt.ItemDataRole.DisplayRole):
            if role == Qt.ItemDataRole.DisplayRole:
                return self.COLS[section] if orientation == Qt.Orientation.Horizontal else str(section + 1)
            return None

        @staticmethod
        def _text(w: Widget, col: int) -> str:
            return [w.label, w.wtype + ("" if w.writable else " (RO)"), fmt_num(w.min), fmt_num(w.max),
                    w.unit, w.current, w.set_value, w.status, w.path][col]

        def data(self, index, role=Qt.ItemDataRole.DisplayRole):
            if not index.isValid():
                return None
            w, col = self.rows[index.row()], index.column()
            if role in (Qt.ItemDataRole.DisplayRole, Qt.ItemDataRole.EditRole):
                return self._text(w, col)
            if role == WIDGET_ROLE:
                return w
            if role == SORT_ROLE:
                if col in (2, 3, 5):
                    f = to_float(self._text(w, col))
                    return f if f is not None else -1e300
                return self._text(w, col).lower()
            if role == Qt.ItemDataRole.ToolTipRole:
                tip = [f"<b>{_html.escape(w.key)}</b>", f"Type: {w.wtype} ({w.access})"]
                if w.limits_text():
                    tip.append(f"Limits: {_html.escape(w.limits_text())}")
                if w.options:
                    tip.append(f"Options: {_html.escape(w.options)}")
                if w.path:
                    tip.append(f"Path: {_html.escape(w.path)}")
                if w.x is not None:
                    tip.append(f"Position: {w.x},{w.y}  Size: {w.w}x{w.h}")
                if w.status:
                    tip.append(f"Status: {_html.escape(w.status)}")
                return "<br>".join(tip)
            if role == Qt.ItemDataRole.BackgroundRole:
                if col == self.SET_COL and w.writable:
                    return QtGui.QBrush(_COL["pending"] if is_pending(w) else _COL["input"])
                if col == 7 and w.status:
                    st = w.status
                    if st.startswith(("FAIL", "Invalid")):
                        return QtGui.QBrush(_COL["fail"])
                    if st.startswith("OK"):
                        return QtGui.QBrush(_COL["ok"])
                    if st.startswith("DRY"):
                        return QtGui.QBrush(_COL["dry"])
                if not w.writable:
                    return QtGui.QBrush(_COL["ro"])
                return None
            if role == Qt.ItemDataRole.ForegroundRole:
                if col == 0 and w.critical:
                    return QtGui.QBrush(_COL["crit"])
                if not w.writable and col != 0:
                    return QtGui.QBrush(_COL["grey"])
                return None
            if role == Qt.ItemDataRole.FontRole and col == 0:
                return self._bold
            if role == Qt.ItemDataRole.TextAlignmentRole and col in (2, 3, 5, 6):
                return Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter
            return None

        def flags(self, index):
            f = Qt.ItemFlag.ItemIsEnabled | Qt.ItemFlag.ItemIsSelectable
            if index.isValid() and index.column() == self.SET_COL and self.rows[index.row()].writable:
                f |= Qt.ItemFlag.ItemIsEditable
            return f

        def setData(self, index, value, role=Qt.ItemDataRole.EditRole) -> bool:
            if role != Qt.ItemDataRole.EditRole or not index.isValid() or index.column() != self.SET_COL:
                return False
            w = self.rows[index.row()]
            txt = "" if value is None else str(value).strip()
            if txt:
                try:
                    txt = validate_value(w, txt)
                except ValueError as e:
                    w.status = f"Invalid: {e}"
                    self.refresh(w)
                    return False
            w.set_value = txt
            w.status = "" if not txt else ("pending" if is_pending(w) else "= current")
            self.refresh(w)
            self.on_edit(w)
            return True

        def refresh(self, w: Widget) -> None:
            r = self._row_of.get(w)
            if r is not None:
                self.dataChanged.emit(self.index(r, 0), self.index(r, len(self.COLS) - 1))

        def refresh_all(self) -> None:
            if self.rows:
                self.dataChanged.emit(self.index(0, 0), self.index(len(self.rows) - 1, len(self.COLS) - 1))

    class FilterProxy(QtCore.QSortFilterProxyModel):
        def __init__(self, parent=None):
            super().__init__(parent)
            self.text, self.only_pending, self.only_writable = "", False, False
            self.setSortRole(SORT_ROLE)

        def set_filter(self, text: str, only_pending: bool, only_writable: bool) -> None:
            if hasattr(self, "beginFilterChange"):
                self.beginFilterChange()
                self.text, self.only_pending, self.only_writable = text.strip().lower(), only_pending, only_writable
                self.endFilterChange()
            else:
                self.text, self.only_pending, self.only_writable = text.strip().lower(), only_pending, only_writable
                self.invalidateFilter()

        def filterAcceptsRow(self, row: int, parent) -> bool:
            w = self.sourceModel().rows[row]
            if self.only_writable and not w.writable:
                return False
            if self.only_pending and not is_pending(w):
                return False
            if not self.text:
                return True
            hay = f"{w.label} {w.path} {w.wtype} {w.group} {w.unit}".lower()
            return all(tok in hay for tok in self.text.split())

    class SetValueDelegate(QtWidgets.QStyledItemDelegate):
        def createEditor(self, parent, option, index):
            w = index.data(WIDGET_ROLE)
            if w is None:
                return super().createEditor(parent, option, index)
            opts = w.option_list()
            if opts:
                cb = QtWidgets.QComboBox(parent)
                cb.addItems([l for l, _ in opts])
                return cb
            if w.is_numeric and w.min is not None and w.max is not None:
                sp = QtWidgets.QDoubleSpinBox(parent)
                d = _decimals_for(w)
                sp.setDecimals(d)
                sp.setRange(w.min, w.max)
                sp.setSingleStep(w.step or (10 ** -d if d else 1))
                sp.setAccelerated(True)
                return sp
            return QtWidgets.QLineEdit(parent)

        def setEditorData(self, editor, index):
            w = index.data(WIDGET_ROLE)
            val = index.data(Qt.ItemDataRole.EditRole) or ""
            if isinstance(editor, QtWidgets.QComboBox):
                lab = option_label(w.option_list(), val or w.current)
                if lab:
                    editor.setCurrentText(lab)
            elif isinstance(editor, QtWidgets.QDoubleSpinBox):
                f = to_float(val)
                if f is None:
                    f = to_float(w.current)
                if f is None:
                    f = min(max(0.0, editor.minimum()), editor.maximum())
                editor.setValue(f)
                editor.selectAll()
            else:
                editor.setText(val)

        def setModelData(self, editor, model, index):
            if isinstance(editor, QtWidgets.QComboBox):
                v = editor.currentText()
            elif isinstance(editor, QtWidgets.QDoubleSpinBox):
                editor.interpretText()
                v = fmt_num(round(editor.value(), editor.decimals()))
            else:
                v = editor.text()
            model.setData(index, v, Qt.ItemDataRole.EditRole)

