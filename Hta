@dataclass
class SeqStep:
    step: str
    enabled: bool
    action: str
    tab: str = ""
    name: str = ""
    value: str = ""
    tol: Optional[float] = None
    wait_ms: int = 0
    timeout_ms: int = 0
    on_fail: str = "CONTINUE"
    comment: str = ""
    row: int = 0

    @property
    def target(self) -> str:
        return f"{self.tab}/{self.name}" if self.tab and self.name else self.name


@dataclass
class StepResult:
    step: str
    action: str
    target: str = ""
    expected: str = ""
    actual: str = ""
    verdict: str = ""
    message: str = ""
    started: str = ""
    duration_ms: float = 0.0


def load_sequence(path: Any, sheet: str = SHEET_SEQUENCE) -> List[SeqStep]:
    _require_openpyxl()
    wb = openpyxl.load_workbook(Path(path), data_only=True)
    if sheet not in wb.sheetnames:
        raise KeyError(f"sheet '{sheet}' not found in {Path(path).name}")
    ws = wb[sheet]
    hdr = {norm_key(ws.cell(1, c).value): c for c in range(1, ws.max_column + 1)
           if ws.cell(1, c).value not in (None, "")}

    def g(r: int, key: str) -> Any:
        c = hdr.get(norm_key(key))
        return ws.cell(r, c).value if c else None

    steps: List[SeqStep] = []
    for r in range(2, ws.max_row + 1):
        action = _cell_str(g(r, "Action")).upper().replace(" ", "_")
        if not action:
            continue
        en = g(r, "Enabled")
        steps.append(SeqStep(
            step=_cell_str(g(r, "Step")) or str(r - 1),
            enabled=True if en in (None, "") else _truthy(en), action=action,
            tab=_cell_str(g(r, "Tab")), name=_cell_str(g(r, "Name")), value=_cell_str(g(r, "Value")),
            tol=to_float(g(r, "Tolerance")), wait_ms=int(to_float(g(r, "Wait_ms")) or 0),
            timeout_ms=int(to_float(g(r, "Timeout_ms")) or 0),
            on_fail=(_cell_str(g(r, "On_Fail")) or "CONTINUE").upper(),
            comment=_cell_str(g(r, "Comment")), row=r))
    return steps


def _same_text(w: Optional[Widget], a: str, b: str) -> bool:
    opts = w.option_list() if w is not None else []
    if opts:
        la, lb = option_label(opts, a), option_label(opts, b)
        if la is not None and lb is not None:
            return la == lb
    return norm_key(a) == norm_key(b) and (norm_key(a) != "" or a.strip() == b.strip())


def evaluate_expectation(w: Optional[Widget], expected: str, actual: Optional[str],
                         tol: Optional[float] = None, abs_tol: float = 1e-6) -> Tuple[bool, str]:
    """12 | >=11.5 | <3 | !=0 | ==On | 10..20 | 10 to 20 | On  (+ optional tolerance)."""
    if actual is None:
        return False, "no value read"
    exp, act = str(expected).strip(), str(actual).strip()
    a = to_float(act)
    if ".." in exp or re.search(r"\bto\b", exp):
        parts = re.split(r"\s*(?:\.\.|\bto\b)\s*", exp, maxsplit=1)
        lo, hi = (to_float(parts[0]), to_float(parts[1])) if len(parts) == 2 else (None, None)
        if lo is not None and hi is not None and a is not None:
            t = tol or 0.0
            ok = lo - t <= a <= hi + t
            return ok, f"{act} {'within' if ok else 'outside'} [{fmt_num(lo)}..{fmt_num(hi)}]"
    m = re.match(r"^(>=|<=|!=|==|=|>|<)\s*(.+)$", exp)
    if m:
        op, rhs = m.group(1), m.group(2).strip()
        r = to_float(rhs)
        if r is not None and a is not None:
            t = tol if tol is not None else abs_tol
            ok = {">=": a >= r - t, "<=": a <= r + t, ">": a > r, "<": a < r,
                  "==": abs(a - r) <= t, "=": abs(a - r) <= t, "!=": abs(a - r) > t}[op]
            return ok, f"{act} {op} {rhs}: {'true' if ok else 'false'}"
        eq = _same_text(w, act, rhs)
        if op in ("==", "="):
            return eq, f"'{act}' == '{rhs}': {eq}"
        if op == "!=":
            return not eq, f"'{act}' != '{rhs}': {not eq}"
        return False, f"cannot compare '{act}' {op} '{rhs}'"
    if tol is not None and a is not None and to_float(exp) is not None:
        ok = abs(a - to_float(exp)) <= tol
        return ok, f"{act} vs {exp} ±{fmt_num(tol)}"
    if to_float(exp) is None and to_float(act) is None:
        ok = _same_text(w, act, exp)
        return ok, "" if ok else f"read '{act}'"
    ok, msg = values_match(w, exp, act, abs_tol)
    return ok, msg or f"{act} = {exp}"


class SequenceRunner:
    def __init__(self, controller: Controller, settings: Settings, dry_run: bool = False,
                 stop: Optional[threading.Event] = None,
                 prompt: Optional[Callable[[str], bool]] = None,
                 on_step: Optional[Callable[[int, SeqStep, StepResult], None]] = None):
        self.ctl, self.s, self.dry_run = controller, settings, dry_run
        self.stop = stop or threading.Event()
        self.prompt, self.on_step = prompt, on_step
        self.started = ""
        self.finished = ""

    def _sleep(self, ms: float) -> None:
        if ms > 0:
            self.stop.wait(ms / 1000.0)

    def _notify(self, i: int, st: SeqStep, r: StepResult) -> None:
        if self.on_step:
            try:
                self.on_step(i, st, r)
            except Exception:
                log.debug("on_step failed", exc_info=True)

    def run(self, steps: Sequence[SeqStep]) -> List[StepResult]:
        self.started = now_iso()
        results: List[StepResult] = []
        log.info("Sequence started (%d steps%s)", len(steps), ", DRY RUN" if self.dry_run else "")
        for i, st in enumerate(steps):
            if self.stop.is_set():
                r = StepResult(st.step, st.action, st.target, st.value, verdict="ABORTED",
                               message="stopped", started=now_iso())
                results.append(r)
                self._notify(i, st, r)
                break
            if not st.enabled:
                r = StepResult(st.step, st.action, st.target, st.value, verdict="SKIP", started=now_iso())
                results.append(r)
                self._notify(i, st, r)
                continue
            self._notify(i, st, StepResult(st.step, st.action, st.target, st.value, verdict="RUNNING"))
            r = self._exec(st)
            results.append(r)
            self._notify(i, st, r)
            (log.info if r.verdict in ("PASS", "DONE", "SKIP") else log.warning)(
                "Step %s %-10s %-30s %-7s %s", st.step, st.action, r.target, r.verdict, r.message)
            if r.verdict == "ABORTED" or (r.verdict in ("FAIL", "ERROR") and st.on_fail == "STOP"):
                if r.verdict != "ABORTED":
                    log.warning("Sequence stopped at step %s (On_Fail=STOP)", st.step)
                break
            if st.wait_ms and st.action != "WAIT":
                self._sleep(st.wait_ms)
        self.finished = now_iso()
        cnt = Counter(r.verdict for r in results)
        log.info("Sequence finished: %s", ", ".join(f"{k} {v}" for k, v in sorted(cnt.items())))
        return results

    def _exec(self, st: SeqStep) -> StepResult:
        r = StepResult(step=st.step, action=st.action, target=st.target, expected=st.value,
                       started=now_iso())
        t0 = time.perf_counter()
        a = st.action
        try:
            if a == "WAIT":
                ms = st.wait_ms or int(to_float(st.value) or 0)
                self._sleep(ms)
                r.verdict, r.message = "DONE", f"waited {ms} ms"
            elif a == "LOG":
                r.verdict, r.message = "DONE", st.comment or st.value
                log.info("SEQUENCE: %s", r.message)
            elif a == "PAUSE":
                ok = self.prompt(st.comment or st.value or "Sequence paused") if self.prompt else True
                r.verdict, r.message = ("DONE", "operator confirmed") if ok else ("ABORTED", "operator aborted")
                if not ok:
                    self.stop.set()
            elif a in ("SET", "PRESS", "READ", "CHECK", "WAIT_UNTIL"):
                w = self.ctl.table.find(st.name, st.tab or None,
                                        writable=True if a in ("SET", "PRESS") else None)
                r.target = w.key
                if a == "SET":
                    res = self.ctl.set_value(w, st.value, self.dry_run)
                    r.actual, r.message = res.after, res.message
                    r.verdict = "PASS" if res.ok else "FAIL"
                elif a == "PRESS":
                    res = self.ctl.press(w, self.dry_run)
                    r.actual, r.message = res.after, res.message
                    r.verdict = "PASS" if res.ok else "FAIL"
                elif a == "READ":
                    v = self.ctl.read(w)
                    r.actual = v if v is not None else ""
                    r.verdict = "DONE" if v is not None else "FAIL"
                elif self.dry_run:
                    r.verdict, r.message = "SKIP", "dry-run (no verification)"
                elif a == "CHECK":
                    v = self.ctl.read(w)
                    ok, msg = evaluate_expectation(w, st.value, v, st.tol, self.s.abs_tolerance)
                    r.actual, r.message, r.verdict = v or "", msg, "PASS" if ok else "FAIL"
                else:  # WAIT_UNTIL
                    timeout = st.timeout_ms or 5000
                    t_end = time.perf_counter() + timeout / 1000.0
                    while True:
                        v = self.ctl.read(w)
                        ok, msg = evaluate_expectation(w, st.value, v, st.tol, self.s.abs_tolerance)
                        if ok or time.perf_counter() >= t_end or self.stop.is_set():
                            break
                        self._sleep(100)
                    r.actual, r.verdict = v or "", "PASS" if ok else "FAIL"
                    r.message = f"{msg} after {(time.perf_counter() - t0) * 1000:.0f} ms" + \
                                ("" if ok else f" (timeout {timeout} ms)")
            else:
                r.verdict, r.message = "ERROR", f"unknown action '{a}' (use {', '.join(SEQ_ACTIONS)})"
        except KeyError as e:
            r.verdict, r.message = "ERROR", str(e).strip("'\"")
        except Exception as e:
            r.verdict, r.message = "ERROR", f"{type(e).__name__}: {e}"
            log.debug(traceback.format_exc())
        r.duration_ms = (time.perf_counter() - t0) * 1000
        return r


_VERDICT_FILL = {"PASS": "C6EFCE", "DONE": "DDEBF7", "FAIL": "FFC7CE", "ERROR": "FF9999",
                 "SKIP": "EDEDED", "ABORTED": "FFEB9C"}


def overall_verdict(results: Sequence[StepResult]) -> str:
    v = {r.verdict for r in results}
    if v & {"FAIL", "ERROR"}:
        return "FAIL"
    if "ABORTED" in v:
        return "ABORTED"
    return "PASS" if results else "EMPTY"


def write_sequence_report(results: Sequence[StepResult], path: Any, meta: Dict[str, Any]) -> Path:
    _require_openpyxl()
    st = _xl_styles()
    path = Path(path)
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Summary"
    cnt = Counter(r.verdict for r in results)
    overall = overall_verdict(results)
    ws["A1"] = "HTA Sequence Report"
    ws["A1"].font = st.title
    rows = [("Overall", overall), ("Started", meta.get("started", "")),
            ("Finished", meta.get("finished", "")), ("Workbook", meta.get("workbook", "")),
            ("Backend", meta.get("backend", "")), ("Dry run", "Y" if meta.get("dry_run") else "N"),
            ("User", meta.get("user", "")), ("Steps", len(results))]
    rows += [(k, cnt.get(k, 0)) for k in ("PASS", "FAIL", "ERROR", "DONE", "SKIP", "ABORTED")]
    for i, (k, v) in enumerate(rows, 3):
        ws.cell(i, 1, k).font = st.bold
        c = ws.cell(i, 2, v)
        if k == "Overall":
            c.font = Font(bold=True, size=14)
            c.fill = PatternFill("solid", fgColor=_VERDICT_FILL.get(overall, "FFFFFF"))
    ws.column_dimensions["A"].width, ws.column_dimensions["B"].width = 14, 60
    ws2 = wb.create_sheet("Steps")
    heads = ["Step", "Action", "Target", "Expected", "Actual", "Verdict", "Message", "Started", "Duration_ms"]
    ws2.append(heads)
    for r in results:
        ws2.append([r.step, r.action, r.target, r.expected, r.actual, r.verdict, r.message, r.started,
                    round(r.duration_ms)])
    for j, wd in enumerate([7, 12, 34, 14, 14, 10, 60, 24, 12], 1):
        c = ws2.cell(1, j)
        c.font, c.fill, c.alignment = st.hfont, st.hfill, st.center
        ws2.column_dimensions[get_column_letter(j)].width = wd
    for i, r in enumerate(results, 2):
        ws2.cell(i, 6).fill = PatternFill("solid", fgColor=_VERDICT_FILL.get(r.verdict, "FFFFFF"))
    ws2.freeze_panes = "A2"
    ws2.auto_filter.ref = f"A1:I{max(2, len(results) + 1)}"
    path.parent.mkdir(parents=True, exist_ok=True)
    wb.save(path)
    return path


