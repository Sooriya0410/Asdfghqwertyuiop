    x: Optional[int] = None
    y: Optional[int] = None
    w: Optional[int] = None
    h: Optional[int] = None
    group: str = ""
    locator: str = ""
    source: str = ""
    raw: str = ""
    instance: int = 1
    # ---- runtime only (never exported as data) ----
    status: str = ""
    sheet: str = ""
    row: int = 0

    @property
    def label(self) -> str:
        return self.name if self.instance <= 1 else f"{self.name}#{self.instance}"

    @property
    def key(self) -> str:
        return f"{self.tab}/{self.label}"

    @property
    def writable(self) -> bool:
        return self.access.upper() not in ("RO", "R") and self.wtype not in ("Display", "Label")

    @property
    def is_numeric(self) -> bool:
        return not self.options and (self.wtype in ("Input", "Slider", "Display")
                                     or self.min is not None or self.max is not None)

    def option_list(self) -> List[Tuple[str, str]]:
        return parse_options(self.options)

    def limits_text(self) -> str:
        if self.min is None and self.max is None:
            return ""
        return f"{fmt_num(self.min) or '-inf'} .. {fmt_num(self.max) or '+inf'} {self.unit}".strip()


def option_label(opts: Sequence[Tuple[str, str]], value: Any) -> Optional[str]:
    """Map 'On' / 'on' / '1' / 1.0 / 'true' to the option label, or None."""
    v = str(value if value is not None else "").strip()
    nv = norm_key(v)
    for lab, _ in opts:
        if norm_key(lab) == nv and nv:
            return lab
    for lab, val in opts:
        if str(val).strip() == v and v:
            return lab
    fv = to_float(v)
    if fv is not None:
        for lab, val in opts:
            if to_float(val) == fv:
                return lab
    if len(opts) == 2:
        truthy = {"on", "true", "yes", "high", "active", "enable", "enabled", "ein"}
        falsy = {"off", "false", "no", "low", "inactive", "disable", "disabled", "aus"}
        want = True if nv in truthy else False if nv in falsy else None
        if want is not None:
            for lab, val in opts:
                lv = norm_key(lab)
                fvv = to_float(val)
                is_true = lv in truthy or (fvv is not None and fvv != 0)
                if is_true == want:
                    return lab
    return None


def validate_value(w: Widget, raw: Any) -> str:
    """Canonical value to send to HTA, or ValueError with a human readable reason."""
    if not w.writable:
        raise ValueError(f"'{w.label}' is read-only")
    if isinstance(raw, (int, float)) and not isinstance(raw, bool):
        s = fmt_num(raw)
    else:
        s = "" if raw is None else str(raw).strip()
    if s == "":
        raise ValueError("empty value")
    opts = w.option_list()
    if opts:
        lab = option_label(opts, s)
        if lab is None:
            raise ValueError(f"'{s}' is not one of: {', '.join(l for l, _ in opts)}")
        return lab
    numeric = w.wtype in ("Input", "Slider") or w.min is not None or w.max is not None
    if numeric:
        f = to_float(s)
        if f is None:
            if w.min is not None or w.max is not None or w.wtype == "Slider":
                raise ValueError(f"'{s}' is not a number")
            return s  # free-text input field
        eps = 1e-9 * max(1.0, abs(f))
        if w.min is not None and f < w.min - eps:
            raise ValueError(f"{fmt_num(f)} is below the minimum {fmt_num(w.min)}")
        if w.max is not None and f > w.max + eps:
            raise ValueError(f"{fmt_num(f)} is above the maximum {fmt_num(w.max)}")
        return fmt_num(f)
    return s


def values_match(w: Optional[Widget], requested: Any, actual: Any,
                 abs_tol: float = 1e-6) -> Tuple[bool, str]:
    """Compare a requested value with what HTA shows (display rounding aware)."""
    if actual is None:
        return False, "no read-back"
    act, req = str(actual).strip(), str(requested).strip()
    opts = w.option_list() if w is not None else []
    if opts:
        la, lr = option_label(opts, act), option_label(opts, req)
        ok = (la == lr) if (la is not None and lr is not None) else norm_key(act) == norm_key(req)
        return ok, "" if ok else f"HTA shows '{act}'"
    a, r = to_float(act), to_float(req)
    if a is not None and r is not None:
        tol = max(abs_tol, 0.5 * (10 ** -decimals_in(act)) * 1.001)
        diff = abs(a - r)
        if diff <= tol:
            return True, ("" if diff <= abs_tol else f"HTA rounded to {act}")
        return False, f"HTA shows {act}"
    ok = act == req or (norm_key(act) == norm_key(req) and norm_key(act) != "")
    return ok, "" if ok else f"HTA shows '{act}'"


def is_pending(w: Widget) -> bool:
    if not w.writable or not str(w.set_value).strip():
        return False
    return not values_match(w, w.set_value, w.current)[0]


def assign_instances(widgets: Sequence[Widget]) -> None:
    """Number widgets that share a name on the same tab (#1, #2 ...) in reading order."""
    groups: Dict[Tuple[str, str], List[Widget]] = defaultdict(list)
    for w in widgets:
        groups[(norm_key(w.tab), norm_key(w.name))].append(w)
    for items in groups.values():
        if len(items) == 1:
            items[0].instance = 1
            continue
        if all(w.x is not None and w.y is not None for w in items):
            items = reading_order(items, lambda w: w.x, lambda w: w.y, tol=8)
        for n, w in enumerate(items, 1):
            w.instance = n


class SignalTable:
    """Container of all widgets + metadata (tabs keep HTA order)."""

    def __init__(self, widgets: Optional[Iterable[Widget]] = None, meta: Optional[dict] = None):
        self.widgets: List[Widget] = list(widgets or [])
        self.meta: Dict[str, Any] = dict(meta or {})

    def __iter__(self):
        return iter(self.widgets)

    def __len__(self) -> int:
        return len(self.widgets)

    def tabs(self) -> List[str]:
        return list(OrderedDict.fromkeys(w.tab for w in self.widgets))

    def in_tab(self, tab: str) -> List[Widget]:
        return [w for w in self.widgets if w.tab == tab]

    def finalize(self, keep_instances: bool = False) -> "SignalTable":
        if not keep_instances:
            assign_instances(self.widgets)
        return self

    def apply_critical(self, regex: str) -> None:
        try:
            rx = re.compile(regex, re.I)
        except re.error:
            return
        for w in self.widgets:
            if w.writable and rx.search(w.name):
                w.critical = True

    def pending(self, tab: Optional[str] = None) -> List[Widget]:
        return [w for w in self.widgets if (tab is None or w.tab == tab) and is_pending(w)]

    def find(self, name: str, tab: Optional[str] = None, writable: Optional[bool] = None) -> Widget:
        """Find by name ('KL30A V', 'KL30A V#2', 'System/KL30A V'), optional tab."""
        name = str(name or "").strip()
        if not tab and "/" in name:
            t, rest = name.split("/", 1)
            if norm_key(t) in {norm_key(x) for x in self.tabs()}:
                tab, name = t, rest
        inst = None
        m = re.match(r"^(.*?)\s*#(\d+)$", name)
        if m:
            name, inst = m.group(1).strip(), int(m.group(2))
        nn, nt = norm_key(name), (norm_key(tab) if tab else None)
        cands = [w for w in self.widgets
                 if norm_key(w.name) == nn and (nt is None or norm_key(w.tab) == nt)]
        if inst is not None:
            cands = [w for w in cands if w.instance == inst]
        if not cands:
            raise KeyError(f"signal not found: {(tab + '/') if tab else ''}{name}"
                           f"{('#' + str(inst)) if inst else ''}")
        if len(cands) > 1:
            if len({w.tab for w in cands}) > 1:
                raise KeyError(f"'{name}' exists on several tabs "
                               f"({', '.join(sorted({w.tab for w in cands}))}) - fill the Tab column")
            if writable is not None:
                pref = [w for w in cands if w.writable == writable]
                cands = pref or cands
            cands.sort(key=lambda w: w.instance)
        return cands[0]


# =============================================================================
# 4. HTA LAYOUT XML PARSER  (schema tolerant)
# =============================================================================
#   Matches what HTA shows in "Change Widget Properties":
#     <Button name="Ignition OnOff">
#        <Value display="Label"> <Set id="On" label="On" value="1"> ... </Set> </Value>
#        <Path ...>model path</Path>
#        <Position x="771" y="159"/>   <Size width="80" height="50"/>
#     </Button>
#   Any element with a Position/geometry child is a widget; containers with
#   geometry become groups (their offset is added), tab-like ancestors give the tab.
_POS_TAGS = {"position", "pos", "location", "loc", "origin", "topleft", "point"}
_SIZE_TAGS = {"size", "dimension", "dimensions", "extent", "extents"}
_GEOM_TAGS = {"geometry", "rect", "rectangle", "bounds", "boundingbox"}
_PATH_TAGS = {"path", "modelpath", "signal", "signalpath", "variable", "parameter", "param",
              "blockpath", "datapath", "binding", "connection", "address", "port", "mapping",
              "simpath", "source", "target"}
_OPTION_TAGS = {"set", "state", "option", "item", "entry", "enum", "enumvalue", "choice"}
_STYLE_TAGS = {"backgroundcolour", "foregroundcolour", "backgroundcolor", "foregroundcolor",
               "colour", "color", "font", "style", "image", "icon", "border"}
_NON_WIDGET_TAGS = _POS_TAGS | _SIZE_TAGS | _GEOM_TAGS | _PATH_TAGS | _OPTION_TAGS | _STYLE_TAGS
_NAME_KEYS = ("name", "title", "caption", "objectname", "text", "label", "id")
_STRONG_TAB = {"tab", "tabs", "tabpage", "page", "tabsheet", "pages"}
_WEAK_TAB = {"view", "viewset", "views", "sheet", "screen", "panel", "layout", "form", "window",
             "workspace", "desktop", "mainwindow", "dashboard", "set"}

_MIN_KEYS = ("min", "minimum", "minvalue", "minval", "lower", "lowerlimit", "lowerbound", "lowlimit",
             "minlimit", "rangemin", "scalemin", "physmin", "limitmin", "lowervalue")
_MAX_KEYS = ("max", "maximum", "maxvalue", "maxval", "upper", "upperlimit", "upperbound", "highlimit",
             "maxlimit", "rangemax", "scalemax", "physmax", "limitmax", "uppervalue")
_STEP_KEYS = ("step", "stepsize", "singlestep", "increment", "inc", "resolution", "delta")
_DEFAULT_KEYS = ("default", "defaultvalue", "init", "initial", "initvalue", "initialvalue",
                 "startvalue", "value", "current")
_UNIT_KEYS = ("unit", "units", "physunit", "engunit", "suffix")
_RANGE_KEYS = ("range", "limits", "limit", "minmax", "valuerange")


def _local(tag: Any) -> str:
    return tag.rsplit("}", 1)[-1] if isinstance(tag, str) else ""


def _is_el(e: Any) -> bool:
    return isinstance(getattr(e, "tag", None), str)


def _attrs_ci(e: Any) -> Dict[str, str]:
    return {norm_key(_local(k)): (v if v is not None else "") for k, v in e.attrib.items()}


def _leaf_texts(e: Any) -> Dict[str, str]:
    out: Dict[str, str] = {}
    for c in e:
        if _is_el(c) and len(c) == 0 and (c.text or "").strip():
            out.setdefault(norm_key(_local(c.tag)), c.text.strip())
    return out


def _kv(e: Any) -> Dict[str, str]:
    d = _leaf_texts(e)
    d.update(_attrs_ci(e))
    return d


def _nums_dot(text: Optional[str]) -> List[float]:
    return [float(n) for n in _NUM_DOT_RE.findall(text or "")]


def _xy_from(e: Any) -> Optional[Tuple[int, int]]:
    d = _kv(e)
    x, y = _first(d, ("x", "left", "posx", "xpos")), _first(d, ("y", "top", "posy", "ypos"))
    if x is None or y is None:
        nums = _nums_dot(e.text)
        if len(nums) >= 2:
            x, y = nums[0], nums[1]
    fx, fy = to_float(x), to_float(y)
    if fx is None or fy is None:
        return None
    return int(round(fx)), int(round(fy))


def _wh_from(e: Any) -> Optional[Tuple[int, int]]:
    d = _kv(e)
    w = _first(d, ("width", "w", "cx", "sizex", "dx"))
    h = _first(d, ("height", "h", "cy", "sizey", "dy"))
    if w is None or h is None:
        nums = _nums_dot(e.text)
        if len(nums) >= 2:
            w, h = nums[0], nums[1]
    fw, fh = to_float(w), to_float(h)
    if fw is None or fh is None:
        return None
    return int(round(fw)), int(round(fh))


def _geometry(e: Any) -> Tuple[Optional[Tuple[int, int]], Optional[Tuple[int, int]]]:
    pos = size = None
    for c in e:
        if not _is_el(c):
            continue
        t = norm_key(_local(c.tag))
        if t in _POS_TAGS and pos is None:
            pos = _xy_from(c)
        elif t in _SIZE_TAGS and size is None:
            size = _wh_from(c)
        elif t in _GEOM_TAGS:
            nums = _nums_dot(c.text)
            if len(nums) >= 4:  # "x,y,w,h"
                gp, gs = (int(nums[0]), int(nums[1])), (int(nums[2]), int(nums[3]))
            else:
                gp = _xy_from(c)
                d = _kv(c)
                gs = _wh_from(c) if ("width" in d or "w" in d) else None
            pos, size = pos or gp, size or gs
    if pos is None:
        d = _kv(e)
        if "x" in d and "y" in d and _name_of(e):
            pos = _xy_from(e)
    if size is None:
        d = _kv(e)
        if ("width" in d and "height" in d) or ("w" in d and "h" in d):
            size = _wh_from(e)
    return pos, size


def _name_of(e: Any) -> str:
    d = _attrs_ci(e)
    for k in _NAME_KEYS:
        v = d.get(k)
        if v and v.strip():
            return v.strip()
    lt = _leaf_texts(e)
    for k in _NAME_KEYS:
        v = lt.get(k)
        if v and len(v) <= 200:
            return v.strip()
    return ""


def _flatten(e: Any) -> str:
    parts: List[Tuple[str, str]] = []

    def walk(el: Any, prefix: str) -> None:
        for k, v in el.attrib.items():
            parts.append((f"{prefix}{_local(k)}", v))
        txt = (el.text or "").strip()
        if txt:
            parts.append((prefix.rstrip("."), txt))
        for c in el:
            if _is_el(c):
                walk(c, f"{prefix}{_local(c.tag)}.")

    walk(e, "")
    parts = [(k, v) for k, v in parts if str(v).strip()]
    if not parts:
        return ""
    if len(parts) == 1:
        return parts[0][1]
    return "; ".join(f"{k}={v}" if k else v for k, v in parts)


def _path_of(e: Any) -> str:
    for c in e:
        if _is_el(c) and norm_key(_local(c.tag)) in _PATH_TAGS:
            s = _flatten(c)
            if s:
                return s
    d = _attrs_ci(e)
    return _first(d, ("path", "modelpath", "signal", "variable", "blockpath", "parameter",
                      "address", "simpath")) or ""


def _collect_props(e: Any) -> Dict[str, str]:
    """Breadth-first key/value map of a widget subtree (shallow keys win)."""
    props: Dict[str, str] = {}
    dq = deque([e])
    while dq:
        el = dq.popleft()
        for k, v in el.attrib.items():
            props.setdefault(norm_key(_local(k)), v)
        for c in el:
            if not _is_el(c):
                continue
            t = norm_key(_local(c.tag))
            if t in _NON_WIDGET_TAGS:
                continue
            txt = (c.text or "").strip()
            if txt and len(c) == 0:
                props.setdefault(t, txt)
            dq.append(c)
    return props


def _options_of(e: Any) -> List[Tuple[str, str]]:
    opts: List[Tuple[str, str]] = []
    for s in e.iter():
        if s is e or not _is_el(s) or norm_key(_local(s.tag)) not in _OPTION_TAGS:
            continue
        d = _kv(s)
        lab = _first(d, ("label", "text", "display", "caption", "name", "id"))
        val = _first(d, ("value", "val", "data", "number", "raw"))
        if lab is None and val is None:
            txt = (s.text or "").strip()
            if not txt:
                continue
            lab = txt
        lab = str(lab if lab is not None else val).strip()
        val = str(val if val is not None else lab).strip()
        if norm_key(lab) not in {norm_key(l) for l, _ in opts}:
            opts.append((lab, val))
    if len(opts) == 1:  # HTA defines the ON set; the OFF value is "0" unless stated
        props: Dict[str, str] = {}
        for s in e.iter():
            if _is_el(s):
                for k, v in _kv(s).items():
                    props.setdefault(k, v)
        on_lab, on_val = opts[0]
        off_val = _first(props, ("offvalue", "valueoff", "falsevalue", "releasevalue"))
        off_lab = _first(props, ("offlabel", "labeloff", "offtext", "falselabel"))
        if off_val is None:
            fv = to_float(on_val)
            off_val = "0" if (fv is not None and fv != 0) else None
        if off_val is not None:
            opts.append((off_lab or "Off", off_val))
    return opts


def _raw_xml(e: Any, limit: int = 4000) -> str:
    try:
        if HAVE_LXML and not isinstance(e, ET.Element):
            s = LET.tostring(e, encoding="unicode", with_tail=False)
        else:
            s = ET.tostring(e, encoding="unicode")
    except Exception:
        return ""
    s = re.sub(r"\s+xmlns(:\w+)?=\"[^\"]*\"", "", s)
    s = re.sub(r">\s+<", "><", s).strip()
    return s if len(s) <= limit else s[:limit] + " ...(truncated)"


def _tab_strength(e: Any) -> int:
    toks = set(_camel_tokens(_local(e.tag))) | {norm_key(_local(e.tag))}
    if toks & _STRONG_TAB:
        return 2
    if toks & _WEAK_TAB:
        return 1
    return 0


def _context_of(e: Any, parent: Dict[Any, Any], containers: set, default_tab: str
                ) -> Tuple[str, str, Tuple[int, int]]:
    chain = []
    p = parent.get(e)
    while p is not None:
        chain.append(p)
        p = parent.get(p)
    tab_el = next((p for p in chain if _tab_strength(p) == 2 and _name_of(p)), None)
    if tab_el is None:
        tab_el = next((p for p in chain if _tab_strength(p) == 1 and _name_of(p)), None)
    group, ox, oy = "", 0, 0
    for p in chain:
        if p is tab_el:
            break
        if p in containers:
            group = group or _name_of(p)
            pos, _ = _geometry(p)
            if pos:
                ox, oy = ox + pos[0], oy + pos[1]
    return (_name_of(tab_el) if tab_el is not None else default_tab), group, (ox, oy)


def _widget_from_element(e: Any, tab: str, group: str, off: Tuple[int, int], source: str) -> Widget:
    tag = _local(e.tag)
    attrs = _attrs_ci(e)
    type_hint = _first(attrs, ("type", "widgettype", "class", "kind", "control"))
    wtype = normalize_type(type_hint) if type_hint else "Other"
    if wtype == "Other":
        wtype = normalize_type(tag)
    pos, size = _geometry(e)
    props = _collect_props(e)

    def num(keys: Sequence[str]) -> Optional[float]:
        for k in keys:
            if k in props:
                f = to_float(props[k])
                if f is not None:
                    return f
        return None

    mn, mx = num(_MIN_KEYS), num(_MAX_KEYS)
    if mn is None or mx is None:
        rng = _first(props, _RANGE_KEYS)
        if rng:
            nums = [float(n) for n in re.findall(r"[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?", rng)]
            if len(nums) >= 2:
                mn = nums[0] if mn is None else mn
                mx = nums[1] if mx is None else mx
    if mn is not None and mx is not None and mn > mx:
        mn, mx = mx, mn
    opts = _options_of(e)
    if opts and wtype in ("Other", "Display", "Input") and wtype != "ComboBox":
        wtype = "Button" if wtype == "Other" else wtype
    if wtype == "Other" and (mn is not None or mx is not None):
        wtype = "Input"
    name = _name_of(e) or f"{tag}@{pos[0] if pos else '?'},{pos[1] if pos else '?'}"
    unit = _first(props, _UNIT_KEYS) or ""
    if not unit:
        m = re.search(r"\[([^\]]{1,12})\]\s*$", name)
        unit = m.group(1) if m else ""
    ro = _first(props, ("readonly", "ro", "isreadonly", "outputonly"))
    access = "RO" if (wtype in ("Display", "Label") or (ro is not None and _truthy(ro))) else "RW"
    default = _first(props, _DEFAULT_KEYS) or ""
    return Widget(
        tab=tab, name=name, wtype=wtype, access=access, min=mn, max=mx, step=num(_STEP_KEYS),
        unit=unit, options=format_options(opts), current=default, path=_path_of(e),
        x=(pos[0] + off[0]) if pos else None, y=(pos[1] + off[1]) if pos else None,
        w=size[0] if size else None, h=size[1] if size else None,
        group=group, source=source, raw=_raw_xml(e))


def parse_layout_root(root: Any, source: str = "xml", default_tab: str = "Main") -> List[Widget]:
    """Extract all widgets below an XML root element."""
    parent: Dict[Any, Any] = {}
    for p in root.iter():
        if _is_el(p):
            for c in p:
                if _is_el(c):
                    parent[c] = p
    cands = []
    for e in root.iter():
        if not _is_el(e) or norm_key(_local(e.tag)) in _NON_WIDGET_TAGS:
            continue
        pos, _ = _geometry(e)
        if pos is not None:
            cands.append(e)
    cset = set(cands)
    containers = set()
    for c in cands:
        p = parent.get(c)
        while p is not None:
            if p in cset:
                containers.add(p)
            p = parent.get(p)
    out: List[Widget] = []
    for e in cands:
        if e in containers or _tab_strength(e) == 2:
            continue
        tab, group, off = _context_of(e, parent, containers, default_tab)
        out.append(_widget_from_element(e, tab, group, off, source))
    return out


def load_xml(path: Any) -> Any:
    """Parse an XML file; tolerant to bad encodings / stray '&' / control chars."""
    path = Path(path)
    if HAVE_LXML:
        parser = LET.XMLParser(recover=True, remove_comments=True, huge_tree=True,
                               resolve_entities=False, no_network=True)
        try:
            root = LET.parse(str(path), parser).getroot()
            if root is not None:
                return root
        except Exception:
            pass
    try:
        return ET.parse(str(path)).getroot()
    except ET.ParseError:
        data = path.read_bytes()
        text = None
        for enc in ("utf-8-sig", "utf-16", "cp1252", "latin-1"):
            try:
                text = data.decode(enc)
                break
            except UnicodeDecodeError:
                continue
        text = re.sub(r"<\?xml[^>]*\?>", "", text or "", count=1)
        text = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", text)
        text = re.sub(r"&(?!(?:amp|lt|gt|quot|apos|#\d+|#x[0-9a-fA-F]+);)", "&amp;", text)
        return ET.fromstring(text)


def parse_layout_file(path: Any, default_tab: Optional[str] = None) -> List[Widget]:
    path = Path(path)
    root = load_xml(path)
    return parse_layout_root(root, source=f"xml:{path.name}", default_tab=default_tab or path.stem)


def tree_items_to_xml(items: Sequence[Tuple[int, str]]) -> Any:
    """Rebuild XML from the lines of HTA's 'Change Widget Properties' tree.

    items = [(depth, text), ...] e.g. (0,'Button'), (1,'name : Ignition OnOff'), (1,'Value'),
    (2,'display : Label') ...  'key : value' lines become attributes of their parent,
    '<!-- ... -->' lines are ignored.  If no usable depth information exists (all
    depths equal) the first element is the widget and attributes attach to the
    element above them - enough to recover name / options / path / position / size.
    """
    kv_re = re.compile(r"^\s*([^:<>]{1,60}?)\s*:\s*(.*?)\s*$")
    synth = ET.Element("PropertyDialog")
    rows = [(int(d), (t or "").strip()) for d, t in items]
    rows = [(d, t) for d, t in rows if t and not t.startswith("<!--") and not t.startswith("-->")]

    def tagify(t: str) -> str:
        s = re.sub(r"[^A-Za-z0-9_.-]+", "_", t).strip("_") or "Node"
        return s if re.match(r"[A-Za-z_]", s) else "_" + s

    if len({d for d, _ in rows}) <= 1:  # flat mode
        widget = last = None
        for _, t in rows:
            m = kv_re.match(t)
            if m and (last is not None):
                last.set(tagify(m.group(1)), m.group(2))
                continue
            el = ET.Element(tagify(t))
            if widget is None:
                widget = el
                synth.append(el)
            else:
                widget.append(el)
            last = el
        return synth
    stack: List[Tuple[int, Any]] = [(-1, synth)]
    for d, t in rows:
        while len(stack) > 1 and stack[-1][0] >= d:
            stack.pop()
        parent = stack[-1][1]
        m = kv_re.match(t)
        if m and parent is not synth:
            parent.set(tagify(m.group(1)), m.group(2))
            continue
        el = ET.SubElement(parent, tagify(t))
        stack.append((d, el))
    return synth


def depths_from_indent(lefts: Sequence[int], tol: int = 4) -> List[int]:
    """Indentation (x pixel of each tree row) -> depth level."""
    levels: List[int] = []
    for x in sorted(set(lefts)):
        if not levels or x - levels[-1] > tol:
            levels.append(x)
    return [min(range(len(levels)), key=lambda i: abs(levels[i] - x)) for x in lefts]


def find_layout_files(dirs: Iterable[Any], exts: Sequence[str], max_depth: int = 6,
                      max_files: int = 20000, progress: Optional[Callable[[str], None]] = None
                      ) -> List[Tuple[Path, int]]:
    """Search folders for HTA layout files (XML with widget geometry). -> [(path, widgets)]"""
    exts = {e.lower() for e in exts}
    found: Dict[str, Tuple[Path, int]] = {}
    scanned = 0
    skip = {"node_modules", "__pycache__", "$recycle.bin", "windows", "winsxs", ".git", "site-packages"}
    for d in dirs:
        d = Path(d)
        if not d.is_dir():
            continue
        base = len(d.parts)
        if progress:
            progress(f"Searching {d}")
        for cur, subdirs, files in os.walk(d):
            if len(Path(cur).parts) - base >= max_depth:
                subdirs[:] = []
            subdirs[:] = [s for s in subdirs if not s.startswith(".") and s.lower() not in skip]
            for f in files:
                p = Path(cur) / f
                if p.suffix.lower() not in exts:
                    continue
                scanned += 1
                if scanned > max_files:
                    break
                try:
                    if p.stat().st_size > 30_000_000:
                        continue
                    with open(p, "rb") as fh:
                        head = fh.read(3_000_000).decode("utf-8", "ignore")
                    if not re.search(r"<\s*(?:\w+:)?(position|pos|location|geometry|rect)\b", head, re.I):
                        continue
                    n = len(parse_layout_file(p))
                    if n:
                        found[str(p.resolve()).lower()] = (p, n)
                except Exception:
                    continue
    return sorted(found.values(), key=lambda t: -t[1])


def hta_process_hints(settings: "Settings") -> Dict[str, List[str]]:
    """Folders / files used by the running HTA (exe dir, cwd, command line, open files)."""
    hints: Dict[str, List[str]] = {"dirs": [], "files": [], "info": []}
    pids: List[int] = []
    try:
        from pywinauto import Desktop  # type: ignore
        rx = re.compile(settings.window_title_re, re.I)
        for w in Desktop(backend="uia").windows():
            try:
                if rx.match(w.window_text() or ""):
                    pids.append(w.process_id())
            except Exception:
                continue
    except Exception:
        pass
    try:
        import psutil  # type: ignore
    except ImportError:
        hints["info"].append("psutil not installed - process hints unavailable (pip install psutil)")
        return hints
    if not pids:
        for p in psutil.process_iter(["pid", "name"]):
            if re.search(r"hta|hybrid", p.info.get("name") or "", re.I):
                pids.append(p.info["pid"])
    for pid in dict.fromkeys(pids):
        try:
            p = psutil.Process(pid)
            exe = p.exe()
            hints["info"].append(f"PID {pid}: {exe}")
            hints["dirs"] += [str(Path(exe).parent), p.cwd()]
            for a in p.cmdline()[1:]:
                if os.path.exists(a):
                    (hints["files"] if os.path.isfile(a) else hints["dirs"]).append(a)
                    hints["info"].append(f"  cmdline arg: {a}")
            for f in p.open_files():
                if Path(f.path).suffix.lower() in (".xml", ".hta", ".vs", ".view", ".cfg"):
                    hints["files"].append(f.path)
                    hints["info"].append(f"  open file: {f.path}")
        except Exception as e:
            hints["info"].append(f"PID {pid}: {e}")
    hints["dirs"] = list(dict.fromkeys(hints["dirs"]))
    hints["files"] = list(dict.fromkeys(hints["files"]))
    return hints


def default_search_dirs(settings: "Settings") -> List[Path]:
    dirs: List[Path] = [Path.cwd()]
    hints = hta_process_hints(settings)
    dirs += [Path(d) for d in hints["dirs"]] + [Path(f).parent for f in hints["files"]]
    home = Path.home()
    dirs += [home / "Documents", home / "Desktop"]
    rx = re.compile(r"hta|hybrid|htr|hil|mbsp", re.I)
    for env in ("APPDATA", "LOCALAPPDATA", "PROGRAMDATA", "ProgramFiles", "ProgramFiles(x86)"):
        base = os.environ.get(env)
        if base and Path(base).is_dir():
            try:
                dirs += [p for p in Path(base).iterdir() if p.is_dir() and rx.search(p.name)]
            except OSError:
                pass
    if sys.platform == "win32":
        for drive in ("C:\\", "D:\\"):
            try:
                dirs += [p for p in Path(drive).iterdir() if p.is_dir() and rx.search(p.name)]
            except OSError:
                pass
    return list(OrderedDict((str(p).lower(), p) for p in dirs).values())


