            r = self.table.rowCount()
            self.table.insertRow(r)
            self.table.setItem(r, 0, QtWidgets.QTableWidgetItem(w.key))
            self.table.setItem(r, 1, QtWidgets.QTableWidgetItem(w.current))
            self.table.setItem(r, 2, QtWidgets.QTableWidgetItem(""))

        def _remove(self) -> None:
            for r in sorted({i.row() for i in self.table.selectedIndexes()}, reverse=True):
                self.table.removeRow(r)
                del self.items[r]

        def _clear(self) -> None:
            self.table.setRowCount(0)
            self.items.clear()

        def update_values(self, values: Dict[Widget, Optional[str]]) -> None:
            ts = _dt.datetime.now().strftime("%H:%M:%S.%f")[:-3]
            for r, w in enumerate(self.items):
                if w not in values:
                    continue
                v = values[w]
                it = self.table.item(r, 1)
                txt = v if v is not None else "n/a (other tab)"
                changed = it.text() != txt
                it.setText(txt)
                it.setBackground(QtGui.QBrush(_COL["pending"] if changed and v is not None else
                                              QtGui.QColor("white")))
                self.table.item(r, 2).setText(ts)

