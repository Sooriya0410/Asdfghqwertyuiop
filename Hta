def merge_widgets(primary: List[Widget], secondary: List[Widget], tag: str = "uia") -> List[Widget]:
    """Fill gaps of primary (XML/dialog) with secondary (live) data; add unknown widgets.
    XML tab names that do not exist in the UI are renamed to the matching UI tab."""
    assign_instances(primary)
    assign_instances(secondary)
    idx = {(norm_key(w.tab), norm_key(w.name), w.instance): w for w in primary}
    by_name: Dict[Tuple[str, int], List[Widget]] = defaultdict(list)
    for w in primary:
        by_name[(norm_key(w.name), w.instance)].append(w)
    ui_tabs = {norm_key(w.tab) for w in secondary}
    votes: Dict[str, Counter] = defaultdict(Counter)
    out = list(primary)
    merged = added = 0
    for s in secondary:
        p = idx.get((norm_key(s.tab), norm_key(s.name), s.instance))
        if p is None:
            cand = by_name.get((norm_key(s.name), s.instance), [])
            p = cand[0] if len(cand) == 1 and norm_key(cand[0].tab) not in ui_tabs else None
            if p is not None:
                votes[p.tab][s.tab] += 1
        if p is None:
            out.append(s)
            added += 1
            continue
        for attr in ("min", "max", "step", "unit", "options", "current", "locator"):
            if getattr(p, attr) in (None, "") and getattr(s, attr) not in (None, ""):
                setattr(p, attr, getattr(s, attr))
        if p.wtype == "Other" and s.wtype != "Other":
            p.wtype = s.wtype
        if tag not in p.source:
            p.source = f"{p.source}+{tag}" if p.source else tag
        merged += 1
    rename = {xt: c.most_common(1)[0][0] for xt, c in votes.items()}
    for w in out:
        if w.tab in rename and norm_key(w.tab) not in ui_tabs:
            w.tab = rename[w.tab]
    if rename:
        log.info("Tab names mapped to HTA: %s", rename)
    log.info("Merge (%s): %d matched, %d added", tag, merged, added)
    return out


def extract(xml_sources: Sequence[Any] = (), live: bool = False, dialogs: str = "",
            settings: Optional[Settings] = None, backend: Optional[Backend] = None,
            progress: Optional[Callable[[str], None]] = None,
            stop: Optional[threading.Event] = None) -> SignalTable:
    """Collect widgets from XML files/folders, live UI scan and/or property dialogs."""
    s = settings or Settings.load()
    widgets: List[Widget] = []
    sources: List[str] = []
    hta_window = ""
    for src in xml_sources:
        p = Path(src)
        if p.is_file():
            files = [p]
        elif p.is_dir():
            files = sorted(f for f in p.rglob("*") if f.is_file() and f.suffix.lower() in s.extensions())
        else:
            files = []
        if not files:
            log.warning("No layout files found at %s", src)
        for f in files:
            if progress:
                progress(f"Parsing {f.name}")
            try:
                ws = parse_layout_file(f)
            except Exception as e:
                log.warning("Skipped %s: %s", f.name, e)
                continue
            if ws:
                widgets += ws
                sources.append(f.name)
                log.info("%s: %d widgets", f.name, len(ws))
    if live or dialogs:
        be = backend if isinstance(backend, HtaUiaBackend) and backend.connected else None
        if be is None:
            be = HtaUiaBackend(s)
            be.connect()
        hta_window = be.title
        if dialogs:
            dw = be.extract_via_dialogs(dialogs, progress, stop)
            widgets = merge_widgets(widgets, dw, "dialog") if widgets else dw
            sources.append(f"property dialogs ({dialogs})")
        if live:
            lw = be.extract_live(progress, stop)
            widgets = merge_widgets(widgets, lw, "uia") if widgets else lw
            sources.append("live UI scan")
    table = SignalTable(widgets, {"generated": now_iso(), "sources": "; ".join(sources),
                                  "hta_window": hta_window})
    table.finalize()
    table.apply_critical(s.critical_regex)
    log.info("Extracted %d widgets on %d tabs", len(table), len(table.tabs()))
    return table


