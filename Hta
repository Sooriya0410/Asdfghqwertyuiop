def default_sequence_rows(table: SignalTable) -> List[list]:
    """Disabled example steps built from real widget names of this HTA."""
    rows: List[list] = []
    inp = next((w for w in table if w.wtype == "Input" and w.writable and not w.critical
                and (w.min is not None or w.max is not None)), None)
    btn = next((w for w in table if w.wtype == "Button" and len(w.option_list()) >= 2), None)
    disp = next((w for w in table if w.wtype == "Display"), None)

    def add(*vals: Any) -> None:
        rows.append([len(rows) + 1, "N", *vals])

    if inp:
        v = inp.min if (inp.min is not None and inp.min > 0) else 0
        add("SET", inp.tab, inp.label, fmt_num(v), "", 200, "", "CONTINUE", f"Example: set {inp.name}")
    add("WAIT", "", "", "", "", 1000, "", "", "Example: wait 1 s")
    if btn:
        add("SET", btn.tab, btn.label, btn.option_list()[0][0], "", 300, "", "STOP",
            f"Example: switch {btn.name}")
    if disp:
        add("WAIT_UNTIL", disp.tab, disp.label, ">=0", "", "", 3000, "CONTINUE",
            f"Example: wait until {disp.name} >= 0")
        add("CHECK", disp.tab, disp.label, "0", 0.1, "", "", "CONTINUE", f"Example: check {disp.name}")
    add("PAUSE", "", "", "", "", "", "", "", "Example: check the ECU and press OK")
    add("LOG", "", "", "", "", "", "", "", "Example: end of test")
    return rows


