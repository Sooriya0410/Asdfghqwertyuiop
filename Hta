_NUM_FULL_RE = re.compile(
    r"^\s*([-+]?(?:\d[\d.,]*|[.,]\d+)(?:[eE][-+]?\d+)?)\s*([A-Za-z%°µ/\[\]() ]{0,12})\s*$")
_NUM_DOT_RE = re.compile(r"[-+]?\d+(?:\.\d+)?")
_PURE_NUM_RE = re.compile(r"^[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?$")


def norm_key(s: Any) -> str:
    """Case/space/punctuation-insensitive key: 'KL30A V' -> 'kl30av'."""
    return re.sub(r"[^a-z0-9]+", "", str(s if s is not None else "").lower())


def to_float(v: Any) -> Optional[float]:
    """Lenient number parser: 12 / '12.5' / '12,5' / '-40 km/h' / '0x1F' -> float, else None."""
    if v is None or isinstance(v, bool):
        return float(v) if isinstance(v, bool) else None
    if isinstance(v, (int, float)):
        return None if (isinstance(v, float) and (math.isnan(v) or math.isinf(v))) else float(v)
    s = str(v).strip()
    if not s:
        return None
    if re.fullmatch(r"[-+]?0[xX][0-9a-fA-F]+", s):
        return float(int(s, 16))
    m = _NUM_FULL_RE.match(s)
    if not m:
        return None
    num = m.group(1)
    if "," in num and "." in num:          # 1,234.5  -> thousands separator
        num = num.replace(",", "")
    elif num.count(",") == 1:              # 12,5     -> decimal comma
        num = num.replace(",", ".")
    try:
        return float(num)
    except ValueError:
        return None


def fmt_num(v: Any) -> str:
    """12.0 -> '12', 0.1+0.2 -> '0.3', None -> ''."""
    if v is None or v == "":
        return ""
    f = to_float(v)
    if f is None:
        return str(v)
    if f.is_integer() and abs(f) < 1e15:
        return str(int(f))
    return f"{f:.10g}"


def decimals_in(text: Any) -> int:
    m = re.search(r"\d[.,](\d+)", str(text or ""))
    return len(m.group(1)) if m else 0


def now_iso() -> str:
    return _dt.datetime.now().isoformat(timespec="milliseconds")


def _first(d: Dict[str, Any], keys: Iterable[str]) -> Optional[str]:
    for k in keys:
        v = d.get(k)
        if v is not None and str(v).strip() != "":
            return str(v).strip()
    return None


def _truthy(v: Any) -> bool:
    return str(v).strip().lower() in ("1", "y", "yes", "true", "x", "on", "ja")


def reading_order(items: Sequence[Any], getx: Callable[[Any], float], gety: Callable[[Any], float],
                  tol: float = 8.0) -> List[Any]:
    """Sort like a human reads a panel: rows top->bottom (within tol), then left->right."""
    ordered = sorted(items, key=lambda i: (gety(i), getx(i)))
    rows: List[List[Any]] = []
    ref = None
    for it in ordered:
        y = gety(it)
        if ref is None or abs(y - ref) > tol:
            rows.append([it])
            ref = y
        else:
            rows[-1].append(it)
    out: List[Any] = []
    for r in rows:
        out.extend(sorted(r, key=getx))
    return out


def _camel_tokens(tag: str) -> List[str]:
    return [t.lower() for t in re.findall(r"[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|\d+", tag or "")]


