    keys = {w.key for w in table}

    def m(src: str, dst: str, gate: Optional[str] = None, glabel: Optional[str] = None) -> None:
        if src in keys and dst in keys and (gate is None or gate in keys):
            sim.mirror(src, dst, gate, glabel)

    for wl, WL in [("fl", "FL"), ("fr", "FR"), ("rl", "RL"), ("rr", "RR"), ("al", "AL"), ("ar", "AR")]:
        m(f"System/{wl}_tractor_kmh", f"System/{WL}")
