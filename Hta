def export_excel(table: SignalTable, path: Any, sequence_rows: Optional[Sequence[Sequence[Any]]] = None,
                 include_sequence: bool = True) -> Path:
    """Write the signal map workbook (index + one sheet per tab + Sequence)."""
    _require_openpyxl()
    path = Path(path)
    wb = openpyxl.Workbook()
    ws_idx = wb.active
    ws_idx.title = SHEET_INDEX
    used: set = set()
    tab_sheets = []
    for tab in table.tabs():
        wl = table.in_tab(tab)
        ws = wb.create_sheet(sanitize_sheet_name(tab, used))
        _write_tab_sheet(ws, wl)
        for r, w in enumerate(wl, 2):
            w.sheet, w.row = ws.title, r
        tab_sheets.append((tab, ws.title, wl))
    _write_index_sheet(ws_idx, table, tab_sheets)
    if include_sequence:
        _write_sequence_sheet(wb.create_sheet(SHEET_SEQUENCE),
                              sequence_rows if sequence_rows is not None else default_sequence_rows(table))
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        wb.save(path)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
    return path


def _find_header(ws: Any, max_scan: int = 10) -> Tuple[int, Dict[str, int]]:
    for r in range(1, min(ws.max_row, max_scan) + 1):
        cmap: Dict[str, int] = {}
        for c in range(1, min(ws.max_column, 60) + 1):
            v = ws.cell(r, c).value
            if v is None:
                continue
            a = _HEADER_ALIASES.get(norm_key(v))
            if a and a not in cmap:
                cmap[a] = c
        if "name" in cmap and len(cmap) >= 2:
            return r, cmap
    return 0, {}


def import_excel(path: Any) -> SignalTable:
    """Read a signal-map workbook (column order free, extra columns ignored)."""
    _require_openpyxl()
    path = Path(path)
    wb = openpyxl.load_workbook(path, data_only=True)
    meta: Dict[str, Any] = {"excel": str(path)}
    if SHEET_INDEX in wb.sheetnames:
        wsi = wb[SHEET_INDEX]
        for r in range(2, 7):
            k, v = wsi.cell(r, 1).value, wsi.cell(r, 2).value
            if k:
                meta[norm_key(k)] = v
    widgets: List[Widget] = []
    have_instances = True
    for ws in wb.worksheets:
        if ws.title.lower() in RESERVED_SHEETS:
            continue
        hdr, cmap = _find_header(ws)
        if not cmap:
            continue
        if "instance" not in cmap:
            have_instances = False
        for r in range(hdr + 1, ws.max_row + 1):
            def g(attr: str) -> Any:
                return ws.cell(r, cmap[attr]).value if attr in cmap else None
            name = _cell_str(g("name"))
            if not name:
                continue
            inst = to_float(g("instance"))
            wgt = Widget(
                tab=_cell_str(g("tab")) or ws.title, name=name,
                wtype=_cell_str(g("wtype")) or "Other", access=(_cell_str(g("access")) or "RW").upper(),
                min=to_float(g("min")), max=to_float(g("max")), step=to_float(g("step")),
                unit=_cell_str(g("unit")), options=_cell_str(g("options")),
                current=_cell_str(g("current")), set_value=_cell_str(g("set_value")),
                critical=_truthy(g("critical")), path=_cell_str(g("path")),
                x=int(to_float(g("x"))) if to_float(g("x")) is not None else None,
                y=int(to_float(g("y"))) if to_float(g("y")) is not None else None,
                w=int(to_float(g("w"))) if to_float(g("w")) is not None else None,
                h=int(to_float(g("h"))) if to_float(g("h")) is not None else None,
                group=_cell_str(g("group")), locator=_cell_str(g("locator")),
                source=_cell_str(g("source")), raw=_cell_str(g("raw")),
                instance=int(inst) if inst else 1, sheet=ws.title, row=r)
            if wgt.wtype not in WIDGET_TYPES:
                wgt.wtype = normalize_type(wgt.wtype)
            if inst is None:
                have_instances = False
            widgets.append(wgt)
    table = SignalTable(widgets, meta)
    table.finalize(keep_instances=have_instances)
    log.info("Loaded %d widgets on %d tabs from %s", len(table), len(table.tabs()), path.name)
    return table


def update_excel_values(path: Any, table: SignalTable, out_path: Any = None) -> Path:
    """Write Current/Set Value back into the original workbook (formatting & other sheets kept)."""
    _require_openpyxl()
    path = Path(path)
    out = Path(out_path) if out_path else path
    wb = openpyxl.load_workbook(path)
    headers: Dict[str, Dict[str, int]] = {}
    for w in table:
        if not w.sheet or w.sheet not in wb.sheetnames or not w.row:
            continue
        ws = wb[w.sheet]
        if w.sheet not in headers:
            headers[w.sheet] = _find_header(ws)[1]
        cmap = headers[w.sheet]
        if "current" in cmap:
            ws.cell(w.row, cmap["current"]).value = _excel_value(w, "current")
        if "set_value" in cmap:
            ws.cell(w.row, cmap["set_value"]).value = _excel_value(w, "set_value")
    try:
        wb.save(out)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {out} - close it in Excel first.") from e
    return out


