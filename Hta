class Widget:
    """One HTA control.  eq=False -> hashable by identity (usable as dict key)."""
    tab: str
    name: str
    wtype: str = "Other"
    access: str = "RW"
    min: Optional[float] = None
    max: Optional[float] = None
    step: Optional[float] = None
    unit: str = ""
    options: str = ""
    current: str = ""
    set_value: str = ""
    critical: bool = False
