def _make_backend(args: argparse.Namespace, s: Settings, table: SignalTable) -> Backend:
    if getattr(args, "sim", False):
        demo = "DEMO" in str(table.meta.get("sources", "")) or "demo" in str(getattr(args, "excel", "")).lower()
        be: Backend = demo_simulator(s, table) if demo else SimulatorBackend(s, table)
    else:
        be = HtaUiaBackend(s)
    log.info("Backend: %s", be.connect())
    return be


def _confirm(prompt: str) -> bool:
    try:
        return input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def cmd_extract(args: argparse.Namespace, s: Settings) -> int:
    table = extract(args.xml or [], live=args.live, dialogs=args.dialogs or "", settings=s,
                    progress=lambda m: log.info(m))
    if not len(table):
        log.error("Nothing extracted. Give --xml <file|folder> and/or --live (HTA running).")
        return 2
    out = export_excel(table, args.output)
    print(f"\n{len(table)} widgets on {len(table.tabs())} tabs -> {out}")
    for t in table.tabs():
        c = Counter(w.wtype for w in table.in_tab(t))
        print(f"  {t:30s} {sum(c.values()):4d}  " + ", ".join(f"{k} {v}" for k, v in c.most_common()))
    return 0


def cmd_find(args: argparse.Namespace, s: Settings) -> int:
    hints = hta_process_hints(s)
    for line in hints["info"]:
        print(line)
    dirs = [Path(d) for d in args.dirs] if args.dirs else default_search_dirs(s)
    print("Searching:\n  " + "\n  ".join(str(d) for d in dirs))
    res = find_layout_files(dirs, s.extensions(), max_depth=args.depth)
    if not res:
        print("\nNo HTA layout files found. Try: find-layouts <HTA install / project folder> --depth 10")
        return 1
    print(f"\n{'widgets':>8}  file")
    for p, n in res:
        print(f"{n:8d}  {p}")
    print(f"\nNext:  python {Path(sys.argv[0]).name} extract --xml \"{res[0][0]}\" --live -o HTA_Signals.xlsx")
    return 0


def cmd_inspect(args: argparse.Namespace, s: Settings) -> int:
    be = HtaUiaBackend(s)
    print(be.connect())
    out = be.inspect(args.output or HOME_DIR / f"hta_inspect_{_dt.datetime.now():%Y%m%d_%H%M}.txt")
    print(f"Control dump written to {out}")
    return 0


def cmd_set(args: argparse.Namespace, s: Settings) -> int:
    table = import_excel(args.excel)
    w = table.find(args.signal, args.tab, writable=True)
    try:
        validate_value(w, args.value)
    except ValueError as e:
        print(f"REJECTED {w.key}: {e}")
        return 1
    if w.critical and s.confirm_critical and not args.yes and not args.dry_run:
        if not _confirm(f"{w.key} is CRITICAL. Write '{args.value}'?"):
            return 3
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))
    res = ctl.set_value(w, args.value, args.dry_run)
    print(f"{'OK  ' if res.ok else 'FAIL'} {w.key}: {res.before!r} -> {res.after!r}  {res.message}")
    return 0 if res.ok else 1


def cmd_get(args: argparse.Namespace, s: Settings) -> int:
    table = import_excel(args.excel)
    ctl = Controller(_make_backend(args, s, table), table, s)
    rc = 0
    for name in args.signal:
        try:
            w = table.find(name, args.tab)
        except KeyError as e:
            print(f"?    {name}: {e}")
            rc = 1
            continue
        v = ctl.read(w)
        print(f"{w.key:45s} = {v if v is not None else '<not readable>'} {w.unit}")
    return rc


def cmd_apply(args: argparse.Namespace, s: Settings) -> int:
    table = import_excel(args.excel)
    ws = [w for w in table if w.writable and str(w.set_value).strip()
          and (not args.tab or norm_key(w.tab) == norm_key(args.tab))]
    if not ws:
        print("No 'Set Value' cells filled in.")
        return 0
    crit = [w for w in ws if w.critical]
    if crit and s.confirm_critical and not args.yes and not args.dry_run:
        print("Critical signals:\n  " + "\n  ".join(f"{w.key} -> {w.set_value}" for w in crit))
        if not _confirm("Write them?"):
            return 3
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))
    res = ctl.apply_pending(ws, args.dry_run)
    for w, r in zip(ws, res):
        print(f"{'OK  ' if r.ok else 'FAIL'} {w.key:45s} {r.requested:>10} -> {r.after:<10} {r.message}")
    if args.save:
        update_excel_values(args.excel, table)
    bad = sum(1 for r in res if not r.ok)
    print(f"\n{len(res) - bad}/{len(res)} written")
    return 1 if bad else 0


def cmd_run(args: argparse.Namespace, s: Settings) -> int:
    table = import_excel(args.excel)
    steps = load_sequence(args.excel, args.sheet)
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))

    def prompt(msg: str) -> bool:
        if args.yes:
            return True
        try:
            return input(f"\nPAUSE: {msg}\n  [Enter] continue, [a] abort: ").strip().lower() != "a"
        except EOFError:
            return True

    runner = SequenceRunner(ctl, s, args.dry_run, prompt=prompt)
    results = runner.run(steps)
    report = Path(args.report) if args.report else \
        s.report_path() / f"SeqReport_{_dt.datetime.now():%Y%m%d_%H%M%S}.xlsx"
    write_sequence_report(results, report, {"workbook": str(args.excel), "backend": ctl.backend.kind,
                                            "dry_run": args.dry_run, "started": runner.started,
                                            "finished": runner.finished, "user": AuditLog(".").user})
    print()
    for r in results:
        print(f"{r.step:>4} {r.action:10s} {r.target:40s} {r.verdict:7s} {r.actual:>10}  {r.message}")
    verdict = overall_verdict(results)
    print(f"\nOVERALL: {verdict}    report: {report}")
    return 0 if verdict == "PASS" else 1


def cmd_demo(args: argparse.Namespace, s: Settings) -> int:
    folder = Path(args.folder) if args.folder else HOME_DIR / "demo"
    xml_path, xlsx = make_demo(folder)
    print(f"Demo layout : {xml_path}\nDemo workbook: {xlsx}")
    if args.no_gui:
        ns = argparse.Namespace(excel=str(xlsx), sheet=SHEET_SEQUENCE, sim=True, dry_run=False, yes=True,
                                report=str(folder / "SeqReport_DEMO.xlsx"))
        return cmd_run(ns, s)
    return run_gui(xlsx, s, demo=True)


