@dataclass
class Settings:
    window_title_re: str = r".*Hybrid Test Application.*"
    write_method: str = "keyboard"
    verify_writes: bool = True
    settle_ms: int = 250
    tab_switch_ms: int = 450
    abs_tolerance: float = 1e-6
    confirm_critical: bool = True
    critical_regex: str = r"ignition|\bkl\s?(15|30|31|50)|hil\s?init|reset|power|battery|standstill"
    allow_coordinate_fallback: bool = True
    refocus_after_write: bool = True
    label_max_gap_px: int = 45
    layout_extensions: str = ".xml;.hta;.vs;.view;.cfg"
    property_menu_regex: str = r"propert|change widget"
    property_dialog_title_re: str = r".*widget propert.*"
    poll_ms: int = 1000
    audit_dir: str = ""
    report_dir: str = ""

    @staticmethod
    def file() -> Path:
        return HOME_DIR / "settings.json"

    @classmethod
    def load(cls) -> "Settings":
        s = cls()
        try:
            data = json.loads(cls.file().read_text("utf-8"))
            for f in fields(cls):
                if f.name in data:
                    cur = getattr(s, f.name)
                    setattr(s, f.name, type(cur)(data[f.name]))
        except FileNotFoundError:
            pass
        except Exception as e:  # corrupt settings must never stop the tool
            log.warning("Settings file ignored (%s)", e)
        return s

    def save(self) -> None:
        self.file().parent.mkdir(parents=True, exist_ok=True)
        self.file().write_text(json.dumps({f.name: getattr(self, f.name) for f in fields(self)},
                                          indent=2), "utf-8")

    def extensions(self) -> List[str]:
        return [e.strip().lower() if e.strip().startswith(".") else "." + e.strip().lower()
                for e in self.layout_extensions.split(";") if e.strip()]

    def audit_path(self) -> Path:
        return Path(self.audit_dir) if self.audit_dir else HOME_DIR / "audit"

    def report_path(self) -> Path:
        return Path(self.report_dir) if self.report_dir else HOME_DIR / "reports"


def setup_logging(console_level: int = logging.INFO, console: bool = True) -> Path:
    """Rotating debug log in HTA_Bridge/logs + optional console output."""
    logdir = HOME_DIR / "logs"
    logfile = logdir / "hta_bridge.log"
    log.setLevel(logging.DEBUG)
    log.propagate = False
    try:
        logdir.mkdir(parents=True, exist_ok=True)
        if not any(isinstance(h, logging.handlers.RotatingFileHandler) for h in log.handlers):
            fh = logging.handlers.RotatingFileHandler(logfile, maxBytes=2_000_000, backupCount=5,
                                                      encoding="utf-8")
            fh.setLevel(logging.DEBUG)
            fh.setFormatter(logging.Formatter(
                "%(asctime)s %(levelname)-7s [%(threadName)s] %(message)s"))
            log.addHandler(fh)
    except OSError:
        pass
    if console and not any(type(h) is logging.StreamHandler for h in log.handlers):
        sh = logging.StreamHandler()
        sh.setLevel(console_level)
        sh.setFormatter(logging.Formatter("%(levelname)-7s %(message)s"))
        log.addHandler(sh)
    return logfile


