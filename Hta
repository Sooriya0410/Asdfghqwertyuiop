WIDGET_TYPES = ("Input", "Slider", "Button", "CheckBox", "ComboBox", "Display", "Label", "Other")

_TYPE_RULES: List[Tuple[str, Tuple[str, ...]]] = [
    ("Button", ("button", "pushbutton", "toggle", "switch", "onoff")),
    ("CheckBox", ("checkbox", "check")),
    ("ComboBox", ("combo", "dropdown", "listbox", "enum", "select")),
    ("Slider", ("slider", "scroll", "knob", "dial", "wheel", "fader", "trackbar")),
    ("Display", ("display", "lcd", "indicator", "led", "lamp", "gauge", "meter", "thermo",
                 "progress", "readout", "monitor", "scope", "plot", "graph", "chart")),
    ("Input", ("spin", "input", "edit", "entry", "numeric", "field", "textbox")),
    ("Display", ("label", "text", "output", "static", "status")),
    ("Input", ("value", "param", "number", "double", "int", "float")),
]


def normalize_type(tag: str) -> str:
    """Map an HTA/Qt/XML widget tag to one of WIDGET_TYPES."""
    toks = _camel_tokens(tag) or [norm_key(tag)]
    full = norm_key(tag)
    for name, keys in _TYPE_RULES:
        for k in keys:
            if any(t.startswith(k) for t in toks) or (len(k) >= 5 and k in full):
                return name
    return "Other"


def parse_options(s: str) -> List[Tuple[str, str]]:
    """'On=1; Off=0' -> [('On','1'), ('Off','0')]."""
    out: List[Tuple[str, str]] = []
    for part in re.split(r"[;\n|]", s or ""):
        part = part.strip()
        if not part:
            continue
        if "=" in part:
            lab, val = part.split("=", 1)
            out.append((lab.strip(), val.strip()))
        else:
            out.append((part, part))
    return out


def format_options(opts: Sequence[Tuple[str, str]]) -> str:
    return "; ".join(f"{l}={v}" for l, v in opts)


