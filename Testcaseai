            pump()
            self.assertEqual(app.tree_tc.set(rej, "dec"), "Confirmed (you)")
            wait_for(lambda: os.path.isfile(os.path.join(c["tmp"], "gui_confirmed_2.xlsx")), "auto export")
            wait_for(lambda: "saved" in app.lbl_status.cget("text"), "export message")
