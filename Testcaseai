def confirmed_snapshot(results: Sequence[ChangeResult]) -> List[Tuple[Change, List[Tuple[TestCase, str, Optional[float], str, float, str]]]]:
    """(change, [(test case, status, llm p, llm reason, matcher conf, short matcher reason)]) - safe to
    hand to another thread."""
    snap = []
    for res in results:
        rows = []
        for m in res.matches:
            rows.append((m.tc, m.status, m.llm, m.llm_why, m.conf, "; ".join((m.reasons or [])[:3])))
        snap.append((res.change, rows))
    return snap


def training_confirmations(model: Model, store: Optional[TestCaseStore] = None) -> List[List[Any]]:
    """Every test case you confirmed in training (Right, expected-but-missing, or listed with mark 10)."""
    rows: List[List[Any]] = []
    for ev in model.read_events():
        refs = ev.get("refs", {})
        mark = ev.get("mark", "")
        how_list = (("Right", ev.get("right", [])), ("Expected (model had missed it)", ev.get("missing", [])),
                    ("Listed with mark 10", ev.get("implicit_right", [])))
        for how, keys in how_list:
            for k in keys:
                ref = refs.get(k, {})
                tc_id = ref.get("id") or (k[3:] if k.startswith("id:") else k)
                text = ""
                if store is not None:
                    d = store.by_key.get(k)
                    if d is None and ref.get("fp"):
                        d = store.by_fp.get(ref["fp"])
                    if d is not None:
                        text = store.cases[d].text
                rows.append([ev.get("ts", ""), ev.get("label", ""), tc_id, how,
                             mark if isinstance(mark, int) and mark >= 0 else "quick confirm",
                             ev.get("note", ""), text or ref.get("snip", "")])
    return rows


def _save_workbook(wb: Any, path: str) -> str:
    """Save; when the file is open in Excel (locked), save next to it with a time stamp."""
    try:
        wb.save(path)
        return path
    except PermissionError:
        stem, ext = os.path.splitext(path)
        alt = "%s_%s%s" % (stem, _dt.datetime.now().strftime("%Y%m%d_%H%M%S"), ext or ".xlsx")
        wb.save(alt)
        return alt


def resolve_export_path(path: str) -> str:
    """A folder gets a dated file name; a file name without extension gets .xlsx."""
    path = (path or "").strip().strip('"')
    if not path:
        raise ValueError("No export path is set.")
    if os.path.isdir(path) or path.endswith(("\\", "/")):
        os.makedirs(path, exist_ok=True)
        return os.path.join(path, "confirmed_test_cases_%s.xlsx" % _dt.datetime.now().strftime("%Y%m%d_%H%M"))
    if not os.path.splitext(path)[1]:
        path += ".xlsx"
    parent = os.path.dirname(os.path.abspath(path))
    os.makedirs(parent, exist_ok=True)
    return path


def write_confirmed_excel(path: str, snapshot: Sequence[Tuple[Change, List[Tuple[Any, ...]]]],
                          model: Model, store: Optional[TestCaseStore], run_info: Sequence[Tuple[str, Any]] = ()) -> str:
    """The confirmed test cases (by you and by the LLM) with reasons, the ones to review, and
    every confirmation from your training.  Returns the path that was written."""
    openpyxl = require_openpyxl()
    from openpyxl.styles import Alignment, PatternFill
    target = resolve_export_path(path)
    wrap = Alignment(wrap_text=True, vertical="top")
    fill = {STATUS_YOU: PatternFill("solid", fgColor="BDD7EE"), STATUS_LLM: PatternFill("solid", fgColor="C6EFCE"),
            STATUS_REJECTED: PatternFill("solid", fgColor="F8CBAD"), STATUS_UNCHECKED: PatternFill("solid", fgColor="FFEB9C")}
    by_tc: Dict[int, Dict[str, Any]] = {}
    review: List[List[Any]] = []
    wb = openpyxl.Workbook()
    wsum = wb.active
    wsum.title = "Confirmed Test Cases"
    wch = wb.create_sheet("Confirmed By Change")
    wch.append(["Change ID", "File", "File Type", "Change", "Function", "New Lines", "Test Case", "Confirmed By",
                "LLM %", "Matcher %", "Reason"])
    for ch, rows in snapshot:
        for tc, status, p, why, conf, mwhy in rows:
            if status in CONFIRMED_STATUSES:
                reason = why or (("Confirmed by you in training. " + mwhy) if status == STATUS_YOU else mwhy)
                wch.append([ch.cid, ch.file, ch.kind, ch.status, ", ".join(ch.functions), ch.new_lines or ch.old_lines,
                            tc.tc_id, "You" if status == STATUS_YOU else "LLM",
                            round(p * 100, 1) if p is not None else "", round(conf * 100, 1), xl_text(reason)])
                wch.cell(row=wch.max_row, column=8).fill = fill[status]
                a = by_tc.setdefault(tc.idx, {"tc": tc, "by": set(), "p": None, "changes": [], "why": ""})
                a["by"].add(status)
                if p is not None and (a["p"] is None or p > a["p"]):
                    a["p"] = p
                a["changes"].append("%s  %s" % (ch.cid, ch.label()))
                if reason and not a["why"]:
                    a["why"] = reason
            elif status in (STATUS_REJECTED, STATUS_UNCHECKED) and (status == STATUS_UNCHECKED or (p or 0) >= 0.2
                                                                    or conf >= LEVEL_MED):
                review.append([ch.cid, ch.file, ", ".join(ch.functions), ch.new_lines or ch.old_lines, tc.tc_id,
                               STATUS_LABEL[status], round(p * 100, 1) if p is not None else "", round(conf * 100, 1),
                               xl_text(why or mwhy)])
    _style_header(wch, 11)
    _set_widths(wch, [10, 40, 9, 10, 26, 10, 16, 13, 8, 10, 80])
    if wch.max_row > 1:
        wch.auto_filter.ref = wch.dimensions

    wsum.append(["Test Case", "Excel Row", "Confirmed By", "LLM %", "Changes", "Reason", "Test Case Text"])
    order = sorted(by_tc.values(), key=lambda a: (0 if STATUS_YOU in a["by"] else 1, -(a["p"] or 0), a["tc"].idx))
    for a in order:
        tc = a["tc"]
        by = " + ".join(x for x, s in (("You", STATUS_YOU), ("LLM", STATUS_LLM)) if s in a["by"])
        wsum.append([tc.tc_id, tc.row, by, round(a["p"] * 100, 1) if a["p"] is not None else "",
                     xl_text("\n".join(a["changes"][:20]) + ("\n... +%d more" % (len(a["changes"]) - 20)
                                                             if len(a["changes"]) > 20 else "")),
                     xl_text(a["why"]), xl_text(tc.text, 6000)])
        r = wsum.max_row
        wsum.cell(row=r, column=3).fill = fill[STATUS_YOU if STATUS_YOU in a["by"] else STATUS_LLM]
        for c in (5, 6, 7):
            wsum.cell(row=r, column=c).alignment = wrap
    _style_header(wsum, 7)
    _set_widths(wsum, [18, 10, 14, 8, 50, 70, 80])
    if order:
        wsum.auto_filter.ref = wsum.dimensions

    wrv = wb.create_sheet("Not Confirmed (review)")
    wrv.append(["Change ID", "File", "Function", "New Lines", "Test Case", "Decision", "LLM %", "Matcher %", "Reason"])
    for row in review:
        wrv.append(row)
        status = STATUS_REJECTED if row[5] == STATUS_LABEL[STATUS_REJECTED] else STATUS_UNCHECKED
        wrv.cell(row=wrv.max_row, column=6).fill = fill[status]
    _style_header(wrv, 9)
    _set_widths(wrv, [10, 40, 26, 10, 16, 20, 8, 10, 80])
    if review:
        wrv.auto_filter.ref = wrv.dimensions

    wtr = wb.create_sheet("Confirmed In Training")
    wtr.append(["Date", "Change / Input", "Test Case", "Confirmed As", "Marks", "Note", "Test Case Text"])
    trows = training_confirmations(model, store)
    for row in trows:
        wtr.append([xl_text(x) if isinstance(x, str) else x for x in row[:6]] + [xl_text(row[6], 6000)])
    _style_header(wtr, 7)
    _set_widths(wtr, [19, 60, 16, 26, 12, 30, 80])
    if trows:
        wtr.auto_filter.ref = wtr.dimensions

    wi = wb.create_sheet("Run Info")
    wi.append(["Item", "Value"])
    for k, v in [("Created", now_iso()), ("Tool", "%s %s" % (APP_NAME, APP_VERSION)),
                 ("Confirmed test cases (unique)", len(order)),
                 ("Confirmed by you", sum(1 for a in order if STATUS_YOU in a["by"])),
                 ("Confirmed by the LLM only", sum(1 for a in order if a["by"] == {STATUS_LLM})),
                 ("To review (not confirmed)", len(review)), ("Confirmations in training", len(trows)),
                 ("Model folder", str(model.dir))] + list(run_info):
        wi.append([k, xl_text(v) if isinstance(v, str) else v])
    _style_header(wi, 2)
    _set_widths(wi, [34, 90])
    return _save_workbook(wb, target)

