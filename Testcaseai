def _np() -> Any:
    try:
        import numpy
        return numpy
    except ImportError:
        return None


def _sigmoid(np: Any, z: Any) -> Any:
    return 1.0 / (1.0 + np.exp(-np.clip(z, -35.0, 35.0)))


def _prov_bucket(src: str) -> int:
    """Where a word of the change comes from: 0 = the changed lines, 1 = the function and
    its callers, 2 = file / folder / surrounding context."""
    s = src.lower()
    if s.startswith(("changed line", "old / removed", "your input", "llm:", "search")):
        return 0
    if s.startswith(("function ", "comment above", "comment inside", "code inside")) or " calls " in s \
            or "uses changed symbol" in s:
        return 1
    return 2


