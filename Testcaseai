_RE_TOKEN = re.compile(
    r"0[xX][0-9A-Fa-f]+"
    r"|\$[0-9A-Fa-f]{2,8}\b"
    r"|\b(?=[0-9A-Fa-f]*\d)[0-9A-Fa-f]{2,8}[hH]\b"
    r"|[A-Za-z_][A-Za-z0-9_]*"
    r"|\d+(?:\.\d+)?")
_RE_CAMEL = re.compile(r"[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|\d+")
_RE_HEX_H = re.compile(r"(?=[0-9A-Fa-f]*\d)[0-9A-Fa-f]{2,8}[hH]")
_RE_HEX_0X = re.compile(r"0[xX][0-9A-Fa-f]+")
_RE_INNER_CAMEL = re.compile(r"[a-z][A-Z]")
_RE_HEX_WORD = re.compile(r"(?=[0-9A-Fa-f]*\d)(?=[0-9A-Fa-f]*[A-Fa-f])[0-9A-Fa-f]{4}")       # F190, 0A1B
_RE_BYTE_PAIR = re.compile(r"\b([0-9A-Fa-f]{2})[ \t]+(?=([0-9A-Fa-f]{2})\b)")                # "F1 90"
_VOWELS = set("aeiou")


def _norm_hex(digits: str) -> str:
    try:
        return "0x%x" % int(digits, 16)
    except ValueError:
        return digits.lower()


@lru_cache(maxsize=150000)
def split_identifier(tok: str) -> Tuple[Tuple[str, ...], Tuple[str, ...]]:
    """Split an identifier into (words, compounds).
       WdgM_CheckpointReached -> words ('wdgm', 'wdg', 'm', 'checkpointreached', 'checkpoint', 'reached')
       CheckUnderVolt         -> words ('check', 'under', 'volt'),
                                 compounds ('checkundervolt', 'checkunder', 'undervolt')
    A two-piece name (WdgM, VehSpd, UnderVolt) is a word of its own; longer joins are
    'compounds' - kept so that 'UnderVolt' inside a long name can still meet
    'undervoltage', but counted with less weight."""
    words: List[str] = []
    comps: List[str] = []
    for part in tok.split("_"):
        if not part:
            continue
        if _RE_HEX_0X.fullmatch(part):
            words.append(_norm_hex(part[2:]))
            continue
        pieces = _RE_CAMEL.findall(part)
        if len(pieces) == 2:
            words.append(part.lower())
        elif len(pieces) > 2:
            comps.append(part.lower())
            for a, b in zip(pieces, pieces[1:]):
                if len(a) > 1 and len(b) > 1 and a.isalpha() and b.isalpha():
                    comps.append((a + b).lower())
        for p in pieces:
            words.append(p.lower())
    return tuple(words), tuple(comps)


def is_complex_identifier(tok: str) -> bool:
    """True for names that are worth matching literally (signals, functions, macros)."""
    if len(tok) < 4:
        return False
    core = tok.strip("_")
    return ("_" in core) or any(c.isdigit() for c in core) or bool(_RE_INNER_CAMEL.search(core))


def _undouble(w: str) -> str:
    if len(w) > 3 and w[-1] == w[-2] and w[-1] not in "lsz" and w[-1] not in _VOWELS:
        return w[:-1]
    return w


@lru_cache(maxsize=200000)
def stem(w: str) -> str:
    """Light, conservative stemmer (plural / -ing / -ed / -ion / final e)."""
    n = len(w)
    if n <= 3 or not w.isalpha():
        return w
    if w.endswith("ies") and n > 4:
        w = w[:-3] + "y"
    elif w.endswith("sses"):
        w = w[:-2]
    elif w.endswith(("ches", "shes", "xes", "zes")):
        w = w[:-2]
    elif w.endswith("s") and not w.endswith(("ss", "us", "is")):
        w = w[:-1]
    n = len(w)
    if w.endswith("ied") and n > 4:
        w = w[:-3] + "y"
    elif w.endswith("ing") and n > 5:
        base = w[:-3]
        if any(c in _VOWELS for c in base):
            w = _undouble(base)
    elif w.endswith("ed") and n > 4 and not w.endswith("eed"):
        base = w[:-2]
        if any(c in _VOWELS for c in base):
            w = _undouble(base)
    elif w.endswith("ion") and n > 5:
        w = w[:-3]
    if len(w) >= 4 and w.endswith("e"):
        w = w[:-1]
    if len(w) > 5 and w.endswith("at"):
        w = w[:-2]
    return w


def iter_tokens(text: str) -> Iterable[Tuple[str, str, str]]:
    """Yield (kind, token, surface).
    kind 'w' = stemmed word / identifier part,  'c' = compound of identifier parts,
    kind 'r' = raw identifier or number (matched literally: signal names, function
    names, DIDs, DTCs, thresholds)."""
    for m in _RE_TOKEN.finditer(text):
        s = m.group(0)
        c = s[0]
        if c == "$":
            yield "r", _norm_hex(s[1:]), s
            continue
        if c.isdigit():
            if len(s) > 2 and s[1] in "xX":
                yield "r", _norm_hex(s[2:]), s
            elif s[-1] in "hH":
                yield "r", _norm_hex(s[:-1]), s
            elif len(s) >= 3:
                yield "r", s, s
            continue
        if s[-1] in "hH" and _RE_HEX_H.fullmatch(s):
            yield "r", _norm_hex(s[:-1]), s
            continue
        if is_complex_identifier(s):
            yield "r", s.lower(), s
            for part in s.split("_"):                 # Dcm_Rdbi_F190_Vin -> also the DID 0xf190
                if _RE_HEX_WORD.fullmatch(part):
                    yield "r", _norm_hex(part), part
        elif _RE_HEX_WORD.fullmatch(s):
            yield "r", _norm_hex(s), s
        words, comps = split_identifier(s)
        for p in comps:
            yield "c", stem(p), p
        for p in words:
            if p.startswith("0x"):
                yield "r", p, p
            elif len(p) < 2 or p.isdigit() or p in STOPWORDS:
                continue
            else:
                yield "w", stem(p), p
    for m in _RE_BYTE_PAIR.finditer(text):            # diagnostic bytes "22 F1 90" -> 0x22f1, 0xf190
        a, b = m.group(1), m.group(2)
        if not (a.isdigit() and b.isdigit()):
            yield "r", _norm_hex(a + b), a + " " + b


def word_stems(text: str) -> List[str]:
    return [t for k, t, _ in iter_tokens(text) if k != "r"]


