def analyze_changes(engine: Engine, changes: Sequence[Change], threshold: Optional[float] = None,
                    progress: ProgressFn = None, skip_comment_only: bool = True) -> List[ChangeResult]:
    """Find the test cases for every change.  Comment-only changes cannot alter the
    behaviour of the software, so by default they get no test cases."""
    out: List[ChangeResult] = []
    total = max(1, len(changes))
    for n, ch in enumerate(changes):
        if n % 5 == 0:
            _progress(progress, "Finding test cases: change %d / %d" % (n + 1, total), n / total)
        q = engine.query_for_change(ch)
        if skip_comment_only and ch.note.startswith("comment-only"):
            q.context.append("Comment-only change: no test case needed "
                             "(untick 'Ignore changes in: comments' to analyse it anyway).")
            out.append(ChangeResult(ch, q, []))
            continue
        ms = engine.match(q, threshold, explain=False)
        for m in ms:
            m.status = classify_match(m)
        ms.sort(key=Match.sort_key)
        out.append(ChangeResult(ch, q, ms))
    _progress(progress, "Analysis finished.", 1.0)
    return out


def summarize_results(results: Sequence[ChangeResult]) -> List[Dict[str, Any]]:
    """One entry per test case over all changes: confirmed first, then strongest first.
    'best' is the strongest match (confirmed beats not confirmed), 'status' / 'llm' are its values."""
    agg: Dict[int, Dict[str, Any]] = {}
    for res in results:
        for m in res.matches:
            a = agg.get(m.tc.idx)
            if a is None:
                a = agg[m.tc.idx] = {"tc": m.tc, "conf": 0.0, "changes": [], "best": None, "best_change": None}
            a["changes"].append((res.change, m.conf))
            if m.conf > a["conf"]:
                a["conf"] = m.conf
            if a["best"] is None or m.sort_key() < a["best"].sort_key():
                a["best"], a["best_change"] = m, res.change
    for a in agg.values():
        a["status"] = a["best"].status
        a["llm"] = a["best"].llm
    out = sorted(agg.values(), key=lambda a: (STATUS_RANK.get(a["status"], 2),
                                              -(a["llm"] if a["llm"] is not None else a["conf"]),
                                              -a["conf"], -len(a["changes"]), a["tc"].idx))
    return out


def level_of(conf: float) -> str:
    return "High" if conf >= LEVEL_HIGH else "Medium" if conf >= LEVEL_MED else "Possible"


def write_results_excel(path: str, results: Sequence[ChangeResult], cs: Optional[ChangeSet],
                        engine: Engine, threshold: float) -> None:
    openpyxl = require_openpyxl()
    from openpyxl.styles import Alignment, PatternFill
    wb = openpyxl.Workbook()
    wrap = Alignment(wrap_text=True, vertical="top")
    fills = {"High": PatternFill("solid", fgColor="C6EFCE"), "Medium": PatternFill("solid", fgColor="FFEB9C"),
             "Possible": PatternFill("solid", fgColor="F2F2F2")}
    ws = wb.active
    ws.title = "Test Cases To Run"
    wc = wb.create_sheet("By Change")
    summary = summarize_results(results)
    want_best = {(a["best_change"].cid, a["tc"].idx) for a in summary}
    best_why: Dict[Tuple[str, int], str] = {}

    wc.append(["Change ID", "File", "File Type", "Status", "Function", "New Lines", "Old Lines",
               "Test Case", "Confidence %", "Level", "Why", "Decision", "LLM %", "LLM Reason"])
    for res in results:
        ch = res.change
        if not res.matches:
            wc.append([ch.cid, ch.file, ch.kind, ch.status, ", ".join(ch.functions), ch.new_lines, ch.old_lines,
                       "(no related test case found)", "", "", xl_text(ch.note)])
            continue
        fresh = [m for m in res.matches if m.reasons is None]
        engine.explain_matches(res.query, res.matches)
        for m in res.matches:
            why = xl_text("\n".join("- " + r for r in (m.reasons or [])))
            if (ch.cid, m.tc.idx) in want_best:
                best_why[(ch.cid, m.tc.idx)] = why
            wc.append([ch.cid, ch.file, ch.kind, ch.status, ", ".join(ch.functions), ch.new_lines, ch.old_lines,
                       m.tc.tc_id, round(m.conf * 100, 1), m.level, why, STATUS_LABEL.get(m.status, ""),
                       round(m.llm * 100, 1) if m.llm is not None else "", xl_text(m.llm_why)])
            wc.cell(row=wc.max_row, column=10).fill = fills[m.level]
        for m in fresh:                       # give the memory back
            m.reasons, m.fv = None, None
    _style_header(wc, 14)
    _set_widths(wc, [10, 44, 9, 10, 28, 10, 10, 18, 13, 10, 90, 18, 8, 60])
    if wc.max_row > 1:
        wc.auto_filter.ref = wc.dimensions

    ws.append(["Test Case", "Excel Row", "Confidence %", "Level", "Changes Hit", "Changed Files / Functions",
               "Why (strongest change)", "Test Case Text", "Decision", "LLM %", "LLM Reason"])
    for a in summary:
        tc = a["tc"]
        chs = sorted(a["changes"], key=lambda x: -x[1])
        where = "\n".join("%s  %s  (%d%%)" % (c.cid, c.label(), round(cf * 100)) for c, cf in chs[:12])
        if len(chs) > 12:
            where += "\n... +%d more" % (len(chs) - 12)
        lv = level_of(a["conf"])
        best = a["best"]
        ws.append([tc.tc_id, tc.row, round(a["conf"] * 100, 1), lv, len(chs), xl_text(where),
                   best_why.get((a["best_change"].cid, tc.idx), ""), xl_text(tc.text, 6000),
                   STATUS_LABEL.get(a["status"], ""), round(a["llm"] * 100, 1) if a["llm"] is not None else "",
                   xl_text(best.llm_why)])
        r = ws.max_row
        ws.cell(row=r, column=4).fill = fills[lv]
        for c in (6, 7, 8):
            ws.cell(row=r, column=c).alignment = wrap
    _style_header(ws, 11)
    _set_widths(ws, [18, 10, 13, 10, 12, 60, 80, 80, 18, 8, 60])
    if summary:
        ws.auto_filter.ref = ws.dimensions

    if cs is not None:
        wch = wb.create_sheet("Changes")
        _fill_changes_sheet(wch, cs.changes)

