def _csr_dot(np: Any, indptr: Any, idx: Any, val: Any, M: Any, max_nnz: int = 150000) -> Any:
    """(sparse rows given as CSR arrays) @ M, in blocks of at most max_nnz entries (small memory)."""
    n = len(indptr) - 1
    out = np.zeros((n, M.shape[1]), np.float32)
    r0 = 0
    while r0 < n:
        r1 = int(np.searchsorted(indptr, indptr[r0] + max_nnz, side="right")) - 1
        r1 = min(n, max(r0 + 1, r1))
        a, b = int(indptr[r0]), int(indptr[r1])
        if b > a:
            prod = val[a:b, None] * M[idx[a:b]]
            starts = indptr[r0:r1] - a
            nonempty = indptr[r0 + 1:r1 + 1] > indptr[r0:r1]
            block = out[r0:r1]
            block[nonempty] = np.add.reduceat(prod, starts[nonempty], axis=0)
        r0 = r1
    return out


class SemanticIndex:
    """LSA: a truncated SVD of the test-case term matrix.  Words that occur in the same kind
    of test cases get similar vectors; a change is projected into the same space."""
    VERSION = 2

    def __init__(self, terms: List[str], V: Any, doc_vecs: Any, s: Any = None):
        self.terms = terms
        self.col = {t: i for i, t in enumerate(terms)}
        self.V = V
        self.s = s
        self.doc_vecs = doc_vecs
        self.dim = int(V.shape[1])

    @classmethod
    def for_index(cls, index: TCIndex, cache_dir: Optional[Path] = None,
                  progress: ProgressFn = None) -> Optional["SemanticIndex"]:
        """Built once per test-case file (kept with the index and cached on disk)."""
        hit = getattr(index, "_semantic", False)
        if hit is not False:
            return hit
        sem = None
        try:
            sem = cls.build(index, cache_dir, progress)
        except Exception:
            sem = None
        index._semantic = sem                         # type: ignore[attr-defined]
        return sem

    @classmethod
    def build(cls, index: TCIndex, cache_dir: Optional[Path] = None,
              progress: ProgressFn = None) -> Optional["SemanticIndex"]:
        np = _np()
        n = index.n_docs
        if np is None or n < 20:
            return None
        sig = sha1_short("%d|%d|%s" % (cls.VERSION, SEM_DIM, "|".join(tc.fp for tc in index.store.cases)), 16)
        path = Path(cache_dir) / ("semantic_%s.npz" % sig) if cache_dir is not None else None
        if path is not None and path.is_file():
            try:
                with np.load(path, allow_pickle=False) as z:
                    terms = [str(t) for t in z["terms"]]
                    return cls(terms, z["V"].astype(np.float32), z["docs"].astype(np.float32),
                               z["s"].astype(np.float32))
            except Exception:
                pass
        _progress(progress, "Learning semantic vectors from the test cases ...")
        df = {t: len(p) for t, p in index.post.items()}
        hi = max(2, int(0.5 * n))
        terms = sorted((t for t, c in df.items() if 2 <= c <= hi and len(t) >= 2 and not t.isdigit()),
                       key=lambda t: (-df[t], t))[:12000]
        if len(terms) < 10:
            return None
        terms.sort()
        col = {t: i for i, t in enumerate(terms)}
        indptr = [0]
        idx: List[int] = []
        val: List[float] = []
        for d in range(n):
            items = sorted((col[t], math.log1p(e[0]) * index.idf[t])
                           for t, e in index.doc_terms[d].items() if t in col and e[0] > 0)
            nrm = math.sqrt(sum(v * v for _, v in items)) or 1.0
            idx += [c for c, _ in items]
            val += [v / nrm for _, v in items]
            indptr.append(len(idx))
        ip = np.asarray(indptr, np.int64)
        ix = np.asarray(idx, np.int64)
        vx = np.asarray(val, np.float32)
        order = np.argsort(ix, kind="stable")             # the transposed matrix (terms as rows)
        rows_of = np.repeat(np.arange(n, dtype=np.int64), np.diff(ip))
        ipt = np.zeros(len(terms) + 1, np.int64)
        ipt[1:] = np.cumsum(np.bincount(ix, minlength=len(terms)))
        ixt, vxt = rows_of[order], vx[order]
        k = max(2, min(SEM_DIM, n // 4, len(terms) // 4))     # far fewer dimensions than words: that groups them
        p = min(k + 12, len(terms), n)
        rng = np.random.default_rng(0)
        Y = _csr_dot(np, ip, ix, vx, rng.standard_normal((len(terms), p)).astype(np.float32))
        Q, _ = np.linalg.qr(Y)
        for _ in range(3):                                 # power iterations: a sharper subspace
            Zt, _ = np.linalg.qr(_csr_dot(np, ipt, ixt, vxt, Q.astype(np.float32)))
            Q, _ = np.linalg.qr(_csr_dot(np, ip, ix, vx, Zt.astype(np.float32)))
        Bt = _csr_dot(np, ipt, ixt, vxt, Q.astype(np.float32))      # (A^T Q) = B^T
        _u, sv, vt = np.linalg.svd(Bt.T, full_matrices=False)
        V = vt[:k].T.astype(np.float32)                    # terms x k
        sv = sv[:k].astype(np.float32)
        docs = _csr_dot(np, ip, ix, vx, V)
        docs /= np.maximum(np.linalg.norm(docs, axis=1, keepdims=True), 1e-9)
        docs = docs.astype(np.float32)
        if path is not None:
            try:
                tmp = path.with_name(path.stem + "_tmp.npz")
                np.savez(tmp, terms=np.asarray(terms), V=V, docs=docs, s=sv)
                os.replace(tmp, path)
                olds = sorted(path.parent.glob("semantic_*.npz"), key=lambda f: f.stat().st_mtime)
                for f in olds[:-3]:                           # keep the vectors of the last 3 test-case files
                    f.unlink()
            except OSError:
                pass
        return cls(terms, V, docs, sv)

    def query_vec(self, weights: Dict[str, float]) -> Any:
        np = _np()
        cols = [(self.col[t], w) for t, w in weights.items() if t in self.col and w > 0]
        if not cols:
            return None
        v = (np.asarray([w for _, w in cols], np.float32)[:, None] * self.V[[c for c, _ in cols]]).sum(axis=0)
        nrm = float(np.linalg.norm(v))
        return v / nrm if nrm > 1e-9 else None

    def sims(self, qv: Any) -> Any:
        return self.doc_vecs @ qv

    def neighbours(self, word: str, k: int = 8) -> List[Tuple[str, float]]:
        """Words used in the same kind of test cases (shown in the Model window)."""
        np = _np()
        i = self.col.get(word)
        if i is None:
            return []
        V = self.V * self.s if self.s is not None else self.V           # word vectors = V * singular values
        V = V / np.maximum(np.linalg.norm(V, axis=1, keepdims=True), 1e-9)
        s = V @ V[i]
        best = np.argsort(-s)[:k + 1]
        return [(self.terms[j], float(s[j])) for j in best if j != i][:k]


# ---- training rows ---------------------------------------------------------------------------
class RankRows:
    """Training rows of the smart ranker, one block per training session: the evidence of
    the candidates as the model saw it BEFORE it learned from that session, and the verdicts."""
    MAX_ROWS = 150000

    def __init__(self) -> None:
        self.blocks: List[Tuple[str, Any, Any, Any]] = []

    def __len__(self) -> int:
        return len(self.blocks)

    @property
    def n_rows(self) -> int:
        return sum(len(b[2]) for b in self.blocks)

    def add(self, sid: str, X: Any, y: Any, w: Any) -> None:
        np = _np()
        self.blocks.append((sid, np.asarray(X, np.float32), np.asarray(y, np.int8), np.asarray(w, np.float32)))
        total = self.n_rows
        while total > self.MAX_ROWS and len(self.blocks) > 1:
            total -= len(self.blocks[0][2])
            self.blocks.pop(0)

    def arrays(self, max_rows: Optional[int] = None) -> Tuple[Any, Any, Any, Any]:
        """(X, y, w, session number) of the most recent sessions (all, or up to max_rows rows)."""
        np = _np()
        blocks = self.blocks
        if max_rows is not None:
            n, start = 0, len(blocks)
            while start > 0 and n + len(blocks[start - 1][2]) <= max_rows:
                start -= 1
                n += len(blocks[start][2])
            blocks = blocks[min(start, len(blocks) - 1):]
        X = np.concatenate([b[1] for b in blocks]).astype(float)
        y = np.concatenate([b[2] for b in blocks]).astype(float)
        w = np.concatenate([b[3] for b in blocks]).astype(float)
        g = np.concatenate([np.full(len(b[2]), i, np.int64) for i, b in enumerate(blocks)])
        return X, y, w, g

    def save(self, path: Path) -> None:
        np = _np()
        if np is None:
            return
        path = Path(path)
        if not self.blocks:
            if path.is_file():
                path.unlink()
            return
        X, y, w, g = self.arrays()
        tmp = path.with_name(path.stem + "_tmp.npz")
        np.savez(tmp, X=X.astype(np.float32), y=y.astype(np.int8), w=w.astype(np.float32),
                            g=g.astype(np.int32), sids=np.asarray([b[0] for b in self.blocks]),
                            feats=np.asarray(RANK_FEATS), version=np.asarray([RANKER_VERSION]))
        os.replace(tmp, path)

    @classmethod
    def load(cls, path: Path) -> "RankRows":
        out = cls()
        np = _np()
        if np is None or not Path(path).is_file():
            return out
        try:
            with np.load(path, allow_pickle=False) as z:
                if [str(f) for f in z["feats"]] != list(RANK_FEATS) or int(z["version"][0]) != RANKER_VERSION:
                    return out                         # rows of another tool version: rebuilt by re-training
                X, y, w, g, sids = z["X"], z["y"], z["w"], z["g"], [str(s) for s in z["sids"]]
            cuts = np.flatnonzero(np.diff(g)) + 1
            for sid, part in zip(sids, np.split(np.arange(len(g)), cuts)):
                out.blocks.append((sid, X[part], y[part], w[part]))
        except Exception:
            return cls()
        return out


# ---- re-rankers -------------------------------------------------------------------------------
def _group_holdout(np: Any, groups: Any, frac: float, seed: int) -> Optional[Any]:
    """Mask of the rows of about frac of the sessions (for early stopping)."""
    if groups is None:
        return None
    uniq = np.unique(groups)
    if len(uniq) < 8:
        return None
    rng = np.random.default_rng(seed)
    pick = rng.choice(uniq, size=max(1, int(round(frac * len(uniq)))), replace=False)
    return np.isin(groups, pick)


def _logloss(np: Any, p: Any, y: Any, w: Any) -> float:
    p = np.clip(p, 1e-6, 1 - 1e-6)
    return float(-(w * (y * np.log(p) + (1 - y) * np.log(1 - p))).sum() / max(1e-9, float(w.sum())))


def _f(x: Any) -> List[Any]:
    return [float(v) for v in x]                        # full precision: identical answers after loading


class _LR:
    """Logistic regression on standardised inputs, L2-regularised, solved by Newton steps."""
    kind = "lr"

    def __init__(self, lam: float = 1.0):
        self.lam = lam
        self.mu = self.sd = self.beta = None

    def fit(self, X: Any, y: Any, w: Any, groups: Any = None) -> "_LR":
        np = _np()
        self.mu, self.sd = X.mean(axis=0), X.std(axis=0) + 1e-6
        Z = np.hstack([(X - self.mu) / self.sd, np.ones((len(X), 1))])
        beta = np.zeros(Z.shape[1])
        reg = np.full(Z.shape[1], self.lam)
        reg[-1] = 0.0
        for _ in range(50):
            p = _sigmoid(np, Z @ beta)
            g = Z.T @ (w * (p - y)) + reg * beta
            H = (Z * (w * p * (1 - p))[:, None]).T @ Z + np.diag(reg + 1e-6)
            step = np.linalg.solve(H, g)
            beta -= step
            if float(np.abs(step).max()) < 1e-7:
                break
        self.beta = beta
        return self

    def predict(self, X: Any) -> Any:
        np = _np()
        return _sigmoid(np, ((X - self.mu) / self.sd) @ self.beta[:-1] + self.beta[-1])

    def importance(self) -> Any:
        np = _np()
        return np.abs(self.beta[:-1])

    def to_dict(self) -> Dict[str, Any]:
        return {"kind": self.kind, "lam": self.lam, "mu": _f(self.mu), "sd": _f(self.sd), "beta": _f(self.beta)}

    @classmethod
    def from_dict(cls, d: Dict[str, Any]) -> "_LR":
        np = _np()
        m = cls(d.get("lam", 1.0))
        m.mu, m.sd, m.beta = np.asarray(d["mu"]), np.asarray(d["sd"]), np.asarray(d["beta"])
        return m


class _GBDT:
    """Gradient-boosted decision trees: logistic loss, histogram splits, shrinkage, row
    sub-sampling, early stopping on held-out sessions, then a refit on all rows."""
    kind = "gbdt"

    def __init__(self, n_trees: int = 300, depth: int = 3, lr: float = 0.08, lam: float = 1.0,
                 min_hess: float = 1.0, subsample: float = 0.8, n_bins: int = 32, seed: int = 0):
        self.n_trees, self.depth, self.lr, self.lam = n_trees, depth, lr, lam
        self.min_hess, self.subsample, self.n_bins, self.seed = min_hess, subsample, n_bins, seed
        self.edges: List[Any] = []
        self.trees: List[List[Any]] = []
        self.f0 = 0.0

    def _bin(self, X: Any) -> Any:
        np = _np()
        B = np.empty(X.shape, np.int32)
        for f in range(X.shape[1]):
            B[:, f] = np.searchsorted(self.edges[f], X[:, f], side="right")
        return B

    def _build(self, B: Any, g: Any, h: Any, rows: Any) -> List[Any]:
        np = _np()
        nb = self.n_bins + 1
        feat, thr, left, right, value = [-1], [0], [-1], [-1], [0.0]
        frontier = [(0, rows)]
        for _depth in range(self.depth):
            nxt = []
            for node, r in frontier:
                G, H = float(g[r].sum()), float(h[r].sum())
                value[node] = -G / (H + self.lam)
                if len(r) < 4 or H < 2 * self.min_hess:
                    continue
                parent = G * G / (H + self.lam)
                nf = B.shape[1]
                flat = (B[r] + self._offsets).ravel()          # all features in one histogram pass
                gh = np.bincount(flat, weights=np.repeat(g[r], nf), minlength=nf * nb).reshape(nf, nb)
                hh = np.bincount(flat, weights=np.repeat(h[r], nf), minlength=nf * nb).reshape(nf, nb)
                GL, HL = np.cumsum(gh, axis=1)[:, :-1], np.cumsum(hh, axis=1)[:, :-1]
                GR, HR = G - GL, H - HL
                gain = GL * GL / (HL + self.lam) + GR * GR / (HR + self.lam) - parent
                gain[(HL < self.min_hess) | (HR < self.min_hess)] = -1.0
                fb = int(np.argmax(gain))
                best = (float(gain.flat[fb]), fb // (nb - 1), fb % (nb - 1))
                if best[0] <= 1e-9:
                    continue
                Br = B[r]
                go_left = Br[:, best[1]] <= best[2]
                feat[node], thr[node] = best[1], best[2]
                for side, rr in ((left, r[go_left]), (right, r[~go_left])):
                    feat.append(-1)
                    thr.append(0)
                    left.append(-1)
                    right.append(-1)
                    value.append(0.0)
                    side[node] = len(feat) - 1
                    nxt.append((len(feat) - 1, rr))
            frontier = nxt
        for node, r in frontier:
            value[node] = -float(g[r].sum()) / (float(h[r].sum()) + self.lam)
        return [feat, thr, left, right, value]

    def _tree_out(self, tree: List[Any], B: Any) -> Any:
        np = _np()
        feat, thr, left, right, value = (np.asarray(a) for a in tree) if isinstance(tree[0], list) else tree
        node = np.zeros(len(B), np.int64)
        rows = np.arange(len(B))
        for _ in range(self.depth + 1):
            f = feat[node]
            inner = f >= 0
            if not inner.any():
                break
            go_left = B[rows, np.maximum(f, 0)] <= thr[node]
            node = np.where(inner, np.where(go_left, left[node], right[node]), node)
        return value[node]

    def _boost(self, B: Any, y: Any, w: Any, n_trees: int, B_val: Any = None, y_val: Any = None,
               w_val: Any = None) -> Tuple[List[List[Any]], int]:
        np = _np()
        self._offsets = (np.arange(B.shape[1]) * (self.n_bins + 1)).astype(np.int64)
        rng = np.random.default_rng(self.seed)
        F = np.full(len(B), self.f0)
        Fv = np.full(len(B_val), self.f0) if B_val is not None else None
        trees: List[List[Any]] = []
        best_loss, best_n = float("inf"), 0
        for t in range(n_trees):
            p = _sigmoid(np, F)
            g = (p - y) * w
            h = np.maximum(p * (1 - p) * w, 1e-9)
            rows = np.flatnonzero(rng.random(len(B)) < self.subsample)
            if len(rows) < 4:
                rows = np.arange(len(B))
            tree = self._build(B, g, h, rows)
            trees.append(tree)
            F += self.lr * self._tree_out(tree, B)
            if Fv is not None:
                Fv += self.lr * self._tree_out(tree, B_val)
                loss = _logloss(np, _sigmoid(np, Fv), y_val, w_val)
                if loss < best_loss - 1e-6:
                    best_loss, best_n = loss, t + 1
                elif t + 1 - best_n >= 30:
                    break
        return trees, (best_n or len(trees))

    def fit(self, X: Any, y: Any, w: Any, groups: Any = None) -> "_GBDT":
        np = _np()
        qs = np.linspace(0, 1, self.n_bins + 1)[1:-1]
        self.edges = [np.unique(np.quantile(X[:, f], qs)) for f in range(X.shape[1])]
        B = self._bin(X)
        pbar = float(np.clip((w * y).sum() / max(1e-9, float(w.sum())), 1e-3, 1 - 1e-3))
        self.f0 = math.log(pbar / (1 - pbar))
        hold = _group_holdout(np, groups, 0.2, self.seed)
        n_best = self.n_trees
        if hold is not None and y[hold].min() != y[hold].max() and y[~hold].min() != y[~hold].max():
            _t, n_best = self._boost(B[~hold], y[~hold], w[~hold], self.n_trees, B[hold], y[hold], w[hold])
        self.trees, _n = self._boost(B, y, w, max(10, n_best))
        return self

    def predict(self, X: Any) -> Any:
        np = _np()
        B = self._bin(X)
        F = np.full(len(X), self.f0)
        arrs = getattr(self, "_arrs", None)
        if arrs is None or len(arrs) != len(self.trees):
            arrs = self._arrs = [tuple(np.asarray(a) for a in t) for t in self.trees]
        for tree in arrs:
            F += self.lr * self._tree_out(tree, B)
        return _sigmoid(np, F)

    def importance(self) -> Any:
        np = _np()
        imp = np.zeros(len(self.edges))
        for feat, _thr, _l, _r, _v in self.trees:
            for f in feat:
                if f >= 0:
                    imp[f] += 1.0
        return imp

    def to_dict(self) -> Dict[str, Any]:
        return {"kind": self.kind, "depth": self.depth, "lr": self.lr, "f0": self.f0,
                "edges": [_f(e) for e in self.edges],
                "trees": [[t[0], t[1], t[2], t[3], _f(t[4])] for t in self.trees]}

    @classmethod
    def from_dict(cls, d: Dict[str, Any]) -> "_GBDT":
        np = _np()
        m = cls(depth=d["depth"], lr=d["lr"])
        m.f0 = d["f0"]
        m.edges = [np.asarray(e, float) for e in d["edges"]]
        m.trees = d["trees"]
        return m


class _MLP:
    """Neural network: inputs -> 32 -> 16 -> 1 (ReLU, sigmoid output), Adam, L2 penalty.
    Three networks with different random starts, each early-stopped on a different
    20 % of the sessions; their predictions are averaged."""
    kind = "mlp"

    def __init__(self, hidden: Tuple[int, ...] = (32, 16), lr: float = 0.003, l2: float = 1e-4,
                 epochs: int = 80, batch: int = 256, patience: int = 10, seeds: Tuple[int, ...] = (0, 1, 2)):
        self.hidden, self.lr, self.l2, self.epochs, self.batch = hidden, lr, l2, epochs, batch
        self.patience, self.seeds = patience, seeds
        self.mu = self.sd = None
        self.nets: List[List[Any]] = []

    @staticmethod
    def _forward(np: Any, params: List[Any], X: Any) -> Tuple[Any, List[Any]]:
        acts = [X]
        h = X
        n_layers = len(params) // 2
        for i in range(n_layers):
            h = h @ params[2 * i] + params[2 * i + 1]
            if i < n_layers - 1:
                h = np.maximum(h, 0.0)
            acts.append(h)
        return h[:, 0], acts

    def _train(self, X: Any, y: Any, w: Any, seed: int, Xv: Any = None, yv: Any = None,
               wv: Any = None) -> List[Any]:
        np = _np()
        rng = np.random.default_rng(seed)
        sizes = [X.shape[1]] + list(self.hidden) + [1]
        params: List[Any] = []
        for i in range(len(sizes) - 1):
            params.append(rng.normal(0.0, math.sqrt(2.0 / sizes[i]), (sizes[i], sizes[i + 1])))
            params.append(np.zeros(sizes[i + 1]))
        m1 = [np.zeros_like(p) for p in params]
        m2 = [np.zeros_like(p) for p in params]
        step = 0
        best_loss, best_ep, best_params = float("inf"), 0, [p.copy() for p in params]
        n = len(X)
        epochs = self.epochs if Xv is not None else max(10, self.epochs // 2)
        for ep in range(epochs):
            perm = rng.permutation(n)
            for s in range(0, n, self.batch):
                b = perm[s:s + self.batch]
                out, acts = self._forward(np, params, X[b])
                p = _sigmoid(np, out)
                wb = w[b]
                delta = ((p - y[b]) * wb / max(1e-9, float(wb.sum())))[:, None]
                grads: List[Any] = [None] * len(params)
                n_layers = len(params) // 2
                for i in range(n_layers - 1, -1, -1):
                    grads[2 * i] = acts[i].T @ delta + self.l2 * params[2 * i]
                    grads[2 * i + 1] = delta.sum(axis=0)
                    if i > 0:
                        delta = (delta @ params[2 * i].T) * (acts[i] > 0)
                step += 1
                c1, c2 = 1 - 0.9 ** step, 1 - 0.999 ** step
                for j, gr in enumerate(grads):
                    m1[j] = 0.9 * m1[j] + 0.1 * gr
                    m2[j] = 0.999 * m2[j] + 0.001 * gr * gr
                    params[j] -= self.lr * (m1[j] / c1) / (np.sqrt(m2[j] / c2) + 1e-8)
            if Xv is not None:
                loss = _logloss(np, _sigmoid(np, self._forward(np, params, Xv)[0]), yv, wv)
                if loss < best_loss - 1e-6:
                    best_loss, best_ep, best_params = loss, ep + 1, [p.copy() for p in params]
                elif ep + 1 - best_ep >= self.patience:
                    break
        return best_params if Xv is not None else params

    def fit(self, X: Any, y: Any, w: Any, groups: Any = None) -> "_MLP":
        np = _np()
        self.mu, self.sd = X.mean(axis=0), X.std(axis=0) + 1e-6
        Xs = (X - self.mu) / self.sd
        self.nets = []
        for seed in self.seeds:
            hold = _group_holdout(np, groups, 0.2, 100 + seed)
            if hold is not None and y[hold].min() != y[hold].max() and y[~hold].min() != y[~hold].max():
                self.nets.append(self._train(Xs[~hold], y[~hold], w[~hold], seed, Xs[hold], y[hold], w[hold]))
            else:
                self.nets.append(self._train(Xs, y, w, seed))
        return self

    def predict(self, X: Any) -> Any:
        np = _np()
        Xs = (X - self.mu) / self.sd
        return np.mean([_sigmoid(np, self._forward(np, p, Xs)[0]) for p in self.nets], axis=0)

    def importance(self) -> Any:
        np = _np()
        return np.mean([np.abs(p[0]).sum(axis=1) for p in self.nets], axis=0)

    def to_dict(self) -> Dict[str, Any]:
        return {"kind": self.kind, "hidden": list(self.hidden), "mu": _f(self.mu), "sd": _f(self.sd),
                "nets": [[[_f(row) for row in p] if p.ndim == 2 else _f(p) for p in net] for net in self.nets]}

    @classmethod
    def from_dict(cls, d: Dict[str, Any]) -> "_MLP":
        np = _np()
        m = cls(hidden=tuple(d["hidden"]))
        m.mu, m.sd = np.asarray(d["mu"]), np.asarray(d["sd"])
        m.nets = [[np.asarray(p, float) for p in net] for net in d["nets"]]
        return m


class _Ensemble:
    """Average of logistic regression, boosted trees and the neural network."""
    kind = "ensemble"

    def __init__(self, parts: Optional[List[Any]] = None):
        self.parts = parts if parts is not None else [_LR(), _GBDT(), _MLP()]

    def fit(self, X: Any, y: Any, w: Any, groups: Any = None) -> "_Ensemble":
        for p in self.parts:
            p.fit(X, y, w, groups)
        return self

    def predict(self, X: Any) -> Any:
        np = _np()
        return np.mean([p.predict(X) for p in self.parts], axis=0)

    def importance(self) -> Any:
        np = _np()
        shares = []
        for p in self.parts:
            imp = p.importance()
            shares.append(imp / max(1e-9, float(imp.sum())))
        return np.mean(shares, axis=0)

    def to_dict(self) -> Dict[str, Any]:
        return {"kind": self.kind, "parts": [p.to_dict() for p in self.parts]}

    @classmethod
    def from_dict(cls, d: Dict[str, Any]) -> "_Ensemble":
        return cls([ranker_from_dict(p) for p in d["parts"]])


_RANKER_CLASSES = {"lr": _LR, "gbdt": _GBDT, "mlp": _MLP, "ensemble": _Ensemble}


def make_ranker(kind: str) -> Any:
    return _RANKER_CLASSES[kind]()


def ranker_from_dict(d: Dict[str, Any]) -> Any:
    return _RANKER_CLASSES[d["kind"]].from_dict(d)


def load_ranker(info: Dict[str, Any]) -> Any:
    """The saved re-ranker, or None (none trained, numpy missing, or saved by another version)."""
    if not info or _np() is None or info.get("kind") not in RANKER_KINDS or not info.get("model"):
        return None
    if info.get("version") != RANKER_VERSION or list(info.get("feats") or []) != list(RANK_FEATS):
        return None
    try:
        return ranker_from_dict(info["model"])
    except Exception:
        return None


def ranker_importance(obj: Any, top: int = 8) -> List[List[Any]]:
    """What the re-ranker relies on most: [[input, share 0..1], ...]."""
    if obj is None:
        return []
    try:
        imp = obj.importance()
    except Exception:
        return []
    tot = float(imp.sum()) or 1.0
    order = sorted(range(len(imp)), key=lambda i: -float(imp[i]))[:top]
    return [[RANK_FEATS[i], round(float(imp[i]) / tot, 3)] for i in order if float(imp[i]) > 0]


# ---- choosing the best model ------------------------------------------------------------------
def _average_precision(np: Any, scores: Any, y: Any) -> Optional[float]:
    if y.min() == y.max():
        return None
    order = np.argsort(-scores, kind="stable")
    hits = y[order]
    prec = np.cumsum(hits) / np.arange(1, len(hits) + 1)
    return float((prec * hits).sum() / hits.sum())


def _auc(np: Any, scores: Any, y: Any) -> Optional[float]:
    pos, neg = scores[y == 1], scores[y == 0]
    if not len(pos) or not len(neg):
        return None
    allv = np.concatenate([pos, neg])
    order = np.argsort(allv, kind="stable")
    ranks = np.empty(len(order))
    ranks[order] = np.arange(1, len(order) + 1)
    # average ranks of ties
    sv = allv[order]
    i = 0
    while i < len(sv):
        j = i
        while j + 1 < len(sv) and sv[j + 1] == sv[i]:
            j += 1
        if j > i:
            ranks[order[i:j + 1]] = (i + j + 2) / 2.0
        i = j + 1
    return float((ranks[:len(pos)].sum() - len(pos) * (len(pos) + 1) / 2) / (len(pos) * len(neg)))


def ranking_metrics(np: Any, scores: Any, y: Any, w: Any, groups: Any) -> Dict[str, Any]:
    """map: mean average precision per session; p10: precision of the 10 best per session."""
    aps, p10 = [], []
    for g in np.unique(groups):
        m = groups == g
        ap = _average_precision(np, scores[m], y[m])
        if ap is None:
            continue
        aps.append(ap)
        top = np.argsort(-scores[m], kind="stable")[:10]
        p10.append(float(y[m][top].mean()))
    return {"map": float(np.mean(aps)) if aps else None, "p10": float(np.mean(p10)) if p10 else None,
            "auc": _auc(np, scores, y), "logloss": _logloss(np, scores, y, w), "sessions": len(aps)}


def _logit(p: float) -> float:
    p = min(1.0 - 1e-6, max(1e-6, p))
    return math.log(p / (1.0 - p))


def recall_shift(np: Any, scores: Any, base: Any, pos: Any, thr: float = DEFAULT_THRESHOLD) -> float:
    """Logit shift for a re-ranker's scores: at the default minimum confidence (thr) the
    re-ranker lists RECALL_TARGET of the test cases you confirmed (measured on the cross-
    validation predictions, i.e. on sessions it did not learn from) - and at least as many
    as the built-in scorer.  Because it ranks better, it needs a much shorter list for that."""
    if pos.sum() < 5:
        return 0.0
    target = max(RECALL_TARGET, float((base[pos] >= thr).mean()))
    srt = np.sort(scores[pos])
    t = float(srt[int(math.floor(max(0.0, min(1.0, 1.0 - target)) * (len(srt) - 1)))])
    return max(-3.0, min(5.0, _logit(thr) - _logit(t)))


def compare_rankers(X: Any, y: Any, w: Any, groups: Any, k: int = 5, progress: ProgressFn = None,
                    cancel: Optional[threading.Event] = None) -> Dict[str, Dict[str, Any]]:
    """Cross-validation grouped by training session: every session is predicted by models
    trained without it.  'base' = the built-in scorer alone; 'ensemble' = the average of
    the three models of the same split.  'shift' = confidence shift (see recall_shift)."""
    np = _np()
    if len(y) > CV_MAX_ROWS:                            # most recent sessions only (speed)
        keep_from = len(y) - CV_MAX_ROWS
        first_g = groups[keep_from]
        sel = groups >= first_g
        X, y, w, groups = X[sel], y[sel], w[sel], groups[sel]
    uniq = np.unique(groups)
    perm = np.random.default_rng(0).permutation(uniq)
    k = max(2, min(k, len(uniq)))
    folds = [perm[i::k] for i in range(k)]
    parts = ("lr", "gbdt", "mlp")
    oof = {kind: np.full(len(y), np.nan) for kind in parts}
    timing = dict.fromkeys(parts, 0.0)
    step, steps = 0, k * len(parts)
    for fi, fold in enumerate(folds):
        te = np.isin(groups, fold)
        tr = ~te
        if not te.any() or y[tr].sum() < 2 or (1 - y[tr]).sum() < 2:
            continue
        for kind in parts:
            if cancel is not None and cancel.is_set():
                raise RankerCancelled()
            _progress(progress, "Comparing models: %s - part %d of %d" % (RANKER_LABEL[kind], fi + 1, k),
                      step / steps)
            step += 1
            t0 = time.time()
            oof[kind][te] = make_ranker(kind).fit(X[tr], y[tr], w[tr], groups[tr]).predict(X[te])
            timing[kind] += time.time() - t0
    oof["ensemble"] = np.mean([oof[p] for p in parts], axis=0)
    timing["ensemble"] = sum(timing.values())
    oof["base"] = _sigmoid(np, X[:, _COL_BASEZ])
    ok = ~np.isnan(oof["ensemble"])
    out: Dict[str, Dict[str, Any]] = {}
    if ok.sum() == 0:
        return out
    pos = (y[ok] == 1)
    for kind in ("base",) + RANKER_KINDS:
        m = ranking_metrics(np, oof[kind][ok], y[ok], w[ok], groups[ok])
        m["seconds"] = round(timing.get(kind, 0.0), 1)
        m["shift"] = 0.0 if kind == "base" else round(recall_shift(np, oof[kind][ok], oof["base"][ok], pos), 3)
        out[kind] = m
    return out


def select_ranker(metrics: Dict[str, Dict[str, Any]]) -> str:
    """The model with the best mean average precision in cross-validation - if it beats the
    built-in scorer.  The ensemble is preferred unless another model is clearly better
    (ENSEMBLE_TOLERANCE): averaging three different models is the most robust choice for
    changes in areas that the training did not cover (see the model benchmark)."""
    base = (metrics.get("base") or {}).get("map") or 0.0
    cands = [k for k in RANKER_KINDS if (metrics.get(k) or {}).get("map") is not None]
    if not cands:
        return "base"
    best = max(cands, key=lambda k: (round(metrics[k]["map"], 4), -metrics[k].get("logloss", 0.0)))
    ens = (metrics.get("ensemble") or {}).get("map")
    if ens is not None and ens >= metrics[best]["map"] - ENSEMBLE_TOLERANCE:
        best = "ensemble"
    return best if metrics[best]["map"] >= base + RANKER_MARGIN else "base"


RANKER_SHORT = {"base": "built-in scorer", "lr": "logistic regression", "gbdt": "boosted trees",
                "mlp": "neural network", "ensemble": "ensemble (all three)"}


def format_ranker_table(info: Dict[str, Any]) -> List[str]:
    """Text table of the last model comparison (Model window, command line)."""
    met = info.get("metrics") or {}
    if not met:
        return [info.get("reason") or "No model comparison yet."]
    chosen = info.get("kind", "base")
    mc, mb = (met.get(chosen) or {}).get("map"), (met.get("base") or {}).get("map")
    head = "In use: %s" % RANKER_SHORT.get(chosen, chosen)
    if chosen != "base" and mc is not None and mb is not None:
        head += " - MAP %.1f %% (built-in %.1f %%)" % (100 * mc, 100 * mb)
    lines = [head, "Cross-validation on your data (%d sessions, %d rows):" % (info.get("sessions", 0),
                                                                              info.get("rows", 0)),
             "  %-21s %6s %7s %6s" % ("model", "MAP", "top-10", "AUC")]
    for kind in ("base",) + RANKER_KINDS:
        m = met.get(kind)
        if not m:
            continue
        lines.append("  %-21s %5.1f%% %6.1f%% %6.3f%s" % (
            RANKER_SHORT[kind], 100 * (m.get("map") or 0), 100 * (m.get("p10") or 0), m.get("auc") or 0,
            "  <- in use" if kind == chosen else ""))
    lines.append("MAP = ranking quality (100 % = all right test cases first)")
    lines.append("top-10 = share of right test cases among the 10 best")
    lines.append("Chosen by %s on %s." % (info.get("selected_by", "cross-validation"), info.get("fitted", "")))
    imp = info.get("importance") or []
    if imp:
        lines.append("It relies most on: " + ", ".join("%s (%d%%)" % (RANK_FEAT_TEXT.get(n, n), round(100 * v))
                                                       for n, v in imp[:5]))
    return lines

