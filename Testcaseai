    def _llm_flow(self, app: Any, pump: Callable[..., None], cid: str) -> None:
        """LOCAL LLM window, Find with the LLM, Confirm / Reject, auto export, LLM in training."""
        c = _ctx()
        g = globals()
        orig_make = g["make_backend"]
        g["make_backend"] = lambda cfg, progress=None: _OracleBackend(c["demo"])

        def wait_for(cond: Callable[[], bool], what: str, timeout: float = 30.0) -> None:
            end = time.time() + timeout
            while not cond():
                app.root.update()
                time.sleep(0.02)
                self.assertLess(time.time(), end, "timed out waiting for " + what)

        try:
            app.nb.select(app.tab_llm)
            app.v_llm_backend.set("ollama")
            app._on_llm_backend()
            app.v_llm_ollama_model.set("oracle")
            app.v_llm_cands.set("60")
