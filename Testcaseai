class T10_LearningCurve(unittest.TestCase):
    def test_training_improves_answers(self):
        rep = run_benchmark(rounds=2, verbose=False)
        r0, r2 = rep["rounds"][0], rep["rounds"][-1]
        self.assertGreaterEqual(r0["recall"], 0.90)
        self.assertGreaterEqual(r2["recall"], 0.99)
