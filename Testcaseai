def llm_self_check(judge: LLMJudge, progress: ProgressFn = None) -> List[str]:
    """Load test: two sanity questions, one realistic pair of test cases, speed estimate."""
    b = judge.backend
    lines = ["Model: " + b.info()]
    if isinstance(b, LlamaCppBackend):
        lines.append("Loaded in %.1f s from %s" % (b.load_seconds, b.file))
    ok = True
    for qtext, want in (("Is 2 + 2 equal to 4?", True), ("Is 7 an even number?", False)):
        msgs = [{"role": "system", "content": "Answer the question with Yes or No."},
                {"role": "user", "content": qtext + " Answer Yes or No."}]
        _progress(progress, "LLM test: " + qtext)
        p = b.yes_prob(msgs)
        how = "probability"
        if p is None:
            v, _r = parse_answer(b.generate(msgs, 12))
            p = 0.9 if v else 0.1 if v is False else 0.5
            how = "text"
        good = (p >= 0.5) == want
        ok = ok and good
        lines.append("  Sanity check: %-24s -> Yes %3d %%  (%s)  %s" % (qtext, round(p * 100), how,
                                                                     "OK" if good else "WRONG"))
    change_text = llm_change_text(None, [_SELF_CHECK_CHANGE], [
        "PwrMgr_CheckUnderVolt() is called by: PwrMgr_MainFunction()"])
    tcs = []
    for n, (tid, text) in enumerate(_SELF_CHECK_TCS):
        title, pre, proc, exp = split_sections(text)
        tcs.append(TestCase(-1 - n, "selfcheck:" + tid, tid, 0, text, title, pre, proc, exp, sha1_short(text)))
    times = []
    verdicts = []
    for tc in tcs:
        _progress(progress, "LLM test: realistic test case %s" % tc.tc_id)
        t0 = time.time()
        verdicts.append(judge.judge(change_text, tc, use_cache=False))
        times.append(time.time() - t0)
    for tc, v, want in zip(tcs, verdicts, (True, False)):
        good = (v.p >= judge.cfg.confirm) == want
        ok = ok and good
        lines.append("  Realistic check %s (%s): LLM %3d %%  %s   %s" % (
            tc.tc_id, "relevant" if want else "not relevant", round(v.p * 100), "OK" if good else "WRONG",
            ("- " + v.reason) if v.reason else ""))
    per_tc = times[-1]
    lines.append("  Speed: first test case of a change %.1f s, each further test case about %.1f s" % (times[0], per_tc))
    est = times[0] + per_tc * (judge.cfg.candidates - 1) + (per_tc * 3 if judge.cfg.explain else 0)
    lines.append("  -> about %s per changed function with %d test cases checked (answers are remembered: "
                 "a second run of the same change is instant)" % (_fmt_secs(est), judge.cfg.candidates))
    if isinstance(b, LlamaCppBackend) and b.recurrent:
        lines.append("  Note: hybrid / recurrent model - the shared prompt part is restored from a saved state.")
    if not b.supports_prob:
        lines.append("  Note: this runtime gives no token probabilities - the LLM answers Yes / No only "
                     "(confidence 90 % / 10 %).")
    lines.append("RESULT: %s" % ("model works" if ok else "model answers were wrong - try a larger or newer model"))
    return lines


