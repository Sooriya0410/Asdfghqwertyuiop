def run_headless(args: argparse.Namespace, model_dir: Path) -> int:
    """Run without GUI:  compare (or load changes) -> find test cases -> write Excel."""
    last = [0.0]

    def progress(msg: str, frac: float) -> None:
        if time.time() - last[0] > 1.0 or frac >= 1.0:
            last[0] = time.time()
            print("  " + msg)

    pats = split_patterns(args.patterns or DEFAULT_USER_PATTERNS)
    excl = split_patterns(args.exclude or DEFAULT_EXCLUDE_DIRS)
    model = Model(model_dir)
    sbx = SandboxIndex.build(args.new, pats, excl, model.cache_dir, progress) if args.new else None
    if args.changes:
        cs = read_changes_excel(args.changes, sbx, pats)
    else:
        cs = compare_sandboxes(args.old, args.new, pats, excl, not args.keep_ws, progress,
                               new_table=sbx.table if sbx else None)
    print("Changes: %d files, %d changed blocks" % (len(cs.files), len(cs.changes)))
    if args.changes_out:
        write_changes_excel(args.changes_out, cs)
        print("Written: %s" % args.changes_out)
    if not args.testcases:
        return 0
    store = TestCaseStore.load(args.testcases, progress)
    for w in store.warnings:
        print("Note: " + w)
    eng = Engine(model, store, sandbox=sbx, progress=progress)
    thr = args.threshold if args.threshold else model.threshold
    judge: Optional[LLMJudge] = None
    info: Dict[str, Any] = {}
    try:
        if args.llm or args.gguf:
            cfg = _cli_llm_config(args, model)
            judge = LLMJudge(make_backend(cfg, progress), cfg, model.dir)
            print("Local LLM: %s" % judge.backend.info())
            results = analyze_changes_llm(eng, judge, cs.changes, thr, progress, not args.with_comments, None, info)
        else:
            results = analyze_changes(eng, cs.changes, thr, progress, not args.with_comments)
        out = args.out or "test_cases_to_run.xlsx"
        write_results_excel(out, results, cs, eng, thr)
        summary = summarize_results(results)
        if judge is not None:
            c = count_statuses(results)
            print("Confirmed test cases: %d (by you %d, by the LLM %d), not checked %d, rejected by the LLM %d  "
                  "(%d LLM answers, %d remembered)" % (c[STATUS_YOU] + c[STATUS_LLM], c[STATUS_YOU], c[STATUS_LLM],
                                                       c[STATUS_UNCHECKED], c[STATUS_REJECTED], info.get("calls", 0),
                                                       info.get("cached", 0)))
            if info.get("too_long"):
                print("Note: %d test case(s) not checked - prompt longer than the model context (raise n_ctx in the "
                      "GUI, LOCAL LLM window)." % info["too_long"])
        else:
            print("Test cases to run: %d of %d   (model: %d training sessions, ranking: %s)" % (
                len(summary), len(store), len(model.history), model.stats()["ranker"]))
        print("Written: %s" % out)
        if args.confirmed_out:
            run_info = [("Sandbox (new)", args.new or ""), ("Sandbox (old)", args.old or ""),
                        ("Test case file", args.testcases),
                        ("Local LLM", judge.backend.name if judge is not None else "not used")]
            written = write_confirmed_excel(args.confirmed_out, confirmed_snapshot(results), model, store, run_info)
            print("Confirmed test cases written: %s" % written)
    finally:
        if judge is not None:
            judge.close()
    return 0


def _cli_llm_config(args: argparse.Namespace, model: Model) -> LLMConfig:
    cfg = LLMConfig.from_dict(model.load_settings().get("llm"))
    if args.gguf:
        cfg.backend, cfg.gguf = "llamacpp", args.gguf
    if args.llm_candidates:
        cfg.candidates = max(1, args.llm_candidates)
    if not cfg.enabled():
        raise LLMError("No local LLM is set up: use --gguf FILE, or set it up in the GUI (LOCAL LLM window).")
    return cfg


def main(argv: Optional[Sequence[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="sandbox_tc_mapper",
        description="%s %s - compares two sandboxes and finds the test cases to run. Fully offline." % (
            APP_NAME, APP_VERSION))
    ap.add_argument("--selftest", action="store_true", help="run the built-in self-test suite and exit")
    ap.add_argument("--benchmark", action="store_true", help="simulated training on demo data (shows learning)")
    ap.add_argument("--make-demo", metavar="DIR", help="create demo sandboxes and 3000+ demo test cases in DIR")
    ap.add_argument("--model-dir", help="folder for the trained model data (default %s)" % DEFAULT_MODEL_DIR)
    ap.add_argument("--old", help="old sandbox (baseline)")
    ap.add_argument("--new", help="new sandbox")
    ap.add_argument("--changes", help="files-changed Excel (instead of --old)")
    ap.add_argument("--testcases", help="test-case Excel (column 'Text')")
    ap.add_argument("--out", help="result Excel to write (headless mode)")
    ap.add_argument("--changes-out", help="also write the files-changed Excel here (headless mode)")
    ap.add_argument("--threshold", type=float, help="minimum confidence 0..1 (default: value stored in the model)")
    ap.add_argument("--patterns", help="user file patterns, e.g. \"*.arxml;*.dbc\"")
    ap.add_argument("--exclude", help="folders to ignore, e.g. \".git;build\"")
    ap.add_argument("--keep-ws", action="store_true", help="report white-space-only changes too")
    ap.add_argument("--with-comments", action="store_true", help="find test cases for comment-only changes too")
    ap.add_argument("--llm", action="store_true", help="also use the local LLM set up in the GUI (LOCAL LLM window)")
    ap.add_argument("--gguf", help="use this GGUF model file with llama.cpp (implies --llm)")
    ap.add_argument("--llm-candidates", type=int, help="test cases per changed function checked by the LLM")
    ap.add_argument("--confirmed-out", help="write the confirmed test cases to this Excel file (or folder)")
    ap.add_argument("--llm-test", action="store_true", help="load the local LLM, run a short test and exit")
    ap.add_argument("--llm-benchmark", action="store_true",
                    help="demo data: matcher alone vs matcher + local LLM (needs --gguf or a saved LLM setup)")
    ap.add_argument("--compare-models", action="store_true",
                    help="train and compare the ranking models (logistic regression, boosted trees, neural "
                         "network, ensemble) on your training data and use the best one")
    ap.add_argument("--ranker", choices=("auto", "off") + RANKER_KINDS,
                    help="with --compare-models: which ranking model to use (default auto = best in comparison)")
    ap.add_argument("--model-benchmark", action="store_true",
                    help="synthetic project: train on some changes, measure all ranking models on unseen changes")
    args = ap.parse_args(argv)

    if ENFORCE_OFFLINE:
        enforce_offline()
    if args.selftest:
        return run_selftest()
    if args.benchmark:
        run_benchmark()
        return 0
    if args.model_benchmark:
        try:
            run_model_benchmark()
        except RuntimeError as exc:
            print("ERROR: %s" % exc, file=sys.stderr)
            return 2
        return 0
    if args.make_demo:
        demo = make_demo(args.make_demo)
        write_changes_excel(os.path.join(os.path.abspath(args.make_demo), "files_changed_template.xlsx"), None)
        print("Demo data written to %s\n  old sandbox : %s\n  new sandbox : %s\n  test cases  : %s" % (
            os.path.abspath(args.make_demo), demo["old"], demo["new"], demo["testcases"]))
        return 0
    model_dir, note = resolve_model_dir(args.model_dir)
    if args.compare_models:
        model = Model(model_dir)
        if args.ranker:
            model.ranker_mode = args.ranker
            model.save()
        if _np() is None:
            print("ERROR: the smart ranker needs numpy (pip install numpy).", file=sys.stderr)
            return 2
        last = [0.0]

        def progress(msg: str, frac: float) -> None:
            if time.time() - last[0] > 2.0:
                last[0] = time.time()
                print("  " + msg)

        if args.testcases:                             # rebuild everything from the training log first
            store = TestCaseStore.load(args.testcases, progress)
            eng = Engine(model, store, progress=progress)
            n = eng.retrain(progress, refit=False)
            print("Model rebuilt from %d training sessions." % n)
        elif not len(model.rows) and len(model.history):
            print("No training rows yet - add  --testcases TC.xlsx  to rebuild them from your %d training "
                  "sessions (or press 'Re-train from history' in the GUI)." % len(model.history))
        info = model.refit_ranker(progress)
        for line in format_ranker_table(info):
            print(line)
        return 0
    if args.llm_test or args.llm_benchmark:
        try:
            cfg = _cli_llm_config(args, Model(model_dir))
            if args.llm_benchmark:
                run_llm_benchmark(cfg)
                return 0
            judge = LLMJudge(make_backend(cfg, lambda m, f: print("  " + m)), cfg, model_dir)
            try:
                for line in llm_self_check(judge):
                    print(line)
            finally:
                judge.close()
            return 0
        except (ValueError, RuntimeError, OSError) as exc:
            print("ERROR: %s" % exc, file=sys.stderr)
            return 2
    headless = bool((args.old and args.new) or (args.changes and (args.testcases or args.changes_out)))
    if headless:
        try:
            return run_headless(args, model_dir)
        except (ValueError, RuntimeError, OSError) as exc:
            print("ERROR: %s" % exc, file=sys.stderr)
            return 2
    try:
        run_gui(model_dir, note)
    except ImportError as exc:
        print("The GUI needs tkinter (part of the standard Python installer on Windows): %s" % exc, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
