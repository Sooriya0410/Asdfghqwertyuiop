class T13_LlamaCpp(unittest.TestCase):
    """The llama.cpp runtime with tiny generated GGUF models (skipped when llama-cpp-python is missing)."""

    def setUp(self):
        import importlib.util
        if importlib.util.find_spec("llama_cpp") is None or importlib.util.find_spec("numpy") is None:
            self.skipTest("llama-cpp-python is not installed")

    def _model(self, name: str, chain: Dict[str, str], *cal: float) -> str:
        path = os.path.join(_ctx()["tmp"], name + ".gguf")
        if not os.path.isfile(path):
            write_tiny_gguf(path, chain, *cal)
        return path

    def test_probabilities_reuse_and_generation(self):
        cfg = LLMConfig(backend="llamacpp", gguf=self._model("tiny_yes", _TINY_YES), n_ctx=4096)
        b = LlamaCppBackend(cfg)
        try:
            self.assertEqual(b.family, "chatml")
            self.assertTrue(b.supports_prob)
            m1 = [{"role": "system", "content": "S"}, {"role": "user", "content": "CHANGE\n" + LLM_SPLIT + "TC one\nQ?"}]
            m2 = [{"role": "system", "content": "S"}, {"role": "user", "content": "CHANGE\n" + LLM_SPLIT + "TC two!\nQ?"}]
            self.assertIn("<|im_start|>assistant\n", b.render(m1))
            self.assertGreater(b.yes_prob(m1), 0.99)
            n1 = b.n_evaluated
            self.assertGreater(b.yes_prob(m2), 0.99)
            self.assertLess(b.n_evaluated - n1, n1 * 0.8)                # shared part was not evaluated again
            self.assertEqual(b.generate(m1, 20), "Yes -ok")
            self.assertEqual(b.generate(m1, 20, prefix="Yes"), " -ok")
            self.assertEqual(parse_answer("Yes" + b.generate(m2, 20, prefix="Yes")), (True, "ok"))
            p_normal = b.yes_prob(m2)
            b.recurrent = True                                           # the saved-state path of hybrid models
            b.yes_prob(m1)
            n2 = b.n_evaluated
            self.assertAlmostEqual(b.yes_prob(m2), p_normal, places=5)
            self.assertLess(b.n_evaluated - n2, n1 * 0.8)
            with self.assertRaises(LLMContextError):
                b.yes_prob([{"role": "user", "content": "x" * 5000}])
        finally:
            b.close()
        b = LlamaCppBackend(LLMConfig(backend="llamacpp", gguf=self._model("tiny_no", _TINY_NO)))
        try:
            self.assertLess(b.yes_prob([{"role": "user", "content": "Q?"}]), 0.01)
            self.assertEqual(parse_answer(b.generate([{"role": "user", "content": "Q?"}], 20)), (False, "bad"))
        finally:
            b.close()
        b = LlamaCppBackend(LLMConfig(backend="llamacpp", gguf=self._model("tiny_cal", _TINY_YES, 2.0, 1.0)))
        try:
            self.assertAlmostEqual(b.yes_prob([{"role": "user", "content": "Q?"}]), 1 / (1 + math.exp(-1)), places=3)
        finally:
            b.close()
        with self.assertRaises(LLMError):
            LlamaCppBackend(LLMConfig(backend="llamacpp", gguf=os.path.join(_ctx()["tmp"], "missing.gguf")))
        bad = os.path.join(_ctx()["tmp"], "broken.gguf")
        with open(bad, "wb") as fh:
            fh.write(b"GGUF" + b"\0" * 64)
        with self.assertRaises(LLMError):
            LlamaCppBackend(LLMConfig(backend="llamacpp", gguf=bad))

