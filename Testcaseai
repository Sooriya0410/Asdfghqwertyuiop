class T07_Learning(unittest.TestCase):
    def test_expected_wrong_and_scope(self):
        eng = _fresh_engine()
        ch = _change("PwrMgr_CheckUnderVolt")
        q = eng.query_for_change(ch)
        shown = eng.match(q)
        got = {m.tc.tc_id for m in shown}
        missed = _by_id(next(i for i in _ctx()["demo"]["truth"]["x:door lock"] if i not in got))
        wrong = shown[3].tc
        s = eng.feedback(q, shown, {shown[0].tc.key: "R", wrong.key: "W"}, [missed.key], 4, "unit test")
        self.assertEqual((s["right"], s["wrong"], s["missing"]), (1, 1, 1))
        after = {m.tc.key: m for m in eng.match(eng.query_for_change(ch))}
        self.assertGreaterEqual(after[missed.key].conf, LEVEL_HIGH)
        self.assertTrue(after[missed.key].reasons[0].startswith("TRAINED"))
        self.assertGreater(after[shown[0].tc.key].conf, shown[0].conf)
        self.assertNotIn(wrong.key, after)                                   # rejected for this function
        # a different line of the same function keeps what was learned
        other = Change(file=ch.file, kind="C", functions=list(ch.functions), new_start=ch.new_start + 2,
                       new_end=ch.new_start + 2, new_code="        PwrMgr_State = PWR_STATE_UV;")
        o = {m.tc.key: m for m in eng.match(eng.query_for_change(other))}
        self.assertGreaterEqual(o[missed.key].conf, LEVEL_MED)
        self.assertGreater(o[missed.key].feats["link"], 0.5)
        self.assertNotIn(wrong.key, o)
        # ... but the rejection does not leak into other functions
        full = eng.match(eng.query_for_change(_change("PwrMgr_CheckOverVolt") if False else
                                              next(c for c in _ctx()["cs"].changes if c.file.endswith("PwrMgr_Cfg.h"))),
                         threshold=0.0, limit=None, only={wrong.idx})
