_OFFLINE_MSG = ("Network access is disabled: %s never opens a network connection - not even to this PC "
                "(localhost / 127.0.0.1)." % APP_NAME)
_OFFLINE_MSG_LOCAL = ("Network access is disabled: %s is offline by design - only the local LLM server on this "
