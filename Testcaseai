    def act_quick_verdict(self, v: str) -> None:
        """Confirm / Reject the selected test cases for the selected change - saved as training at once."""
        ch = self._selected_change()
        res = self.res_by_cid.get(ch.cid) if ch is not None else None
        sel = self.tree_tc.selection()
        if ch is None or res is None or not sel or self.engine is None or self.store is None:
            messagebox.showinfo(APP_NAME, "Select one change in the left list (not 'ALL'), then select the test "
                                          "case(s) and press Confirm or Reject.")
            return
        keys = [self.store.cases[int(i)].key for i in sel]
        verdicts = {k: v for k in keys}
        llm_p = {m.tc.key: m.llm for m in res.matches if m.llm is not None}
        try:
            self.engine.feedback(res.query, res.matches, verdicts, [], None, "Confirm / Reject in WORKING window",
                                 llm_ctx=llm_change_text(self.engine, [ch], res.query.context), llm_p=llm_p)
        except Exception as exc:                           # noqa: BLE001
            self._show_error("Confirm / Reject", exc, traceback.format_exc())
            return
        for m in res.matches:
            if m.tc.key in verdicts:
                m.status = STATUS_YOU if v == "R" else STATUS_YOU_NO
        self.summary = summarize_results(self.results)
        self._fill_change_tree()
        self.tree_ch.selection_set(ch.cid)
        self.tree_ch.see(ch.cid)
        self.refresh_model_tab()
        self.set_status("%s %d test case(s) for %s - learned and kept as training." % (
            "Confirmed" if v == "R" else "Rejected", len(keys), ch.cid))
        self._auto_export()
        self._refit_ranker_bg()

    def act_export_confirmed(self) -> None:
        if not self.v_export.get().strip():
            self._browse_export()
            if not self.v_export.get().strip():
                return
        self._export_async(force=True)

    def _auto_export(self) -> None:
        if self.v_auto_export.get() and self.v_export.get().strip():
            self._export_async()

    def _export_async(self, force: bool = False) -> None:
        """Write the confirmed-test-case Excel in the background (the GUI stays usable)."""
        path = self.v_export.get().strip().strip('"')
        snap = confirmed_snapshot(self.results)
        model, store, run_info = self.model, self.store, self._run_info(self.cs)

        def worker() -> None:
            try:
                written = write_confirmed_excel(path, snap, model, store, run_info)
                note = "" if os.path.abspath(written) == os.path.abspath(path) or os.path.isdir(path) else \
                    "  (the file was open in Excel - saved under this name instead)"
                self.q.put(("ui", lambda: self.set_status("Confirmed test cases saved: %s%s" % (written, note))))
            except Exception as exc:                       # noqa: BLE001
                err = str(exc)
                self.q.put(("ui", lambda: (self.set_status("Could not save the confirmed test cases: %s" % err),
                                           force and messagebox.showerror(APP_NAME, err))))

        threading.Thread(target=worker, daemon=True).start()

