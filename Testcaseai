            self._browse_file(self.v_changes, [("Excel", "*.xlsx *.xlsm"), ("All files", "*.*")])
            inp = self.inputs()
            if not inp["changes"]:
                return
        if not os.path.isfile(inp["changes"]):
            messagebox.showerror(APP_NAME, "File not found:\n%s" % inp["changes"])
            return

        def job(progress: ProgressFn) -> ChangeSet:
            self._prepare(inp, progress, need_tc=False, need_sbx=True, force_sbx=True)
            _progress(progress, "Reading files-changed Excel ...")
            return read_changes_excel(inp["changes"], self.sbx, inp["patterns"])

        self.run_bg("Loading files-changed Excel", job, self._changes_ready)

    def _changes_ready(self, cs: ChangeSet) -> None:
        self.cs = cs
        self.results, self.res_by_cid, self.summary = [], {}, []
        self.t_done.clear()
        self._fill_change_tree()
        s = cs.stats
        self.lbl_changes.configure(text="Changes: %d files, %d changed blocks" % (len(cs.files), len(cs.changes)))
        extra = ""
        if "identical" in s:
            extra = "   |   %d identical, %d white-space only   |   %.1f s" % (
                s.get("identical", 0), s.get("whitespace_only", 0), s.get("seconds", 0.0))
        self.lbl_changes2.configure(text="C files: %d   H files: %d   user files: %d%s" % (
            s.get("c_files", 0), s.get("h_files", 0), s.get("user_files", 0), extra))
        note = ""
        if self.sbx is not None:
            note = "  Sandbox analysed: %d functions in %d files." % (self.sbx.n_funcs, len(self.sbx.funcs_by_file))
        self.set_status("Changes loaded.%s  Step 2: press 'Find test cases'." % note)
        self._fill_train_changes()
        if not cs.changes:
            messagebox.showinfo(APP_NAME, "No differences were found.")

    def _fill_change_tree(self) -> None:
        t = self.tree_ch
        t.delete(*t.get_children(""))
        if not self.cs:
            return
        n_all = ""
        if self.results:
            n_all = (sum(1 for a in self.summary if a["status"] in CONFIRMED_STATUSES) if self.last_run.get("llm")
                     else len(self.summary))
        t.insert("", "end", iid="ALL", values=("ALL", n_all, "ALL CHANGES - every test case to run", "", "", "", ""),
                 tags=("all",))
        llm_run = bool(self.last_run.get("llm"))
        for ch in self.cs.changes:
            res = self.res_by_cid.get(ch.cid)
            n = ""
            if res:
                n = sum(1 for m in res.matches if m.confirmed) if llm_run else len(res.matches)
            t.insert("", "end", iid=ch.cid, values=(
                ch.cid, n, ch.file, ", ".join(ch.functions) or "-",
                ch.new_lines or ("old " + ch.old_lines if ch.old_lines else ""), ch.kind, ch.status))
        if self.results:
            t.selection_set("ALL")
            t.focus("ALL")

    def act_find(self) -> None:
        inp = self.inputs()
        if not inp["tc"]:
            messagebox.showinfo(APP_NAME, "Select the test-case Excel first.")
            return
        have_cs = self.cs is not None
        if not have_cs and not ((inp["old"] and inp["new"]) or inp["changes"]):
            messagebox.showinfo(APP_NAME, "Step 1 is missing: compare two sandboxes or load a files-changed Excel.")
            return
        if self.v_use_llm.get() and not self.llm_cfg.enabled():
            messagebox.showinfo(APP_NAME, "Choose where the LLM runs in the LOCAL LLM window first "
                                          "(or untick 'with local LLM').")
            return
        if inp["use_llm"] and self.cs is not None and not self._confirm_big_llm_run(self.cs, inp):
            return
        self._cancel_train_llm()
        cs_holder: Dict[str, Any] = {"cs": self.cs}

        def job(progress: ProgressFn) -> Tuple[ChangeSet, List[ChangeResult], Dict[str, Any]]:
            self._prepare(inp, progress, need_tc=True, need_sbx=True, force_sbx=not have_cs)
            cs = cs_holder["cs"]
            if cs is None:
                if inp["changes"] and os.path.isfile(inp["changes"]):
                    cs = read_changes_excel(inp["changes"], self.sbx, inp["patterns"])
                else:
                    cs = compare_sandboxes(inp["old"], inp["new"], inp["patterns"], inp["exclude"],
                                           inp["ignore_ws"], progress,
                                           new_table=self.sbx.table if self.sbx else None)
            assert self.engine is not None
            info: Dict[str, Any] = {"llm": inp["use_llm"]}
            if inp["use_llm"]:
                judge = self._get_judge(progress)
                info["model"] = judge.backend.name
                results = analyze_changes_llm(self.engine, judge, cs.changes, inp["thr"], progress,
                                              inp["ignore_cmt"], self.cancel_ev, info)
            else:
                results = analyze_changes(self.engine, cs.changes, inp["thr"], progress, inp["ignore_cmt"])
            if inp["export"] and inp["auto_export"]:
                _progress(progress, "Saving the confirmed test cases ...")
                try:
                    info["export"] = write_confirmed_excel(inp["export"], confirmed_snapshot(results), self.model,
                                                           self.store, self._run_info(cs, info, inp))
                except Exception as exc:                   # noqa: BLE001
                    info["export_error"] = str(exc)
            return cs, results, info

        def done(res: Tuple[ChangeSet, List[ChangeResult], Dict[str, Any]]) -> None:
            cs, results, info = res
            if cs is not self.cs:
                self._changes_ready(cs)
            self.results = results
            self.last_run = info
            self.res_by_cid = {r.change.cid: r for r in results}
            self.summary = summarize_results(results)
            self._fill_change_tree()
            self._fill_train_changes()
            warn = ""
            if self.store and self.store.warnings:
                warn = "   Note: " + " ".join(self.store.warnings)
            if info.get("llm"):
                c = count_statuses(results)
                msg = ("Done%s: %d test cases confirmed (%d by you, %d by the LLM), %d not checked, %d rejected by the "
                       "LLM - %d changes, %d LLM answers (%d remembered)." % (
                           " (STOPPED - press Find again to continue)" if info.get("cancelled") else "",
                           c[STATUS_YOU] + c[STATUS_LLM], c[STATUS_YOU], c[STATUS_LLM], c[STATUS_UNCHECKED],
                           c[STATUS_REJECTED], len(results), info.get("calls", 0), info.get("cached", 0)))
            else:
                n_hi = sum(1 for a in self.summary if a["conf"] >= LEVEL_HIGH)
                n_md = sum(1 for a in self.summary if LEVEL_MED <= a["conf"] < LEVEL_HIGH)
                msg = ("Done: %d test cases to run for %d changes  (%d high, %d medium, %d possible) out of %d test "
                       "cases." % (len(self.summary), len(results), n_hi, n_md, len(self.summary) - n_hi - n_md,
                                   len(self.store) if self.store else 0))
            if info.get("too_long"):
                msg += ("   %d test case(s) not checked: prompt longer than the model context - increase 'Context' "
                        "in the LOCAL LLM window." % info["too_long"])
            if info.get("export"):
                msg += "   Confirmed test cases saved: %s" % info["export"]
            elif info.get("export_error"):
                msg += "   Could not save the confirmed test cases: %s" % info["export_error"]
            self.set_status(msg + warn)

        self.run_bg("Finding test cases" + (" with the local LLM" if inp["use_llm"] else ""), job, done)

    def _run_info(self, cs: Optional[ChangeSet], info: Optional[Dict[str, Any]] = None,
                  inp: Optional[Dict[str, Any]] = None) -> List[Tuple[str, Any]]:
        """Run details for the export.  From a worker thread pass 'inp' (Tk variables are GUI-thread only)."""
        info = info if info is not None else self.last_run
        inp = inp if inp is not None else self.inputs()
        return [("Sandbox (new)", inp["new"]), ("Sandbox (old)", cs.old_root if cs and cs.old_root else inp["old"]),
                ("Test case file", inp["tc"]), ("Changes", len(cs.changes) if cs else ""),
                ("Local LLM", info.get("model", "not used") if info.get("llm") else "not used"),
                ("LLM confirm level", "%d %%" % round(self.llm_cfg.confirm * 100) if info.get("llm") else ""),
                ("Test cases checked per change", self.llm_cfg.candidates if info.get("llm") else ""),
                ("LLM run stopped early", "yes" if info.get("cancelled") else "")]

    def _confirm_big_llm_run(self, cs: ChangeSet, inp: Dict[str, Any]) -> bool:
        """Large deltas need many LLM answers: say how many (and how long) before starting."""
        funcs = {(c.file, c.functions[0] if c.functions else "") for c in cs.changes
                 if not (inp["ignore_cmt"] and c.note.startswith("comment-only"))}
        per = min(self.llm_cfg.candidates, len(self.store) if self.store else self.llm_cfg.candidates)
        n = len(funcs) * per
        sec = self.judge.avg_seconds if self.judge is not None else 0.0
        if n <= 3000 and not (sec and n * sec > 1800):
            return True
        speed = (" At the speed measured on this PC (%.1f s per answer) that is about %s." % (sec, _fmt_secs(n * sec))
                 if sec else " Press 'Load + test model' in the LOCAL LLM window to measure the speed of this PC.")
        return bool(messagebox.askyesno(APP_NAME, (
            "The LLM has to check up to %d test cases (%d changed functions x %d).%s\n\n"
            "Answers it gave before are remembered and not asked again. You can press Stop at any time - "
            "a stopped run continues where it stopped.\n\nStart now?") % (n, len(funcs), per, speed)))

    def _on_use_llm(self) -> None:
        if self.v_use_llm.get() and not self.llm_cfg.enabled():
            self.v_use_llm.set(False)
            self.nb.select(self.tab_llm)
            messagebox.showinfo(APP_NAME, "Set up the local LLM in this window first: choose where it runs, then "
                                          "press 'Load + test model'.")

    def _get_judge(self, progress: ProgressFn = None, reload: bool = False) -> LLMJudge:
        """(any thread) the loaded LLM; loads it on first use or when its settings changed."""
        cfg = self.llm_cfg.copy()
        if not cfg.enabled():
            raise UserError("The local LLM is off - choose where it runs in the LOCAL LLM window.")
        sig = cfg.load_signature()
        with self._judge_lock:
            if self.judge is not None and (reload or sig != self.judge_sig):
                self.judge.close()
                self.judge = None
            if self.judge is None:
                self.judge = LLMJudge(make_backend(cfg, progress), cfg, self.model.dir)
                self.judge_sig = sig
            else:
                self.judge.cfg = cfg                  # decision settings change without reloading
            return self.judge

    def _selected_change(self) -> Optional[Change]:
        sel = self.tree_ch.selection()
        if not sel or sel[0] == "ALL" or not self.cs:
            return None
        for ch in self.cs.changes:
            if ch.cid == sel[0]:
                return ch
        return None

    def _on_change_select(self, _evt: Any = None) -> None:
        sel = self.tree_ch.selection()
        t = self.tree_tc
        t.delete(*t.get_children(""))
        self._fill(self.txt_why, [])
        if not sel:
            return
        if sel[0] == "ALL":
            if self.last_run.get("llm"):
                n_c = sum(1 for a in self.summary if a["status"] in CONFIRMED_STATUSES)
                self.lbl_tcs.configure(text="All changes: %d confirmed, %d listed" % (n_c, len(self.summary)))
            else:
                self.lbl_tcs.configure(text="All test cases to run: %d" % len(self.summary))
            for a in self.summary:
                tc = a["tc"]
                best = a["best"]
                t.insert("", "end", iid=str(tc.idx), tags=(self._row_tag(best),), values=(
                    tc.tc_id, best.status_text(), self._llm_cell(best), "%d%%" % round(a["conf"] * 100),
                    len(a["changes"]), tc.headline()))
            seg = [("All changes\n", "h")]
            if self.cs:
                for f in self.cs.files:
                    seg.append(("%-8s %-5s %s   (+%d / -%d lines, %d blocks)\n" % (
                        f.status, f.kind, f.file, f.added, f.removed, f.hunks), "code"))
            self._fill(self.txt_code, seg)
        else:
            ch = self._selected_change()
            if ch is None:
                return
            res = self.res_by_cid.get(ch.cid)
            n = len(res.matches) if res else 0
            n_c = sum(1 for m in res.matches if m.confirmed) if res else 0
            self.lbl_tcs.configure(text="Test cases for %s: %s%s" % (
                ch.cid, ("%d confirmed, %d listed" % (n_c, n)) if self.last_run.get("llm") else str(n),
                "" if res else "   (press 'Find test cases')"))
            if res:
                for m in res.matches:
                    t.insert("", "end", iid=str(m.tc.idx), tags=(self._row_tag(m),), values=(
                        m.tc.tc_id, m.status_text(), self._llm_cell(m), "%d%%" % round(m.conf * 100), "",
                        m.tc.headline()))
            self._fill(self.txt_code, self._change_segments(ch, res.query if res else None))
        kids = t.get_children("")
        if kids:
            t.selection_set(kids[0])

    @staticmethod
    def _row_tag(m: Match) -> str:
        return ("s_" + m.status) if m.status in COL_STATUS else m.level

    @staticmethod
    def _llm_cell(m: Match) -> str:
        return "" if m.llm is None else "%d%%" % round(m.llm * 100)

    def _change_segments(self, ch: Change, q: Optional[Query]) -> List[Tuple[str, str]]:
        seg: List[Tuple[str, str]] = [("%s   %s\n" % (ch.cid, ch.file), "h")]
        seg.append(("Type %s   Status %s   Function: %s\n" % (
            ch.kind, ch.status, ", ".join(ch.functions) or "(file scope)"), ""))
        seg.append(("New lines: %s    Old lines: %s%s\n" % (
            ch.new_lines or "-", ch.old_lines or "-", ("    Note: " + ch.note) if ch.note else ""), ""))
        if q and q.context:
            seg.append(("\nSandbox analysis\n", "h"))
            for line in q.context:
                seg.append(("  " + line + "\n", ""))
        if ch.old_code:
            seg.append(("\nOld code (lines %s)\n" % (ch.old_lines or "-"), "h"))
            seg += [("- " + ln + "\n", "del") for ln in ch.old_code.split("\n")]
        if ch.new_code:
            seg.append(("\nNew code (lines %s)\n" % (ch.new_lines or "-"), "h"))
            seg += [("+ " + ln + "\n", "add") for ln in ch.new_code.split("\n")]
        return seg

    def _tc_segments(self, tc: TestCase, m: Optional[Match], extra: Sequence[Tuple[str, str]] = ()) -> List[Tuple[str, str]]:
        seg: List[Tuple[str, str]] = []
        if m is not None:
            seg.append(("%s    confidence %d %%  (%s)\n" % (tc.tc_id, round(m.conf * 100), m.level), "h"))
        else:
            seg.append(("%s\n" % tc.tc_id, "h"))
        seg += list(extra)
        if m is not None and (m.status or m.llm is not None):
            seg.append(("Decision: %s\n" % (m.status_text()), "b"))
            if m.llm is not None:
                seg.append(("  Local LLM: %d %% sure it must be run%s\n" % (
                    round(m.llm * 100), (" - " + m.llm_why) if m.llm_why else ""), "trained"))
            if m.status == STATUS_YOU:
                seg.append(("  You confirmed this test case for this function / line in training - this wins over "
                            "the LLM.\n", "trained"))
            elif m.status == STATUS_YOU_NO:
                seg.append(("  You rejected this test case for this function / line in training.\n", "trained"))
            elif m.status == STATUS_UNCHECKED:
                seg.append(("  Not checked by the LLM (beyond 'test cases per change' or the run was stopped).\n",
                            "dim"))
        if m is not None:
            seg.append(("Why the matcher picked it\n" if m.llm is not None else "Why this test case\n", "b"))
            if not m.reasons:
                seg.append(("  (weak overall similarity)\n", "dim"))
            for r in (m.reasons or []):
                seg.append(("  - " + r + "\n", "trained" if r.startswith(("TRAINED", "Learned", "Counter")) else ""))
            ev = "   ".join("%s %.2f" % (lab, m.feats.get(k, 0.0)) for k, lab in FEAT_LABEL if m.feats.get(k, 0.0) >= 0.005)
            seg.append(("  Evidence (0..1):  %s\n" % (ev or "-"), "dim"))
        seg.append(("\nTest case  (Excel row %d)\n" % tc.row, "b"))
        if tc.pre or tc.exp or tc.title:
            if tc.title:
                seg.append((tc.title + "\n", ""))
            for name, body in (("Precondition", tc.pre), ("Test procedure", tc.proc), ("Expected result", tc.exp)):
                if body:
                    seg.append((name + "\n", "b"))
                    seg.append((body + "\n", ""))
        else:
            seg.append((tc.text + "\n", ""))
        if tc.meta:
            seg.append(("\n" + "   |   ".join("%s: %s" % kv for kv in tc.meta.items()) + "\n", "dim"))
        return seg

    def _on_tc_select(self, _evt: Any = None) -> None:
        sel = self.tree_tc.selection()
        if not sel or self.store is None:
            return
        idx = int(sel[0])
        tc = self.store.cases[idx]
        csel = self.tree_ch.selection()
        if csel and csel[0] == "ALL":
            a = next((x for x in self.summary if x["tc"].idx == idx), None)
            if a is None:
                return
            chs = sorted(a["changes"], key=lambda x: -x[1])
            extra: List[Tuple[str, str]] = [("Hit by %d change(s)\n" % len(chs), "b")]
            for c, cf in chs[:25]:
                extra.append(("  %s  %s   (%d %%)\n" % (c.cid, c.label(), round(cf * 100)), ""))
            if len(chs) > 25:
                extra.append(("  ... +%d more\n" % (len(chs) - 25), "dim"))
            extra.append(("Reasons below are for the strongest change (%s).\n" % a["best_change"].cid, "dim"))
            best_res = self.res_by_cid.get(a["best_change"].cid)
            if best_res and self.engine:
                self.engine.explain_matches(best_res.query, [a["best"]])
            self._fill(self.txt_why, self._tc_segments(tc, a["best"], extra))
        else:
            res = self.res_by_cid.get(csel[0]) if csel else None
            m = next((x for x in res.matches if x.tc.idx == idx), None) if res else None
            if m is not None and res and self.engine:
                self.engine.explain_matches(res.query, [m])
            self._fill(self.txt_why, self._tc_segments(tc, m))

