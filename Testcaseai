        ttk.Label(bar, text="OFFLINE - no network access", style="Ok.TLabel").pack(side="right")

    def set_status(self, msg: str) -> None:
        self.lbl_status.configure(text=msg)

    def run_bg(self, title: str, func: Callable[[ProgressFn], Any], on_done: Callable[[Any], None]) -> None:
        if self.busy:
            self.set_status("Please wait - another task is still running ...")
            return
        self.busy = True
        self.cancel_ev.clear()
        for b in self._action_buttons:
            b.configure(state="disabled")
        for b in self._stop_buttons:
            b.configure(state="normal")
        self.set_status(title + " ...")

        def cb(msg: str, frac: float) -> None:
            self.q.put(("progress", msg, frac))

        def worker() -> None:
            try:
                res = func(cb)
                self.q.put(("done", on_done, res))
            except Exception as exc:                       # noqa: BLE001
                self.q.put(("error", title, exc, traceback.format_exc()))

        threading.Thread(target=worker, daemon=True).start()

    def _poll(self) -> None:
        try:
            while True:
                item = self.q.get_nowait()
                kind = item[0]
                if kind == "progress":
                    self.set_status(item[1])
                    if item[2] is not None and item[2] >= 0:
                        self.pb.configure(mode="determinate")
                        self.pb["value"] = int(item[2] * 1000)
                elif kind == "ui":
                    try:
                        item[1]()
                    except Exception as exc:               # noqa: BLE001
                        self._show_error("Display", exc, traceback.format_exc())
                elif kind in ("done", "error"):
                    self.busy = False
                    self.pb["value"] = 0
                    for b in self._action_buttons:
                        b.configure(state="normal")
                    for b in self._stop_buttons:
                        b.configure(state="disabled")
                    if self._store_reloaded:
                        self._store_reloaded = False
                        self._forget_old_testcases()
                    if kind == "done":
                        try:
                            item[1](item[2])
                        except Exception as exc:           # noqa: BLE001
                            self._show_error("Display", exc, traceback.format_exc())
                    else:
                        self._show_error(item[1], item[2], item[3])
        except queue.Empty:
            pass
        self.root.after(70, self._poll)

    def _forget_old_testcases(self) -> None:
        """A different test-case file was loaded: drop results and ratings of the old one."""
        self.results, self.res_by_cid, self.summary = [], {}, []
        self.t_query, self.t_matches, self.t_verdicts, self.t_expected = None, [], {}, []
        self.t_search_hits = []
        for tree in (self.tree_tc, self.tree_tr):
            tree.delete(*tree.get_children(""))
        self.lst_hits.delete(0, "end")
        self.lst_exp.delete(0, "end")
        self._fill(self.txt_why, [])
        self._fill(self.txt_train, [])
        self._fill_change_tree()

