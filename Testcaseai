    def _llm_cfg_to_ui(self) -> None:
        c = self.llm_cfg
        self._llm_ui_loading = True
        try:
            self.v_llm_backend.set(c.backend)
            self.v_llm_gguf.set(c.gguf)
            self.v_llm_threads.set(str(c.threads))
            self.v_llm_gpu.set(str(c.gpu_layers))
            self.v_llm_ctx.set(str(c.n_ctx))
            self.v_llm_ollama_url.set(c.ollama_url)
            self.v_llm_ollama_model.set(c.ollama_model)
            self.v_llm_server_url.set(c.server_url)
            self.v_llm_server_model.set(c.server_model)
            self.v_llm_cands.set(str(c.candidates))
            self.v_llm_confirm.set(str(int(round(c.confirm * 100))))
            self.v_llm_reasons.set(c.reasons)
            self.v_llm_explain.set(c.explain)
            self.v_llm_examples.set(c.examples)
        finally:
            self._llm_ui_loading = False
        self._llm_refresh_suggest()

    def _llm_cfg_from_ui(self) -> LLMConfig:
        if getattr(self, "_llm_ui_loading", False):
            return self.llm_cfg

        def num(var: Any, default: float) -> float:
            try:
                return float(str(var.get()).strip())
            except (ValueError, tk.TclError):
                return default

        c = self.llm_cfg
        d = {"backend": self.v_llm_backend.get(), "gguf": self.v_llm_gguf.get().strip().strip('"'),
             "threads": int(num(self.v_llm_threads, c.threads)), "gpu_layers": int(num(self.v_llm_gpu, c.gpu_layers)),
             "n_ctx": int(num(self.v_llm_ctx, c.n_ctx)), "ollama_url": self.v_llm_ollama_url.get().strip(),
             "ollama_model": self.v_llm_ollama_model.get().strip(), "server_url": self.v_llm_server_url.get().strip(),
             "server_model": self.v_llm_server_model.get().strip(),
             "candidates": int(num(self.v_llm_cands, c.candidates)),
             "confirm": num(self.v_llm_confirm, c.confirm * 100) / 100.0, "reasons": bool(self.v_llm_reasons.get()),
             "explain": bool(self.v_llm_explain.get()), "examples": bool(self.v_llm_examples.get())}
        self.llm_cfg = LLMConfig.from_dict(d)
        return self.llm_cfg

    def _on_llm_backend(self) -> None:
        cfg = self._llm_cfg_from_ui()
        if not cfg.enabled():
            self.v_use_llm.set(False)

    def _browse_gguf(self) -> None:
        cur = self.v_llm_gguf.get().strip()
        f = filedialog.askopenfilename(initialdir=os.path.dirname(cur) if cur else None, title="Select the GGUF model",
                                       filetypes=[("GGUF model", "*.gguf"), ("All files", "*.*")])
        if f:
            self.v_llm_gguf.set(os.path.normpath(f))
            if self.v_llm_backend.get() == "off":
                self.v_llm_backend.set("llamacpp")
                self._on_llm_backend()

    def _llm_refresh_suggest(self) -> None:
        sug = suggest_llm_threshold(self.model)
        self._llm_sugg = sug
        if sug is None:
            self.lbl_llm_sugg.configure(text="(suggestion after 10+ Right and 10+ Wrong on LLM answers)")
            self.btn_llm_sugg.configure(state="disabled")
        else:
            self.lbl_llm_sugg.configure(text="your verdicts suggest %d %%" % round(sug * 100))
            self.btn_llm_sugg.configure(state="normal")

    def act_llm_apply_suggest(self) -> None:
        if getattr(self, "_llm_sugg", None):
            self.v_llm_confirm.set(str(int(round(self._llm_sugg * 100))))
            self.set_status("LLM confirm level set to %d %% - press 'Find test cases' again to apply it." %
                            round(self._llm_sugg * 100))

    def act_llm_test(self) -> None:
        cfg = self._llm_cfg_from_ui()
        if not cfg.enabled():
            messagebox.showinfo(APP_NAME, "Choose where the model runs (step 1) first.")
            return
        self._cancel_train_llm()

        def job(progress: ProgressFn) -> List[str]:
            return llm_self_check(self._get_judge(progress), progress)

        def done(lines: List[str]) -> None:
            ok = bool(lines) and lines[-1].endswith("model works")
            self._llm_show(["LOAD + TEST   %s" % now_iso(), ""] + lines + ["", "-" * 60, self.LLM_HELP])
            if ok:
                self.v_use_llm.set(True)
            self.set_status("Local LLM: %s" % (lines[-1] if lines else "?"))

        self.run_bg("Loading and testing the local LLM", job, done)

    def act_llm_unload(self) -> None:
        with self._judge_lock:
            if self.judge is not None:
                self.judge.close()
            self.judge, self.judge_sig = None, None
        self.set_status("Local LLM unloaded - its memory is free again.")

    def act_llm_clear(self) -> None:
        if not messagebox.askyesno(APP_NAME, "Forget all remembered LLM answers?\n\nThe next run asks the LLM "
                                             "again for every test case (useful after changing the model's "
                                             "settings or after a lot of new training)."):
            return
        with self._judge_lock:
            if self.judge is not None:
                self.judge.cache.clear()
            else:
                LLMCache(self.model.dir / "llm_cache.jsonl").clear()
        self.set_status("LLM memory cleared.")

    def act_llm_models(self) -> None:
        url = self.v_llm_ollama_url.get().strip() or LLMConfig().ollama_url

        def job(progress: ProgressFn) -> List[str]:
            host, port, base = parse_local_url(url, 11434)
            allow_loopback(True)                      # explicit request to talk to Ollama on this PC
            models = _http_json(host, port, "GET", base + "/api/tags", timeout=15).get("models", [])
            return [str(m.get("name") or m.get("model")) for m in models]

        def done(names: List[str]) -> None:
            self._llm_show(["Ollama models on this PC:"] + ["  " + n for n in names] +
                           ([] if names else ["  (none - run:  ollama pull <model>)"]))
            if names and not self.v_llm_ollama_model.get().strip():
                self.v_llm_ollama_model.set(names[0])

        self.run_bg("Asking Ollama for its models", job, done)

    def act_llm_eval(self) -> None:
        cfg = self._llm_cfg_from_ui()
        if not cfg.enabled():
            messagebox.showinfo(APP_NAME, "Choose where the model runs (step 1) first.")
            return
        if not any(ev.get("llm_ctx") for ev in self.model.read_events()):
            messagebox.showinfo(APP_NAME, "No training sessions to compare with yet - train a few changes in the "
                                          "TRAINING window first (sessions saved with this version are used).")
            return
        inp = self.inputs()
        self._cancel_train_llm()

        def job(progress: ProgressFn) -> Dict[str, Any]:
            self._prepare(inp, progress, need_tc=True, need_sbx=False)
            assert self.engine is not None
            return evaluate_llm_on_history(self._get_judge(progress), self.engine, 200, progress, self.cancel_ev)

        def pct(x: Optional[float]) -> str:
            return "-" if x is None else "%d %%" % round(x * 100)

        def done(r: Dict[str, Any]) -> None:
            lines = ["LLM AGAINST YOUR VERDICTS   %s" % now_iso(), "",
                     "Test cases compared: %d   (%d you marked Right, %d Wrong)" % (r["pairs"], r["right"], r["wrong"]),
                     "Confirm level: %d %%" % round(r["threshold"] * 100), "",
                     "  Of the test cases you marked Right, the LLM confirmed : %s   (%d of %d)" % (
                         pct(r["recall"]), r["tp"], r["tp"] + r["fn"]),
                     "  Of the test cases the LLM confirmed, you agreed       : %s   (%d of %d)" % (
                         pct(r["precision"]), r["tp"], r["tp"] + r["fp"]),
                     "  Same decision as you overall                          : %s" % pct(r["accuracy"]), ""]
            if r["misses"]:
                lines.append("Right test cases the LLM did NOT confirm (LLM %):")
                lines += ["  %-16s %3d %%   %s" % (tc, round(p * 100), where[:80]) for tc, p, where in r["misses"]]
            if r["false_alarms"]:
                lines.append("Wrong test cases the LLM confirmed (LLM %):")
                lines += ["  %-16s %3d %%   %s" % (tc, round(p * 100), where[:80]) for tc, p, where in r["false_alarms"]]
            sug = suggest_llm_threshold(self.model)
            if sug is not None:
                lines += ["", "Confirm level that fits your verdicts best: %d %%  (button 'Apply')" % round(sug * 100)]
            self._llm_refresh_suggest()
            self._llm_show(lines)
            self.set_status("LLM agrees with your verdicts in %s of %d cases." % (pct(r["accuracy"]), r["pairs"]))

        self.run_bg("Checking the LLM against your verdicts", job, done)

    # ---- settings ---------------------------------------------------------------------
    def _load_settings(self) -> None:
        s = self.model.load_settings()
        for key, var in (("new", self.v_new), ("old", self.v_old), ("changes", self.v_changes), ("tc", self.v_tc),
                         ("patterns", self.v_patterns), ("exclude", self.v_exclude)):
            if s.get(key):
                var.set(s[key])
        if "ignore_ws" in s:
            self.v_ignore_ws.set(bool(s["ignore_ws"]))
        if "ignore_cmt" in s:
            self.v_ignore_cmt.set(bool(s["ignore_cmt"]))
        self.v_export.set(s.get("export", ""))
        self.v_auto_export.set(bool(s.get("auto_export", True)))
        self.v_use_llm.set(bool(s.get("use_llm", False)) and self.llm_cfg.enabled())
        self.v_train_llm.set(bool(s.get("train_llm", True)))
        self._llm_cfg_to_ui()
        self.v_thr.set(round(self.model.threshold * 100))
        self._on_thr()

    def _save_settings(self) -> None:
        self.model.save_settings({
            "new": self.v_new.get(), "old": self.v_old.get(), "changes": self.v_changes.get(), "tc": self.v_tc.get(),
            "patterns": self.v_patterns.get(), "exclude": self.v_exclude.get(),
            "ignore_ws": bool(self.v_ignore_ws.get()), "ignore_cmt": bool(self.v_ignore_cmt.get()),
            "threshold": self.model.threshold, "export": self.v_export.get(),
            "auto_export": bool(self.v_auto_export.get()), "use_llm": bool(self.v_use_llm.get()),
            "train_llm": bool(self.v_train_llm.get()), "llm": self._llm_cfg_from_ui().to_dict()})

    def _on_close(self) -> None:
        if self.busy and not messagebox.askyesno(APP_NAME, "A task is still running. Close anyway?"):
            return
        self.cancel_ev.set()
        self._cancel_train_llm()
        try:
            self._save_settings()
            self.model.save()
        except Exception:
            pass
        try:
            if self.judge is not None:
                self.judge.close()
        except Exception:
            pass
        self.root.destroy()


