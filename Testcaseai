# ============================================================================
# 11b. LOCAL LLM  (optional second stage: a language model that runs on this PC
#      reads each change and each candidate test case, confirms or rejects the
#      test case and writes the reason)
#
#      Stage 1 - the matcher above picks the candidates out of 3000+ test cases
#                in milliseconds (keywords, identifiers, your training).
#      Stage 2 - the LLM reads the code change and every candidate test case
#                (precondition, procedure, expected result) and answers Yes / No
#                with a probability and a one-sentence reason.
#      Your own training always wins: a test case you confirmed or rejected for
#      a function or line stays confirmed / rejected whatever the LLM says.
#
#      Runtimes (all on this PC - nothing leaves it):
#        llama.cpp  - a GGUF model file loaded inside this program
#                     (pip install llama-cpp-python) - recommended, no server
#        Ollama     - local server on 127.0.0.1
#        OpenAI-compatible local server (LM Studio, llama-server) on 127.0.0.1
# ============================================================================
LLM_PROMPT_VERSION = "llm-v1"
LLM_SPLIT = "\u0001STCM-SPLIT\u0001"   # marks the end of the prompt part shared by all test cases of a change
LLM_FLOOR = 0.04                      # lowest matcher confidence that is still handed to the LLM
LLM_BACKENDS = [
    ("off", "Off - matcher only"),
    ("llamacpp", "llama.cpp - GGUF file, inside this program (recommended)"),
    ("ollama", "Ollama - local server (uses a port on 127.0.0.1)"),
    ("openai", "LM Studio / llama-server (local server, uses a port on 127.0.0.1)"),
]


class LLMError(RuntimeError):
    """A problem with the local LLM that the user can fix (shown without a traceback)."""


class LLMContextError(LLMError):
    def __init__(self, n_tokens: int, n_ctx: int):
        super().__init__("The prompt has %d tokens but the model context is only %d - increase 'Context' in the "
                         "LOCAL LLM window." % (n_tokens, n_ctx))
        self.n_tokens, self.n_ctx = n_tokens, n_ctx


class LLMHTTPError(LLMError):
    def __init__(self, status: int, body: str):
        super().__init__("The local LLM server answered HTTP %d: %s" % (status, body[:300]))
        self.status, self.body = status, body


@dataclass
class LLMConfig:
    backend: str = "off"
    gguf: str = ""
    threads: int = 0                        # 0 = automatic
    gpu_layers: int = 0                     # 0 = CPU only, 99 = everything on the GPU (needs a GPU build)
    n_ctx: int = 4096
    ollama_url: str = "http://127.0.0.1:11434"
    ollama_model: str = ""
    server_url: str = "http://127.0.0.1:1234/v1"
    server_model: str = ""
    candidates: int = 100                   # test cases per changed function checked by the LLM
    confirm: float = 0.50                   # LLM probability needed to confirm a test case
    reasons: bool = True                    # write a reason for every confirmed test case
    explain: bool = True                    # let the LLM describe the change first (better recall)
    examples: bool = True                   # show the LLM your earlier decisions for similar changes

    @classmethod
    def from_dict(cls, d: Optional[Dict[str, Any]]) -> "LLMConfig":
        cfg = cls()
        for f in dc_fields(cls):
            if d and f.name in d and d[f.name] is not None:
                default = getattr(cfg, f.name)
                try:
                    if isinstance(default, bool):
                        val: Any = bool(d[f.name])
                    elif isinstance(default, int):
                        val = int(d[f.name])
                    elif isinstance(default, float):
                        val = float(d[f.name])
                    else:
                        val = str(d[f.name])
                except (TypeError, ValueError):
                    continue
                setattr(cfg, f.name, val)
        if cfg.backend not in [b for b, _ in LLM_BACKENDS]:
            cfg.backend = "off"
        cfg.candidates = max(1, cfg.candidates)
        cfg.confirm = max(0.01, min(0.99, cfg.confirm))
        cfg.n_ctx = max(1024, cfg.n_ctx)
        return cfg

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)

    def copy(self) -> "LLMConfig":
        return LLMConfig.from_dict(self.to_dict())

    def enabled(self) -> bool:
        return self.backend in ("llamacpp", "ollama", "openai")

    def load_signature(self) -> Tuple[Any, ...]:
        """Settings that need the model to be loaded again when they change."""
        if self.backend == "llamacpp":
            return (self.backend, os.path.abspath(self.gguf) if self.gguf else "", self.threads, self.gpu_layers,
                    self.n_ctx)
        if self.backend == "ollama":
            return (self.backend, self.ollama_url, self.ollama_model, self.n_ctx)
        return (self.backend, self.server_url, self.server_model)

    def describe(self) -> str:
        if self.backend == "llamacpp":
            return "llama.cpp: %s" % (os.path.basename(self.gguf) or "(no model file)")
        if self.backend == "ollama":
            return "Ollama: %s" % (self.ollama_model or "(no model)")
        if self.backend == "openai":
            return "local server: %s" % (self.server_model or self.server_url)
        return "off"


# ---- talking to a local server (127.0.0.1 only) -------------------------------------
_RE_LOCAL_URL = re.compile(r"^\s*http://(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.\-]+)(?::(\d{1,5}))?(/[^\s?#]*)?\s*$")


def parse_local_url(url: str, default_port: int) -> Tuple[str, int, str]:
    """'http://127.0.0.1:11434/x' -> ('127.0.0.1', 11434, '/x').  Only addresses of this PC are accepted."""
    m = _RE_LOCAL_URL.match(url or "")
    if not m:
        raise LLMError("'%s' is not a local address. Use e.g. http://127.0.0.1:11434 - https and other computers "
                       "are not allowed (offline by design)." % url)
    host = m.group(1).strip("[]")
    if not _is_loopback(host):
        raise LLMError("Only this PC is allowed (localhost / 127.0.0.1) - '%s' is another computer." % host)
    return host, int(m.group(2) or default_port), (m.group(3) or "").rstrip("/")


def _http_json(host: str, port: int, method: str, path: str, payload: Any = None, timeout: float = 900.0) -> Any:
    import http.client
    if not _is_loopback(host):                      # second line of defence after parse_local_url
        raise LLMError(_OFFLINE_MSG)
    body = json.dumps(payload).encode("utf-8") if payload is not None else None
    headers = {"Content-Type": "application/json", "Accept": "application/json"} if body is not None else {}
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        try:
            conn.request(method, path or "/", body=body, headers=headers)
            resp = conn.getresponse()
            raw = resp.read()
        except ConnectionRefusedError as exc:
            raise LLMError("Nothing answers at http://%s:%d - is the local LLM server (Ollama / LM Studio) "
                           "running?" % (host, port)) from exc
        except OSError as exc:
            raise LLMError("Local LLM server at http://%s:%d: %s" % (host, port, exc)) from exc
        text = raw.decode("utf-8", "replace")
        if resp.status >= 400:
            raise LLMHTTPError(resp.status, text)
        try:
            return json.loads(text) if text.strip() else {}
        except ValueError as exc:
            raise LLMError("The local LLM server sent an answer that is not JSON: %s" % text[:200]) from exc
    finally:
        conn.close()


def _strip_split(messages: Sequence[Dict[str, str]]) -> List[Dict[str, str]]:
    return [{"role": m["role"], "content": m["content"].replace(LLM_SPLIT, "")} for m in messages]


def _p_from_logprobs(lp: Any) -> Optional[float]:
    """P(Yes) / (P(Yes) + P(No)) from the token probabilities of the first answer token
    (OpenAI and Ollama formats).  None when the server sent none or the model wants to
    answer with something else (for example a thinking block)."""
    if isinstance(lp, dict):
        lp = lp.get("content")
    if not isinstance(lp, list) or not lp or not isinstance(lp[0], dict):
        return None
    tops = lp[0].get("top_logprobs") or [lp[0]]
    py = pn = 0.0
    for t in tops:
        if not isinstance(t, dict) or t.get("logprob") is None:
            continue
        tok = str(t.get("token", "")).strip().strip("*\"'`").lower()
        try:
            pr = math.exp(float(t["logprob"]))
        except (TypeError, ValueError, OverflowError):
            continue
        if tok.startswith("yes"):
            py += pr
        elif tok in ("no", "not", "none") or tok.startswith("no "):
            pn += pr
    if py + pn < 0.05:
        return None
    return py / (py + pn)


_RE_THINK_BLOCK = re.compile(r"<think>.*?</think>", re.S | re.I)
_RE_ANSWER = re.compile(r"(?is)^[\s*#>_`\"'\-:]*(yes|no|true|false|not relevant|irrelevant|relevant)\b(.*)$")


def _strip_thinking(text: str) -> str:
    t = _RE_THINK_BLOCK.sub("", text or "")
    if "</think>" in t:
        t = t.split("</think>", 1)[1]
    if "<think>" in t:                               # unfinished thinking: nothing usable after it
        t = t.split("<think>", 1)[0]
    return t.strip()


def parse_answer(text: str) -> Tuple[Optional[bool], str]:
    """'Yes - the change alters ...' -> (True, 'the change alters ...').  (None, text) when unclear."""
    t = _strip_thinking(text)
    m = _RE_ANSWER.match(t)
    if not m:
        m2 = re.search(r"(?i)\b(yes|no)\b", t[:160])
        if not m2:
            return None, " ".join(t.split())[:300]
        word, rest = m2.group(1), t[m2.end():]
    else:
        word, rest = m.group(1), m.group(2)
    verdict = word.lower() in ("yes", "true", "relevant")
    rest = rest.strip().lstrip("*.,:;-\u2013\u2014|) ").strip()
    rest = rest.split("\n\n")[0]
    reason = " ".join(rest.split()).strip(" *\"'")
    return verdict, reason[:300]


@dataclass
class ChangeInsight:
    summary: str
    keywords: List[str]


def parse_insight(text: str) -> ChangeInsight:
    t = _strip_thinking(text)
    sm = re.search(r"(?im)^[\s*#\-]*summary[\s*]*[:\-]\s*(.+)$", t)
    km = re.search(r"(?im)^[\s*#\-]*key\s*words?[\s*]*[:\-]\s*(.+)$", t)
    summary = sm.group(1).strip(" *") if sm else ""
    kw_line = km.group(1) if km else ""
    if not sm and not km:
        summary = " ".join(t.split())[:400]
    kws: List[str] = []
    for k in re.split(r"[,;]", kw_line):
        k = k.strip(" .*`\"'[]()")
        if 2 <= len(k) <= 50 and k.lower() not in (x.lower() for x in kws):
            kws.append(k)
    return ChangeInsight(" ".join(summary.split())[:500], kws[:16])


# ---- chat templates ----------------------------------------------------------------
def _merge_system(messages: Sequence[Dict[str, str]]) -> List[Dict[str, str]]:
    """For templates without a system role: put the system text in front of the first user message."""
    sys_txt = "\n\n".join(m["content"] for m in messages if m["role"] == "system")
    out = [dict(m) for m in messages if m["role"] != "system"]
    if sys_txt and out:
        out[0]["content"] = sys_txt + "\n\n" + out[0]["content"]
    return out


_TEMPLATE_CACHE: Dict[str, Any] = {}


def _render_jinja(template: str, messages: Sequence[Dict[str, str]], bos: str, eos: str) -> str:
    """Render the model's own chat template (stored in the GGUF file), thinking switched off."""
    tpl = _TEMPLATE_CACHE.get(template)
    if tpl is None:
        import jinja2
        from jinja2.sandbox import ImmutableSandboxedEnvironment

        def raise_exception(message: str) -> None:
            raise jinja2.TemplateError(message)

        env = ImmutableSandboxedEnvironment(trim_blocks=True, lstrip_blocks=True,
                                            extensions=["jinja2.ext.loopcontrols"])
        env.globals["raise_exception"] = raise_exception
        env.globals["strftime_now"] = lambda fmt: _dt.datetime.now().strftime(fmt)
        env.filters["tojson"] = lambda x, indent=None, ensure_ascii=False, sort_keys=False: json.dumps(
            x, indent=indent, ensure_ascii=ensure_ascii, sort_keys=sort_keys)
        tpl = _TEMPLATE_CACHE[template] = env.from_string(template)
    return tpl.render(messages=list(messages), add_generation_prompt=True, bos_token=bos, eos_token=eos,
                      enable_thinking=False, tools=None, documents=None, reasoning_effort="low")


_BUILTIN_TEMPLATES = {
    "chatml": ("<|im_start|>system\n{s}<|im_end|>\n", "<|im_start|>user\n{u}<|im_end|>\n<|im_start|>assistant\n"),
    "llama3": ("<|start_header_id|>system<|end_header_id|>\n\n{s}<|eot_id|>",
               "<|start_header_id|>user<|end_header_id|>\n\n{u}<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n"),
    "gemma": ("", "<start_of_turn>user\n{u}<end_of_turn>\n<start_of_turn>model\n"),
    "phi": ("<|system|>\n{s}<|end|>\n", "<|user|>\n{u}<|end|>\n<|assistant|>\n"),
    "mistral": ("", "[INST] {u} [/INST]"),
    "plain": ("{s}\n\n", "### Question\n{u}\n\n### Answer\n"),
}
_FAMILY_MARKERS = [("chatml", "<|im_start|>"), ("llama3", "<|start_header_id|>"), ("gemma", "<start_of_turn>"),
                   ("phi", "<|user|>"), ("mistral", "[INST]")]


def _render_builtin(family: str, messages: Sequence[Dict[str, str]]) -> str:
    sys_tpl, user_tpl = _BUILTIN_TEMPLATES.get(family, _BUILTIN_TEMPLATES["plain"])
    msgs = list(messages) if sys_tpl else _merge_system(messages)
    out = []
    for m in msgs:
        if m["role"] == "system":
            out.append(sys_tpl.format(s=m["content"]))
        elif m["role"] == "user":
            out.append(user_tpl.format(u=m["content"]))
    return "".join(out)


# ---- runtimes -------------------------------------------------------------------------
class LLMBackend:
    """Interface of a local LLM runtime."""
    kind = ""
    name = ""                 # shown to the user
    model_id = ""             # part of every cache key (a different model never reuses old answers)
    n_ctx = 4096
    supports_prob = True      # can it give P(Yes)?  (False -> the answer text is parsed)

    def yes_prob(self, messages: Sequence[Dict[str, str]]) -> Optional[float]:
        return None

    def generate(self, messages: Sequence[Dict[str, str]], max_tokens: int = 80, stop: Sequence[str] = ("\n\n",),
                 prefix: str = "") -> str:
        raise NotImplementedError

    def info(self) -> str:
        return self.name

    def close(self) -> None:
        pass


class LlamaCppBackend(LLMBackend):
    """GGUF model loaded in this process with llama-cpp-python - no server, no network."""
    kind = "llamacpp"

    def __init__(self, cfg: LLMConfig, progress: ProgressFn = None):
        path = (cfg.gguf or "").strip().strip('"')
        if not path:
            raise LLMError("Select the GGUF model file in the LOCAL LLM window.")
        if not os.path.isfile(path):
            raise LLMError("GGUF model file not found:\n%s" % path)
        try:
            import numpy as np
            import llama_cpp
        except ImportError as exc:
            raise LLMError("The Python package 'llama-cpp-python' is not installed.\n\n"
                           "Install it once:   pip install llama-cpp-python\n"
                           "(the LOCAL LLM window explains the prebuilt / offline way).") from exc
        self.np, self.lc = np, llama_cpp
        cpu = os.cpu_count() or 2
        threads = cfg.threads if cfg.threads > 0 else max(1, cpu // 2)
        size = os.path.getsize(path)
        _progress(progress, "Loading the LLM model file %s (%.1f GB) ..." % (os.path.basename(path), size / 1e9))
        t0 = time.time()
        try:
            self.llm = llama_cpp.Llama(model_path=path, n_ctx=int(cfg.n_ctx), n_threads=threads,
                                       n_threads_batch=threads, n_gpu_layers=int(cfg.gpu_layers), n_batch=512,
                                       seed=0, logits_all=False, verbose=False)
        except Exception as exc:
            raise LLMError("The model could not be loaded:\n%s\n\nCommon reasons: not enough free RAM, a damaged "
                           "download, or a model architecture this llama-cpp-python version does not know yet "
                           "(update llama-cpp-python or choose another model)." % exc) from exc
        self.load_seconds = time.time() - t0
        llm = self.llm
        self.file, self.threads, self.gpu_layers = path, threads, int(cfg.gpu_layers)
        self.n_ctx = int(llm.n_ctx())
        self.n_vocab = int(llm.n_vocab())
        self.meta = dict(getattr(llm, "metadata", {}) or {})
        self.template = self.meta.get("tokenizer.chat_template", "") or ""
        self.arch = self.meta.get("general.architecture", "")
        self.name = self.meta.get("general.name") or os.path.splitext(os.path.basename(path))[0]
        self.model_id = "gguf:%s:%d" % (os.path.basename(path).lower(), size)
        # hybrid / recurrent models (Mamba, gated delta nets ...) cannot cut their memory back:
        # the shared prompt part is saved once and restored for every test case instead
        self.recurrent = bool(getattr(llm, "_is_recurrent", False) or getattr(llm, "_is_hybrid", False))
        self.bos_text = self._tok_text(llm.token_bos())
        self.eos_text = self._tok_text(llm.token_eos())
        try:
            self._vocab = llama_cpp.llama_model_get_vocab(llm._model.model)
        except Exception:
            self._vocab = None
        self.thinking_template = "<think>" in self.template
        self.force_nothink = False
        self.n_evaluated = 0
        self._pstate: Any = None
        self._pstate_key: Any = None
        self.family = self._detect_family()
        self.yes_ids, self.no_ids = self._answer_ids()
        self.supports_prob = bool(self.yes_ids and self.no_ids)

    # -- helpers --
    def _tok_text(self, tok: Optional[int]) -> str:
        if tok is None or tok < 0:
            return ""
        try:
            return self.llm.detokenize([tok], special=True).decode("utf-8", "replace")
        except TypeError:
            return self.llm.detokenize([tok]).decode("utf-8", "replace")
        except Exception:
            return ""

    def _detok(self, toks: Sequence[int]) -> str:
        try:
            return self.llm.detokenize(list(toks)).decode("utf-8", "replace")
        except Exception:
            return ""

    def _tokenize(self, text: str, add_bos: bool) -> List[int]:
        return list(self.llm.tokenize(text.encode("utf-8"), add_bos=add_bos, special=True))

    def _detect_family(self) -> str:
        for fam, marker in _FAMILY_MARKERS:
            if marker in self.template:
                return fam
        for fam, marker in _FAMILY_MARKERS:
            try:
                if len(self._tokenize(marker, False)) == 1:
                    return fam
            except Exception:
                continue
        return "plain"

    def _answer_ids(self) -> Tuple[List[int], List[int]]:
        def first_ids(words: Sequence[str]) -> Set[int]:
            out: Set[int] = set()
            for w in words:
                try:
                    toks = self.llm.tokenize(w.encode("utf-8"), add_bos=False, special=False)
                except Exception:
                    continue
                if toks:
                    out.add(int(toks[0]))
            return out
        def after_newline(words: Sequence[str]) -> Set[int]:
            """The token a word gets at the start of an answer line (tokenizers that add a space prefix)."""
            out: Set[int] = set()
            try:
                nl = self.llm.tokenize(b"\n", add_bos=False, special=False)
            except Exception:
                return out
            for w in words:
                try:
                    toks = self.llm.tokenize(("\n" + w).encode("utf-8"), add_bos=False, special=False)
                except Exception:
                    continue
                if len(toks) > len(nl) and list(toks[:len(nl)]) == list(nl):
                    out.add(int(toks[len(nl)]))
            return out

        yes = first_ids(["Yes", " Yes", "yes", " yes", "YES", "**Yes"]) | after_newline(["Yes", "yes"])
        no = first_ids(["No", " No", "no", " no", "NO", "**No"]) | after_newline(["No", "no"])
        both = yes & no
        return sorted(yes - both), sorted(no - both)

    def _is_eog(self, tok: int) -> bool:
        if self._vocab is not None:
            try:
                return bool(self.lc.llama_vocab_is_eog(self._vocab, tok))
            except Exception:
                pass
        return tok == self.llm.token_eos()

    def render(self, messages: Sequence[Dict[str, str]]) -> str:
        text: Optional[str] = None
        if self.template:
            for msgs in (list(messages), _merge_system(messages)):
                try:
                    text = _render_jinja(self.template, msgs, self.bos_text, self.eos_text)
                    break
                except Exception:
                    text = None
        if text is None:
            text = _render_builtin(self.family, messages)
        if self.bos_text and text.startswith(self.bos_text):
            text = text[len(self.bos_text):]        # llama.cpp adds BOS itself when the model wants one
        if self.force_nothink and not text.rstrip().endswith("</think>"):
            text += "<think>\n\n</think>\n\n"
        return text

    def _tokens(self, messages: Sequence[Dict[str, str]], prefix: str = "") -> Tuple[List[int], int]:
        """Prompt tokens and the length of the part shared by all test cases of a change."""
        text = self.render(messages) + prefix
        if LLM_SPLIT in text:
            pre, post = text.split(LLM_SPLIT, 1)
            post = post.replace(LLM_SPLIT, "")
        else:
            pre, post = "", text
        tp = self._tokenize(pre, True) if pre else []
        ts = self._tokenize(post, not tp)
        toks = tp + ts
        if len(toks) > self.n_ctx - 80:
            raise LLMContextError(len(toks), self.n_ctx)
        return toks, len(tp)

    # -- evaluation with reuse of the shared prompt part --
    def _eval(self, toks: List[int], prefix_len: int) -> None:
        llm = self.llm
        if self.recurrent:
            self._eval_restore(toks, prefix_len)
            return
        n_old = int(llm.n_tokens)
        lim = min(n_old, len(toks) - 1)               # always evaluate at least one token (fresh logits)
        common = 0
        if lim > 0:
            old = llm.input_ids[:lim]
            new = self.np.asarray(toks[:lim], dtype=old.dtype)
            diff = self.np.nonzero(old != new)[0]
            common = int(diff[0]) if len(diff) else lim
        if common < n_old:
            ok = False
            if common > 0:
                try:
                    ok = bool(llm._ctx.kv_cache_seq_rm(-1, common, -1))
                except Exception:
                    ok = False
            if not ok:
                if common > 0:                        # memory cannot be cut back: use saved states from now on
                    self.recurrent = True
                    self._eval_restore(toks, prefix_len)
                    return
                llm.reset()
        llm.n_tokens = common
        llm.eval(toks[common:])
        self.n_evaluated += len(toks) - common

    def _eval_restore(self, toks: List[int], prefix_len: int) -> None:
        import ctypes
        llm, lc = self.llm, self.lc
        ctx = llm._ctx.ctx
        key = hash(tuple(toks[:prefix_len])) if 0 < prefix_len < len(toks) else None
        if key is not None and key == self._pstate_key and self._pstate is not None:
            llm.reset()
            buf = self._pstate
            if int(lc.llama_state_seq_set_data(ctx, buf, len(buf), 0)) > 0:
                llm.n_tokens = prefix_len
                llm.input_ids[:prefix_len] = toks[:prefix_len]
                llm.eval(toks[prefix_len:])
                self.n_evaluated += len(toks) - prefix_len
                return
            self._pstate = self._pstate_key = None
        llm.reset()
        if key is not None:
            llm.eval(toks[:prefix_len])
            size = int(lc.llama_state_seq_get_size(ctx, 0))
            buf = (ctypes.c_uint8 * size)()
            got = int(lc.llama_state_seq_get_data(ctx, buf, size, 0))
            self._pstate, self._pstate_key = (buf, key) if got > 0 else (None, None)
            llm.eval(toks[prefix_len:])
        else:
            llm.eval(toks)
        self.n_evaluated += len(toks)

    def _last_logits(self) -> Any:
        ctx = self.llm._ctx.ctx
        try:
            ptr = self.lc.llama_get_logits_ith(ctx, -1)
        except Exception:
            ptr = self.lc.llama_get_logits(ctx)
        return self.np.ctypeslib.as_array(ptr, shape=(self.n_vocab,))

    # -- public --
    def yes_prob(self, messages: Sequence[Dict[str, str]]) -> Optional[float]:
        if not self.supports_prob:
            return None
        toks, plen = self._tokens(messages)
        self._eval(toks, plen)
        lg = self._last_logits().astype(self.np.float64)
        top = int(lg.argmax())
        p = self.np.exp(lg - lg[top])
        p /= p.sum()
        py, pn = float(p[self.yes_ids].sum()), float(p[self.no_ids].sum())
        if py + pn < 0.10:
            if not self.force_nothink and ("think" in self._tok_text(top).lower() or self.thinking_template):
                self.force_nothink = True             # a thinking model: answer directly instead
                return self.yes_prob(messages)
            return None
        return py / (py + pn)

    def generate(self, messages: Sequence[Dict[str, str]], max_tokens: int = 80, stop: Sequence[str] = ("\n\n",),
                 prefix: str = "") -> str:
        toks, plen = self._tokens(messages, prefix)
        self._eval(toks, plen)
        out: List[int] = []
        text = ""
        for _ in range(max_tokens):
            tok = int(self._last_logits().argmax())   # greedy = repeatable answers
            if self._is_eog(tok):
                break
            out.append(tok)
            text = self._detok(out)
            if any(s and s in text for s in stop):
                break
            self.llm.eval([tok])
            self.n_evaluated += 1
        for s in stop:
            if s:
                text = text.split(s)[0]
        return text

    def info(self) -> str:
        return "%s  |  %s  |  context %d tokens  |  %s  |  %s  |  %s" % (
            self.name, self.arch or "?", self.n_ctx,
            "GPU layers %d" % self.gpu_layers if self.gpu_layers else "CPU, %d threads" % self.threads,
            "shared prompt part: saved state (hybrid model)" if self.recurrent else "shared prompt part: reused",
            "answers: probability" if self.supports_prob else "answers: text")

    def close(self) -> None:
        llm = getattr(self, "llm", None)
        self.llm = None
        self._pstate = None
        if llm is not None:
            try:
                llm.close()
            except Exception:
                pass


class OllamaBackend(LLMBackend):
    """Ollama running on this PC (http://127.0.0.1:11434)."""
    kind = "ollama"

    def __init__(self, cfg: LLMConfig, progress: ProgressFn = None):
        self.host, self.port, self.base = parse_local_url(cfg.ollama_url, 11434)
        allow_loopback(True)                          # the user chose a server on this PC: 127.0.0.1 only
        self.n_ctx = int(cfg.n_ctx)
        want = (cfg.ollama_model or "").strip()
        _progress(progress, "Connecting to Ollama on this PC ...")
        models = self.list_models()
        names = [str(m.get("name") or m.get("model") or "") for m in models]
        if not want:
            raise LLMError("Enter the Ollama model name in the LOCAL LLM window. Installed: %s"
                           % (", ".join(names) or "(none - run: ollama pull <model>)"))
        match = want if want in names else next((n for n in names if n.split(":")[0] == want
                                                 or n == want + ":latest"), None)
        if match is None:
            raise LLMError("Ollama has no model '%s'. Installed: %s" % (want, ", ".join(names) or "(none)"))
        digest = next((str(m.get("digest", "")) for m in models if (m.get("name") or m.get("model")) == match), "")
        self.model = match
        self.model_id = "ollama:%s:%s" % (match, digest[:12])
        self.name = "Ollama: %s" % match
        self._think_param = True

    def list_models(self) -> List[Dict[str, Any]]:
        return list(_http_json(self.host, self.port, "GET", self.base + "/api/tags", timeout=15).get("models", []))

    def _chat(self, messages: Sequence[Dict[str, str]], max_tokens: int, logprobs: bool = False) -> Dict[str, Any]:
        payload: Dict[str, Any] = {
            "model": self.model, "messages": _strip_split(messages), "stream": False, "keep_alive": "30m",
            "options": {"temperature": 0, "num_predict": int(max_tokens), "num_ctx": self.n_ctx, "seed": 0}}
        if self._think_param:
            payload["think"] = False
        if logprobs:
            payload["logprobs"] = True
            payload["top_logprobs"] = 20
        try:
            return _http_json(self.host, self.port, "POST", self.base + "/api/chat", payload)
        except LLMHTTPError as exc:
            if self._think_param and "think" in exc.body.lower():
                self._think_param = False             # older Ollama / model without a thinking switch
                return self._chat(messages, max_tokens, logprobs)
            raise

    def yes_prob(self, messages: Sequence[Dict[str, str]]) -> Optional[float]:
        if not self.supports_prob:
            return None
        resp = self._chat(messages, 1, logprobs=True)
        p = _p_from_logprobs(resp.get("logprobs"))
        if p is None:
            self.supports_prob = False                # this Ollama gives no token probabilities: use the text
        return p

    def generate(self, messages: Sequence[Dict[str, str]], max_tokens: int = 80, stop: Sequence[str] = ("\n\n",),
                 prefix: str = "") -> str:
        resp = self._chat(messages, max_tokens)
        return str((resp.get("message") or {}).get("content", "") or "")


class OpenAICompatBackend(LLMBackend):
    """OpenAI-compatible server on this PC: LM Studio (port 1234), llama-server (8080), Jan ..."""
    kind = "openai"

    def __init__(self, cfg: LLMConfig, progress: ProgressFn = None):
        self.host, self.port, self.base = parse_local_url(cfg.server_url, 1234)
        allow_loopback(True)                          # the user chose a server on this PC: 127.0.0.1 only
        _progress(progress, "Connecting to the local LLM server ...")
        data = _http_json(self.host, self.port, "GET", self.base + "/models", timeout=15)
        ids = [str(m.get("id", "")) for m in data.get("data", []) if isinstance(m, dict)]
        self.model = (cfg.server_model or "").strip() or (ids[0] if ids else "")
        if not self.model:
            raise LLMError("The local server reports no model - load a model in LM Studio / llama-server first.")
        self.model_id = "openai:%s:%d:%s" % (self.host, self.port, self.model)
        self.name = "Local server: %s" % self.model

    def _chat(self, messages: Sequence[Dict[str, str]], max_tokens: int, logprobs: bool = False) -> Dict[str, Any]:
        payload: Dict[str, Any] = {"model": self.model, "messages": _strip_split(messages), "temperature": 0,
                                   "max_tokens": int(max_tokens), "seed": 0, "stream": False}
        if logprobs:
            payload.update({"logprobs": True, "top_logprobs": 20})
        return _http_json(self.host, self.port, "POST", self.base + "/chat/completions", payload)

    def yes_prob(self, messages: Sequence[Dict[str, str]]) -> Optional[float]:
        if not self.supports_prob:
            return None
        try:
            resp = self._chat(messages, 1, logprobs=True)
        except LLMHTTPError:
            self.supports_prob = False
            return None
        choice = (resp.get("choices") or [{}])[0]
        p = _p_from_logprobs(choice.get("logprobs"))
        if p is None:
            self.supports_prob = False
        return p

    def generate(self, messages: Sequence[Dict[str, str]], max_tokens: int = 80, stop: Sequence[str] = ("\n\n",),
                 prefix: str = "") -> str:
        resp = self._chat(messages, max_tokens)
        choice = (resp.get("choices") or [{}])[0]
        return str((choice.get("message") or {}).get("content", "") or "")


def make_backend(cfg: LLMConfig, progress: ProgressFn = None) -> LLMBackend:
    if cfg.backend not in ("ollama", "openai"):
        allow_loopback(False)                         # llama.cpp runs inside this program: no socket at all
    if cfg.backend == "llamacpp":
        return LlamaCppBackend(cfg, progress)
    if cfg.backend == "ollama":
        return OllamaBackend(cfg, progress)
    if cfg.backend == "openai":
        return OpenAICompatBackend(cfg, progress)
    raise LLMError("The local LLM is switched off - choose where it runs in the LOCAL LLM window.")


# ---- memory of LLM answers ---------------------------------------------------------------
class LLMCache:
    """Every LLM answer is kept in llm_cache.jsonl in the model folder: a change that was
    checked once is never sent to the model again (re-runs are instant, an interrupted
    run continues where it stopped)."""

    def __init__(self, path: Path):
        self.path = Path(path)
        self.data: Dict[str, Dict[str, Any]] = {}
        self._lock = threading.Lock()
        lines = 0
        if self.path.is_file():
            with open(self.path, "r", encoding="utf-8") as fh:
                for line in fh:
                    try:
                        rec = json.loads(line)
                        self.data[rec.pop("k")] = rec
                        lines += 1
                    except (ValueError, KeyError, AttributeError):
                        continue
        if lines > 2 * len(self.data) + 2000:
            self.compact()

    def __len__(self) -> int:
        return len(self.data)

    def get(self, key: str) -> Optional[Dict[str, Any]]:
        return self.data.get(key)

    def put(self, key: str, value: Dict[str, Any]) -> None:
        with self._lock:
            self.data[key] = value
            try:
                self.path.parent.mkdir(parents=True, exist_ok=True)
                with open(self.path, "a", encoding="utf-8", newline="\n") as fh:
                    rec = dict(value)
                    rec["k"] = key
                    fh.write(json.dumps(rec, separators=(",", ":")) + "\n")
            except OSError:
                pass

    def compact(self) -> None:
        with self._lock:
            atomic_write_text(self.path, "".join(json.dumps(dict(v, k=k), separators=(",", ":")) + "\n"
                                                 for k, v in self.data.items()))

    def clear(self) -> None:
        with self._lock:
            self.data.clear()
            try:
                self.path.unlink()
            except OSError:
                pass


@dataclass
class LLMVerdict:
    p: float                 # probability that the test case must be run (0..1)
    reason: str = ""
    mode: str = ""           # 'prob' = from token probabilities, 'text' = parsed from the answer
    cached: bool = False


_KIND_WORD = {"C": "C source file", "H": "C header file", "USER": "configuration / user file"}


def llm_change_text(engine: Optional[Engine], changes: Sequence[Change], context: Sequence[str] = (),
                    limit: int = 3800) -> str:
    """The change as the LLM sees it: file, function (+ its comment and callers), the
    changed lines (- old / + new) and the most useful sandbox analysis notes."""
    first = changes[0]
    sbx = engine.sbx if engine is not None else None
    lines = ["CODE CHANGE", "File: %s   (%s, %s)" % (first.file, _KIND_WORD.get(first.kind, first.kind),
                                                    first.status.lower())]
    names = list(dict.fromkeys(n for ch in changes for n in ch.functions))
    for name in names[:3]:
        f = sbx.find_func(name, first.file) if sbx is not None else None
        if f is None:
            lines.append("Function: %s()" % name)
            continue
        lines.append("Function: %s()   (lines %d-%d)" % (name, f.start, f.end))
        if f.doc:
            lines.append("  Comment above it: %s" % f.doc[:280])
        callers = sbx.callers_of(name, 2, 6) if sbx is not None else []
        lv1 = [c.name + "()" for lv, c in callers if lv == 1][:4]
        lv2 = [c.name + "()" for lv, c in callers if lv == 2][:3]
        if lv1:
            lines.append("  Called by: %s%s" % (", ".join(lv1), ("   <-   " + ", ".join(lv2)) if lv2 else ""))
    if not names:
        lines.append("Location: outside any function (macros, types, global data or configuration values)")
    notes = [c for c in context if c and not c.startswith(("LLM:", "Comment-only", "Note: comment"))][:4]
    budget = limit - sum(len(x) + 1 for x in lines) - sum(min(len(n), 300) + 3 for n in notes) - 60
    code: List[str] = []
    for ch in changes[:8]:
        rng = ch.new_lines or (("old " + ch.old_lines) if ch.old_lines else "")
        code.append("Changed lines %s:" % rng if rng else "Changed lines:")
        code += ["- " + ln.rstrip() for ln in ch.old_code.split("\n")] if ch.old_code else []
        code += ["+ " + ln.rstrip() for ln in ch.new_code.split("\n")] if ch.new_code else []
        if not ch.old_code and not ch.new_code:
            code.append("  (%s)" % (ch.note or "content not available"))
    used = 0
    for ln in code:
        ln = ln[:220]
        if used + len(ln) + 1 > budget:
            lines.append("  ... (more changed lines not shown)")
            break
        lines.append(ln)
        used += len(ln) + 1
    if notes:
        lines.append("Sandbox analysis:")
        lines += ["  " + n[:300] for n in notes]
    return "\n".join(lines)


def llm_input_text(engine: Optional[Engine], text: str, q: Optional[Query] = None, limit: int = 3800) -> str:
    """A code line / function name typed in the TRAINING window, as the LLM sees it."""
    lines = ["CODE CHANGE  (code given by the test engineer: this code was changed)"]
    if q is not None:
        lines += ["  " + c[:300] for c in q.context[:4]]
    lines.append("Changed lines:")
    used = sum(len(x) + 1 for x in lines)
    for ln in text.strip("\n").split("\n"):
        ln = "+ " + ln.rstrip()[:220]
        if used + len(ln) + 1 > limit:
            lines.append("  ... (cut)")
            break
        lines.append(ln)
        used += len(ln) + 1
    return "\n".join(lines)


def llm_tc_text(tc: TestCase, limit: int = 1800) -> str:
    parts = ["TEST CASE %s" % tc.tc_id]
    if tc.pre or tc.exp or tc.title:
        if tc.title:
            parts.append(" ".join(tc.title.split()))
        for name, body in (("Precondition", tc.pre), ("Procedure", tc.proc), ("Expected result", tc.exp)):
            if body:
                parts.append("%s: %s" % (name, " ".join(body.split())))
    else:
        parts.append(" ".join(tc.text.split()))
    text = "\n".join(parts)
    return text if len(text) <= limit else text[:limit - 12] + " ... (cut)"


def examples_block(engine: Engine, q: Query, max_examples: int = 2, per_side: int = 3) -> str:
    """Your earlier decisions for the most similar changes - the LLM follows your logic."""
    model = engine.model
    if not model.examples:
        return ""
    inv = model.ex_inv()
    sims: Dict[int, float] = {}
    for t, w in engine._qvec(q).items():
        for ei, ew in inv.get(t, ()):
            sims[ei] = sims.get(ei, 0.0) + w * ew
    top = sorted(((s, ei) for ei, s in sims.items() if s >= 0.30), reverse=True)[:max_examples]
    lines: List[str] = []
    for _s, ei in top:
        ex = model.examples[ei]
        items: List[str] = []
        for k, _st in sorted(ex["right"].items(), key=lambda kv: -kv[1])[:per_side]:
            d = engine._resolve(k)
            if d is not None:
                tc = engine.store.cases[d]
                items.append("  RELEVANT: %s %s" % (tc.tc_id, tc.headline(90)))
        for k in ex["wrong"][:per_side]:
            d = engine._resolve(k)
            if d is not None:
                tc = engine.store.cases[d]
                items.append("  NOT RELEVANT: %s %s" % (tc.tc_id, tc.headline(90)))
        if items:
            lines.append("Similar change: %s" % ex.get("label", "")[:140])
            lines += items
    if not lines:
        return ""
    return "Decisions of the test engineer for similar changes (follow the same logic):\n" + "\n".join(lines)


class LLMJudge:
    """Asks the local LLM, remembers every answer, measures the speed."""
    SYSTEM = ("You are a senior automotive ECU software test engineer doing regression test selection. "
              "For a source code change you decide whether a test case must be run again. Answer Yes when the change "
              "can alter any behaviour, value, threshold, timing, state, fault reaction, diagnostic response or "
              "interface that the test case stimulates or checks - directly or through the functions, macros and "
              "configuration it depends on. Answer No when the test case is about a different function or feature, "
              "or when the change cannot influence what the test case checks.")
    QUESTION = ("Question: must this test case be run again because of the code change above? "
                "Answer Yes or No, then ' - ' and the reason in at most 25 words.")
    DESCRIBE = ("Task: explain for a test engineer which behaviour of the ECU software this change can affect.\n"
                "Reply in exactly two lines:\n"
                "SUMMARY: <one or two sentences>\n"
                "KEYWORDS: <8 to 15 comma-separated terms that test cases about this behaviour would use - functions, "
                "signals, faults (DTC), states, diagnostic services, thresholds, timings>")

    def __init__(self, backend: LLMBackend, cfg: LLMConfig, model_dir: Path):
        self.backend = backend
        self.cfg = cfg
        self.cache = LLMCache(Path(model_dir) / "llm_cache.jsonl")
        self.lock = threading.RLock()
        self.calls = 0
        self.cached = 0
        self.seconds = 0.0

    @property
    def avg_seconds(self) -> float:
        return self.seconds / self.calls if self.calls else 0.0

    def close(self) -> None:
        with self.lock:
            self.backend.close()

    def _key(self, *parts: str) -> str:
        return sha1_short("|".join((self.backend.model_id, LLM_PROMPT_VERSION) + parts), 24)

    def judge_messages(self, change_text: str, tc: TestCase, examples: str = "") -> List[Dict[str, str]]:
        user = (change_text + ("\n\n" + examples if examples else "") + "\n\n" + LLM_SPLIT
                + llm_tc_text(tc) + "\n\n" + self.QUESTION)
        return [{"role": "system", "content": self.SYSTEM}, {"role": "user", "content": user}]

    def judge(self, change_text: str, tc: TestCase, examples: str = "", use_cache: bool = True) -> LLMVerdict:
        cfg = self.cfg
        key = self._key("j", sha1_short(change_text, 20), tc.fp)
        hit = self.cache.get(key) if use_cache else None
        want_reason = cfg.reasons and (hit is None or hit["p"] >= cfg.confirm - 0.15)
        if hit is not None and (hit.get("r") or not want_reason):
            self.cached += 1
            return LLMVerdict(float(hit["p"]), hit.get("r", ""), hit.get("m", ""), True)
        msgs = self.judge_messages(change_text, tc, examples)
        t0 = time.time()
        with self.lock:
            p: Optional[float] = float(hit["p"]) if hit is not None else self.backend.yes_prob(msgs)
            mode = (hit.get("m") if hit is not None else "prob") or "prob"
            reason = ""
            if p is None:
                mode = "text"
                verdict, reason = parse_answer(self.backend.generate(msgs, 70))
                p = 0.9 if verdict else 0.1 if verdict is False else 0.5
            elif cfg.reasons and p >= cfg.confirm - 0.15:
                word = "Yes" if p >= 0.5 else "No"
                answer = self.backend.generate(msgs, 70, prefix=word if self.backend.kind == "llamacpp" else "")
                if self.backend.kind == "llamacpp":
                    answer = word + answer
                _v, reason = parse_answer(answer)
        self.calls += 1
        self.seconds += time.time() - t0
        self.cache.put(key, {"p": round(float(p), 4), "r": reason, "m": mode})
        return LLMVerdict(float(p), reason, mode, False)

    def describe(self, change_text: str, use_cache: bool = True) -> ChangeInsight:
        key = self._key("d", sha1_short(change_text, 20))
        hit = self.cache.get(key) if use_cache else None
        if hit is not None:
            return ChangeInsight(hit.get("s", ""), list(hit.get("w", [])))
        msgs = [{"role": "system", "content": self.SYSTEM},
                {"role": "user", "content": change_text + "\n\n" + self.DESCRIBE}]
        t0 = time.time()
        with self.lock:
            text = self.backend.generate(msgs, 200, stop=("\n\n\n",))
        self.seconds += time.time() - t0
        self.calls += 1
        ins = parse_insight(text)
        self.cache.put(key, {"s": ins.summary, "w": ins.keywords})
        return ins


def _fmt_secs(s: float) -> str:
    if s < 90:
        return "%d s" % max(1, round(s))
    if s < 5400:
        return "%d min" % round(s / 60)
    return "%.1f h" % (s / 3600)


def analyze_changes_llm(engine: Engine, judge: LLMJudge, changes: Sequence[Change],
                        threshold: Optional[float] = None, progress: ProgressFn = None,
                        skip_comment_only: bool = True, cancel: Optional[threading.Event] = None,
                        info: Optional[Dict[str, Any]] = None) -> List[ChangeResult]:
    """Matcher + local LLM.  Changes in the same function are read by the LLM together
    (one description, one check per test case); the matcher's best candidates of the
    function are checked, the LLM's verdict decides, your training overrides it."""
    cfg = judge.cfg
    thr = engine.model.threshold if threshold is None else threshold
    store = engine.store
    info = info if info is not None else {}
    calls0, cached0 = judge.calls, judge.cached
    out: Dict[str, ChangeResult] = {}
    groups: Dict[Tuple[str, str], List[Change]] = {}
    for ch in changes:
        if skip_comment_only and ch.note.startswith("comment-only"):
            q = engine.query_for_change(ch)
            q.context.append("Comment-only change: no test case needed "
                             "(untick 'Ignore changes in: comments' to analyse it anyway).")
            out[ch.cid] = ChangeResult(ch, q, [])
            continue
        groups.setdefault((ch.file, ch.functions[0] if ch.functions else ""), []).append(ch)
    n_groups = max(1, len(groups))
    n_all = len(store)
    check_all = cfg.candidates >= n_all
    cand_counts: List[int] = []
    stop = False
    too_long = 0

    def avg_cands() -> float:
        return (sum(cand_counts) / len(cand_counts)) if cand_counts else float(min(cfg.candidates, n_all))

    def eta(left_here: float, gi: int) -> str:
        """Time left: the rest of this change plus the changes still to come."""
        left = left_here + (n_groups - gi - 1) * (avg_cands() + (1 if cfg.explain else 0))
        return ("   ~%s left" % _fmt_secs(left * judge.avg_seconds)) if judge.avg_seconds > 0 else ""

    for gi, chs in enumerate(groups.values()):
        stop = stop or bool(cancel is not None and cancel.is_set())
        base_q = {ch.cid: engine.query_for_change(ch) for ch in chs}
        ctx = list(dict.fromkeys(c for q in base_q.values() for c in q.context))
        change_text = llm_change_text(engine, chs, ctx)
        insight: Optional[ChangeInsight] = None
        if cfg.explain and not stop:
            _progress(progress, "LLM reads change %d / %d: %s%s" % (gi + 1, n_groups, chs[0].label()[:80],
                                                                   eta(1 + avg_cands(), gi)), gi / n_groups)
            try:
                insight = judge.describe(change_text)
            except LLMContextError:
                insight = None
            if insight is not None and not (insight.summary or insight.keywords):
                insight = None
        queries = {ch.cid: (engine.query_for_change(ch, insight) if insight is not None else base_q[ch.cid])
                   for ch in chs}
        per: Dict[str, List[Match]] = {}
        best: Dict[int, float] = {}
        for ch in chs:
            q = queries[ch.cid]
            if insight is not None and insight.summary:
                q.context.insert(0, "LLM: " + insight.summary)
            ms = engine.match(q, threshold=min(LLM_FLOOR, thr), limit=max(cfg.candidates, MAX_RESULTS_PER_CHANGE),
                              explain=False)
            per[ch.cid] = ms
            for m in ms:
                if m.conf > best.get(m.tc.idx, -1.0):
                    best[m.tc.idx] = m.conf
        if check_all:
            order = sorted(range(n_all), key=lambda d: (-best.get(d, 0.0), d))
        else:
            order = sorted(best, key=lambda d: (-best[d], d))[:max(1, cfg.candidates)]
        cand_counts.append(len(order))
        examples = examples_block(engine, queries[chs[0].cid]) if cfg.examples else ""
        verdicts: Dict[int, LLMVerdict] = {}
        for i, d in enumerate(order):
            if stop or (cancel is not None and cancel.is_set()):
                stop = True
                break
            _progress(progress, "LLM checks change %d / %d, test case %d / %d%s" % (
                gi + 1, n_groups, i + 1, len(order), eta(len(order) - i, gi)), (gi + i / len(order)) / n_groups)
            try:
                verdicts[d] = judge.judge(change_text, store.cases[d], examples)
            except LLMContextError:
                too_long += 1                            # stays 'Not checked'; reported to the user
                continue
        for ch in chs:
            ms = per[ch.cid]
            present = {m.tc.idx for m in ms}
            for d, v in verdicts.items():            # confirmed for the function = confirmed for each of its hunks
                if d not in present and v.p >= cfg.confirm:
                    ms.append(Match(store.cases[d], best.get(d, 0.0)))
            keep: List[Match] = []
            for m in ms:
                v = verdicts.get(m.tc.idx)
                if v is not None:
                    m.llm, m.llm_why = v.p, v.reason
                m.status = classify_match(m, cfg.confirm)
                if m.status in (STATUS_YOU, STATUS_LLM, STATUS_REJECTED) or m.conf >= thr:
                    keep.append(m)
            keep.sort(key=Match.sort_key)
            out[ch.cid] = ChangeResult(ch, queries[ch.cid], keep)
    info.update(groups=len(groups), calls=judge.calls - calls0, cached=judge.cached - cached0, cancelled=stop,
                seconds_per_call=judge.avg_seconds, too_long=too_long)
    _progress(progress, "LLM analysis %s." % ("stopped" if stop else "finished"), 1.0)
    return [out[ch.cid] for ch in changes]


def count_statuses(results: Sequence[ChangeResult]) -> Dict[str, int]:
    """Unique test cases per final status (best status over all changes)."""
    c: Counter = Counter(a["status"] for a in summarize_results(results))
    return {k: c.get(k, 0) for k in (STATUS_YOU, STATUS_LLM, STATUS_UNCHECKED, STATUS_REJECTED, STATUS_YOU_NO, "")}


def suggest_llm_threshold(model: Model) -> Optional[float]:
    """Confirm level that best matches your Right / Wrong verdicts on LLM answers (recall counts double)."""
    pts: List[Tuple[float, int]] = []
    for ev in model.read_events():
        lp = ev.get("llm_p") or {}
        for k in ev.get("right", []) + ev.get("missing", []) + ev.get("implicit_right", []):
            if k in lp:
                pts.append((float(lp[k]), 1))
        for k in ev.get("wrong", []) + ev.get("implicit_wrong", []):
            if k in lp:
                pts.append((float(lp[k]), 0))
    pos = sum(y for _, y in pts)
    if pos < 10 or len(pts) - pos < 10:
        return None
    best_f, best_t = -1.0, 0.5
    for i in range(5, 96, 5):
        t = i / 100.0
        tp = sum(1 for p, y in pts if p >= t and y)
        fp = sum(1 for p, y in pts if p >= t and not y)
        fn = pos - tp
        f2 = (5.0 * tp) / (5.0 * tp + 4.0 * fn + fp) if tp else 0.0
        if f2 > best_f + 1e-9:
            best_f, best_t = f2, t
    return best_t


def evaluate_llm_on_history(judge: LLMJudge, engine: Engine, max_pairs: int = 200, progress: ProgressFn = None,
                            cancel: Optional[threading.Event] = None) -> Dict[str, Any]:
    """Ask the LLM again for test cases you rated in training and compare with your verdicts."""
    pairs: List[Tuple[str, str, int]] = []
    for ev in reversed(engine.model.read_events()):
        ctx = ev.get("llm_ctx")
        if not ctx:
            continue
        for k in ev.get("right", []) + ev.get("missing", []):
            pairs.append((ctx, k, 1))
        for k in ev.get("wrong", []):
            pairs.append((ctx, k, 0))
        if len(pairs) >= max_pairs:
            break
    pairs = pairs[:max_pairs]
    rows: List[Tuple[float, int, str, str]] = []
    for i, (ctx, k, y) in enumerate(pairs):
        if cancel is not None and cancel.is_set():
            break
        d = engine._resolve(k)
        if d is None:
            continue
        _progress(progress, "Checking the LLM against your verdicts: %d / %d" % (i + 1, len(pairs)),
                  (i + 1) / max(1, len(pairs)))
        v = judge.judge(ctx, engine.store.cases[d])
        rows.append((v.p, y, engine.store.cases[d].tc_id, ctx.split("\n")[1] if "\n" in ctx else ""))
    thr = judge.cfg.confirm
    tp = sum(1 for p, y, _, _ in rows if p >= thr and y)
    fp = sum(1 for p, y, _, _ in rows if p >= thr and not y)
    fn = sum(1 for p, y, _, _ in rows if p < thr and y)
    tn = sum(1 for p, y, _, _ in rows if p < thr and not y)
    n = len(rows)
    res: Dict[str, Any] = {"pairs": n, "right": tp + fn, "wrong": fp + tn, "tp": tp, "fp": fp, "fn": fn, "tn": tn,
                           "threshold": thr, "accuracy": (tp + tn) / n if n else None,
                           "recall": tp / (tp + fn) if tp + fn else None,
                           "precision": tp / (tp + fp) if tp + fp else None,
                           "misses": [(tc, round(p, 2), where) for p, y, tc, where in rows if y and p < thr][:15],
                           "false_alarms": [(tc, round(p, 2), where) for p, y, tc, where in rows if not y and p >= thr][:15]}
    return res


