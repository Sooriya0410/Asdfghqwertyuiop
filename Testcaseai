def now_iso() -> str:
    return _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def atomic_write_text(path: Path, text: str) -> None:
    """Write a file so that a crash can never leave a half-written model."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)
        fh.flush()
        try:
            os.fsync(fh.fileno())
        except OSError:
            pass
    os.replace(tmp, path)


def sha1_short(text: str, n: int = 16) -> str:
    return hashlib.sha1(text.encode("utf-8", "replace")).hexdigest()[:n]


def norm_header(value: Any) -> str:
    """'Test Case-ID ' -> 'testcaseid' (used to recognise Excel column names)."""
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def xl_text(value: Any, limit: int = XL_CELL_LIMIT) -> str:
    """Make a string safe for an Excel cell (length + illegal control chars)."""
    s = "" if value is None else str(value)
    s = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", " ", s)
    if len(s) > limit:
        s = s[: limit - 40] + "\n... [truncated %d chars]" % (len(s) - limit + 40)
    if s[:1] in "=+-@":            # never let source text become an Excel formula
        s = "'" + s
    return s


def split_patterns(text: str) -> List[str]:
    return [p.strip() for p in re.split(r"[;,\n]", text or "") if p.strip()]


def fmt_range(a: int, b: int) -> str:
    if not a and not b:
        return ""
    if not b or b <= a:
        return str(a)
    return "%d-%d" % (a, b)


def parse_line_spec(spec: Any) -> List[Tuple[int, int]]:
    """'120-135, 200' -> [(120, 135), (200, 200)].  Accepts '-', ':', '..', 'to'."""
    out: List[Tuple[int, int]] = []
    if spec is None:
        return out
    if isinstance(spec, (int, float)):
        n = int(spec)
        return [(n, n)] if n > 0 else out
    for part in re.split(r"[,;\n]", str(spec)):
        nums = [int(x) for x in re.findall(r"\d+", part)]
        if not nums:
            continue
        a, b = nums[0], nums[-1]
        if b < a:
            a, b = b, a
        if a > 0:
            out.append((a, b))
    return out


