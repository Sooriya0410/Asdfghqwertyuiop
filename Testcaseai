    def _sort_tree(self, tree: Any, col: str) -> None:
        rev = not tree._sort_state.get(col, True)
        tree._sort_state[col] = rev

        def keyf(iid: str) -> Tuple[int, Any]:
            v = tree.set(iid, col)
            try:
                return (0, float(str(v).replace("%", "")))
            except ValueError:
                return (1, str(v).lower())

        fixed = [i for i in tree.get_children("") if i == "ALL"]
        rest = sorted((i for i in tree.get_children("") if i != "ALL"), key=keyf, reverse=rev)
        for n, iid in enumerate(fixed + rest):
            tree.move(iid, "", n)

