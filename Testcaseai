def _start_fake_server(routes: Dict[Tuple[str, str], Callable[[Any], Tuple[int, Any]]]) -> Tuple[Any, int, List[Any]]:
    """A tiny JSON server on 127.0.0.1 (stands in for Ollama / LM Studio in the tests).
    Like choosing a local LLM server in the GUI, it switches connections to 127.0.0.1 on."""
    import http.server
    allow_loopback(True)
    log: List[Any] = []

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a: Any) -> None:
            pass

        def _answer(self, method: str, data: Any) -> None:
            log.append((method, self.path, data))
            fn = routes.get((method, self.path))
            code, obj = fn(data) if fn else (404, {"error": "not found"})
            body = json.dumps(obj).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:
            self._answer("GET", None)

        def do_POST(self) -> None:
            n = int(self.headers.get("Content-Length", "0") or 0)
            self._answer("POST", json.loads(self.rfile.read(n) or b"{}"))

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, srv.server_address[1], log


class _OracleBackend(LLMBackend):
    """Stand-in LLM that knows the right answers of the demo data (tests the LLM pipeline exactly)."""
    kind, name, model_id = "oracle", "Oracle (test)", "oracle"

    def __init__(self, demo: Dict[str, Any]):
        self.demo = demo
        self.calls = 0

    def _truth(self, content: str) -> Set[str]:
        f = re.search(r"File: (\S+)", content)
        fn = re.search(r"Function: (\w+)\(\)", content)
        ch = Change(file=f.group(1) if f else "", functions=[fn.group(1)] if fn else [])
        return demo_truth_for(ch, self.demo) or set()

    def _yes(self, content: str) -> bool:
        m = re.search(r"TEST CASE (\S+)", content)
        if not m:
            return "2 + 2 equal to 4" in content
        if m.group(1) == "CHECK-1":
            return True
        return m.group(1) in self._truth(content)

    def yes_prob(self, messages: Sequence[Dict[str, str]]) -> Optional[float]:
        self.calls += 1
        return 0.97 if self._yes(messages[-1]["content"]) else 0.03

    def generate(self, messages: Sequence[Dict[str, str]], max_tokens: int = 80, stop: Sequence[str] = ("\n\n",),
                 prefix: str = "") -> str:
        self.calls += 1
        c = messages[-1]["content"]
        if "Task: explain" in c:
            return "SUMMARY: The changed function is affected.\nKEYWORDS: changed function"
        return "Yes - oracle: the test case checks the changed behaviour" if self._yes(c) else \
            "No - oracle: different feature"


