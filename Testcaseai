def _bytes_to_unicode() -> Dict[int, str]:
    bs = list(range(33, 127)) + list(range(161, 173)) + list(range(174, 256))
    cs = bs[:]
    n = 0
    for b in range(256):
        if b not in bs:
            bs.append(b)
            cs.append(256 + n)
            n += 1
    return {b: chr(c) for b, c in zip(bs, cs)}


def write_tiny_gguf(path: str, chain: Dict[str, str], nl_yes: Optional[float] = None,
                    nl_no: Optional[float] = None) -> None:
    """A tiny llama-architecture GGUF model for testing the llama.cpp runtime: attention and
    feed-forward outputs are zero, so the next token depends only on the current one and
    'chain' decides the answer (e.g. after the prompt's last newline: 'Y' 'e' 's' ...)."""
    import struct
    import numpy as np
    enc = _bytes_to_unicode()
    tokens = [enc[b] for b in range(256)] + ["<|endoftext|>", "<|im_start|>", "<|im_end|>"]
    types = [1] * 256 + [3, 3, 3]
    tid = {t: i for i, t in enumerate(tokens)}

    def tok(x: str) -> int:
        return tid[x] if x in tid else tid[enc[ord(x)]]

    n_vocab, n_embd, n_ff, n_layer, n_head = len(tokens), 64, 128, 2, 4
    emb = np.zeros((n_vocab, n_embd), np.float32)
    emb[:, n_embd - 1] = 1.0
    states: Dict[int, int] = {}
    for cur in chain:
        states.setdefault(tok(cur), len(states))
    for t, dim in states.items():
        emb[t, :] = 0.0
        emb[t, dim] = 1.0
    out_w = np.zeros((n_vocab, n_embd), np.float32)
    out_w[tok("<|im_end|>"), n_embd - 1] = 5.0
    for cur, nxt in chain.items():
        out_w[tok(nxt), states[tok(cur)]] = 5.0
    if nl_yes is not None:
        d = states[tok("\n")]
        out_w[:, d] = -10.0 / 8.0
        out_w[tok("Y"), d] = nl_yes / 8.0
        out_w[tok("N"), d] = (nl_no or 0.0) / 8.0
    tensors = [("token_embd.weight", emb), ("output_norm.weight", np.ones(n_embd, np.float32)), ("output.weight", out_w)]
    for i in range(n_layer):
        def z(*shape: int) -> Any:
            return np.zeros(shape, np.float32)
        tensors += [("blk.%d.attn_norm.weight" % i, np.ones(n_embd, np.float32)),
                    ("blk.%d.attn_q.weight" % i, z(n_embd, n_embd)), ("blk.%d.attn_k.weight" % i, z(n_embd, n_embd)),
                    ("blk.%d.attn_v.weight" % i, z(n_embd, n_embd)),
                    ("blk.%d.attn_output.weight" % i, z(n_embd, n_embd)),
                    ("blk.%d.ffn_norm.weight" % i, np.ones(n_embd, np.float32)),
                    ("blk.%d.ffn_gate.weight" % i, z(n_ff, n_embd)), ("blk.%d.ffn_up.weight" % i, z(n_ff, n_embd)),
                    ("blk.%d.ffn_down.weight" % i, z(n_embd, n_ff))]
    tpl = ("{% for m in messages %}<|im_start|>{{ m['role'] }}\n{{ m['content'] }}<|im_end|>\n{% endfor %}"
           "{% if add_generation_prompt %}<|im_start|>assistant\n{% endif %}")
    kv = [("general.architecture", 8, "llama"), ("general.name", 8, "stcm-tiny-test"), ("general.alignment", 4, 32),
          ("llama.context_length", 4, 32768), ("llama.embedding_length", 4, n_embd), ("llama.block_count", 4, n_layer),
          ("llama.feed_forward_length", 4, n_ff), ("llama.attention.head_count", 4, n_head),
          ("llama.attention.head_count_kv", 4, n_head), ("llama.attention.layer_norm_rms_epsilon", 6, 1e-5),
          ("llama.rope.dimension_count", 4, n_embd // n_head), ("tokenizer.ggml.model", 8, "gpt2"),
          ("tokenizer.ggml.pre", 8, "default"), ("tokenizer.ggml.tokens", 9, (8, tokens)),
          ("tokenizer.ggml.token_type", 9, (5, types)), ("tokenizer.ggml.merges", 9, (8, [])),
          ("tokenizer.ggml.bos_token_id", 4, tid["<|endoftext|>"]), ("tokenizer.ggml.eos_token_id", 4, tid["<|im_end|>"]),
          ("tokenizer.ggml.add_bos_token", 7, False), ("tokenizer.chat_template", 8, tpl)]

    def gstr(x: str) -> bytes:
        b = x.encode("utf-8")
        return struct.pack("<Q", len(b)) + b

    def value(t: int, v: Any) -> bytes:
        if t == 8:
            return gstr(v)
        if t in (4, 5, 6, 7):
            return struct.pack({4: "<I", 5: "<i", 6: "<f", 7: "<?"}[t], v)
        et, items = v
        return struct.pack("<IQ", et, len(items)) + b"".join(value(et, it) for it in items)

    out = bytearray(b"GGUF" + struct.pack("<IQQ", 3, len(tensors), len(kv)))
    for k, t, v in kv:
        out += gstr(k) + struct.pack("<I", t) + value(t, v)
    off = 0
    blobs = []
    for name, arr in tensors:
        dims = list(reversed(arr.shape))
        out += gstr(name) + struct.pack("<I", len(dims)) + struct.pack("<%dQ" % len(dims), *dims)
        out += struct.pack("<IQ", 0, off)
        b = arr.astype("<f4").tobytes()
        blobs.append(b)
        off += (len(b) + 31) // 32 * 32
    out += b"\0" * ((32 - len(out) % 32) % 32)
    for b in blobs:
        out += b + b"\0" * ((32 - len(b) % 32) % 32)
    with open(path, "wb") as fh:
        fh.write(out)


