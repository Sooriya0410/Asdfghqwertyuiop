        sv["avg"].set("-" if st["avg_mark"] is None else "%.1f / 10" % st["avg_mark"])
        sv["avg20"].set("-" if st["avg_mark_last20"] is None else "%.1f / 10" % st["avg_mark_last20"])
        sv["links"].set("%d   (line / function / identifier / file -> test case)" % st["links"])
        sv["assoc"].set("%d   (code word -> test-case word)" % st["assoc"])
        sv["examples"].set(str(st["examples"]))
        sv["gloss"].set(str(st["glossary_user"]))
        sv["tcs"].set(str(st["testcases_known"]))
        sv["ranker"].set(st["ranker"])
        self.v_rank_mode.set(dict(RANKER_MODES).get(self.model.ranker_mode, RANKER_MODES[0][1]))
        self._show_ranker_info()
        sug = self.engine.suggest_threshold() if self.engine else None
        if sug is None:
            self.lbl_sugg.configure(text="Suggested min. confidence: needs 15+ Right and 15+ Wrong verdicts.")
            self.btn_sugg.configure(state="disabled")
        else:
            self._sugg = sug
            self.lbl_sugg.configure(text="Suggested min. confidence from your verdicts: %d %%" % round(sug * 100))
            self.btn_sugg.configure(state="normal")
        t = self.tree_hist
        t.delete(*t.get_children(""))
        for n, h in enumerate(reversed(self.model.history[-1500:])):
            mk = h.get("mark", "")
            t.insert("", "end", iid=h.get("id") or ("h%d" % n), values=(
                h.get("ts", ""), mk if not isinstance(mk, int) or mk >= 0 else "-", h.get("right", 0),
                h.get("wrong", 0), h.get("missing", 0), h.get("label", "")))
        g = self.tree_gl
        g.delete(*g.get_children(""))
        for a in sorted(self.model.glossary.user):
            g.insert("", "end", iid="u:" + a, values=(a, "you", " | ".join(self.model.glossary.user[a])))
        for a in sorted(BUILTIN_GLOSSARY):
            g.insert("", "end", iid="b:" + a, values=(a, "built-in", " | ".join(BUILTIN_GLOSSARY[a])))
        self._draw_chart()

    def _draw_chart(self) -> None:
        cv = self.cv
        cv.delete("all")
        w, h = max(cv.winfo_width(), 200), max(cv.winfo_height(), 120)
        l, r, tp, bt = 34, 12, 12, 24
        marks = [x["mark"] for x in self.model.history if x.get("mark", 0) >= 0][-300:]
        for v in (0, 5, 10):
            y = tp + (h - tp - bt) * (1 - v / 10.0)
            cv.create_line(l, y, w - r, y, fill="#e3e3e3")
            cv.create_text(l - 6, y, text=str(v), anchor="e", fill="#666666")
        if not marks:
            cv.create_text(w / 2, h / 2, text="No training yet - rate the model in the TRAINING window.",
                           fill="#888888")
            return
        n = len(marks)

        def xy(i: int, v: float) -> Tuple[float, float]:
            x = l + (w - l - r) * (i / max(1, n - 1)) if n > 1 else (l + w - r) / 2
            return x, tp + (h - tp - bt) * (1 - v / 10.0)

        for i, v in enumerate(marks):
            x, y = xy(i, v)
            cv.create_oval(x - 2, y - 2, x + 2, y + 2, fill="#9db7d5", outline="")
        pts: List[float] = []
        for i in range(n):
            win = marks[max(0, i - 9): i + 1]
            pts += list(xy(i, sum(win) / len(win)))
        if len(pts) >= 4:
            cv.create_line(*pts, fill="#1b5e9a", width=2, smooth=False)
        cv.create_text(l, h - 8, text="dots = marks per session   line = average of the last 10   (%d sessions)" % n,
                       anchor="w", fill="#666666")

    def _show_ranker_info(self) -> None:
        info = self.model.ranker_info
        if _np() is None:
            lines = ["numpy is not installed: the built-in scorer is used.",
                     "Install numpy (it comes with pandas) to train the smart ranker on this PC."]
        elif not info.get("metrics"):
            n = len(self.model.rows)
            lines = ["Not trained yet: the built-in scorer is used.",
                     "The re-rankers (logistic regression, boosted",
                     "trees, neural network, ensemble) are trained",
                     "and compared automatically after %d training" % RANKER_MIN_SESSIONS,
                     "sessions (so far: %d)." % n]
            if n == 0 and len(self.model.history) >= RANKER_MIN_SESSIONS:
                lines += ["Your %d earlier sessions can be used:" % len(self.model.history),
                          "press 'Re-train from history' once."]
        else:
            lines = format_ranker_table(info)
        if self._refitting:
            lines = ["(training the re-rankers in the background ...)"] + lines
        self.txt_rank.configure(state="normal")
        self.txt_rank.delete("1.0", "end")
        self.txt_rank.insert("1.0", "\n".join(lines))
        self.txt_rank.configure(state="disabled")

    def _on_ranker_mode(self) -> None:
        lab = self.v_rank_mode.get()
        mode = next((k for k, l in RANKER_MODES if l == lab), "auto")
        if mode == self.model.ranker_mode:
            return
        self.model.ranker_mode = mode
        self.model.save()
        info = self.model.ranker_info
        need = mode in RANKER_KINDS and info.get("kind") != mode
        need = need or (mode == "auto" and info.get("metrics") and select_ranker(info["metrics"]) != info.get("kind"))
        self.refresh_model_tab()
        if need and _np() is not None and len(self.model.rows) >= RANKER_MIN_SESSIONS:
            self.act_compare_models()
        else:
            self.set_status("Ranking model: %s.  Press 'Find test cases' again to use it." % lab)

    def act_compare_models(self) -> None:
        if _np() is None:
            messagebox.showinfo(APP_NAME, "The smart ranker needs numpy (it comes with pandas). Without it the "
                                          "built-in scorer is used.")
            return
        if self._refitting:
            self.set_status("The re-rankers are already being trained in the background - please wait.")
            return
        model, cancel = self.model, self.cancel_ev

        def job(progress: ProgressFn) -> Dict[str, Any]:
            try:
                return model.refit_ranker(progress, cancel)
            except RankerCancelled:
                return {"kind": model.ranker_info.get("kind", "base"), "reason": "Stopped - nothing was changed."}

        def done(info: Dict[str, Any]) -> None:
            self.refresh_model_tab()
            if info.get("reason"):
                self.set_status(info["reason"])
            else:
                self.set_status("Model comparison finished: %s is used.  Press 'Find test cases' again to use it."
                                % RANKER_LABEL.get(info.get("kind", "base"), "built-in scorer"))

        self.run_bg("Comparing the ranking models on your training data", job, done)

    def _refit_ranker_bg(self) -> None:
        """After training: re-train and compare the re-rankers in the background (the window stays usable)."""
        if self._refitting or self.busy or not self.model.ranker_due():
            return
        self._refitting = True
        model = self.model
        self._show_ranker_info()

        def post(fn: Callable[[], None]) -> None:
            self.q.put(("ui", fn))

        def worker() -> None:
            try:
                info = model.refit_ranker()
                msg = "Smart ranker updated from your training: %s is used." % RANKER_LABEL.get(
                    info.get("kind", "base"), "built-in scorer") if not info.get("reason") else ""
            except Exception as exc:                       # noqa: BLE001
                msg = "Smart ranker could not be trained: %s" % exc
            finally:
                self._refitting = False

            def fin() -> None:
                if model is self.model:
                    self.refresh_model_tab()
                if msg:
                    self.set_status(msg)
            post(fin)

        threading.Thread(target=worker, daemon=True).start()

    def act_apply_threshold(self) -> None:
        sug = getattr(self, "_sugg", None)
        if sug:
            self.v_thr.set(round(sug * 100))
            self._on_thr()
            self.set_status("Minimum confidence set to %d %%." % round(sug * 100))

    def act_retrain(self) -> None:
        def go() -> None:
            eng = self.engine
            assert eng is not None
            self.run_bg("Re-training from history", lambda p: eng.retrain(p),
                        lambda n: (self.refresh_model_tab(), self.set_status("Model rebuilt from %d sessions." % n)))

        self._with_engine(go)

    def act_delete_sessions(self) -> None:
        ids = set(self.tree_hist.selection())
        if not ids:
            messagebox.showinfo(APP_NAME, "Select one or more sessions in the history list first.")
            return
        if not messagebox.askyesno(APP_NAME, "Delete %d training session(s) and rebuild the model without them?" % len(ids)):
            return

        def go() -> None:
            eng = self.engine
            assert eng is not None
            self.run_bg("Deleting sessions", lambda p: eng.retrain(p, drop_ids=ids),
                        lambda n: (self.refresh_model_tab(), self.set_status("Model rebuilt from %d sessions." % n)))

        self._with_engine(go)

    def act_open_folder(self) -> None:
        path = str(self.model.dir)
        try:
            os.startfile(path)                             # type: ignore[attr-defined]
        except Exception:
            messagebox.showinfo(APP_NAME, "Model folder:\n%s" % path)

    def act_change_folder(self) -> None:
        d = filedialog.askdirectory(initialdir=str(self.model.dir), title="Select the model folder")
        if not d:
            return
        try:
            self._save_settings()
            self.model = Model(Path(d))
            remember_model_dir(Path(d))
            if self.engine is not None:
                self.engine.model = self.model
                self.engine._resolve_cache.clear()
            self.v_thr.set(round(self.model.threshold * 100))
            self._on_thr()
            self.refresh_model_tab()
            self.set_status("Model folder: %s   (%d training sessions)" % (self.model.dir, len(self.model.history)))
        except Exception as exc:                           # noqa: BLE001
            self._show_error("Model folder", exc, traceback.format_exc())

    def act_gloss_add(self) -> None:
        a, m = self.v_ga.get().strip(), self.v_gm.get().strip()
        if not a or not m:
            messagebox.showinfo(APP_NAME, "Fill both fields, for example:   uvlo  =  under voltage lockout")
            return
        self.model.glossary.teach(a, m)
        self.model.save_glossary()
        self.v_ga.set("")
        self.v_gm.set("")
        self.refresh_model_tab()
        self.set_status("Learned: '%s' means '%s'." % (a, m))

    def act_gloss_remove(self) -> None:
        sel = self.tree_gl.selection()
        if not sel or not sel[0].startswith("u:"):
            messagebox.showinfo(APP_NAME, "Select one of your own entries (source 'you').")
            return
        self.model.glossary.forget(sel[0][2:])
        self.model.save_glossary()
        self.refresh_model_tab()

    # ======================================================================== LOCAL LLM
    LLM_HELP = """HOW IT WORKS
1. The matcher picks the best candidates out of all test cases (milliseconds).
2. The local LLM reads the code change and every candidate test case (precondition, procedure, expected result) and answers Yes / No with a probability and a one-sentence reason.
3. Your training always wins: a test case you confirmed or rejected for a function or line keeps that decision, whatever the LLM says. Your decisions are also shown to the LLM as examples.
Everything runs on this PC. The program blocks every network connection - with llama.cpp not even 127.0.0.1 is used. Only when you choose Ollama or LM Studio below may it talk to that server on this PC (127.0.0.1), never to another computer.
You do not need an LLM: the smart ranker (MODEL window) is trained on this PC from your verdicts and needs no download.

SET UP llama.cpp  (recommended - runs inside this program, no server)
1. Install the runtime once:
     pip install llama-cpp-python
   If pip starts to compile and fails (no C++ compiler), try the prebuilt CPU wheel:
     pip install llama-cpp-python --prefer-binary --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cpu
   If no wheel fits your Python version: install 'Visual Studio Build Tools (C++)' and run the first command again - or use Ollama / LM Studio.
   PC without internet: on another PC run the same command as 'pip download ... -d wheels', copy the folder 'wheels' and run:
     pip install --no-index --find-links wheels llama-cpp-python
2. Download ONE instruct model as a .gguf file (quantisation Q4_K_M) on a PC with internet and copy it here, e.g. to D:\\model\\llm\\. Size by free RAM:
   - 8 GB: 3-4 B instruct model (e.g. Qwen3-4B-Instruct, Phi-4-mini-instruct), file about 2.5 GB
   - 16 GB: 7-9 B instruct model (e.g. Qwen3-8B, Llama-3.1-8B-Instruct), file about 5 GB
   - 32 GB or more: a 14 B model, or a 30 B "A3B" mixture-of-experts model (fast on a CPU), file 9-19 GB
   Newer versions of these families work as well. Larger = better judgement, but slower.
3. Choose the file on the left and press 'Load + test model'.
NVIDIA GPU: install a CUDA build of llama-cpp-python and set 'GPU layers' to 99 (10-50x faster).

SET UP Ollama or LM Studio  (alternative)
Install the program, download a model with it, start it, then enter its local address and model name on the left. These are separate programs: check their own update / telemetry settings if that matters to you.

SPEED  (CPU only, 7-9 B model)
Roughly 1-5 s per test case after the first one of a change (the change itself is read once per changed function). 100 test cases per changed function take a few minutes. Every answer is remembered: a second run is instant and a stopped run continues where it stopped. 'Load + test model' measures your PC.

ACCURACY
No model is perfect. After some training press 'Check LLM against my verdicts': the LLM is asked again for the test cases you rated and you see how often it agrees with you.
Confirmed test cases missing? Raise 'test cases checked per changed function' or lower the confirm level. Too many? Raise the confirm level. Test cases the LLM rejected stay visible ('Rejected (LLM)') for review.
"""

