_NET = {"loopback": False}


def allow_loopback(on: bool) -> None:
    """By default every network socket is blocked, connections to this PC itself (127.0.0.1)
    included.  Only when the user explicitly chooses a local LLM *server* (Ollama / LM Studio)
    in the LOCAL LLM window are connections to 127.0.0.1 allowed - never to another computer."""
    _NET["loopback"] = bool(on)


def loopback_allowed() -> bool:
    return bool(_NET["loopback"])


def _is_loopback(host: Any) -> bool:
    """True for 'localhost', 127.x.x.x and ::1 - addresses that never leave this PC."""
    if host is None:
        return False
    h = str(host).strip().strip("[]").split("%")[0].lower()
    if h in ("localhost", "localhost.localdomain", "ip6-localhost", "ip6-loopback"):
        return True
    try:
        import ipaddress
        return ipaddress.ip_address(h).is_loopback
    except ValueError:
        return False


def _net_ok(host: Any) -> bool:
    return _NET["loopback"] and _is_loopback(host)


def _net_error() -> OSError:
    return OSError(_OFFLINE_MSG_LOCAL if _NET["loopback"] else _OFFLINE_MSG)


def enforce_offline() -> None:
    """Make "never connects to anything" a hard guarantee for this process: network sockets
    cannot connect, listen, bind or send, and host names cannot be looked up - for other
    computers and for this PC (127.0.0.1) alike.  Connections to 127.0.0.1 only become
    possible after allow_loopback(True), i.e. when the user explicitly picks a local LLM
    server (Ollama / LM Studio).  The tool itself needs no socket at all."""
    try:
        import socket
    except Exception:           # pragma: no cover - socket module missing
        return
    if getattr(socket, "_stcm_offline", False):
        return
    inet = {socket.AF_INET, getattr(socket, "AF_INET6", socket.AF_INET)}
    real_gai = socket.getaddrinfo
    real_ghbn = socket.gethostbyname
    real_ghbn_ex = socket.gethostbyname_ex

    def check(sock: Any, address: Any) -> None:
        if sock.family in inet:
            host = address[0] if isinstance(address, (tuple, list)) and address else address
            if not _net_ok(host):
                raise _net_error()

    class _NoNetSocket(socket.socket):                # type: ignore[misc, valid-type]
        def connect(self, address):                   # noqa: D401
            check(self, address)
            return super().connect(address)

        def connect_ex(self, address):
            check(self, address)
            return super().connect_ex(address)

        def bind(self, address):
            check(self, address)
            return super().bind(address)

        def listen(self, *args):
            if self.family in inet:                   # an unbound socket would listen on every interface
                try:
                    host = self.getsockname()[0]
                except OSError:
                    host = None
                if not _net_ok(host):
                    raise _net_error()
            return super().listen(*args)

        def sendto(self, data, *args):
            check(self, args[-1] if args else None)
            return super().sendto(data, *args)

        def sendmsg(self, buffers, ancdata=(), flags=0, address=None):
            if address is not None:
                check(self, address)
                return super().sendmsg(buffers, ancdata, flags, address)
            return super().sendmsg(buffers, ancdata, flags)

    def local_gai(host, *a, **k):
        if not _net_ok(host):
            raise _net_error()
        return real_gai(host, *a, **k)

    def local_ghbn(name):
        if not _net_ok(name):
            raise _net_error()
        return real_ghbn(name)

    def local_ghbn_ex(name):
        if not _net_ok(name):
            raise _net_error()
        return real_ghbn_ex(name)

    def blocked(*a, **k):
        raise _net_error()

    socket.socket = _NoNetSocket                      # type: ignore[misc]
    socket.getaddrinfo = local_gai                    # type: ignore[assignment]
    socket.gethostbyname = local_ghbn                 # type: ignore[assignment]
    socket.gethostbyname_ex = local_ghbn_ex           # type: ignore[assignment]
    socket.gethostbyaddr = blocked                    # type: ignore[assignment]
    socket._stcm_offline = True                       # type: ignore[attr-defined]


