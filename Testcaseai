def _rb_sub(text: str, **vals: str) -> str:
    for k, v in vals.items():
        text = text.replace("{%s}" % k, v)
    return text


def _rb_abbr(word: str) -> str:
    if word in _RB_ABBR:
        return _RB_ABBR[word]
    return word[0].upper() + "".join(c for c in word[1:] if c not in "aeiou")[:3]


def _rb_case(rnd: random.Random, f_phrase: str, title_tpl: str, steps: Sequence[str], exp: Sequence[str],
             extra: str = "") -> str:
    vals = {"f": f_phrase, "F": f_phrase[:1].upper() + f_phrase[1:], "n": rnd.choice([9, 12, 13.5, 16, 50, 120]),
            "u": rnd.choice(["V", "bar", "%", "km/h", "deg"]), "t": rnd.choice([20, 50, 100, 200, 500, 1000])}
    title = title_tpl.format(**vals) + extra
    pre = rnd.sample(_RB_PRE, 2)
    st = rnd.sample(list(steps), min(len(steps), rnd.choice([2, 3])))
    ex = rnd.sample(list(exp), min(len(exp), rnd.choice([1, 2])))
    lines = [title, "Precondition:"] + ["- " + p for p in pre] + ["Test Procedure:"]
    lines += ["%d. %s" % (i + 1, s) for i, s in enumerate(st)] + ["Expected Result:"] + ["- " + e for e in ex]
    return "\n".join(lines).format(**vals)


def make_rank_bench(target: str, seed: int = 11) -> Dict[str, Any]:
    """Write <target>/sandbox and <target>/test_cases.xlsx; return the changes with their right test cases."""
    openpyxl = require_openpyxl()
    rnd = random.Random(seed)
    target = os.path.abspath(target)
    root = os.path.join(target, "sandbox")
    if os.path.isdir(root):
        shutil.rmtree(root)
    aspect_keys = list(_RB_ASPECTS)
    feats = []
    for fi, (prefix, title, own) in enumerate(_RB_FEATURES):
        asp = rnd.sample(aspect_keys, 4)
        feats.append({"i": fi, "prefix": prefix, "title": title, "own": own, "aspects": asp,
                      "dir": ("Bsw/" if fi % 3 == 0 else "Swc/") + prefix})
    # ---- source code ----
    changes: List[Tuple[Change, Tuple[int, str]]] = []
    files: Dict[str, str] = {}
    for f in feats:
        p, P = f["prefix"], f["prefix"].upper()
        o1 = _rb_abbr(f["own"][1])
        cfg = ["#ifndef %s_CFG_H" % P, "#define %s_CFG_H" % P, ""]
        src = ["/* %s.c - %s */" % (p, f["title"]), '#include "%s_Cfg.h"' % p, '#include "Dem.h"', ""]
        cfg_lines: Dict[str, int] = {}
        func_lines: Dict[str, Tuple[str, int, int]] = {}
        for a in f["aspects"]:
            spec = _RB_ASPECTS[a]
            A = _rb_abbr(spec["words"][0])
            cfg_lines[a] = len(cfg) + 1
            cfg.append("#define %s    %dU   /* %s */" % (_rb_sub(spec["macro"], P=P), rnd.choice([10, 20, 50, 100, 250, 1000]),
                                                       " ".join(spec["words"]) if rnd.random() < 0.5 else ""))
            fname = "%s_%s" % (p, spec["verb"])
            if rnd.random() < 0.6:
                src.append("/* %s: %s %s. */" % (fname, rnd.choice(["checks the", "handles the", "monitors the"]),
                                                 " ".join([f["own"][rnd.randrange(4)]] + spec["words"][:1])))
            src += ["void %s(void)" % fname, "{"]
            start = len(src) + 1
            body = [_rb_sub(ln, p=p, P=P, A=A, a=A.lower(), O1=o1) for ln in spec["code"]]
            src += ["    " + ln for ln in body]
            func_lines[a] = (fname, start, len(src))
            src += ["}", ""]
        src += ["void %s_MainFunction(void)" % p, "{"] + \
               ["    %s();" % func_lines[a][0] for a in f["aspects"]] + ["}", ""]
        cfg += ["", "#endif", ""]
        rel_c, rel_h = f["dir"] + "/%s.c" % p, f["dir"] + "/%s_Cfg.h" % p
        files[rel_c], files[rel_h] = "\n".join(src), "\n".join(cfg)
        lines_c = files[rel_c].split("\n")
        for a in f["aspects"]:
            fname, a0, a1 = func_lines[a]
            cands = [i for i in range(a0, a1 + 1) if lines_c[i - 1].strip() not in ("{", "}", "else", "break;")]
            for ln in sorted(rnd.sample(cands, min(3, len(cands)))):
                new = lines_c[ln - 1]
                if re.search(r"\d", new):
                    old = re.sub(r"\d+", lambda m_: str(int(m_.group(0)) + rnd.choice([1, 5, 10])), new, count=1)
                elif ">" in new or "<" in new:
                    old = new.replace(">", ">=", 1) if ">" in new else new.replace("<", "<=", 1)
                elif "==" in new or "!=" in new:
                    old = new.replace("==", "!=", 1) if "==" in new else new.replace("!=", "==", 1)
                else:
                    old = ""
                changes.append((Change(file=rel_c, kind="C", status="Modified", functions=[fname],
                                       old_start=ln, old_end=ln if old else 0, new_start=ln, new_end=ln,
                                       old_code=old, new_code=new), (f["i"], a)))
            hl = cfg_lines[a]
            new = files[rel_h].split("\n")[hl - 1]
            old = re.sub(r"(\d+)U", lambda m_: "%dU" % (int(m_.group(1)) * 2), new, count=1)
            changes.append((Change(file=rel_h, kind="H", status="Modified", old_start=hl, old_end=hl,
                                   new_start=hl, new_end=hl, old_code=old, new_code=new), (f["i"], a)))
    files["App/Sched/Sched.c"] = "\n".join(
        ["/* Scheduler */", "void Task_10ms(void)", "{"] + ["    %s_MainFunction();" % f["prefix"] for f in feats]
        + ["}", ""])
    for rel, text in files.items():
        _write(os.path.join(root, rel), text)
    # ---- test cases ----
    rows: List[Tuple[str, str]] = []
    truth: Dict[Tuple[int, str], Set[str]] = defaultdict(set)

    def add(text: str, keys: Sequence[Tuple[int, str]]) -> None:
        tc_id = "RB-%05d" % (len(rows) + 1)
        rows.append((tc_id, text))
        for k in keys:
            truth[k].add(tc_id)

    def phrase(f: Dict[str, Any]) -> str:
        r = rnd.random()
        if r < 0.55:
            return f["title"]
        if r < 0.85:
            return " ".join(f["title"].split()[:2])
        return "%s %s" % (f["own"][rnd.randrange(4)], f["own"][rnd.randrange(4)])

    for f in feats:
        for a in f["aspects"]:
            spec = _RB_ASPECTS[a]
            for _ in range(10):
                add(_rb_case(rnd, phrase(f), rnd.choice(spec["titles"]), spec["steps"], spec["exp"]), [(f["i"], a)])
        for _ in range(6):
            add(_rb_case(rnd, phrase(f), rnd.choice(_RB_GENERAL["titles"]), _RB_GENERAL["steps"],
                         _RB_GENERAL["exp"]), [(f["i"], a) for a in f["aspects"]])
        for _ in range(4):                               # interaction with another module
            a = rnd.choice(f["aspects"])
            g = feats[rnd.randrange(len(feats))]
            if g is f:
                continue
            b = rnd.choice(g["aspects"])
            spec = _RB_ASPECTS[a]
            add(_rb_case(rnd, phrase(f), rnd.choice(spec["titles"]), list(spec["steps"]) + list(
                _RB_ASPECTS[b]["steps"][:1]), spec["exp"], " while the %s is active" % g["title"]),
                [(f["i"], a), (g["i"], b)])
    for name in _RB_LOOKALIKES:                          # features without code: look-alike test cases
        for a in rnd.sample(aspect_keys, 4):
            spec = _RB_ASPECTS[a]
            for _ in range(10):
                add(_rb_case(rnd, name, rnd.choice(spec["titles"]), spec["steps"], spec["exp"]), [])
        for _ in range(6):
            add(_rb_case(rnd, name, rnd.choice(_RB_GENERAL["titles"]), _RB_GENERAL["steps"], _RB_GENERAL["exp"]), [])
    order = list(range(len(rows)))
    rnd.shuffle(order)
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.append(["ID", "Text"])
    for i in order:
        ws.append(list(rows[i]))
    tc_path = os.path.join(target, "test_cases.xlsx")
    wb.save(tc_path)
    out = []
    for n, (ch, key) in enumerate(changes, 1):
        ch.cid = "C%04d" % n
        out.append({"change": ch, "feature": key[0], "aspect": key[1], "truth": set(truth[key])})
    return {"sandbox": root, "testcases": tc_path, "changes": out, "n_features": len(feats)}


def _rank_eval(eng: Engine, items: Sequence[Dict[str, Any]], queries: Dict[str, Query], rerank: bool,
               thr: float = DEFAULT_THRESHOLD) -> Dict[str, float]:
    """Mean ranking quality over changes with known right test cases."""
    acc: Dict[str, List[float]] = defaultdict(list)
    for it in items:
        truth = it["truth"]
        if not truth:
            continue
        q = queries[it["change"].cid]
        ms = eng.match(q, threshold=0.0, limit=None, explain=False, lean=True, rerank=rerank)
        ids = [m.tc.tc_id for m in ms]
        hits, ap = 0, 0.0
        for r, tc_id in enumerate(ids, 1):
            if tc_id in truth:
                hits += 1
                ap += hits / r
        acc["map"].append(ap / len(truth))
        acc["p10"].append(sum(1 for i in ids[:10] if i in truth) / 10.0)
        acc["r20"].append(sum(1 for i in ids[:20] if i in truth) / len(truth))
        acc["r50"].append(sum(1 for i in ids[:50] if i in truth) / len(truth))
        listed = [m.tc.tc_id for m in ms if m.conf >= thr][:MAX_RESULTS_PER_CHANGE]
        tp = sum(1 for i in listed if i in truth)
        acc["rec_thr"].append(tp / len(truth))
        acc["prec_thr"].append(tp / len(listed) if listed else 1.0)
        acc["n_thr"].append(float(len(listed)))
    return {k: sum(v) / max(1, len(v)) for k, v in acc.items()}


def _simulated_training(eng: Engine, items: Sequence[Dict[str, Any]], queries: Dict[str, Query],
                        id2key: Dict[str, str], rnd: random.Random) -> None:
    """The trainer of run_benchmark: rates 24 listed results (10 strongest, 6 weakest, 8 between)
    and names up to 3 missed right test cases."""
    for it in items:
        truth = it["truth"]
        q = queries[it["change"].cid]
        shown = eng.match(q, explain=False, lean=True)
        if len(shown) > 24:
            mid = shown[10:-6]
            rated = shown[:10] + shown[-6:] + [mid[int(i * len(mid) / 8)] for i in range(8)]
        else:
            rated = shown
        verdicts = {m.tc.key: ("R" if m.tc.tc_id in truth else "W") for m in rated}
        got = {m.tc.tc_id for m in shown}
        missed = sorted(truth - got)
        rnd.shuffle(missed)
        tp = len(got & truth)
        f1 = 2 * tp / (len(got) + len(truth)) if (got or truth) else 1.0
        eng.feedback(q, shown, verdicts, [id2key[i] for i in missed[:3]], min(9, int(round(10 * f1))))


def run_model_benchmark(target: Optional[str] = None, seeds: Sequence[int] = (1, 2, 3), verbose: bool = True,
                        scenarios: Sequence[str] = ("A", "B")) -> Dict[str, Any]:
    """Which ranking model generalises best?  Scenario A: new changes in modules that were
    trained before; scenario B: changes in modules never trained.  For every split the
    simulated trainer trains on one half, all models are measured on the other half."""
    np = _np()
    if np is None:
        raise RuntimeError("The model benchmark needs numpy.")
    tmp = target or tempfile.mkdtemp(prefix="stcm_mbench_")
    bench = make_rank_bench(os.path.join(tmp, "data"))
    pats, excl = split_patterns(DEFAULT_USER_PATTERNS), split_patterns(DEFAULT_EXCLUDE_DIRS)
    store = TestCaseStore.load(bench["testcases"])
    index = TCIndex(store)
    id2key = {tc.tc_id: tc.key for tc in store.cases}
    items = bench["changes"]
    report: Dict[str, Any] = {"testcases": len(store), "changes": len(items), "runs": []}
    configs = ("v11", "base") + RANKER_KINDS
    t_all = time.time()
    for scen in scenarios:
        for seed in seeds:
            rnd = random.Random(1000 * seed + ord(scen))
            if scen == "A":                              # half of the changes of every function
                by: Dict[Tuple[int, str], List[Dict[str, Any]]] = defaultdict(list)
                for it in items:
                    by[(it["feature"], it["aspect"])].append(it)
                train, test = [], []
                for grp in by.values():
                    grp = grp[:]
                    rnd.shuffle(grp)
                    train += grp[:len(grp) // 2]
                    test += grp[len(grp) // 2:]
            else:                                        # half of the modules
                fs = list(range(bench["n_features"]))
                rnd.shuffle(fs)
                tr_f = set(fs[:len(fs) // 2])
                train = [it for it in items if it["feature"] in tr_f]
                test = [it for it in items if it["feature"] not in tr_f]
            rnd.shuffle(train)
            mdir = Path(tmp) / ("model_%s%d" % (scen, seed))
            if mdir.exists():
                shutil.rmtree(mdir)
            model = Model(mdir)
            sbx = SandboxIndex.build(bench["sandbox"], pats, excl, model.cache_dir)
            eng = Engine(model, store, index=index, sandbox=sbx)
            queries = {it["change"].cid: eng.query_for_change(it["change"]) for it in items}
            t0 = time.time()
            _simulated_training(eng, train, queries, id2key, rnd)
            t_train = time.time() - t0
            res: Dict[str, Dict[str, float]] = {}
            model.ranker = None
            sem_keep = eng.sem
            eng.sem = None                               # version 1.1: no semantic vectors, no re-ranker
            res["v11"] = _rank_eval(eng, test, queries, rerank=False)
            eng.sem = sem_keep
            res["base"] = _rank_eval(eng, test, queries, rerank=False)
            t0 = time.time()
            info = model.refit_ranker()
            t_cv = time.time() - t0
            X, y, w, g = model.rows.arrays()
            fit_s = {}
            for kind in RANKER_KINDS:
                t1 = time.time()
                model.ranker = make_ranker(kind).fit(X, y, w, g)
                model.ranker_shift = float((info.get("metrics", {}).get(kind) or {}).get("shift", 0.0))
                fit_s[kind] = time.time() - t1
                res[kind] = _rank_eval(eng, test, queries, rerank=True)
            run = {"scenario": scen, "seed": seed, "train": len(train), "test": len(test), "rows": int(len(y)),
                   "chosen": info.get("kind"), "cv": info.get("metrics", {}), "test_metrics": res,
                   "seconds": {"train": round(t_train, 1), "compare": round(t_cv, 1),
                               "fit": {k: round(v, 1) for k, v in fit_s.items()}}}
            report["runs"].append(run)
            if verbose:
                print("Scenario %s, split %d: trained on %d changes (%d rows), tested on %d - CV chose: %s"
                      % (scen, seed, len(train), len(y), len(test), RANKER_LABEL.get(run["chosen"], run["chosen"])))
                for c in configs:
                    m = res[c]
                    cvm = (run["cv"].get(c) or {}).get("map")
                    print("   %-30s MAP %5.1f  P@10 %5.1f  R@20 %5.1f  R@50 %5.1f | listed %5.1f: recall %5.1f "
                          "precision %5.1f | CV MAP %s" % (
                              c, 100 * m["map"], 100 * m["p10"], 100 * m["r20"], 100 * m["r50"], m["n_thr"],
                              100 * m["rec_thr"], 100 * m["prec_thr"], "%.1f" % (100 * cvm) if cvm else "-"))
    report["seconds"] = round(time.time() - t_all, 1)
    summary: Dict[str, Dict[str, Dict[str, float]]] = {}
    for scen in scenarios:
        runs = [r for r in report["runs"] if r["scenario"] == scen]
        summary[scen] = {}
        for c in configs:
            summary[scen][c] = {k: float(np.mean([r["test_metrics"][c][k] for r in runs]))
                                for k in runs[0]["test_metrics"][c]}
            summary[scen][c]["map_sd"] = float(np.std([r["test_metrics"][c]["map"] for r in runs]))
        summary[scen]["chosen"] = {"kinds": [r["chosen"] for r in runs]}  # type: ignore[assignment]
    report["summary"] = summary
    if verbose:
        print("Total time %.0f s" % report["seconds"])
    if target is None:
        shutil.rmtree(tmp, ignore_errors=True)
    return report

