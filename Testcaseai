            app.v_auto_export.set(True)
            app.nb.select(app.tab_work)
            app.act_find()
            pump(120)
            self.assertTrue(app.last_run.get("llm"))
            self.assertTrue(os.path.isfile(export))
            self.assertIn("confirmed", app.lbl_status.cget("text"))
            st = Counter(a["status"] for a in app.summary)
            self.assertGreater(st[STATUS_LLM], 50)
            app.tree_ch.selection_set(cid)
            pump()
            rows = app.tree_tc.get_children("")
            decisions = [app.tree_tc.set(r, "dec") for r in rows]
            self.assertEqual(decisions[0], "Confirmed (you)")                  # trained earlier in this test: wins
            self.assertIn("Confirmed (LLM)", decisions)
            self.assertEqual(decisions, sorted(decisions, key=lambda d: [
                "Confirmed (you)", "Confirmed (LLM)", "Not checked", "Rejected (LLM)", "Rejected (you)"].index(d)))
            app.tree_tc.selection_set(rows[decisions.index("Confirmed (LLM)")])
            pump()
            self.assertIn("Local LLM:", app.txt_why.get("1.0", "end"))
            rej = [r for r in rows if app.tree_tc.set(r, "dec") == "Rejected (LLM)"][0]
            rej_id = app.tree_tc.set(rej, "tc")
            app.tree_tc.selection_set(rej)
