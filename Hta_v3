for _i in range(1, 703):  # A .. ZZ
    _s, _n = "", _i
    while _n:
        _n, _r = divmod(_n - 1, 26)
        _s = chr(65 + _r) + _s
    _COLNUM[_s] = _i
del _i, _s, _n, _r


def _xl_row_values(el: Any, shared: List[str], ns: str) -> list:
    """Values of one <row> element (shared by the lxml and stdlib readers)."""
    tag_c, tag_v, tag_is, tag_t = ns + "c", ns + "v", ns + "is", ns + "t"
    vals: list = []
    for c in el:
        if c.tag != tag_c:
            continue
        ref = c.get("r")
        if ref:
            col = _COLNUM.get(ref.rstrip(_DIGITS))
            if col is None:
                col = _xl_col(ref)
        else:
            col = len(vals) + 1
        t = c.get("t")
        v: Any = None
        if t == "inlineStr":
            v = ""
            for ch in c:
                if ch.tag == tag_is:
                    v = "".join(x.text or "" for x in ch.iter(tag_t))
                    break
        else:
            txt = None
            for ch in c:
                if ch.tag == tag_v:
                    txt = ch.text
                    break
            if txt is not None:
                if t is None or t == "n":
                    v = _xl_num(txt)
                elif t == "s":
                    v = shared[int(txt)]
                elif t == "b":
                    v = txt == "1"
                elif t in ("str", "e"):
                    v = txt
                else:
                    v = _xl_num(txt)
        n = len(vals)
        if col == n + 1:
            vals.append(v)
        elif col > n + 1:
            vals.extend([None] * (col - 1 - n))
            vals.append(v)
        else:
            vals[col - 1] = v
    return vals


def read_xlsx_values(path: Any, sheets: Optional[Sequence[str]] = None) -> "OrderedDict[str, List[list]]":
    """Fast read-only cell values of an .xlsx (zip + streaming XML, much faster than openpyxl).
    -> {sheet title: [row values ...]} with list index 0 = Excel row 1.
    Rows are streamed (flat memory) and decoded with cached column lookups."""
    import zipfile
    ns = _XL_NS
    tag_row = ns + "row"
    out: "OrderedDict[str, List[list]]" = OrderedDict()
    with zipfile.ZipFile(Path(path)) as z:
        names = set(z.namelist())
        parts = _xlsx_sheet_parts(z)
        shared: List[str] = []
        if "xl/sharedStrings.xml" in names and any(sheets is None or t in sheets for t in parts):
            data = z.read("xl/sharedStrings.xml")
            sst = ET.fromstring(data)
            tag_t, tag_r = ns + "t", ns + "r"
            for si in sst.iter(ns + "si"):
                pieces = []
                for ch in si:
                    if ch.tag == tag_t:
                        pieces.append(ch.text or "")
                    elif ch.tag == tag_r:
                        t = ch.find(tag_t)
                        pieces.append((t.text or "") if t is not None else "")
                shared.append("".join(pieces))
            del sst, data
        for title, part in parts.items():
            if sheets is not None and title not in sheets:
                continue
            if part not in names:
                continue
            rows: List[list] = []

            def take(el: Any) -> None:
                rnum = int(el.get("r") or len(rows) + 1)
                vals = _xl_row_values(el, shared, ns)
                if rnum > len(rows) + 1:
                    rows.extend([[] for _ in range(rnum - 1 - len(rows))])
                rows.append(vals)

            with z.open(part) as fh:  # streamed row by row: flat memory on any sheet size
                for _, el in ET.iterparse(fh):
                    if el.tag == tag_row:
                        take(el)
                        el.clear()
            out[title] = rows
    return out


def _openpyxl_values(path: Any, sheets: Optional[Sequence[str]] = None) -> "OrderedDict[str, List[list]]":
    wb = openpyxl.load_workbook(Path(path), read_only=True, data_only=True)
    try:
        return OrderedDict((ws.title, [list(r) for r in ws.iter_rows(values_only=True)])
                           for ws in wb.worksheets if sheets is None or ws.title in sheets)
    finally:
        wb.close()


def xlsx_values(path: Any, sheets: Optional[Sequence[str]] = None) -> "OrderedDict[str, List[list]]":
    """Fast reader with openpyxl fallback (e.g. for unusual files)."""
    try:
        return read_xlsx_values(path, sheets)
    except Exception as e:
        log.debug("fast xlsx reader fell back to openpyxl: %s", e)
        _require_openpyxl()
        return _openpyxl_values(path, sheets)


def _row_get(row: Sequence[Any], col: Optional[int]) -> Any:
    return row[col - 1] if col and col - 1 < len(row) else None


def _header_from_rows(rows: Sequence[Sequence[Any]], max_scan: int = 10) -> Tuple[int, Dict[str, int]]:
    for r in range(min(len(rows), max_scan)):
        cmap: Dict[str, int] = {}
        for c, v in enumerate(list(rows[r])[:60], 1):
            if v is None:
                continue
            a = _HEADER_ALIASES.get(norm_key(v))
            if a and a not in cmap:
                cmap[a] = c
        if "name" in cmap and len(cmap) >= 2:
            return r + 1, cmap
    return 0, {}


def _find_header(ws: Any, max_scan: int = 10) -> Tuple[int, Dict[str, int]]:
    for r in range(1, min(ws.max_row, max_scan) + 1):
        cmap: Dict[str, int] = {}
        for c in range(1, min(ws.max_column, 60) + 1):
            v = ws.cell(r, c).value
            if v is None:
                continue
            a = _HEADER_ALIASES.get(norm_key(v))
            if a and a not in cmap:
                cmap[a] = c
        if "name" in cmap and len(cmap) >= 2:
            return r, cmap
    return 0, {}


def import_excel(path: Any, progress: Optional[Callable[[str], None]] = None) -> SignalTable:
    """Read a signal-map workbook (column order free, extra columns ignored)."""
    path = Path(path)
    t0 = time.perf_counter()
    data = xlsx_values(path)
    meta: Dict[str, Any] = {"excel": str(path)}
    for r in (data.get(SHEET_INDEX) or [])[1:6]:
        if r and r[0]:
            meta[norm_key(r[0])] = r[1] if len(r) > 1 else None
    widgets: List[Widget] = []
    have_instances = True

    def i_or_none(v: Any) -> Optional[int]:
        f = to_float(v)
        return int(f) if f is not None else None

    for n, (title, rows) in enumerate(data.items(), 1):
        if title.lower() in RESERVED_SHEETS:
            continue
        hdr, cmap = _header_from_rows(rows)
        if not cmap:
            continue
        if progress:
            progress(f"Reading sheet {n}/{len(data)}: {title}")
        if "instance" not in cmap:
            have_instances = False
        c = cmap.get
        for i in range(hdr, len(rows)):
            row = rows[i]
            name = _cell_str(_row_get(row, c("name")))
            if not name:
                continue
            inst = to_float(_row_get(row, c("instance")))
            wtype = _cell_str(_row_get(row, c("wtype"))) or "Other"
            wgt = Widget(
                tab=_cell_str(_row_get(row, c("tab"))) or title, name=name,
                wtype=wtype if wtype in WIDGET_TYPES else normalize_type(wtype),
                access=(_cell_str(_row_get(row, c("access"))) or "RW").upper(),
                min=to_float(_row_get(row, c("min"))), max=to_float(_row_get(row, c("max"))),
                step=to_float(_row_get(row, c("step"))), unit=_cell_str(_row_get(row, c("unit"))),
                options=_cell_str(_row_get(row, c("options"))), current=_cell_str(_row_get(row, c("current"))),
                set_value=_cell_str(_row_get(row, c("set_value"))), critical=_truthy(_row_get(row, c("critical"))),
                path=_cell_str(_row_get(row, c("path"))), x=i_or_none(_row_get(row, c("x"))),
                y=i_or_none(_row_get(row, c("y"))), w=i_or_none(_row_get(row, c("w"))),
                h=i_or_none(_row_get(row, c("h"))), group=_cell_str(_row_get(row, c("group"))),
                locator=_cell_str(_row_get(row, c("locator"))), source=_cell_str(_row_get(row, c("source"))),
                raw=_cell_str(_row_get(row, c("raw"))), instance=int(inst) if inst else 1, sheet=title, row=i + 1)
            if inst is None:
                have_instances = False
            widgets.append(wgt)
    table = SignalTable(widgets, meta)
    table.finalize(keep_instances=have_instances)
    log.info("Loaded %d widgets on %d tabs from %s (%.1f s)", len(table), len(table.tabs()), path.name,
             time.perf_counter() - t0)
    return table


def excel_value_updates(table: SignalTable) -> List[Tuple[str, int, Any, Any]]:
    """(sheet, row, Current Value, Set Value) for every widget that came from a workbook row."""
    return [(w.sheet, w.row, _excel_value(w, "current"), _excel_value(w, "set_value"))
            for w in table if w.sheet and w.row]


class _FastPathUnsupported(Exception):
    """The in-place XML patcher met something it does not handle -> use openpyxl instead."""


_XML_BAD_CHARS = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f]")
_XML_SPACE = "{http://www.w3.org/XML/1998/namespace}space"


def _xl_clean(v: Any) -> Any:
    """Strip characters Excel cannot store (openpyxl raises IllegalCharacterError on them)."""
    return _XML_BAD_CHARS.sub("", v)[:32767] if isinstance(v, str) else v


def _col_letters(n: int) -> str:
    s = ""
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def _xl_cell_text(c: Any, shared: List[str], ns: str) -> Any:
    t = c.get("t", "n")
    if t == "inlineStr":
        is_ = c.find(ns + "is")
        return "".join(x.text or "" for x in is_.iter(ns + "t")) if is_ is not None else ""
    v = c.find(ns + "v")
    if v is None or v.text is None:
        return None
    if t == "s":
        try:
            return shared[int(v.text)]
        except (ValueError, IndexError):
            return None
    return v.text


def _xl_set_cell(row_el: Any, col: int, rnum: int, value: Any, ns: str) -> None:
    ref = _col_letters(col) + str(rnum)
    cell = None
    insert_at = len(row_el)
    for i, c in enumerate(row_el):
        r = c.get("r")
        if r is None:
            raise _FastPathUnsupported("cell without reference")
        cc = _xl_col(r)
        if cc == col:
            cell = c
            break
        if cc > col:
            insert_at = i
            break
    if cell is None:
        if value is None:
            return
        cell = LET.Element(ns + "c", r=ref)
        row_el.insert(insert_at, cell)
    elif cell.find(ns + "f") is not None:
        raise _FastPathUnsupported("formula cell")  # keep calcChain consistent -> openpyxl
    for ch in list(cell):
        if ch.tag in (ns + "v", ns + "is", ns + "f"):
            cell.remove(ch)
    cell.attrib.pop("t", None)
    if value is None:
        return
    if isinstance(value, (int, float)) and not isinstance(value, bool) and value == value \
            and value not in (float("inf"), float("-inf")):
        v = LET.Element(ns + "v")
        v.text = str(value) if isinstance(value, int) else "%.16g" % value
        cell.insert(0, v)
        return
    s = _XML_BAD_CHARS.sub("", str(value))[:32767]
    cell.set("t", "inlineStr")
    is_ = LET.Element(ns + "is")
    t = LET.SubElement(is_, ns + "t")
    t.text = s
    if s != s.strip():
        t.set(_XML_SPACE, "preserve")
    cell.insert(0, is_)


def _xlsx_sheet_parts(z: Any) -> "OrderedDict[str, str]":
    """{sheet title: zip part name} of an open .xlsx ZipFile (workbook order)."""
    ns = _XL_NS
    wbx = ET.fromstring(z.read("xl/workbook.xml"))
    rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
    targets = {r.get("Id"): r.get("Target", "") for r in rels}
    out: "OrderedDict[str, str]" = OrderedDict()
    for sh in wbx.iter(ns + "sheet"):
        target = targets.get(sh.get(_XL_RNS + "id"), "")
        part = target.lstrip("/") if target.startswith("/") else "xl/" + target
        out[sh.get("name")] = re.sub(r"[^/]+/\.\./", "", part)
    return out


def _zip_rewrite(z: Any, out: Path, patched: Dict[str, bytes]) -> None:
    """Copy every entry of open ZipFile *z* to *out* (atomic replace), swapping in *patched* parts."""
    import zipfile
    tmp = out.with_name(out.name + ".~tmp")
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as zo:
            for info in z.infolist():
                data = patched.get(info.filename)
                if data is None:
                    zo.writestr(info, z.read(info.filename))
                else:
                    zi = zipfile.ZipInfo(info.filename, date_time=time.localtime()[:6])
                    zi.compress_type = zipfile.ZIP_DEFLATED
                    zi.external_attr = info.external_attr
                    zo.writestr(zi, data)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise
    z.close()
    try:
        os.replace(str(tmp), str(out))
    except PermissionError as e:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise PermissionError(f"Cannot write {out} - close it in Excel first.") from e


_COL_LETTERS = [""] + [_col_letters(i) for i in range(1, 257)]


def _xl_esc(s: str) -> str:
    if _XML_BAD_CHARS.search(s):
        s = _XML_BAD_CHARS.sub("", s)
    if len(s) > 32767:
        s = s[:32767]
    if "&" in s:
        s = s.replace("&", "&amp;")
    if "<" in s:
        s = s.replace("<", "&lt;")
    if ">" in s:
        s = s.replace(">", "&gt;")
    if "\r" in s:
        s = s.replace("\r", "&#13;")
    return s


def _xl_rows_xml(rows: Iterable[Sequence[Any]], first_row: int) -> Tuple[str, int, int]:
    """SpreadsheetML <row> elements for *rows* (inline strings, like openpyxl writes them).
    -> (xml, last row number, widest column)."""
    parts: List[str] = []
    add = parts.append
    letters = _COL_LETTERS
    rnum = first_row - 1
    maxc = 0
    for row in rows:
        rnum += 1
        rs = str(rnum)
        add('<row r="%s">' % rs)
        for j, v in enumerate(row, 1):
            if v is None:
                continue
            ref = (letters[j] if j < len(letters) else _col_letters(j)) + rs
            if isinstance(v, str):
                if not v:
                    continue
                if v[0] in " \t\n" or v[-1] in " \t\n":
                    add('<c r="%s" t="inlineStr"><is><t xml:space="preserve">%s</t></is></c>' % (ref, _xl_esc(v)))
                else:
                    add('<c r="%s" t="inlineStr"><is><t>%s</t></is></c>' % (ref, _xl_esc(v)))
            elif isinstance(v, bool):
                add('<c r="%s" t="b"><v>%d</v></c>' % (ref, v))
            elif isinstance(v, int):
                add('<c r="%s"><v>%d</v></c>' % (ref, v))
            elif isinstance(v, float):
                if v != v or v in (float("inf"), float("-inf")):
                    continue  # openpyxl writes these as empty cells too
                add('<c r="%s"><v>%.16g</v></c>' % (ref, v))  # same number format as openpyxl
            else:
                add('<c r="%s" t="inlineStr"><is><t>%s</t></is></c>' % (ref, _xl_esc(str(v))))
            if j > maxc:
                maxc = j
        add("</row>")
    return "".join(parts), rnum, maxc


_DIM_RE = re.compile(rb'<dimension ref="([A-Z]+)(\d+)(?::([A-Z]+)(\d+))?"\s*/>')


def _inject_rows(path: Path, payload: Dict[str, Tuple[int, List[Sequence[Any]]]]) -> None:
    """Append pre-built data rows to sheets of a workbook just written by openpyxl.
    openpyxl writes structure (headers, styles, rules, validations, links); rows are streamed in here
    as plain XML - several times faster than creating ~250k openpyxl Cell objects."""
    import zipfile
    z = zipfile.ZipFile(path)
    try:
        parts = _xlsx_sheet_parts(z)
        patched: Dict[str, bytes] = {}
        for title, (first, rows) in payload.items():
            if not rows:
                continue
            part = parts[title]
            xml = z.read(part)
            body, last, maxc = _xl_rows_xml(rows, first)
            data = body.encode("utf-8", "replace")
            if b"</sheetData>" in xml:
                if xml.count(b"</sheetData>") != 1:
                    raise ValueError("unexpected sheet XML in " + part)
                head, tail = xml.split(b"</sheetData>")
                if re.search(rb'<row r="(\d+)"', head) and max(int(x) for x in re.findall(rb'<row r="(\d+)"', head)) >= first:
                    raise ValueError("rows already present in " + part)
                xml = head + data + b"</sheetData>" + tail
            elif re.search(rb"<sheetData\s*/>", xml):
                xml = re.sub(rb"<sheetData\s*/>", lambda m: b"<sheetData>" + data + b"</sheetData>", xml, 1)
            else:
                raise ValueError("no sheetData in " + part)
            m = _DIM_RE.search(xml)
            if m:
                c2 = max(_xl_col((m.group(3) or m.group(1)).decode()), maxc)
                r2 = max(int(m.group(4) or m.group(2)), last)
                xml = xml[:m.start()] + ('<dimension ref="A1:%s%d"/>' % (_col_letters(c2), r2)).encode() + xml[m.end():]
            patched[part] = xml
        _zip_rewrite(z, path, patched)
    finally:
        z.close()


def _fast_apply_excel_updates(path: Path, updates: Sequence[Tuple[str, int, Any, Any]], out: Path) -> Path:
    """Patch only the touched worksheet XML parts in place (zip copy + lxml) - ~10x faster than
    loading/saving the whole workbook with openpyxl; formatting, rules and other parts are untouched."""
    import zipfile
    if not HAVE_LXML:
        raise _FastPathUnsupported("lxml not installed")
    ns = _XL_NS
    by_sheet: Dict[str, Dict[int, Tuple[Any, Any]]] = {}
    for sheet, row, cur, sv in updates:
        if sheet and row:
            by_sheet.setdefault(str(sheet), {})[int(row)] = (cur, sv)
    parser = LET.XMLParser(huge_tree=True, remove_blank_text=False, resolve_entities=False)
    patched: Dict[str, bytes] = {}
    z = zipfile.ZipFile(path)
    try:
        names = set(z.namelist())
        parts = _xlsx_sheet_parts(z)
        shared: List[str] = []
        todo = [s for s in by_sheet if s in parts and parts[s] in names]
        if todo and "xl/sharedStrings.xml" in names:
            for si in LET.fromstring(z.read("xl/sharedStrings.xml"), parser).iter(ns + "si"):
                shared.append("".join(t.text or "" for t in si.iter(ns + "t")
                                      if t.getparent().tag != ns + "rPh"))
        for sheet in todo:
            root = LET.fromstring(z.read(parts[sheet]), parser)
            sd = root.find(ns + "sheetData")
            if sd is None:
                continue
            rows: Dict[int, Any] = {}
            for r in sd.iterchildren(ns + "row"):
                rn = r.get("r")
                if rn is None:
                    raise _FastPathUnsupported("row without number")
                rows[int(rn)] = r
            head_rows = []
            for rn in range(1, 11):
                vals: list = []
                r = rows.get(rn)
                if r is not None:
                    for c in r.iterchildren(ns + "c"):
                        col = _xl_col(c.get("r") or "A1")
                        if col > 60:
                            break
                        vals.extend([None] * (col - 1 - len(vals)))
                        vals.append(_xl_cell_text(c, shared, ns))
                head_rows.append(vals)
            _, cmap = _header_from_rows(head_rows)
            ccur, cset = cmap.get("current"), cmap.get("set_value")
            if not (ccur or cset):
                continue
            for rn, (cur, sv) in by_sheet[sheet].items():
                r = rows.get(rn)
                if r is None:
                    if cur is None and sv is None:
                        continue
                    raise _FastPathUnsupported("row %d missing in %s" % (rn, sheet))
                if ccur:
                    _xl_set_cell(r, ccur, rn, cur, ns)
                if cset:
                    _xl_set_cell(r, cset, rn, sv, ns)
            patched[parts[sheet]] = LET.tostring(root, xml_declaration=True, encoding="UTF-8", standalone=True)
        _zip_rewrite(z, out, patched)
    finally:
        z.close()
    return out


def apply_excel_updates(path: Any, updates: Sequence[Tuple[str, int, Any, Any]], out_path: Any = None) -> Path:
    """Write Current/Set Value cells into the workbook (formatting & other sheets kept).
    Fast in-place XML patch first; full openpyxl load/save as the fallback."""
    path = Path(path)
    out = Path(out_path) if out_path else path
    if path.suffix.lower() in (".xlsx", ".xlsm"):
        try:
            return _fast_apply_excel_updates(path, updates, out)
        except PermissionError:
            raise
        except Exception as e:
            log.debug("fast Excel update fell back to openpyxl: %s", e)
    _require_openpyxl()
    wb = openpyxl.load_workbook(path, keep_vba=path.suffix.lower() == ".xlsm")
    headers: Dict[str, Dict[str, int]] = {}
    for sheet, row, cur, sv in updates:
        if sheet not in wb.sheetnames:
            continue
        ws = wb[sheet]
        if sheet not in headers:
            headers[sheet] = _find_header(ws)[1]
        cmap = headers[sheet]
        if "current" in cmap:
            ws.cell(row, cmap["current"]).value = _xl_clean(cur)
        if "set_value" in cmap:
            ws.cell(row, cmap["set_value"]).value = _xl_clean(sv)
    try:
        wb.save(out)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {out} - close it in Excel first.") from e
    return out


def update_excel_values(path: Any, table: SignalTable, out_path: Any = None) -> Path:
    """Write Current/Set Value back into the original workbook (formatting & other sheets kept)."""
    return apply_excel_updates(path, excel_value_updates(table), out_path)


