@dataclass
class CmdLine:
    level: str   # ok | value | info | warn | error | action
    text: str


def parse_command_value(rest: str) -> Tuple[str, Any]:
    r = (rest or "").strip()
    if r == "" or r.startswith("?"):
        return "read", None
    if r == "!":
        return "press", None
    if r[:2] in ("+=", "-="):
        d = to_float(r[2:])
        if d is None:
            raise ValueError(f"'{r}' - expected a number after {r[:2]}")
        return "rel", d if r[0] == "+" else -d
    if r in ("++", "--"):
        return "step", 1 if r == "++" else -1
    if r[0] in "=:":
        r = r[1:].strip()
        if not r:
            raise ValueError("value missing after '='")
    if r.upper() in ("MIN", "MAX"):
        return r.lower(), None
    return "set", r


def split_statements(line: str) -> List[str]:
    out, cur, quote = [], [], None
    for ch in line or "":
        if quote:
            cur.append(ch)
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
            cur.append(ch)
        elif ch in ";\n":
            out.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    out.append("".join(cur))
    return [s.strip() for s in out if s.strip()]


class CommandEngine:
    """Executes console lines. Runs on the worker thread (owns the backend)."""

    def __init__(self, table: SignalTable, keywords: KeywordMap, settings: Settings,
                 get_ctl: Callable[[], Optional[Controller]]):
        self.table, self.kw, self.s, self.get_ctl = table, keywords, settings, get_ctl
        self.stop = threading.Event()

    def bind(self, table: SignalTable, keywords: KeywordMap) -> None:
        self.table, self.kw = table, keywords

    # ---------------------------------------------------------------- public
    def execute(self, line: str, dry: bool = False, stop: Optional[threading.Event] = None,
                depth: int = 0) -> List[CmdLine]:
        if stop is not None:
            self.stop = stop
        if depth > 6:
            return [CmdLine("error", "macro nesting too deep")]
        out: List[CmdLine] = []
        for stmt in split_statements(line):
            if self.stop.is_set():
                out.append(CmdLine("warn", "stopped"))
                break
            try:
                out += self._one(stmt, dry, depth)
            except (BackendError, KeyError, ValueError, RuntimeError) as e:
                msg = e.args[0] if isinstance(e, KeyError) and e.args else str(e)
                out.append(CmdLine("error", f"{stmt}: {msg}"))
            except Exception as e:
                log.debug(traceback.format_exc())
                out.append(CmdLine("error", f"{stmt}: {type(e).__name__}: {e}"))
        return out

    # --------------------------------------------------------------- helpers
    def _ctl(self) -> Controller:
        c = self.get_ctl()
        if c is None:
            raise BackendError("not connected - press F2 (HTA) or type CONNECT SIM")
        return c

    @staticmethod
    def _fmt(w: Widget, v: Optional[str]) -> str:
        return (v if v is not None else "<not readable>") + (f" {w.unit}" if w.unit and v else "")

    def _one(self, stmt: str, dry: bool, depth: int) -> List[CmdLine]:
        s = stmt.strip()
        if not s or s.startswith("#"):
            return []
        head, _, tail = s.partition(" ")
        h = head.upper()
        if h in CONSOLE_BUILTINS:
            return self._builtin(h, tail.strip(), dry, depth)
        m = self.kw.match(s)
        if m is None:
            word = re.match(r"[A-Za-z]+", s)
            guess = difflib.get_close_matches((word.group(0) if word else s)[:8].upper(), self.kw.words(), n=3,
                                              cutoff=0.5)
            return [CmdLine("error", f"unknown keyword/command '{head}'"
                            + (f" - did you mean {', '.join(guess)}?" if guess else "") + "   (HELP / KEYS)")]
        k, rest = m
        return self._keyword(k, rest, dry, depth)

    def _keyword(self, k: Keyword, rest: str, dry: bool, depth: int) -> List[CmdLine]:
        if not k.enabled:
            return [CmdLine("error", f"{k.keyword} is disabled in Keywords.xlsx")]
        if k.kind == "Macro":
            tmpl = k.macro
            val = rest.lstrip("=:").strip()
            if "$" in tmpl:
                if not val:
                    return [CmdLine("error", f"{k.keyword} needs a value, e.g. {example_command(k)}")]
                cmd = tmpl.replace("$", val)
            else:
                cmd = tmpl
            return [CmdLine("info", f"{k.keyword} -> {cmd}")] + self.execute(cmd, dry, None, depth + 1)
        if not k.widgets:
            return [CmdLine("error", f"{k.keyword}: no target in this workbook ({k.problem or 'Keywords REFRESH?'})")]
        op, val = parse_command_value(rest)
        ctl = self._ctl()
        out: List[CmdLine] = []
        for w in k.widgets:
            if self.stop.is_set():
                break
            tag = f"{k.keyword}" + (f"[{w.label}]" if len(k.widgets) > 1 else "")
            if op == "read":
                out.append(CmdLine("value", f"{tag} = {self._fmt(w, ctl.read(w))}    ({w.key})"))
                continue
            if op == "press":
                r = ctl.press(w, dry)
                out.append(CmdLine("ok" if r.ok else "error",
                                   f"{tag} pressed -> {r.after or '?'}" if r.ok else f"{tag}: {r.message}"))
                continue
            if op in ("min", "max"):
                lim = w.min if op == "min" else w.max
                if lim is None:
                    out.append(CmdLine("error", f"{tag}: no {op.upper()} limit known"))
                    continue
                target = fmt_num(lim)
            elif op in ("rel", "step"):
                cur = to_float(ctl.read(w))
                if cur is None:
                    out.append(CmdLine("error", f"{tag}: current value not numeric"))
                    continue
                delta = val if op == "rel" else (w.step or 1.0) * val
                target = fmt_num(round(cur + delta, 10))
            else:
                target = str(val)
            r = ctl.set_value(w, target, dry)
            if r.ok and r.dry_run:
                out.append(CmdLine("ok", f"{tag} = {self._fmt(w, r.requested)}  (dry run - not sent)"))
            elif r.ok:
                extra = f"  [{r.message}]" if r.message else ""
                out.append(CmdLine("ok", f"{tag} = {self._fmt(w, r.after or r.requested)}{extra}"
                                         f"    (was {r.before or '?'})"))
            else:
                hint = f"   allowed: {allowed_text(k)}" if r.method == "validate" else ""
                out.append(CmdLine("error", f"{tag} = {target}: {r.message}{hint}"))
        return out

    # -------------------------------------------------------------- built-ins
    def _builtin(self, h: str, arg: str, dry: bool, depth: int) -> List[CmdLine]:
        if h == "HELP":
            if arg:
                k = self.kw.get(arg)
                if k is None:
                    return [CmdLine("error", f"no keyword '{arg}'")]
                lines = [CmdLine("info", f"{k.keyword}  [{k.kind}]  {'' if k.enabled else '(disabled)'}"),
                         CmdLine("info", f"  target : {k.target_text()}"),
                         CmdLine("info", f"  allowed: {allowed_text(k)}")]
                for w in k.widgets[:12]:
                    lines.append(CmdLine("info", f"  {w.key}: {w.wtype} {w.access} {w.limits_text()} "
                                                 f"{w.options} current={w.current or '?'}"))
                lines.append(CmdLine("info", f"  example: {example_command(k)}"))
                if k.problem:
                    lines.append(CmdLine("warn", f"  problem: {k.problem}"))
                return lines
            return [CmdLine("info", t) for t in (
                "kw<value>  set      AWS100 | AWS 100 | AWS=100 | IGN ON | IGNON",
                "kw? / kw   read     kw+=5  kw-=5  kw++  kw--  kwMIN  kwMAX  kw! (press)",
                "a; b; c    several commands in one line     # comment",
            )] + [CmdLine("info", v) for v in CONSOLE_BUILTINS.values()]
        if h in ("KEYS", "LIST"):
            f = arg.lower()
            rows = []
            for k in self.kw.items:
                hay = f"{k.keyword} {k.target_text()} {k.description}".lower()
                if f and not all(t in hay for t in f.split()):
                    continue
                w = k.widgets[0] if k.widgets else None
                cur = f" = {w.current}" if (w is not None and w.current and len(k.widgets) == 1) else ""
                rows.append(CmdLine("info", f"{k.keyword:<6} {k.kind[:6]:<6} {k.target_text()[:70]}{cur}"))
            more = len(rows) - 80
            return (rows[:80] or [CmdLine("warn", "no keyword matches")]) + \
                ([CmdLine("info", f"... {more} more (narrow with KEYS <filter>)")] if more > 0 else [])
        if h in ("READ", "GET"):
            if not arg:
                return [CmdLine("error", "READ needs keyword(s)")]
            out: List[CmdLine] = []
            for a in arg.replace(",", " ").split():
                out += self._one(a.rstrip("?") + "?", dry, depth)
            return out
        if h == "WAIT":
            m = re.fullmatch(r"\s*([\d.]+)\s*(ms|s)?\s*", arg)
            if not m:
                return [CmdLine("error", "WAIT <ms> | WAIT <n>s")]
            ms = float(m.group(1)) * (1000 if m.group(2) == "s" else 1)
            self.stop.wait(ms / 1000.0)
            return [CmdLine("info", f"waited {fmt_num(ms)} ms")]
        if h in ("START", "STOP", "RESET"):
            r = self._ctl().sim(h.lower(), dry)
            return [CmdLine("ok" if r.ok else "error",
                            f"simulation {h}: {r.after or r.message}" + (" (dry run)" if r.dry_run else "")
                            if r.ok else f"simulation {h} failed: {r.message}")] + \
                ([CmdLine("action", "read_tab")] if r.ok and h == "RESET" and not r.dry_run else [])
        if h in ("STATUS", "STAT"):
            c = self.get_ctl()
            if c is None:
                return [CmdLine("warn", "not connected")]
            return [CmdLine("value", f"backend {c.backend.kind}: {c.sim_status()}" + ("   [DRY RUN]" if dry else ""))]
        if h == "TAB":
            return [CmdLine("ok", f"HTA tab -> {self._ctl().backend.select_tab(arg)}")]
        if h == "MENU":
            r = self._ctl().invoke_menu(arg, dry)
            return [CmdLine("ok" if r.ok else "error", f"menu {r.after or arg}" if r.ok else r.message)]
        if h == "PRESS":
            return self._one(arg.strip() + "!", dry, depth)
        if h == "UNDO":
            r = self._ctl().revert_last(dry)
            if r is None:
                return [CmdLine("warn", "nothing to undo")]
            return [CmdLine("ok" if r.ok else "error", f"undo {r.key} -> {r.requested}  {r.message}")]
        if h == "ECHO":
            return [CmdLine("info", arg)]
        if h == "DRY":
            v = arg.strip().upper()
            if v not in ("ON", "OFF"):
                return [CmdLine("error", "DRY ON | DRY OFF")]
            return [CmdLine("action", f"dry:{v.lower()}"), CmdLine("info", f"dry run {v}")]
        if h == "CONNECT":
            return [CmdLine("action", "connect:" + ("sim" if arg.upper().startswith("SIM") else "hta"))]
        if h == "DISCONNECT":
            return [CmdLine("action", "disconnect")]
        return [CmdLine("action", h.lower() + (f":{arg}" if arg else ""))]   # APPLY RUN REFRESH CLS HIST


