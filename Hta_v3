            self.btn_all = QtWidgets.QPushButton("Install / update all")
            self.btn_close = QtWidgets.QPushButton("Close")
            for b in (self.btn_missing, self.btn_all):
                row2.addWidget(b)
            row2.addStretch(1)
            row2.addWidget(self.btn_close)
            lay.addLayout(row2)
            self.proc = QtCore.QProcess(self)
            self.proc.setProcessChannelMode(QtCore.QProcess.ProcessChannelMode.MergedChannels)
            self.proc.readyReadStandardOutput.connect(self._read)
            self.proc.finished.connect(self._done)
            self.btn_missing.clicked.connect(lambda: self._run(missing_requirements(required_only=False)))
            self.btn_all.clicked.connect(lambda: self._run(None))
            self.btn_close.clicked.connect(self.close)
            self.refresh()

        def refresh(self) -> None:
            reqs = check_requirements()
            self.table.setRowCount(len(reqs))
            for r, q in enumerate(reqs):
                vals = [q["package"], q["purpose"], "required" if q["required"] else "optional",
                        q["version"] if q["installed"] else "MISSING"]
                for c, v in enumerate(vals):
                    it = QtWidgets.QTableWidgetItem(v)
                    if c == 3:
                        it.setBackground(QtGui.QBrush(_COL["ok"] if q["installed"] else
                                                      (_COL["fail"] if q["required"] else _COL["pending"])))
                    self.table.setItem(r, c, it)
            if getattr(sys, "frozen", False):
                self.btn_missing.setEnabled(False)
                self.btn_all.setEnabled(False)
                self.out.setPlainText("Packaged executable - libraries are bundled.")

        def _run(self, packages: Optional[List[str]]) -> None:
            if packages is not None and not packages:
                self.out.appendPlainText("Nothing missing.")
                return
            self.s.pip_extra_args = self.extra.text().strip()
            try:
                self.s.save()
            except OSError:
                pass
            cmd = pip_command(packages, upgrade=True, extra=self.s.pip_extra_args)
            self.out.appendPlainText("> " + " ".join(cmd))
            self.btn_missing.setEnabled(False)
            self.btn_all.setEnabled(False)
            self.proc.start(cmd[0], cmd[1:])

        def _read(self) -> None:
            self.out.appendPlainText(bytes(self.proc.readAllStandardOutput()).decode("utf-8", "replace").rstrip())

        def _done(self, rc: int, _status=None) -> None:
            self.btn_missing.setEnabled(True)
            self.btn_all.setEnabled(True)
            self.out.appendPlainText("\nDone - restart HTA Bridge to use newly installed libraries." if rc == 0 else
                                     f"\npip exit code {rc}. Behind a proxy? Fill 'Extra pip arguments'.")
            self.refresh()

