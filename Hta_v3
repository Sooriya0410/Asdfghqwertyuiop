                self.stack.setCurrentIndex(0)
            else:
                self.edit.setText(w.set_value or w.current)
                self.stack.setCurrentIndex(2)
            self.refresh()

        def refresh(self) -> None:
            w = self.w
            if w is None:
                return
            self.cur.setText((w.current or "-") + (f" {w.unit}" if w.unit and w.current else ""))
            st = w.status
            self.cur.setStyleSheet("color:#C00000" if st.startswith(("FAIL", "Invalid")) else
                                   "color:#2E7D32" if st.startswith("OK") else "")
            self.cur.setToolTip(st)

        def _configure_spin(self, w: Widget) -> None:
            d = _decimals_for(w)
            self._lo = w.min if w.min is not None else -1e9
            self._hi = w.max if w.max is not None else 1e9
            self.spin.blockSignals(True)
            self.spin.setDecimals(d)
            self.spin.setRange(self._lo, self._hi)
            self.spin.setSingleStep(w.step or (10 ** -d if d else 1))
            self.spin.setSuffix(f" {w.unit}" if w.unit else "")
            v = to_float(w.set_value)
            v = v if v is not None else to_float(w.current)
            self.spin.setValue(v if v is not None else min(max(0.0, self._lo), self._hi))
            self.spin.blockSignals(False)
            has_range = w.min is not None and w.max is not None and w.max > w.min
            self.slider.setEnabled(has_range)
            self.lbl_lo.setText(fmt_num(w.min))
            self.lbl_hi.setText(fmt_num(w.max))
            self._spin_changed(self.spin.value())

        def _spin_changed(self, v: float) -> None:
            if self.slider.isEnabled() and self._hi > self._lo:
                self.slider.blockSignals(True)
                self.slider.setValue(int(round((v - self._lo) / (self._hi - self._lo) * 1000)))
                self.slider.blockSignals(False)

        def _slider_changed(self, pos: int) -> None:
            v = self._lo + (self._hi - self._lo) * pos / 1000.0
            st = self.spin.singleStep() or 0
            if st > 0:
                v = self._lo + round((v - self._lo) / st) * st
            self.spin.blockSignals(True)
            self.spin.setValue(v)
            self.spin.blockSignals(False)

        def _apply_num(self) -> None:
            self.spin.interpretText()
            self._emit(fmt_num(round(self.spin.value(), self.spin.decimals())))

