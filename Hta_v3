class BackendError(RuntimeError):
    pass


@dataclass
class WriteResult:
    key: str
    requested: str
    ok: bool = False
    before: str = ""
    after: str = ""
    message: str = ""
    dry_run: bool = False
    method: str = ""
    duration_ms: float = 0.0


@dataclass(eq=False)
class DlgControl:
    """One editable field of an HTA dialog (hardware / channel configuration ...)."""
    page: str
    label: str
    ctype: str                     # input | combo | checkbox | radio | cell | slider
    value: str = ""
    set_value: str = ""
    options: str = ""
    instance: int = 1
    status: str = ""
    wrapper: Any = None            # runtime UIA wrapper

    @property
    def key(self) -> str:
        base = f"{self.page}/{self.label}" if self.page else self.label
        return base + (f"#{self.instance}" if self.instance > 1 else "")

    def option_list(self) -> List[str]:
        return [o.strip() for o in re.split(r"[;|]", self.options or "") if o.strip()]


def dialog_validate(c: DlgControl, raw: Any) -> str:
    s = "" if raw is None else (fmt_num(raw) if isinstance(raw, float) else str(raw).strip())
    if c.ctype in ("checkbox", "radio"):
        if _truthy(s) or norm_key(s) in ("checked", "enabled", "selected", "true"):
            return "1"
        if norm_key(s) in ("0", "no", "false", "off", "n", "unchecked", "disabled", "unselected"):
            return "0"
        raise ValueError(f"{c.key}: use 1/0, on/off or yes/no")
    if c.ctype == "combo" and c.option_list():
        for o in c.option_list():
            if norm_key(o) == norm_key(s) and (norm_key(s) or o == s):
                return o
        raise ValueError(f"{c.key}: '{s}' is not one of {', '.join(c.option_list())}")
    return s


def assign_dlg_instances(items: Sequence[DlgControl]) -> None:
    seen: Counter = Counter()
    for it in items:
        k = (norm_key(it.page), norm_key(it.label))
        seen[k] += 1
        it.instance = seen[k]


class Backend:
    """Interface.  All calls of one backend instance must come from ONE thread
    (UI Automation COM objects are apartment bound) - the GUI uses a worker thread."""
    kind = "base"

    def __init__(self, settings: Settings):
        self.s = settings
        self.table: Optional[SignalTable] = None
        self.own_hwnd: Optional[int] = None

    def attach_table(self, table: SignalTable) -> None:
        self.table = table

    def connect(self) -> str:
        raise NotImplementedError

    def disconnect(self) -> None:
        pass

    @property
    def connected(self) -> bool:
        return False

    def tabs(self) -> List[str]:
        return self.table.tabs() if self.table else []

    def read(self, w: Widget, allow_switch: bool = True) -> Optional[str]:
        raise NotImplementedError

    def read_bulk(self, widgets: Sequence[Widget], allow_switch: bool = True,
                  stop: Optional[threading.Event] = None) -> Dict[Widget, Optional[str]]:
        out: Dict[Widget, Optional[str]] = {}
        for w in widgets:
            if stop is not None and stop.is_set():
                break
            try:
                out[w] = self.read(w, allow_switch)
            except Exception as e:
                log.debug("read %s: %s", w.key, e)
                out[w] = None
        return out

    def write(self, w: Widget, value: str) -> WriteResult:
        raise NotImplementedError

    def press(self, w: Widget) -> WriteResult:
        raise NotImplementedError

    # optional capabilities (HTA application level)
    def select_tab(self, name: str) -> str:
        return name

    def sim_control(self, action: str) -> WriteResult:
        raise BackendError(f"{self.kind}: simulation control not supported")

    def sim_status(self) -> str:
        return "unknown"

    def menu_paths(self) -> List[str]:
        return []

    def invoke_menu(self, path: str) -> str:
        raise BackendError(f"{self.kind}: menus not supported")

    def dialog_capture(self, menu_path: str = "", title_re: str = "") -> Tuple[str, List[DlgControl]]:
        raise BackendError(f"{self.kind}: dialogs not supported")

    def dialog_apply(self, menu_path: str, title_re: str, items: Sequence[DlgControl],
                     press: str = "OK") -> Tuple[str, List[WriteResult]]:
        raise BackendError(f"{self.kind}: dialogs not supported")


