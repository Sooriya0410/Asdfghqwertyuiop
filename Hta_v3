                "mv", "a", "ma", "pct", "percent", "rpm", "nm", "hz", "khz", "mm", "cm", "kg", "degc"}
_STOP_TOKENS = {"on", "off", "onoff", "the", "of", "and", "or", "to", "for", "an", "x"}
_POSITION_RE = re.compile(r"^(?:[fram][lr]|[lr][fr]|front|rear|left|right)$")
_TOKEN_RE = re.compile(r"[A-Z]{2,}[0-9A-Z]*(?![a-z])|[A-Z][a-z]+[0-9]*|[a-z]+[0-9]*|[A-Z][0-9]*|[0-9]+[A-Za-z]*")
_ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
CONSOLE_BUILTINS = {
    "HELP": "HELP [kw]            syntax help, or details of one keyword",
    "KEYS": "KEYS [filter]        list keywords (also LIST)",
    "LIST": "LIST [filter]        list keywords",
    "READ": "READ kw [kw ...]     read values (also GET, or kw?)",
    "GET": "GET kw [kw ...]      read values",
    "WAIT": "WAIT ms              pause (WAIT 500, WAIT 2s)",
    "START": "START                start the HTA simulation",
    "STOP": "STOP                 stop the HTA simulation",
    "RESET": "RESET                reset the HTA simulation",
    "STATUS": "STATUS               simulation / connection status (also STAT)",
    "STAT": "STAT                 simulation status",
    "TAB": "TAB name             switch the visible HTA tab",
    "MENU": "MENU path            click an HTA menu entry, e.g. MENU Settings->Hardware...",
    "PRESS": "PRESS kw             click a button once (same as kw!)",
    "UNDO": "UNDO                 write back the value before the last write",
    "ECHO": "ECHO text            print text",
    "DRY": "DRY ON|OFF           dry-run mode (validate + log only)",
    "APPLY": "APPLY                apply all pending Set Values (GUI)",
    "RUN": "RUN                  run the loaded sequence (GUI)",
    "REFRESH": "REFRESH              reload Keywords.xlsx",
    "CONNECT": "CONNECT [HTA|SIM]    connect to HTA or the simulator",
    "DISCONNECT": "DISCONNECT           disconnect",
    "CLS": "CLS                  clear the console",
    "HIST": "HIST                 command history",
}
RESERVED_WORDS = set(CONSOLE_BUILTINS) | {"ON", "OFF", "TRUE", "FALSE", "YES", "NO", "MIN", "MAX", "SET",
                                          "ALL", "EXIT", "QUIT", "HIGH", "LOW", "NONE"}
_WORD_VALUES = {"ON", "OFF", "TRUE", "FALSE", "YES", "NO", "MIN", "MAX", "HIGH", "LOW"}
_TYPE_PRIO = {"Input": 0, "Slider": 1, "Button": 2, "ComboBox": 3, "CheckBox": 4, "Other": 5,
              "Display": 6, "Label": 7}
_TYPE_LETTER = {"Input": "I", "Slider": "S", "Button": "B", "ComboBox": "C", "CheckBox": "C",
                "Other": "X", "Display": "D", "Label": "L"}
KW_KINDS = ("Signal", "Group", "Macro")


def name_tokens(name: str) -> List[Tuple[str, bool]]:
    """'v_wheel_fl_tractor_kmh' -> [('wheel',False), ('fl',True), ('tractor',False)]  (units/stop words out)."""
    n = re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", str(name or ""))
    toks: List[Tuple[str, str, bool]] = []
    for part in re.split(r"[^A-Za-z0-9]+", n):
        for t in _TOKEN_RE.findall(part):
            low = t.lower()
            letters = re.sub(r"[^a-z]", "", low)
            if not letters:
                continue
            acr = ((t.isupper() and len(t) >= 2) or (bool(re.search(r"\d", t)) and len(letters) <= 3)
                   or bool(_POSITION_RE.match(low)))
            toks.append((low, letters, acr))
    keep = [x for x in toks if x[0] not in _UNIT_TOKENS and x[1] not in _UNIT_TOKENS
            and x[0] not in _STOP_TOKENS]
    return [(l, a) for _, l, a in (keep or toks)]


def _abbr(letters: str, acr: bool, abbrev: Dict[str, str]) -> str:
    if acr:
        return letters.upper()
    a = abbrev.get(letters) or (abbrev.get(letters[:-1]) if letters.endswith("s") else None)
    return (a or letters).upper()


def _candidates_from_parts(parts: List[Tuple[str, bool, str]], lo: int, hi: int) -> List[str]:
    """parts = [(ABBR, is_acronym, letters)] -> readable keyword candidates, best first."""
    out: List[str] = []

    def add(s: str) -> None:
        s = re.sub(r"[^A-Z]", "", s.upper())
        if lo <= len(s) <= hi and s not in out and s not in RESERVED_WORDS:
            out.append(s)

    if not parts:
        return out
    n = len(parts)
    if n == 1:
        p, acr, letters = parts[0]
        add(p)
        if not acr:
            for k in (3, 4, 5):
                add(letters.upper()[:k])
    elif n == 2:
        (a, aa, _), (b, ba, _) = parts
        a_prefs = [len(a)] if aa else ([1, 2, 3] if ba else [3, 2, 1, 4])
        b_prefs = [len(b)] if ba else [1, 2, 3]
        for i in a_prefs:
            for j in b_prefs:
                add(a[:i] + b[:j])
    else:
        init = "".join(p if acr else p[0] for p, acr, _ in parts)
        pure = "".join(p[0] for p, _, _ in parts)
        add(init)
        add(pure)
        first, fa, _ = parts[0]
        rest = "".join(p if acr else p[0] for p, acr, _ in parts[1:])
        if not fa:
            for k in (2, 3):
                add(first[:k] + rest)
        add(init[:hi])
        add(pure[:hi])
    return out


def keyword_candidates(name: str, abbrev: Optional[Dict[str, str]] = None, lo: int = 3, hi: int = 5) -> List[str]:
    ab = abbrev or DEFAULT_ABBREV
    parts = [(_abbr(l, a, ab), a, l) for l, a in name_tokens(name)]
    return _candidates_from_parts(parts, lo, hi)


def _fallback_keyword(seed: str, used: set, lo: int, hi: int) -> str:
    s = re.sub(r"[^A-Z]", "", str(seed).upper()) or "KW"
    for length in range(max(lo, 2), hi + 1):
        base = (s + "X" * hi)[:length - 1]
        for c in _ALPHA:
            k = base + c
            if k not in used and k not in RESERVED_WORDS:
                return k
    for a in _ALPHA:
        for b in _ALPHA:
            k = (s + "XXX")[:hi - 2] + a + b
            if k not in used and k not in RESERVED_WORDS:
                return k
    raise RuntimeError("keyword space exhausted")


@dataclass(eq=False)
class Keyword:
    keyword: str
    kind: str = "Signal"
    targets: List[str] = field(default_factory=list)   # widget keys 'Tab/Name#n' (Signal / Group)
    macro: str = ""                                     # command template (Macro), '$' = value
    description: str = ""
    enabled: bool = True
    source: str = "auto"
    widgets: List[Widget] = field(default_factory=list)  # runtime: resolved targets
    problem: str = ""

    def target_text(self) -> str:
        return self.macro if self.kind == "Macro" else "; ".join(self.targets)


class KeywordMap:
    def __init__(self, items: Iterable[Keyword] = ()):
        self.items: List[Keyword] = []
        self.by_kw: Dict[str, Keyword] = {}
        self._maxlen = 0
        for k in items:
            self.add(k)

    def __len__(self) -> int:
        return len(self.items)

    def __iter__(self):
        return iter(self.items)

    def add(self, k: Keyword) -> bool:
        k.keyword = k.keyword.strip().upper()
        if not k.keyword or k.keyword in self.by_kw:
            return False
        self.items.append(k)
        self.by_kw[k.keyword] = k
        self._maxlen = max(self._maxlen, len(k.keyword))
        return True

    def get(self, kw: str) -> Optional[Keyword]:
        return self.by_kw.get(str(kw or "").strip().upper())

    def words(self) -> List[str]:
        return [k.keyword for k in self.items if k.enabled]

    def copy(self) -> "KeywordMap":
        return KeywordMap(Keyword(k.keyword, k.kind, list(k.targets), k.macro, k.description, k.enabled, k.source)
                          for k in self.items)

    def resolve(self, table: SignalTable) -> List[str]:
        """Attach widgets to keywords; set Widget.keyword. Returns problem messages."""
        problems: List[str] = []
        for w in table:
            w.keyword = ""
        primary: Dict[Widget, List[str]] = defaultdict(list)
        for k in self.items:
            k.widgets, k.problem = [], ""
            if k.kind == "Macro":
                if not k.macro.strip():
                    k.problem = "macro has no command"
                continue
            missing = []
            for t in k.targets:
                try:
                    k.widgets.append(table.find(t))
                except KeyError:
                    missing.append(t)
            if missing:
                k.problem = "not found: " + ", ".join(missing)
                problems.append(f"{k.keyword}: {k.problem}")
            if k.kind == "Signal":
                for w in k.widgets:
                    primary[w].append(k.keyword)
        for w, kws in primary.items():
            w.keyword = ", ".join(kws)
        return problems

    def match(self, stmt: str) -> Optional[Tuple[Keyword, str]]:
        """Longest keyword that prefixes stmt ('AWS100' -> AWS, '100')."""
        s = stmt.strip()
        up = s.upper()
        for n in range(min(self._maxlen, len(up)), 0, -1):   # longest prefix first, O(8) dict lookups
            k = self.by_kw.get(up[:n])
            if k is None:
                continue
            rest = s[n:]
            if rest and rest[0].isalpha():
                word = rest.strip().upper()
                labels = {norm_key(l) for w in k.widgets for l, _ in w.option_list()}
                if word not in _WORD_VALUES and norm_key(word) not in labels:
                    continue
            return k, rest.strip()
        return None

    def unmapped(self, table: SignalTable) -> List[Widget]:
        covered = {w for k in self.items if k.kind == "Signal" for w in k.widgets}
        return [w for w in table if w not in covered]


def example_command(k: Keyword) -> str:
    if k.kind == "Macro":
        return k.keyword + ("24" if "$" in k.macro else "")
    w = k.widgets[0] if k.widgets else None
    if w is None:
        return k.keyword
    if not w.writable:
        return k.keyword + "?"
    opts = w.option_list()
    if opts:
        return f"{k.keyword} {opts[0][0].upper()}"
    for v in (100.0, 10.0, 1.0):
        if (w.min is None or w.min <= v) and (w.max is None or v <= w.max):
            return k.keyword + fmt_num(v)
    return k.keyword + fmt_num(w.min if w.min is not None else 0)


def _common_limits(ws: Sequence[Widget]) -> Tuple[Optional[float], Optional[float]]:
    mins = [w.min for w in ws if w.min is not None]
    maxs = [w.max for w in ws if w.max is not None]
    return (max(mins) if len(mins) == len(ws) and mins else None,
            min(maxs) if len(maxs) == len(ws) and maxs else None)


def allowed_text(k: Keyword) -> str:
    """What the keyword accepts, from the box limits:  'AWS0 ... AWS150 km/h'  /  'IGN ON | IGN OFF'."""
    kw = k.keyword
    if k.kind == "Macro":
        return f"{kw}<value>  (checked by each command of the macro)" if "$" in k.macro else kw
    ws = k.widgets
    if not ws:
        return ""
    if not any(w.writable for w in ws):
        return f"{kw}?  (read only)"
    w = ws[0]
    opts = w.option_list()
    if opts:
        vals = " / ".join(v for _, v in opts)
        return " | ".join(f"{kw} {l.upper()}" for l, _ in opts) + (f"   (or {vals})" if vals else "")
    mn, mx = _common_limits(ws)
    unit = f" {w.unit}" if w.unit else ""
    if mn is not None and mx is not None:
        return f"{kw}{fmt_num(mn)} ... {kw}{fmt_num(mx)}{unit}   (any value in between)"
    if mn is not None:
        return f"{kw}{fmt_num(mn)} or more{unit}"
    if mx is not None:
        return f"up to {kw}{fmt_num(mx)}{unit}"
    return "any value (no limits known for this box)"


def find_families(table: SignalTable) -> List[Tuple[List[Tuple[str, bool]], List[Widget], List[str]]]:
    """Writable widgets differing only by a position token (fl/fr/rl/rr/al/ar/left/right ...)."""
    fam: Dict[tuple, List[Tuple[Widget, str]]] = defaultdict(list)
    stems: Dict[tuple, List[Tuple[str, bool]]] = {}
    for w in table:
        if not w.writable:
            continue
        toks = name_tokens(w.name)
        pos = [i for i, (l, _) in enumerate(toks) if _POSITION_RE.match(l)]
        if len(pos) != 1:
            continue
        stem = [t for i, t in enumerate(toks) if i != pos[0]]
        key = (w.tab, w.wtype, tuple(stem), pos[0])
        fam[key].append((w, toks[pos[0]][0]))
        stems[key] = stem
    return [(stems[k], [w for w, _ in v], [p for _, p in v]) for k, v in fam.items() if len(v) >= 2]


def generate_keywords(table: SignalTable, existing: Optional[KeywordMap] = None,
                      settings: Optional[Settings] = None, abbrev: Optional[Dict[str, str]] = None) -> KeywordMap:
    """Keep every existing keyword, add unique keywords for uncovered widgets (+ family groups)."""
    s = settings or Settings()
    lo, hi = max(2, s.keyword_min_len), max(s.keyword_min_len, s.keyword_max_len)
    ab = dict(DEFAULT_ABBREV)
    ab.update({k.lower(): v.upper() for k, v in (abbrev or {}).items() if k and v})
    km = existing.copy() if existing is not None else KeywordMap()
    km.resolve(table)
    used = set(km.by_kw) | RESERVED_WORDS
    covered: Dict[Widget, str] = {}
    for k in km.items:
        if k.kind == "Signal":
            for w in k.widgets:
                covered.setdefault(w, k.keyword)
    index = {w: i for i, w in enumerate(table.widgets)}
    groups: "OrderedDict[tuple, List[Widget]]" = OrderedDict()
    for w in table:
        groups.setdefault((w.tab, norm_key(w.name)), []).append(w)
    ordered = sorted(groups.values(), key=lambda ms: (min(_TYPE_PRIO.get(w.wtype, 5) for w in ms),
                                                      min(index[w] for w in ms)))
    added = 0

    def assign(w: Widget, kw: str) -> None:
        nonlocal added
        used.add(kw)
        desc = " ".join(x for x in (w.wtype, w.limits_text(), w.options) if x)
        k = Keyword(kw, "Signal", [w.key], description=desc, source="auto", widgets=[w])
        km.add(k)
        added += 1

    for members in ordered:
        members = sorted(members, key=lambda w: w.instance)
        todo = [w for w in members if w not in covered]
        if not todo:
            continue
        cands = keyword_candidates(members[0].name, ab, lo, hi)
        if not cands:
            letters = re.sub(r"[^A-Z]", "", members[0].name.upper())
            seed = letters + _TYPE_LETTER.get(members[0].wtype, "X")
            cands = [(seed + "X" * hi)[:max(lo, min(len(seed), hi))]]
            cands = [c for c in cands if c not in RESERVED_WORDS]
        if len(members) == 1:
            kw = next((c for c in cands if c not in used), None) or \
                _fallback_keyword(cands[0] if cands else members[0].name, used, lo, hi)
            assign(members[0], kw)
            continue
        base = covered.get(members[0]) if members[0] in covered else None
        if base is None or len(base) > hi - 1:
            base = next((c for c in cands if len(c) <= hi - 1 and c not in used), None)
        if base is None:
            base = _fallback_keyword(cands[0] if cands else members[0].name, used, lo, hi - 1)
        first_type = members[0].wtype
        for w in members:
            if w not in todo:
                continue
            if w is members[0]:
                kw = base
            else:
                opts = []
                if w.wtype != first_type:
                    opts.append(base + _TYPE_LETTER.get(w.wtype, "X"))
                opts.append(base + _ALPHA[min(w.instance - 1, 25)])
                opts += [base + c for c in _ALPHA]
                kw = next((o for o in opts if len(o) <= hi and o not in used and o not in RESERVED_WORDS), None) \
                    or _fallback_keyword(base, used, lo, hi)
            assign(w, kw)
    if s.keyword_groups:
        have = {frozenset(k.targets) for k in km.items if k.kind == "Group"}
        for stem, ws, positions in find_families(table):
            targets = [w.key for w in ws]
            if frozenset(targets) in have:
                continue
            parts = [(_abbr(l, a, ab), a, l) for l, a in stem]
            cands = ["A" + c for c in _candidates_from_parts(parts, max(1, lo - 1), hi - 1)]
            kw = next((c for c in cands if c not in used and c not in RESERVED_WORDS), None) or \
                _fallback_keyword("A" + (cands[0][1:] if cands else "GRP"), used, lo, hi)
            used.add(kw)
            km.add(Keyword(kw, "Group", targets, source="auto", widgets=list(ws),
                           description=f"All {len(ws)} ({'/'.join(p.upper() for p in positions)}): "
                                       f"{ws[0].wtype} {ws[0].limits_text()}".strip()))
            added += 1
    km.resolve(table)
    log.info("Keywords: %d total, %d new", len(km), added)
    return km


KW_COLUMNS = ["Keyword", "Enabled", "Kind", "Target(s)", "Allowed values", "Type", "Access", "Min", "Max", "Unit",
              "Options", "Current", "Example", "Description", "Source"]
_KW_HEADER = {norm_key(h): h for h in KW_COLUMNS}
_KW_HEADER.update({"targets": "Target(s)", "target": "Target(s)", "command": "Target(s)", "macro": "Target(s)",
                   "keywords": "Keyword", "key": "Keyword", "shortname": "Keyword"})


def save_keywords(path: Any, km: KeywordMap, table: Optional[SignalTable] = None,
                  abbrev: Optional[Dict[str, str]] = None, settings: Optional[Settings] = None,
                  fast: bool = True) -> Path:
    """Write Keywords.xlsx (Keywords + Abbreviations + Help + _Info).
    fast=True streams the keyword rows into the sheet XML; falls back to plain openpyxl on any problem."""
    if fast:
        try:
            return _save_keywords(path, km, table, abbrev, settings, True)
        except PermissionError:
            raise
        except Exception as e:
            log.debug("fast keyword save fell back to openpyxl: %s", e)
    return _save_keywords(path, km, table, abbrev, settings, False)


def _save_keywords(path: Any, km: KeywordMap, table: Optional[SignalTable], abbrev: Optional[Dict[str, str]],
                   settings: Optional[Settings], fast: bool) -> Path:
    _require_openpyxl()
    s = settings or Settings()
    st = _xl_styles()
    path = Path(path)
    if table is not None:
        km.resolve(table)
    order = {w: i for i, w in enumerate(table.widgets)} if table is not None else {}
    kind_rank = {"Signal": 0, "Group": 1, "Macro": 2}
    items = sorted(km.items, key=lambda k: (kind_rank.get(k.kind, 3),
                                            min((order.get(w, 1e9) for w in k.widgets), default=1e9), k.keyword))
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Keywords"
    ws.append(KW_COLUMNS)
    kw_rows: List[list] = []
    add_row = kw_rows.append if fast else (lambda r: ws.append([None if v == "" else _xl_clean(v) for v in r]))
    for k in items:
        w = k.widgets[0] if k.widgets else None
        add_row([k.keyword, "Y" if k.enabled else "N", k.kind, k.target_text(), allowed_text(k),
                   w.wtype if w else "", w.access if w else "", w.min if w else None, w.max if w else None,
                   w.unit if w else "", w.options if w else "", (w.current or None) if w else None,
                   example_command(k), k.description or (k.problem and f"! {k.problem}"), k.source])
    widths = [10, 9, 9, 44, 40, 10, 8, 9, 9, 8, 18, 12, 14, 45, 9]
    for j, wd in enumerate(widths, 1):
        c = ws.cell(1, j)
        c.font, c.fill, c.alignment = st.hfont, st.hfill, st.center
        ws.column_dimensions[get_column_letter(j)].width = wd
    from openpyxl.formatting.rule import FormulaRule
    last = max(2, len(items) + 1)
    ws.conditional_formatting.add(f"A2:A{last}", FormulaRule(formula=['LEN($A2)>0'], fill=st.input_fill,
                                                             font=Font(bold=True, color="1F3864")))
    ws.conditional_formatting.add(f"A2:{get_column_letter(len(KW_COLUMNS))}{last}",
                                  FormulaRule(formula=['$B2="N"'], font=st.grey))
    ws.freeze_panes = "B2"
    ws.auto_filter.ref = f"A1:{get_column_letter(len(KW_COLUMNS))}{max(2, len(items) + 1)}"
    for col, formula in (("B", '"Y,N"'), ("C", '"' + ",".join(KW_KINDS) + '"')):
        dv = DataValidation(type="list", formula1=formula, allow_blank=True)
        dv.add(f"{col}2:{col}5000")
        ws.add_data_validation(dv)
    wa = wb.create_sheet("Abbreviations")
    wa.append(["Word", "Abbreviation", "Note"])
    custom = {k.lower(): v.upper() for k, v in (abbrev or {}).items()}
    merged = dict(DEFAULT_ABBREV)
    merged.update(custom)
    ab_rows = [[word, merged[word], "custom" if word in custom else "built-in"] for word in sorted(merged)]
    if not fast:
        for r in ab_rows:
            wa.append(r)
    for j, wd in enumerate([22, 14, 10], 1):
        c = wa.cell(1, j)
        c.font, c.fill = st.hfont, st.hfill
        wa.column_dimensions[get_column_letter(j)].width = wd
    wa.freeze_panes = "A2"
    wh = wb.create_sheet("Help")
    lines = [
        ("CONSOLE SYNTAX", ""),
        ("AWS100", "set keyword AWS to 100 (also AWS 100, AWS=100)"),
        ("IGN ON / IGNON / IGN 1", "set a button to a state (label or value)"),
        ("AWS?  or  AWS", "read the current value"),
        ("AWS+=5  AWS-=5", "relative change"),
        ("AWS++  AWS--", "one step up / down"),
        ("AWSMAX  AWSMIN", "set to the widget's limit"),
        ("PUP!", "click a button once (momentary)"),
        ("KLA24; KLB24; IGN ON", "several commands in one line"),
        ("", ""),
        ("KEYWORD RULES", ""),
        ("Keyword", f"{s.keyword_min_len}-{s.keyword_max_len} letters, unique; edit freely, then REFRESH in the GUI"),
        ("Values", "any value inside the box limits Min..Max is accepted (limits included), e.g. AWS0, AWS100, "
                   "AWS150; outside the limits it is rejected before anything is sent to HTA"),
        ("Buttons", "accept their states: IGN ON / IGN OFF (or the state values 1 / 0)"),
        ("Kind = Signal", "Target(s) = one widget 'Tab/Name' or 'Tab/Name#2'"),
        ("Kind = Group", "Target(s) = several widgets separated by ';' - all get the same value"),
        ("Kind = Macro", "Target(s) = console commands, '$' = the value typed, e.g. 'KLA$; KLB$'"),
        ("Enabled = N", "keyword ignored"),
        ("Abbreviations", "words -> abbreviation used when generating new keywords"),
        ("", ""),
        ("BUILT-IN COMMANDS", ""),
    ] + [(k, v) for k, v in CONSOLE_BUILTINS.items()]
    for a, b in lines:
        wh.append([a, b])
        if a and not b:
            wh.cell(wh.max_row, 1).font = st.bold
    wh.column_dimensions["A"].width, wh.column_dimensions["B"].width = 28, 90
    wi = wb.create_sheet("_Info")
    info = [("Generated", now_iso()), ("Tool", f"{APP_NAME} {__version__}"),
            ("Signal workbook", (table.meta.get("excel") if table is not None else "") or ""),
            ("Keywords", len(km)), ("Signal", sum(k.kind == "Signal" for k in km)),
            ("Group", sum(k.kind == "Group" for k in km)), ("Macro", sum(k.kind == "Macro" for k in km))]
    for k, v in info:
        wi.append([k, v])
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {"Keywords": (2, kw_rows), "Abbreviations": (2, ab_rows)} if fast else {}
    target = path.with_name(path.name + ".~new") if fast else path
    try:
        wb.save(target)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
    if fast:
        try:
            _inject_rows(target, payload)
            os.replace(str(target), str(path))
        except PermissionError as e:
            raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
        finally:
            if target.exists():
                try:
                    target.unlink()
                except OSError:
                    pass
    return path


def load_keywords(path: Any) -> Tuple[KeywordMap, Dict[str, str], List[str]]:
    """Read Keywords.xlsx -> (map, custom abbreviations, problems). Lenient: any column order."""
    data = xlsx_values(Path(path))
    problems: List[str] = []
    order = (["Keywords"] if "Keywords" in data else []) + [t for t in data if t != "Keywords"]
    rows: List[list] = []
    hdr_row, cmap = 0, {}
    for title in order:
        for r, row in enumerate(data[title][:10]):
            m: Dict[str, int] = {}
            for c, v in enumerate(list(row)[:40], 1):
                h = _KW_HEADER.get(norm_key(v))
                if h and h not in m:
                    m[h] = c
            if "Keyword" in m:
                rows, hdr_row, cmap = data[title], r + 1, m
                break
        if cmap:
            break
    km = KeywordMap()
    if not cmap:
        return km, {}, [f"{Path(path).name}: no sheet with a 'Keyword' column"]
    extra: Dict[str, int] = {}
    for c, v in enumerate(rows[hdr_row - 1], 1):
        k = norm_key(v)
        if k in ("tab", "name", "instance", "signal", "signalname"):
            extra.setdefault("name" if k in ("signal", "signalname") else k, c)
    for i in range(hdr_row, len(rows)):
        row, r = rows[i], i + 1

        def g(h: str) -> str:
            return _cell_str(_row_get(row, cmap.get(h)))
        kw = g("Keyword").upper()
        if not kw:
            continue
        if not re.fullmatch(r"[A-Z][A-Z0-9_]{1,7}", kw):
            problems.append(f"row {r}: '{kw}' is not a valid keyword (letters/digits, 2-8, start with a letter)")
            continue
        if kw in RESERVED_WORDS:
            problems.append(f"row {r}: '{kw}' is a reserved console word")
            continue
        kind = (g("Kind") or "Signal").strip().capitalize()
        if kind not in KW_KINDS:
            problems.append(f"row {r}: unknown Kind '{kind}' (Signal/Group/Macro)")
            continue
        tgt = g("Target(s)")
        if kind == "Signal" and not tgt and "name" in extra:
            tab = _cell_str(_row_get(row, extra.get("tab")))
            name = _cell_str(_row_get(row, extra.get("name")))
            inst = to_float(_row_get(row, extra.get("instance")))
            tgt = (f"{tab}/" if tab else "") + name + (f"#{int(inst)}" if inst and inst > 1 else "")
        desc = g("Description")
        k = Keyword(kw, kind, [], "", "" if desc.startswith("! ") else desc,
                    True if g("Enabled") == "" else _truthy(g("Enabled")), g("Source") or "user")
        if kind == "Macro":
            k.macro = tgt
        else:
            k.targets = [t.strip() for t in re.split(r"[;\n]", tgt) if t.strip()]
            if not k.targets:
                problems.append(f"row {r}: {kw} has no Target(s)")
                continue
        if not km.add(k):
            problems.append(f"row {r}: duplicate keyword '{kw}' ignored")
    abbrev: Dict[str, str] = {}
    for row in (data.get("Abbreviations") or [])[1:]:
        word, ab = _cell_str(_row_get(row, 1)).lower(), _cell_str(_row_get(row, 2)).upper()
        if word and ab and DEFAULT_ABBREV.get(word) != ab:
            abbrev[word] = ab
    log.info("Loaded %d keywords from %s%s", len(km), Path(path).name,
             f" ({len(problems)} problem(s))" if problems else "")
    return km, abbrev, problems


def ensure_keywords(table: SignalTable, path: Any, settings: Settings, regenerate: bool = False
                    ) -> Tuple[KeywordMap, List[str], bool]:
    """Load Keywords.xlsx (create / extend it when needed). -> (map, problems, file_written)."""
    path = Path(path)
    existing, abbrev, problems = (load_keywords(path) if path.exists() else (None, {}, []))
    written = False
    if existing is None or regenerate:
        km = generate_keywords(table, existing, settings, abbrev)
        save_keywords(path, km, table, abbrev, settings)
        written = True
    else:
        km = existing
    problems += km.resolve(table)
    return km, problems, written


