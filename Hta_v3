def _xl_col(ref: str) -> int:
    n = 0
    for ch in ref:
        o = ord(ch)
        if 65 <= o <= 90:
            n = n * 26 + o - 64
        elif 97 <= o <= 122:
            n = n * 26 + o - 96
        else:
            break
    return n


def _xl_num(txt: str) -> Any:
    if "." not in txt and "e" not in txt and "E" not in txt:
        try:
            return int(txt)
        except ValueError:
            pass
    try:
        f = float(txt)
    except ValueError:
        return txt
    return f


