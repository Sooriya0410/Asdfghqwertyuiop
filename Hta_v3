            fn, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Output workbook", self.out.text(), "Excel (*.xlsx)")
            if fn:
                self.out.setText(fn if fn.lower().endswith(".xlsx") else fn + ".xlsx")

