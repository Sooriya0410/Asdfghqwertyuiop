class AuditLog:
    """Append-only CSV trail of every write attempt (one file per day)."""
    FIELDS = ["timestamp", "user", "backend", "dry_run", "tab", "name", "instance", "path",
              "requested", "before", "after", "ok", "method", "message", "duration_ms"]

    def __init__(self, directory: Any):
        self.dir = Path(directory)
        self._lock = threading.Lock()
        try:
            self.user = os.getlogin()
        except Exception:
            self.user = os.environ.get("USERNAME") or os.environ.get("USER") or "?"

    def file(self) -> Path:
        return self.dir / f"hta_audit_{_dt.date.today():%Y%m%d}.csv"

    def record(self, w: Widget, res: WriteResult, backend: str) -> None:
        row = {"timestamp": now_iso(), "user": self.user, "backend": backend,
               "dry_run": "Y" if res.dry_run else "", "tab": w.tab, "name": w.name,
               "instance": w.instance, "path": w.path, "requested": res.requested,
               "before": res.before, "after": res.after, "ok": "Y" if res.ok else "N",
               "method": res.method, "message": res.message, "duration_ms": f"{res.duration_ms:.0f}"}
        with self._lock:
            try:
                self.dir.mkdir(parents=True, exist_ok=True)
                f = self.file()
                new = not f.exists()
                with open(f, "a", newline="", encoding="utf-8") as fh:
                    wr = csv.DictWriter(fh, fieldnames=self.FIELDS)
                    if new:
                        wr.writeheader()
                    wr.writerow(row)
            except OSError as e:
                log.warning("Audit write failed: %s", e)


class Controller:
    """Single entry point for reads/writes: validates, writes, verifies, audits, keeps undo."""

    def __init__(self, backend: Backend, table: SignalTable, settings: Settings,
                 audit: Optional[AuditLog] = None):
        self.backend, self.table, self.s, self.audit = backend, table, settings, audit
        self.history: List[Tuple[Widget, str]] = []
        backend.attach_table(table)

    def rebind(self, table: SignalTable) -> None:
        self.table = table
        self.backend.attach_table(table)
        self.history.clear()

    def _audit(self, w: Widget, res: WriteResult) -> None:
        if self.audit is not None:
            self.audit.record(w, res, self.backend.kind)

    def read(self, w: Widget, allow_switch: bool = True) -> Optional[str]:
        v = self.backend.read(w, allow_switch=allow_switch)
        if v is not None:
            w.current = v
        return v

    def read_many(self, widgets: Sequence[Widget], allow_switch: bool = True,
                  stop: Optional[threading.Event] = None,
                  on_value: Optional[Callable[[Widget, Optional[str]], None]] = None
                  ) -> Dict[Widget, Optional[str]]:
        order = {t: i for i, t in enumerate(self.table.tabs())}
        ordered = sorted(widgets, key=lambda w: order.get(w.tab, 0))  # minimise tab switches
        out: Dict[Widget, Optional[str]] = {}
        chunk = 400  # progress + stop granularity
        for i in range(0, len(ordered), chunk):
            if stop is not None and stop.is_set():
                break
            part = self.backend.read_bulk(ordered[i:i + chunk], allow_switch, stop)
            for w, v in part.items():
                if v is not None:
                    w.current = v
                out[w] = v
                if on_value:
                    on_value(w, v)
        return out

    def set_value(self, w: Widget, raw: Any, dry_run: bool = False) -> WriteResult:
        t0 = time.perf_counter()
        try:
            value = validate_value(w, raw)
        except ValueError as e:
            res = WriteResult(key=w.key, requested=str(raw), message=str(e), method="validate")
            w.status = f"Invalid: {e}"
            self._audit(w, res)
            log.warning("REJECTED %s = %r : %s", w.key, raw, e)
            return res
        if dry_run:
            res = WriteResult(key=w.key, requested=value, ok=True, before=w.current, after=w.current,
                              message="dry-run, not sent", dry_run=True, method="dry-run")
        else:
            res = self.backend.write(w, value)
            if res.ok:
                self.history.append((w, res.before))
            if res.after != "":
                w.current = res.after
            elif res.ok:
                w.current = value
        res.duration_ms = res.duration_ms or (time.perf_counter() - t0) * 1000
        w.status = ("DRY" if res.dry_run else "OK" if res.ok else "FAIL") + \
                   (f": {res.message}" if res.message else "")
        self._audit(w, res)
        (log.info if res.ok else log.warning)(
            "%s %s = %s -> %s%s", "DRY" if dry_run else ("SET" if res.ok else "FAIL"), w.key, value,
            res.after or "?", f"  ({res.message})" if res.message else "")
        return res

    def press(self, w: Widget, dry_run: bool = False) -> WriteResult:
        if w.wtype not in ("Button", "CheckBox", "Other"):
            res = WriteResult(key=w.key, requested="<press>", message=f"'{w.label}' is not a button")
        elif dry_run:
            res = WriteResult(key=w.key, requested="<press>", ok=True, dry_run=True, method="dry-run",
                              message="dry-run, not sent")
        else:
            res = self.backend.press(w)
            if res.after:
                w.current = res.after
        w.status = ("OK" if res.ok else "FAIL") + (f": {res.message}" if res.message else "")
        self._audit(w, res)
        log.info("PRESS %s -> %s", w.key, "ok" if res.ok else res.message)
        return res

    def apply_pending(self, widgets: Sequence[Widget], dry_run: bool = False,
                      stop: Optional[threading.Event] = None,
                      on_result: Optional[Callable[[Widget, WriteResult], None]] = None) -> List[WriteResult]:
        out: List[WriteResult] = []
        order = {t: i for i, t in enumerate(self.table.tabs())}
        for w in sorted(widgets, key=lambda w: order.get(w.tab, 0)):
            if stop is not None and stop.is_set():
                log.warning("Apply stopped by user")
                break
            r = self.set_value(w, w.set_value, dry_run)
            out.append(r)
            if on_result:
                on_result(w, r)
        return out

    # ---- HTA application level (simulation, menus, dialogs) - all audited
    def _audit_app(self, tab: str, name: str, res: WriteResult) -> None:
        self._audit(Widget(tab=tab, name=name, access="RW"), res)
        (log.info if res.ok else log.warning)("%s %s -> %s %s", tab, name, "ok" if res.ok else "FAILED",
                                              res.message or res.after)

    def sim(self, action: str, dry_run: bool = False) -> WriteResult:
        a = action.strip().lower()
        if dry_run:
            res = WriteResult(key=f"SIM/{a}", requested=a, ok=True, dry_run=True, method="dry-run",
                              message="dry-run, not sent")
        else:
            res = self.backend.sim_control(a)
        self._audit_app("SIM", a.upper(), res)
        return res

    def sim_status(self) -> str:
        return self.backend.sim_status()

    def invoke_menu(self, path: str, dry_run: bool = False) -> WriteResult:
        res = WriteResult(key=f"MENU/{path}", requested=path, method="menu")
        if dry_run:
            res.ok, res.dry_run, res.message = True, True, "dry-run, not clicked"
        else:
            try:
                res.after, res.ok = self.backend.invoke_menu(path), True
            except Exception as e:
                res.message = f"{type(e).__name__}: {e}"
        self._audit_app("MENU", path, res)
        return res

    def dialog_capture(self, menu_path: str = "", title_re: str = "") -> Tuple[str, List[DlgControl]]:
        return self.backend.dialog_capture(menu_path, title_re)

    def dialog_apply(self, menu_path: str, title_re: str, items: Sequence[DlgControl], press: str = "OK",
                     dry_run: bool = False) -> Tuple[str, List[WriteResult]]:
        todo = [i for i in items if str(i.set_value).strip()]
        if dry_run:
            out = []
            for i in todo:
                try:
                    v = dialog_validate(i, i.set_value)
                    r = WriteResult(key=i.key, requested=v, ok=True, dry_run=True, method="dry-run",
                                    before=i.value, after=i.value, message="dry-run, not sent")
                except ValueError as e:
                    r = WriteResult(key=i.key, requested=str(i.set_value), message=str(e))
                out.append(r)
            title = "(dry run)"
        else:
            title, out = self.backend.dialog_apply(menu_path, title_re, todo, press)
        for r in out:
            self._audit_app(f"DIALOG {title}", r.key, r)
        return title, out

    def revert_last(self, dry_run: bool = False) -> Optional[WriteResult]:
        if not self.history:
            return None
        w, before = self.history.pop()
        if before == "":
            return WriteResult(key=w.key, requested="", message="previous value unknown - cannot revert")
        res = self.set_value(w, before, dry_run)
        if res.ok and self.history and self.history[-1][0] is w:
            self.history.pop()  # the revert itself is not undoable
        return res


