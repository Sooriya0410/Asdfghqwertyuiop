@dataclass(eq=False)
class UiaCtrl:
    ctype: str
    rect: Tuple[int, int, int, int]
    name: str = ""
    aid: str = ""
    cls: str = ""
    role: str = ""
    label: str = ""
    value: str = ""
    min: Optional[float] = None
    max: Optional[float] = None
    step: Optional[float] = None
    readonly: bool = False
    wrapper: Any = None
    ticks: List[Tuple[int, float]] = field(default_factory=list)

    left = property(lambda s: s.rect[0])
    top = property(lambda s: s.rect[1])
    right = property(lambda s: s.rect[2])
    bottom = property(lambda s: s.rect[3])
    width = property(lambda s: s.rect[2] - s.rect[0])
    height = property(lambda s: s.rect[3] - s.rect[1])
    cx = property(lambda s: (s.rect[0] + s.rect[2]) // 2)
    cy = property(lambda s: (s.rect[1] + s.rect[3]) // 2)

    def contains(self, x: float, y: float, pad: int = 0) -> bool:
        return self.left - pad <= x <= self.right + pad and self.top - pad <= y <= self.bottom + pad

    def inside(self, other: "UiaCtrl") -> bool:
        return (other is not self and self.left >= other.left and self.right <= other.right
                and self.top >= other.top and self.bottom <= other.bottom)


class _Grid:
    """Uniform spatial hash: rectangles -> cells, so neighbours are found without O(n^2) scans."""
    __slots__ = ("size", "cells")

    def __init__(self, size: int = 160):
        self.size = size
        self.cells: Dict[Tuple[int, int], list] = defaultdict(list)

    def add(self, obj: Any, l: float, t: float, r: float, b: float) -> None:
        s = self.size
        for gx in range(int(l) // s, int(r) // s + 1):
            for gy in range(int(t) // s, int(b) // s + 1):
                self.cells[(gx, gy)].append(obj)

    def at(self, x: float, y: float) -> list:
        return list(self.cells.get((int(x) // self.size, int(y) // self.size), ()))

    def query(self, l: float, t: float, r: float, b: float) -> list:
        s, out = self.size, []
        for gx in range(int(l) // s, int(r) // s + 1):
            for gy in range(int(t) // s, int(b) // s + 1):
                out.extend(self.cells.get((gx, gy), ()))
        return out


def analyze_controls(ctrls: List[UiaCtrl], max_gap: int = 45) -> List[UiaCtrl]:
    """Assign roles, drop sub-parts, turn numeric texts into slider ticks / displays,
    take slider limits from tick labels and pair caption labels with controls."""
    for c in ctrls:
        ct, cls = c.ctype, c.cls.lower()
        if ct == "Spinner":
            c.role = "display" if c.readonly else "input"
        elif ct == "Edit":
            c.role = "display" if c.readonly else "input"
        elif ct == "Slider" or any(k in cls for k in ("slider", "knob", "wheel", "dial")):
            c.role = "slider"
        elif ct == "Button":
            c.role = "button" if (c.name or c.width >= 20) else ""
        elif ct == "CheckBox":
            c.role = "checkbox"
        elif ct == "ComboBox":
            c.role = "combo"
        elif ct == "RadioButton":
            c.role = "radio"
        elif ct == "DataItem":
            c.role = "cell"
        elif ct == "ProgressBar" or any(k in cls for k in ("thermo", "lcd", "meter", "gauge")):
            c.role = "display"
        elif ct == "Text":
            c.role = "numtext" if to_float(c.name) is not None else ("label" if c.name else "")
        else:
            c.role = ""
    # sub-parts of composite controls (spin-box line edit + arrows, combo internals)
    comp_grid = _Grid()
    for i, p in enumerate(c for c in ctrls if c.ctype in ("Spinner", "ComboBox") and c.role):
        comp_grid.add(p, p.left, p.top, p.right, p.bottom)
    for c in ctrls:
        if c.role and any(c.inside(p) for p in comp_grid.at(c.left, c.top)):
            c.role = ""
    sliders = [c for c in ctrls if c.role == "slider"]
    s_index = {id(s): i for i, s in enumerate(sliders)}
    s_grid = _Grid()
    for s in sliders:
        s_grid.add(s, s.left - 25, s.top - 20, s.right + 25, s.bottom + 40)
    for t in [c for c in ctrls if c.role == "numtext"]:
        host = None
        near = {id(s): s for s in s_grid.at(t.cx, t.top) + s_grid.at(t.cx, t.bottom)}
        for s in sorted(near.values(), key=lambda s: s_index[id(s)]):
            if s.left - 25 <= t.cx <= s.right + 25 and (-4 <= t.top - s.bottom <= 40
                                                         or -4 <= s.top - t.bottom <= 20):
                host = s
                break
        if host is not None:
            t.role = "tick"
            host.ticks.append((t.cx, to_float(t.name) or 0.0))
        else:
            t.role, t.value, t.readonly = "display", t.name, True
    for s in sliders:
        if (s.min is None or s.max is None) and len(s.ticks) >= 2:
            tk = sorted(s.ticks)
            if tk[0][1] < tk[-1][1]:
                s.min, s.max = tk[0][1], tk[-1][1]
    # caption pairing - global greedy on distance score (spatial grid: only nearby labels are compared)
    labels = [c for c in ctrls if c.role == "label"]
    targets = [c for c in ctrls if c.role in WIDGET_ROLES]
    l_index = {id(L): i for i, L in enumerate(labels)}
    l_grid = _Grid()
    for L in labels:
        l_grid.add(L, L.left, L.top, L.right, L.bottom)
    cands: List[Tuple[float, int, int]] = []
    for ti, t in enumerate(targets):
        near = l_grid.query(t.left - 60, t.top - max_gap, max(t.right, t.left + 60), t.top + 4)
        near += l_grid.query(t.left - max_gap * 1.5, t.top - 4, t.left + 4, t.bottom + 4)
        for L in {id(x): x for x in near}.values():
            li = l_index[id(L)]
            dy = t.top - L.bottom
            if -4 <= dy <= max_gap:
                dx = abs(L.left - t.left)
                overlap = min(L.right, t.right) - max(L.left, t.left)
                if overlap > 0 or dx <= 60:
                    cands.append((dy + 0.25 * dx, ti, li))
            gap = t.left - L.right
            if -4 <= gap <= max_gap * 1.5 and abs(L.cy - t.cy) <= max(t.height, L.height) / 2 + 4:
                cands.append((gap + 15.0, ti, li))
    cands.sort()
    used_t, used_l = set(), set()
    for _, ti, li in cands:
        if ti in used_t or li in used_l:
            continue
        targets[ti].label = labels[li].name.strip()
        used_t.add(ti)
        used_l.add(li)
    for c in ctrls:
        if not c.label and c.role in ("checkbox", "radio"):
            c.label = c.name
    return ctrls


@dataclass
class Calib:
    """screen = s * logical + o   (per axis)."""
    sx: float = 1.0
    ox: float = 0.0
    sy: float = 1.0
    oy: float = 0.0
    n: int = 0
    rms: float = 0.0

    def to_screen(self, x: float, y: float) -> Tuple[int, int]:
        return int(round(self.sx * x + self.ox)), int(round(self.sy * y + self.oy))

    def to_logical(self, X: float, Y: float) -> Tuple[float, float]:
        return (X - self.ox) / self.sx, (Y - self.oy) / self.sy


def fit_calibration(pairs: Sequence[Tuple[float, float, float, float]], default_scale: float = 1.0,
                    default_origin: Tuple[float, float] = (0.0, 0.0)) -> Calib:
    """Least-squares fit of XML position -> screen pixel with one outlier-rejection pass.
    pairs = (x_logical, y_logical, X_screen, Y_screen)."""
    def fit1(xs: List[float], Xs: List[float], s0: float, o0: float) -> Tuple[float, float]:
        n = len(xs)
        if n == 0:
            return s0, o0
        if n == 1 or (max(xs) - min(xs)) < 20:
            return s0, sum(X - s0 * x for x, X in zip(xs, Xs)) / n
        mx, mX = sum(xs) / n, sum(Xs) / n
        sxx = sum((x - mx) ** 2 for x in xs)
        s = sum((x - mx) * (X - mX) for x, X in zip(xs, Xs)) / sxx
        if not 0.5 <= s <= 4.0:
            s = s0
        return s, mX - s * mx

    pts = list(pairs)
    cal = Calib(default_scale, default_origin[0], default_scale, default_origin[1])
    for _ in range(2):
        if not pts:
            break
        cal.sx, cal.ox = fit1([p[0] for p in pts], [p[2] for p in pts], default_scale, default_origin[0])
        cal.sy, cal.oy = fit1([p[1] for p in pts], [p[3] for p in pts], default_scale, default_origin[1])
        res = [math.hypot(cal.sx * p[0] + cal.ox - p[2], cal.sy * p[1] + cal.oy - p[3]) for p in pts]
        med = sorted(res)[len(res) // 2]
        keep = [p for p, r in zip(pts, res) if r <= 3 * med + 6]
        cal.n, cal.rms = len(pts), math.sqrt(sum(r * r for r in res) / len(res))
        if len(keep) == len(pts) or len(keep) < 2:
            break
        pts = keep
    return cal


def _escape_keys(text: str) -> str:
    """Escape pywinauto send_keys specials."""
    return re.sub(r"([{}+^%~()\[\]])", r"{\1}", str(text))


_COM_STATE = threading.local()


def _ensure_com() -> None:
    """COM must be initialised in every thread that talks to UI Automation."""
    if getattr(_COM_STATE, "done", False):
        return
    try:
        import pythoncom  # type: ignore
        pythoncom.CoInitialize()
    except Exception:
        try:
            import comtypes  # type: ignore
            comtypes.CoInitialize()
        except Exception:
            pass
    _COM_STATE.done = True


def _dpi_scale(hwnd: int) -> float:
    try:
        import ctypes
        dpi = ctypes.windll.user32.GetDpiForWindow(int(hwnd))
        return dpi / 96.0 if dpi else 1.0
    except Exception:
        return 1.0


def bring_to_front(hwnd: Optional[int]) -> None:
    """Give the foreground back to our own window (AttachThreadInput trick)."""
    if sys.platform != "win32" or not hwnd:
        return
    try:
        import ctypes
        u32, k32 = ctypes.windll.user32, ctypes.windll.kernel32
        fg = u32.GetForegroundWindow()
        fg_tid = u32.GetWindowThreadProcessId(fg, None)
        me = k32.GetCurrentThreadId()
        u32.AttachThreadInput(fg_tid, me, True)
        u32.SetForegroundWindow(int(hwnd))
        u32.BringWindowToTop(int(hwnd))
        u32.AttachThreadInput(fg_tid, me, False)
    except Exception:
        pass


class _LazyWrapper:
    """Creates the pywinauto wrapper only when a control is really touched (scan stays cheap)."""
    __slots__ = ("_elem", "_real")

    def __init__(self, elem: Any):
        self._elem = elem
        self._real = None

    def _get(self) -> Any:
        if self._real is None:
            from pywinauto.controls.uiawrapper import UIAWrapper  # type: ignore
            from pywinauto.uia_element_info import UIAElementInfo  # type: ignore
            self._real = UIAWrapper(UIAElementInfo(self._elem))
        return self._real

    def __getattr__(self, name: str) -> Any:
        return getattr(self._get(), name)


def _safe(fn: Callable[[], Any], default: Any = None) -> Any:
    try:
        return fn()
    except Exception:
        return default


