# -----------------------------------------------------------------------------
class SimulatorBackend(Backend):
    """In-memory HTA stand-in.  Respects limits, button states and optional rules
    (display <- input mirrors, gated by a button) so sequences can be dry-tested."""
    kind = "sim"

    SIM_MENUS = ["File->Open...", "File->Save", "Simulation->Load", "Simulation->Start", "Simulation->Stop",
                 "Simulation->Reset", "Tools->Signal Monitor", "Settings->Hardware...", "Settings->Channels...",
                 "View Sets->Default", "Help->About"]

    def __init__(self, settings: Settings, table: Optional[SignalTable] = None, latency_ms: int = 0):
        super().__init__(settings)
        self._vals: Dict[str, str] = {}
        self._initial: Dict[str, str] = {}
        self.state = "loaded"
        self._dialogs = self._make_dialogs()
        self._on = False
        self.latency = latency_ms / 1000.0
        self.rules: List[Tuple[str, str, Optional[str], Optional[str]]] = []
        if table is not None:
            self.attach_table(table)

    def attach_table(self, table: SignalTable) -> None:
        super().attach_table(table)
        for w in table:
            self._initial.setdefault(w.key, self._initial_value(w))
            self._vals.setdefault(w.key, self._initial[w.key])

    @staticmethod
    def _initial_value(w: Widget) -> str:
        if w.current:
            return w.current
        opts = w.option_list()
        if opts:
            return opts[-1][0] if len(opts) > 1 else opts[0][0]
        if w.is_numeric:
            v = 0.0
            if w.min is not None and v < w.min:
                v = w.min
            if w.max is not None and v > w.max:
                v = w.max
            return fmt_num(v)
        return ""

    def mirror(self, src_key: str, dst_key: str, gate_key: Optional[str] = None,
               gate_label: Optional[str] = None) -> None:
        """dst shows src (or 0 when gate_key does not show gate_label)."""
        self.rules.append((src_key, dst_key, gate_key, gate_label))
        self._apply_rules()

    def _apply_rules(self) -> None:
        for src, dst, gate, glabel in self.rules:
            v = self._vals.get(src, "0")
            if gate and norm_key(self._vals.get(gate, "")) != norm_key(glabel or ""):
                v = "0"
            self._vals[dst] = v

    def connect(self) -> str:
        self._on = True
        return f"HTA Simulator (offline, {len(self._vals)} signals)"

    def disconnect(self) -> None:
        self._on = False

    @property
    def connected(self) -> bool:
        return self._on

    def _check(self) -> None:
        if not self._on:
            raise BackendError("simulator not connected")
        if self.latency:
            time.sleep(self.latency)

    def read(self, w: Widget, allow_switch: bool = True) -> Optional[str]:
        self._check()
        return self._vals.get(w.key, "")

    def write(self, w: Widget, value: str) -> WriteResult:
        t0 = time.perf_counter()
        self._check()
        res = WriteResult(key=w.key, requested=str(value), before=self._vals.get(w.key, ""), method="sim")
        if not w.writable:
            res.message = "read-only"
            return res
        opts = w.option_list()
        if opts:
            lab = option_label(opts, value)
            if lab is None:
                res.message = f"unknown state '{value}'"
                return res
            self._vals[w.key] = lab
        else:
            f = to_float(value)
            self._vals[w.key] = fmt_num(f) if f is not None else str(value)
        self._apply_rules()
        res.after = self._vals[w.key]
        res.ok, res.message = values_match(w, value, res.after, self.s.abs_tolerance)
        res.duration_ms = (time.perf_counter() - t0) * 1000
        return res

    def press(self, w: Widget) -> WriteResult:
        self._check()
        opts = w.option_list()
        res = WriteResult(key=w.key, requested="<press>", before=self._vals.get(w.key, ""), method="sim")
        if len(opts) >= 2:
            labels = [l for l, _ in opts]
            cur = option_label(opts, res.before)
            nxt = labels[(labels.index(cur) + 1) % len(labels)] if cur in labels else labels[0]
            self._vals[w.key] = nxt
            self._apply_rules()
        res.after, res.ok = self._vals.get(w.key, ""), True
        return res

    # ---- simulation / menus / dialogs (emulated HTA application level)
    @staticmethod
    def _make_dialogs() -> Dict[str, Tuple[str, List[DlgControl]]]:
        hw = [DlgControl("General", "Interface", "combo", "CAN1", options="CAN1;CAN2;CAN3;FlexRay1"),
              DlgControl("General", "Baudrate", "input", "500000"),
              DlgControl("General", "Termination", "checkbox", "1"),
              DlgControl("Analog", "Input Range", "combo", "0-10V", options="0-5V;0-10V;+-10V"),
              DlgControl("Analog", "Sample Rate [Hz]", "input", "1000")]
        ch = []
        for i, pos in enumerate(("FL", "FR", "RL", "RR"), 1):
            ch += [DlgControl("", f"Channel {i} Name", "input", f"WSS_{pos}"),
                   DlgControl("", f"Channel {i} Gain", "input", "1.0"),
                   DlgControl("", f"Channel {i} Enabled", "checkbox", "1")]
        return {"settingshardware": ("Hardware Configuration", hw), "settingschannels": ("Channel Setup", ch)}

    def sim_control(self, action: str) -> WriteResult:
        self._check()
        a = action.strip().lower()
        res = WriteResult(key=f"SIM/{a}", requested=a, before=self.state, method="sim")
        if a == "start":
            self.state = "running"
        elif a == "stop":
            self.state = "stopped"
        elif a == "reset":
            self._vals.update(self._initial)
            self._apply_rules()
            self.state = "loaded"
        else:
            res.message = f"unknown simulation action '{action}'"
            return res
        res.after, res.ok = self.state, True
        return res

    def sim_status(self) -> str:
        self._check()
        return f"{self.state} | simulation {self.state}"

    def menu_paths(self) -> List[str]:
        return [p.replace("->", " -> ") for p in self.SIM_MENUS]

    def invoke_menu(self, path: str) -> str:
        self._check()
        want = norm_key(path)
        for m in self.SIM_MENUS:
            if norm_key(m) == want:
                if want.startswith("simulation") and want[10:] in ("start", "stop", "reset"):
                    self.sim_control(want[10:])
                return m.replace("->", " -> ")
        raise BackendError(f"menu '{path}' not found")

    def _dialog(self, menu_path: str, title_re: str) -> Tuple[str, List[DlgControl]]:
        key = norm_key(menu_path)
        if key in self._dialogs:
            return self._dialogs[key]
        if title_re:
            rx = re.compile(title_re, re.I)
            for title, items in self._dialogs.values():
                if rx.search(title):
                    return title, items
        raise BackendError(f"no dialog for menu '{menu_path}' / title '{title_re}'")

    def dialog_capture(self, menu_path: str = "", title_re: str = "") -> Tuple[str, List[DlgControl]]:
        self._check()
        title, items = self._dialog(menu_path, title_re)
        out = [DlgControl(i.page, i.label, i.ctype, i.value, options=i.options) for i in items]
        assign_dlg_instances(out)
        return title, out

    def dialog_apply(self, menu_path: str, title_re: str, items: Sequence[DlgControl],
                     press: str = "OK") -> Tuple[str, List[WriteResult]]:
        self._check()
        title, stored = self._dialog(menu_path, title_re)
        assign_dlg_instances(stored)
        index = {(norm_key(s.page), norm_key(s.label), s.instance): s for s in stored}
        commit = norm_key(press) in ("ok", "apply")
        results = []
        for it in items:
            if not str(it.set_value).strip():
                continue
            res = WriteResult(key=it.key, requested=str(it.set_value), method="sim")
            s = index.get((norm_key(it.page), norm_key(it.label), it.instance))
            if s is None:
                res.message = "field not found in dialog"
            else:
                try:
                    v = dialog_validate(s, it.set_value)
                    res.before = s.value
                    if commit:
                        s.value = v
                    res.after, res.ok = v, True
                    res.message = "" if commit else "not committed (press=None)"
                except ValueError as e:
                    res.message = str(e)
            results.append(res)
        return title, results


