def _make_backend(args: argparse.Namespace, s: Settings, table: SignalTable) -> Backend:
    if getattr(args, "sim", False):
        demo = "DEMO" in str(table.meta.get("sources", "")) or "demo" in str(getattr(args, "excel", "")).lower()
        be: Backend = demo_simulator(s, table) if demo else SimulatorBackend(s, table)
    else:
        be = HtaUiaBackend(s)
    log.info("Backend: %s", be.connect())
    return be


def _confirm(prompt: str) -> bool:
