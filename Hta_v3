        def set_items(self, items: Sequence[DlgControl], title: str = "") -> None:
            self.title = title or self.title
            self.table.setRowCount(len(items))
            for r, it in enumerate(items):
                vals = [it.page, it.label, str(it.instance), it.ctype, it.value, it.set_value, it.options, it.status]
                for c, v in enumerate(vals):
                    item = QtWidgets.QTableWidgetItem(v)
                    if c != 5:
                        item.setFlags(item.flags() & ~Qt.ItemFlag.ItemIsEditable)
                    else:
                        item.setBackground(QtGui.QBrush(_COL["input"]))
                        tip = it.options.replace(";", ", ") if it.options else (
                            "1 / 0" if it.ctype in ("checkbox", "radio") else "")
                        item.setToolTip(tip)
                    self.table.setItem(r, c, item)
            if title and not self.profile.currentText():
                self.profile.setCurrentText(re.sub(r"[^A-Za-z0-9_ -]+", "", title).strip()[:28])

        def items(self) -> List[DlgControl]:
            out = []
            for r in range(self.table.rowCount()):
                t = [self.table.item(r, c).text() if self.table.item(r, c) else "" for c in range(len(self.COLS))]
                out.append(DlgControl(page=t[0], label=t[1], instance=int(to_float(t[2]) or 1), ctype=t[3],
                                      value=t[4], set_value=t[5].strip(), options=t[6], status=t[7]))
            return out

        def set_results(self, results: Sequence[WriteResult]) -> None:
            by_key = {r.key: r for r in results}
            for r, it in enumerate(self.items()):
                res = by_key.get(it.key)
                if res is None:
                    continue
                cell = self.table.item(r, 7)
                cell.setText(("OK" if res.ok else "FAIL") + (f": {res.message}" if res.message else ""))
                cell.setBackground(QtGui.QBrush(_COL["ok"] if res.ok else _COL["fail"]))
                if res.ok and res.after:
                    self.table.item(r, 4).setText(res.after)

        def _copy_captured(self) -> None:
            for r in range(self.table.rowCount()):
                self.table.item(r, 5).setText(self.table.item(r, 4).text())

        def current_profile(self) -> ConfigProfile:
            name = self.profile.currentText().strip() or (self.title or "Profile")
            menu = self.menu.currentText().strip()
            title_re = "" if menu or not self.title else "^" + re.escape(self.title) + "$"
            return ConfigProfile(name, menu, title_re, self.press.currentText(), now_iso(), self.items())

        def set_profiles(self, profiles: Dict[str, ConfigProfile], path: Path) -> None:
            self.profiles = profiles
            self.profile.clear()
            self.profile.addItems(list(profiles))
            self.lbl_file.setText(f"{path.name}: {len(profiles)} profile(s)")
            if profiles:
                self._select_profile(next(iter(profiles)))

        def _select_profile(self, name: str) -> None:
            p = self.profiles.get(name)
            if p is None:
                return
            self.menu.setCurrentText(p.menu_path)
            self.press.setCurrentText(p.press if p.press in ("OK", "Apply", "None", "Cancel") else "OK")
            self.title = ""
            self.set_items(p.items)

