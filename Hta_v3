    def test_fast_excel_paths_match_openpyxl(self) -> None:
        """Streamed export / keyword save / in-place update give the same workbook as plain openpyxl."""
        t = self.table()
        for i, w in enumerate(t.widgets[:12]):
            w.current = ["  sp ", "a&b<c>", "x\x02y", 3.5, "", 12][i % 6]
        fx, cx = self.tmp / "fast_sig.xlsx", self.tmp / "classic_sig.xlsx"
        export_excel(t, fx, fast=True)
        export_excel(t, cx, fast=False)
        self.assertEqual(read_xlsx_values(fx), read_xlsx_values(cx))
        km = generate_keywords(t, None, self.s)
        fk, ck = self.tmp / "fast_kw.xlsx", self.tmp / "classic_kw.xlsx"
        save_keywords(fk, km, t, fast=True)
        save_keywords(ck, km, t, fast=False)
        a, b = read_xlsx_values(fk), read_xlsx_values(ck)
        a.pop("_Info"), b.pop("_Info")  # timestamps differ
        self.assertEqual(a, b)
        wb = openpyxl.load_workbook(fx)  # structure written by openpyxl is intact
        ws = wb[t.widgets[0].sheet]
        self.assertTrue(ws.freeze_panes and ws.auto_filter.ref and ws.data_validations.dataValidation)
        self.assertEqual(ws.max_row, len(t.in_tab(t.widgets[0].tab)) + 1)
        t2 = import_excel(fx)
        self.assertEqual([(w.name, w.min, w.max) for w in t2], [(w.name, w.min, w.max) for w in t])
        self.assertEqual(t2.widgets[2].current, "xy")  # control character stripped, not a crash
        for w in t2.widgets:
            w.current, w.set_value = "7", ("ON" if w.options else 1.5)
        ups = excel_value_updates(t2)
        shutil.copy(fx, cx)
        apply_excel_updates(fx, ups)                       # fast in-place patch
        real = globals()["_fast_apply_excel_updates"]
        try:
            globals()["_fast_apply_excel_updates"] = lambda *a: (_ for _ in ()).throw(_FastPathUnsupported("x"))
            apply_excel_updates(cx, ups)                   # forced openpyxl fallback
        finally:
            globals()["_fast_apply_excel_updates"] = real
        def norm(d: Any) -> Any:  # an openpyxl load/save round trip turns '' cells into empty ones
            out = {}
            for k, rows in d.items():
                rr = [[None if v == "" else v for v in r] for r in rows]
                out[k] = [r[:max([i + 1 for i, v in enumerate(r) if v is not None] or [0])] for r in rr]
            return out
        self.assertEqual(norm(read_xlsx_values(fx)), norm(read_xlsx_values(cx)))
        self.assertEqual(import_excel(fx).widgets[0].current, "7")
        self.assertFalse(list(self.tmp.glob("*.~tmp")) + list(self.tmp.glob("*.~new")))  # no temp leftovers

