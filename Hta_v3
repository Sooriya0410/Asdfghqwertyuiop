        def _update_status(self, title: Optional[str] = None) -> None:
            if self.ctl is None:
                self.lbl_conn.setText("  ● Not connected")
                self.lbl_conn.setStyleSheet("color:#808080; font-weight:bold")
            else:
                hta = self.ctl.backend.kind == "hta"
                self.lbl_conn.setText(f"  ● {'HTA' if hta else 'Simulator'} connected"
                                      + ("  [DRY RUN]" if self.chk_dry.isChecked() else ""))
                self.lbl_conn.setStyleSheet("color:#2E7D32; font-weight:bold" if not self.chk_dry.isChecked()
                                            else "color:#1F4E79; font-weight:bold")
                if title:
                    self.lbl_conn.setToolTip(title)
            pend = self._pending_count
            self.lbl_pending.setText(f"Pending: {pend}  ")
            self.lbl_pending.setStyleSheet("color:#B36B00; font-weight:bold" if pend else "")
            self.lbl_file.setText((self.excel_path.name + (" *" if self.dirty else "")) if self.excel_path
                                  else "No workbook")
            connected = self.ctl is not None
            for a in (self.a_read_tab, self.a_read_all, self.a_apply_tab, self.a_apply_all, self.a_revert,
                      self.a_disc, self.a_sim_start, self.a_sim_stop, self.a_sim_reset, self.a_sim_status):
                a.setEnabled(connected)
            hta = connected and self.ctl.backend.kind == "hta"
            self.a_calib.setEnabled(hta)

        # ------------------------------------------------------ helper process
        def _pool(self) -> Any:
            if self._ppool is None and not self._ppool_failed:
                try:
                    import multiprocessing as mp
                    from concurrent.futures import ProcessPoolExecutor
                    self._ppool = ProcessPoolExecutor(max_workers=1, mp_context=mp.get_context("spawn"))
                except Exception as e:
                    self._ppool_failed = True
                    log.info("Helper process not available (%s) - heavy work runs in a thread", e)
            return self._ppool

        def run_heavy(self, fn: Callable[..., Any], args: tuple, callback: Callable[[Any], None]) -> None:
            """Excel / keyword work in a separate process: it never competes with the GUI for the
            Python interpreter, so the window stays fluid even with 10 000+ widgets.
            Falls back to the background thread if processes cannot be used."""
            emit = self.bridge.result.emit
            pool = self._pool()
            if pool is None:
                self.io.submit(lambda: fn(*args), callback)
                return
            self._heavy += 1
            user_cb = callback

            def callback(res: Any) -> None:  # noqa: F811 - wraps the caller's callback
                self._heavy -= 1
                user_cb(res)

            def fallback() -> None:
                self._ppool, self._ppool_failed = None, True
                self._heavy -= 1
                log.info("Helper process failed - continuing in a background thread")
                self.io.submit(lambda: fn(*args), user_cb)

            try:
                fut = pool.submit(fn, *args)
            except Exception:
                fallback()
                return

            def done(f: Any) -> None:
                try:
                    res: Any = f.result()
                except Exception as e:
                    from concurrent.futures.process import BrokenProcessPool
                    if isinstance(e, BrokenProcessPool):
                        emit(lambda _: fallback(), None)
                        return
                    res = e
                emit(callback, res)

            fut.add_done_callback(done)

        @property
        def busy_jobs(self) -> int:
            """Work still running anywhere (HTA worker, file thread, helper process, extraction)."""
            return self.worker.pending + self.io.pending + self._heavy + (1 if self.proc is not None else 0)

        # ---------------------------------------------------------- workbook
        def _confirm_discard(self) -> bool:
            if not (self.dirty and self.excel_path):
                return True
            r = QtWidgets.QMessageBox.question(
                self, APP_NAME, "Save Current/Set values to the workbook first?",
                QtWidgets.QMessageBox.StandardButton.Yes | QtWidgets.QMessageBox.StandardButton.No
                | QtWidgets.QMessageBox.StandardButton.Cancel)
            if r == QtWidgets.QMessageBox.StandardButton.Cancel:
                return False
            if r == QtWidgets.QMessageBox.StandardButton.Yes:
                return self.save_excel(sync=True)
            return True

        def open_excel(self, path: Optional[Path] = None, ask: bool = True) -> None:
            if self._loading:
                self.statusBar().showMessage("Still loading - please wait", 3000)
                return
            if ask and not self._confirm_discard():
                return
            if path is None:
                fn, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Open HTA signal workbook", self._last_dir(),
                                                              "Excel (*.xlsx *.xlsm)")
                if not fn:
                    return
                path = Path(fn)
            path, s = Path(path), self.s
            self.qs.setValue("last_dir", str(path.parent))
            kwfile = Path(s.keywords_file) if s.keywords_file else None

            self._set_loading(True, f"Opening {path.name} ...")
            self.run_heavy(proc_open_workbook, (str(path), s, str(kwfile) if kwfile else None), self._adopt_bundle)

        def _set_loading(self, on: bool, text: str = "") -> None:
            self._loading = on
            for a in (self.a_open, self.a_extract, self.a_kw_refresh, self.a_kw_gen, self.a_kw_import):
                a.setEnabled(not on)
            self._busy(text if on else "")

        def _adopt_bundle(self, b: Any) -> None:
            """Install a loaded / extracted workbook (runs in the GUI thread, cheap)."""
            self._set_loading(False)
            if isinstance(b, Exception):
                self._error("Cannot open workbook", b)
                return
            self.table, self.excel_path, self.dirty = b["table"], b["path"], False
            self._rebuild_tabs()
            if self.ctl is not None:
                ctl, table = self.ctl, self.table
                self.worker.submit(lambda: ctl.rebind(table))
            self.seq.set_steps(b["steps"])
            self.kw_path = b["kw_path"]
            self._apply_keywords((b["kw_path"], b["km"], b["problems"], b["written"]), regenerate=b["regenerate"],
                                 table=self.table)
            import gc
            gc.collect()
            self.cfg_path = b["cfg_path"]
            if b["profiles"] is not None:
                self.config.set_profiles(b["profiles"], self.cfg_path)
            self._update_status()
            log.info("Workbook %s: %d widgets on %d tabs, %d keywords", self.excel_path.name, len(self.table),
                     len(self.table.tabs()), len(b["km"]))
            if self._auto_sim and self.ctl is None:
                self._auto_sim = False
                self.connect_backend("sim")
            if b.get("extracted"):
                QtWidgets.QMessageBox.information(
                    self, "Extract", f"{len(self.table)} widgets on {len(self.table.tabs())} tabs written to\n"
                                     f"{self.excel_path}\n\nKeywords: {self.kw_path}")

        def save_excel(self, sync: bool = False) -> bool:
            if not self.excel_path:
                return self.save_excel_as()
            path, table = self.excel_path, self.table
            if sync:
                QtWidgets.QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
                try:
                    update_excel_values(path, table)
                except Exception as e:
                    self._error("Save failed", e)
                    return False
                finally:
                    QtWidgets.QApplication.restoreOverrideCursor()
                self._on_saved(path)
                return True
            self._busy(f"Saving {path.name} ...")
            self.run_heavy(proc_save, (str(path), excel_value_updates(table)), self._on_saved)
            return True

        def _on_saved(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Save failed", res)
                return
            self.dirty = False
            self._update_status()
            self.statusBar().showMessage(f"Saved {Path(res).name}", 4000)

        def save_excel_as(self) -> bool:
            start = str(self.excel_path) if self.excel_path else self._last_dir()
            fn, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Save workbook as", start, "Excel (*.xlsx)")
            if not fn:
                return False
            try:
                if self.excel_path and self.excel_path.exists():
                    if Path(fn).resolve() != self.excel_path.resolve():
                        shutil.copyfile(self.excel_path, fn)
                    update_excel_values(fn, self.table)
                else:
                    export_excel(self.table, fn)
            except Exception as e:
                self._error("Save failed", e)
                return False
            self.excel_path, self.dirty = Path(fn), False
            self._update_status()
            return True

        def _rebuild_tabs(self) -> None:
            """Models for every tab, but a table view only for tabs that are actually opened."""
            self.tabs.blockSignals(True)
            while self.tabs.count():
                wdg = self.tabs.widget(0)
                self.tabs.removeTab(0)
                wdg.deleteLater()
            self.models.clear()
            self.proxies.clear()
            self.view_tab.clear()
            self.views.clear()
            for tab in self.table.tabs():
                model = SignalModel(self.table.in_tab(tab), self.on_set_value_edited)
                proxy = FilterProxy(self)
                proxy.setSourceModel(model)
                page = QtWidgets.QWidget()
                lay = QtWidgets.QVBoxLayout(page)
                lay.setContentsMargins(0, 0, 0, 0)
                self.models[tab], self.proxies[tab], self.view_tab[page] = model, proxy, tab
                self.tabs.addTab(page, tab.replace("&", "&&"))
            self.tabs.blockSignals(False)
            self.central.setCurrentIndex(1 if self.table.tabs() else 0)
            self._ensure_view(self._current_tab_name())
            self._apply_filter()

        def _ensure_view(self, tab: Optional[str]) -> Optional["SignalView"]:
            if tab is None or tab not in self.models:
                return None
            v = self.views.get(tab)
            if v is not None:
                return v
            page = next(p for p, t in self.view_tab.items() if t == tab)
            v = SignalView(self)
            v.setModel(self.proxies[tab])
            v.selectionModel().currentRowChanged.connect(
                lambda cur, _prev: self.control.show_widget(cur.data(WIDGET_ROLE) if cur.isValid() else None))
            v.customContextMenuRequested.connect(lambda pos, vv=v: self.on_table_menu(vv, pos))
            for i, wd in enumerate([220, 62, 90, 60, 60, 50, 90, 90, 210, 320]):
                v.setColumnWidth(i, wd)
            page.layout().addWidget(v)
            self.views[tab] = v
            return v

        def _current_tab_name(self) -> Optional[str]:
            return self.view_tab.get(self.tabs.currentWidget())

        def _current_view(self) -> Optional["SignalView"]:
            return self._ensure_view(self._current_tab_name())

        def _on_tab_changed(self) -> None:
            v = self._current_view()
            ws = v.selected_widgets() if v else []
            self.control.show_widget(ws[0] if ws else None)

        def _apply_filter(self) -> None:
            for p in self.proxies.values():
                p.set_filter(self.search.text(), self.chk_pending.isChecked(), self.chk_writable.isChecked())
            self._update_tab_titles()

        def _update_tab_titles(self) -> None:
            self._counts_timer.start()   # coalesced: at most one recount per 200 ms

        def _refresh_counts(self) -> None:
            total = 0
            for i in range(self.tabs.count()):
                tab = self.view_tab.get(self.tabs.widget(i))
                if tab is None:
                    continue
                pend = sum(1 for w in self.models[tab].rows if is_pending(w))
                total += pend
                self.tabs.setTabText(i, f"{tab.replace('&', '&&')} ({self.proxies[tab].rowCount()})"
                                     + (f"  ●{pend}" if pend else ""))
            self._pending_count = total
            self._update_status()

        def _refresh_many(self, ws: Sequence[Widget]) -> None:
            by_tab: Dict[str, List[Widget]] = defaultdict(list)
            for w in ws:
                by_tab[w.tab].append(w)
            for tab, lst in by_tab.items():
                m = self.models.get(tab)
                if m is None:
                    continue
                if len(lst) > 40:
                    m.refresh_all()
                else:
                    for w in lst:
                        m.refresh(w)
            if self.control.w is not None and self.control.w in set(ws):
                self.control.refresh()
            if self.chk_pending.isChecked():
                self._filter_timer.start()
            self._update_tab_titles()

        def _refresh_widget(self, w: Widget) -> None:
            m = self.models.get(w.tab)
            if m is not None:
                m.refresh(w)
            if self.control.w is w:
                self.control.refresh()

        def on_set_value_edited(self, w: Widget) -> None:
            self.dirty = True
            if self.control.w is w:
                self.control.refresh()
            self._update_tab_titles()
            if self.chk_live.isChecked() and is_pending(w) and self.ctl is not None:
                self._apply([w])

        def clear_set_values(self, widgets: Optional[List[Widget]]) -> None:
            if widgets is None:
                tab = self._current_tab_name()
                widgets = self.table.in_tab(tab) if tab else []
            for w in widgets:
                w.set_value = ""
                if w.status in ("pending", "= current"):
                    w.status = ""
                self._refresh_widget(w)
            self.dirty = True
            self._update_status()
            self._update_tab_titles()

        def copy_current_to_set(self) -> None:
            tab = self._current_tab_name()
            for w in (self.table.in_tab(tab) if tab else []):
                if w.writable and w.current:
                    try:
                        w.set_value = validate_value(w, w.current)
                    except ValueError:
                        continue
                    self._refresh_widget(w)
            self.dirty = True
            self._update_status()

        def on_table_menu(self, view: SignalView, pos) -> None:
            ws = [w for w in view.selected_widgets() if w is not None]
            if not ws:
                return
            m = QtWidgets.QMenu(self)
            m.addAction(f"Apply Set Value ({len(ws)})", lambda: self.apply_widgets(ws))
            m.addAction("Read from HTA", lambda: self._read(ws))
            if len(ws) == 1 and ws[0].wtype in ("Button", "CheckBox"):
                m.addAction("Press once (click)", lambda: self.press_widget(ws[0]))
            if len(ws) == 1 and ws[0].writable and ws[0].min is not None and ws[0].max is not None:
                w0 = ws[0]
                m.addAction(f"Set Value = Min ({fmt_num(w0.min)})", lambda: self._set_cell(w0, fmt_num(w0.min)))
                m.addAction(f"Set Value = Max ({fmt_num(w0.max)})", lambda: self._set_cell(w0, fmt_num(w0.max)))
            m.addAction("Clear Set Value", lambda: self.clear_set_values(ws))
            m.addSeparator()
            m.addAction("Add to Watch", lambda: [self._add_watch(w) for w in ws])
            m.addAction("Toggle Critical flag", lambda: self._toggle_critical(ws))
            m.addSeparator()
            m.addAction("Copy name(s)", lambda: QtWidgets.QApplication.clipboard().setText(
                "\n".join(w.label for w in ws)))
            m.addAction("Copy path(s)", lambda: QtWidgets.QApplication.clipboard().setText(
                "\n".join(w.path for w in ws)))
            m.exec(view.viewport().mapToGlobal(pos))

        def _set_cell(self, w: Widget, value: str) -> None:
            w.set_value = value
            w.status = "pending" if is_pending(w) else ""
            self._refresh_widget(w)
            self.on_set_value_edited(w)

        def _toggle_critical(self, ws: List[Widget]) -> None:
            for w in ws:
                w.critical = not w.critical
                self._refresh_widget(w)

        def _add_watch(self, w: Widget) -> None:
            self.watch.add(w)
            self.d_watch.show()
            self.d_watch.raise_()

        # ----------------------------------------------------------- backend
        def connect_backend(self, kind: str) -> None:
            if self.ctl is not None:
                self.disconnect_backend()
            table, s, hwnd, demo, audit = self.table, self.s, int(self.winId()), self.demo, self.audit

            def job():
                if kind == "hta":
                    be: Backend = HtaUiaBackend(s)
                else:
                    be = demo_simulator(s, table) if demo else SimulatorBackend(s, table)
                be.own_hwnd = hwnd
                title = be.connect()
                return Controller(be, table, s, audit), title

            self._busy("Connecting to HTA ..." if kind == "hta" else "Starting simulator ...")
            self.worker.submit(job, self._on_connected)

        def _on_connected(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Connection failed", res)
                return
            self.ctl, title = res
            log.info("Connected: %s", title)
            self._update_status(title)
            self.console.show_lines([CmdLine("ok", f"connected: {title}")])
            self.refresh_sim_status()

        def disconnect_backend(self) -> None:
            ctl, self.ctl = self.ctl, None
            if ctl is not None:
                self.worker.submit(lambda: ctl.backend.disconnect())
                log.info("Disconnected")
            self.watch.btn_run.setChecked(False)
            self._set_sim_label("-")
            self._update_status()

        def stop(self) -> None:
            self.stop_event.set()
            if self.proc is not None:
                self.proc.kill()
                log.warning("Extraction aborted by user")
            self.statusBar().showMessage("Stop requested", 3000)

        def read_current_tab(self) -> None:
            tab = self._current_tab_name()
            if tab:
                self._read(self.table.in_tab(tab))

        def read_all(self) -> None:
            self._read(list(self.table))

        def _read(self, widgets: List[Widget]) -> None:
            if not self._need_ctl() or not widgets:
                return
            ctl, stop, emit = self.ctl, self._new_stop(), self.bridge.result.emit
            self._busy(f"Reading {len(widgets)} signal(s) ...")

            def job():
                b = Batcher(lambda ws: emit(self._refresh_many, ws))
                res = ctl.read_many(widgets, True, stop, on_value=lambda w, v: b.add(w))
                b.flush()
                return res

            self.worker.submit(job, self._on_read_done)

        def _on_read_done(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Read failed", res)
                return
            ok = sum(1 for v in res.values() if v is not None)
            log.info("Read %d/%d signals", ok, len(res))
            self.dirty = True
            self._update_status()
            self._update_tab_titles()

        def apply_widgets(self, widgets: List[Widget]) -> None:
            ws = [w for w in widgets if w is not None and w.writable and str(w.set_value).strip()]
            if not ws:
                self.statusBar().showMessage("Nothing to apply - fill the Set Value column first", 4000)
                return
            self._apply(ws)

        def apply_pending(self, all_tabs: bool) -> None:
            ws = self.table.pending() if all_tabs else self.table.pending(self._current_tab_name())
            if not ws:
                self.statusBar().showMessage("No pending values", 3000)
                return
            self._apply(ws)

        def apply_single(self, w: Widget, value: str) -> None:
            try:
                w.set_value = validate_value(w, value)
            except ValueError as e:
                w.status = f"Invalid: {e}"
                self._refresh_widget(w)
                QtWidgets.QMessageBox.warning(self, "Invalid value", str(e))
                return
            self._refresh_widget(w)
            self._apply([w])

        def _apply(self, widgets: List[Widget]) -> None:
            if not self._need_ctl():
                return
            dry = self.chk_dry.isChecked()
            crit = [w for w in widgets if w.critical]
            if crit and self.s.confirm_critical and not dry:
                lines = "\n".join(f"  {w.key}  ->  {w.set_value}" for w in crit[:15])
                more = f"\n  ... and {len(crit) - 15} more" if len(crit) > 15 else ""
                r = QtWidgets.QMessageBox.question(self, "Critical signals",
                                                   f"Write these CRITICAL signals to HTA?\n\n{lines}{more}")
                if r != QtWidgets.QMessageBox.StandardButton.Yes:
                    return
            ctl, stop, emit = self.ctl, self._new_stop(), self.bridge.result.emit
            self._busy(f"{'Dry-run' if dry else 'Writing'} {len(widgets)} value(s) ...")

            def job():
                b = Batcher(lambda items: emit(self._on_write_many, items), max_items=100)
                res = ctl.apply_pending(widgets, dry, stop, on_result=lambda w, r: b.add((w, r)))
                b.flush()
                return res

            self.worker.submit(job, self._on_apply_done)

        def _on_write_many(self, items: Sequence[Tuple[Widget, WriteResult]]) -> None:
            self.dirty = True
            self._refresh_many([w for w, _ in items])
            bad = [(w, r) for w, r in items if not r.ok]
            if bad:
                self.statusBar().showMessage(f"FAILED {bad[-1][0].key}: {bad[-1][1].message}", 8000)

        def _on_write(self, payload: Tuple[Widget, WriteResult]) -> None:
            w, r = payload
            self.dirty = True
            self._refresh_widget(w)
            if not r.ok:
                self.statusBar().showMessage(f"FAILED {w.key}: {r.message}", 8000)

        def _on_apply_done(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Write failed", res)
                return
            ok = sum(1 for r in res if r.ok)
            bad = [r for r in res if not r.ok]
            self.statusBar().showMessage(f"Applied {ok}/{len(res)}", 5000)
            self._update_status()
            self._update_tab_titles()
            if bad:
                QtWidgets.QMessageBox.warning(self, "Some writes failed", "\n".join(
                    f"{r.key}: {r.message}" for r in bad[:20]))

        def press_widget(self, w: Widget) -> None:
            if not self._need_ctl():
                return
            if w.critical and self.s.confirm_critical and not self.chk_dry.isChecked():
                if QtWidgets.QMessageBox.question(self, "Critical", f"Press {w.key}?") != \
                        QtWidgets.QMessageBox.StandardButton.Yes:
                    return
            ctl, dry, emit = self.ctl, self.chk_dry.isChecked(), self.bridge.result.emit
            self.worker.submit(lambda: emit(self._on_write, (w, ctl.press(w, dry))))

        def revert_last(self) -> None:
            if not self._need_ctl():
                return
            ctl, dry = self.ctl, self.chk_dry.isChecked()
            by_key = {w.key: w for w in self.table}

            def done(res: Any) -> None:
                if isinstance(res, Exception):
                    self._error("Revert failed", res)
                elif res is None:
                    self.statusBar().showMessage("Nothing to revert", 3000)
                else:
                    w = by_key.get(res.key)
                    if w is not None:
                        self._on_write((w, res))
                    self.statusBar().showMessage(f"Reverted {res.key} -> {res.requested}", 5000)

            self.worker.submit(lambda: ctl.revert_last(dry), done)

        def poll_watch(self, widgets: List[Widget]) -> None:
            if self._watch_busy or self.ctl is None or not widgets or self.worker.pending:
                return
            self._watch_busy = True
            ctl = self.ctl
            self.worker.submit(lambda: ctl.read_many(widgets, allow_switch=False), self._on_watch)

        def _on_watch(self, res: Any) -> None:
            self._watch_busy = False
            if isinstance(res, Exception):
                return
            self.watch.update_values(res)
            for w in res:
                self._refresh_widget(w)

        # ---------------------------------------------------------- sequence
        def reload_sequence(self, quiet: bool = False) -> None:
            if not self.excel_path:
                return
            try:
                self.seq.set_steps(load_sequence(self.excel_path))
            except KeyError:
                self.seq.set_steps([])
                if not quiet:
                    QtWidgets.QMessageBox.information(self, APP_NAME, "This workbook has no 'Sequence' sheet.")
            except Exception as e:
                if not quiet:
                    self._error("Cannot load sequence", e)

        def load_sequence_file(self) -> None:
            fn, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Workbook with a Sequence sheet", self._last_dir(),
                                                          "Excel (*.xlsx *.xlsm)")
            if fn:
                try:
                    self.seq.set_steps(load_sequence(fn))
                except Exception as e:
                    self._error("Cannot load sequence", e)

        def run_sequence(self) -> None:
            if not self._need_ctl():
                return
            steps = list(self.seq.steps)
            if not steps:
                QtWidgets.QMessageBox.information(self, APP_NAME, "No sequence loaded.")
                return
            dry = self.chk_dry.isChecked()
            crit = []
            for st in steps:
                if st.enabled and st.action in ("SET", "PRESS"):
                    try:
                        w = self.table.find(st.name, st.tab or None, writable=True)
                        if w.critical:
                            crit.append(f"  step {st.step}: {w.key} -> {st.value or 'press'}")
                    except KeyError:
                        pass
            if crit and self.s.confirm_critical and not dry:
                if QtWidgets.QMessageBox.question(
                        self, "Run sequence", "The sequence writes CRITICAL signals:\n\n" + "\n".join(crit[:20])
                        + "\n\nRun it?") != QtWidgets.QMessageBox.StandardButton.Yes:
                    return
            self.seq.reset_results()
            ctl, s, stop, emit = self.ctl, self.s, self._new_stop(), self.bridge.result.emit
            runner = SequenceRunner(ctl, s, dry, stop, prompt=self._prompt_from_worker,
                                    on_step=lambda i, st, r: emit(self.seq.on_step, (i, st, r)))
            meta = {"workbook": str(self.excel_path or ""), "backend": ctl.backend.kind, "dry_run": dry,
                    "user": self.audit.user}

            def job():
                results = runner.run(steps)
                meta.update(started=runner.started, finished=runner.finished)
                path: Optional[Path] = s.report_path() / f"SeqReport_{_dt.datetime.now():%Y%m%d_%H%M%S}.xlsx"
                try:
                    write_sequence_report(results, path, meta)
                except Exception as e:
                    log.error("Report not written: %s", e)
                    path = None
                return results, path

            self.d_seq.show()
            self.d_seq.raise_()
            self._busy("Running sequence ...")
            self.worker.submit(job, self._on_seq_done)

        def _prompt_from_worker(self, msg: str) -> bool:
            holder = {"ok": False, "ev": threading.Event()}
            self.bridge.prompt.emit(msg, holder)
            holder["ev"].wait()
            return holder["ok"]

        def _on_prompt(self, msg: str, holder: dict) -> None:
            r = QtWidgets.QMessageBox.question(
                self, "Sequence paused", f"{msg}\n\nOK = continue,  Cancel = abort",
                QtWidgets.QMessageBox.StandardButton.Ok | QtWidgets.QMessageBox.StandardButton.Cancel)
            holder["ok"] = r == QtWidgets.QMessageBox.StandardButton.Ok
            holder["ev"].set()

        def _on_seq_done(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Sequence failed", res)
                return
            results, path = res
            self.last_report = path
            verdict = overall_verdict(results)
            cnt = Counter(r.verdict for r in results)
            self.seq.summary.setText(f"<b>{verdict}</b>  -  " + ", ".join(f"{k} {v}" for k, v in sorted(cnt.items()))
                                     + (f"   report: {path.name}" if path else ""))
            self.seq.summary.setStyleSheet("color:#2E7D32" if verdict == "PASS" else "color:#C00000")
            for w in self.table:
                self._refresh_widget(w)
            self.dirty = True
            self._update_status()

        # ------------------------------------------------------- extraction
        def extract_flow(self) -> None:
            if self._loading:
                return
            base = self.excel_path.parent if self.excel_path else Path(self._last_dir())
            dlg = ExtractDialog(self, self.s, base / f"HTA_Signals_{_dt.date.today():%Y%m%d}.xlsx",
                                self.worker.submit)
            if dlg.exec() != QtWidgets.QDialog.DialogCode.Accepted:
                return
            if not self._confirm_discard():
                return
            cfg = dlg.config()
            args = ["extract", "-o", cfg["out"]]
            for src in cfg["sources"]:
                args += ["--xml", src]
            if cfg["live"]:
                args.append("--live")
            if cfg["dialogs"]:
                args += ["--dialogs", cfg["dialogs"]]
            if self.s.keywords_file:
                args += ["--keywords", self.s.keywords_file]
            self._run_extract_process(args)

        def _run_extract_process(self, args: List[str]) -> None:
            """Extraction runs as its own Python process: the GUI can never freeze, Abort kills it."""
            self._extract_result: Optional[dict] = None
            self._extract_tail: List[str] = []
            frozen = getattr(sys, "frozen", False)
            prog_args = ([] if frozen else [os.path.abspath(__file__)]) + args
            p = QtCore.QProcess(self)
            env = QtCore.QProcessEnvironment.systemEnvironment()
            env.insert("HTA_BRIDGE_HOME", str(HOME_DIR))
            env.insert("PYTHONUNBUFFERED", "1")
            env.insert("PYTHONIOENCODING", "utf-8")
            p.setProcessEnvironment(env)
            p.setProcessChannelMode(QtCore.QProcess.ProcessChannelMode.MergedChannels)
            p.readyReadStandardOutput.connect(self._extract_output)
            p.finished.connect(self._extract_finished)
            self.proc = p
            self._set_loading(True, "Extracting ...")
            log.info("Extraction started: %s", " ".join(args))
            p.start(sys.executable, prog_args)

        def _extract_output(self) -> None:
            if self.proc is None:
                return
            text = bytes(self.proc.readAllStandardOutput()).decode("utf-8", "replace")
            for line in text.splitlines():
                line = line.rstrip()
                if not line:
                    continue
                if line.startswith("@@RESULT "):
                    try:
                        self._extract_result = json.loads(line[9:])
                    except ValueError:
                        pass
                    continue
                self._extract_tail = (self._extract_tail + [line])[-30:]
                msg = re.sub(r"^(INFO|WARNING|ERROR|DEBUG)\s+", "", line)
                self.lbl_busy.setText("  " + msg[:120])
                if line.startswith(("WARNING", "ERROR")):
                    log.warning("extract: %s", msg)

        def _extract_finished(self, code: int, _status=None) -> None:
            self._extract_output()
            self.proc = None
            self._set_loading(False)
            res = self._extract_result
            if code != 0 or not res:
                self._error("Extraction failed", "\n".join(self._extract_tail[-12:]) or f"exit code {code}")
                return
            log.info("Extraction finished: %s widgets, %s tabs -> %s", res["widgets"], res["tabs"], res["excel"])
            path = Path(res["excel"])
            kwfile = res.get("keywords") or None

            def adopt(b: Any) -> None:
                if isinstance(b, dict):
                    b["extracted"] = True
                self._adopt_bundle(b)

            self._set_loading(True, f"Opening {path.name} ...")
            self.run_heavy(proc_open_workbook, (str(path), self.s, kwfile), adopt)

        def inspect_hta(self) -> None:
            fn, _ = QtWidgets.QFileDialog.getSaveFileName(
                self, "Save HTA control dump", str(HOME_DIR / f"hta_inspect_{_dt.datetime.now():%Y%m%d_%H%M}.txt"),
                "Text (*.txt)")
            if not fn:
                return
            backend = self.ctl.backend if (self.ctl and isinstance(self.ctl.backend, HtaUiaBackend)) else None
            s = self.s

            def job():
                be = backend
                if be is None:
                    be = HtaUiaBackend(s)
                    be.connect()
                return be.inspect(fn)

            self._busy("Inspecting HTA ...")
            self.worker.submit(job, lambda r: (self._busy(""), self._error("Inspect failed", r)
                                               if isinstance(r, Exception) else _open_path(r)))

        def recalibrate(self) -> None:
            if self.ctl is None or not isinstance(self.ctl.backend, HtaUiaBackend):
                return
            be = self.ctl.backend
            self.worker.submit(be.calibrate_all, lambda r: None if isinstance(r, Exception) else
                               log.info("Calibrated %d tabs", len(r)))

        # ----------------------------------------------------------- keywords
        def _load_keywords(self, regenerate: bool = False) -> None:
            if not self.table.widgets:
                return
            table, s = self.table, self.s
            path = self.kw_path or s.keywords_path(self.excel_path)
            self._busy("Generating keywords ..." if regenerate else "Loading keywords ...")

            def done(r: Any) -> None:
                if not isinstance(r, Exception) and table is self.table:
                    p, km, problems, written = r
                    problems = list(dict.fromkeys(list(problems) + km.resolve(table)))  # link to GUI widgets
                    r = (p, km, problems, written)
                self._apply_keywords(r, regenerate, table)

            self.run_heavy(proc_keywords, (table, str(path), s, regenerate), done)

        def _apply_keywords(self, res: Any, regenerate: bool, table: SignalTable) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Keywords", res)
                return
            if table is not self.table:
                return  # a different workbook was opened meanwhile
            path, km, problems, written = res
            self.kw_path, self.kwmap = Path(path), km
            self.engine.bind(self.table, km)
            unmapped = len(km.unmapped(self.table))
            self.kwpanel.load(km, self.kw_path, problems, unmapped)
            self.console.set_words(km.words() + list(CONSOLE_BUILTINS))
            for m in self.models.values():
                m.refresh_all()
            if self.control.w is not None:
                self.control.show_widget(self.control.w)
            for p in problems[:15]:
                log.warning("Keyword %s", p)
            log.info("Keywords %s %s: %d", "written to" if written else "loaded from", self.kw_path.name, len(km))
            if unmapped and not regenerate:
                log.info("%d signal(s) have no keyword - Keywords -> Generate / update", unmapped)

        def refresh_keywords(self) -> None:
            self._load_keywords(False)

        def generate_keywords_file(self) -> None:
            self._load_keywords(True)

        def import_keywords(self) -> None:
            fn, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Keywords workbook",
                                                          str(self.kw_path or self._last_dir()), "Excel (*.xlsx *.xlsm)")
            if fn:
                self.kw_path = Path(fn)
                self._load_keywords(False)

        def open_keywords_file(self) -> None:
            p = self.kw_path or self.s.keywords_path(self.excel_path)
            if p.exists():
                _open_path(p)
            else:
                QtWidgets.QMessageBox.information(self, APP_NAME, "Open a signal workbook first - "
                                                                  "Keywords.xlsx is created next to it.")

        def show_console(self) -> None:
            self.d_console.show()
            self.d_console.raise_()
            self.console.inp.setFocus()

        def show_config(self) -> None:
            self.d_config.show()
            self.d_config.raise_()

        def show_libs(self) -> None:
            LibsDialog(self, self.s).exec()
            self._check_libs()

        def _check_libs(self) -> None:
            miss = [r for r in check_requirements() if not r["installed"]]
            self.a_libs.setText(f"Libs ({len(miss)} missing)" if miss else "Libs")
            if miss:
                log.warning("Missing libraries: %s - click 'Libs' to install",
                            ", ".join(r["package"] for r in miss))

        def _restore_history(self) -> None:
            h = self.qs.value("console_history")
            if isinstance(h, (list, tuple)):
                self.console.inp.history = [str(x) for x in h][-300:]
                self.console.inp.pos = len(self.console.inp.history)

        def on_console(self, text: str) -> None:
            dry, stop, eng = self.chk_dry.isChecked(), self._new_stop(), self.engine
            self._busy(f"> {text}")
            self.worker.submit(lambda: eng.execute(text, dry, stop), self._on_console_done)

        def _on_console_done(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self.console.show_lines([CmdLine("error", f"{type(res).__name__}: {res}")])
                return
            self.console.show_lines(res)
            for line in res:
                if line.level == "action":
                    self._console_action(line.text)
            for m in self.models.values():
                m.refresh_all()
            self.control.refresh()
            self.kwpanel.refresh_current()
            if any(l.level == "ok" for l in res):
                self.dirty = True
            self._update_tab_titles()

        def _console_action(self, action: str) -> None:
            name, _, arg = action.partition(":")
            if name == "dry":
                self.chk_dry.setChecked(arg == "on")
            elif name == "cls":
                self.console.out.clear()
            elif name == "refresh":
                self._load_keywords(False)
                self.console.show_lines([CmdLine("ok", f"keywords reloaded: {len(self.kwmap)}")])
            elif name == "apply":
                self.apply_pending(True)
            elif name == "run":
                self.run_sequence()
            elif name == "connect":
                self.connect_backend("sim" if arg == "sim" else "hta")
            elif name == "disconnect":
                self.disconnect_backend()
            elif name == "hist":
                h = self.console.inp.history[-50:]
                self.console.show_lines([CmdLine("info", f"{i + 1:3d}  {t}") for i, t in enumerate(h)])
            elif name == "read_tab":
                self.read_current_tab()

        # --------------------------------------------------------- simulation
        def sim_action(self, action: str) -> None:
            if not self._need_ctl():
                return
            dry = self.chk_dry.isChecked()
            if action == "reset" and self.s.confirm_critical and not dry:
                if QtWidgets.QMessageBox.question(self, "Reset simulation", "Reset the HTA simulation?") != \
                        QtWidgets.QMessageBox.StandardButton.Yes:
                    return
            ctl = self.ctl
            self._busy(f"Simulation {action} ...")
            self.worker.submit(lambda: ctl.sim(action, dry), lambda r, a=action: self._on_sim_done(a, r))

        def _on_sim_done(self, action: str, r: Any) -> None:
            self._busy("")
            if isinstance(r, Exception):
                self._error(f"Simulation {action}", r)
                return
            if r.ok:
                self._set_sim_label(r.after or ("dry run" if r.dry_run else "?"))
                self.console.show_lines([CmdLine("ok", f"simulation {action.upper()}: {r.after or r.message}")])
                if action == "reset" and not r.dry_run:
                    self.read_current_tab()
            else:
                self.console.show_lines([CmdLine("error", f"simulation {action.upper()} failed: {r.message}")])
                QtWidgets.QMessageBox.warning(self, "Simulation", f"{action.upper()} failed:\n{r.message}")

        def refresh_sim_status(self) -> None:
            if self.ctl is None:
                self._set_sim_label("-")
                return
            ctl = self.ctl
            self.worker.submit(ctl.sim_status, lambda r: self._set_sim_label("?" if isinstance(r, Exception) else r))

        def _set_sim_label(self, text: Any) -> None:
            t = str(text)
            low = t.lower()
            color = "#2E7D32" if "running" in low else "#B36B00" if ("stop" in low or "load" in low) else "#555555"
            self.lbl_sim.setText(f"  {t[:60]}  ")
            self.lbl_sim.setStyleSheet(f"color:{color}; font-weight:bold")
            self.lbl_sim.setToolTip(t)

        # ------------------------------------------------- channels / hardware
        def list_hta_menus(self) -> None:
            if not self._need_ctl():
                return
            ctl = self.ctl
            self._busy("Reading HTA menus ...")
            self.worker.submit(lambda: ctl.backend.menu_paths(), self._on_menus)

        def _on_menus(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("HTA menus", res)
                return
            self.config.set_menus(res)
            self.console.show_lines([CmdLine("info", f"HTA menu: {p}") for p in res])
            log.info("%d HTA menu entries listed", len(res))
            self.show_config()

        def click_hta_menu(self) -> None:
            path = self.config.menu.currentText().strip()
            if not path or not self._need_ctl():
                return
            ctl, dry = self.ctl, self.chk_dry.isChecked()

            def done(r: Any) -> None:
                if isinstance(r, Exception) or not r.ok:
                    self._error("HTA menu", r if isinstance(r, Exception) else r.message)

            self.worker.submit(lambda: ctl.invoke_menu(path, dry), done)

        def capture_dialog(self) -> None:
            if not self._need_ctl():
                return
            path, ctl = self.config.menu.currentText().strip(), self.ctl
            self._busy("Capturing HTA dialog ...")
            self.worker.submit(lambda: ctl.dialog_capture(path, ""), self._on_captured)

        def _on_captured(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Capture dialog", res)
                return
            title, items = res
            self.config.set_items(items, title)
            log.info("Captured dialog '%s': %d fields", title, len(items))
            self.show_config()

        def apply_dialog(self) -> None:
            if not self._need_ctl():
                return
            prof = self.config.current_profile()
            todo = [i for i in prof.items if i.set_value]
            if not todo:
                self.statusBar().showMessage("Fill the 'Set Value' column first", 4000)
                return
            bad = []
            for i in todo:
                try:
                    dialog_validate(i, i.set_value)
                except ValueError as e:
                    bad.append(str(e))
            if bad:
                QtWidgets.QMessageBox.warning(self, "Invalid values", "\n".join(bad[:20]))
                return
            dry = self.chk_dry.isChecked()
            if not dry and self.s.confirm_critical:
                where = prof.menu_path or self.config.title or "open dialog"
                if QtWidgets.QMessageBox.question(
                        self, "Apply configuration",
                        f"Write {len(todo)} field(s) into the HTA dialog '{where}' and press {prof.press}?") != \
                        QtWidgets.QMessageBox.StandardButton.Yes:
                    return
            ctl = self.ctl
            self._busy("Applying configuration ...")
            self.worker.submit(lambda: ctl.dialog_apply(prof.menu_path, prof.title_re, prof.items, prof.press, dry),
                               self._on_dialog_applied)

        def _on_dialog_applied(self, res: Any) -> None:
            self._busy("")
            if isinstance(res, Exception):
                self._error("Apply configuration", res)
                return
            title, results = res
            self.config.set_results(results)
            ok = sum(1 for r in results if r.ok)
            self.statusBar().showMessage(f"Configuration: {ok}/{len(results)} field(s) applied to '{title}'", 6000)
            if ok < len(results):
                QtWidgets.QMessageBox.warning(self, "Configuration", "\n".join(
                    f"{r.key}: {r.message}" for r in results if not r.ok)[:3000])

        def save_profile(self) -> None:
            prof = self.config.current_profile()
            if not prof.items:
                QtWidgets.QMessageBox.information(self, APP_NAME, "Capture a dialog first.")
                return
            path = self.cfg_path or self.s.config_path(self.excel_path)
            try:
                save_config_profile(path, prof)
            except Exception as e:
                self._error("Save profile", e)
                return
            self.cfg_path = Path(path)
            self.load_profiles(self.cfg_path, quiet=True)
            self.config.profile.setCurrentText(prof.name)
            self.statusBar().showMessage(f"Profile '{prof.name}' saved to {self.cfg_path.name}", 5000)

        def load_profiles(self, path: Optional[Path] = None, quiet: bool = False) -> None:
            if path is None:
                fn, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Configuration profiles",
                                                              str(self.cfg_path or self._last_dir()), "Excel (*.xlsx)")
                if not fn:
                    return
                path = Path(fn)
            try:
                profs = load_config_profiles(path)
            except Exception as e:
                if not quiet:
                    self._error("Load profiles", e)
                return
            self.cfg_path = Path(path)
            self.config.set_profiles(profs, self.cfg_path)

        # ------------------------------------------------------------- misc
        def edit_settings(self) -> None:
            dlg = SettingsDialog(self, self.s)
            if dlg.exec() != QtWidgets.QDialog.DialogCode.Accepted:
                return
            try:
                dlg.apply_to(self.s)
                self.s.save()
            except Exception as e:
                self._error("Invalid setting", e)
                return
            self.audit = AuditLog(self.s.audit_path())
            if self.ctl is not None:
                self.ctl.audit = self.audit
            log.info("Settings saved to %s", Settings.file())

        def run_selftest_gui(self) -> None:
            def job():
                import io
                buf = io.StringIO()
                rc = run_selftest(verbosity=1, stream=buf)
                return rc, buf.getvalue()

            def done(res: Any) -> None:
                if isinstance(res, Exception):
                    self._error("Self-test crashed", res)
                    return
                rc, text = res
                for line in text.splitlines()[-40:]:
                    log.info("selftest: %s", line)
                (QtWidgets.QMessageBox.information if rc == 0 else QtWidgets.QMessageBox.warning)(
                    self, "Self-test", "All tests passed." if rc == 0 else "Some tests FAILED - see the log.")

            self.worker.submit(job, done)

        def about(self) -> None:
            QtWidgets.QMessageBox.about(
                self, APP_NAME,
                f"<h3>{APP_NAME} {__version__}</h3>"
                "<p>Extract the Hybrid Test Application (HTA) into Excel and drive it from a GUI, "
                "the command line or test sequences.</p>"
                f"<p>Settings: {Settings.file()}<br>Audit: {self.s.audit_path()}<br>"
                f"Reports: {self.s.report_path()}<br>Logs: {HOME_DIR / 'logs'}</p>")

        def closeEvent(self, ev) -> None:
            if not self._confirm_discard():
                ev.ignore()
                return
            self._save_state()
            self.qs.setValue("console_history", self.console.inp.history[-300:])
            self.watch.timer.stop()
            self.stop_event.set()
            log.removeHandler(self.log_handler)
            if self.proc is not None:
                self.proc.kill()
            if self.ctl is not None:
                ctl = self.ctl
                self.worker.submit(lambda: ctl.backend.disconnect())
            self.worker.shutdown()
            self.io.shutdown()
            self._shutdown_pool()
            super().closeEvent(ev)

        def _shutdown_pool(self) -> None:
            """Stop the helper process cleanly (Python 3.7+: shutdown(wait=False) can hang the exit)."""
            pool, self._ppool = self._ppool, None
            if pool is None:
                return
            if self._heavy:  # a job is still running -> stop it instead of waiting for it
                for pr in list(getattr(pool, "_processes", {}).values()):
                    try:
                        pr.terminate()
                    except Exception:
                        pass
            try:
                pool.shutdown(wait=True)
            except Exception:
                pass


def run_gui(excel: Optional[Any] = None, settings: Optional[Settings] = None, demo: bool = False) -> int:
    if not HAVE_QT:
        return bootstrap_installer(missing_requirements(), sys.argv[1:])
    sys.setswitchinterval(0.001)  # background threads hand the interpreter back to the GUI every 1 ms
    app = QtWidgets.QApplication.instance() or QtWidgets.QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setStyle("Fusion")
    win = MainWindow(settings or Settings.load(), excel, demo)
    win.show()
    return app.exec()


