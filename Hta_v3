    class KeywordModel(QtCore.QAbstractTableModel):
        """Virtual table: 10 000+ keywords without creating 70 000 table items."""
        COLS = ["Keyword", "Kind", "Target(s)", "Type", "Allowed values", "Current", "Example"]

        def __init__(self) -> None:
            super().__init__()
            self.items: List[Keyword] = []
            self._txt: Dict[int, tuple] = {}
            self._font = QtGui.QFont("Consolas")
            self._font.setBold(True)

        def set_items(self, items: Sequence[Keyword]) -> None:
            self.beginResetModel()
            self.items, self._txt = list(items), {}
            self.endResetModel()

        def rowCount(self, parent=QtCore.QModelIndex()) -> int:
            return 0 if parent.isValid() else len(self.items)

        def columnCount(self, parent=QtCore.QModelIndex()) -> int:
            return 0 if parent.isValid() else len(self.COLS)

        def headerData(self, section, orientation, role=Qt.ItemDataRole.DisplayRole):
            if role == Qt.ItemDataRole.DisplayRole and orientation == Qt.Orientation.Horizontal:
                return self.COLS[section]
            return None

        def text(self, r: int, col: int) -> str:
            k = self.items[r]
            if col == 5:
                return k.widgets[0].current if len(k.widgets) == 1 else ""
            t = self._txt.get(r)
            if t is None:
                w = k.widgets[0] if k.widgets else None
                t = (k.keyword, k.kind, k.target_text(), w.wtype if w else "", allowed_text(k), "",
                     example_command(k))
                self._txt[r] = t
            return t[col]

        def data(self, index, role=Qt.ItemDataRole.DisplayRole):
            if not index.isValid():
                return None
            r, col = index.row(), index.column()
            if role in (Qt.ItemDataRole.DisplayRole, SORT_ROLE):
                return self.text(r, col)
            k = self.items[r]
            if role == WIDGET_ROLE:
                return k.keyword
            if role == Qt.ItemDataRole.FontRole and col == 0:
                return self._font
            if role == Qt.ItemDataRole.ForegroundRole:
                if k.problem:
                    return QtGui.QBrush(_COL["crit"])
                if not k.enabled:
                    return QtGui.QBrush(_COL["grey"])
                if col == 0:
                    return QtGui.QBrush(QtGui.QColor("#1F3864"))
            if role == Qt.ItemDataRole.ToolTipRole and (k.problem or not k.enabled):
                return k.problem or "disabled"
            return None

        def refresh_current(self) -> None:
            if self.items:
                self.dataChanged.emit(self.index(0, 5), self.index(len(self.items) - 1, 5))

