def export_excel(table: SignalTable, path: Any, sequence_rows: Optional[Sequence[Sequence[Any]]] = None,
                 include_sequence: bool = True, progress: Optional[Callable[[str], None]] = None,
                 raw_max_chars: int = 1500, fast: bool = True) -> Path:
    """Write the signal map workbook (index + one sheet per tab + Sequence).
    fast=True: openpyxl writes the structure, data rows are streamed into the sheet XML (2-4x faster);
    any problem there falls back to the classic all-openpyxl writer."""
    if fast:
        try:
            return _export_excel(table, path, sequence_rows, include_sequence, progress, raw_max_chars, True)
        except PermissionError:
            raise
        except Exception as e:
            log.debug("fast Excel export fell back to openpyxl: %s", e)
    return _export_excel(table, path, sequence_rows, include_sequence, progress, raw_max_chars, False)


def _export_excel(table: SignalTable, path: Any, sequence_rows: Optional[Sequence[Sequence[Any]]],
                  include_sequence: bool, progress: Optional[Callable[[str], None]], raw_max_chars: int,
                  fast: bool) -> Path:
    _require_openpyxl()
    path = Path(path)
    payload: Dict[str, Tuple[int, List[Sequence[Any]]]] = {}
    _RAW_MAX[0] = max(0, min(32000, int(raw_max_chars)))
    wb = openpyxl.Workbook()
    ws_idx = wb.active
    ws_idx.title = SHEET_INDEX
    used: set = set()
    tab_sheets = []
    tabs = table.tabs()
    for n, tab in enumerate(tabs, 1):
        if progress:
            progress(f"Writing Excel sheet {n}/{len(tabs)}: {tab}")
        wl = table.in_tab(tab)
        ws = wb.create_sheet(sanitize_sheet_name(tab, used))
        rows: Optional[list] = [] if fast else None
        _write_tab_sheet(ws, wl, rows)
        if rows:
            payload[ws.title] = (2, rows)
        for r, w in enumerate(wl, 2):
            w.sheet, w.row = ws.title, r
        tab_sheets.append((tab, ws.title, wl))
    _write_index_sheet(ws_idx, table, tab_sheets)
    if include_sequence:
        _write_sequence_sheet(wb.create_sheet(SHEET_SEQUENCE),
                              sequence_rows if sequence_rows is not None else default_sequence_rows(table))
    path.parent.mkdir(parents=True, exist_ok=True)
    if progress:
        progress(f"Saving {path.name} ...")
    target = path.with_name(path.name + ".~new") if payload else path
    try:
        wb.save(target)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
    if payload:
        try:
            _inject_rows(target, payload)
            os.replace(str(target), str(path))
        except PermissionError as e:
            raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
        finally:
            if target.exists():
                try:
                    target.unlink()
                except OSError:
                    pass
    return path


