class HtaUiaBackend(Backend):
    """Drives the running HTA like an operator: tab select -> locate -> type/click -> read back."""
    kind = "hta"
    INTERESTING = {"Spinner", "Edit", "Slider", "Button", "CheckBox", "ComboBox", "ProgressBar",
                   "Text", "Custom", "Pane", "Group"}

    def __init__(self, settings: Settings):
        super().__init__(settings)
        self.win: Any = None
        self._pw: Any = None
        self._tabbar: Any = None
        self._tab_items: "OrderedDict[str, Any]" = OrderedDict()
        self._current_tab: Optional[str] = None
        self._scan: Dict[str, List[UiaCtrl]] = {}
        self._scan_idx: Dict[str, Dict[str, Dict[str, List[UiaCtrl]]]] = {}
        self._cache: Dict[str, UiaCtrl] = {}
        self._cache_ok: Optional[bool] = None
        self._calib: Dict[str, Calib] = {}
        self._scale = 1.0
        self.title = ""

    # ---------------------------------------------------------------- connect
    def _import(self) -> None:
        if self._pw is not None:
            return
        if sys.platform != "win32":
            raise BackendError("The HTA UI-Automation backend needs Windows (use the simulator here).")
        _ensure_com()
        try:
            from pywinauto import Application, Desktop, keyboard, mouse  # type: ignore
        except ImportError as e:
            raise BackendError("pywinauto is required for HTA control:  pip install pywinauto") from e
        self._pw = SimpleNamespace(Application=Application, Desktop=Desktop, mouse=mouse,
                                   keyboard=keyboard)

    def attach_table(self, table: SignalTable) -> None:
        super().attach_table(table)
        self._cache.clear()
        self._calib.clear()

    def connect(self) -> str:
        self._import()
        rx = re.compile(self.s.window_title_re, re.I)
        wins = []
        for w in self._pw.Desktop(backend="uia").windows():
            try:
                if rx.match(w.window_text() or "") and w.is_visible():
                    r = w.rectangle()
                    wins.append(((r.right - r.left) * (r.bottom - r.top), w))
            except Exception:
                continue
        if not wins:
            raise BackendError(f"No window matching '{self.s.window_title_re}'. Is HTA running?")
        wins.sort(key=lambda t: -t[0])
        handle = wins[0][1].handle
        app = self._pw.Application(backend="uia").connect(handle=handle)
        self.win = app.window(handle=handle).wrapper_object()
        self._scale = _dpi_scale(handle)
        self._find_tabbar()
        self.title = self.win.window_text()
        msg = (f"{self.title}  [pid {self.win.process_id()}, {len(self._tab_items)} tabs, "
               f"DPI x{self._scale:.2f}]")
        log.info("Connected to %s", msg)
        return msg

    @property
    def connected(self) -> bool:
        if self.win is None:
            return False
        try:
            import ctypes
            return bool(ctypes.windll.user32.IsWindow(int(self.win.handle)))
        except Exception:
            return False

    def disconnect(self) -> None:
        self.win = self._tabbar = None
        self._tab_items.clear()
        self._scan.clear()
        self._cache.clear()
        self._calib.clear()

    def _need(self) -> None:
        if self.win is None:
            raise BackendError("not connected to HTA")

    # ------------------------------------------------------------------- tabs
    def _find_tabbar(self) -> None:
        self._need()
        best, best_items = None, []
        for t in self.win.descendants(control_type="Tab"):
            items = [c for c in _safe(lambda: t.children(), [])
                     if _safe(lambda: c.element_info.control_type) == "TabItem"]
            if len(items) > len(best_items):
                best, best_items = t, items
        if best is None:
            raise BackendError("No tab control found in the HTA window")
        self._tabbar = best
        self._tab_items = OrderedDict(((_safe(lambda: it.window_text(), "") or "").strip(), it)
                                      for it in best_items)

    def tabs(self) -> List[str]:
        self._need()
        if not self._tab_items:
            self._find_tabbar()
        return list(self._tab_items.keys())

    def _match_tab(self, name: str) -> Optional[str]:
        if not name:
            return self._current_tab
        if name in self._tab_items:
            return name
        n = norm_key(name.replace("&&", "&"))
        for k in self._tab_items:
            if norm_key(k.replace("&&", "&")) == n:
                return k
        for k in self._tab_items:
            nk = norm_key(k)
            if n and nk and (n in nk or nk in n):
                return k
        return None

    def select_tab(self, name: str) -> str:
        self._need()
        key = self._match_tab(name)
        if key is None:
            self._find_tabbar()
            key = self._match_tab(name)
        if key is None:
            raise BackendError(f"Tab '{name}' not found in HTA. Available: {', '.join(self._tab_items)}")
        item = self._tab_items[key]
        if self._current_tab == key and _safe(lambda: item.is_selected(), False):
            return key
        if not _safe(lambda: item.is_selected(), False):
            try:
                item.select()
            except Exception:
                self._focus_hta()
                item.click_input()
            time.sleep(self.s.tab_switch_ms / 1000.0)
        self._current_tab = key
        return key

    def _page_rect(self) -> Tuple[int, int, int, int]:
        tb = self._tabbar.rectangle()
        parent = _safe(lambda: self._tabbar.parent())
        pr = _safe(lambda: parent.rectangle()) if parent is not None else None
        if pr is None or pr.bottom - tb.bottom < 50:
            pr = self.win.rectangle()
        return pr.left, tb.bottom, pr.right, pr.bottom

    def _scan_root(self) -> Any:
        parent = _safe(lambda: self._tabbar.parent())
        if parent is not None:
            r = _safe(lambda: parent.rectangle())
            if r is not None and r.bottom - self._tabbar.rectangle().bottom >= 50:
                return parent
        return self.win

    # ------------------------------------------------------------------- scan
    def scan_tab(self, tab: str, force: bool = False) -> List[UiaCtrl]:
        key = self.select_tab(tab)
        if not force and key in self._scan:
            return self._scan[key]
        t0 = time.perf_counter()
        page = self._page_rect()
        ctrls: Optional[List[UiaCtrl]] = self._cached_scan(self._scan_root(), page)
        fast = ctrls is not None
        if ctrls is None:
            ctrls = self._slow_scan(page)
        analyze_controls(ctrls, self.s.label_max_gap_px)
        ctrls = [c for c in ctrls if c.role in WIDGET_ROLES or c.role == "label"]
        self._scan[key] = ctrls
        idx: Dict[str, Dict[str, List[UiaCtrl]]] = {"label": defaultdict(list), "aid": defaultdict(list),
                                                    "name": defaultdict(list)}
        for c in ctrls:
            if c.role in WIDGET_ROLES:
                if c.label:
                    idx["label"][norm_key(c.label)].append(c)
                if c.aid:
                    idx["aid"][norm_key(c.aid)].append(c)
                if c.name:
                    idx["name"][norm_key(c.name)].append(c)
        self._scan_idx[key] = idx
        log.info("Scanned tab '%s': %d controls (%.2f s, %s)", key,
                 sum(1 for c in ctrls if c.role != "label"), time.perf_counter() - t0,
                 "cached UIA" if fast else "per-control UIA")
        return ctrls

    def _cached_scan(self, root: Any, page: Tuple[int, int, int, int]) -> Optional[List[UiaCtrl]]:
        """All descendants + their properties in ONE cross-process UIA call (FindAllBuildCache)."""
        if not self.s.uia_cache or self._cache_ok is False:
            return None
        try:
            from pywinauto.uia_defines import IUIA  # type: ignore
            iu = IUIA()
            ua, dll = iu.iuia, iu.UIA_dll
            P = {k: getattr(dll, v) for k, v in {
                "val": "UIA_ValueValuePropertyId", "val_ro": "UIA_ValueIsReadOnlyPropertyId",
                "rv": "UIA_RangeValueValuePropertyId", "rv_ro": "UIA_RangeValueIsReadOnlyPropertyId",
                "rv_min": "UIA_RangeValueMinimumPropertyId", "rv_max": "UIA_RangeValueMaximumPropertyId",
                "rv_step": "UIA_RangeValueSmallChangePropertyId", "toggle": "UIA_ToggleToggleStatePropertyId"}.items()}
            base = [dll.UIA_NamePropertyId, dll.UIA_ControlTypePropertyId, dll.UIA_AutomationIdPropertyId,
                    dll.UIA_ClassNamePropertyId, dll.UIA_BoundingRectanglePropertyId, dll.UIA_IsOffscreenPropertyId]
            req = ua.CreateCacheRequest()
            for pid in base + list(P.values()):
                req.AddProperty(pid)
            arr = root.element_info.element.FindAllBuildCache(dll.TreeScope_Descendants, ua.CreateTrueCondition(), req)
            id2name = {getattr(dll, f"UIA_{n}ControlTypeId"): n for n in self.INTERESTING
                       if hasattr(dll, f"UIA_{n}ControlTypeId")}
        except Exception as e:
            self._cache_ok = False
            log.info("UIA cache not available (%s) - using per-control scan", e)
            return None

        def num(v: Any) -> Optional[float]:
            return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else None

        out: List[UiaCtrl] = []
        for i in range(arr.Length):
            try:
                el = arr.GetElement(i)
                ct = id2name.get(el.CachedControlType)
                if ct is None or el.CachedIsOffscreen:
                    continue
                r = el.CachedBoundingRectangle
                rect = (int(r.left), int(r.top), int(r.right), int(r.bottom))
                if rect[2] - rect[0] < 3 or rect[3] - rect[1] < 3:
                    continue
                cx, cy = (rect[0] + rect[2]) // 2, (rect[1] + rect[3]) // 2
                if not (page[0] <= cx <= page[2] and page[1] <= cy <= page[3]):
                    continue
                c = UiaCtrl(ctype=ct, rect=rect, name=(el.CachedName or "").strip(),
                            aid=(el.CachedAutomationId or "").strip(), cls=el.CachedClassName or "",
                            wrapper=_LazyWrapper(el))
                g = el.GetCachedPropertyValue
                if ct in ("Spinner", "Slider", "ProgressBar") or "slider" in c.cls.lower():
                    c.min, c.max = num(g(P["rv_min"])), num(g(P["rv_max"]))
                    c.step = num(g(P["rv_step"])) or None
                    ro = g(P["rv_ro"])
                    c.readonly = bool(ro) if isinstance(ro, bool) else False
                    if num(g(P["rv"])) is not None:
                        c.value = fmt_num(num(g(P["rv"])))
                if ct in ("Edit", "Spinner", "ComboBox"):
                    v = g(P["val"])
                    if isinstance(v, str):
                        c.value = v
                    ro = g(P["val_ro"])
                    c.readonly = c.readonly or (bool(ro) if isinstance(ro, bool) else False)
                if ct in ("Button", "Text"):
                    c.value = c.name
                if ct == "CheckBox":
                    st = g(P["toggle"])
                    c.value = "1" if st == 1 else "0" if st == 0 else ""
                out.append(c)
            except Exception as e:
                log.debug("cached element skipped: %s", e)
        self._cache_ok = True
        return out

    def _slow_scan(self, page: Tuple[int, int, int, int]) -> List[UiaCtrl]:
        ctrls: List[UiaCtrl] = []
        for wr in self._scan_root().descendants():
            try:
                info = wr.element_info
                ct = info.control_type
                if ct not in self.INTERESTING:
                    continue
                r = info.rectangle
                rect = (r.left, r.top, r.right, r.bottom)
                if rect[2] - rect[0] < 3 or rect[3] - rect[1] < 3:
                    continue
                cx, cy = (rect[0] + rect[2]) // 2, (rect[1] + rect[3]) // 2
                if not (page[0] <= cx <= page[2] and page[1] <= cy <= page[3]):
                    continue
                if not wr.is_visible():
                    continue
                c = UiaCtrl(ctype=ct, rect=rect, name=(info.name or "").strip(),
                            aid=(info.automation_id or "").strip(), cls=info.class_name or "",
                            wrapper=wr)
                self._enrich(c)
                ctrls.append(c)
            except Exception as e:  # stale / inaccessible element
                log.debug("scan skip: %s", e)
        return ctrls

    @staticmethod
    def _enrich(c: UiaCtrl) -> None:
        wr = c.wrapper
        if c.ctype in ("Spinner", "Slider", "ProgressBar") or "slider" in c.cls.lower():
            rv = _safe(lambda: wr.iface_range_value)
            if rv is not None:
                c.min = _safe(lambda: float(rv.CurrentMinimum))
                c.max = _safe(lambda: float(rv.CurrentMaximum))
                c.step = _safe(lambda: float(rv.CurrentSmallChange)) or None
                c.readonly = bool(_safe(lambda: rv.CurrentIsReadOnly, False))
                c.value = fmt_num(_safe(lambda: rv.CurrentValue))
        if c.ctype in ("Edit", "Spinner", "ComboBox"):
            vp = _safe(lambda: wr.iface_value)
            if vp is not None:
                v = _safe(lambda: vp.CurrentValue)
                if v is not None:
                    c.value = str(v)
                c.readonly = c.readonly or bool(_safe(lambda: vp.CurrentIsReadOnly, False))
        if c.ctype in ("Button", "Text"):
            c.value = c.name
        if c.ctype == "CheckBox":
            st = _safe(lambda: wr.iface_toggle.CurrentToggleState)
            c.value = "1" if st == 1 else "0" if st == 0 else ""

    # --------------------------------------------------------------- resolve
    def _alive(self, c: UiaCtrl) -> bool:
        try:
            r = c.wrapper.element_info.rectangle
            return (r.right - r.left) > 0 and c.wrapper.is_visible()
        except Exception:
            return False

    def _calibration(self, tab: str) -> Optional[Calib]:
        key = self._match_tab(tab)
        if key is None:
            return None
        if key in self._calib:
            return self._calib[key]
        ctrls = self.scan_tab(key)
        page = self._page_rect()
        pairs = []
        if self.table is not None:
            xw = [w for w in self.table if self._match_tab(w.tab) == key and w.x is not None]
            names = Counter(norm_key(w.name) for w in xw)
            by_label: Dict[str, List[UiaCtrl]] = defaultdict(list)
            for c in ctrls:
                if c.label and c.role in WIDGET_ROLES:
                    by_label[norm_key(c.label)].append(c)
            for w in xw:
                cs = by_label.get(norm_key(w.name), [])
                if names[norm_key(w.name)] == 1 and len(cs) == 1:
                    pairs.append((w.x + (w.w or 0) / 2, w.y + (w.h or 0) / 2, cs[0].cx, cs[0].cy))
        cal = fit_calibration(pairs, self._scale, (page[0], page[1]))
        self._calib[key] = cal
        log.info("Calibration '%s': %d anchors, scale %.3f/%.3f, origin %.0f/%.0f, rms %.1f px",
                 key, cal.n, cal.sx, cal.sy, cal.ox, cal.oy, cal.rms)
        return cal

    def calibrate_all(self) -> Dict[str, Calib]:
        self._calib.clear()
        return {t: self._calibration(t) for t in self.tabs()}

    def _resolve(self, w: Widget) -> Optional[UiaCtrl]:
        c = self._cache.get(w.key)
        if c is not None and self._alive(c):
            return c
        key = self.select_tab(w.tab)
        ctrls = self.scan_tab(key, force=c is not None)  # stale cache -> rescan
        roles = _ROLES_FOR_TYPE.get(w.wtype, WIDGET_ROLES)
        memo = self._scan_idx.setdefault(key, {"label": {}, "aid": {}, "name": {}}).setdefault("cands", {})
        cands = memo.get(roles)
        if cands is None:  # filtered once per tab scan, not once per widget
            cands = [c for c in ctrls if c.role in roles] or [c for c in ctrls if c.role in WIDGET_ROLES]
            memo[roles] = cands
        nk = norm_key(w.name)

        def pick(m: List[UiaCtrl]) -> Optional[UiaCtrl]:
            if not m:
                return None
            m = reading_order(m, lambda c: c.cx, lambda c: c.cy, tol=8 * self._scale)
            return m[w.instance - 1] if len(m) >= w.instance else (m[0] if len(m) == 1 else None)

        found: Optional[UiaCtrl] = None
        idx = self._scan_idx.get(key) or {"label": {}, "aid": {}, "name": {}}
        role_ok = set(roles) if any(c.role in roles for c in ctrls) else set(WIDGET_ROLES)

        def by(kind: str, k: str) -> List[UiaCtrl]:
            return [c for c in idx[kind].get(k, ()) if c.role in role_ok]

        loc = (w.locator or "").strip()
        if loc:
            k, _, v = loc.partition("=")
            k, v = k.strip().lower(), v.strip()
            if k == "aid":
                found = pick([c for c in ctrls if c.aid == v])
            elif k == "label":
                found = pick([c for c in cands if norm_key(c.label) == norm_key(v)])
            elif k == "name":
                found = pick([c for c in ctrls if norm_key(c.name) == norm_key(v)])
            elif k == "index":
                idx = int(to_float(v) or 0)
                ordered = reading_order(cands, lambda c: c.cx, lambda c: c.cy, tol=8 * self._scale)
                found = ordered[idx] if 0 <= idx < len(ordered) else None
        if found is None and loc.lower() != "pos":
            found = (pick(by("aid", nk))
                     or pick(by("label", nk))
                     or pick([c for c in by("name", nk) if c.role not in ("button", "display")]))
            if found is None and nk:  # automation ids that end with the name ('page.tab.KL30A V')
                found = pick([c for c in cands if c.aid and norm_key(c.aid).endswith(nk)])
        if found is None and w.x is not None and w.y is not None:
            cal = self._calibration(key)
            if cal is not None:
                X, Y = cal.to_screen(w.x + (w.w or 0) / 2, w.y + (w.h or 0) / 2)
                inside = [c for c in cands if c.contains(X, Y)]
                if inside:
                    found = min(inside, key=lambda c: c.width * c.height)
                else:
                    near = sorted(cands, key=lambda c: math.hypot(c.cx - X, c.cy - Y))
                    if near and math.hypot(near[0].cx - X, near[0].cy - Y) <= 30 * self._scale:
                        found = near[0]
        if found is not None:
            self._cache[w.key] = found
        else:
            log.warning("Control for '%s' not found on HTA tab '%s'", w.key, key)
        return found

    # ------------------------------------------------------------- read/write
    def _read_ctrl(self, c: UiaCtrl) -> str:
        wr = c.wrapper
        if c.ctype in ("Button", "Text"):
            return (wr.window_text() or "").strip()
        if c.ctype == "CheckBox":
            st = _safe(lambda: wr.iface_toggle.CurrentToggleState)
            return "1" if st == 1 else "0"
        v = _safe(lambda: wr.iface_value.CurrentValue)
        if v is not None:
            return str(v).strip()
        v = _safe(lambda: wr.iface_range_value.CurrentValue)
        if v is not None:
            return fmt_num(v)
        return (wr.window_text() or "").strip()

    def read(self, w: Widget, allow_switch: bool = True) -> Optional[str]:
        self._need()
        c = self._cache.get(w.key)
        if c is None or not self._alive(c):
            if not allow_switch:  # polling: never switch HTA tabs behind the operator's back
                item = self._tab_items.get(self._match_tab(w.tab) or "")
                if item is None or not _safe(lambda: item.is_selected(), False):
                    return None
            c = self._resolve(w)
        if c is None:
            return None
        try:
            return self._read_ctrl(c)
        except Exception as e:
            self._cache.pop(w.key, None)
            log.debug("read %s failed: %s", w.key, e)
            return None

    def read_bulk(self, widgets: Sequence[Widget], allow_switch: bool = True,
                  stop: Optional[threading.Event] = None) -> Dict[Widget, Optional[str]]:
        """Read many widgets: one (cached) scan per HTA tab instead of one UIA call per widget."""
        self._need()
        out: Dict[Widget, Optional[str]] = {}
        by_tab: Dict[str, List[Widget]] = OrderedDict()
        for w in widgets:
            by_tab.setdefault(self._match_tab(w.tab) or w.tab, []).append(w)
        for tab, ws in by_tab.items():
            if stop is not None and stop.is_set():
                break
            item = self._tab_items.get(tab)
            visible = item is not None and _safe(lambda: item.is_selected(), False)
            if not allow_switch and not visible:
                out.update({w: None for w in ws})
                continue
            if len(ws) < 5:  # few signals: direct reads are cheaper than a rescan
                for w in ws:
                    out[w] = self.read(w, allow_switch)
                continue
            try:
                self.scan_tab(tab, force=True)  # fresh values for the whole tab in one request
            except Exception as e:
                log.warning("Tab '%s' not readable: %s", tab, e)
                out.update({w: None for w in ws})
                continue
            for w in ws:
                self._cache.pop(w.key, None)
                c = self._resolve(w)
                out[w] = (c.value if self._cache_ok else _safe(lambda: self._read_ctrl(c))) if c else None
        return out

    def _focus_hta(self) -> None:
        try:
            if _safe(lambda: self.win.is_minimized(), False):
                self.win.restore()
            self.win.set_focus()
        except Exception as e:
            log.debug("focus failed: %s", e)

    def _click(self, c: UiaCtrl) -> None:
        try:
            c.wrapper.invoke()
        except Exception:
            self._focus_hta()
            c.wrapper.click_input()

    def _type_into(self, c: UiaCtrl, text: str, use_mouse: bool = False) -> None:
        self._focus_hta()
        rect = c.rect
        if c.ctype == "Spinner":
            ed = _safe(lambda: c.wrapper.descendants(control_type="Edit"), [])
            if ed:
                r = ed[0].rectangle()
                rect = (r.left, r.top, r.right, r.bottom)
        focused = False
        if not use_mouse:
            try:
                c.wrapper.set_focus()
                focused = True
            except Exception:
                pass
        if not focused:
            x = rect[0] + max(4, min(30, (rect[2] - rect[0]) // 3))
            self._pw.mouse.click(button="left", coords=(x, (rect[1] + rect[3]) // 2))
        time.sleep(0.05)
        self._pw.keyboard.send_keys("^a{BACKSPACE}" + _escape_keys(text) + "{ENTER}",
                                    pause=0.02, with_spaces=True)

    def _write_input(self, c: UiaCtrl, w: Widget, value: str, res: WriteResult) -> None:
        method = (self.s.write_method or "keyboard").lower()
        if method in ("pattern", "auto"):
            try:
                f = to_float(value)
                if c.ctype in ("Spinner", "Slider") and f is not None:
                    c.wrapper.iface_range_value.SetValue(f)
                    res.method = "uia-range"
                else:
                    c.wrapper.iface_value.SetValue(str(value))
                    res.method = "uia-value"
                if method == "pattern":
                    return
                time.sleep(0.05)
                if values_match(w, value, _safe(lambda: self._read_ctrl(c)), self.s.abs_tolerance)[0]:
                    return
            except Exception as e:
                if method == "pattern":
                    raise BackendError(f"UIA pattern write not supported: {e}") from e
        self._type_into(c, value)
        res.method = "keyboard"
        if self.s.verify_writes:
            time.sleep(self.s.settle_ms / 1000.0)
            if not values_match(w, value, _safe(lambda: self._read_ctrl(c)), self.s.abs_tolerance)[0]:
                self._type_into(c, value, use_mouse=True)  # retry with a real click
                res.method = "keyboard+click"

    def _write_button(self, c: UiaCtrl, w: Widget, value: str, res: WriteResult) -> None:
        opts = w.option_list()
        res.method = "invoke"
        if not opts:
            self._click(c)
            return
        target = option_label(opts, value) or value
        cur = self._read_ctrl(c)
        for _ in range(len(opts) + 1):
            if option_label(opts, cur) == target or norm_key(cur) == norm_key(target):
                return
            if option_label(opts, cur) is None and norm_key(cur) not in {norm_key(l) for l, _ in opts}:
                raise BackendError(f"button shows '{cur}', which is none of its states "
                                   f"({w.options}) - state unknown, not clicked")
            self._click(c)
            time.sleep(self.s.settle_ms / 1000.0)
            new = self._read_ctrl(c)
            if new == cur:
                raise BackendError("clicked, but the button label did not change (state not readable)")
            cur = new
        raise BackendError(f"button did not reach '{target}' (shows '{cur}')")

    def write(self, w: Widget, value: str) -> WriteResult:
        self._need()
        t0 = time.perf_counter()
        res = WriteResult(key=w.key, requested=str(value))
        try:
            self.select_tab(w.tab)
            c = self._resolve(w)
            if c is None:
                if self.s.allow_coordinate_fallback and w.x is not None and w.wtype in ("Input", "Other"):
                    self._write_by_coordinates(w, value, res)
                else:
                    res.message = "control not found in HTA (check Tab/Name, Locator column or run 'inspect')"
                res.duration_ms = (time.perf_counter() - t0) * 1000
                return res
            res.before = _safe(lambda: self._read_ctrl(c), "")
            if c.role == "button":
                self._write_button(c, w, value, res)
            elif c.role == "checkbox":
                want = _truthy(value) or norm_key(value) in ("on", "checked")
                for _ in range(2):
                    if (self._read_ctrl(c) == "1") == want:
                        break
                    c.wrapper.toggle() if hasattr(c.wrapper, "toggle") else self._click(c)
                    time.sleep(self.s.settle_ms / 1000.0)
                res.method = "toggle"
            elif c.role == "combo":
                c.wrapper.select(value)
                res.method = "select"
            elif c.role == "slider":
                f = to_float(value)
                if f is None:
                    raise BackendError("slider needs a number")
                try:
                    c.wrapper.iface_range_value.SetValue(f)
                    res.method = "uia-range"
                except Exception as e:
                    raise BackendError("slider does not support UIA RangeValue - set its paired input "
                                       "box instead") from e
            elif c.role == "input":
                self._write_input(c, w, value, res)
            else:
                res.message = f"control is read-only ({c.role})"
                return res
            time.sleep(self.s.settle_ms / 1000.0)
            res.after = _safe(lambda: self._read_ctrl(c), "")
            if self.s.verify_writes:
                res.ok, res.message = values_match(w, value, res.after, self.s.abs_tolerance)
            else:
                res.ok = True
        except Exception as e:
            self._cache.pop(w.key, None)
            if self._current_tab:
                self._scan.pop(self._current_tab, None)
            res.ok, res.message = False, f"{type(e).__name__}: {e}"
        finally:
            if res.method.startswith("keyboard") and self.s.refocus_after_write:
                bring_to_front(self.own_hwnd)
        res.duration_ms = (time.perf_counter() - t0) * 1000
        return res

    def _write_by_coordinates(self, w: Widget, value: str, res: WriteResult) -> None:
        cal = self._calibration(w.tab)
        if cal is None or cal.n == 0:
            res.message = "control not found and no position calibration available"
            return
        X, Y = cal.to_screen(w.x + (w.w or 0) / 2, w.y + (w.h or 0) / 2)
        self._focus_hta()
        self._pw.mouse.double_click(button="left", coords=(X, Y))
        time.sleep(0.05)
        self._pw.keyboard.send_keys("^a{BACKSPACE}" + _escape_keys(value) + "{ENTER}",
                                    pause=0.02, with_spaces=True)
        res.ok, res.method = True, "keyboard@xy"
        res.message = f"typed at screen ({X},{Y}) from XML position - not verified"

    def press(self, w: Widget) -> WriteResult:
        self._need()
        res = WriteResult(key=w.key, requested="<press>", method="invoke")
        try:
            self.select_tab(w.tab)
            c = self._resolve(w)
            if c is None:
                res.message = "control not found in HTA"
                return res
            res.before = _safe(lambda: self._read_ctrl(c), "")
            self._click(c)
            time.sleep(self.s.settle_ms / 1000.0)
            res.after = _safe(lambda: self._read_ctrl(c), "")
            res.ok = True
        except Exception as e:
            res.message = f"{type(e).__name__}: {e}"
        return res

    # ------------------------------------------------------------- extraction
    def extract_live(self, progress: Optional[Callable[[str], None]] = None,
                     stop: Optional[threading.Event] = None) -> List[Widget]:
        """Scan every HTA tab and turn the found controls into Widgets."""
        self._need()
        out: List[Widget] = []
        names = self.tabs()
        for i, tab in enumerate(names, 1):
            if stop is not None and stop.is_set():
                break
            if progress:
                progress(f"Live scan {i}/{len(names)}: {tab}")
            ctrls = self.scan_tab(tab, force=True)
            page = self._page_rect()
            sc = self._scale or 1.0
            for c in ctrls:
                if c.role not in WIDGET_ROLES:
                    continue
                x, y = int((c.left - page[0]) / sc), int((c.top - page[1]) / sc)
                name = (c.label or (c.name if c.role not in ("button", "display", "input") else "")
                        or c.aid or f"{c.ctype}@{x},{y}")
                out.append(Widget(
                    tab=tab, name=name, wtype=_ROLE_TO_TYPE[c.role],
                    access="RO" if (c.role == "display" or c.readonly) else "RW",
                    min=c.min, max=c.max, step=c.step, current=c.value, x=x, y=y,
                    w=int(c.width / sc), h=int(c.height / sc),
                    locator=f"aid={c.aid}" if c.aid else "", source="uia",
                    raw=json.dumps({"uia_type": c.ctype, "class": c.cls, "uia_name": c.name,
                                    "automation_id": c.aid}, ensure_ascii=False)))
        return out

    def _read_tree(self, dlg: Any) -> List[Tuple[int, str]]:
        trees = _safe(lambda: dlg.descendants(control_type="Tree"), [])
        if not trees:
            return []
        tree = trees[0]
        try:  # numpad '*' = expand all (Qt & Win32 trees)
            first = tree.descendants(control_type="TreeItem")[0]
            first.click_input()
            self._pw.keyboard.send_keys("{VK_MULTIPLY}")
            time.sleep(0.2)
        except Exception:
            pass
        for _ in range(8):
            changed = False
            for ti in _safe(lambda: tree.descendants(control_type="TreeItem"), []):
                ec = _safe(lambda: ti.iface_expand_collapse)
                if ec is not None and _safe(lambda: ec.CurrentExpandCollapseState) == 0:
                    if _safe(lambda: ec.Expand() or True, False):
                        changed = True
            if not changed:
                break
            time.sleep(0.1)
        rows: List[Tuple[int, str, int]] = []

        def walk(node: Any, depth: int) -> None:
            for ch in _safe(lambda: node.children(), []):
                if _safe(lambda: ch.element_info.control_type) != "TreeItem":
                    continue
                r = _safe(lambda: ch.element_info.rectangle)
                rows.append((depth, (_safe(lambda: ch.window_text(), "") or "").strip(),
                             r.left if r is not None else 0))
                walk(ch, depth + 1)

        walk(tree, 0)
        if rows and len({d for d, _, _ in rows}) <= 1:  # flat tree (Qt) -> use indentation
            lefts = [l for _, _, l in rows]
            if len(set(lefts)) > 1 and all(lefts):
                dd = depths_from_indent(lefts)
                rows = [(d, t, l) for d, (_, t, l) in zip(dd, rows)]
        return [(d, t) for d, t, _ in rows]

    def _read_property_dialog(self, point: Tuple[int, int]) -> List[Tuple[int, str]]:
        pw = self._pw
        D = pw.Desktop(backend="uia")
        pid = self.win.process_id()
        self._focus_hta()
        pw.mouse.right_click(coords=point)
        time.sleep(0.35)
        menu_rx = re.compile(self.s.property_menu_regex, re.I)
        item, deadline = None, time.time() + 2.5
        while item is None and time.time() < deadline:
            for wnd in _safe(lambda: D.windows(process=pid), []):
                if wnd.handle == self.win.handle:
                    continue
                for mi in _safe(lambda: wnd.descendants(control_type="MenuItem"), []):
                    if menu_rx.search(_safe(lambda: mi.window_text(), "") or ""):
                        item = mi
                        break
                if item is not None:
                    break
            if item is None:
                time.sleep(0.1)
        if item is None:
            pw.keyboard.send_keys("{ESC}")
            log.warning("No 'Properties' entry in the context menu at %s", point)
            return []
        try:
            item.invoke()
        except Exception:
            item.click_input()
        dlg_rx = re.compile(self.s.property_dialog_title_re, re.I)
        dlg, deadline = None, time.time() + 4
        while dlg is None and time.time() < deadline:
            for wnd in _safe(lambda: D.windows(process=pid), []) + \
                    _safe(lambda: self.win.children(control_type="Window"), []):
                if dlg_rx.match(_safe(lambda: wnd.window_text(), "") or ""):
                    dlg = wnd
                    break
            if dlg is None:
                time.sleep(0.1)
        if dlg is None:
            pw.keyboard.send_keys("{ESC}")
            log.warning("Properties dialog did not open (title regex '%s')", self.s.property_dialog_title_re)
            return []
        try:
            return self._read_tree(dlg)
        finally:
            closed = False
            for b in _safe(lambda: dlg.descendants(control_type="Button"), []):
                if norm_key(_safe(lambda: b.window_text(), "")) in ("cancel", "abbrechen"):
                    _safe(lambda: b.invoke())
                    closed = True
                    break
            if not closed:
                try:
                    dlg.close()
                except Exception:
                    pw.keyboard.send_keys("{ESC}")
            time.sleep(0.2)

    def extract_via_dialogs(self, mode: str = "widget", progress: Optional[Callable[[str], None]] = None,
                            stop: Optional[threading.Event] = None) -> List[Widget]:
        """Right-click -> Properties on every widget (mode='widget') or tab header (mode='tab')."""
        self._need()
        out: List[Widget] = []
        names = self.tabs()
        for i, tab in enumerate(names, 1):
            if stop is not None and stop.is_set():
                break
            key = self.select_tab(tab)
            if mode == "tab":
                r = self._tab_items[key].rectangle()
                items = self._read_property_dialog(((r.left + r.right) // 2, (r.top + r.bottom) // 2))
                ws = parse_layout_root(tree_items_to_xml(items), "dialog", key) if items else []
                for w in ws:
                    w.tab, w.source = key, "dialog"
                out += ws
                continue
            targets = [c for c in self.scan_tab(key, force=True) if c.role in WIDGET_ROLES]
            for j, c in enumerate(targets, 1):
                if stop is not None and stop.is_set():
                    break
                if progress:
                    progress(f"Properties {tab}: {j}/{len(targets)}")
                items = self._read_property_dialog((c.cx, c.cy))
                ws = parse_layout_root(tree_items_to_xml(items), "dialog", key) if items else []
                for w in ws:
                    w.tab, w.source = key, "dialog"
                    w.locator = w.locator or (f"aid={c.aid}" if c.aid else "")
                    if w.min is None:
                        w.min = c.min
                    if w.max is None:
                        w.max = c.max
                    w.current = w.current or c.value
                out += ws
        return out

    # ------------------------------------------------------- simulation control
    def _toolbar_button(self, names: str) -> Any:
        """Toolbar button (above the tab bar) whose caption is one of names ('Start;Run')."""
        wanted = {norm_key(n) for n in names.split(";") if n.strip()}
        limit = _safe(lambda: self._tabbar.rectangle().top) if self._tabbar is not None else None
        best = None
        for b in _safe(lambda: self.win.descendants(control_type="Button"), []):
            nm = norm_key((_safe(lambda: b.window_text(), "") or "").replace("&", ""))
            if nm not in wanted:
                continue
            r = _safe(lambda: b.rectangle())
            if r is None or (limit is not None and r.top >= limit):
                continue
            best = b
            break
        return best

    def sim_status(self) -> str:
        self._need()
        texts: List[str] = []
        for sb in _safe(lambda: self.win.descendants(control_type="StatusBar"), []):
            for el in [sb] + _safe(lambda: sb.descendants(), []):
                t = (_safe(lambda: el.window_text(), "") or "").strip()
                if t and t not in texts:
                    texts.append(t)
        state = ""
        start, stop = self._toolbar_button(self.s.sim_start_names), self._toolbar_button(self.s.sim_stop_names)
        if start is not None and stop is not None:
            s_en, t_en = _safe(lambda: start.is_enabled(), None), _safe(lambda: stop.is_enabled(), None)
            if s_en and not t_en:
                state = "stopped"
            elif t_en and not s_en:
                state = "running"
        return " | ".join([x for x in [state] + texts if x]) or "unknown"

    def sim_control(self, action: str) -> WriteResult:
        self._need()
        a = action.strip().lower()
        names = {"start": self.s.sim_start_names, "stop": self.s.sim_stop_names,
                 "reset": self.s.sim_reset_names}.get(a)
        res = WriteResult(key=f"SIM/{a}", requested=a)
        if names is None:
            res.message = f"unknown simulation action '{action}' (start/stop/reset)"
            return res
        t0 = time.perf_counter()
        try:
            res.before = self.sim_status()
            b = self._toolbar_button(names)
            if b is not None:
                if not _safe(lambda: b.is_enabled(), True):
                    res.message = f"HTA '{a}' button is disabled (state: {res.before})"
                    return res
                try:
                    b.invoke()
                except Exception:
                    self._focus_hta()
                    b.click_input()
                res.method = "toolbar"
            else:
                self.invoke_menu({"start": self.s.sim_menu_start, "stop": self.s.sim_menu_stop,
                                  "reset": self.s.sim_menu_reset}[a])
                res.method = "menu"
            time.sleep(0.4 + self.s.settle_ms / 1000.0)
            res.after, res.ok = self.sim_status(), True
        except Exception as e:
            res.message = f"{type(e).__name__}: {e}"
        res.duration_ms = (time.perf_counter() - t0) * 1000
        return res

    # ------------------------------------------------------------------ menus
    @staticmethod
    def _menu_norm(text: str) -> str:
        return norm_key(re.sub(r"\t.*$", "", (text or "").replace("&", "")))

    @staticmethod
    def _menu_clean(text: str) -> str:
        return re.sub(r"\t.*$", "", (text or "").replace("&&", "\x00").replace("&", "").replace("\x00", "&")).strip()

    def _menubar_items(self) -> List[Any]:
        bars = _safe(lambda: self.win.descendants(control_type="MenuBar"), [])
        items: List[Any] = []
        for bar in bars:
            items += [c for c in _safe(lambda: bar.children(), [])
                      if _safe(lambda: c.element_info.control_type) == "MenuItem"]
            if items:
                break
        if not items:
            raise BackendError("HTA menu bar not visible to UI Automation")
        return items

    def _popup_windows(self) -> List[Any]:
        pid = self.win.process_id()
        out = []
        for w in _safe(lambda: self._pw.Desktop(backend="uia").windows(process=pid), []):
            if w.handle != self.win.handle and _safe(lambda: w.element_info.control_type) == "Menu":
                out.append(w)
        out += _safe(lambda: self.win.descendants(control_type="Menu"), [])
        return out

    def _popup_items(self, exclude: Iterable[int] = ()) -> List[Any]:
        ex = set(exclude)
        items: List[Any] = []
        for w in self._popup_windows():
            if _safe(lambda: w.handle) in ex and _safe(lambda: w.handle):
                continue
            items += [c for c in _safe(lambda: w.children(), [])
                      if _safe(lambda: c.element_info.control_type) == "MenuItem"]
        return items

    def _open_item(self, item: Any) -> None:
        ec = _safe(lambda: item.iface_expand_collapse)
        if ec is not None:
            try:
                ec.Expand()
                return
            except Exception:
                pass
        try:
            item.invoke()
        except Exception:
            item.click_input()

    @staticmethod
    def _has_submenu(item: Any) -> bool:
        st = _safe(lambda: item.iface_expand_collapse.CurrentExpandCollapseState)
        return st in (0, 1, 2)

    def menu_paths(self, max_depth: int = 3) -> List[str]:
        """All HTA menu entries as 'Top -> Sub -> Item' (menus are opened and closed again)."""
        self._need()
        self._focus_hta()
        out: List[str] = []
        kb = self._pw.keyboard

        def collect(prefix: str, known: set, depth: int) -> None:
            fresh = [w for w in self._popup_windows() if _safe(lambda: w.handle) not in known]
            items = []
            for w in fresh:
                items += [c for c in _safe(lambda: w.children(), [])
                          if _safe(lambda: c.element_info.control_type) == "MenuItem"]
            for mi in items:
                name = self._menu_clean(_safe(lambda: mi.window_text(), "") or "")
                if not name:
                    continue
                path = f"{prefix} -> {name}"
                out.append(path)
                if depth < max_depth and self._has_submenu(mi):
                    before = {_safe(lambda: w.handle) for w in self._popup_windows()}
                    self._open_item(mi)
                    time.sleep(0.3)
                    collect(path, before, depth + 1)
                    kb.send_keys("{ESC}")
                    time.sleep(0.15)

        for top in self._menubar_items():
            name = self._menu_clean(_safe(lambda: top.window_text(), "") or "")
            if not name:
                continue
            out.append(name)
            before = {_safe(lambda: w.handle) for w in self._popup_windows()}
            try:
                self._open_item(top)
                time.sleep(0.35)
                collect(name, before, 1)
            finally:
                kb.send_keys("{ESC}{ESC}{ESC}")
                time.sleep(0.2)
        return out

    def invoke_menu(self, path: str) -> str:
        """Click an HTA menu entry given as 'Settings -> Hardware...'."""
        self._need()
        parts = [x.strip() for x in re.split(r"\s*(?:->|>)\s*", path or "") if x.strip()]
        if not parts:
            raise BackendError("empty menu path")
        self._focus_hta()
        tops = self._menubar_items()
        top = next((m for m in tops if self._menu_norm(_safe(lambda: m.window_text(), "")) == norm_key(parts[0])),
                   None)
        if top is None:
            raise BackendError(f"menu '{parts[0]}' not found. Menus: "
                               + ", ".join(self._menu_clean(_safe(lambda: m.window_text(), "")) for m in tops))
        if len(parts) == 1:
            self._open_item(top)
            return parts[0]
        self._open_item(top)
        time.sleep(0.3)
        for i, part in enumerate(parts[1:], 1):
            item, deadline = None, time.time() + 2.5
            while item is None and time.time() < deadline:
                for mi in self._popup_items():
                    if self._menu_norm(_safe(lambda: mi.window_text(), "")) == norm_key(part):
                        item = mi
                        break
                if item is None:
                    time.sleep(0.1)
            if item is None:
                self._pw.keyboard.send_keys("{ESC}{ESC}{ESC}")
                raise BackendError(f"menu item '{part}' not found under '{' -> '.join(parts[:i])}'")
            if i == len(parts) - 1:
                if not _safe(lambda: item.is_enabled(), True):
                    self._pw.keyboard.send_keys("{ESC}{ESC}{ESC}")
                    raise BackendError(f"menu entry '{path}' is disabled")
                try:
                    item.invoke()
                except Exception:
                    item.click_input()
            else:
                self._open_item(item)
                time.sleep(0.3)
        log.info("HTA menu: %s", " -> ".join(parts))
        return " -> ".join(parts)

    # ---------------------------------------------------------------- dialogs
    def _top_windows(self) -> List[Any]:
        pid = self.win.process_id()
        wins = [w for w in _safe(lambda: self._pw.Desktop(backend="uia").windows(process=pid), [])
                if w.handle != self.win.handle]
        wins += _safe(lambda: self.win.children(control_type="Window"), [])
        return [w for w in wins if _safe(lambda: w.element_info.control_type) not in ("Menu", "ToolTip")]

    def _wait_dialog(self, title_re: str = "", before: Iterable[Any] = (), timeout: float = 6.0) -> Any:
        rx = re.compile(title_re, re.I) if title_re else None
        before = set(before)
        deadline = time.time() + timeout
        while time.time() < deadline:
            fresh = []
            for w in self._top_windows():
                title = _safe(lambda: w.window_text(), "") or ""
                if rx is not None:
                    if rx.search(title) and _safe(lambda: w.is_visible(), True):
                        return w
                elif _safe(lambda: w.handle) not in before and _safe(lambda: w.is_visible(), False):
                    fresh.append(w)
            if fresh:
                return fresh[-1]
            if rx is None and not before:  # capture an already open dialog
                wins = [w for w in self._top_windows() if _safe(lambda: w.is_visible(), False)]
                if wins:
                    return wins[-1]
            time.sleep(0.15)
        raise BackendError("HTA dialog did not appear" + (f" (title regex '{title_re}')" if title_re else ""))

    def _open_dialog(self, menu_path: str, title_re: str) -> Any:
        before = {_safe(lambda: w.handle) for w in self._top_windows()}
        if menu_path:
            self.invoke_menu(menu_path)
            return self._wait_dialog(title_re, before)
        return self._wait_dialog(title_re, ())

    def _scan_dialog_page(self, dlg: Any, page: str) -> List[DlgControl]:
        ctrls: List[UiaCtrl] = []
        for wr in _safe(lambda: dlg.descendants(), []):
            try:
                info = wr.element_info
                ct = info.control_type
                if ct not in ("Edit", "Spinner", "ComboBox", "CheckBox", "RadioButton", "Text", "DataItem", "Slider"):
                    continue
                if not wr.is_visible():
                    continue
                r = info.rectangle
                if r.right - r.left < 3 or r.bottom - r.top < 3:
                    continue
                c = UiaCtrl(ctype=ct, rect=(r.left, r.top, r.right, r.bottom), name=(info.name or "").strip(),
                            aid=(info.automation_id or "").strip(), cls=info.class_name or "", wrapper=wr)
                self._enrich(c)
                if ct == "RadioButton":
                    c.value = "1" if _safe(lambda: wr.is_selected(), False) else "0"
                ctrls.append(c)
            except Exception:
                continue
        analyze_controls(ctrls, self.s.label_max_gap_px)
        out: List[DlgControl] = []
        for c in reading_order([c for c in ctrls if c.role in ("input", "combo", "checkbox", "radio",
                                                                  "cell", "slider")],
                               lambda c: c.cx, lambda c: c.cy, 8):
            label = c.label or c.name or c.aid or f"{c.ctype}@{c.left},{c.top}"
            opts = ""
            if c.role == "combo":
                opts = ";".join(t for t in _safe(lambda: c.wrapper.texts(), []) if isinstance(t, str) and t)
            if c.role == "cell":
                gi = _safe(lambda: c.wrapper.iface_grid_item)
                if gi is not None:
                    label = f"R{_safe(lambda: gi.CurrentRow, 0) + 1}C{_safe(lambda: gi.CurrentColumn, 0) + 1}"
            out.append(DlgControl(page, label, c.role, c.value if c.role != "cell" else c.name,
                                  options=opts, wrapper=c.wrapper))
        return out

    def _scan_dialog(self, dlg: Any) -> List[DlgControl]:
        items: List[DlgControl] = []
        pages = _safe(lambda: dlg.descendants(control_type="TabItem"), [])
        if not pages:
            items = self._scan_dialog_page(dlg, "")
        else:
            for ti in pages:
                name = (_safe(lambda: ti.window_text(), "") or "").strip()
                try:
                    ti.select()
                except Exception:
                    _safe(lambda: ti.click_input())
                time.sleep(self.s.tab_switch_ms / 1000.0)
                items += self._scan_dialog_page(dlg, name)
        assign_dlg_instances(items)
        return items

    def _press_dialog(self, dlg: Any, regex: str) -> bool:
        rx = re.compile(regex, re.I)
        for b in _safe(lambda: dlg.descendants(control_type="Button"), []):
            if rx.match((_safe(lambda: b.window_text(), "") or "").replace("&", "").strip()):
                try:
                    b.invoke()
                except Exception:
                    b.click_input()
                return True
        return False

    def dialog_capture(self, menu_path: str = "", title_re: str = "") -> Tuple[str, List[DlgControl]]:
        self._need()
        dlg = self._open_dialog(menu_path, title_re)
        title = _safe(lambda: dlg.window_text(), "") or ""
        try:
            items = self._scan_dialog(dlg)
        finally:
            if menu_path:  # opened by us -> close without changes
                if not self._press_dialog(dlg, self.s.dialog_cancel_regex):
                    _safe(lambda: dlg.close())
        for it in items:
            it.wrapper = None
        log.info("Captured dialog '%s': %d fields", title, len(items))
        return title, items

    def _write_dialog_field(self, c: DlgControl, value: str) -> str:
        wr = c.wrapper
        if c.ctype in ("checkbox",):
            want = value == "1"
            for _ in range(2):
                st = _safe(lambda: wr.iface_toggle.CurrentToggleState)
                if (st == 1) == want:
                    break
                try:
                    wr.toggle()
                except Exception:
                    wr.click_input()
                time.sleep(0.1)
            return "1" if _safe(lambda: wr.iface_toggle.CurrentToggleState) == 1 else "0"
        if c.ctype == "radio":
            if value == "1":
                try:
                    wr.select()
                except Exception:
                    wr.click_input()
            return "1" if _safe(lambda: wr.is_selected(), False) else "0"
        if c.ctype == "combo":
            try:
                wr.select(value)
            except Exception:
                wr.iface_value.SetValue(value)
            return str(_safe(lambda: wr.selected_text(), None) or _safe(lambda: wr.iface_value.CurrentValue, value))
        if c.ctype == "slider":
            wr.iface_range_value.SetValue(float(to_float(value)))
            return fmt_num(_safe(lambda: wr.iface_range_value.CurrentValue))
        # input / cell
        try:
            wr.iface_value.SetValue(value)
        except Exception:
            self._focus_hta()
            if c.ctype == "cell":
                wr.double_click_input()
            else:
                wr.set_focus()
            self._pw.keyboard.send_keys("^a{BACKSPACE}" + _escape_keys(value)
                                        + ("{ENTER}" if c.ctype == "cell" else "{TAB}"),
                                        pause=0.02, with_spaces=True)
        time.sleep(0.1)
        return str(_safe(lambda: wr.iface_value.CurrentValue, value))

    def dialog_apply(self, menu_path: str, title_re: str, items: Sequence[DlgControl],
                     press: str = "OK") -> Tuple[str, List[WriteResult]]:
        self._need()
        dlg = self._open_dialog(menu_path, title_re)
        title = _safe(lambda: dlg.window_text(), "") or ""
        current = self._scan_dialog(dlg)
        index = {(norm_key(c.page), norm_key(c.label), c.instance): c for c in current}
        pages = {norm_key(_safe(lambda: t.window_text(), "")): t
                 for t in _safe(lambda: dlg.descendants(control_type="TabItem"), [])}
        results: List[WriteResult] = []
        for it in items:
            if not str(it.set_value).strip():
                continue
            res = WriteResult(key=it.key, requested=str(it.set_value), method="dialog")
            c = index.get((norm_key(it.page), norm_key(it.label), it.instance))
            if c is None:
                res.message = "field not found in dialog"
                results.append(res)
                continue
            try:
                v = dialog_validate(c, it.set_value)
                if it.page and norm_key(it.page) in pages:
                    t = pages[norm_key(it.page)]
                    try:
                        t.select()
                    except Exception:
                        t.click_input()
                    time.sleep(self.s.tab_switch_ms / 1000.0)
                res.before = c.value
                res.after = self._write_dialog_field(c, v)
                res.ok = (norm_key(res.after) == norm_key(v)) or values_match(None, v, res.after)[0]
                if not res.ok:
                    res.message = f"dialog shows '{res.after}'"
            except Exception as e:
                res.message = f"{type(e).__name__}: {e}"
            results.append(res)
        p = norm_key(press)
        if p in ("ok", "apply"):
            rx = self.s.dialog_ok_regex if p == "ok" else self.s.dialog_apply_regex
            if not self._press_dialog(dlg, rx):
                log.warning("No '%s' button found in dialog '%s'", press, title)
        elif p == "cancel":
            self._press_dialog(dlg, self.s.dialog_cancel_regex)
        log.info("Applied %d/%d fields to '%s' (%s)", sum(r.ok for r in results), len(results), title, press)
        return title, results

    # ---------------------------------------------------------------- support
    def inspect(self, path: Any) -> Path:
        """Dump the HTA control tree + per-tab classification to a text file."""
        self._need()
        path = Path(path)
        lines = [f"{APP_NAME} {__version__} - HTA inspect {now_iso()}", f"Window: {self.title}",
                 f"DPI scale: {self._scale}", f"Tabs: {', '.join(self.tabs())}", "", "== RAW TREE =="]

        def walk(node: Any, depth: int) -> None:
            if depth > 25 or len(lines) > 60000:
                return
            for ch in _safe(lambda: node.children(), []):
                i = ch.element_info
                r = _safe(lambda: i.rectangle)
                lines.append(f"{'  ' * depth}{i.control_type} name={i.name!r} aid={i.automation_id!r} "
                             f"class={i.class_name!r} rect={(r.left, r.top, r.right, r.bottom) if r else None}")
                walk(ch, depth + 1)

        walk(self.win, 0)
        for tab in self.tabs():
            lines += ["", f"== TAB '{tab}' (classified) =="]
            for c in self.scan_tab(tab, force=True):
                lines.append(f"{c.role:9s} {c.ctype:10s} label={c.label!r:32} name={c.name!r:24} "
                             f"aid={c.aid!r} cls={c.cls} rect={c.rect} value={c.value!r} "
                             f"min={c.min} max={c.max}")
            cal = self._calibration(tab)
            if cal:
                lines.append(f"calibration: {cal}")
        path.write_text("\n".join(lines), "utf-8")
        return path


