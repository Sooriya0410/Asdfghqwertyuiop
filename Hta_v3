@dataclass
class ConfigProfile:
    name: str
    menu_path: str = ""
    title_re: str = ""
    press: str = "OK"
    captured: str = ""
    items: List[DlgControl] = field(default_factory=list)


_CFG_HEAD = ["Page", "Label", "Instance", "Type", "Captured Value", "Set Value", "Options", "Status"]


def save_config_profile(path: Any, prof: ConfigProfile) -> Path:
    """Add / replace one profile sheet in HTA_Config.xlsx (other profiles are kept)."""
    _require_openpyxl()
    st = _xl_styles()
    path = Path(path)
    wb = openpyxl.load_workbook(path) if path.exists() else openpyxl.Workbook()
    if not path.exists() and wb.active.max_row == 1 and wb.active["A1"].value is None:
        wb.remove(wb.active)
    sheet = re.sub(r"[\[\]:*?/\\]", "_", prof.name)[:31] or "Profile"
    if sheet in wb.sheetnames:
        idx = wb.sheetnames.index(sheet)
        wb.remove(wb[sheet])
        ws = wb.create_sheet(sheet, idx)
    else:
        ws = wb.create_sheet(sheet)
    meta = [("Profile", prof.name), ("Menu path", prof.menu_path), ("Dialog title regex", prof.title_re),
            ("Press after apply", prof.press), ("Captured", prof.captured or now_iso())]
    for i, (k, v) in enumerate(meta, 1):
        ws.cell(i, 1, k).font = st.bold
        ws.cell(i, 2, v)
    hdr = len(meta) + 2
    for j, h in enumerate(_CFG_HEAD, 1):
        c = ws.cell(hdr, j, h)
        c.font, c.fill, c.alignment = st.hfont, st.hfill, st.center
    for r, it in enumerate(prof.items, hdr + 1):
        for j, v in enumerate([it.page, it.label, it.instance, it.ctype, it.value, it.set_value or None,
                               it.options, it.status], 1):
            ws.cell(r, j, v)
        ws.cell(r, 6).fill = st.input_fill
    for j, wd in enumerate([16, 34, 9, 10, 18, 14, 34, 30], 1):
        ws.column_dimensions[get_column_letter(j)].width = wd
    ws.freeze_panes = ws.cell(hdr + 1, 1)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        wb.save(path)
    except PermissionError as e:
        raise PermissionError(f"Cannot write {path} - close it in Excel first.") from e
    return path


def load_config_profiles(path: Any) -> Dict[str, ConfigProfile]:
    _require_openpyxl()
    wb = openpyxl.load_workbook(Path(path), data_only=True)
    out: Dict[str, ConfigProfile] = {}
    for ws in wb.worksheets:
        meta = {norm_key(ws.cell(r, 1).value): _cell_str(ws.cell(r, 2).value) for r in range(1, 8)}
        hdr = next((r for r in range(1, 15) if norm_key(ws.cell(r, 2).value) == "label"
                    and norm_key(ws.cell(r, 1).value) == "page"), 0)
        if not hdr:
            continue
        prof = ConfigProfile(meta.get("profile") or ws.title, meta.get("menupath", ""),
                             meta.get("dialogtitleregex", ""), meta.get("pressafterapply", "OK") or "OK",
                             meta.get("captured", ""))
        for r in range(hdr + 1, ws.max_row + 1):
            label = _cell_str(ws.cell(r, 2).value)
            if not label:
                continue
            prof.items.append(DlgControl(
                page=_cell_str(ws.cell(r, 1).value), label=label,
                instance=int(to_float(ws.cell(r, 3).value) or 1), ctype=_cell_str(ws.cell(r, 4).value) or "input",
                value=_cell_str(ws.cell(r, 5).value), set_value=_cell_str(ws.cell(r, 6).value),
                options=_cell_str(ws.cell(r, 7).value)))
        out[prof.name] = prof
    return out


def workbook_bundle(path: Any, table: SignalTable, settings: Settings, keywords_file: Optional[Path] = None,
                    regenerate: bool = False, progress: Optional[Callable[[str], None]] = None) -> Dict[str, Any]:
    """Everything the GUI needs for one workbook, prepared off the GUI thread."""
    path = Path(path)
    try:
        steps = load_sequence(path)
    except KeyError:
        steps = []
    except Exception as e:
        log.warning("Sequence sheet not loaded: %s", e)
        steps = []
    kwp = Path(keywords_file) if keywords_file else settings.keywords_path(path)
    if progress:
        progress("Keywords ...")
    km, problems, written = ensure_keywords(table, kwp, settings, regenerate=regenerate)
    cfg = settings.config_path(path)
    profiles = None
    if cfg.exists():
        try:
            profiles = load_config_profiles(cfg)
        except Exception as e:
            log.warning("%s not loaded: %s", cfg.name, e)
    return {"path": path, "table": table, "steps": steps, "kw_path": kwp, "km": km, "problems": problems,
            "written": written, "regenerate": regenerate, "cfg_path": cfg, "profiles": profiles}


