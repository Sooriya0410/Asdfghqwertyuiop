def sanitize_sheet_name(name: str, used: set) -> str:
    s = re.sub(r"[\[\]:*?/\\]", "_", str(name)).strip("' ") or "Tab"
    s = s[:31]
    base, i = s, 2
    while s.lower() in used or s.lower() in RESERVED_SHEETS:
        suf = f"_{i}"
        s = base[:31 - len(suf)] + suf
        i += 1
    used.add(s.lower())
    return s


def _excel_value(w: Widget, attr: str) -> Any:
    v = _excel_value_raw(w, attr)
    return _xl_clean(v) if isinstance(v, str) else v


def _excel_value_raw(w: Widget, attr: str) -> Any:
    v = getattr(w, attr)
    if attr == "critical":
        return "Y" if v else None
    if attr in ("current", "set_value"):
        s = str(v or "").strip()
        if _PURE_NUM_RE.match(s):
            f = float(s)
            return int(f) if f.is_integer() and abs(f) < 1e15 else f
        return s or None
    if attr == "raw":
        return (v or "")[:_RAW_MAX[0]] or None
    if v is None or v == "":
        return None
    return v


