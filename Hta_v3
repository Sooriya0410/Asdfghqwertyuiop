            s = self.s
            self.submit(lambda: find_layout_files(default_search_dirs(s), s.extensions()), self._found)

        def _found(self, res: Any) -> None:
            try:
                self.btn_auto.setEnabled(True)
                self.btn_auto.setText("Auto-find")
            except RuntimeError:  # dialog already closed
                return
            if isinstance(res, Exception):
                QtWidgets.QMessageBox.warning(self, "Auto-find", str(res))
                return
            for p, n in res[:50]:
                self._add(str(p), f"{n} widgets")
            if not res:
                QtWidgets.QMessageBox.information(
                    self, "Auto-find", "No layout files found automatically.\n"
                    "Use 'Add folder...' on HTA's installation / project folder, or use the live scan.")

        def _remove(self) -> None:
            for it in self.list.selectedItems():
                self.list.takeItem(self.list.row(it))

