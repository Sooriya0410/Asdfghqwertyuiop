def cmd_run(args: argparse.Namespace, s: Settings) -> int:
    table = import_excel(args.excel)
    steps = load_sequence(args.excel, args.sheet)
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))

    def prompt(msg: str) -> bool:
        if args.yes:
            return True
        try:
            return input(f"\nPAUSE: {msg}\n  [Enter] continue, [a] abort: ").strip().lower() != "a"
        except EOFError:
            return True

    runner = SequenceRunner(ctl, s, args.dry_run, prompt=prompt)
    results = runner.run(steps)
    report = Path(args.report) if args.report else \
        s.report_path() / f"SeqReport_{_dt.datetime.now():%Y%m%d_%H%M%S}.xlsx"
    write_sequence_report(results, report, {"workbook": str(args.excel), "backend": ctl.backend.kind,
                                            "dry_run": args.dry_run, "started": runner.started,
                                            "finished": runner.finished, "user": AuditLog(".").user})
    print()
    for r in results:
        print(f"{r.step:>4} {r.action:10s} {r.target:40s} {r.verdict:7s} {r.actual:>10}  {r.message}")
    verdict = overall_verdict(results)
    print(f"\nOVERALL: {verdict}    report: {report}")
    return 0 if verdict == "PASS" else 1


