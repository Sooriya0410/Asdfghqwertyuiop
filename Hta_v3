def _cell_str(v: Any) -> str:
    if v is None:
        return ""
    if isinstance(v, float):
        return fmt_num(v)
    return str(v).strip()


def _ranges(letter: str, rows: Sequence[int]) -> str:
    """[2,3,4,7,9,10] -> 'L2:L4 L7 L9:L10'  (one sqref instead of thousands of single cells)."""
    out, rows = [], sorted(rows)
    i = 0
    while i < len(rows):
        j = i
        while j + 1 < len(rows) and rows[j + 1] == rows[j] + 1:
            j += 1
        out.append(f"{letter}{rows[i]}" if i == j else f"{letter}{rows[i]}:{letter}{rows[j]}")
        i = j + 1
    return " ".join(out)


def _write_tab_sheet(ws: Any, widgets: Sequence[Widget], defer: Optional[list] = None) -> None:
    """Header, widths, filter, rules and validations; data rows go to *defer* (streamed in later
    by _inject_rows) or, without it, are appended through openpyxl."""
    from openpyxl.formatting.rule import FormulaRule
    st = _xl_styles()
    ws.append([h for h, _, _ in EXCEL_COLUMNS])
    attrs = [a for _, a, _ in EXCEL_COLUMNS]
    if defer is not None:
        defer.extend([_excel_value(w, a) for a in attrs] for w in widgets)
    else:
        for w in widgets:
            ws.append([_excel_value(w, a) for a in attrs])
    ncol, last = len(EXCEL_COLUMNS), max(2, len(widgets) + 1)
    for i, (_, _, width) in enumerate(EXCEL_COLUMNS, 1):
        c = ws.cell(1, i)
        c.font, c.fill, c.alignment = st.hfont, st.hfill, st.center
        ws.column_dimensions[get_column_letter(i)].width = width
    ws.row_dimensions[1].height = 22
    ws.freeze_panes = "C2"
    ws.auto_filter.ref = f"A1:{get_column_letter(ncol)}{last}"
    L = {a: get_column_letter(i) for i, (_, a, _) in enumerate(EXCEL_COLUMNS, 1)}
    acc = f"${L['access']}2"
    sv = f"{L['set_value']}2:{L['set_value']}{last}"
    # formatting by rules: constant cost whatever the number of rows
    ws.conditional_formatting.add(sv, FormulaRule(formula=[f'{acc}="RO"'], fill=st.ro_fill, stopIfTrue=True))
    ws.conditional_formatting.add(sv, FormulaRule(formula=[f'{acc}<>"RO"'], fill=st.input_fill))
    ws.conditional_formatting.add(f"A2:{get_column_letter(ncol)}{last}",
                                  FormulaRule(formula=[f'{acc}="RO"'], font=st.grey))
    ws.conditional_formatting.add(f"{L['name']}2:{L['name']}{last}",
                                  FormulaRule(formula=[f'{acc}<>"RO"'], font=st.bold))
    ws.conditional_formatting.add(f"{L['critical']}2:{L['critical']}{last}",
                                  FormulaRule(formula=[f'${L["critical"]}2="Y"'], font=st.crit))
    groups: Dict[tuple, List[int]] = defaultdict(list)
    for r, w in enumerate(widgets, 2):
        if not w.writable:
            continue
        opts = w.option_list()
        if opts:
            labels = [l for l, _ in opts]
            f = '"' + ",".join(labels) + '"'
            if all('"' not in l and "," not in l for l in labels) and len(f) <= 255:
                groups[("list", f)].append(r)
        elif w.min is not None or w.max is not None:
            groups[("dec", w.min, w.max)].append(r)
    for sig, rows in groups.items():
        sq = _ranges(L["set_value"], rows)
        if sig[0] == "list":
            dv = DataValidation(type="list", formula1=sig[1], allow_blank=True, sqref=sq)
            dv.error = "Choose one of: " + sig[1].strip('"')
        else:
            _, mn, mx = sig
            if mn is not None and mx is not None:
                dv = DataValidation(type="decimal", operator="between", formula1=repr(float(mn)),
                                    formula2=repr(float(mx)), allow_blank=True, sqref=sq)
            elif mn is not None:
                dv = DataValidation(type="decimal", operator="greaterThanOrEqual",
                                    formula1=repr(float(mn)), allow_blank=True, sqref=sq)
            else:
                dv = DataValidation(type="decimal", operator="lessThanOrEqual",
                                    formula1=repr(float(mx)), allow_blank=True, sqref=sq)
            dv.error = f"Allowed range: {fmt_num(mn) or '-inf'} .. {fmt_num(mx) or '+inf'}"
        dv.errorTitle, dv.showErrorMessage = "HTA limit", True
        ws.add_data_validation(dv)


