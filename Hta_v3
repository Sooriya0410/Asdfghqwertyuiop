        print("Critical signals:\n  " + "\n  ".join(f"{w.key} -> {w.set_value}" for w in crit))
        if not _confirm("Write them?"):
            return 3
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))
    res = ctl.apply_pending(ws, args.dry_run)
