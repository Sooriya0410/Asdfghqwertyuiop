# 11. BACKGROUND WORKER (one thread owns the backend - COM apartment rules)
# =============================================================================
class Batcher:
    """Collects results produced on a worker thread and hands them over in chunks
    (max_items or max_age seconds) - keeps the GUI event queue small for 10 000+ signals."""

    def __init__(self, sink: Callable[[list], None], max_items: int = 300, max_age: float = 0.15):
        self.sink, self.max_items, self.max_age = sink, max_items, max_age
        self.buf: list = []
        self.t = time.perf_counter()

    def add(self, item: Any) -> None:
        self.buf.append(item)
        if len(self.buf) >= self.max_items or time.perf_counter() - self.t >= self.max_age:
            self.flush()

    def flush(self) -> None:
        if self.buf:
            items, self.buf = self.buf, []
            self.sink(items)
        self.t = time.perf_counter()


class JobWorker(threading.Thread):
    def __init__(self, notify: Callable[[Callable[[Any], None], Any], None], name: str = "hta-worker"):
        super().__init__(name=name, daemon=True)
        self.q: "queue.Queue[Tuple[Optional[Callable[[], Any]], Optional[Callable[[Any], None]]]]" = queue.Queue()
        self.notify = notify
        self.busy = False

    def submit(self, fn: Callable[[], Any], callback: Optional[Callable[[Any], None]] = None) -> None:
        self.q.put((fn, callback))

    def run(self) -> None:
        _ensure_com()
        while True:
            fn, cb = self.q.get()
            if fn is None:
                return
            self.busy = True
            try:
                res: Any = fn()
            except Exception as e:
                log.error("%s: %s", type(e).__name__, e)
                log.debug(traceback.format_exc())
                res = e
            finally:
                self.busy = False
            if cb is not None:
                try:
                    self.notify(cb, res)
                except Exception:
                    log.exception("notify failed")

    @property
    def pending(self) -> int:
        return self.q.qsize() + (1 if self.busy else 0)

    def shutdown(self) -> None:
        self.q.put((None, None))


