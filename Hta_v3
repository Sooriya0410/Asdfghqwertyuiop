def _print_cmd_lines(lines: Sequence[CmdLine]) -> bool:
    mark = {"ok": "OK ", "value": "   ", "info": "   ", "warn": "!  ", "error": "ERR"}
    for o in lines:
        if o.level != "action":
            print(f"  {mark.get(o.level, '   ')} {o.text}")
    return any(o.level == "error" for o in lines)


def cmd_cmd(args: argparse.Namespace, s: Settings) -> int:
    table, km, _ = _table_and_keywords(args, s)
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))
    eng = CommandEngine(table, km, s, lambda: ctl)
    bad = False
    for line in args.command:
        print(f"HTA> {line}")
        bad |= _print_cmd_lines(eng.execute(line, args.dry_run))
    return 1 if bad else 0


def cmd_console(args: argparse.Namespace, s: Settings) -> int:
    table, km, kwp = _table_and_keywords(args, s)
    ctl = Controller(_make_backend(args, s, table), table, s, AuditLog(s.audit_path()))
    eng = CommandEngine(table, km, s, lambda: ctl)
    dry = args.dry_run
    try:
        importlib.import_module("readline")  # arrow-key history on Linux/macOS
    except ImportError:
        pass
    print(f"{APP_NAME} console - {len(km)} keywords from {kwp.name}.  HELP = syntax, KEYS = list, EXIT = quit")
    while True:
        try:
            line = input(("DRY " if dry else "") + "HTA> ")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if line.strip().upper() in ("EXIT", "QUIT"):
            break
        out = eng.execute(line, dry)
        _print_cmd_lines(out)
        for o in out:
            if o.level != "action":
                continue
            name, _, arg = o.text.partition(":")
            if name == "dry":
                dry = arg == "on"
            elif name == "refresh":
                km, problems, _ = ensure_keywords(table, kwp, s)
                eng.bind(table, km)
                print(f"      {len(km)} keywords reloaded" + (f", {len(problems)} problem(s)" if problems else ""))
            elif name == "cls":
                os.system("cls" if os.name == "nt" else "clear")
            elif name != "read_tab":
                print(f"      ({name.upper()} is available in the GUI)")
    return 0


