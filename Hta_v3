def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="hta_bridge", description=f"{APP_NAME} {__version__} - "
                                "HTA <-> Excel <-> GUI bridge", formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog=__doc__.split("QUICK START", 1)[-1].split("HOW VALUES", 1)[0])
    p.add_argument("-v", "--verbose", action="store_true", help="debug output on the console")
    sub = p.add_subparsers(dest="cmd")

    g = sub.add_parser("gui", help="open the GUI (default)")
    g.add_argument("excel", nargs="?", help="signal workbook to open")

    e = sub.add_parser("extract", help="extract HTA widgets into an Excel workbook")
    e.add_argument("--xml", action="append", help="layout XML file or folder (repeatable)")
    e.add_argument("--live", action="store_true", help="also scan the running HTA (UI Automation)")
    e.add_argument("--dialogs", choices=["widget", "tab"], help="read HTA 'Change Widget Properties' dialogs")
    e.add_argument("-o", "--output", default=f"HTA_Signals_{_dt.date.today():%Y%m%d}.xlsx")
    e.add_argument("--keywords", help="Keywords workbook (default: Keywords.xlsx next to the output)")
    e.add_argument("--no-keywords", action="store_true", help="do not create / update Keywords.xlsx")

    f = sub.add_parser("find-layouts", help="search for HTA layout XML files")
    f.add_argument("dirs", nargs="*", help="folders to search (default: HTA process dirs, Documents, ...)")
    f.add_argument("--depth", type=int, default=6)

    i = sub.add_parser("inspect", help="dump HTA's UI-automation tree (for troubleshooting)")
    i.add_argument("-o", "--output")

    for name, hlp in (("set", "write one signal"), ("get", "read signal(s)"),
                      ("apply", "write every filled 'Set Value' cell"), ("run", "run the Sequence sheet")):
        sp = sub.add_parser(name, help=hlp)
        sp.add_argument("excel")
        if name == "set":
            sp.add_argument("signal", help="'Name', 'Name#2' or 'Tab/Name'")
            sp.add_argument("value")
        if name == "get":
            sp.add_argument("signal", nargs="+")
        if name in ("set", "get", "apply"):
            sp.add_argument("--tab")
        if name == "apply":
            sp.add_argument("--save", action="store_true", help="write read-back values into the workbook")
        if name == "run":
            sp.add_argument("--sheet", default=SHEET_SEQUENCE)
            sp.add_argument("--report")
        sp.add_argument("--sim", action="store_true", help="use the offline simulator instead of HTA")
        if name != "get":
            sp.add_argument("--dry-run", action="store_true", help="validate & log only, send nothing")
            sp.add_argument("-y", "--yes", action="store_true", help="no confirmation prompts")

    k = sub.add_parser("keywords", help="create / update Keywords.xlsx for a signal workbook")
    k.add_argument("excel")
    k.add_argument("-o", "--output", help="default: Keywords.xlsx next to the workbook")
    k.add_argument("--fresh", action="store_true", help="ignore the existing Keywords.xlsx")

    for name, hlp in (("cmd", "run console command(s): cmd <xlsx> \"AWS100\" \"IGN ON\""),
                      ("console", "interactive keyword console (AWS100, IGN ON, KLA? ...)")):
        c = sub.add_parser(name, help=hlp)
        c.add_argument("excel")
        if name == "cmd":
            c.add_argument("command", nargs="+")
        c.add_argument("--keywords", help="Keywords workbook (default: next to the signal workbook)")
        c.add_argument("--sim", action="store_true", help="use the offline simulator")
        c.add_argument("--dry-run", action="store_true")

    sm = sub.add_parser("sim", help="start / stop / reset the HTA simulation, or show its status")
    sm.add_argument("action", choices=["start", "stop", "reset", "status"])
    sm.add_argument("--excel", help="signal workbook (only needed with --sim)")
    sm.add_argument("--sim", action="store_true")
    sm.add_argument("--dry-run", action="store_true")

    mn = sub.add_parser("menus", help="list every HTA menu entry (and optionally click one)")
    mn.add_argument("--click", metavar="PATH", help="e.g. \"Settings -> Hardware...\"")
    mn.add_argument("--sim", action="store_true")
    mn.add_argument("--dry-run", action="store_true")

    cf = sub.add_parser("config", help="capture / apply HTA dialog profiles (hardware, channels)")
    cf.add_argument("action", choices=["capture", "apply", "list"])
    cf.add_argument("--menu", help="menu path that opens the dialog, e.g. \"Settings -> Hardware...\"")
    cf.add_argument("--title", help="dialog title regex (dialog already open)")
    cf.add_argument("--name", help="profile name")
    cf.add_argument("--file", help="profiles workbook (default HTA_Config.xlsx in the current folder)")
    cf.add_argument("--press", choices=["OK", "Apply", "None", "Cancel"])
    cf.add_argument("--sim", action="store_true")
    cf.add_argument("--dry-run", action="store_true")

    ins = sub.add_parser("install", help="install / update the required Python libraries")
    ins.add_argument("--check", action="store_true", help="only show what is installed")
    ins.add_argument("--all", action="store_true", help="update every library, not only missing ones")
    ins.add_argument("--pip-args", help="extra pip arguments, e.g. \"--proxy http://host:8080\"")

    d = sub.add_parser("demo", help="offline demo with a simulated HTA")
    d.add_argument("--folder")
    d.add_argument("--no-gui", action="store_true", help="run the demo sequence in the console")

    sub.add_parser("selftest", help="run the built-in test suite")
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    cmd = args.cmd or "gui"
    setup_logging(logging.DEBUG if args.verbose else logging.WARNING if cmd == "selftest" else logging.INFO)
    s = Settings.load()
    if cmd == "install":
        return cmd_install(args, s)
    gui_cmd = cmd == "gui" or (cmd == "demo" and not getattr(args, "no_gui", False))
    if (gui_cmd and not HAVE_QT) or not HAVE_OPENPYXL:
        missing = missing_requirements()
        if gui_cmd:
            return bootstrap_installer(missing, list(argv) if argv is not None else sys.argv[1:])
        print(f"Missing libraries: {', '.join(missing)}\nRun:  python {Path(sys.argv[0]).name} install")
        return 2
    try:
        if cmd == "gui":
            return run_gui(getattr(args, "excel", None), s)
        if cmd == "selftest":
            return run_selftest()
        return {"extract": cmd_extract, "find-layouts": cmd_find, "inspect": cmd_inspect, "set": cmd_set,
                "get": cmd_get, "apply": cmd_apply, "run": cmd_run, "demo": cmd_demo, "keywords": cmd_keywords,
                "cmd": cmd_cmd, "console": cmd_console, "sim": cmd_sim, "menus": cmd_menus,
                "config": cmd_config}[cmd](args, s)
    except KeyboardInterrupt:
        log.warning("Interrupted")
        return 130
    except (BackendError, KeyError, ValueError, PermissionError, FileNotFoundError, RuntimeError) as e:
        log.error("%s", str(e).strip("'\""))
        log.debug(traceback.format_exc())
        return 2


if __name__ == "__main__":
    import multiprocessing
    multiprocessing.freeze_support()  # helper processes in a packaged .exe
    sys.exit(main())
