            if hasattr(self, "beginFilterChange"):
                self.beginFilterChange()
                self.toks = text.lower().split()
                self.endFilterChange()
            else:
                self.toks = text.lower().split()
                self.invalidateFilter()

        def filterAcceptsRow(self, row: int, parent) -> bool:
            if not self.toks:
                return True
            m = self.sourceModel()
            hay = f"{m.text(row, 0)} {m.text(row, 2)} {m.text(row, 4)}".lower()
            return all(t in hay for t in self.toks)

