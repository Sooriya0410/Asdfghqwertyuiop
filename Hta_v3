def _dist_version(name: str) -> str:
    """Installed version of a distribution (works on Python 3.7 too)."""
    try:
        from importlib import metadata as _md  # Python 3.8+
        return _md.version(name)
    except Exception:
        pass
    try:
        import importlib_metadata as _md2  # type: ignore  # backport, if present
        return _md2.version(name)
    except Exception:
        pass
    try:
        import pkg_resources  # type: ignore  # setuptools (always there on 3.7)
        return pkg_resources.get_distribution(name).version
    except Exception:
        pass
    try:
        return str(getattr(importlib.import_module(name), "__version__", "?"))
    except Exception:
        return "?"


def check_requirements() -> List[Dict[str, Any]]:
    out = []
    for pip_name, mod, purpose, required in REQUIREMENTS:
        if pip_name == "pywinauto" and sys.platform != "win32":
            continue  # Windows-only; irrelevant elsewhere
        installed = importlib.util.find_spec(mod) is not None
        out.append({"package": pip_name, "module": mod, "purpose": purpose, "required": required,
                    "installed": installed, "version": _dist_version(pip_name) if installed else ""})
    return out


def missing_requirements(required_only: bool = True) -> List[str]:
    return [r["package"] for r in check_requirements() if not r["installed"] and (r["required"] or not required_only)]


# last releases that still support Python 3.7 (pip honours these pins even when it is old)
PY37_PINS: Dict[str, str] = {"PySide6": "PySide6>=6.5,<6.6", "lxml": "lxml>=4.9,<6",
                             "openpyxl": "openpyxl>=3.1,<3.2", "psutil": "psutil>=5.9"}


def pip_command(packages: Optional[Sequence[str]] = None, upgrade: bool = True, extra: str = "") -> List[str]:
    pkgs = list(packages) if packages else [r[0] for r in REQUIREMENTS
                                            if r[0] != "pywinauto" or sys.platform == "win32"]
    if sys.version_info < (3, 8):
        pkgs = [PY37_PINS.get(p, p) for p in pkgs]
    return [sys.executable, "-m", "pip", "install", "--disable-pip-version-check"] + \
        (["--upgrade"] if upgrade else []) + pkgs + (shlex.split(extra, posix=(os.name != "nt")) if extra else [])


def install_requirements(packages: Optional[Sequence[str]] = None, upgrade: bool = True, extra: str = "",
                         out: Callable[[str], None] = print) -> int:
    if getattr(sys, "frozen", False):
        out("This is a packaged executable - libraries are already bundled.")
        return 0
    cmd = pip_command(packages, upgrade, extra)
    out("> " + " ".join(cmd))
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
                             creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    except OSError as e:
        out(f"cannot start pip: {e}")
        return 1
    assert p.stdout is not None
    for line in p.stdout:
        out(line.rstrip())
    rc = p.wait()
    out("Installation finished OK - restart HTA Bridge." if rc == 0 else
        f"pip failed (exit code {rc}). Behind a proxy? Set 'pip_extra_args' in Settings, e.g. --proxy http://host:port")
    return rc


def bootstrap_installer(missing: Sequence[str], relaunch_args: Sequence[str]) -> int:
    """Tiny tkinter window with an 'Install required libraries' button (runs before PySide6 exists)."""
    try:
        import tkinter as tk
        from tkinter import scrolledtext
    except Exception:
        print(f"Missing libraries: {', '.join(missing)}")
        if input("Install them now with pip? [y/N] ").strip().lower() in ("y", "yes"):
            return install_requirements(extra=Settings.load().pip_extra_args)
        return 2
    root = tk.Tk()
    root.title(f"{APP_NAME} - setup")
    root.geometry("720x420")
    tk.Label(root, text=f"{APP_NAME} needs these Python libraries:", font=("Segoe UI", 11, "bold")).pack(
        anchor="w", padx=10, pady=(10, 0))
    tk.Label(root, text="Missing: " + ", ".join(missing), fg="#C00000").pack(anchor="w", padx=10)
    log_box = scrolledtext.ScrolledText(root, height=14, font=("Consolas", 9))
    log_box.pack(fill="both", expand=True, padx=10, pady=8)
    bar = tk.Frame(root)
    bar.pack(fill="x", padx=10, pady=(0, 10))
    q: "queue.Queue[str]" = queue.Queue()
    state = {"rc": None}

    def pump() -> None:
        while not q.empty():
            log_box.insert("end", q.get() + "\n")
            log_box.see("end")
        if state["rc"] is None:
            root.after(150, pump)
        elif state["rc"] == 0:
            btn.config(text="Start HTA Bridge", state="normal", command=relaunch)
        else:
            btn.config(text="Retry install", state="normal")

    def run() -> None:
        btn.config(state="disabled", text="Installing ...")
        state["rc"] = None
        threading.Thread(target=lambda: state.update(rc=install_requirements(
            extra=Settings.load().pip_extra_args, out=q.put)), daemon=True).start()
        root.after(150, pump)

    def relaunch() -> None:
        subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), *relaunch_args])
        root.destroy()

    btn = tk.Button(bar, text="Install required libraries", command=run, bg="#1F3864", fg="white",
                    font=("Segoe UI", 10, "bold"), padx=12)
    btn.pack(side="left")
    tk.Button(bar, text="Close", command=root.destroy).pack(side="right")
    root.mainloop()
    return 0 if state["rc"] == 0 else 2


