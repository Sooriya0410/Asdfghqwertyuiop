#  DBC model
# =============================================================================
_BO_RE = re.compile(r"^BO_\s+(\d+)\s+(\w+)\s*:\s*(\d+)\s+(\w+)")
_SG_RE = re.compile(r"^\s*SG_\s+(\w+)\s*(M|m\d+)?\s*:\s*(\d+)\|(\d+)@([01])([+-])\s*\(\s*([-+0-9.eE]+)\s*,"
                    r"\s*([-+0-9.eE]+)\s*\)\s*\[\s*([-+0-9.eE]*)\s*\|\s*([-+0-9.eE]*)\s*\]\s*\"([^\"]*)\"\s*(.*)$")


def motorola_lsb(start: int, length: int) -> int:
    pos = start
    for _ in range(max(0, length - 1)):
        pos = pos + 15 if pos % 8 == 0 else pos - 1
    return pos


def intel_msb(start: int, length: int) -> int:
    return start + length - 1


class DbcModel:
    def __init__(self):
        self.signals: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
        self.messages: Dict[str, Dict[str, Any]] = {}
        self.nodes: List[str] = []
        self.files = 0

    @classmethod
    def build(cls, idx: SandboxIndex, log=None) -> "DbcModel":
        m = cls()
        for fid in idx.dbc_fids:
            try:
                m._parse(idx.lines(fid), idx.rel(fid))
                m.files += 1
            except Exception as exc:
                if log:
                    log("WARN", f"DBC parse error {idx.rel(fid)}: {exc}")
        return m

    def _parse(self, lines: List[str], rel: str):
        cur = None
        for i, ln in enumerate(lines, 1):
            s = ln.strip()
            if s.startswith("BU_"):
                self.nodes.extend(s.split(":", 1)[-1].split())
            mo = _BO_RE.match(s)
            if mo:
                cur = {"id": int(mo.group(1)), "name": mo.group(2), "dlc": int(mo.group(3)), "tx": mo.group(4),
                       "file": rel, "line": i, "signals": []}
                self.messages[cur["name"]] = cur
                continue
            ms = _SG_RE.match(ln)
            if ms and cur is not None:
                start, length = int(ms.group(3)), int(ms.group(4))
                intel = ms.group(5) == "1"
                sig = {"name": ms.group(1), "msg": cur["name"], "msg_id": cur["id"], "tx": cur["tx"],
                       "start": start, "length": length, "endian": "LITTLE" if intel else "BIG",
                       "signed": ms.group(6) == "-", "factor": float(ms.group(7)), "offset": float(ms.group(8)),
                       "unit": ms.group(11), "rx": [x.strip() for x in ms.group(12).split(",") if x.strip()],
                       "lsb": start if intel else motorola_lsb(start, length),
                       "msb": intel_msb(start, length) if intel else start, "file": rel, "line": i}
                self.signals[sig["name"]].append(sig)
                cur["signals"].append(sig["name"])
            elif s and not s.startswith("SG_"):
                if not ln.startswith((" ", "\t")):
                    cur = None if not s.startswith("BO_") else cur

    def find_signal(self, name: str) -> Optional[Dict[str, Any]]:
        if not name:
            return None
        if name in self.signals:
            return self.signals[name][0]
        base = re.split(r"_o[A-Z]", name)[0]
        if base in self.signals:
            return self.signals[base][0]
        low = base.lower()
        for n, lst in self.signals.items():
            if n.lower() == low:
                return lst[0]
        return None


# =============================================================================
#  Transformer (ComXf / DiagXf) generated-code layout parser
# =============================================================================
def _apply_ops(bits: Dict[int, int], ops: List[Tuple[str, int]], width: int = 64) -> Dict[int, int]:
    """bits: value_bit -> source_bit.  Apply '>>', '<<', '&' sequentially."""
    cur = dict(bits)
    for op, n in ops:
        if op == ">>":
            cur = {vb - n: sb for vb, sb in cur.items() if vb - n >= 0}
        elif op == "<<":
            cur = {vb + n: sb for vb, sb in cur.items() if vb + n < width}
        elif op == "&":
            cur = {vb: sb for vb, sb in cur.items() if (n >> vb) & 1}
    return cur


_OPS_RE = re.compile(r"(>>|<<|&)\s*\(?\s*(?:\(\s*\w+\s*\)\s*)?(0[xX][0-9A-Fa-f]+|\d+)[uUlL]*")


def parse_xf_layout(body: str) -> Dict[str, Dict[str, Any]]:
    """Best-effort bit layout from generated (de)serializer code.

    Returns {member: {'bits': {element_bit: absolute_buffer_bit}, 'lsb', 'msb', 'length', 'endian'}}
    """
    layout: Dict[str, Dict[int, int]] = defaultdict(dict)
    for stmt in re.findall(r"[^;{}]+", body):
        sp = _assignment_split(stmt.strip())
        if not sp:
            continue
        lhs, rhs = sp
        mb = re.search(r"(\w+)\s*\[\s*(\d+)\s*[uU]?\s*\]\s*$", lhs.strip())
        mm_l = re.search(r"(?:->|\.)\s*(\w+)\s*$", lhs.strip())
        if mb and not mm_l:   # serializer: buffer[k] = f(element)
            k = int(mb.group(2))
            for term in split_top(strip_parens(rhs), "|"):
                mem = re.search(r"(?:->|\.)\s*(\w+)", term)
                if not mem:
                    continue
                after = term[mem.end():]
                bits = {i: i for i in range(64)}
                ops = [(o, int(n, 0)) for o, n in _OPS_RE.findall(after)]
                res = _apply_ops(bits, ops)
                for vb, eb in res.items():
                    if vb < 8:
                        layout[mem.group(1)][eb] = k * 8 + vb
        elif mm_l:            # deserializer: element = f(buffer[k], ...)
            member = mm_l.group(1)
            for term in split_top(strip_parens(rhs), "|"):
                bm = re.search(r"\w+\s*\[\s*(\d+)\s*[uU]?\s*\]", term)
                if not bm:
                    continue
                k = int(bm.group(1))
                ops = [(o, int(n, 0)) for o, n in _OPS_RE.findall(term[bm.end():])]
                bits = {i: k * 8 + i for i in range(8)}
                for vb, ab in _apply_ops(bits, ops).items():
                    layout[member][vb] = ab
    out = {}
    for mem, bits in layout.items():
        if not bits:
            continue
        ebs = sorted(bits)
        lsb_abs, msb_abs = bits[ebs[0]], bits[ebs[-1]]
        bytes_seq = [bits[e] // 8 for e in ebs]
        endian = ""
        if len(set(bytes_seq)) > 1:
            endian = "LITTLE" if bytes_seq[-1] > bytes_seq[0] else "BIG"
        out[mem] = {"bits": bits, "lsb": lsb_abs, "msb": msb_abs, "length": ebs[-1] + 1, "endian": endian}
    return out


