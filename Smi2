        def _save_settings(self):
            s = self.settings
            for k, v in self.set_vars.items():
                setattr(s, k, v.get())
            s.excludes = [x.strip() for x in self.var_excl.get().split(",") if x.strip()]
            self._save_paths()
            self._log("INFO", "Settings saved (re-index to apply exclude / size changes)")

        def _clear_cache(self):
            n = 0
            for fn in os.listdir(cache_dir()):
                try:
                    os.remove(os.path.join(cache_dir(), fn))
                    n += 1
                except OSError:
                    pass
            self._log("INFO", f"Index cache cleared ({n} files)")

        def _save_log(self):
            p = filedialog.asksaveasfilename(defaultextension=".txt", initialfile="smi_analyzer_log.txt")
            if p:
                with open(p, "w", encoding="utf-8") as fh:
                    fh.write(self.txt_log.get("1.0", "end"))

        def _save_paths(self):
            self.settings.save({"last_sandbox": self.var_sandbox.get(), "last_out": self.var_out.get(),
                                "last_excel": self.var_excel.get()})

        # ------------------------------------------------------------ actions
        def _browse_dir(self, var):
            p = filedialog.askdirectory(initialdir=var.get() or os.getcwd())
            if p:
                var.set(p)
                self._save_paths()

        def _busy(self, on: bool):
            for b in (self.btn_index, self.btn_run1, self.btn_runb):
                b.configure(state="disabled" if on else "normal")
            self.btn_cancel.configure(state="normal" if on else "disabled")
            self.configure(cursor="watch" if on else "")

        def _start(self, target, *args):
            if self.worker and self.worker.is_alive():
                messagebox.showinfo(TOOL_NAME, "A job is already running.")
                return
            self.cancel.clear()
            self._busy(True)

            def wrap():
                try:
                    target(*args)
                except Cancelled:
                    self.q.put(("log", "WARN", "Cancelled"))
                except Exception as exc:
                    self.q.put(("error", f"{type(exc).__name__}: {exc}", traceback.format_exc()))
                finally:
                    self.q.put(("idle",))
            self.worker = threading.Thread(target=wrap, daemon=True)
            self.worker.start()

        def _check_paths(self, need_out=True) -> bool:
            sb = self.var_sandbox.get().strip()
            if not sb or not os.path.isdir(sb):
                messagebox.showwarning(TOOL_NAME, "Select a valid sandbox folder.")
                return False
            if need_out and not self.var_out.get().strip():
                messagebox.showwarning(TOOL_NAME, "Select an output folder.")
                return False
            self._save_paths()
            return True

        def _index(self, force):
            if not self._check_paths(False):
                return
            self.var_status.set("Indexing sandbox ...")
            self._start(self._do_index, self.var_sandbox.get().strip(), force)

        def _do_index(self, sb, force):
            st = self.engine.load(sb, force=force)
            self.q.put(("indexed", st))

        def _run_single(self):
            if not self._check_paths():
                return
            r = self._row_from_form()
            spec = SMI_SPECS[r.smi]
            for req in spec.required:
                if not any(getattr(r, x) for x in req.split("|")):
                    messagebox.showwarning(TOOL_NAME, f"Please fill: {' or '.join(FIELD_LABELS[x][0] for x in req.split('|'))}")
                    return
            self.var_status.set(f"Running {r.smi} ...")
            self._start(self._do_run, [r], "single", None, self.var_sandbox.get().strip(), self.var_out.get().strip())

        def _run_batch(self):
            if not self._check_paths():
                return
            if not self.batch_rows:
                messagebox.showwarning(TOOL_NAME, "Load a request Excel (or add rows from 'Single check') first.")
                return
            filt = [k for k, v in self.smi_filter_vars.items() if v.get()]
            self.var_status.set(f"Running batch ({len(self.batch_rows)} rows) ...")
            self._start(self._do_run, list(self.batch_rows), "batch", filt, self.var_sandbox.get().strip(),
                        self.var_out.get().strip())

        def _do_run(self, rows, mode, filt, sb, out):
            # runs in the worker thread: never touch Tk objects here, only the queue
            if not self.engine.idx or os.path.abspath(sb) != self.engine.sandbox:
                st = self.engine.load(sb)
                self.q.put(("indexed", st))
            res = self.engine.run(rows, out, on_result=lambda r: self.q.put(("result", r)), smi_filter=filt)
            self.q.put(("run_done", res, mode))

        def _cancel(self):
            self.cancel.set()
            self.var_status.set("Stopping ...")

        # ------------------------------------------------------------ queue
        def _log(self, lvl, msg):
            ts = _dt.datetime.now().strftime("%H:%M:%S")
            self.txt_log.insert("end", f"{ts}  {lvl:<6}  {msg}\n", lvl if lvl in ("ERROR", "WARN", "FAIL", "PASS", "REVIEW") else "INFO")
            self.txt_log.see("end")

        def _poll(self):
            try:
                for _ in range(300):
                    msg = self.q.get_nowait()
                    kind = msg[0]
                    if kind == "log":
                        self._log(msg[1], msg[2])
                    elif kind == "progress":
                        d, t, m = msg[1:]
                        self.pb.configure(maximum=max(1, t), value=d)
                        self.var_status.set(m)
                    elif kind == "indexed":
                        st = msg[1]
                        self.var_index.set(f"{os.path.basename(self.engine.sandbox)}: {st.get('files', 0)} files, "
                                           f"{st.get('components', 0)} SWCs, {st.get('rte_functions', 0)} RTE functions")
                        self.var_status.set(f"Index ready ({st.get('seconds', 0)} s)")
                        self._fill_explorer()
                        self._smi_changed()
                    elif kind == "result":
                        self.results.append(msg[1])
                        self._refresh_results()
                    elif kind == "run_done":
                        res, mode = msg[1], msg[2]
                        self.last_run = res
                        self.var_status.set(f"Done in {res['seconds']:.1f} s - " +
                                            ", ".join(f"{k} {v}" for k, v in res["counts"].items()))
                        if mode == "single" and res["results"]:
                            self._show_single(res["results"][-1])
                        else:
                            self.nb.select(self.tab_results)
                    elif kind == "error":
                        self._log("ERROR", msg[1])
                        self._log("ERROR", msg[2])
                        messagebox.showerror(TOOL_NAME, msg[1])
                    elif kind == "idle":
                        self._busy(False)
            except queue.Empty:
                pass
            self.after(80, self._poll)

        def _show_single(self, res: AnalysisResult):
            self._single_res = res
            fg = "#%02x%02x%02x" % STATUS_RGB.get(res.status, (100, 100, 100))
            self.lbl_status.configure(text=res.status, fg=fg)
            self.lbl_summary.configure(text=f"{res.smi}  |  {res.row.who() or '-'}  |  {res.row.label()}\n{res.summary}")
            self._fill_checks(self.tv_s_checks, res)
            self.txt_s_ev.delete("1.0", "end")
            bad = [i for i, c in enumerate(res.checks) if c.status in (FAIL, ERROR, REVIEW)]
            first = str(bad[0] if bad else 0)
            if res.checks:
                self.tv_s_checks.selection_set(first)
                self.tv_s_checks.see(first)

        def _on_close(self):
            self._save_paths()
            self.cancel.set()
            self.destroy()


def launch_gui() -> int:
    if not HAVE_TK:
        print("tkinter is not available in this Python installation. Use the CLI (see --help).")
        return 2
    if sys.platform.startswith("win"):
        try:
            import ctypes
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except Exception:
            pass
    app = SmiApp()
    app.mainloop()
    return 0


