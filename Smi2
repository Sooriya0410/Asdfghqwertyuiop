#  Sandbox index
# =============================================================================
@dataclass
class FileRec:
    rel: str
    size: int
    mtime: int
    kind: str
    is_rte: bool = False
    nlines: int = 0


class SandboxIndex:
    """Parallel, incremental, cached index of a sandbox."""

    def __init__(self, root: str, settings: Settings, log: Callable[[str, str], None] = None,
                 progress: Callable[[int, int, str], None] = None, cancel: threading.Event = None):
        self.root = os.path.abspath(root)
        self.settings = settings
        self.log = log or (lambda lvl, msg: None)
        self.progress = progress or (lambda a, b, c: None)
        self.cancel = cancel or threading.Event()
        self.files: List[FileRec] = []
        self.fid_by_rel: Dict[str, int] = {}
        self.tokens: Dict[str, List[Tuple[int, int]]] = defaultdict(list)
        self.funcdefs: Dict[str, List[Tuple[int, int, int, str, str]]] = defaultdict(list)
        self.file_funcs: Dict[int, List[Tuple[int, int, str]]] = defaultdict(list)
        self.macros: Dict[str, List[Tuple[int, int, Optional[str], str]]] = defaultdict(list)
        self.typedefs: Dict[str, Dict[str, Any]] = {}
        self.rte_funcs: Dict[str, Dict[str, Any]] = {}
        self.rte_dups: Dict[str, int] = Counter()
        self.rte_globals: Dict[str, Tuple[int, int, str, str]] = {}
        self.rte_protos: Dict[str, List[Tuple[int, int, str, str]]] = defaultdict(list)
        self.includes: Dict[int, List[str]] = {}
        self.included_by: Dict[str, List[int]] = defaultdict(list)
        self.arxml_fids: List[int] = []
        self.dbc_fids: List[int] = []
        self.errors: List[str] = []
        self.stats: Dict[str, Any] = {}
        self._lines_cache: "OrderedDict[int, List[str]]" = OrderedDict()
        self._lock = threading.Lock()

    # ------------------------------------------------------------------ build
    def _walk(self) -> List[Tuple[str, int, int, str]]:
        excl = {x.strip().lower() for x in self.settings.excludes if x.strip()}
        pats = [x for x in excl if any(c in x for c in "*?[")]
        limit = self.settings.max_file_mb * 1024 * 1024
        out, stack = [], [self.root]
        while stack:
            if self.cancel.is_set():
                raise Cancelled()
            d = stack.pop()
            try:
                it = os.scandir(d)
            except OSError:
                continue
            with it:
                for e in it:
                    try:
                        if e.is_dir(follow_symlinks=False):
                            nl = e.name.lower()
                            if nl in excl or any(fnmatch.fnmatch(nl, p) for p in pats):
                                continue
                            stack.append(e.path)
                        elif e.is_file(follow_symlinks=False):
                            kind = EXT_KIND.get(os.path.splitext(e.name)[1].lower())
                            if kind:
                                st = e.stat()
                                if st.st_size <= limit or kind == "arxml":
                                    out.append((e.path, st.st_size, st.st_mtime_ns, kind))
                    except OSError:
                        continue
        out.sort(key=lambda x: x[0].lower())
        return out

    def _cache_file(self) -> str:
        h = hashlib.sha1(self.root.lower().encode("utf-8")).hexdigest()[:16]
        return os.path.join(cache_dir(), f"index_{h}.pkl")

    def build(self, force: bool = False) -> Dict[str, Any]:
        t0 = time.perf_counter()
        if not os.path.isdir(self.root):
            raise FileNotFoundError(f"Sandbox folder not found: {self.root}")
        self.log("INFO", f"Scanning sandbox {self.root}")
        entries = self._walk()
        self.log("INFO", f"Found {len(entries)} relevant files (.c/.h/.arxml/.dbc)")
        cached: Dict[str, Any] = {}
        cpath = self._cache_file()
        if self.settings.use_cache and not force and os.path.isfile(cpath):
            try:
                with open(cpath, "rb") as fh:
                    blob = pickle.load(fh)
                if blob.get("version") == CACHE_VERSION and blob.get("root") == self.root:
                    cached = blob.get("files", {})
            except Exception as exc:
                self.log("WARN", f"Index cache ignored ({exc})")
        records: Dict[str, Tuple[int, int, str, Optional[Dict]]] = {}
        todo = []
        for path, size, mtime, kind in entries:
            rel = os.path.relpath(path, self.root).replace("\\", "/")
            c = cached.get(rel)
            if c and c[0] == size and c[1] == mtime and c[2] == kind:
                records[rel] = c
            else:
                records[rel] = (size, mtime, kind, None)
                if kind in ("c", "h"):
                    todo.append((path, rel))
        reused = sum(1 for r in records.values() if r[3] is not None)
        self.log("INFO", f"Indexing {len(todo)} C/H files ({reused} reused from cache)")
        done = 0
        total = max(1, len(todo))
        results = []
        workers = int(self.settings.workers or 1)
        if todo and workers > 1 and len(todo) >= 60:
            try:
                chunk = max(4, len(todo) // (workers * 8))
                with ProcessPoolExecutor(max_workers=workers, mp_context=_mp_ctx()) as ex:
                    for rec in ex.map(_safe_index, todo, chunksize=chunk):
                        results.append(rec)
                        done += 1
                        if done % 25 == 0 or done == total:
                            self.progress(done, total, f"Indexing {done}/{total}")
                        if self.cancel.is_set():
                            ex.shutdown(cancel_futures=True)
                            raise Cancelled()
            except Cancelled:
                raise
            except Exception as exc:
                self.log("WARN", f"Parallel indexing failed ({exc}); falling back to sequential")
                results, done = [], 0
        if todo and not results:
            for item in todo:
                if self.cancel.is_set():
                    raise Cancelled()
                results.append(_safe_index(item))
                done += 1
                if done % 25 == 0 or done == total:
                    self.progress(done, total, f"Indexing {done}/{total}")
        for rec in results:
            size, mtime, kind, _ = records[rec["rel"]]
            if not rec.get("ok"):
                self.errors.append(f"{rec['rel']}: {rec.get('error')}")
            records[rec["rel"]] = (size, mtime, kind, rec)
        self._merge(records)
        if self.settings.use_cache:
            try:
                with open(cpath, "wb") as fh:
                    pickle.dump({"version": CACHE_VERSION, "root": self.root, "files": records}, fh,
                                protocol=pickle.HIGHEST_PROTOCOL)
            except Exception as exc:
                self.log("WARN", f"Could not write index cache ({exc})")
        dt = time.perf_counter() - t0
        kinds = Counter(f.kind for f in self.files)
        self.stats = {"files": len(self.files), "c": kinds.get("c", 0), "h": kinds.get("h", 0),
                      "arxml": kinds.get("arxml", 0), "dbc": kinds.get("dbc", 0),
                      "rte_files": sum(1 for f in self.files if f.is_rte),
                      "rte_functions": len(self.rte_funcs), "functions": sum(len(v) for v in self.funcdefs.values()),
                      "macros": len(self.macros), "typedefs": len(self.typedefs),
                      "reindexed": len(todo), "seconds": round(dt, 2), "errors": len(self.errors)}
        self.log("INFO", f"Index ready in {dt:.1f}s - {self.stats['rte_functions']} RTE functions, "
                         f"{self.stats['functions']} functions, {self.stats['macros']} macros")
        if self.rte_dups:
            self.log("WARN", f"{len(self.rte_dups)} RTE functions defined in more than one file "
                             f"(first one used) - check exclude folders, e.g. "
                             f"{', '.join(list(self.rte_dups)[:3])}")
        return self.stats

    def _merge(self, records: Dict[str, Tuple[int, int, str, Optional[Dict]]]):
        for rel in sorted(records, key=str.lower):
            size, mtime, kind, rec = records[rel]
            fid = len(self.files)
            fr = FileRec(rel, size, mtime, kind)
            self.files.append(fr)
            self.fid_by_rel[rel] = fid
            if kind == "arxml":
                self.arxml_fids.append(fid)
                continue
            if kind == "dbc":
                self.dbc_fids.append(fid)
                continue
            if not rec or not rec.get("ok"):
                continue
            fr.is_rte = rec.get("is_rte", False)
            fr.nlines = rec.get("nlines", 0)
            for tok, lines in rec["tokens"].items():
                lst = self.tokens[tok]
                lst.extend((fid, ln) for ln in lines)
            self.includes[fid] = rec["includes"]
            for inc in rec["includes"]:
                self.included_by[inc].append(fid)
            for name, start, end, header, params in rec["funcdefs"]:
                self.funcdefs[name].append((fid, start, end, header, params))
                self.file_funcs[fid].append((start, end, name))
            for name, line, params, body in rec["macros"]:
                self.macros[name].append((fid, line, params, body))
            for td in rec["typedefs"]:
                if td["name"] not in self.typedefs or fr.is_rte:
                    td = dict(td)
                    td["fid"] = fid
                    self.typedefs[td["name"]] = td
            for name, an in rec["rte_funcs"].items():
                if name in self.rte_funcs:
                    self.rte_dups[name] += 1
                    continue
                an = dict(an)
                an["fid"] = fid
                self.rte_funcs[name] = an
            for name, line, typ, arr in rec["globals"]:
                if name not in self.rte_globals or rel.lower().endswith(".c"):
                    self.rte_globals[name] = (fid, line, typ, arr)
            for name, line, ret, params in rec["protos"]:
                self.rte_protos[name].append((fid, line, ret, params))
        for fid in self.file_funcs:
            self.file_funcs[fid].sort()

    # ---------------------------------------------------------------- queries
    def abspath(self, fid: int) -> str:
        return os.path.join(self.root, self.files[fid].rel)

    def rel(self, fid: int) -> str:
        return self.files[fid].rel

    def basename(self, fid: int) -> str:
        return os.path.basename(self.files[fid].rel)

    def lines(self, fid: int) -> List[str]:
        with self._lock:
            if fid in self._lines_cache:
                self._lines_cache.move_to_end(fid)
                return self._lines_cache[fid]
        try:
            ls = read_text(self.abspath(fid)).split("\n")
        except Exception:
            ls = []
        with self._lock:
            self._lines_cache[fid] = ls
            if len(self._lines_cache) > 64:
                self._lines_cache.popitem(last=False)
        return ls

    def snippet(self, fid: int, start: int, end: int = 0, ctx: int = 4, max_lines: int = 60) -> List[Tuple[int, str]]:
        ls = self.lines(fid)
        end = end or start
        a = max(1, start - ctx)
        b = min(len(ls), end + ctx)
        if b - a + 1 > max_lines:
            b = a + max_lines - 1
        return [(i, ls[i - 1].rstrip("\r").expandtabs(4)[:240]) for i in range(a, b + 1)]

    def ev(self, fid: int, line: int, end: int = 0, title: str = "", hl: Sequence[int] = (),
           ctx: Optional[int] = None) -> Evidence:
        ctx = self.settings.context_lines if ctx is None else ctx
        hl = tuple(hl)
        if not hl:
            hl = tuple(range(line, (end or line) + 1)) if (end or line) - line < 3 else (line,)
        return Evidence(self.rel(fid), line, end or line, title, hl, self.abspath(fid),
                        self.snippet(fid, line, end or line, ctx))

    def token_hits(self, token: str, fids: Optional[Iterable[int]] = None) -> List[Tuple[int, int]]:
        hits = self.tokens.get(token, [])
        if fids is None:
            return list(hits)
        fs = set(fids)
        return [h for h in hits if h[0] in fs]

    def grep(self, pattern: str, fids: Iterable[int], flags: int = 0, limit: int = 200) -> List[Tuple[int, int, str]]:
        rx = re.compile(pattern, flags)
        out = []
        for fid in fids:
            for i, ln in enumerate(self.lines(fid), 1):
                if rx.search(ln):
                    out.append((fid, i, ln.strip()))
                    if len(out) >= limit:
                        return out
        return out

    def func_at(self, fid: int, line: int) -> Optional[Tuple[int, int, str]]:
        lst = self.file_funcs.get(fid, [])
        i = bisect.bisect_right(lst, (line, 10 ** 9, "")) - 1
        while i >= 0:
            s, e, n = lst[i]
            if s <= line <= e:
                return s, e, n
            if e < line:
                break
            i -= 1
        return None

    def nonrte_funcdef(self, name: str) -> Optional[Tuple[int, int, int, str, str]]:
        for d in self.funcdefs.get(name, []):
            if not self.files[d[0]].is_rte:
                return d
        return None

    def clean_segment(self, fid: int, start: int, end: int) -> List[str]:
        seg = "\n".join(self.lines(fid)[start - 1:end])
        return strip_c(seg).split("\n")


