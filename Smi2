class ExcelReporter:
    HFILL = "1F2937"

    def __init__(self, settings: Settings):
        self.s = settings
        self.thin = Side(style="thin", color="D0D7DE")
        self.border = Border(left=self.thin, right=self.thin, top=self.thin, bottom=self.thin)

    def _hdr(self, ws, row: int, headers: List[str], fill: str = None):
        for i, h in enumerate(headers, 1):
            c = ws.cell(row=row, column=i, value=h)
            c.font = Font(bold=True, color="FFFFFF")
            c.fill = PatternFill("solid", fgColor=fill or self.HFILL)
            c.alignment = Alignment(vertical="center", wrap_text=True)
            c.border = self.border

    def _status(self, cell, status):
        f, t = STATUS_COLORS.get(status, ("FFFFFF", "000000"))
        cell.fill = PatternFill("solid", fgColor=f)
        cell.font = Font(bold=True, color=t)
        cell.alignment = Alignment(horizontal="center", vertical="top")

    @staticmethod
    def _print_setup(wb):
        for ws in wb.worksheets:
            try:
                ws.page_setup.orientation = "landscape"
                ws.page_setup.paperSize = ws.PAPERSIZE_A4
                ws.sheet_properties.pageSetUpPr.fitToPage = True
                ws.page_setup.fitToWidth = 1
                ws.page_setup.fitToHeight = 0
                ws.print_options.gridLines = False
                ws.page_margins.left = ws.page_margins.right = 0.4
            except Exception:
                pass

    @staticmethod
    def _widths(ws, widths: Dict[int, int]):
        for col, w in widths.items():
            ws.column_dimensions[get_column_letter(col)].width = w

    @staticmethod
    def _rel(target: str, base_dir: str) -> str:
        try:
            return os.path.relpath(target, base_dir).replace("\\", "/")
        except ValueError:
            return target

    def _link(self, cell, target: str, base_dir: str, text: str = None):
        if not target:
            return
        cell.value = text or os.path.basename(target)
        cell.hyperlink = self._rel(target, base_dir)
        cell.font = Font(color="0563C1", underline="single")

    def write_smi(self, path: str, smi: str, results: List[AnalysisResult], meta: Dict[str, Any]):
        base = os.path.dirname(path)
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = "Summary"
        spec = SMI_SPECS.get(smi)
        ws["A1"] = f"{smi} - {spec.title if spec else ''}"
        ws["A1"].font = Font(bold=True, size=14)
        ws["A2"] = spec.requirement if spec else ""
        ws["A2"].alignment = Alignment(wrap_text=True)
        ws.merge_cells("A2:L2")
        ws.row_dimensions[2].height = 32
        cnt = Counter(r.status for r in results)
        ws["A3"] = "   ".join(f"{k}: {cnt.get(k, 0)}" for k in (PASS, FAIL, REVIEW, ERROR)) + f"   Total: {len(results)}"
        ws["A3"].font = Font(bold=True)
        hdr = ["ID", "Excel row", "Component", "RTE API / item", "Source", "Destination", "Status", "Pass", "Fail",
               "Review", "Summary", "Summary picture", "Diagram", "Duration [ms]", "Remarks", "Inputs"]
        self._hdr(ws, 5, hdr)
        for i, r in enumerate(results, 6):
            c = r.counts()
            vals = [r.row.row_id, r.row.excel_row or "", r.row.who(), r.row.label(), r.row.src_component,
                    r.row.dst_component, r.status, c.get(PASS, 0), c.get(FAIL, 0) + c.get(ERROR, 0), c.get(REVIEW, 0),
                    r.summary, "", "", round(r.duration_ms, 1), r.row.remarks, row_inputs_text(r.row, smi)]
            for j, v in enumerate(vals, 1):
                cell = ws.cell(row=i, column=j, value=xl_safe(v))
                cell.border = self.border
                cell.alignment = Alignment(vertical="top", wrap_text=j in (4, 11, 15, 16))
            self._status(ws.cell(row=i, column=7), r.status)
            pics = [p for p in r.pictures if p.endswith("_00_summary.png")]
            dgs = [p for p in r.pictures if "_D1_" in os.path.basename(p)]
            if pics:
                self._link(ws.cell(row=i, column=12), pics[0], base, "summary")
            if dgs:
                self._link(ws.cell(row=i, column=13), dgs[0], base, "diagram")
        ws.freeze_panes = "A6"
        ws.auto_filter.ref = f"A5:{get_column_letter(len(hdr))}{max(6, len(results) + 5)}"
        self._widths(ws, {1: 10, 2: 9, 3: 20, 4: 40, 5: 18, 6: 18, 7: 10, 8: 6, 9: 6, 10: 7, 11: 70, 12: 12, 13: 10,
                          14: 10, 15: 30, 16: 60})
        # Checks ------------------------------------------------------------
        wc = wb.create_sheet("Checks")
        hdr = ["ID", "Component", "RTE API / item", "#", "Check", "Status", "Expected", "Actual", "Note",
               "Evidence (file:line)", "Picture"]
        self._hdr(wc, 1, hdr)
        r_i = 2
        for r in results:
            for k, c in enumerate(r.checks, 1):
                vals = [r.row.row_id, r.row.who(), r.row.label(), k, c.name, c.status, c.expected, c.actual,
                        c.note, "\n".join(e.ref for e in c.evidence[:6]), ""]
                for j, v in enumerate(vals, 1):
                    cell = wc.cell(row=r_i, column=j, value=xl_safe(v))
                    cell.border = self.border
                    cell.alignment = Alignment(vertical="top", wrap_text=j in (5, 7, 8, 9, 10))
                self._status(wc.cell(row=r_i, column=6), c.status)
                if c.picture:
                    self._link(wc.cell(row=r_i, column=11), c.picture, base, "picture")
                r_i += 1
        wc.freeze_panes = "A2"
        wc.auto_filter.ref = f"A1:{get_column_letter(len(hdr))}{max(2, r_i - 1)}"
        self._widths(wc, {1: 10, 2: 18, 3: 34, 4: 4, 5: 36, 6: 10, 7: 34, 8: 50, 9: 50, 10: 40, 11: 10})
        # Evidence ------------------------------------------------------------
        we = wb.create_sheet("Evidence")
        self._hdr(we, 1, ["ID", "Check", "Title", "File", "Line", "Code snippet (>> = highlighted)"])
        r_i = 2
        for r in results:
            for c in r.checks:
                for e in c.evidence[:6]:
                    snip = "\n".join(f"{'>>' if n in (e.highlight or ()) else '  '} {n:5d}  {t}" for n, t in e.snippet[:40])
                    vals = [r.row.row_id, c.name, e.title, e.file, e.line, snip]
                    for j, v in enumerate(vals, 1):
                        cell = we.cell(row=r_i, column=j, value=xl_safe(v))
                        cell.alignment = Alignment(vertical="top", wrap_text=j == 6)
                        cell.border = self.border
                        if j == 6:
                            cell.font = Font(name="Consolas", size=9)
                    r_i += 1
        self._widths(we, {1: 10, 2: 30, 3: 34, 4: 46, 5: 7, 6: 120})
        we.freeze_panes = "A2"
        # Details --------------------------------------------------------------
        wd = wb.create_sheet("Details")
        r_i = 1
        for r in results:
            for t in r.details:
                cell = wd.cell(row=r_i, column=1, value=xl_safe(f"{r.row.row_id}  |  {r.row.label()}  |  {t['name']}"))
                cell.font = Font(bold=True, color="1F4E78", size=12)
                r_i += 1
                self._hdr(wd, r_i, t["headers"], "374151")
                r_i += 1
                for rowv in t["rows"]:
                    for j, v in enumerate(rowv, 1):
                        c = wd.cell(row=r_i, column=j, value=xl_safe(v))
                        c.border = self.border
                        c.alignment = Alignment(vertical="top", wrap_text=True)
                        if str(v) in ("DIFF",):
                            self._status(c, FAIL)
                        elif str(v) == "OK":
                            self._status(c, PASS)
                    r_i += 1
                r_i += 1
        for col in range(1, 30):
            wd.column_dimensions[get_column_letter(col)].width = 20
        # Gallery --------------------------------------------------------------
        if self.s.gallery and HAVE_PIL:
            wg = wb.create_sheet("Gallery")
            wg["A1"] = "Summary cards (click the Summary sheet links for full-size pictures)"
            wg["A1"].font = Font(bold=True)
            row_i = 3
            try:
                from openpyxl.drawing.image import Image as XLImage
                for r in results[:300]:
                    pics = [p for p in r.pictures if p.endswith("_00_summary.png")]
                    if not pics or not os.path.isfile(pics[0]):
                        continue
                    im = XLImage(pics[0])
                    scale = 0.55
                    im.width, im.height = int(im.width * scale), int(im.height * scale)
                    wg.add_image(im, f"A{row_i}")
                    row_i += int(im.height / 20) + 3
            except Exception as exc:
                wg["A2"] = f"Gallery not available: {exc}"
        # Info ------------------------------------------------------------------
        wi = wb.create_sheet("Info")
        info = [("Tool", f"{TOOL_NAME} {TOOL_VERSION}"), ("Generated", _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")),
                ("SMI", smi), ("Requirement", spec.requirement if spec else ""),
                ("Guidance", spec.guidance if spec else "")]
        info += [(k, v) for k, v in meta.items()]
        info += [("Status legend", "PASS = verified automatically; FAIL = violation found; REVIEW = manual judgement "
                                   "required; N/A = not applicable; INFO = information; ERROR = analysis error")]
        for i, (k, v) in enumerate(info, 1):
            wi.cell(row=i, column=1, value=k).font = Font(bold=True)
            c = wi.cell(row=i, column=2, value=xl_safe(v))
            c.alignment = Alignment(wrap_text=True, vertical="top")
        self._widths(wi, {1: 24, 2: 120})
        self._print_setup(wb)
        wb.save(path)
        return path

    def write_master(self, path: str, results: List[AnalysisResult], workbooks: Dict[str, str], meta: Dict[str, Any]):
        base = os.path.dirname(path)
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = "Dashboard"
        ws["A1"] = f"{TOOL_NAME} - MICROSAR Safe SMI verification report"
        ws["A1"].font = Font(bold=True, size=15)
        ws["A2"] = f"Generated {_dt.datetime.now():%Y-%m-%d %H:%M}   |   Sandbox: {meta.get('Sandbox', '')}"
        hdr = ["SMI", "Title", "Total", PASS, FAIL, REVIEW, ERROR, "Workbook"]
        self._hdr(ws, 4, hdr)
        by = defaultdict(list)
        for r in results:
            by[r.smi].append(r)
        row = 5
        for smi in list(SMI_SPECS) + sorted(k for k in by if k not in SMI_SPECS):
            lst = by.get(smi)
