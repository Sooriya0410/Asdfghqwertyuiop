_COMMENT_STR_RE = re.compile(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\'', re.S)


def strip_c(text: str) -> str:
    """Blank comments and string/char literals, keep offsets and newlines."""
    def repl(m):
        s = m.group(0)
        if s[0] == "/":
            return "\n".join(" " * len(p) for p in s.split("\n"))
        return s[0] + " " * (len(s) - 2) + s[-1] if len(s) >= 2 else s
    return _COMMENT_STR_RE.sub(repl, text)


def line_starts(text: str) -> List[int]:
    return [0] + [m.end() for m in re.finditer("\n", text)]


def lineno_at(ls: List[int], pos: int) -> int:
    return bisect.bisect_right(ls, pos)


def _func_header(clean: str, brace: int):
    i = brace - 1
    while i >= 0 and clean[i] in " \t\r\n":
        i -= 1
    if i < 0 or clean[i] != ")":
        return None
    d, j = 0, i
    lim = max(0, i - 4000)
    while j >= lim:
        ch = clean[j]
        if ch == ")":
            d += 1
        elif ch == "(":
            d -= 1
            if d == 0:
                break
        elif ch in ";{}":
            return None
        j -= 1
    if j < lim or d != 0:
        return None
    params = clean[j + 1:i]
    k = j - 1
    while k >= 0 and clean[k] in " \t\r\n":
        k -= 1
    e = k + 1
    while k >= 0 and (clean[k].isalnum() or clean[k] == "_"):
        k -= 1
    name = clean[k + 1:e]
    if not name or name in C_KEYWORDS or name[0].isdigit():
        return None
    hs = max(clean.rfind(";", 0, k + 1), clean.rfind("}", 0, k + 1), clean.rfind("{", 0, k + 1)) + 1
    # skip preprocessor lines at header start
    seg = clean[hs:k + 1]
    lines = seg.split("\n")
    off = hs
    for ln in lines:
        if ln.strip().startswith("#") or not ln.strip():
            off += len(ln) + 1
        else:
            break
    if name in ("TASK", "ISR", "ALARMCALLBACK"):
        name = f"{name}({params.strip()})"
    return name, k + 1, min(off, k + 1), params


def find_funcdefs(clean: str):
    """Yield (name, name_pos, header_start, body_open, body_close, params)."""
    out = []
    depth = 0
    cur = None
    for m in re.finditer(r"[{}]", clean):
        p = m.start()
        if clean[p] == "{":
            if depth == 0:
                cur = _func_header(clean, p)
                if cur:
                    cur = (cur[0], cur[1], cur[2], p, cur[3])
            depth += 1
        else:
            depth -= 1
            if depth < 0:
                depth, cur = 0, None
            elif depth == 0 and cur:
                out.append((cur[0], cur[1], cur[2], cur[3], p, cur[4]))
                cur = None
    return out


_DEFINE_RE = re.compile(r"^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)(\([^)]*\))?[ \t]*((?:\\\n|[^\n])*)", re.M)
_INCLUDE_LINE_RE = re.compile(r"^[ \t]*#[ \t]*include\b", re.M)
_INCLUDE_NAME_RE = re.compile(r'#\s*include\s*[<"]([^>"]+)[>"]')
_TYPEDEF_STRUCT_RE = re.compile(r"\btypedef\s+(struct|union)\s*(\w*)\s*\{([^{}]*)\}\s*(\w+)\s*;", re.S)
_TYPEDEF_ENUM_RE = re.compile(r"\btypedef\s+enum\s*\w*\s*\{[^{}]*\}\s*(\w+)\s*;", re.S)
_TYPEDEF_SIMPLE_RE = re.compile(
    r"\btypedef\s+((?:(?:unsigned|signed|const|volatile|long|short|struct|enum|union)\s+)*\w+)"
    r"\s+(\w+)\s*(?:\[\s*([^\]]+?)\s*\])?\s*;")
_MEMBER_RE = re.compile(r"^\s*((?:(?:const|volatile|unsigned|signed|struct|long|short)\s+)*\w+(?:\s*\*)*)\s+"
                        r"(\w+)\s*(?:\[\s*([^\]]+?)\s*\])?\s*(?::\s*(\d+))?\s*$")
_GLOBAL_VAR_RE = re.compile(
    r"^[ \t]*(?:extern[ \t]+|static[ \t]+)?(?:volatile[ \t]+)?"
    r"(?:(?:VAR|CONST)\s*\(\s*([^,()]+?)\s*,\s*\w+\s*\)|"
    r"(?:P2VAR|P2CONST|CONSTP2VAR|CONSTP2CONST)\s*\(\s*([^,()]+?)\s*,[^)]*\)|"
    r"((?:(?:const|volatile|unsigned|signed|struct)\s+)*[A-Za-z_]\w*))"
    r"\s+(?:volatile\s+)?(Rte_\w+)\s*(\[[^\]]*\])?\s*(?:=|;)", re.M)
_PROTO_RE = re.compile(
    r"(?:FUNC\s*\(\s*([^,()]+?)\s*,\s*\w+\s*\)|\b([A-Za-z_]\w*))\s+([A-Za-z_]\w*)\s*\(([^;{}()]*(?:\([^()]*\)[^;{}()]*)*)\)\s*;")
KEY_TOKEN_RE = re.compile(
    r"\b(?:Rte_|RTE_|Com_|ComXf_|DiagXf_|E2EXf_|E2E_|E2EPW_|LdCom_|Dcm_|ComConf_|SetRelAlarm|SetAbsAlarm|"
    r"ActivateTask|SetEvent|WaitEvent|CallTrustedFunction|Os_Call)\w*")
_IDENT_NOMEMBER_RE = re.compile(r"(?<![\w.])(?<!->)([A-Za-z_]\w*)")
_PATH_RE = re.compile(r"(?<![\w.])([A-Za-z_]\w*(?:\s*(?:\.|->)\s*[A-Za-z_]\w*|\s*\[[^\[\]]*\])+)")
_CALL_RE = re.compile(r"(?<![\w.])(?<!->)([A-Za-z_]\w*)\s*\(")
_NUM_LIT = r"(?:0[xX][0-9A-Fa-f]+|\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)[uUlLfF]*"
_CONV_MULDIV_RE = re.compile(r"(?:[\w\)\]]\s*[*/]\s*\(?\s*(?:\(\s*[A-Za-z_]\w*\s*\)\s*)?" + _NUM_LIT +
                             r"|" + _NUM_LIT + r"\s*[*/]\s*[\(A-Za-z_])")
_CONV_ADDSUB_RE = re.compile(r"[\w\)\]]\s*[+\-]\s*\(?\s*(?:\(\s*[A-Za-z_]\w*\s*\)\s*)?" + _NUM_LIT)
_FLOAT_LIT_RE = re.compile(r"(?<![\w.])\d+\.\d+(?:[eE][-+]?\d+)?[fF]?")


def parse_macros(clean: str, ls: List[int], name_filter: Optional[re.Pattern] = None):
    out = []
    for m in _DEFINE_RE.finditer(clean):
        name = m.group(1)
        if name_filter is not None and not name_filter.match(name):
            continue
        body = re.sub(r"\\\n", " ", m.group(3) or "")
        body = re.sub(r"\s+", " ", body).strip()
        out.append((name, lineno_at(ls, m.start(1)), (m.group(2) or None), body[:4000]))
    return out


def parse_typedefs(clean: str, ls: List[int]):
    out = []
    for m in _TYPEDEF_STRUCT_RE.finditer(clean):
        members = []
        for decl in m.group(3).split(";"):
            decl = re.sub(r"\s+", " ", decl).strip()
            if not decl:
                continue
            mm = _MEMBER_RE.match(decl)
            if mm:
                members.append({"type": mm.group(1).strip(), "name": mm.group(2),
                                "array": mm.group(3), "bitfield": int(mm.group(4)) if mm.group(4) else None})
        out.append({"name": m.group(4), "kind": m.group(1), "members": members,
                    "line": lineno_at(ls, m.start())})
    for m in _TYPEDEF_ENUM_RE.finditer(clean):
        out.append({"name": m.group(1), "kind": "enum", "line": lineno_at(ls, m.start())})
    for m in _TYPEDEF_SIMPLE_RE.finditer(clean):
        base = re.sub(r"\s+", " ", m.group(1)).strip()
        if base.split()[0] in ("struct", "union", "enum") and "{" in clean[m.start():m.end()]:
            continue
        out.append({"name": m.group(2), "kind": "alias", "base": base, "array": m.group(3),
                    "line": lineno_at(ls, m.start())})
    return out


def split_top(text: str, sep: str = ",") -> List[str]:
    parts, d, cur = [], 0, []
    for ch in text:
        if ch in "([{":
            d += 1
        elif ch in ")]}":
            d -= 1
        if ch == sep and d == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    parts.append("".join(cur))
    return parts


def call_args(text: str, open_pos: int) -> List[str]:
    d, i = 0, open_pos
    n = len(text)
    while i < n:
        ch = text[i]
        if ch == "(":
            d += 1
        elif ch == ")":
            d -= 1
            if d == 0:
                return [a.strip() for a in split_top(text[open_pos + 1:i])]
        i += 1
    return [a.strip() for a in split_top(text[open_pos + 1:])]


def strip_parens(expr: str) -> str:
    e = expr.strip()
    while e.startswith("(") and e.endswith(")"):
        d, ok = 0, True
        for i, ch in enumerate(e):
            if ch == "(":
                d += 1
            elif ch == ")":
                d -= 1
                if d == 0 and i != len(e) - 1:
                    ok = False
                    break
        if not ok:
            break
        e = e[1:-1].strip()
    return e


def strip_casts(expr: str) -> str:
    e = strip_parens(expr)
    prev = None
    while prev != e:
        prev = e
        e = re.sub(r"^\(\s*(?:(?:const|volatile|unsigned|signed|struct)\s+)*[A-Za-z_]\w*(?:\s*\*)*\s*\)\s*", "", e)
        e = re.sub(r"^\(\s*(?:P2VAR|P2CONST|CONSTP2VAR|CONSTP2CONST)\s*\([^()]*\)\s*\)\s*", "", e)
        e = e.lstrip("&* ")
        e = strip_parens(e)
    return e


def base_ident(expr: str) -> str:
    e = strip_casts(expr)
    m = re.match(r"\s*([A-Za-z_]\w*)", e)
    return m.group(1) if m else ""


def lhs_target(lhs: str) -> Tuple[str, str]:
    """Return (base identifier, full normalized path) of an assignment target."""
    s = re.sub(r"^[\s\*\(]+|[\s\)]+$", "", lhs)
    m = re.search(r"([A-Za-z_]\w*(?:\s*(?:\.|->)\s*[A-Za-z_]\w*|\s*\[[^\[\]]*\])*)\s*$", s)
    if not m:
        return "", ""
    full = re.sub(r"\s+", "", m.group(1))
    base = re.match(r"[A-Za-z_]\w*", full).group(0)
    return base, full


def _assignment_split(stmt: str):
    d = 0
    n = len(stmt)
    for i, ch in enumerate(stmt):
        if ch in "([":
            d += 1
        elif ch in ")]":
            d -= 1
        elif ch == "=" and d == 0:
            prev = stmt[i - 1] if i > 0 else ""
            nxt = stmt[i + 1] if i + 1 < n else ""
            if nxt == "=" or prev in "=!":
                continue
            if prev in "<>":
                if i >= 2 and stmt[i - 2] == prev:   # <<= / >>=
                    return stmt[:i - 2], stmt[i + 1:]
                continue
            if prev in "+-*/%&|^":
                return stmt[:i - 1], stmt[i + 1:]
            return stmt[:i], stmt[i + 1:]
    return None


def _expand_expr(stmt: str) -> List[str]:
    """Strip outer parens and split comma-expressions (macro bodies)."""
    s = strip_parens(stmt)
    parts = split_top(s, ",")
    if len(parts) > 1:
        out = []
        for p in parts:
            out.extend(_expand_expr(p))
        return out
    return [s]


def analyze_code(body: str, base_line: int = 1) -> Dict[str, Any]:
    """Data-flow summary of a function body / macro expression (comments already stripped)."""
    ls = line_starts(body)

    def ln(pos):
        return base_line + lineno_at(ls, pos) - 1

    res = {"calls": [], "writes": [], "reads": [], "assigns": [], "com": [], "xf": [],
           "os": [], "conv": [], "paths": []}
    lhs_count: Counter = Counter()
    for m in _CALL_RE.finditer(body):
        name = m.group(1)
        if name in C_KEYWORDS or name in AUTOSAR_MACROS:
            continue
        line = ln(m.start())
        res["calls"].append((name, line))
        if name.startswith(("Com_", "LdCom_")):
            args = call_args(body, m.end() - 1)
            res["com"].append((name, base_ident(args[0]) if args else "", line))
        elif name.startswith(XF_PREFIXES):
            res["xf"].append((name, line))
        elif name in OS_FUNCS:
            args = call_args(body, m.end() - 1)
            res["os"].append((name, [re.sub(r"\s+", " ", a) for a in args], line))
        if name in MEMCPY_FUNCS:
            args = call_args(body, m.end() - 1)
            if len(args) >= 2:
                db, dfull = base_ident(args[0]), re.sub(r"\s+", "", strip_casts(args[0]))
                sb = base_ident(args[1])
                if db:
                    res["writes"].append((db, line))
                    res["assigns"].append((dfull, db, [sb] if sb else [], line))
                    lhs_count[db] += 1
    # statements
    for stmt_m in re.finditer(r"[^;{}]+", body):
        stmt = stmt_m.group(0)
        if "=" not in stmt:
            continue
        for sub in _expand_expr(stmt):
            sp = _assignment_split(sub)
            if not sp:
                continue
            lhs, rhs = sp
            base, full = lhs_target(lhs)
            if not base:
                continue
            off = stmt_m.start() + max(0, stmt.find(sub[:20]) if sub[:20] else 0)
            line = ln(off)
            rhs_ids = [x for x in _IDENT_NOMEMBER_RE.findall(rhs) if x not in C_KEYWORDS]
            res["writes"].append((base, line))
            res["assigns"].append((full, base, rhs_ids, line))
            lhs_count[base] += 1
            # data conversion hints
            rhs_ni = re.sub(r"\[[^\[\]]*\]", "", rhs)
            rhs_ni = re.sub(r"\bsizeof\s*\([^()]*\)", "0", rhs_ni)
            hint = None
            if _CONV_MULDIV_RE.search(rhs_ni) or _FLOAT_LIT_RE.search(rhs_ni):
                hint = "scaling (*,/ or float literal)"
            elif _CONV_ADDSUB_RE.search(rhs_ni) and base not in rhs_ids and re.search(r"[A-Za-z_]", rhs_ni):
                hint = "offset (+/- constant)"
            if hint:
                res["conv"].append((hint, re.sub(r"\s+", " ", sub.strip())[:200], line))
    idents = Counter(x for x in _IDENT_NOMEMBER_RE.findall(re.sub(r"[A-Za-z_]\w*\s*\(", "(", body))
                     if x not in C_KEYWORDS)
    for name, cnt in idents.items():
        if cnt > lhs_count.get(name, 0):
            res["reads"].append(name)
    res["writes"] = sorted({w for w in res["writes"]}, key=lambda x: x[1])
    res["paths"] = sorted({re.sub(r"\s+", "", p) for p in _PATH_RE.findall(body)})
    return res


def block_context(lines: List[str], target_idx: int) -> List[str]:
    """Enclosing block headers ('if (...)', 'for(;;)') of line target_idx (0-based).

    `lines` must start with the function header line; the function header itself is
    not part of the returned list.
    """
    stack: List[str] = []
    pending: List[str] = []
    pdepth = 0
    for ch in "\n".join(lines[:target_idx]):
        if ch == "(":
            pdepth += 1
            pending.append(ch)
        elif ch == ")":
            pdepth -= 1
            pending.append(ch)
        elif ch == "{" and pdepth <= 0:
            stack.append(re.sub(r"\s+", " ", "".join(pending)).strip())
            pending, pdepth = [], 0
        elif ch == "}" and pdepth <= 0:
            if stack:
                stack.pop()
            pending, pdepth = [], 0
        elif ch == ";" and pdepth <= 0:
            pending = []
        else:
            pending.append(ch)
    hdr = re.sub(r"\s+", " ", "".join(pending)).strip()
    if re.match(r"^(if|else\s+if|else|while|for)\b", hdr):
        stack.append(hdr)
    tl = lines[target_idx].strip() if target_idx < len(lines) else ""
    m = re.match(r"^((?:else\s+)?if|while)\s*\(", tl)
    if m and "{" not in tl:
        depth, j = 0, tl.index("(")
        for k in range(j, len(tl)):
            if tl[k] == "(":
                depth += 1
            elif tl[k] == ")":
                depth -= 1
                if depth == 0:
                    stack.append(tl[:k + 1])
                    break
    return [h for h in stack[1:] if h]


def parse_params(params: str) -> List[Dict[str, Any]]:
    p = params.strip()
    if not p or p == "void":
        return []
    out = []
    for part in split_top(p):
        part = part.strip()
        if not part or part == "void" or part == "...":
            continue
        ptr, const = False, False
        m = re.match(r"(CONSTP2VAR|CONSTP2CONST|P2VAR|P2CONST)\s*\(\s*([^,()]+?)\s*,[^)]*\)\s*(\w+)?\s*$", part)
        if m:
            ptr = True
            const = "CONST" in m.group(1).replace("CONSTP2VAR", "P2VAR")
            typ, name = m.group(2).strip(), m.group(3) or ""
        else:
            m = re.match(r"VAR\s*\(\s*([^,()]+?)\s*,[^)]*\)\s*(\w+)?\s*$", part)
            if m:
                typ, name = m.group(1).strip(), m.group(2) or ""
            else:
                const = bool(re.search(r"\bconst\b", part))
                ptr = "*" in part
                q = re.sub(r"\b(const|volatile)\b", "", part).replace("*", " ")
                q = re.sub(r"\[[^\]]*\]", "", q)
                toks = q.split()
                if len(toks) >= 2:
                    typ, name = " ".join(toks[:-1]), toks[-1]
                else:
                    typ, name = (toks[0] if toks else ""), ""
                if "[" in part:
                    ptr = True
        out.append({"type": typ, "name": name, "ptr": ptr, "const": const, "raw": part})
    return out


