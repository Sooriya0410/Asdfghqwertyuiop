WRITE_KINDS = {"Write", "IWrite", "IWriteRef", "Send", "Invalidate", "IInvalidate", "Switch", "IrvWrite", "IrvIWrite"}
READ_KINDS = {"Read", "IRead", "Receive", "DRead", "Mode", "IStatus", "IsUpdated", "IrvRead", "IrvIRead"}
IMPLICIT_KINDS = {"IRead", "IWrite", "IWriteRef", "IStatus", "IInvalidate", "IrvIRead", "IrvIWrite"}
INIT_FUNC_RE = re.compile(r"^(?:Rte_Init\w*|Rte_\w*InitMemory\w*|Rte_Start\w*|Rte_Stop\w*|Rte_MemClr\w*|"
                          r"Rte_\w*_Init|Rte_InitState\w*)$")
NON_COMP_HEADERS = {"Type", "Cfg", "Main", "Hook", "Cbk", "DataHandleType", "Intern", "UserTypes", "MemMap",
                    "Compiler_Cfg", "Rtm", "Calprm", "Lcfg", "PBCfg", "Rte", "Rtm_Cfg", "Hook_Cfg", "Vfb", "Ioc",
                    "Os_Cfg", "Hdr", "Callout", "Version"}


def api_kind(api: str) -> str:
