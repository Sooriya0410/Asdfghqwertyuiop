                continue
            cnt = Counter(r.status for r in lst)
            vals = [smi, SMI_SPECS[smi].title if smi in SMI_SPECS else "Unknown SMI type (see All results)", len(lst), cnt.get(PASS, 0), cnt.get(FAIL, 0),
                    cnt.get(REVIEW, 0), cnt.get(ERROR, 0), ""]
            for j, v in enumerate(vals, 1):
                c = ws.cell(row=row, column=j, value=xl_safe(v))
                c.border = self.border
            for j, st in ((4, PASS), (5, FAIL), (6, REVIEW), (7, ERROR)):
                if vals[j - 1]:
                    self._status(ws.cell(row=row, column=j), st)
            if smi in workbooks:
                self._link(ws.cell(row=row, column=8), workbooks[smi], base)
            row += 1
        tot = Counter(r.status for r in results)
        ws.cell(row=row, column=1, value="TOTAL").font = Font(bold=True)
        for j, st in ((3, None), (4, PASS), (5, FAIL), (6, REVIEW), (7, ERROR)):
            ws.cell(row=row, column=j, value=len(results) if st is None else tot.get(st, 0)).font = Font(bold=True)
        self._widths(ws, {1: 14, 2: 64, 3: 8, 4: 8, 5: 8, 6: 9, 7: 8, 8: 46})
        wa = wb.create_sheet("All results")
        hdr = ["SMI", "ID", "Excel row", "Component", "RTE API / item", "Status", "Summary", "Summary picture"]
        self._hdr(wa, 1, hdr)
        for i, r in enumerate(results, 2):
            vals = [r.smi or r.row.smi_raw, r.row.row_id, r.row.excel_row or "", r.row.who(), r.row.label(),
                    r.status, r.summary, ""]
            for j, v in enumerate(vals, 1):
                c = wa.cell(row=i, column=j, value=xl_safe(v))
                c.border = self.border
                c.alignment = Alignment(vertical="top", wrap_text=j in (5, 7))
            self._status(wa.cell(row=i, column=6), r.status)
            pics = [p for p in r.pictures if p.endswith("_00_summary.png")]
            if pics:
                self._link(wa.cell(row=i, column=8), pics[0], base, "summary")
        wa.freeze_panes = "A2"
        wa.auto_filter.ref = f"A1:H{max(2, len(results) + 1)}"
        self._widths(wa, {1: 13, 2: 10, 3: 9, 4: 20, 5: 42, 6: 10, 7: 80, 8: 12})
        wi = wb.create_sheet("Info")
        for i, (k, v) in enumerate(meta.items(), 1):
            wi.cell(row=i, column=1, value=k).font = Font(bold=True)
            wi.cell(row=i, column=2, value=xl_safe(v)).alignment = Alignment(wrap_text=True)
        self._widths(wi, {1: 24, 2: 110})
        self._print_setup(wb)
        wb.save(path)
        return path


