def norm_header(h: Any) -> str:
    return re.sub(r"[^a-z0-9]", "", str(h or "").lower())


def normalize_smi(text: str, api: str = "") -> str:
    """Map any user spelling of an SMI to a catalog key ('' if unknown)."""
    t = str(text or "").strip().lower()
    t = t.replace("–", "-").replace("—", "-").replace("−", "-")
    if not t:
        return ""
    compact = re.sub(r"[\s_\-/.()]", "", t)
    if "105506" in compact:
        return "SMI-105506"
    if "62933" in compact:
        return "SMI-62933"
    if "2123" in compact:
        return "SMI-2123"
    if "2063" in compact:
        return "SMI-2063"
    if "2065" in compact:
        return "SMI-2065"
    if "324" in compact:
        if any(k in compact for k in ("client", "server", "324cs", "cs324", "c/s")):
            return "SMI-324_CS"
        if any(k in compact for k in ("nonqueued", "notqueued", "nq", "nonqueue", "unqueued", "sr", "sender",
                                      "queued", "receiver")):
            return "SMI-324_NQ"
        return "SMI-324_CS" if re.match(r"\s*Rte_(Call|Result)_", api or "") else "SMI-324_NQ"
    if "1055" in compact or "1052" in compact or "rtemode" in compact:
        return "SMI-1055"
    for k in SMI_SPECS:
        if norm_header(k) == norm_header(t):
            return k
    return ""


