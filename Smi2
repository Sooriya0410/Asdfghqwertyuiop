DEFAULT_EXCLUDES = [".git", ".svn", ".hg", "__pycache__", ".vs", ".vscode", ".idea", "node_modules",
                    ".smi_cache", "$recycle.bin"]
EXT_KIND = {".c": "c", ".h": "h", ".arxml": "arxml", ".dbc": "dbc"}


@dataclass
class Settings:
    strict: bool = True                 # deviations from Vector recommendations -> FAIL
    pass_when_consistent: bool = False  # no expectation given but code == config -> PASS
    context_lines: int = 6
    max_pictures_per_check: int = 2
    pictures: bool = True
    workers: int = max(1, min(8, (os.cpu_count() or 2) - 1))
    use_arxml: bool = True
    use_dbc: bool = True
    use_cache: bool = True
    gallery: bool = True
    timestamped: bool = True
    excludes: List[str] = field(default_factory=lambda: list(DEFAULT_EXCLUDES))
    max_file_mb: int = 120

    @staticmethod
    def path() -> str:
        base = os.environ.get("LOCALAPPDATA") or os.path.join(os.path.expanduser("~"), ".config")
        return os.path.join(base, "SMI_Analyzer", "settings.json")

    @classmethod
    def load(cls) -> "Settings":
        s = cls()
        try:
            with open(cls.path(), "r", encoding="utf-8") as fh:
                d = json.load(fh)
            for k, v in d.items():
                if hasattr(s, k):
                    setattr(s, k, v)
        except Exception:
            pass
        return s

    def save(self, extra: Optional[Dict[str, Any]] = None):
        try:
            os.makedirs(os.path.dirname(self.path()), exist_ok=True)
            d = {k: getattr(self, k) for k in self.__dataclass_fields__}
            if extra:
                d.update(extra)
            with open(self.path(), "w", encoding="utf-8") as fh:
                json.dump(d, fh, indent=2)
        except Exception:
            pass

    @staticmethod
    def extra() -> Dict[str, Any]:
        try:
            with open(Settings.path(), "r", encoding="utf-8") as fh:
                return json.load(fh)
        except Exception:
            return {}


def cache_dir() -> str:
    base = os.environ.get("LOCALAPPDATA") or os.path.join(os.path.expanduser("~"), ".cache")
    d = os.path.join(base, "SMI_Analyzer", "cache")
    os.makedirs(d, exist_ok=True)
    return d


class Cancelled(Exception):
    pass


def _mp_ctx():
    """'spawn' everywhere: safe from GUI threads (no fork of a Tk process) and identical to Windows."""
    return multiprocessing.get_context("spawn")


