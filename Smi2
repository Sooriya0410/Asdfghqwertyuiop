    ws.freeze_panes = "C2"
    # which column is used by which SMI
    wm = wb.create_sheet("Columns_per_SMI")
    allc = TEMPLATE_COLUMNS[2:-1] + OPTIONAL_COLUMNS
    rep._hdr(wm, 1, ["SMI_Type", "Folder"] + [c for c, _ in allc])
    for i, (k, sp) in enumerate(SMI_SPECS.items(), 2):
        wm.cell(row=i, column=1, value=k).font = Font(bold=True)
        wm.cell(row=i, column=2, value=sp.folder)
        for j, (c, f) in enumerate(allc, 3):
            req = any(f in r.split("|") for r in sp.required)
            mark = "REQUIRED" if req else ("input" if f in sp.fields else ("optional" if f in sp.optional else ""))
            cell = wm.cell(row=i, column=j, value=mark)
            cell.alignment = Alignment(horizontal="center")
            if mark == "REQUIRED":
                rep._status(cell, FAIL)
            elif mark == "input":
                rep._status(cell, PASS)
            elif mark == "optional":
                rep._status(cell, NA)
    wm.column_dimensions["A"].width = 14
    wm.column_dimensions["B"].width = 24
    for j in range(3, len(allc) + 3):
        wm.column_dimensions[get_column_letter(j)].width = 15
    wm.freeze_panes = "C2"
    note_r = len(SMI_SPECS) + 4
    for k, n in enumerate([
            "REQUIRED / input = the data you give for this SMI.  optional = extra expectation column you MAY add to the "
            "request sheet (header exactly as shown) to turn REVIEW into PASS/FAIL.",
            "SMI_Type: any spelling works (SMI-2123, 2123, 324-client-server, 324 not queued, 2063-entities, "
            "2065-external, 62933, 105506, 1055).",
            "Alternative layout: one sheet per SMI named after the SMI (e.g. 'SMI-2063') - then no SMI_Type column is "
            "needed.",
            "SMI-2123: Component may contain several SWCs (comma separated); RTE_API may also be an RTE variable "
            "(e.g. Rte_CtApSpeed_PpSpeed_DeSpeed).",
            "SMI-324_Client_Server: Call_Function_or_Variable = the server runnable / BSW function / RTE variable "
            "the Rte_Call must reach."], note_r):
        wm.cell(row=k, column=1, value=f"- {n}")
    wh = wb.create_sheet("Help")
    rep._hdr(wh, 1, ["SMI_Type", "Requirement", "What the tool checks"])
    for i, (k, sp) in enumerate(SMI_SPECS.items(), 2):
        for j, v in enumerate([f"{k}\n(folder {sp.folder})", sp.requirement, sp.guidance], 1):
            c = wh.cell(row=i, column=j, value=v)
            c.alignment = Alignment(wrap_text=True, vertical="top")
    rep._widths(wh, {1: 26, 2: 60, 3: 110})
    rep._print_setup(wb)
    wb.save(path)
    return path


