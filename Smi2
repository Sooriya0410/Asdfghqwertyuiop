        def _comp_selected(self):
            sel = self.tv_comp.selection()
            ctx = self.engine.ctx
            self.tv_api.delete(*self.tv_api.get_children())
            if not sel or not ctx:
                return
            comp = sel[0]
            for a in ctx.rte.comp_apis(comp):
                R = ctx.rte.resolve(comp, a)
                impl = R.direct_target and f"direct -> {R.direct_target}()" or R.func.replace("macro:", "#define ")
                loc = R.chain[-1].ref if R.chain else ""
                self.tv_api.insert("", "end", values=(api_kind(a), a, impl, loc))
            for rn, (fid, line) in sorted(ctx.rte.runnables.get(comp, {}).items()):
                d = self.engine.idx.nonrte_funcdef(rn)
                self.tv_api.insert("", "end", values=("Runnable", rn, f"{len(ctx.rte.call_sites(rn))} RTE call site(s)",
                                                      f"{self.engine.idx.rel(d[0])}:{d[1]}" if d else ""))

        def _api_to_single(self):
            sel = self.tv_api.selection()
            csel = self.tv_comp.selection()
            ctx = self.engine.ctx
            if not sel or not csel or not ctx:
                return
            kind, name = self.tv_api.item(sel[0], "values")[:2]
            comp = csel[0]
            rte = ctx.rte
            for v in self.field_vars.values():
                v.set("")
            fill: Dict[str, str] = {}
            if kind == "Runnable":
                target = "SMI-2063"
                called = [f[5:-1].strip() for f, _ in rte.call_sites(name) if f.startswith("TASK(")]
                fill = {"runnable": name, "task": called[0] if called else ""}
            else:
                R = rte.resolve(comp, name)
                an = rte.funcs.get(R.func, {})
                if kind in ("Call", "Result"):
                    T = rte.server_targets(R)
                    target, fill = "SMI-324_CS", {"src_component": comp, "api": name,
                                                  "call_target": (T["servers"] or [""])[0]}
                elif kind == "Mode":
                    target, fill = "SMI-1055", {"component": comp, "api": name}
                elif an.get("com") or any(x.startswith("ComXf_") for x, _ in an.get("xf", [])):
                    target = "SMI-62933" if any(x.startswith("ComXf_") for x, _ in an.get("xf", [])) else "SMI-2065"
                    fill = {"component": comp, "api": name}
                elif kind in WRITE_KINDS or kind in READ_KINDS:
                    target = "SMI-324_NQ"
                    P = rte.sr_partners(R)
                    if kind in WRITE_KINDS:
                        p = next((x for x in P["receivers"] if x.func != R.func and x.comp in rte.components), None)
                        fill = {"src_component": comp, "src_api": name,
                                "dst_component": p.comp if p else "", "dst_api": p.api if p else ""}
                    else:
                        p = next((x for x in P["senders"] if x.func != R.func and x.comp in rte.components), None)
                        fill = {"dst_component": comp, "dst_api": name,
                                "src_component": p.comp if p else "", "src_api": p.api if p else ""}
                else:
                    target, fill = "SMI-2123", {"component": comp, "api": name}
            self.cb_smi.current(list(SMI_SPECS).index(target))
            self._smi_changed()
            for k, val in fill.items():
                self.field_vars[k].set(val)
            self.field_vars["safety"].set("Yes")
            self._refresh_choices()
            self.nb.select(self.tab_single)

        def _sym_search(self):
            idx = self.engine.idx
            self.tv_sym.delete(*self.tv_sym.get_children())
            q = self.var_sym.get().strip()
            if not idx or not q:
                return
            hits = []
            for tok, lst in idx.tokens.items():
                if q.lower() in tok.lower():
                    hits.extend(lst[:50])
                if len(hits) > 400:
                    break
            for name, defs in idx.funcdefs.items():
                if q.lower() in name.lower():
                    hits.extend((d[0], d[1]) for d in defs[:5])
                if len(hits) > 600:
                    break
            for fid, line in sorted(set(hits))[:600]:
                ls = idx.lines(fid)
                self.tv_sym.insert("", "end", values=(idx.rel(fid), line, ls[line - 1].strip()[:200] if line <= len(ls) else ""))

        def _sym_open(self):
            sel = self.tv_sym.selection()
            if sel and self.engine.idx:
                open_path(os.path.join(self.engine.idx.root, self.tv_sym.item(sel[0], "values")[0]))

