def row_inputs_text(r: RowInput, smi: str = "") -> str:
    spec = SMI_SPECS.get(smi or r.smi)
    flds = list(spec.fields) + [f for f in spec.optional if f not in spec.fields] if spec else list(FIELD_LABELS)
    return "; ".join(f"{FIELD_LABELS[f][0]}={getattr(r, f)}" for f in flds if f in FIELD_LABELS and getattr(r, f, ""))


