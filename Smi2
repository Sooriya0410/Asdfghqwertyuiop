def type_info(name: str, typedefs: Optional[Dict[str, Dict]] = None, depth: int = 0) -> Dict[str, Any]:
    """Resolve a C type name (typedef chain) -> dict(base, bits, signed, float, struct, members, array)."""
    n = re.sub(r"\b(const|volatile|struct|enum|union)\b", "", str(name or "")).replace("*", "").strip()
    n = re.sub(r"\s+", " ", n)
    info = {"name": name, "base": n, "bits": None, "signed": None, "float": False,
            "struct": False, "members": [], "array": None}
    if not n:
        return info
    if n in PLATFORM_TYPES:
        b, s, f = PLATFORM_TYPES[n]
        info.update(bits=b, signed=s, float=f)
        return info
    td = (typedefs or {}).get(n)
    if td and depth < 12:
        if td.get("kind") in ("struct", "union"):
            info.update(struct=True, members=td.get("members", []))
            return info
        if td.get("kind") == "enum":
            info.update(bits=8, signed=False, base="enum")
            return info
        sub = type_info(td.get("base", ""), typedefs, depth + 1)
        sub["name"] = name
        if td.get("array"):
            sub["array"] = td["array"]
        return sub
    return info


def type_desc(ti: Dict[str, Any]) -> str:
    if ti.get("struct"):
        return f"{ti['name']} (record, {len(ti['members'])} elements)"
    if ti.get("bits"):
        kind = "float" if ti["float"] else ("signed" if ti["signed"] else "unsigned")
        arr = f"[{ti['array']}]" if ti.get("array") else ""
        nm = ti["name"] if ti["name"] == ti["base"] else f"{ti['name']} -> {ti['base']}"
        return f"{nm}{arr} ({ti['bits']} bit {kind})"
    return str(ti.get("name") or "?")


