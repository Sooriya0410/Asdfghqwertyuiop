    # ------------------------------------------------------------ diagrams
    def _box(self, d, x, y, w, h, label, fill, outline, bold=False):
        d.rounded_rectangle([x, y, x + w, y + h], radius=10, fill=fill, outline=outline, width=3 if bold else 2)
        parts = str(label).split("\n")[:3]
        th = self._h(self.sans) + 4
        yy = y + (h - th * len(parts)) / 2
        for i, p in enumerate(parts):
            f = self.sans_b if i == 0 else self.sans_s
            t = self._clip(p, f, w - 16)
            d.text((x + (w - self._w(t, f)) / 2, yy), t, font=f, fill=(25, 25, 25))
            yy += th

    def _arrow(self, d, x1, y1, x2, y2, col=(90, 90, 90)):
        d.line([x1, y1, x2, y2], fill=col, width=3)
        ang = math.atan2(y2 - y1, x2 - x1)
        for s in (-0.45, 0.45):
            d.line([x2, y2, x2 - 14 * math.cos(ang + s), y2 - 14 * math.sin(ang + s)], fill=col, width=3)

    def connection(self, dg: Dict[str, Any], path: str, status: str):
        L, R = dg.get("left") or ["?"], dg.get("right") or ["?"]
        bw, bh, gap = 330, 70, 22
        n = max(len(L), len(R), 1)
        W, H = 1280, max(300, 120 + n * (bh + gap) + 40)
        img = Image.new("RGB", (W, H), "white")
        d = ImageDraw.Draw(img)
        d.rectangle([0, 0, W, 56], fill=(31, 41, 55))
        d.text((18, 14), self._clip(dg.get("title", ""), self.title, W - 180), font=self.title, fill="white")
        self._pill(d, W - 120, 15, status)
        hlv = dg.get("highlight") or []
        hls = {h.lower() for h in ([hlv] if isinstance(hlv, str) else hlv) if h}
        cx, cy = (W - bw) // 2, 80 + (n * (bh + gap)) // 2 - bh // 2
        self._box(d, cx, cy, bw, bh + 10, dg.get("center") or "RTE", (233, 240, 252), (52, 120, 200), True)

        def col(lbl):
            first = str(lbl).split("\n")[0].lower()
            if first.startswith("<"):
                return (245, 245, 245), (150, 150, 150)
            return ((220, 236, 255), (31, 119, 180)) if first in hls else ((255, 250, 235), (200, 150, 40))

        def column(items, x, right_side):
            tot = len(items) * (bh + gap) - gap
            y0 = cy + (bh + 10) / 2 - tot / 2
            for i, lbl in enumerate(items):
                y = y0 + i * (bh + gap)
                f, o = col(lbl)
                self._box(d, x, y, bw, bh, lbl, f, o, bold=(f[0] == 220))
                if right_side:
                    self._arrow(d, cx + bw, cy + (bh + 10) / 2, x - 4, y + bh / 2)
                else:
                    self._arrow(d, x + bw + 4, y + bh / 2, cx - 4, cy + (bh + 10) / 2)
        column(L, 40, False)
        column(R, W - bw - 40, True)
        d.text((40, H - 28), "Source / sender / client / manager", font=self.sans_s, fill=(110, 110, 110))
        t = "Destination / receiver / server / user"
        d.text((W - 40 - self._w(t, self.sans_s), H - 28), t, font=self.sans_s, fill=(110, 110, 110))
        self._save(img, path)
        return path

    def bits(self, dg: Dict[str, Any], path: str, status: str):
        els = [e for e in dg.get("elements", []) if e.get("bits")]
        if not els:
            return None
        maxbit = max(max(e["bits"]) for e in els)
        nbytes = max(dg.get("length") or 0, maxbit // 8 + 1)
        nbytes = min(nbytes, 64)
        cw, ch = 74, 34
        gx, gy = 110, 100
        legend_h = 28 * len(els) + 20
        W = max(gx + 8 * cw + 40, 1000)
        H = gy + nbytes * ch + 40 + legend_h
        img = Image.new("RGB", (W, H), "white")
        d = ImageDraw.Draw(img)
        d.rectangle([0, 0, W, 56], fill=(31, 41, 55))
        d.text((18, 14), self._clip(dg.get("title", "Layout"), self.title, W - 180), font=self.title, fill="white")
        self._pill(d, W - 120, 15, status)
        for b in range(8):
            t = f"bit {7 - b}"
            d.text((gx + b * cw + (cw - self._w(t, self.sans_s)) / 2, gy - 24), t, font=self.sans_s, fill=(90, 90, 90))
        owner = {}
        for i, e in enumerate(els):
            for k, bit in enumerate(sorted(e["bits"])):
                owner[int(bit)] = (i, k)
        for byte in range(nbytes):
            d.text((20, gy + byte * ch + 8), f"Byte {byte}", font=self.sans_s, fill=(90, 90, 90))
            for b in range(8):
                bit = byte * 8 + (7 - b)
                x, y = gx + b * cw, gy + byte * ch
                if bit in owner:
                    i, k = owner[bit]
                    c = PALETTE[i % len(PALETTE)]
                    d.rectangle([x, y, x + cw, y + ch], fill=tuple(int(v * 0.35 + 255 * 0.65) for v in c), outline=c)
                    lbl = f"{i + 1}.{k}"
                    d.text((x + (cw - self._w(lbl, self.sans_s)) / 2, y + 9), lbl, font=self.sans_s, fill=(30, 30, 30))
                else:
                    d.rectangle([x, y, x + cw, y + ch], fill=(250, 250, 250), outline=(220, 220, 220))
                    d.text((x + cw / 2 - 8, y + 9), str(bit), font=self.sans_s, fill=(190, 190, 190))
        y = gy + nbytes * ch + 24
        for i, e in enumerate(els):
            c = PALETTE[i % len(PALETTE)]
            bs = sorted(e["bits"])
            d.rectangle([20, y + 4, 40, y + 22], fill=c)
            txt = f"{i + 1}  {e['name']}   LSB bit {bs[0]}, {len(bs)} bit   (source: {e.get('source', '?')})"
            d.text((52, y + 4), txt, font=self.sans, fill=(30, 30, 30))
            y += 28
        self._save(img, path)
        return path


