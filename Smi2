        def _tree(self, parent, cols, height=10):
            fr = ttk.Frame(parent)
            fr.columnconfigure(0, weight=1)
            fr.rowconfigure(0, weight=1)
            tv = ttk.Treeview(fr, columns=[c[0] for c in cols], show="headings", height=height)
            for cid, text, w in cols:
                tv.heading(cid, text=text, command=lambda c=cid, t=tv: self._sort(t, c, False))
                tv.column(cid, width=w, anchor="w", stretch=True)
            vs = ttk.Scrollbar(fr, orient="vertical", command=tv.yview)
            hs = ttk.Scrollbar(fr, orient="horizontal", command=tv.xview)
            tv.configure(yscrollcommand=vs.set, xscrollcommand=hs.set)
            tv.grid(row=0, column=0, sticky="nsew")
            vs.grid(row=0, column=1, sticky="ns")
            hs.grid(row=1, column=0, sticky="ew")
            for st, col in TAG_BG.items():
                tv.tag_configure(st, background=col)
            return tv

        def _sort(self, tv, col, rev):
            data = [(tv.set(k, col), k) for k in tv.get_children("")]
            try:
                data.sort(key=lambda x: float(x[0]), reverse=rev)
            except ValueError:
                data.sort(key=lambda x: x[0].lower(), reverse=rev)
            for i, (_, k) in enumerate(data):
                tv.move(k, "", i)
            tv.heading(col, command=lambda: self._sort(tv, col, not rev))

