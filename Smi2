        def _browse_excel(self):
            p = filedialog.askopenfilename(filetypes=[("Excel", "*.xlsx *.xlsm"), ("All", "*.*")])
            if p:
                self.var_excel.set(p)
                try:
                    sh = excel_sheets(p)
                    self.cb_sheet["values"] = ([ALL_SHEETS] if len(sh) > 1 else []) + sh
                    self.cb_sheet.set(ALL_SHEETS if len(sh) > 1 else (sh[0] if sh else ""))
                except Exception as exc:
                    messagebox.showerror(TOOL_NAME, f"Cannot open Excel:\n{exc}")
                    return
                self._load_excel()

        def _load_excel(self):
            p = self.var_excel.get().strip()
            if not p or not os.path.isfile(p):
                messagebox.showwarning(TOOL_NAME, "Select a request Excel first.")
                return
            try:
                if not self.cb_sheet["values"]:
                    sh = excel_sheets(p)
                    self.cb_sheet["values"] = ([ALL_SHEETS] if len(sh) > 1 else []) + sh
                    self.cb_sheet.set(ALL_SHEETS if len(sh) > 1 else (sh[0] if sh else ""))
                rows, mapping, warns = read_request_excel(p, self.cb_sheet.get() or None)
            except Exception as exc:
                messagebox.showerror(TOOL_NAME, f"Could not read request Excel:\n{exc}")
                return
            self.batch_rows = rows
            self._fill_batch_preview(rows, mapping)
            for w in warns:
                self._log("WARN", w)
            self._save_paths()

        def _fill_batch_preview(self, rows, mapping):
            self.tv_batch.delete(*self.tv_batch.get_children())
            if mapping:
                extra_lbl = {"smi": "SMI type", "id": "ID", "remarks": "Remarks", "port": "Port", "data_element": "Data element"}
                self.lbl_map.configure(text="Column mapping:  " + "   ".join(
                    f"{FIELD_LABELS[k][0] if k in FIELD_LABELS else extra_lbl.get(k, k)} <- '{v}'" for k, v in mapping.items()))
            cnt = Counter()
            for r in rows:
                other = row_inputs_text(r) if r.smi else "; ".join(
                    f"{k}={getattr(r, k)}" for k in FIELD_LABELS if getattr(r, k, ""))
                tag = ERROR if not r.smi else ""
                self.tv_batch.insert("", "end", values=(r.row_id, r.excel_row or "", r.smi or f"? {r.smi_raw}",
                                                        r.component, r.label(), r.src_component, r.dst_component, other),
                                     tags=(tag,) if tag else ())
                cnt[r.smi or "unknown"] += 1
            self.lbl_batch.configure(text=f"{len(rows)} rows   " + "  ".join(f"{k}: {v}" for k, v in cnt.items()))

        def _template(self):
            p = filedialog.asksaveasfilename(defaultextension=".xlsx", initialfile="SMI_Request_Template.xlsx",
                                             filetypes=[("Excel", "*.xlsx")])
            if p:
                write_template(p)
                self._log("INFO", f"Template written: {p}")
                open_path(p)

        def _save_batch_excel(self):
            if not self.batch_rows:
                return
            p = filedialog.asksaveasfilename(defaultextension=".xlsx", initialfile="SMI_Requests.xlsx",
                                             filetypes=[("Excel", "*.xlsx")])
            if not p:
                return
            wb = openpyxl.Workbook()
            ws = wb.active
            ws.title = "SMI_Requests"
            cols = TEMPLATE_COLUMNS + [c for c in OPTIONAL_COLUMNS if any(getattr(r, c[1], "") for r in self.batch_rows)]
            ws.append([c for c, _ in cols])
            for r in self.batch_rows:
                ws.append([r.row_id if f == "id" else (r.smi if f == "smi" else getattr(r, f, "")) for _, f in cols])
            wb.save(p)
            self._log("INFO", f"Batch list saved: {p}")

