TEMPLATE_COLUMNS = [
    ("ID", "id"), ("SMI_Type", "smi"), ("Component", "component"), ("RTE_API", "api"),
    ("Source_Component", "src_component"), ("Write_API", "src_api"), ("Destination_Component", "dst_component"),
    ("Read_API", "dst_api"), ("Call_Function_or_Variable", "call_target"), ("Runnable", "runnable"),
    ("Task", "task"), ("Remarks", "remarks")]
OPTIONAL_COLUMNS = [
    ("Expected_Trigger", "trigger"), ("Expected_Cycle_ms", "cycle"), ("Expected_Offset_ms", "offset"),
    ("Expected_Mode", "mode"), ("Mode_Group", "mode_group"), ("Signal", "signal"), ("DID", "did"),
    ("Expected_Datatype", "datatype"), ("Expected_Endianness", "endianness"), ("Expected_BitPosition", "bitpos"),
    ("Expected_Length", "length"), ("Expected_ECU", "ecu"), ("Safety_Related", "safety")]
SMI_TYPE_CHOICES = ["SMI-2123", "SMI-324_Client_Server", "SMI-324_Non_Queued", "SMI-2063", "SMI-2065", "SMI-62933",
                    "SMI-105506", "SMI-1055"]
ALL_SHEETS = "(all sheets)"


def map_columns(headers: List[Any]) -> Dict[str, int]:
    normed = [norm_header(h) for h in headers]
    out: Dict[str, int] = {}
    for fld, aliases in COLUMN_ALIASES.items():
        best = None
        for rank, al in enumerate(aliases):
            for ci, nh in enumerate(normed):
                if nh == al and ci not in out.values():
                    if best is None or rank < best[0]:
                        best = (rank, ci)
        if best:
            out[fld] = best[1]
    return out


def excel_sheets(path: str) -> List[str]:
    wb = openpyxl.load_workbook(path, read_only=True)
    try:
        return list(wb.sheetnames)
    finally:
        wb.close()


def read_request_excel(path: str, sheet: str = None) -> Tuple[List[RowInput], Dict[str, str], List[str]]:
    """Read requests. One sheet with an SMI type column, or one sheet per SMI (sheet name = SMI type)."""
    warnings: List[str] = []
    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
    try:
        skip = {"help", "columnspersmi", "info", "readme", "smicatalog", "catalog", "legend", "dashboard"}
        sheets = [sheet] if sheet and sheet != ALL_SHEETS else [n for n in wb.sheetnames if norm_header(n) not in skip]
        all_rows: List[RowInput] = []
        mapping: Dict[str, str] = {}
        used_sheets = []
        for sh in sheets:
            ws = wb[sh]
            data = [list(r) for r in ws.iter_rows(values_only=True)]
            sheet_smi = normalize_smi(sh)
            hdr_i, cmap = None, {}
            for i, r in enumerate(data[:25]):
                m = map_columns(r)
                if ("smi" in m and len(m) >= 2) or (sheet_smi and len(m) >= 2 and "smi" not in m):
                    hdr_i, cmap = i, m
                    break
            if hdr_i is None:
                continue
            used_sheets.append(sh)
            headers = [str(h or "").strip() for h in data[hdr_i]]
            used = set(cmap.values())
            for k, r in enumerate(data[hdr_i + 1:], hdr_i + 2):
                if not any(v not in (None, "") for v in r):
                    continue
                ri = RowInput(excel_row=k)
                for fld, ci in cmap.items():
                    v = r[ci] if ci < len(r) else None
                    if v is None:
                        continue
                    if isinstance(v, float) and v.is_integer():
                        v = int(v)
                    v = str(v).strip()
                    if fld == "id":
                        ri.row_id = v
                    elif fld == "smi":
                        ri.smi_raw = v
                    elif hasattr(ri, fld):
                        setattr(ri, fld, v)
                for ci, h in enumerate(headers):
                    if ci not in used and h and ci < len(r) and r[ci] not in (None, ""):
                        ri.extra[h] = r[ci]
                if not ri.smi_raw and sheet_smi:
                    ri.smi_raw = sh
                ri.smi = normalize_smi(ri.smi_raw, ri.api)
                ri.extra["Sheet"] = sh
                if not ri.smi:
                    warnings.append(f"{sh} row {k}: unknown SMI type '{ri.smi_raw}'")
                all_rows.append(ri)
            for fld, ci in cmap.items():
                mapping.setdefault(fld, headers[ci] if len(sheets) == 1 or len(used_sheets) == 1 else f"{headers[ci]}")
        if not used_sheets:
            raise ValueError("No sheet with an SMI type column found (expected a header like 'SMI_Type', or sheets "
                             "named after the SMI, e.g. 'SMI-2063').")
        if len(used_sheets) > 1:
            for r in all_rows:
                if not r.row_id:
                    r.row_id = f"{safe_name(r.extra['Sheet'], 12)}-R{r.excel_row:04d}"
            warnings.append(f"Read {len(all_rows)} rows from sheets: {', '.join(used_sheets)}")
        return all_rows, mapping, warnings
    finally:
        wb.close()


def write_template(path: str):
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "SMI_Requests"
    rep = ExcelReporter(Settings())
    rep._hdr(ws, 1, [c for c, _ in TEMPLATE_COLUMNS])
