def _ecuc(name, defpath, params=None, refs=None, subs=None):
    pv = "".join(
        f"<ECUC-NUMERICAL-PARAM-VALUE><DEFINITION-REF DEST=\"ECUC-INTEGER-PARAM-DEF\">{defpath}/{k}</DEFINITION-REF>"
        f"<VALUE>{v}</VALUE></ECUC-NUMERICAL-PARAM-VALUE>" for k, v in (params or {}).items())
    rv = "".join(
        f"<ECUC-REFERENCE-VALUE><DEFINITION-REF DEST=\"ECUC-REFERENCE-DEF\">{defpath}/{k}</DEFINITION-REF>"
        f"<VALUE-REF DEST=\"ECUC-CONTAINER-VALUE\">{v}</VALUE-REF></ECUC-REFERENCE-VALUE>"
        for k, vs in (refs or {}).items() for v in (vs if isinstance(vs, list) else [vs]))
    sc = f"<SUB-CONTAINERS>{''.join(subs)}</SUB-CONTAINERS>" if subs else ""
    return (f"<ECUC-CONTAINER-VALUE><SHORT-NAME>{name}</SHORT-NAME><DEFINITION-REF DEST=\"ECUC-PARAM-CONF-CONTAINER-DEF\">"
            f"{defpath}</DEFINITION-REF><PARAMETER-VALUES>{pv}</PARAMETER-VALUES><REFERENCE-VALUES>{rv}"
            f"</REFERENCE-VALUES>{sc}</ECUC-CONTAINER-VALUE>")


def _ar(pkgs: str) -> str:
    return (f'<?xml version="1.0" encoding="UTF-8"?>\n<AUTOSAR xmlns="http://autosar.org/schema/r4.0">'
            f"<AR-PACKAGES>{pkgs}</AR-PACKAGES></AUTOSAR>\n")


def _pkg(name: str, elements: str) -> str:
    return f"<AR-PACKAGE><SHORT-NAME>{name}</SHORT-NAME><ELEMENTS>{elements}</ELEMENTS></AR-PACKAGE>"


