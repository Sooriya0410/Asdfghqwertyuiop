        def _sel_result(self) -> Optional[AnalysisResult]:
            sel = self.tv_res.selection()
            if not sel:
                return self.results[-1] if self.results else None
            try:
                return self.results[int(sel[0])]
            except (ValueError, IndexError):
                return None

        def _refresh_results(self):
            self.tv_res.delete(*self.tv_res.get_children())
            fs, ft, q = self.cb_fsmi.get(), self.cb_fst.get(), self.var_search.get().lower().strip()
            for i, r in enumerate(self.results):
                if fs != "All" and r.smi != fs:
                    continue
                if ft != "All" and r.status != ft:
                    continue
                vals = (r.row.row_id, r.smi, r.row.who(), r.row.label(), r.status, r.summary)
                if q and q not in " ".join(str(v) for v in vals).lower():
                    continue
                self.tv_res.insert("", "end", iid=str(i), values=vals, tags=(r.status,))
            cnt = Counter(r.status for r in self.results)
            self.var_counts.set("   ".join(f"{k} {cnt.get(k, 0)}" for k in (PASS, FAIL, REVIEW, ERROR)) if self.results else "")

        def _fill_checks(self, tv, res: Optional[AnalysisResult]):
            tv.delete(*tv.get_children())
            if not res:
                return
            for i, c in enumerate(res.checks):
                cols = tv["columns"]
                vals = {"status": c.status, "check": c.name, "expected": c.expected, "actual": c.actual, "note": c.note}
                tv.insert("", "end", iid=str(i), values=[vals.get(k, "") for k in cols], tags=(c.status,))

