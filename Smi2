RTE_FILE_RE = re.compile(r"^Rte(?:_\w+)?\.(?:c|h)$", re.I)
NONRTE_MACRO_FILTER = re.compile(r"^(?:Rte_|RTE_|ComConf_|ComXf|DiagXf|E2E|Dcm|DCM_|COMXF|DIAGXF)")


def index_c_file(args) -> Dict[str, Any]:
    path, rel = args
    rec: Dict[str, Any] = {"rel": rel, "ok": True}
    try:
        raw = read_text(path)
    except Exception as exc:  # pragma: no cover
        return {"rel": rel, "ok": False, "error": str(exc)}
    base = os.path.basename(path)
    is_rte = bool(RTE_FILE_RE.match(base))
    is_h = base.lower().endswith(".h")
    clean = strip_c(raw)
    ls = line_starts(clean)
    rec["is_rte"] = is_rte
    rec["nlines"] = len(ls)
    tok: Dict[str, set] = defaultdict(set)
    for m in KEY_TOKEN_RE.finditer(clean):
        tok[m.group(0)].add(lineno_at(ls, m.start()))
    rec["tokens"] = {k: sorted(v) for k, v in tok.items()}
    raw_lines = raw.split("\n")
    incs = []
    for m in _INCLUDE_LINE_RE.finditer(clean):
        n = lineno_at(ls, m.start())
        mm = _INCLUDE_NAME_RE.search(raw_lines[n - 1] if n - 1 < len(raw_lines) else "")
        if mm:
            incs.append(os.path.basename(mm.group(1).replace("\\", "/")))
    rec["includes"] = incs
    funcs = []
    rte_funcs = {}
    for name, npos, hs, bo, bc, params in find_funcdefs(clean):
        start = lineno_at(ls, npos)
        end = lineno_at(ls, bc)
        header = re.sub(r"\s+", " ", clean[hs:bo]).strip()[:500]
        funcs.append((name, start, end, header, re.sub(r"\s+", " ", params).strip()[:500]))
        if is_rte:
            body_line = lineno_at(ls, bo)
            an = analyze_code(clean[bo:bc + 1], body_line)
            an["start"], an["end"], an["header"] = start, end, header
            an["params"] = re.sub(r"\s+", " ", params).strip()[:500]
            rte_funcs[name] = an
    rec["funcdefs"] = funcs
    rec["rte_funcs"] = rte_funcs
    rec["macros"] = parse_macros(clean, ls, None if is_rte else NONRTE_MACRO_FILTER)
    rec["typedefs"] = parse_typedefs(clean, ls) if is_h or "Type" in base else []
    gl = []
    pr = []
    if is_rte:
        for m in _GLOBAL_VAR_RE.finditer(clean):
            typ = (m.group(1) or m.group(2) or m.group(3) or "").strip()
            if typ in ("return", "else", "case", "goto"):
                continue
            gl.append((m.group(4), lineno_at(ls, m.start(4)), typ, (m.group(5) or "").strip("[] ")))
    if is_rte or is_h:
        for m in _PROTO_RE.finditer(clean):
            ret = (m.group(1) or m.group(2) or "").strip()
            if ret in C_KEYWORDS and ret != "void" or ret in ("return", "else", "define"):
                continue
            pr.append((m.group(3), lineno_at(ls, m.start(3)), ret, re.sub(r"\s+", " ", m.group(4)).strip()[:500]))
    rec["globals"] = gl
    rec["protos"] = pr
    return rec


def _safe_index(args):
    try:
        return index_c_file(args)
    except Exception as exc:  # pragma: no cover
        return {"rel": args[1], "ok": False, "error": f"{type(exc).__name__}: {exc}"}


