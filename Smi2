        def _show_detail(self):
            for w in self.det_frame.winfo_children():
                w.destroy()
            res = self._sel_result()
            if not res or not res.details or not self.cb_detail.get():
                return
            t = res.details[int(self.cb_detail.get().split(".")[0]) - 1]
            cols = [(f"c{i}", h, max(80, min(260, len(h) * 9))) for i, h in enumerate(t["headers"])]
            tv = self._tree(self.det_frame, cols)
            tv.master.grid(row=0, column=0, sticky="nsew")
            for r in t["rows"]:
                tag = FAIL if "DIFF" in [str(x) for x in r] else ""
                tv.insert("", "end", values=[str(x) for x in r], tags=(tag,) if tag else ())

        def _show_card(self, res):
            pics = [p for p in res.pictures if p.endswith("_00_summary.png")]
            if not pics or not HAVE_PIL:
                self.pic_label.configure(image="", text="(no picture)")
                return
            try:
                from PIL import ImageTk
                im = Image.open(pics[0])
                w = max(400, self.pic_label.winfo_width() - 10)
                if im.width > w:
                    im = im.resize((w, int(im.height * w / im.width)))
                self._pic_ref = ImageTk.PhotoImage(im)
                self.pic_label.configure(image=self._pic_ref, text="")
            except Exception as exc:
                self.pic_label.configure(image="", text=f"Preview not available ({exc}) - use 'Summary picture'")

        def _show_evidence(self, tv, res, txt):
            txt.delete("1.0", "end")
            sel = tv.selection()
            if not res or not sel:
                return
            c = res.checks[int(sel[0])]
            txt.insert("end", f" {c.status}  {c.name}\n", "hdr")
            if c.expected:
                txt.insert("end", f"Expected: {c.expected}\n", "note")
            txt.insert("end", f"Actual:   {c.actual}\n", "note")
            if c.note:
                txt.insert("end", f"Note:     {c.note}\n", "note")
            if not c.evidence:
                txt.insert("end", "\n(no code evidence for this check)\n")
            for e in c.evidence:
                txt.insert("end", f"\n {e.title}   -   {e.ref} \n", "hdr")
                for n, line in e.snippet:
                    tag = "hl" if n in (e.highlight or ()) else ""
                    txt.insert("end", f"{n:6d}  ", "ln")
                    txt.insert("end", line + "\n", tag)

