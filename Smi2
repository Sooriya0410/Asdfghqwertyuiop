        dict(id="R007", smi="SMI-105506", component="CtApDiag", api="Rte_Call_DataServices_DID_F190_ReadData"),
        dict(id="R008", smi="SMI-1055", component="CtApDisplay", api="Rte_Mode_RpEcuMode_EcuMode"),
    ]
    usage_fill = PatternFill("solid", fgColor="EEF4FF")
    for i, r in enumerate(ex, 2):
        spec = SMI_SPECS[normalize_smi(r["smi"])]
        for j, f in enumerate(cols, 1):
            c = ws.cell(row=i, column=j, value=r.get(f, ""))
            if f in spec.fields:
                c.fill = usage_fill
    try:
        from openpyxl.worksheet.datavalidation import DataValidation
