def parse_time_ms(expr: str) -> Optional[float]:
    e = expr.replace(" ", "")
    for rx, mul in ((r"RTE_USEC\w*\(([\d.]+)", 0.001), (r"RTE_MSEC\w*\(([\d.]+)", 1.0), (r"RTE_SEC\w*\(([\d.]+)", 1000.0),
                    (r"RTE_NSEC\w*\(([\d.]+)", 1e-6), (r"OS_US2TICKS\w*\(([\d.]+)", 0.001),
                    (r"OS_MS2TICKS\w*\(([\d.]+)", 1.0), (r"OS_SEC2TICKS\w*\(([\d.]+)", 1000.0),
                    (r"OS_NS2TICKS\w*\(([\d.]+)", 1e-6), (r"\w*MSEC\w*\(([\d.]+)", 1.0),
                    (r"\w*MS2TICKS\w*\(([\d.]+)", 1.0)):
        m = re.search(rx, e)
        if m:
            return float(m.group(1)) * mul
    return None


def event_name_timing(ev: str) -> Tuple[Optional[float], Optional[float]]:
    m = re.search(r"_(\d+)(ms|us)?_(\d+)(ms|us)?$", ev)
    if not m:
        return None, None
    off = float(m.group(1)) * (0.001 if m.group(2) == "us" else 1.0)
    cyc = float(m.group(3)) * (0.001 if m.group(4) == "us" else 1.0)
    return off, cyc


def classify_event(ev: str) -> str:
    e = ev.lower()
    if "init" in e:
        return "INIT"
    if "background" in e or "_bg_" in e or e.endswith("_bg") or "bgev" in e:
        return "BACKGROUND"
    if "cyclic" in e or "_te_" in e or "_te2_" in e or "timing" in e or "_tm_" in e:
        return "CYCLIC"
    if "onentry" in e or "onexit" in e or "modeswitch" in e or "_ms_" in e:
        return "MODE_SWITCH"
    if "opinv" in e or "operationinvoked" in e or "_oi_" in e:
        return "OPERATION_INVOKED"
    if "_run" in e or "datareceived" in e or "_dr_" in e or "dataupdated" in e:
        return "DATA_RECEIVED"
    return "EVENT"


TRIGGER_ALIASES = {
    "CYCLIC": ("cyclic", "timing", "timingevent", "periodic", "cycle", "te"),
    "INIT": ("init", "initevent", "initialization", "startup"),
    "BACKGROUND": ("background", "backgroundevent", "bg", "idle"),
    "DATA_RECEIVED": ("datareceived", "datareceivedevent", "dr", "onreceive", "rteapi", "apitriggered",
                      "dataupdated", "event", "datareceive"),
    "OPERATION_INVOKED": ("operationinvoked", "operationinvokedevent", "oi", "server", "cs", "clientserver",
                          "directcall", "servercall"),
    "MODE_SWITCH": ("modeswitch", "swcmodeswitchevent", "onentry", "onexit", "mode"),
}


def norm_trigger(t: str) -> str:
    c = norm_header(t)
    for k, al in TRIGGER_ALIASES.items():
        if c == norm_header(k) or c in al:
            return k
    return c.upper()


class RteModel:
    """Navigates the generated MICROSAR RTE: components, API chains, buffers, tasks."""

    def __init__(self, idx: SandboxIndex):
        self.idx = idx
        self.components: Dict[str, int] = {}
        self.type_headers: Dict[str, int] = {}
        self.comp_macros: Dict[str, Dict[str, Tuple[int, int, Optional[str], str]]] = defaultdict(dict)
        self.runnables: Dict[str, Dict[str, Tuple[int, int]]] = defaultdict(dict)
        self.runnable_owner: Dict[str, str] = {}
        self.funcs: Dict[str, Dict[str, Any]] = {}
        self.owner: Dict[str, Tuple[str, str]] = {}
        self.writers: Dict[str, List[Tuple[str, int]]] = defaultdict(list)
        self.readers: Dict[str, List[str]] = defaultdict(list)
        self.path_writers: Dict[str, List[Tuple[str, List[str], int]]] = defaultdict(list)
        self.path_users: Dict[str, List[str]] = defaultdict(list)
        self.callers: Dict[str, List[Tuple[str, int]]] = defaultdict(list)
        self.event_setters: Dict[str, List[Tuple[str, str, int]]] = defaultdict(list)
        self.task_activators: Dict[str, List[Tuple[str, int]]] = defaultdict(list)
        self.alarms: Dict[str, Dict[str, Any]] = {}
        self.tasks: Dict[str, str] = {}
        self.comp_files: Dict[str, List[int]] = defaultdict(list)
        self._build()

    # ------------------------------------------------------------------ build
    def _build(self):
        idx = self.idx
        hdrs: Dict[str, int] = {}
        for fid, f in enumerate(idx.files):
            if f.kind == "h" and f.is_rte:
                b = os.path.basename(f.rel)
                m = re.match(r"^Rte_(\w+)\.h$", b, re.I)
                if m:
                    hdrs[m.group(1)] = fid
        for name, fid in hdrs.items():
            if name.endswith("_Type"):
                continue
            if name in NON_COMP_HEADERS or name.startswith(("Rte_", "OsApplication", "Os")):
                continue
            has_type = (name + "_Type") in hdrs
            has_runnable = any(m[0].startswith("RTE_RUNNABLE_") for m in self._macros_in(fid))
            if has_type or has_runnable:
                self.components[name] = fid
                if has_type:
                    self.type_headers[name] = hdrs[name + "_Type"]
        # component macros
        for comp, fid in self.components.items():
            for name, line, params, body in self._macros_in(fid):
                self.comp_macros[comp][name] = (fid, line, params, body)
                if name.startswith("RTE_RUNNABLE_"):
                    sym = strip_parens(body) or name[len("RTE_RUNNABLE_"):]
                    if re.fullmatch(r"[A-Za-z_]\w*", sym):
                        self.runnables[comp][sym] = (fid, line)
                        self.runnable_owner.setdefault(sym, comp)
        # functions + pseudo functions (macro expressions)
        for name, an in idx.rte_funcs.items():
            self.funcs[name] = an
        for comp, macros in self.comp_macros.items():
            for name, (fid, line, params, body) in macros.items():
                if not name.startswith("Rte_"):
                    continue
                b = strip_parens(body)
                if not b:
                    continue
                if re.fullmatch(r"[A-Za-z_]\w*", b) and params is None and b not in idx.rte_globals:
                    if API_KIND_RE.match(name):
                        self.owner.setdefault(b, (comp, name))
                        self.owner.setdefault(f"macro:{b}", (comp, name))
                        if b in self.runnable_owner or idx.nonrte_funcdef(b):
                            self.callers[b].append((f"alias:{comp}:{name}", line))
                    continue
                key = f"macro:{name}"
                an = analyze_code(b, line)
                an.update(fid=fid, start=line, end=line, header=f"#define {name}{params or ''}",
                          params=(params or "").strip("()"), is_macro=True, comp=comp)
                self.funcs[key] = an
                if API_KIND_RE.match(name):
                    self.owner.setdefault(key, (comp, name))
        for key in list(self.funcs):
            if key.startswith("macro:"):
                nm = key[6:]
                if nm in self.owner and key not in self.owner:
                    self.owner[key] = self.owner[nm]
        # data flow maps
        globals_ = idx.rte_globals
        for fname, an in self.funcs.items():
            for var, line in an.get("writes", []):
                if var in globals_:
                    self.writers[var].append((fname, line))
            for var in an.get("reads", []):
                if var in globals_:
                    self.readers[var].append(fname)
            for full, base, rhs, line in an.get("assigns", []):
                if base in globals_ and full != base:
                    self.path_writers[full].append((fname, rhs, line))
            for p in an.get("paths", []):
                b = re.match(r"[A-Za-z_]\w*", p).group(0)
                if b in globals_:
                    self.path_users[p].append(fname)
            for callee, line in an.get("calls", []):
                self.callers[callee].append((fname, line))
            for osf, args, line in an.get("os", []):
                if osf in ("SetEvent", "Os_SetEvent") and len(args) >= 2:
                    for ev in re.findall(r"[A-Za-z_]\w*", args[1]):
                        if ev not in ("EventMaskType",):
                            self.event_setters[ev].append((fname, args[0], line))
                elif osf in ("ActivateTask", "Os_ActivateTask", "ChainTask") and args:
                    self.task_activators[args[0]].append((fname, line))
                elif osf in ("SetRelAlarm", "SetAbsAlarm") and len(args) >= 3:
                    self.alarms[args[0]] = {"alarm": args[0], "kind": osf, "offset_raw": args[1],
                                            "cycle_raw": args[2], "offset_ms": parse_time_ms(args[1]),
                                            "cycle_ms": parse_time_ms(args[2]), "func": fname, "line": line,
                                            "fid": an.get("fid", -1)}
            if fname.startswith("TASK("):
                self.tasks[fname[5:-1].strip()] = fname
        # component -> source files
        for comp in self.components:
            for fid in idx.included_by.get(f"Rte_{comp}.h", []):
                if not idx.files[fid].is_rte:
                    self.comp_files[comp].append(fid)

    def _macros_in(self, fid: int):
        # macros are stored per name; collect those of one file efficiently once
        if not hasattr(self, "_by_file"):
            bf: Dict[int, List] = defaultdict(list)
            for name, lst in self.idx.macros.items():
                for (f, line, params, body) in lst:
                    bf[f].append((name, line, params, body))
            self._by_file = bf
        return self._by_file.get(fid, [])

    # ---------------------------------------------------------------- helpers
    def is_global(self, name: str) -> bool:
        return name in self.idx.rte_globals

    def global_type(self, name: str) -> str:
        g = self.idx.rte_globals.get(name)
        return g[2] if g else ""

    def func_evidence(self, fname: str, title: str = "", hl: Sequence[int] = ()) -> Optional[Evidence]:
        an = self.funcs.get(fname)
        if not an or an.get("fid", -1) < 0:
            return None
        s, e = an["start"], an["end"]
        ev = self.idx.ev(an["fid"], s, e, title or fname, hl or ((s,) if e - s > 3 else tuple(range(s, e + 1))), ctx=1)
        if e - s > 40 and hl:
            ev.snippet = self.idx.snippet(an["fid"], min(hl), max(hl), self.idx.settings.context_lines)
        return ev

    def comp_of(self, fname: str) -> Tuple[str, str]:
        """Map an RTE function / pseudo name to (component, short API)."""
        if fname in self.owner:
            return self.owner[fname]
        if fname.startswith("alias:"):
            _, comp, short = fname.split(":", 2)
            return comp, short
        if fname.startswith("macro:"):
            an = self.funcs.get(fname, {})
            if an.get("comp"):
                return an["comp"], fname[6:]
            fname = fname[6:]
        if fname.startswith("TASK("):
            return "<RTE task>", fname
        if re.match(r"Rte_\w*(COMCbk|ComCbk|Cbk)", fname):
            return "<COM callback>", fname
        m = API_KIND_RE.match(fname)
        if m:
            rest = fname[m.end():]
            best = ""
            for comp in self.components:
                if rest.startswith(comp + "_") and len(comp) > len(best):
                    best = comp
            if best:
                return best, "Rte_" + m.group(1) + "_" + rest[len(best) + 1:]
        return "<RTE>", fname

    def comp_apis(self, comp: str) -> List[str]:
        out = []
        for name in self.comp_macros.get(comp, {}):
            m = API_KIND_RE.match(name)
            if not m:
                continue
            rest = name[m.end():]
            if rest.startswith(comp + "_"):
                continue
            out.append(name)
        return sorted(out)

    def find_comp_for_api(self, api: str) -> List[str]:
        return [c for c, ms in self.comp_macros.items() if api in ms]

    # ------------------------------------------------------------ resolution
    def resolve(self, comp: str, api: str) -> ApiRes:
        api = re.sub(r"\(.*$", "", (api or "").strip())
        comp = (comp or "").strip()
        res = ApiRes(comp=comp, api=api, kind=api_kind(api))
        if not api:
            res.note = "No API given"
            return res
        if comp in self.components and api not in self.comp_macros.get(comp, {}) and api_kind(api):
            other = self.find_comp_for_api(api)
            if other and comp not in other:
                res.note = f"API is defined in Rte_{other[0]}.h (component {other[0]}), not in Rte_{comp}.h. "
                res.comp = comp = other[0]
        if not comp or comp not in self.components:
            cands = self.find_comp_for_api(api)
            if not cands:
                c2, short = self.comp_of(api)
                if c2 in self.components:
                    cands = [c2]
                    if not comp:
                        res.note = f"Long API name mapped to component {c2} ({short})"
            if comp and comp not in self.components:
                res.note = (f"Component '{comp}' has no Rte_{comp}.h in the sandbox. ") + res.note
            res.candidates = cands
            if len(cands) == 1:
                res.comp = cands[0]
            elif len(cands) > 1 and comp:
                res.comp = next((c for c in cands if c.lower() == comp.lower()), cands[0])
            elif len(cands) > 1:
                res.comp = cands[0]
                res.note += f"API defined in several components {cands}; using {cands[0]} (give Component)."
        comp = res.comp
        macros = self.comp_macros.get(comp, {})
        name, seen = api, set()
        for _ in range(8):
            if name in seen:
                break
            seen.add(name)
            mdef = macros.get(name)
            if not mdef:
                gl = [m for m in self.idx.macros.get(name, []) if self.idx.files[m[0]].is_rte]
                mdef = gl[0] if gl else None
            if mdef:
                fid, line, params, body = mdef
                res.chain.append(self.idx.ev(fid, line, line, f"#define {name}", (line,), ctx=2))
                b = strip_parens(body)
                if re.fullmatch(r"[A-Za-z_]\w*", b or "") and params is None and not self.is_global(b):
                    name = b
                    continue
                key = f"macro:{name}"
                if key not in self.funcs:
                    an = analyze_code(b, line)
                    an.update(fid=fid, start=line, end=line, header=f"#define {name}{params or ''}",
                              params=(params or "").strip("()"), is_macro=True, comp=comp)
                    self.funcs[key] = an
                res.func, res.found = key, True
                break
            if name in self.funcs and not name.startswith("macro:"):
                an = self.funcs[name]
                ev = self.func_evidence(name, f"RTE implementation {name}")
                if ev:
                    res.chain.append(ev)
                res.func, res.found = name, True
                break
            d = self.idx.nonrte_funcdef(name)
            if d:
                res.direct_target, res.found = name, True
                res.chain.append(self.idx.ev(d[0], d[1], d[1], f"Direct mapping -> {name}()", (d[1],), ctx=2))
                break
            if res.chain and name != api:
                # alias to a function that is not part of the sandbox (e.g. BSW library)
                res.direct_target, res.found = name, True
                pr = self.idx.rte_protos.get(name)
                if pr:
                    res.chain.append(self.idx.ev(pr[0][0], pr[0][1], pr[0][1], f"Prototype of {name}()", (pr[0][1],), ctx=1))
                res.note = (res.note + " " if res.note else "") + f"{name}() is not defined in the sandbox (library)."
                break
            break
        if not res.found and not res.chain:
            res.note = (res.note + " " if res.note else "") + f"{api} not found in generated RTE"
        self._fill_types(res, name)
        return res

    def _fill_types(self, res: ApiRes, last_name: str):
        an = self.funcs.get(res.func, {}) if res.func else {}
        params_txt, ret = "", ""
        if an and not an.get("is_macro"):
            params_txt = an.get("params", "")
            m = re.search(r"FUNC\s*\(\s*([^,()]+?)\s*,", an.get("header", ""))
            ret = m.group(1).strip() if m else ""
        if not params_txt:
            for nm in (res.func.replace("macro:", "") if res.func else "", last_name, res.direct_target, res.api):
                if nm and nm in self.idx.rte_protos:
                    _, _, ret2, params_txt = self.idx.rte_protos[nm][0]
                    ret = ret or ret2
                    break
        if not params_txt and res.direct_target:
            d = self.idx.nonrte_funcdef(res.direct_target)
            if d:
                params_txt = d[4]
                m = re.search(r"FUNC\s*\(\s*([^,()]+?)\s*,", d[3])
                ret = ret or (m.group(1).strip() if m else "")
        res.params = parse_params(params_txt) if params_txt else []
        res.ret = ret
        dt = ""
        k = res.kind
        if res.params and k not in ("Call", "Result"):
            pick = next((p for p in res.params if p["name"].lower() in ("data", "value")), None)
            pick = pick or (res.params[-1] if k in READ_KINDS else res.params[0])
            dt = pick["type"]
        if not dt and k == "Mode" and ret:
            dt = ret
        if not dt and an:
            bufs = [w for w, _ in an.get("writes", []) if self.is_global(w)] + \
                   [r for r in an.get("reads", []) if self.is_global(r)]
            for b in bufs:
                t = self.global_type(b)
                if t and not t.startswith("Rte_ts_") and "Task" not in b:
                    dt = t
                    break
            if not dt and res.kind in IMPLICIT_KINDS:
                src = self.implicit_sources(res.func)
                if src:
                    dt = self.global_type(src[0][0])
        res.data_type = dt

    # ---------------------------------------------------------- data flow
    def buffers_of(self, fname: str, kind: str) -> Tuple[List[str], List[str]]:
        an = self.funcs.get(fname, {})
        w = sorted({v for v, _ in an.get("writes", []) if self.is_global(v)})
        r = sorted({v for v in an.get("reads", []) if self.is_global(v)})
        return w, r

    def implicit_sources(self, fname: str) -> List[Tuple[str, str, int]]:
        """For an implicit read expression, return [(global_buffer, copy_func, line)]."""
        an = self.funcs.get(fname, {})
        out = []
        for p in an.get("paths", []):
            for wfunc, rhs, line in self.path_writers.get(p, []):
                for r in rhs:
                    if self.is_global(r) and wfunc != fname:
                        out.append((r, wfunc, line))
        return out

    def implicit_targets(self, buffer: str) -> List[Tuple[str, str, int]]:
        """Task-level copies of a global buffer -> [(member_path, copy_func, line)]."""
        out = []
        for full, lst in self.path_writers.items():
            for wfunc, rhs, line in lst:
                if buffer in rhs:
                    out.append((full, wfunc, line))
        return out

    def partner_from_func(self, fname: str, role: str, line: int = 0, via: str = "") -> Partner:
        comp, short = self.comp_of(fname)
        an = self.funcs.get(fname, {})
        com = an.get("com", [])
        return Partner(comp, short, fname, role, an.get("fid", -1), line or an.get("start", 0),
                       bool(com), com[0][1] if com else "", via)

    def sr_partners(self, res: ApiRes) -> Dict[str, Any]:
        out = {"side": "", "buffers": [], "senders": [], "receivers": [], "com": [], "copies": [], "init": []}
        if not res.func:
            return out
        an = self.funcs.get(res.func, {})
        sender_side = res.kind in WRITE_KINDS
        out["side"] = "sender" if sender_side else "receiver"
        out["com"] = list(an.get("com", []))
        w, r = self.buffers_of(res.func, res.kind)
        me = self.partner_from_func(res.func, out["side"])
        if res.kind in IMPLICIT_KINDS and not sender_side:
            src = self.implicit_sources(res.func)
            bufs = sorted({s[0] for s in src})
            out["copies"] = src
        elif res.kind in IMPLICIT_KINDS and sender_side:
            bufs = []
            # implicit write: task copies member path -> global after runnable
            for fname2, an2 in self.funcs.items():
                if not fname2.startswith("TASK("):
                    continue
                for full, base, rhs, line in an2.get("assigns", []):
                    if self.is_global(base) and full == base and any(p.split(".")[0] in rhs for p in an.get("paths", [])):
                        bufs.append(base)
                        out["copies"].append((base, fname2, line))
            bufs = sorted(set(bufs))
        else:
            bufs = w if sender_side else r
        bufs = [b for b in bufs if not re.search(r"(Task|_RB$|Counter|Status|Flag|Init)", b) or b in (w + r)]
        out["buffers"] = bufs
        self._collect_partners(bufs, out)
        # make sure the analysed API itself is listed on its side
        lst = out["senders"] if sender_side else out["receivers"]
        if not any(p.func == res.func for p in lst):
            lst.insert(0, me)
        return out

    def buffer_partners(self, buf: str) -> Dict[str, Any]:
        """Senders / receivers of one RTE variable (buffer) - used when an RTE variable is given."""
        out = {"side": "buffer", "buffers": [buf], "senders": [], "receivers": [], "com": [], "copies": [], "init": []}
        self._collect_partners([buf], out)
        for p in out["senders"] + out["receivers"]:
            out["com"] += self.funcs.get(p.func, {}).get("com", [])
        return out

    def _collect_partners(self, bufs: List[str], out: Dict[str, Any]):
        seen = set()
        for b in bufs:
            for fname, line in self.writers.get(b, []):
                if INIT_FUNC_RE.match(fname):
                    out["init"].append((fname, line))
                    continue
                if fname.startswith("TASK("):
                    continue
                key = ("s", fname)
                if key in seen:
                    continue
                seen.add(key)
                p = self.partner_from_func(fname, "sender", line, via=b)
                out["senders"].append(p)
            readers = list(self.readers.get(b, []))
            for fname in readers:
                if INIT_FUNC_RE.match(fname) or fname.startswith("TASK("):
                    continue
                key = ("r", fname)
                if key in seen:
                    continue
                seen.add(key)
                out["receivers"].append(self.partner_from_func(fname, "receiver", via=b))
            for full, cfunc, line in self.implicit_targets(b):
                for user in self.path_users.get(full, []):
                    if user == cfunc or user.startswith("TASK("):
                        continue
                    key = ("r", user)
                    if key in seen:
                        continue
                    seen.add(key)
                    out["receivers"].append(self.partner_from_func(user, "receiver", via=f"{b} -> {full} ({cfunc})"))

    def server_targets(self, res: ApiRes) -> Dict[str, Any]:
        out = {"servers": [], "async": [], "calls": []}
        if res.direct_target:
            out["servers"].append(res.direct_target)
            return out
        an = self.funcs.get(res.func, {})
        for callee, line in an.get("calls", []):
            out["calls"].append((callee, line))
            if callee.startswith(("Rte_", "Com_", "SchM_", "Os_", "Ioc")) or callee in OS_FUNCS \
                    or callee in MEMCPY_FUNCS or callee.startswith(XF_PREFIXES):
                continue
            if callee in self.runnable_owner or self.idx.nonrte_funcdef(callee):
                if callee not in out["servers"]:
                    out["servers"].append(callee)
        for osf, args, line in an.get("os", []):
            if osf in ("CallTrustedFunction", "Os_CallNonTrustedFunction", "Os_CallFastTrustedFunction",
                       "SetEvent", "ActivateTask", "IocSend", "IocWrite"):
                out["async"].append((osf, args, line))
        if not out["servers"] and out["async"]:
            # asynchronous / cross partition -> look for runnables triggered by the events set here
            evs = []
            for osf, args, line in out["async"]:
                if osf == "SetEvent" and len(args) >= 2:
                    evs += re.findall(r"Rte_Ev\w+", args[1])
                if osf in ("CallTrustedFunction", "Os_CallFastTrustedFunction") and len(args) >= 1:
                    tf = re.sub(r"^.*?(\w+)\s*$", r"\1", args[0])
                    tan = self.funcs.get(tf, {})
                    for callee, _ in tan.get("calls", []):
                        if callee in self.runnable_owner:
                            out["servers"].append(callee)
            for task, tfunc in self.tasks.items():
                tan = self.funcs.get(tfunc, {})
                for callee, line in tan.get("calls", []):
                    if callee in self.runnable_owner:
                        ctx = " ".join(self.call_context(tfunc, line))
                        if any(e in ctx for e in evs) and callee not in out["servers"]:
                            out["servers"].append(callee)
        return out

    def call_context(self, fname: str, line: int) -> List[str]:
        an = self.funcs.get(fname)
        if not an or an.get("is_macro") or an.get("fid", -1) < 0:
            return []
        s, e = an["start"], an["end"]
        seg = self.idx.clean_segment(an["fid"], s, e)
        return block_context(seg, line - s)

    def call_sites(self, symbol: str) -> List[Tuple[str, int]]:
        return [c for c in self.callers.get(symbol, [])]

    def alarm_for_event(self, ev: str) -> Optional[Dict[str, Any]]:
        def key(n, pref):
            n2 = re.sub(r"^" + pref + r"_?", "", n)
            return re.sub(r"^[A-Za-z]+\d*_", "", n2)
        k = key(ev, "Rte_Ev")
        for al, info in self.alarms.items():
            if key(al, "Rte_Al") == k or (len(k) > 6 and al.endswith(k)):
                return info
        return None

    def alarm_for_task(self, task: str) -> Optional[Dict[str, Any]]:
        for al, info in self.alarms.items():
            if task and task in al:
                return info
        return None

    def mode_values(self, comp: str, group: str) -> Dict[str, Tuple[str, int, int]]:
        """{mode: (value, fid, line)} from RTE_MODE_<group>_<mode> macros of the component headers."""
        out = {}
        fids = {self.components.get(comp), self.type_headers.get(comp)} - {None}
        pref = f"RTE_MODE_{group}_"
        for name, lst in self.idx.macros.items():
            if not name.startswith(pref):
                continue
            for fid, line, params, body in lst:
                if not fids or fid in fids:
                    out[name[len(pref):]] = (strip_casts(body).rstrip("uUlL"), fid, line)
        return out

    def mode_groups_of(self, comp: str) -> List[str]:
        fids = {self.components.get(comp), self.type_headers.get(comp)} - {None}
        groups = set()
        for name, lst in self.idx.macros.items():
            if name.startswith("RTE_TRANSITION_"):
                if any(m[0] in fids for m in lst):
                    groups.add(name[len("RTE_TRANSITION_"):])
        return sorted(groups)

    def typedefs(self) -> Dict[str, Dict[str, Any]]:
        return self.idx.typedefs


# =============================================================================
#  ARXML model (SWC, interfaces, data types, events, ECUC, communication, diag)
# =============================================================================
SWC_TAGS = {"APPLICATION-SW-COMPONENT-TYPE", "SENSOR-ACTUATOR-SW-COMPONENT-TYPE",
            "COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE", "SERVICE-SW-COMPONENT-TYPE",
            "ECU-ABSTRACTION-SW-COMPONENT-TYPE", "NV-BLOCK-SW-COMPONENT-TYPE",
            "PARAMETER-SW-COMPONENT-TYPE", "SERVICE-PROXY-SW-COMPONENT-TYPE"}
ARXML_TARGETS = SWC_TAGS | {
    "COMPOSITION-SW-COMPONENT-TYPE", "SENDER-RECEIVER-INTERFACE", "CLIENT-SERVER-INTERFACE",
    "MODE-SWITCH-INTERFACE", "NV-DATA-INTERFACE", "TRIGGER-INTERFACE", "APPLICATION-PRIMITIVE-DATA-TYPE",
    "APPLICATION-RECORD-DATA-TYPE", "APPLICATION-ARRAY-DATA-TYPE", "IMPLEMENTATION-DATA-TYPE", "SW-BASE-TYPE",
    "COMPU-METHOD", "DATA-TYPE-MAPPING-SET", "PORT-INTERFACE-MAPPING-SET", "MODE-DECLARATION-GROUP",
    "I-SIGNAL", "I-SIGNAL-GROUP", "I-SIGNAL-I-PDU", "SYSTEM-SIGNAL", "SYSTEM-SIGNAL-GROUP",
    "SENDER-RECEIVER-TO-SIGNAL-MAPPING", "SENDER-RECEIVER-TO-SIGNAL-GROUP-MAPPING", "CAN-FRAME",
    "FLEXRAY-FRAME", "DIAGNOSTIC-DATA-IDENTIFIER"}
EVENT_KIND = {"TIMING-EVENT": "CYCLIC", "INIT-EVENT": "INIT", "BACKGROUND-EVENT": "BACKGROUND",
              "DATA-RECEIVED-EVENT": "DATA_RECEIVED", "DATA-RECEIVE-ERROR-EVENT": "DATA_RECEIVE_ERROR",
              "OPERATION-INVOKED-EVENT": "OPERATION_INVOKED", "SWC-MODE-SWITCH-EVENT": "MODE_SWITCH",
              "MODE-SWITCHED-ACK-EVENT": "MODE_SWITCHED_ACK", "ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT":
              "ASYNC_SERVER_RETURNS", "DATA-SEND-COMPLETED-EVENT": "DATA_SEND_COMPLETED",
              "DATA-WRITE-COMPLETED-EVENT": "DATA_WRITE_COMPLETED", "INTERNAL-TRIGGER-OCCURRED-EVENT":
              "INTERNAL_TRIGGER", "EXTERNAL-TRIGGER-OCCURRED-EVENT": "EXTERNAL_TRIGGER",
              "OS-TASK-EXECUTION-EVENT": "TASK_EXECUTION", "SWC-MODE-MANAGER-ERROR-EVENT": "MODE_MANAGER_ERROR"}


def _ln(tag) -> str:
    return tag.rsplit("}", 1)[-1] if isinstance(tag, str) else ""


def _kid(el, name):
    if el is None:
        return None
    for c in el:
        if _ln(c.tag) == name:
            return c
    return None


def _kids(el, name=None):
    if el is None:
        return []
    return [c for c in el if isinstance(c.tag, str) and (name is None or _ln(c.tag) == name)]


def _path(el, *names):
    cur = el
    for n in names:
        cur = _kid(cur, n)
        if cur is None:
            return None
    return cur


def _t(el, *names) -> str:
    node = _path(el, *names)
    return (node.text or "").strip() if node is not None else ""


def _desc(el, name):
    if el is None:
        return
    for d in el.iter():
        if _ln(d.tag) == name:
            yield d


def _dtx(el, name) -> str:
    for d in _desc(el, name):
        return (d.text or "").strip()
    return ""


def last_seg(ref: str) -> str:
    return (ref or "").rstrip("/").rsplit("/", 1)[-1]


def _num(s: str) -> Optional[float]:
    try:
        s = (s or "").strip()
        if not s:
            return None
        if s.lower().startswith("0x"):
            return float(int(s, 16))
        return float(s)
    except ValueError:
        return None


def _ecuc_record(el, name: str, path: str, parent: str, module: str) -> Dict[str, Any]:
    defref = _t(el, "DEFINITION-REF")
    c = {"name": name, "def": last_seg(defref), "defpath": defref, "module": module, "params": {},
         "refs": {}, "children": [], "parent": parent, "path": path}
    for p in _kids(_kid(el, "PARAMETER-VALUES")):
        c["params"].setdefault(last_seg(_t(p, "DEFINITION-REF")), []).append(_t(p, "VALUE"))
    for r in _kids(_kid(el, "REFERENCE-VALUES")):
        c["refs"].setdefault(last_seg(_t(r, "DEFINITION-REF")), []).append(_t(r, "VALUE-REF") or _dtx(r, "TARGET-REF"))
    return c


def _arxml_handle(el, tag: str, pkg: str, out: Dict[str, Any], rel: str):
    name = _t(el, "SHORT-NAME")
    path = f"{pkg}/{name}"
    if tag in SWC_TAGS:
        ports = []
        for p in _kids(_kid(el, "PORTS")):
            d = {"P-PORT-PROTOTYPE": "P", "R-PORT-PROTOTYPE": "R", "PR-PORT-PROTOTYPE": "PR"}.get(_ln(p.tag))
            if not d:
                continue
            iref = (_t(p, "PROVIDED-INTERFACE-TREF") or _t(p, "REQUIRED-INTERFACE-TREF") or
                    _t(p, "PROVIDED-REQUIRED-INTERFACE-TREF"))
            comspecs = []
            for csp in ("PROVIDED-COM-SPECS", "REQUIRED-COM-SPECS"):
                for cs in _kids(_kid(p, csp)):
                    comspecs.append({"kind": _ln(cs.tag), "de": last_seg(_dtx(cs, "DATA-ELEMENT-REF")),
                                     "e2e": _dtx(cs, "USES-END-TO-END-PROTECTION").lower(),
                                     "op": last_seg(_dtx(cs, "OPERATION-REF")),
                                     "queue": _dtx(cs, "QUEUE-LENGTH")})
            ports.append({"name": _t(p, "SHORT-NAME"), "dir": d, "iface": iref, "comspecs": comspecs})
        runnables, events = [], []
        for ib in _kids(_kid(el, "INTERNAL-BEHAVIORS")):
            ibn = _t(ib, "SHORT-NAME")
            for r in _kids(_kid(ib, "RUNNABLES"), "RUNNABLE-ENTITY"):
                runnables.append({"name": _t(r, "SHORT-NAME"), "symbol": _t(r, "SYMBOL") or _t(r, "SHORT-NAME")})
            for e in _kids(_kid(ib, "EVENTS")):
                etag = _ln(e.tag)
                en = _t(e, "SHORT-NAME")
                ev = {"name": en, "tag": etag, "kind": EVENT_KIND.get(etag, etag),
                      "runnable": last_seg(_t(e, "START-ON-EVENT-REF")), "period": _num(_t(e, "PERIOD")),
                      "offset": _num(_t(e, "OFFSET")), "path": f"{path}/{ibn}/{en}", "modes": [],
                      "activation": _t(e, "ACTIVATION"), "target": ""}
                for dm in _desc(e, "DISABLED-MODE-IREF"):
                    ev["modes"].append("/".join(x for x in (last_seg(_dtx(dm, "CONTEXT-PORT-REF")),
                                                           last_seg(_dtx(dm, "CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF")),
                                                           last_seg(_dtx(dm, "TARGET-MODE-DECLARATION-REF"))) if x))
                if etag.startswith("DATA-"):
                    ev["target"] = "/".join(x for x in (last_seg(_dtx(e, "CONTEXT-R-PORT-REF")),
                                                       last_seg(_dtx(e, "TARGET-DATA-ELEMENT-REF"))) if x)
                elif etag == "OPERATION-INVOKED-EVENT":
                    ev["target"] = "/".join(x for x in (last_seg(_dtx(e, "CONTEXT-P-PORT-REF")),
                                                       last_seg(_dtx(e, "TARGET-PROVIDED-OPERATION-REF"))) if x)
                elif etag == "SWC-MODE-SWITCH-EVENT":
                    ev["target"] = ", ".join("/".join(x for x in (last_seg(_dtx(mi, "CONTEXT-PORT-REF")),
                                                                  last_seg(_dtx(mi, "TARGET-MODE-DECLARATION-REF"))) if x)
                                             for mi in _desc(e, "MODE-IREF"))
                events.append(ev)
        out["swcs"][path] = {"name": name, "kind": tag, "ports": ports, "runnables": runnables,
                             "events": events, "file": rel}
    elif tag == "COMPOSITION-SW-COMPONENT-TYPE":
        protos = {_t(p, "SHORT-NAME"): _t(p, "TYPE-TREF") for p in _kids(_kid(el, "COMPONENTS"), "SW-COMPONENT-PROTOTYPE")}
        conns = []
        for c in _kids(_kid(el, "CONNECTORS")):
            ct = _ln(c.tag)
            if ct == "ASSEMBLY-SW-CONNECTOR":
                pi, ri = _kid(c, "PROVIDER-IREF"), _kid(c, "REQUESTER-IREF")
                conns.append({"kind": "ASSEMBLY", "name": _t(c, "SHORT-NAME"),
                              "p_comp": last_seg(_t(pi, "CONTEXT-COMPONENT-REF")), "p_port": last_seg(_t(pi, "TARGET-P-PORT-REF")),
                              "r_comp": last_seg(_t(ri, "CONTEXT-COMPONENT-REF")), "r_port": last_seg(_t(ri, "TARGET-R-PORT-REF")),
                              "mapping": _t(c, "MAPPING-REF")})
            elif ct == "DELEGATION-SW-CONNECTOR":
                conns.append({"kind": "DELEGATION", "name": _t(c, "SHORT-NAME"),
                              "inner_comp": last_seg(_dtx(c, "CONTEXT-COMPONENT-REF")),
                              "inner_port": last_seg(_dtx(c, "TARGET-P-PORT-REF") or _dtx(c, "TARGET-R-PORT-REF")),
                              "outer_port": last_seg(_t(c, "OUTER-PORT-REF")), "mapping": _t(c, "MAPPING-REF")})
        out["compositions"][path] = {"name": name, "protos": protos, "connectors": conns, "file": rel}
    elif tag in ("SENDER-RECEIVER-INTERFACE", "NV-DATA-INTERFACE"):
        elems = [{"name": _t(v, "SHORT-NAME"), "type": _t(v, "TYPE-TREF")}
                 for v in _desc(el, "VARIABLE-DATA-PROTOTYPE")]
        inval = {last_seg(_t(ip, "DATA-ELEMENT-REF")): _t(ip, "HANDLE-INVALID")
                 for ip in _desc(el, "INVALIDATION-POLICY")}
        out["interfaces"][path] = {"name": name, "kind": "SR" if tag.startswith("SENDER") else "NV",
                                   "elements": elems, "invalidation": inval, "file": rel}
    elif tag == "CLIENT-SERVER-INTERFACE":
        ops = []
        for op in _desc(el, "CLIENT-SERVER-OPERATION"):
            ops.append({"name": _t(op, "SHORT-NAME"),
                        "args": [{"name": _t(a, "SHORT-NAME"), "type": _t(a, "TYPE-TREF"), "dir": _t(a, "DIRECTION")}
                                 for a in _desc(op, "ARGUMENT-DATA-PROTOTYPE")]})
        out["interfaces"][path] = {"name": name, "kind": "CS", "operations": ops, "file": rel}
    elif tag == "MODE-SWITCH-INTERFACE":
        mg = _kid(el, "MODE-GROUP")
        out["interfaces"][path] = {"name": name, "kind": "MS", "mode_group": _t(mg, "SHORT-NAME"),
                                   "mode_group_type": _t(mg, "TYPE-TREF"), "file": rel}
    elif tag == "TRIGGER-INTERFACE":
        out["interfaces"][path] = {"name": name, "kind": "TRIGGER", "file": rel}
    elif tag in ("APPLICATION-PRIMITIVE-DATA-TYPE", "APPLICATION-RECORD-DATA-TYPE", "APPLICATION-ARRAY-DATA-TYPE"):
        d = {"name": name, "kind": tag, "category": _t(el, "CATEGORY"), "compu": _dtx(el, "COMPU-METHOD-REF"),
             "unit": _dtx(el, "UNIT-REF"), "elements": [], "file": rel}
        if tag == "APPLICATION-RECORD-DATA-TYPE":
            d["elements"] = [{"name": _t(r, "SHORT-NAME"), "type": _t(r, "TYPE-TREF")}
                             for r in _desc(el, "APPLICATION-RECORD-ELEMENT")]
        out["datatypes"][path] = d
    elif tag == "IMPLEMENTATION-DATA-TYPE":
        top_props = _kid(el, "SW-DATA-DEF-PROPS")
        d = {"name": name, "kind": tag, "category": _t(el, "CATEGORY"),
             "base": _dtx(top_props, "BASE-TYPE-REF") if top_props is not None else "",
             "ref": _dtx(top_props, "IMPLEMENTATION-DATA-TYPE-REF") if top_props is not None else "",
             "compu": _dtx(top_props, "COMPU-METHOD-REF") if top_props is not None else "", "elements": [], "file": rel}
        for se in _kids(_kid(el, "SUB-ELEMENTS"), "IMPLEMENTATION-DATA-TYPE-ELEMENT"):
            d["elements"].append({"name": _t(se, "SHORT-NAME"), "category": _t(se, "CATEGORY"),
                                  "array": _t(se, "ARRAY-SIZE"), "base": _dtx(se, "BASE-TYPE-REF"),
                                  "type": _dtx(se, "IMPLEMENTATION-DATA-TYPE-REF")})
        out["datatypes"][path] = d
    elif tag == "SW-BASE-TYPE":
        out["base_types"][path] = {"name": name, "size": _num(_t(el, "BASE-TYPE-SIZE")),
                                   "encoding": _t(el, "BASE-TYPE-ENCODING"), "byte_order": _t(el, "BYTE-ORDER"),
                                   "native": _t(el, "NATIVE-DECLARATION")}
    elif tag == "COMPU-METHOD":
        scales = list(_desc(el, "COMPU-SCALE"))
        factor, offset = None, None
        for coeffs in _desc(el, "COMPU-RATIONAL-COEFFS"):
            num = [_num(v.text) for v in _kids(_kid(coeffs, "COMPU-NUMERATOR"), "V")]
            den = [_num(v.text) for v in _kids(_kid(coeffs, "COMPU-DENOMINATOR"), "V")] or [1.0]
            if num and den and den[0]:
                offset = (num[0] or 0.0) / den[0]
                factor = (num[1] / den[0]) if len(num) > 1 and num[1] is not None else 1.0
            break
        out["compu"][path] = {"name": name, "category": _t(el, "CATEGORY"), "factor": factor,
                              "offset": offset, "scales": len(scales)}
    elif tag == "DATA-TYPE-MAPPING-SET":
        for m in _desc(el, "DATA-TYPE-MAP"):
            out["type_maps"].append((_t(m, "APPLICATION-DATA-TYPE-REF"), _t(m, "IMPLEMENTATION-DATA-TYPE-REF")))
    elif tag == "PORT-INTERFACE-MAPPING-SET":
        for m in _kids(_kid(el, "PORT-INTERFACE-MAPPINGS")):
            out["pim"].append({"set": path, "name": _t(m, "SHORT-NAME"), "kind": _ln(m.tag),
                               "first": _t(m, "FIRST-INTERFACE-REF"), "second": _t(m, "SECOND-INTERFACE-REF"),
                               "texttable": any(True for _ in _desc(m, "TEXT-TABLE-MAPPING")),
                               "data_maps": sum(1 for _ in _desc(m, "DATA-PROTOTYPE-MAPPING")),
                               "path": f"{path}/{_t(m, 'SHORT-NAME')}"})
    elif tag == "MODE-DECLARATION-GROUP":
        modes = [(_t(m, "SHORT-NAME"), _t(m, "VALUE")) for m in _desc(el, "MODE-DECLARATION")]
        out["mode_groups"][path] = {"name": name, "modes": modes, "initial": last_seg(_t(el, "INITIAL-MODE-REF"))}
    elif tag == "I-SIGNAL":
        out["isignals"][path] = {"name": name, "length": _num(_t(el, "LENGTH")), "sys": _t(el, "SYSTEM-SIGNAL-REF"),
                                 "compu": _dtx(_kid(el, "NETWORK-REPRESENTATION-PROPS"), "COMPU-METHOD-REF"),
                                 "base": _dtx(_kid(el, "NETWORK-REPRESENTATION-PROPS"), "BASE-TYPE-REF"),
                                 "type": _t(el, "I-SIGNAL-TYPE"), "file": rel}
    elif tag == "I-SIGNAL-GROUP":
        out["isignal_groups"][path] = {
            "name": name, "signals": [s.text.strip() for s in _desc(el, "I-SIGNAL-REF") if s.text],
            "sys": _t(el, "SYSTEM-SIGNAL-GROUP-REF"),
            "comxf": any(True for _ in _desc(el, "COM-BASED-SIGNAL-GROUP-TRANSFORMATIONS")) or
                     any(True for _ in _desc(el, "TRANSFORMATION-TECHNOLOGY-REF")),
            "e2e": any(True for _ in _desc(el, "END-TO-END-TRANSFORMATION-I-SIGNAL-PROPS")) or
                   any(True for _ in _desc(el, "END-TO-END-TRANSFORMATION-I-SIGNAL-PROPS-CONDITIONAL")),
            "file": rel}
    elif tag == "I-SIGNAL-I-PDU":
        maps = []
        for m in _desc(el, "I-SIGNAL-TO-I-PDU-MAPPING"):
            maps.append({"name": _t(m, "SHORT-NAME"), "signal": _t(m, "I-SIGNAL-REF"),
                         "group": _t(m, "I-SIGNAL-GROUP-REF"), "start": _num(_t(m, "START-POSITION")),
                         "byte_order": _t(m, "PACKING-BYTE-ORDER"), "transfer": _t(m, "TRANSFER-PROPERTY")})
        out["pdus"][path] = {"name": name, "length": _num(_t(el, "LENGTH")), "mappings": maps, "file": rel}
    elif tag in ("CAN-FRAME", "FLEXRAY-FRAME"):
        out["frames"][path] = {"name": name, "length": _num(_t(el, "FRAME-LENGTH")),
                               "pdus": [_t(m, "PDU-REF") for m in _desc(el, "PDU-TO-FRAME-MAPPING")]}
    elif tag in ("SYSTEM-SIGNAL", "SYSTEM-SIGNAL-GROUP"):
        out["sys_signals"][path] = {"name": name, "kind": tag,
                                    "signals": [s.text.strip() for s in _desc(el, "SYSTEM-SIGNAL-REF") if s.text]}
    elif tag in ("SENDER-RECEIVER-TO-SIGNAL-MAPPING", "SENDER-RECEIVER-TO-SIGNAL-GROUP-MAPPING"):
        de = _kid(el, "DATA-ELEMENT-IREF")
        ctx = [last_seg(x.text or "") for x in _desc(de, "CONTEXT-COMPONENT-REF")]
        rec = {"kind": "GROUP" if "GROUP" in tag else "SIGNAL", "comp_proto": ctx[-1] if ctx else "",
               "port": last_seg(_dtx(de, "CONTEXT-PORT-REF")), "de": last_seg(_dtx(de, "TARGET-DATA-PROTOTYPE-REF")),
               "sys": _t(el, "SYSTEM-SIGNAL-REF") or _t(el, "SIGNAL-GROUP-REF"), "elements": []}
        for rm in _desc(el, "SENDER-REC-RECORD-ELEMENT-MAPPING"):
            rec["elements"].append({"element": last_seg(_dtx(rm, "APPLICATION-RECORD-ELEMENT-REF") or
                                                        _dtx(rm, "IMPLEMENTATION-RECORD-ELEMENT-REF")),
                                    "sys": _dtx(rm, "SYSTEM-SIGNAL-REF")})
        out["sr_maps"].append(rec)
    elif tag == "DIAGNOSTIC-DATA-IDENTIFIER":
        params = []
        for p in _desc(el, "DIAGNOSTIC-PARAMETER"):
            de = _kid(p, "DATA-ELEMENT")
            params.append({"name": _t(de, "SHORT-NAME") or _t(p, "SHORT-NAME"), "bit_offset": _num(_t(p, "BIT-OFFSET")),
                           "base": _dtx(de, "BASE-TYPE-REF"), "compu": _dtx(de, "COMPU-METHOD-REF"),
                           "max_elems": _num(_dtx(de, "MAX-NUMBER-OF-ELEMENTS"))})
        out["diag_dids"][path] = {"name": name, "id": _t(el, "ID"), "params": params, "file": rel}


def parse_arxml_file(args) -> Dict[str, Any]:
    path, rel = args
    out = {"rel": rel, "ok": True, "swcs": {}, "compositions": {}, "interfaces": {}, "datatypes": {},
           "base_types": {}, "compu": {}, "type_maps": [], "pim": [], "mode_groups": {}, "isignals": {},
           "isignal_groups": {}, "pdus": {}, "frames": {}, "sys_signals": {}, "sr_maps": [], "ecuc": {},
           "ecuc_modules": {}, "diag_dids": {}}
    try:
        if HAVE_LXML:
            ctx = LET.iterparse(path, events=("start", "end"), huge_tree=True, recover=True)
        else:
            ctx = ET.iterparse(path, events=("start", "end"))
        stack: List[str] = []
        pkgs: List[str] = []
        tdepth = 0
        module: Optional[Dict[str, Any]] = None     # ECUC module being streamed
        cstack: List[Dict[str, Any]] = []           # open ECUC containers
        for event, el in ctx:
            tag = _ln(el.tag)
            if event == "start":
                stack.append(tag)
                if tag == "AR-PACKAGE":
                    pkgs.append("")
                elif tag in ARXML_TARGETS:
                    tdepth += 1
                elif tag == "ECUC-MODULE-CONFIGURATION-VALUES" and tdepth == 0:
                    module = {"name": "", "def": "", "children": []}
                elif tag == "ECUC-CONTAINER-VALUE" and module is not None:
                    cstack.append({"name": "", "children": []})
                continue
            # end
            parent = stack[-2] if len(stack) >= 2 else ""
            if tag == "SHORT-NAME":
                if parent == "AR-PACKAGE" and pkgs:
                    pkgs[-1] = (el.text or "").strip()
                elif parent == "ECUC-CONTAINER-VALUE" and cstack:
                    cstack[-1]["name"] = (el.text or "").strip()
                elif parent == "ECUC-MODULE-CONFIGURATION-VALUES" and module is not None:
                    module["name"] = (el.text or "").strip()
            elif tag == "DEFINITION-REF" and parent == "ECUC-MODULE-CONFIGURATION-VALUES" and module is not None:
                module["def"] = (el.text or "").strip()
            elif tag == "ECUC-CONTAINER-VALUE" and module is not None and cstack:
                base = "/" + "/".join(p for p in pkgs if p) + "/" + module["name"]
                path = base + "".join("/" + c["name"] for c in cstack)
                par = path.rsplit("/", 1)[0]
                rec = _ecuc_record(el, cstack[-1]["name"], path, par, module["name"])
                rec["children"] = cstack[-1]["children"]
                out["ecuc"][path] = rec
                cstack.pop()
                (cstack[-1]["children"] if cstack else module["children"]).append(path)
                el.clear()
                if HAVE_LXML:
                    pe = el.getparent()
                    if pe is not None:
                        while el.getprevious() is not None:
                            del pe[0]
            elif tag == "ECUC-MODULE-CONFIGURATION-VALUES" and module is not None:
                mpath = "/" + "/".join(p for p in pkgs if p) + "/" + module["name"]
                out["ecuc_modules"][mpath] = {"name": module["name"], "def": module["def"], "file": rel}
                module = None
            if tag in ARXML_TARGETS:
                tdepth -= 1
                if tdepth == 0:
                    try:
                        _arxml_handle(el, tag, "/" + "/".join(p for p in pkgs if p), out, rel)
                    except Exception as exc:  # keep going on malformed elements
                        out.setdefault("warnings", []).append(f"{tag}: {exc}")
            if tdepth == 0 and (tag in ARXML_TARGETS or parent == "ELEMENTS"):
                el.clear()
                if HAVE_LXML:
                    par = el.getparent()
                    if par is not None:
                        while el.getprevious() is not None:
                            del par[0]
            if tag == "AR-PACKAGE" and pkgs:
                pkgs.pop()
            stack.pop()
    except Exception as exc:
        out["ok"] = False
        out["error"] = f"{type(exc).__name__}: {exc}"
    return out


def _safe_arxml(args):
    try:
        return parse_arxml_file(args)
    except Exception as exc:  # pragma: no cover
        return {"rel": args[1], "ok": False, "error": str(exc)}


class ArxmlModel:
    DICT_KEYS = ("swcs", "compositions", "interfaces", "datatypes", "base_types", "compu", "mode_groups",
                 "isignals", "isignal_groups", "pdus", "frames", "sys_signals", "ecuc", "ecuc_modules", "diag_dids")
    LIST_KEYS = ("type_maps", "pim", "sr_maps")

    def __init__(self):
        for k in self.DICT_KEYS:
            setattr(self, k, {})
        for k in self.LIST_KEYS:
            setattr(self, k, [])
        self.by_name: Dict[str, Dict[str, List[str]]] = {}
        self.ecuc_by_def: Dict[str, List[str]] = defaultdict(list)
        self.errors: List[str] = []
        self.files = 0

    @classmethod
    def build(cls, idx: SandboxIndex, settings: Settings, log=None, progress=None, cancel=None) -> "ArxmlModel":
        log = log or (lambda a, b: None)
        progress = progress or (lambda a, b, c: None)
        m = cls()
        fids = idx.arxml_fids
        if not fids:
            return m
        cpath = os.path.join(cache_dir(), "arxml_" + hashlib.sha1(idx.root.lower().encode()).hexdigest()[:16] + ".pkl")
        cached = {}
        if settings.use_cache and os.path.isfile(cpath):
            try:
                with open(cpath, "rb") as fh:
                    blob = pickle.load(fh)
                if blob.get("version") == CACHE_VERSION:
                    cached = blob.get("files", {})
            except Exception:
                cached = {}
        results, todo = {}, []
        for fid in fids:
            f = idx.files[fid]
            c = cached.get(f.rel)
            if c and c[0] == f.size and c[1] == f.mtime:
                results[f.rel] = c
            else:
                todo.append((idx.abspath(fid), f.rel))
        t0 = time.perf_counter()
        log("INFO", f"Parsing {len(todo)} ARXML files ({len(results)} cached, lxml={'yes' if HAVE_LXML else 'no'})")
        parsed = []
        workers = int(settings.workers or 1)
        if len(todo) > 1 and workers > 1:
            try:
                with ProcessPoolExecutor(max_workers=min(workers, len(todo)), mp_context=_mp_ctx()) as ex:
                    for i, r in enumerate(ex.map(_safe_arxml, todo), 1):
                        parsed.append(r)
                        progress(i, len(todo), f"ARXML {i}/{len(todo)}")
                        if cancel is not None and cancel.is_set():
                            ex.shutdown(cancel_futures=True)
                            raise Cancelled()
            except Cancelled:
                raise
            except Exception as exc:
                log("WARN", f"Parallel ARXML parsing failed ({exc}); sequential")
                parsed = []
        if todo and not parsed:
            for i, t in enumerate(todo, 1):
                parsed.append(_safe_arxml(t))
                progress(i, len(todo), f"ARXML {i}/{len(todo)}")
        for r in parsed:
            f = idx.files[idx.fid_by_rel[r["rel"]]]
            results[r["rel"]] = (f.size, f.mtime, r)
        for rel in sorted(results):
            r = results[rel][2]
            if not r.get("ok"):
                m.errors.append(f"{rel}: {r.get('error')}")
                continue
            m.files += 1
            for k in cls.DICT_KEYS:
                d = getattr(m, k)
                for p, v in r.get(k, {}).items():
                    d.setdefault(p, v)
            for k in cls.LIST_KEYS:
                getattr(m, k).extend(r.get(k, []))
        if settings.use_cache:
            try:
                with open(cpath, "wb") as fh:
                    pickle.dump({"version": CACHE_VERSION, "files": results}, fh, protocol=pickle.HIGHEST_PROTOCOL)
            except Exception:
                pass
        m._index()
        log("INFO", f"ARXML model ready in {time.perf_counter() - t0:.1f}s: {len(m.swcs)} SWC types, "
                    f"{len(m.isignals)} I-Signals, {len(m.ecuc)} ECUC containers")
        for e in m.errors[:5]:
            log("WARN", f"ARXML error {e}")
        return m

    def _index(self):
        for k in self.DICT_KEYS:
            d = defaultdict(list)
            for p, v in getattr(self, k).items():
                d[last_seg(p)].append(p)
            self.by_name[k] = d
        for p, c in self.ecuc.items():
            self.ecuc_by_def[c["def"]].append(p)

    # ---------------------------------------------------------------- lookup
    def get(self, cat: str, name_or_path: str) -> Optional[Dict[str, Any]]:
        d = getattr(self, cat)
        if not name_or_path:
            return None
        if name_or_path in d:
            return d[name_or_path]
        lst = self.by_name.get(cat, {}).get(last_seg(name_or_path), [])
        return d[lst[0]] if lst else None

    def find(self, cat: str, name: str, fuzzy: bool = True) -> Optional[Tuple[str, Dict[str, Any]]]:
        d = getattr(self, cat)
        if not name:
            return None
        lst = self.by_name.get(cat, {}).get(name)
        if lst:
            return lst[0], d[lst[0]]
        low = name.lower()
        for n, paths in self.by_name.get(cat, {}).items():
            if n.lower() == low:
                return paths[0], d[paths[0]]
        if fuzzy:
            for n, paths in self.by_name.get(cat, {}).items():
                if n.lower().startswith(low + "_") or n.lower().startswith(low):
                    return paths[0], d[paths[0]]
        return None

    def swc(self, name: str):
        return self.get("swcs", name)

    def port(self, swc: str, port: str):
        s = self.swc(swc)
        if not s:
            return None
        for p in s["ports"]:
            if p["name"] == port:
                return p
        return None

    def element_type(self, swc: str, port: str, de: str) -> Dict[str, Any]:
        """Application + implementation type info of a data element of a port."""
        out = {"app": "", "impl": "", "compu": None, "iface": ""}
        p = self.port(swc, port)
        if not p:
            return out
        itf = self.get("interfaces", p["iface"])
        out["iface"] = last_seg(p["iface"])
        if not itf:
            return out
        for e in itf.get("elements", []):
            if e["name"] == de or not de:
                tref = e["type"]
                dt = self.get("datatypes", tref)
                if dt and dt["kind"].startswith("APPLICATION"):
                    out["app"] = dt["name"]
                    out["compu"] = self.get("compu", dt.get("compu"))
                    for a, i in self.type_maps:
                        if last_seg(a) == dt["name"]:
                            out["impl"] = last_seg(i)
                            break
                elif dt:
                    out["impl"] = dt["name"]
                    out["compu"] = self.get("compu", dt.get("compu"))
                else:
                    out["impl"] = last_seg(tref)
                break
        return out

    def events_for_runnable(self, swc: str, runnable: str) -> List[Dict[str, Any]]:
        out = []
        cands = [self.swc(swc)] if swc and self.swc(swc) else list(self.swcs.values())
        for s in cands:
            if not s:
                continue
            names = {r["name"] for r in s["runnables"] if r["symbol"] == runnable or r["name"] == runnable}
            names.add(runnable)
            for e in s["events"]:
                if e["runnable"] in names:
                    ee = dict(e)
                    ee["swc"] = s["name"]
                    out.append(ee)
        return out

    def ecuc_defs(self, defname: str) -> List[Dict[str, Any]]:
        return [self.ecuc[p] for p in self.ecuc_by_def.get(defname, [])]

    @staticmethod
    def p(c: Optional[Dict[str, Any]], key: str, default: str = "") -> str:
        if not c:
            return default
        v = c["params"].get(key)
        return v[0] if v else default

    @staticmethod
    def r(c: Optional[Dict[str, Any]], key: str) -> List[str]:
        return c["refs"].get(key, []) if c else []

    def ecuc_find(self, defname: str, name: str) -> Optional[Dict[str, Any]]:
        if not name:
            return None
        lst = self.ecuc_defs(defname)
        for c in lst:
            if c["name"] == name:
                return c
        low = name.lower()
        for c in lst:
            if c["name"].lower() == low:
                return c
        for c in lst:
            if c["name"].lower().startswith(low + "_o") or c["name"].lower().startswith(low + "_"):
                return c
        return None

    def rte_event_mapping(self, event_path: str, event_name: str) -> List[Dict[str, Any]]:
        out = []
        for c in self.ecuc_defs("RteEventToTaskMapping"):
            for ref in self.r(c, "RteEventRef"):
                if ref == event_path or last_seg(ref) == event_name:
                    out.append(c)
        return out

    def children(self, c: Dict[str, Any], defname: str = "") -> List[Dict[str, Any]]:
        return [self.ecuc[p] for p in c.get("children", []) if not defname or self.ecuc[p]["def"] == defname]

    def pdu_mapping(self, signal_path: str = "", group_path: str = "") -> Optional[Tuple[Dict, Dict]]:
        sname, gname = last_seg(signal_path), last_seg(group_path)
        for pp, pdu in self.pdus.items():
            for m in pdu["mappings"]:
                if signal_path and (m["signal"] == signal_path or (sname and last_seg(m["signal"]) == sname)):
                    return pdu, m
                if group_path and (m["group"] == group_path or (gname and last_seg(m["group"]) == gname)):
                    return pdu, m
        return None

    def base_type_info(self, ref: str) -> Optional[Dict[str, Any]]:
        return self.get("base_types", ref)


