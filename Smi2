def read_text(path: str) -> str:
    with open(path, "rb") as fh:
        data = fh.read()
    if data.startswith(b"\xef\xbb\xbf"):
        data = data[3:]
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return data.decode("cp1252", errors="replace")


def safe_name(s: str, maxlen: int = 60) -> str:
    s = re.sub(r"[^\w\-.]+", "_", str(s or "")).strip("._")
    return (s or "item")[:maxlen]


def xl_safe(v: Any, limit: int = 32000) -> Any:
    if v is None:
        return ""
    if isinstance(v, (int, float)):
        return v
    s = ILLEGAL_CHARACTERS_RE.sub("", str(v))
    return s if len(s) <= limit else s[:limit] + " ...[truncated]"


def to_float(v: Any) -> Optional[float]:
    if v is None:
        return None
    s = str(v).strip().lower().replace(",", ".")
    if not s:
        return None
    m = re.match(r"^\s*(0x[0-9a-f]+|[-+]?\d+(?:\.\d+)?(?:e[-+]?\d+)?)\s*(ms|us|s|sec)?\s*$", s)
    if not m:
        return None
    num = m.group(1)
    val = float(int(num, 16)) if num.startswith("0x") else float(num)
    unit = m.group(2) or ""
    if unit == "us":
        val /= 1000.0
    elif unit in ("s", "sec"):
        val *= 1000.0
    return val


def fmt_num(v: Optional[float]) -> str:
    if v is None:
        return "-"
    return str(int(v)) if abs(v - round(v)) < 1e-9 else f"{v:g}"


def parse_kv_expect(text: str) -> Tuple[Optional[str], Dict[str, str]]:
    """'16' -> ('16', {}) ; 'a=8;b=16' -> (None, {'a':'8','b':'16'})"""
    t = str(text or "").strip()
    if not t:
        return None, {}
    if "=" not in t:
        return t, {}
    d = {}
    for part in re.split(r"[;\n]+", t):
        if "=" in part:
            k, v = part.split("=", 1)
            d[k.strip().lower()] = v.strip()
    return None, d


def split_list(text: str) -> List[str]:
    return [x.strip() for x in re.split(r"[,;\n|/]+", str(text or "")) if x.strip()]


def norm_endian(v: Any) -> str:
    s = str(v or "").strip().lower().replace("-", "_")
    if not s:
        return ""
    if any(k in s for k in ("big", "motorola", "most_significant_byte_first", "msb_first", "msbfirst")) or s == "0":
        return "BIG"
    if any(k in s for k in ("little", "intel", "most_significant_byte_last", "lsb_first", "msblast")) or s == "1":
        return "LITTLE"
    if "opaque" in s:
        return "OPAQUE"
    return s.upper()


def endian_label(v: str) -> str:
    return {"BIG": "Big endian (Motorola)", "LITTLE": "Little endian (Intel)", "OPAQUE": "Opaque"}.get(v, v or "-")


def similarity(a: str, b: str) -> float:
    a2, b2 = re.sub(r"[^a-z0-9]", "", a.lower()), re.sub(r"[^a-z0-9]", "", b.lower())
    if not a2 or not b2:
        return 0.0
    if a2 == b2:
        return 1.0
    if a2 in b2 or b2 in a2:
        return 0.9
    return difflib.SequenceMatcher(None, a2, b2).ratio()


