class SmiEngine:
    def __init__(self, settings: Settings, log=None, progress=None, cancel: threading.Event = None):
        self.s = settings
        self.log = log or (lambda lvl, msg: LOG.info(msg))
        self.progress = progress or (lambda a, b, c: None)
        self.cancel = cancel or threading.Event()
        self.idx: Optional[SandboxIndex] = None
        self.ctx: Optional[AnalysisContext] = None
        self.sandbox = ""

    def load(self, sandbox: str, force: bool = False) -> Dict[str, Any]:
        sandbox = os.path.abspath(sandbox)
        if self.idx is not None and self.sandbox == sandbox and not force:
            return self.idx.stats
        self.cancel.clear()
        idx = SandboxIndex(sandbox, self.s, self.log, self.progress, self.cancel)
        idx.build(force=force)
        self.idx, self.sandbox = idx, sandbox
        self.ctx = AnalysisContext(idx, self.s, self.log, self.progress, self.cancel)
        st = dict(idx.stats)
        st["components"] = len(self.ctx.rte.components)
        st["tasks"] = len(self.ctx.rte.tasks)
        idx.stats = st
        self.log("INFO", f"RTE model: {st['components']} components, {len(self.ctx.rte.funcs)} RTE functions/macros, "
                         f"{st['tasks']} tasks, {len(self.ctx.rte.alarms)} alarms")
        if not self.ctx.rte.components:
            self.log("WARN", "No RTE component headers (Rte_<Swc>.h + Rte_<Swc>_Type.h) found - is the generated RTE "
                             "(GenData) part of the sandbox?")
        return st

    def run(self, rows: List[RowInput], out_dir: str, on_result: Callable[[AnalysisResult], None] = None,
            smi_filter: Optional[Iterable[str]] = None) -> Dict[str, Any]:
        if self.ctx is None:
            raise RuntimeError("Sandbox not indexed")
        t0 = time.perf_counter()
        out_dir = os.path.abspath(out_dir)
        os.makedirs(out_dir, exist_ok=True)
        ts = _dt.datetime.now().strftime("%Y%m%d_%H%M%S")
        suffix = f"_{ts}" if self.s.timestamped else ""
        filt = set(smi_filter) if smi_filter else None
        use_pics = HAVE_PIL and self.s.pictures
        tl = threading.local()

        def render(res_, folder_):
            rd = getattr(tl, "rd", None)
            if rd is None:
                rd = tl.rd = PictureRenderer()      # one renderer (fonts) per thread
            try:
                self._pictures(rd, res_, folder_)
            except Exception as exc:
                self.log("WARN", f"Picture rendering failed for {res_.row.row_id}: {exc}")
        from concurrent.futures import ThreadPoolExecutor
        pool = ThreadPoolExecutor(max_workers=4) if use_pics else None
        futures = []
        analyzers: Dict[str, BaseAnalyzer] = {}
        results: List[AnalysisResult] = []
        todo = []
        seen_ids: Counter = Counter()
        for i, r in enumerate(rows, 1):
            if not r.smi:
                r.smi = normalize_smi(r.smi_raw, r.api)
            if not r.row_id:
                r.row_id = f"R{(r.excel_row or i):04d}"
            seen_ids[r.row_id] += 1
            if seen_ids[r.row_id] > 1:          # keep picture / report names unique
                r.row_id = f"{r.row_id}_{seen_ids[r.row_id]}"
            if filt and r.smi and r.smi not in filt:
                continue
            todo.append(r)
        total = len(todo)
        self.log("INFO", f"Analysing {total} request(s)")
        if any(r.smi in ("SMI-2063", "SMI-2123", "SMI-62933", "SMI-105506", "SMI-1055", "SMI-2065", "SMI-324_NQ")
               for r in todo) and self.s.use_arxml and self.idx.arxml_fids:
            _ = self.ctx.arxml      # build once up front (shows progress)
        for n, r in enumerate(todo, 1):
            if self.cancel.is_set():
                self.log("WARN", "Run cancelled")
                break
            if r.smi not in ANALYZERS:
                res = AnalysisResult(row=r, smi=r.smi or "UNKNOWN", status=ERROR,
                                     summary=f"Unknown SMI type '{r.smi_raw}'")
                res.checks.append(Check("Input", ERROR, note=f"Unknown SMI type '{r.smi_raw}'. Valid: "
                                                            f"{', '.join(SMI_TYPE_CHOICES)}"))
            else:
                an = analyzers.get(r.smi) or ANALYZERS[r.smi](self.ctx)
                analyzers[r.smi] = an
                res = an.run(r)
            spec = SMI_SPECS.get(res.smi)
            folder = os.path.join(out_dir, spec.folder if spec else "SMI-UNKNOWN")
            if pool and spec:
                futures.append(pool.submit(render, res, os.path.join(folder, f"Pictures{suffix}")))
            results.append(res)
            if on_result:
                on_result(res)
            self.progress(n, total, f"{r.row_id} {res.smi} {res.status}")
            self.log({PASS: "PASS", FAIL: "FAIL", REVIEW: "REVIEW"}.get(res.status, "INFO"),
                     f"{r.row_id:<8} {res.smi:<11} {(r.who() or '-')[:30]:<30} {r.label():<44} {res.status}")
        if pool:
            self.progress(0, 1, "Writing pictures ...")
            for f in futures:
                f.result()
            pool.shutdown()
        meta = {"Sandbox": self.sandbox, "Output folder": out_dir, "Run timestamp": ts,
                "Index": json.dumps(self.idx.stats), "Strict mode": str(self.s.strict),
                "PASS when consistent": str(self.s.pass_when_consistent), "lxml": str(HAVE_LXML),
                "Host": platform.node(), "Python": sys.version.split()[0]}
        by = defaultdict(list)
        for r in results:
            by[r.smi].append(r)
        workbooks = {}
        rep = ExcelReporter(self.s)
        for smi, lst in by.items():
            spec = SMI_SPECS.get(smi)
            if not spec:
                continue
            folder = os.path.join(out_dir, spec.folder if spec else "SMI-UNKNOWN")
            os.makedirs(folder, exist_ok=True)
            p = os.path.join(folder, f"{spec.folder if spec else 'SMI-UNKNOWN'}_Results{suffix}.xlsx")
            try:
                workbooks[smi] = rep.write_smi(p, smi, lst, meta)
            except PermissionError:
                p2 = p.replace(".xlsx", f"_{int(time.time())}.xlsx")
                self.log("WARN", f"{p} is open in Excel - writing {p2}")
                workbooks[smi] = rep.write_smi(p2, smi, lst, meta)
        master = ""
        if results:
            master = os.path.join(out_dir, f"SMI_Master_Report{suffix}.xlsx")
            try:
                rep.write_master(master, results, workbooks, meta)
            except PermissionError:
                master = master.replace(".xlsx", f"_{int(time.time())}.xlsx")
                rep.write_master(master, results, workbooks, meta)
        dt = time.perf_counter() - t0
        cnt = Counter(r.status for r in results)
        self.log("INFO", f"Done in {dt:.1f}s: " + ", ".join(f"{k} {v}" for k, v in cnt.items()) + f" -> {out_dir}")
        return {"results": results, "workbooks": workbooks, "master": master, "counts": cnt, "seconds": dt,
                "out_dir": out_dir}

    def _pictures(self, rd: PictureRenderer, res: AnalysisResult, folder: str):
        base = safe_name(f"{res.row.row_id}_{res.row.who()}_{res.row.label()}", 90)
        os.makedirs(folder, exist_ok=True)
        rd.summary_card(res, os.path.join(folder, f"{base}_00_summary.png"))
        res.pictures.append(os.path.join(folder, f"{base}_00_summary.png"))
        for k, dg in enumerate(res.diagrams, 1):
            p = os.path.join(folder, f"{base}_D{k}_{dg['type']}.png")
            out = rd.connection(dg, p, res.status) if dg["type"] == "connection" else rd.bits(dg, p, res.status)
            if out:
                res.pictures.append(out)
        for ci, c in enumerate(res.checks, 1):
            for ei, ev in enumerate(c.evidence[:max(0, int(self.s.max_pictures_per_check))]):
                if not ev.snippet:
                    continue
                p = os.path.join(folder, f"{base}_{ci:02d}{chr(97 + ei)}_{safe_name(c.name, 32)}.png")
                if rd.code_snippet(ev, p, c.status, f"{res.smi} | {c.name}"):
                    res.pictures.append(p)
                    if not c.picture:
                        c.picture = p


