class AnalysisContext:
    def __init__(self, idx: SandboxIndex, settings: Settings, log=None, progress=None, cancel=None):
        self.idx = idx
        self.settings = settings
        self.log = log or (lambda a, b: None)
        self.progress = progress or (lambda a, b, c: None)
        self.cancel = cancel or threading.Event()
        self.rte = RteModel(idx)
        self._arxml: Optional[ArxmlModel] = None
        self._dbc: Optional[DbcModel] = None
        self._lock = threading.Lock()

    @property
    def arxml(self) -> ArxmlModel:
        with self._lock:
            if self._arxml is None:
                if self.settings.use_arxml and self.idx.arxml_fids:
                    self._arxml = ArxmlModel.build(self.idx, self.settings, self.log, self.progress, self.cancel)
                else:
                    self._arxml = ArxmlModel()
            return self._arxml

    @property
    def dbc(self) -> DbcModel:
        with self._lock:
            if self._dbc is None:
                self._dbc = DbcModel.build(self.idx, self.log) if self.settings.use_dbc else DbcModel()
            return self._dbc


def _tn(t: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"\b(const|volatile)\b|\*", "", str(t or ""))).strip()


def api_eq(a: str, b: str) -> bool:
    a, b = (a or "").strip(), (b or "").strip()
    return bool(a and b) and (a == b or a.endswith("_" + b) or b.endswith("_" + a) or a.lower() == b.lower())


def sig_from_handle(h: str) -> str:
    return re.sub(r"^(?:ComConf_)?(?:ComSignalGroup|ComGroupSignal|ComSignal|ComIPdu|LdComConf_LdComIPdu|"
                  r"LdComConf_\w+?)_", "", h or "")


class BaseAnalyzer:
    key = ""

    def __init__(self, ctx: AnalysisContext):
        self.ctx = ctx
        self.idx = ctx.idx
        self.rte = ctx.rte
        self.s = ctx.settings

    # ------------------------------------------------------------ framework
    def run(self, row: RowInput) -> AnalysisResult:
        t0 = time.perf_counter()
        res = AnalysisResult(row=row, smi=self.key)
        try:
            self.analyze(row, res)
        except Cancelled:
            raise
        except Exception as exc:
            res.checks.append(Check("Analysis error", ERROR, note=f"{type(exc).__name__}: {exc}"))
            res.error = traceback.format_exc()
            self.ctx.log("ERROR", f"{self.key} row {row.row_id}: {exc}")
        res.status = aggregate_status(c.status for c in res.checks)
        if not res.summary:
            cnt = res.counts()
            bad = [c.name for c in res.checks if c.status in (FAIL, ERROR)]
            rev = [c.name for c in res.checks if c.status == REVIEW]
            parts = [f"{cnt.get(PASS, 0)} pass", f"{cnt.get(FAIL, 0)} fail", f"{cnt.get(REVIEW, 0)} review"]
            res.summary = ", ".join(parts)
            if bad:
                res.summary += " | FAIL: " + "; ".join(bad[:4])
            elif rev:
                res.summary += " | REVIEW: " + "; ".join(rev[:4])
        res.duration_ms = (time.perf_counter() - t0) * 1000.0
        return res

    def analyze(self, row: RowInput, res: AnalysisResult):  # pragma: no cover
        raise NotImplementedError

    def add(self, res: AnalysisResult, name: str, status: str, expected: Any = "", actual: Any = "",
            note: str = "", evidence: Optional[List[Evidence]] = None) -> Check:
        c = Check(name, status, str(expected or ""), str(actual or ""), note.strip(), [e for e in (evidence or []) if e])
        res.checks.append(c)
        return c

    def dev_status(self) -> str:
        """Status for deviations from Vector's recommended safety subset."""
        return FAIL if self.s.strict else REVIEW

    def table(self, res: AnalysisResult, name: str, headers: List[str], rows: List[List[Any]]):
        if rows:
            res.details.append({"name": name, "headers": headers, "rows": rows})

    # -------------------------------------------------------------- helpers
    def comp_fids(self, comp: str) -> Optional[List[int]]:
        f = self.rte.comp_files.get(comp)
        return list(f) if f else None

    def usage(self, comp: str, symbol: str, limit: int = 6) -> Tuple[List[Evidence], str, str]:
        fids = self.comp_fids(comp) if comp else None
        note = ""
        if fids:
            hits = self.idx.token_hits(symbol, fids)
        else:
            hits = [h for h in self.idx.token_hits(symbol) if not self.idx.files[h[0]].is_rte]
            if comp:
                note = f"No source file includes Rte_{comp}.h - searched all application sources. "
        if not hits and fids:
            other = [h for h in self.idx.token_hits(symbol) if not self.idx.files[h[0]].is_rte]
            if other:
                note += f"Found only outside {comp} sources: {self.idx.rel(other[0][0])}. "
                hits = other
        ev = [self.idx.ev(f, l, title=f"{symbol} used") for f, l in hits[:limit]]
        return ev, (PASS if hits else REVIEW), note + ("" if hits else f"{symbol} not called in the component source.")

    def suggest(self, comp: str, api: str) -> str:
        pool = self.rte.comp_apis(comp) if comp in self.rte.components else \
            [a for c in self.rte.components for a in self.rte.comp_apis(c)]
        close = difflib.get_close_matches(api, pool, n=3, cutoff=0.6)
        return f" Did you mean: {', '.join(close)}?" if close else ""

    def resolve_with_checks(self, res: AnalysisResult, comp: str, api: str, label: str = "") -> ApiRes:
        R = self.rte.resolve(comp, api)
        ce = R.comp or comp
        pre = f"{label}: " if label else ""
        if not api.startswith(("Rte_", "RTE_")):
            d = self.def_ev(api, ce)
            self.add(res, f"{pre}Runnable defined in component source", PASS if d else FAIL, f"{api}() in {ce or 'SWC'}",
                     d.ref if d else "not found", evidence=[d] if d else [])
        else:
            ev, st, note = self.usage(ce, api)
            self.add(res, f"{pre}API used in component source", st, f"{api} called in {ce or 'SWC'} source",
                     f"{len(ev)} call site(s)" + (f" in {ev[0].file}" if ev else ""), note, ev)
        if R.found:
            chain = " -> ".join(e.title.replace("#define ", "") for e in R.chain)
            self.add(res, f"{pre}API implemented by generated RTE", PASS, "RTE API definition (macro / function)",
                     chain or R.func or R.direct_target, R.note, R.chain)
        else:
            self.add(res, f"{pre}API implemented by generated RTE", FAIL, "RTE API definition (macro / function)",
                     "not found", (R.note or "") + self.suggest(ce, api), R.chain)
        return R

    def check_owner(self, res: AnalysisResult, R: ApiRes, comp: str, label: str):
        """Verify the API really belongs to the component given in the request."""
        if not R.found or not R.api.startswith("Rte_"):
            return
        if not comp:
            self.add(res, f"{label} component", INFO, "", f"derived: {R.comp or '?'}")
        elif R.comp and R.comp.lower() == comp.lower():
            self.add(res, f"{label} component owns the API", PASS, f"{R.api} in Rte_{comp}.h", f"Rte_{R.comp}.h")
        else:
            self.add(res, f"{label} component owns the API", FAIL, f"{R.api} in Rte_{comp}.h",
                     f"API is declared for {R.comp or 'another component'}", "Check the component / API pair.")

    def find_target(self, R: ApiRes, target: str, depth: int = 3) -> List[Tuple[str, str, int]]:
        """Where does the API implementation reach `target` (function call or variable access)?"""
        hits: List[Tuple[str, str, int]] = []
        if not target:
            return hits
        if R.direct_target == target:
            hits.append(("direct mapping", "", 0))
        frontier, seen = ([R.func] if R.func else []), set()
        for _ in range(depth):
            nxt = []
            for f in frontier:
                if f in seen:
                    continue
                seen.add(f)
                an = self.rte.funcs.get(f, {})
                for callee, line in an.get("calls", []):
                    if callee == target:
                        hits.append(("call", f, line))
                    elif callee in self.rte.funcs and callee.startswith("Rte_"):
                        nxt.append(callee)
                for v, line in an.get("writes", []):
                    if v == target:
                        hits.append(("write", f, line))
                if target in an.get("reads", []) or any(target in p.split(".") for p in an.get("paths", [])):
                    hits.append(("read", f, self._line_of(f, target)))
            frontier = nxt
        return hits

    def _line_of(self, fname: str, token: str) -> int:
        an = self.rte.funcs.get(fname, {})
        if an.get("fid", -1) < 0:
            return 0
        rx = re.compile(r"\b" + re.escape(token) + r"\b")
        ls = self.idx.lines(an["fid"])
        for i in range(an["start"], min(len(ls), an["end"]) + 1):
            if rx.search(ls[i - 1]):
                return i
        return an["start"]

    def type_of_partner(self, p: Partner) -> str:
        if p.comp in self.rte.components:
            r = self.rte.resolve(p.comp, p.api)
            if r.data_type:
                return r.data_type
        an = self.rte.funcs.get(p.func, {})
        prm = parse_params(an.get("params", "")) if an and not an.get("is_macro") else []
        if prm:
            pick = next((x for x in prm if x["name"].lower() == "data"), prm[0])
            return pick["type"]
        for b in [w for w, _ in an.get("writes", [])] + an.get("reads", []):
            if self.rte.is_global(b):
                return self.rte.global_type(b)
        return ""

    def split_port_de(self, comp: str, api: str) -> Tuple[str, str]:
        m = API_KIND_RE.match(api or "")
        if not m:
            return "", ""
        rest = api[m.end():]
        if m.group(1) in ("IRead", "IWrite", "IWriteRef", "IStatus", "IInvalidate"):
            # Rte_IRead_<runnable>_<port>_<de>
            for r in self.rte.runnables.get(comp, {}):
                if rest.startswith(r + "_"):
                    rest = rest[len(r) + 1:]
                    break
        sw = self.ctx.arxml.swc(comp) if self.ctx.arxml.swcs else None
        if sw:
            for p in sorted(sw["ports"], key=lambda x: -len(x["name"])):
                if rest.startswith(p["name"] + "_"):
                    return p["name"], rest[len(p["name"]) + 1:]
        if "_" in rest:
            a, b = rest.rsplit("_", 1)
            return a, b
        return rest, ""

    def conv_hints(self, funcs: Iterable[str]) -> List[Tuple[str, str, str, int]]:
        out, seen = [], set()
        for f in funcs:
            if not f or f in seen:
                continue
            seen.add(f)
            for kind, text, line in self.rte.funcs.get(f, {}).get("conv", []):
                out.append((f, kind, text, line))
        return out

    def conv_evidence(self, hints) -> List[Evidence]:
        ev = []
        for f, kind, text, line in hints[:4]:
            an = self.rte.funcs.get(f, {})
            if an.get("fid", -1) >= 0:
                ev.append(self.idx.ev(an["fid"], line, title=f"{kind} in {f}"))
        return ev

    def func_ev(self, fname: str, title: str = "", line: int = 0) -> Optional[Evidence]:
        if fname.startswith("alias:"):
            _, comp, short = fname.split(":", 2)
            md = self.rte.comp_macros.get(comp, {}).get(short)
            return self.idx.ev(md[0], md[1], title=title or f"#define {short}") if md else None
        an = self.rte.funcs.get(fname)
        if not an or an.get("fid", -1) < 0:
            return None
        if line:
            return self.idx.ev(an["fid"], line, title=title or fname)
        return self.rte.func_evidence(fname, title or fname)

    def def_ev(self, symbol: str, comp: str = "", title: str = "") -> Optional[Evidence]:
        fids = set(self.comp_fids(comp) or [])
        defs = [d for d in self.idx.funcdefs.get(symbol, []) if not self.idx.files[d[0]].is_rte]
        defs.sort(key=lambda d: 0 if d[0] in fids else 1)
        if not defs:
            return None
        d = defs[0]
        return self.idx.ev(d[0], d[1], title=title or f"{symbol}() definition", hl=(d[1],), ctx=3)

    def partner_label(self, p: Partner) -> str:
        return f"{p.comp}\n{p.api}"

    def partner_rows(self, plist: List[Partner]) -> List[List[Any]]:
        rows = []
        for p in plist:
            ref = f"{self.idx.rel(p.fid)}:{p.line}" if p.fid >= 0 else ""
            rows.append([p.role, p.comp, p.api, p.func.replace("macro:", "#define "), ref, p.via,
                         "yes" if p.external else "", sig_from_handle(p.signal)])
        return rows


# =============================================================================
#  SMI-324 Sender/Receiver non-queued
# =============================================================================
class SrNonQueuedAnalyzer(BaseAnalyzer):
    key = "SMI-324_NQ"

    def pick(self, row: RowInput) -> Tuple[str, str]:
        if row.api:
            k = api_kind(row.api)
            comp = row.component or (row.src_component if k in WRITE_KINDS else row.dst_component)
            return comp, row.api
        if row.dst_api:
            return row.dst_component or row.component, row.dst_api
        if row.src_api:
            return row.src_component or row.component, row.src_api
        return row.component, ""

    def analyze(self, row: RowInput, res: AnalysisResult):
        if row.src_api and row.dst_api:
            self.analyze_pair(row, res)
            return
        comp, api = self.pick(row)
        if not api:
            self.add(res, "Input", ERROR, note="Write API (source) and Read API (destination) are required")
            return
        R = self.resolve_with_checks(res, comp, api)
        if not R.found:
            return
        self.check_pattern(res, R)
        P = self.rte.sr_partners(R)
        self.check_partners(res, R, P, row)
        self.check_expected(res, P, row)
        self.check_types(res, R, P)
        self.check_conversion(res, R, P)
        self.partition_info(res, P)
        self.diagram(res, R, P)

    # ------------------------------------------------------------ pair mode
    def analyze_pair(self, row: RowInput, res: AnalysisResult):
        sc, sa = row.src_component.strip(), row.src_api.strip()
        dc, da = row.dst_component.strip(), row.dst_api.strip()
        if api_kind(sa) in READ_KINDS and api_kind(da) in WRITE_KINDS:
            sc, sa, dc, da = dc, da, sc, sa
            self.add(res, "Input order", INFO, "", "Write/Read columns were swapped - corrected automatically")
        W = self.resolve_with_checks(res, sc, sa, "Source write API")
        Rd = self.resolve_with_checks(res, dc, da, "Destination read API")
        self.check_owner(res, W, sc, "Source")
        self.check_owner(res, Rd, dc, "Destination")
        if not (W.found and Rd.found):
            return
        if W.kind not in WRITE_KINDS:
            self.add(res, "Source API kind", REVIEW, "Rte_Write / Rte_IWrite", W.kind or "unknown")
        if Rd.kind not in READ_KINDS:
            self.add(res, "Destination API kind", REVIEW, "Rte_Read / Rte_IRead / Rte_DRead", Rd.kind or "unknown")
        self.check_pattern(res, W, "source")
        self.check_pattern(res, Rd, "destination")
        Pw, Pr = self.rte.sr_partners(W), self.rte.sr_partners(Rd)
        common = sorted(set(Pw["buffers"]) & set(Pr["buffers"]))
        rd_in = any(p.func == Rd.func for p in Pw["receivers"])
        ev = []
        anw = self.rte.funcs.get(W.func, {})
        for b in common[:2]:
            ln = next((l for v, l in anw.get("writes", []) if v == b), 0)
            e = self.func_ev(W.func, f"{sa} writes {b}", ln) if ln else self.func_ev(W.func, f"{sa} writes {b}")
            if e:
                ev.append(e)
            e = self.func_ev(Rd.func, f"{da} reads {b}", self._line_of(Rd.func, b))
            if e:
                ev.append(e)
        for buf, cf, line in Pr["copies"][:2]:
            e = self.func_ev(cf, f"Implicit copy of {buf} in {cf}", line)
            if e:
                ev.append(e)
        if common or rd_in:
            self.add(res, "Write and read API connected", PASS, f"{sa} -> {da}",
                     f"shared RTE buffer: {', '.join(common) or '(direct)'}", evidence=ev)
        else:
            src = ", ".join(dict.fromkeys(f"{p.comp}:{p.api}" for p in Pr["senders"])) or "-"
            self.add(res, "Write and read API connected", FAIL, f"{sa} -> {da}",
                     f"no shared buffer (write: {', '.join(Pw['buffers']) or '-'} / read: {', '.join(Pr['buffers']) or '-'})",
                     f"The read API receives its data from: {src}" + (" (COM / other ECU)" if Pr["com"] else ""))
        snd = list(dict.fromkeys(p.comp for p in Pr["senders"]))
        extra = [c for c in snd if c.lower() != (W.comp or sc).lower()]
        sev = [self.func_ev(p.func, f"sender {p.comp}: {p.api}") for p in Pr["senders"][:4]]
        if not any(c.lower() == (W.comp or sc).lower() for c in snd):
            self.add(res, "List of senders for the receiver", FAIL, f"only {W.comp or sc}",
                     ", ".join(snd) or "no sender", "The source component does not write the receiver's data.", sev)
        elif extra:
            self.add(res, "List of senders for the receiver", self.dev_status(), f"only {W.comp or sc}",
                     ", ".join(snd), f"Additional senders {extra} (N:1) - Vector recommends only 1:1 or 1:N.", sev)
        else:
            self.add(res, "List of senders for the receiver", PASS, f"only {W.comp or sc}", ", ".join(snd), evidence=sev)
        rcv = list(dict.fromkeys(p.comp for p in Pw["receivers"]))
        conn = "1:1" if len(rcv) <= 1 else f"1:N ({len(rcv)} receivers)"
        self.add(res, "Receivers of the source data", INFO, "", f"{conn}: {', '.join(rcv) or '-'}")
        self.table(res, "Senders of the read data", ["Role", "Component", "API", "RTE function", "Location",
                                                     "Via buffer", "External", "COM signal"], self.partner_rows(Pr["senders"]))
        self.table(res, "Receivers of the written data", ["Role", "Component", "API", "RTE function", "Location",
                                                          "Via buffer", "External", "COM signal"],
                   self.partner_rows(Pw["receivers"]))
        pair = {"senders": [self.rte.partner_from_func(W.func, "sender")],
                "receivers": [self.rte.partner_from_func(Rd.func, "receiver")]}
        self.check_types(res, W, pair)
        both = {"senders": Pr["senders"], "receivers": Pw["receivers"] + pair["receivers"]}
        self.check_conversion(res, W, both)
        self.partition_info(res, both)
        res.diagrams.append({"type": "connection", "title": f"SMI-324 S/R: {sa} -> {da}",
                             "left": [self.partner_label(p) for p in Pr["senders"]] or [f"{W.comp}\n{sa}"],
                             "center": "\n".join(common[:2]) or "no shared buffer",
                             "right": [self.partner_label(p) for p in Pw["receivers"]] or [f"{Rd.comp}\n{da}"],
                             "highlight": [W.comp, Rd.comp]})

    # ------------------------------------------------------------ helpers
    def check_pattern(self, res, R: ApiRes, side: str = ""):
        k = R.kind
        name = f"Communication pattern ({side})" if side else "Communication pattern"
        if k in ("Read", "Write", "DRead"):
            self.add(res, name, PASS, "Explicit non-queued S/R", f"Explicit ({k})")
        elif k in IMPLICIT_KINDS:
            ev = []
            src = self.rte.implicit_sources(R.func) if k not in WRITE_KINDS else []
            for buf, cf, line in src[:3]:
                e = self.func_ev(cf, f"Implicit copy {buf} in {cf}", line)
                if e:
                    ev.append(e)
            self.add(res, name, REVIEW, "Explicit non-queued S/R", f"Implicit ({k}) - task-level buffer copy",
                     "For implicit communication the buffering in the RTE needs to be considered (copy "
                     "points relative to the runnable execution).", ev)
        elif k in ("Send", "Receive"):
            self.add(res, name, REVIEW, "Explicit non-queued S/R", f"Queued ({k})",
                     "Queued API - SMI-324 non-queued rules do not fully apply.")
        else:
            self.add(res, name, REVIEW, "Sender/receiver API", k or "unknown API kind")

    def check_partners(self, res, R: ApiRes, P, row):
        snd, rcv = P["senders"], P["receivers"]
        ns, nr = len({p.comp for p in snd}), len({p.comp for p in rcv})
        conn = ("1:1" if ns == 1 and nr == 1 else "1:N" if ns == 1 and nr > 1 else
                "N:1" if ns > 1 and nr == 1 else f"N:M ({ns}:{nr})" if ns and nr else f"{ns}:{nr}")
        ev = []
        for p in (snd + rcv)[:6]:
            if p.func != R.func:
                e = self.func_ev(p.func, f"{p.role}: {p.comp} {p.api}")
                if e:
                    ev.append(e)
        uniq = lambda lst: ", ".join(dict.fromkeys(p.comp for p in lst)) or "-"
        actual = f"{conn}  senders: {uniq(snd)}  receivers: {uniq(rcv)}  buffer: {', '.join(P['buffers']) or '-'}"
        external = bool(P["com"]) or any(p.external for p in snd + rcv)
        if ns == 0 or nr == 0 or (ns + nr) < 2:
            st = REVIEW
            note = ("Partner is on another ECU (COM) - verify with SMI-2065." if external else
                    "No connected partner found in the generated RTE (unconnected port or unsupported pattern).")
        elif ns == 1:
            st, note = PASS, "Connection type within Vector recommended subset (1:1 / 1:N)."
        else:
            st, note = self.dev_status(), "Vector recommends only 1:1 or 1:N connections for safety-related SWCs."
        if P["init"]:
            note += f" (RTE init writes ignored: {', '.join(sorted({f for f, _ in P['init']}))})"
        self.add(res, "Connection type / list of senders", st, "1:1 or 1:N, correct senders for every receiver",
                 actual, note, ev)
        self.table(res, "Connection partners", ["Role", "Component", "API", "RTE function", "Location", "Via buffer",
                                                "External", "COM signal"], self.partner_rows(snd + rcv))

    def check_expected(self, res, P, row: RowInput):
        snd, rcv = P["senders"], P["receivers"]
        exp, bad = [], []
        if row.src_component:
            exp.append(f"sender={row.src_component}")
            if not any(p.comp.lower() == row.src_component.lower() for p in snd):
                bad.append(f"expected sender {row.src_component} not connected")
            extra = sorted({p.comp for p in snd if p.comp.lower() != row.src_component.lower()})
            if extra:
                bad.append(f"additional senders {extra}")
        if row.dst_component:
            exp.append(f"receiver={row.dst_component}")
            if not any(p.comp.lower() == row.dst_component.lower() for p in rcv):
                bad.append(f"expected receiver {row.dst_component} not connected")
        if exp:
            self.add(res, "Expected source / destination", FAIL if bad else PASS, ", ".join(exp),
                     "; ".join(bad) or "as expected")

    def check_types(self, res, R: ApiRes, P):
        rows, names = [], {}
        for p in P["senders"] + P["receivers"]:
            t = R.data_type if p.func == R.func else self.type_of_partner(p)
            ti = type_info(t, self.rte.typedefs())
            ax = ""
            if self.ctx.arxml.swcs and p.comp in self.rte.components:
                port, de = self.split_port_de(p.comp, p.api)
                et = self.ctx.arxml.element_type(p.comp, port, de)
                ax = "/".join(x for x in (et["app"], et["impl"]) if x)
            rows.append([p.role, p.comp, p.api, t or "?", type_desc(ti), ax])
            names[(p.comp, p.api)] = (_tn(t), ti, ax)
        self.table(res, "Data types on both sides", ["Role", "Component", "API", "C type", "Resolved", "ARXML app/impl"], rows)
        tset = {v[0] for v in names.values() if v[0]}
        axset = {v[2] for v in names.values() if v[2]}
        if len(names) < 2:
            self.add(res, "Same datatype on both sides", REVIEW, "identical datatype", ", ".join(tset) or "?",
                     "Only one side found.")
            return
        if len(tset) <= 1 and len(axset) <= 1 and tset:
            self.add(res, "Same datatype on both sides", PASS, "identical datatype", next(iter(tset)))
            return
        bases = {(v[1].get("bits"), v[1].get("signed"), v[1].get("float"), v[1].get("struct")) for v in names.values()}
        if len(tset) > 1 and len(bases) == 1 and len(axset) <= 1:
            self.add(res, "Same datatype on both sides", REVIEW, "identical datatype", " vs ".join(sorted(tset)),
                     "Different type names with identical base type - confirm equivalence.")
        else:
            self.add(res, "Same datatype on both sides", FAIL, "identical datatype",
                     " vs ".join(sorted(tset | axset)), "Datatype differs between connected ports.")

    def check_conversion(self, res, R: ApiRes, P, name: str = "No data conversion on connection"):
        funcs = ([R.func] if R and R.func else []) + [p.func for p in P["senders"] + P["receivers"]]
        hints = self.conv_hints(funcs)
        if not hints:
            self.add(res, name, PASS, "no conversion code in RTE data path", "none detected")
        else:
            self.add(res, name, self.dev_status(), "no conversion code in RTE data path",
                     "; ".join(f"{f}: {t}" for f, k, t, l in hints[:3]),
                     "Vector recommends avoiding data conversion for safety-related connections.",
                     self.conv_evidence(hints))
        return hints

    def partition_info(self, res, P):
        files = sorted({self.idx.rel(p.fid) for p in P["senders"] + P["receivers"] if p.fid >= 0})
        self.add(res, "Partition / plausibility note", INFO, "", "Implementation files: " + ", ".join(files),
                 "Information used from non-safety-related SWCs has to be checked for plausibility; other code in "
                 "the same partition can corrupt the communication if freedom from interference is not ensured.")

    def diagram(self, res, R, P, title: str = ""):
        res.diagrams.append({"type": "connection", "title": title or f"{self.key}: {R.api}",
                             "left": [self.partner_label(p) for p in P["senders"]] or ["?"],
                             "center": "\n".join(P["buffers"][:2]) or "RTE",
                             "right": [self.partner_label(p) for p in P["receivers"]] or ["?"],
                             "highlight": R.comp})


# =============================================================================
#  SMI-2123 data conversion
# =============================================================================
class ConversionAnalyzer(SrNonQueuedAnalyzer):
    key = "SMI-2123"

    def analyze(self, row: RowInput, res: AnalysisResult):
        comps = [c for c in split_list(row.component)]
        api = (row.api or row.src_api or row.dst_api).strip()
        api = re.sub(r"\(.*$", "", api)
        if not api:
            self.add(res, "Input", ERROR, note="RTE (API or RTE variable) is required")
            return
        if self.rte.is_global(api) and not api_kind(api):
            self.analyze_buffer(res, comps, api)
            return
        comp = next((c for c in comps if api in self.rte.comp_macros.get(c, {})), comps[0] if comps else "")
        R = self.resolve_with_checks(res, comp, api)
        if comp:
            self.check_owner(res, R, comp, "Given")
        if not R.found:
            return
        if R.kind in ("Call", "Result"):
            T = self.rte.server_targets(R)
            hints = self.conv_hints([R.func])
            self.add(res, "Connected SWCs", INFO, "", f"server(s): {', '.join(T['servers']) or '-'}")
            self.add(res, "RTE data conversion on connection", PASS if not hints else self.dev_status(),
                     "no conversion", "none" if not hints else "; ".join(h[2] for h in hints[:3]),
                     evidence=self.conv_evidence(hints))
            return
        P = self.rte.sr_partners(R)
        self.evaluate(res, R, P, comps, f"SMI-2123 data conversion: {R.api}")

    def analyze_buffer(self, res, comps: List[str], buf: str):
        g = self.idx.rte_globals[buf]
        self.add(res, "RTE variable found", PASS, f"declaration of {buf}", f"{g[2]} {buf} ({self.idx.rel(g[0])}:{g[1]})",
                 evidence=[self.idx.ev(g[0], g[1], title=f"{buf} declaration")])
        P = self.rte.buffer_partners(buf)
        R = ApiRes(comp=comps[0] if comps else "", api=buf, found=True, data_type=g[2])
        self.evaluate(res, R, P, comps, f"SMI-2123 data conversion: {buf}")

    def evaluate(self, res, R: ApiRes, P, comps: List[str], title: str):
        snd, rcv = P["senders"], P["receivers"]
        self.add(res, "Connected SWCs identified", PASS if snd and rcv else REVIEW, "all connected SWCs",
                 f"senders: {', '.join(dict.fromkeys(p.comp for p in snd)) or '-'} | receivers: "
                 f"{', '.join(dict.fromkeys(p.comp for p in rcv)) or '-'}",
                 "" if snd and rcv else "Partner side not found in this ECU (COM / unconnected).")
        if len(comps) > 1 or (comps and R.api == (P["buffers"][0] if P["buffers"] else "")):
            connected = {p.comp.lower() for p in snd + rcv}
            missing = [c for c in comps if c.lower() not in connected]
            self.add(res, "Listed components are connected", FAIL if missing else PASS, ", ".join(comps),
                     "all connected" if not missing else f"not connected: {', '.join(missing)}")
        self.table(res, "Connection partners", ["Role", "Component", "API", "RTE function", "Location", "Via buffer",
                                                "External", "COM signal"], self.partner_rows(snd + rcv))
        hints = self.check_conversion(res, R, P, "RTE data conversion on connection")
        self.check_types(res, R, P)
        for c in res.checks:
            if c.name == "Same datatype on both sides":
                c.name = "All connected SWCs expect the same data(type)"
        self.arxml_conversion(res, R, P)
        if hints:
            self.add(res, "Verification of conversion", REVIEW, "review / integration test of every conversion",
                     f"{len(hints)} conversion statement(s)",
                     "Verify by review or integration testing that every connected SWC expects the converted value.")
        self.diagram(res, R, P, title)

    def arxml_conversion(self, res, R: ApiRes, P):
        ax = self.ctx.arxml
        if not ax.swcs:
            return
        rows, compus = [], set()
        for p in P["senders"] + P["receivers"]:
            if p.comp not in self.rte.components:
                continue
            port, de = self.split_port_de(p.comp, p.api)
            et = ax.element_type(p.comp, port, de)
            cm = et.get("compu") or {}
            compus.add((cm.get("category"), cm.get("factor"), cm.get("offset")) if cm else None)
            rows.append([p.role, p.comp, port, de, et["app"], et["impl"], cm.get("name", "") if cm else "",
                         cm.get("category", "") if cm else "", fmt_num(cm.get("factor")) if cm else "",
                         fmt_num(cm.get("offset")) if cm else ""])
        if not rows:
            return
        self.table(res, "ARXML data types / CompuMethods", ["Role", "Component", "Port", "Data element", "App type",
                                                             "Impl type", "CompuMethod", "Category", "Factor", "Offset"], rows)
        pim = [m for m in ax.pim if m.get("texttable") or m.get("data_maps")]
        if len(compus - {None}) > 1:
            self.add(res, "ARXML conversion configuration", self.dev_status(), "identical CompuMethods on both sides",
                     f"{len(compus - {None})} different CompuMethods", "Different physical semantics -> RTE conversion.")
        elif pim:
            self.add(res, "ARXML conversion configuration", REVIEW, "no port interface mapping with conversion",
                     f"{len(pim)} port interface mapping(s) in project", "Check whether a mapping applies to this connector.")
        else:
            self.add(res, "ARXML conversion configuration", PASS, "identical CompuMethods on both sides", "consistent")


# =============================================================================
#  SMI-324 Client/Server
# =============================================================================
class ClientServerAnalyzer(BaseAnalyzer):
    key = "SMI-324_CS"

    def analyze(self, row: RowInput, res: AnalysisResult):
        comp = (row.src_component or row.component).strip()
        api = (row.api or row.src_api).strip()
        target = re.sub(r"\(.*$", "", (row.call_target or "").strip())
        if not api:
            self.add(res, "Input", ERROR, note="API (Rte_Call_<port>_<operation>) is required")
            return
        if api_kind(api) not in ("Call", "Result"):
            self.add(res, "API kind", REVIEW, "Rte_Call / Rte_Result", api_kind(api) or "unknown")
        R = self.resolve_with_checks(res, comp, api, "Client API")
        self.check_owner(res, R, comp, "Source (client)")
        if not R.found:
            return
        T = self.rte.server_targets(R)
        direct = bool(R.direct_target) or (R.func or "").startswith("macro:")
        mode = "direct function call (same partition)" if direct else f"RTE function {R.func}"
        if target:
            server = self.check_call_target(res, R, target, mode)
        else:
            server = self.check_server(res, R, T, mode)
        scomp = self.rte.runnable_owner.get(server, "") if server else ""
        if row.dst_component or row.runnable:
            bad = []
            if row.dst_component and scomp.lower() != row.dst_component.lower():
                bad.append(f"server component is {scomp or '?'}")
            if row.runnable and row.runnable != server:
                bad.append(f"server runnable is {server or '?'}")
            self.add(res, "Expected server", FAIL if bad else PASS,
                     ", ".join(x for x in (row.dst_component, row.runnable) if x), "; ".join(bad) or "as expected")
        if server and not self.rte.is_global(server):
            clients = sorted({self.rte.comp_of(f)[0] for f, _ in self.rte.call_sites(server)})
            self.add(res, "Clients of this server", INFO, "", ", ".join(clients) or "-",
                     "N clients : 1 server is the normal client/server topology.")
        hints = self.conv_hints([R.func])
        self.add(res, "No data conversion on connection", PASS if not hints else self.dev_status(),
                 "no conversion code", "none detected" if not hints else "; ".join(h[2] for h in hints[:3]),
                 evidence=self.conv_evidence(hints))
        res.diagrams.append({"type": "connection", "title": f"SMI-324 C/S: {R.api}",
                             "left": [f"{R.comp or comp}\n{R.api}"],
                             "center": "direct call" if direct else R.func,
                             "right": [f"{scomp or ('RTE variable' if self.rte.is_global(server) else 'target')}\n"
                                       f"{server or target or '?'}"], "highlight": R.comp or comp})

    def check_call_target(self, res, R: ApiRes, target: str, mode: str) -> str:
        hits = self.find_target(R, target)
        ev = []
        for how, f, line in hits[:4]:
            if how == "direct mapping":
                ev.append(R.chain[-1] if R.chain else None)
            else:
                ev.append(self.func_ev(f, f"{how} {target} in {f.replace('macro:', '#define ')}", line))
        is_var = self.rte.is_global(target) or (hits and all(h[0] in ("read", "write") for h in hits))
        kind = "variable" if is_var else "function"
        if hits:
            how = ", ".join(dict.fromkeys(h[0] for h in hits))
            self.add(res, "Call function / variable reached", PASS, f"{R.api} reaches {target}",
                     f"{kind} {target}: {how} via {mode}", evidence=ev)
        else:
            T = self.rte.server_targets(R)
            reached = T["servers"] or [c for c, _ in T["calls"] if not c.startswith(("Rte_", "Os", "Suspend", "Resume"))]
            self.add(res, "Call function / variable reached", FAIL, f"{R.api} reaches {target}",
                     f"reaches: {', '.join(dict.fromkeys(reached)) or '-'}",
                     f"{target} is not called / accessed by the Rte_Call implementation.",
                     [e for e in R.chain[-1:]])
            return ""
        # location of the target
        if is_var:
            g = self.idx.rte_globals.get(target)
            if g:
                self.add(res, "Call target location", PASS, f"declaration of {target}",
                         f"{g[2]} {target} ({self.idx.rel(g[0])}:{g[1]})", evidence=[self.idx.ev(g[0], g[1], title=f"{target}")])
                t_api, t_var = _tn(R.data_type), _tn(g[2])
                if t_api and t_var:
                    self.add(res, "Argument datatypes (client vs target)", PASS if t_api == t_var else FAIL,
                             "identical datatype", f"API {R.data_type} / variable {g[2]}")
            else:
                self.add(res, "Call target location", REVIEW, f"declaration of {target}", "not found in RTE globals")
            return target
        d = self.idx.nonrte_funcdef(target)
        owner = self.rte.runnable_owner.get(target, "")
        if d:
            if not owner:
                for c, fids in self.rte.comp_files.items():
                    if d[0] in fids:
                        owner = c
                        break
            self.add(res, "Call target location", PASS, f"definition of {target}()",
                     f"{self.idx.rel(d[0])}:{d[1]}" + (f" (component {owner})" if owner else ""),
                     evidence=[self.def_ev(target, owner, f"{target}() definition")])
        elif target in self.idx.rte_protos:
            p = self.idx.rte_protos[target][0]
            self.add(res, "Call target location", INFO, f"definition of {target}()",
                     f"declared in {self.idx.rel(p[0])}:{p[1]} - definition not in sandbox (library)",
                     evidence=[self.idx.ev(p[0], p[1], title=f"{target}() prototype", ctx=1)])
        else:
            self.add(res, "Call target location", REVIEW, f"definition of {target}()", "not found in sandbox")
        self.check_args(res, R, target)
        return target

    def check_server(self, res, R: ApiRes, T, mode: str) -> str:
        servers = T["servers"]
        ev = [self.def_ev(s, self.rte.runnable_owner.get(s, ""), f"Server runnable {s}()") for s in servers]
        if servers:
            owners = [f"{s} ({self.rte.runnable_owner.get(s, '?')})" for s in servers]
            self.add(res, "Server runnable reached", PASS if len(servers) == 1 else REVIEW, "exactly one server runnable",
                     ", ".join(owners) + f" via {mode}", "" if len(servers) == 1 else "Several functions called.", ev)
        elif T["async"]:
            aev = [self.func_ev(R.func, f"{a[0]} in {R.func}", a[2]) for a in T["async"][:3]]
            self.add(res, "Server runnable reached", REVIEW, "exactly one server runnable",
                     "asynchronous / cross-partition invocation: " + ", ".join(a[0] for a in T["async"]),
                     "Server is triggered via OS event / trusted function; server runnable could not be resolved.", aev)
        else:
            self.add(res, "Server runnable reached", FAIL, "exactly one server runnable", "none",
                     "The Rte_Call implementation does not call a server runnable.")
        server = servers[0] if servers else ""
        if server:
            self.check_args(res, R, server)
        return server

    def _target_params(self, target: str) -> List[Dict[str, Any]]:
        d = self.idx.nonrte_funcdef(target)
        if d:
            return parse_params(d[4])
        if target in self.idx.rte_protos:
            return parse_params(self.idx.rte_protos[target][0][3])
        return []

    def check_args(self, res, R: ApiRes, target: str):
        tp = self._target_params(target)
        cp = R.params if not R.direct_target else []
        name = "Argument datatypes (client vs target)"
        fmt = lambda ps: ", ".join(f"{p['type']}{'*' if p['ptr'] else ''} {p['name']}".strip() for p in ps) or "void"
        if R.direct_target or not cp:
            if R.direct_target:
                note = "Direct mapping - client uses the target prototype itself."
            elif (R.func or "").startswith("macro:"):
                note = "RTE macro forwards the client arguments to the target."
            else:
                note = "Client prototype not found; target prototype shown."
            self.add(res, name, PASS if tp or R.direct_target else REVIEW, "identical argument types", fmt(tp), note)
            return
        n = len(cp)
        tail = tp[-n:] if len(tp) >= n else tp
        extra = len(tp) - n
        rows, ok = [], len(tail) == n
        for i in range(max(n, len(tail))):
            a = cp[i] if i < n else None
            b = tail[i] if i < len(tail) else None
            same = bool(a and b) and ((_tn(a["type"]), a["ptr"]) == (_tn(b["type"]), b["ptr"]) or
                                      (b["ptr"] and _tn(b["type"]) == "void" and a["ptr"]))
            ok = ok and same
            rows.append([i + 1, a["raw"] if a else "-", b["raw"] if b else "-", "OK" if same else "DIFF"])
        self.table(res, "Client vs target arguments", ["#", "Client (Rte_Call)", "Target", "Result"], rows)
        note = f"{extra} port-defined leading argument(s) added by the RTE." if extra > 0 else ""
        self.add(res, name, PASS if ok else FAIL, "identical argument types",
                 f"client {n} args / target {len(tp)} args" + ("" if ok else " - mismatch"), note)


# =============================================================================
#  SMI-2063 executable entity scheduling
# =============================================================================
class EntityAnalyzer(BaseAnalyzer):
    key = "SMI-2063"
    DETERMINED = {"CYCLIC", "INIT", "BACKGROUND", "DATA_RECEIVED", "OPERATION_INVOKED", "MODE_SWITCH"}

    def analyze(self, row: RowInput, res: AnalysisResult):
        run = re.sub(r"\(.*$", "", (row.runnable or (row.api if row.api and not row.api.startswith("Rte_") else "")).strip())
        task = row.task.strip()
        if not run:
            self.add(res, "Input", ERROR, note="Runnable is required")
            return
        owner = self.rte.runnable_owner.get(run, "")
        comp = row.component or owner
        dev = self.def_ev(run, comp, f"Runnable {run}()")
        rm = self.rte.runnables.get(owner, {}).get(run)
        evs = [dev] + ([self.idx.ev(rm[0], rm[1], title=f"RTE_RUNNABLE_{run} in Rte_{owner}.h")] if rm else [])
        if dev and (not row.component or not owner or owner == row.component):
            self.add(res, "Runnable defined in component", PASS, f"{run} in {comp or 'SWC'}",
                     f"{dev.ref} (component {owner or '?'})", evidence=evs)
        elif dev:
            self.add(res, "Runnable defined in component", REVIEW, f"{run} in {row.component}",
                     f"declared by {owner}", "Runnable belongs to another component.", evs)
        else:
            self.add(res, "Runnable defined in component", FAIL, f"{run} in {comp or 'SWC'}", "definition not found",
                     evidence=evs)
        sites = self.collect_sites(run)
        if sites:
            self.add(res, "Runnable invoked by RTE", PASS, "call site in RTE task / API",
                     f"{len(sites)} call site(s): " + ", ".join(f"{s['func']}:{s['line']}" for s in sites[:4]))
        else:
            self.add(res, "Runnable invoked by RTE", FAIL, "call site in RTE task / API", "never called by the RTE")
        ax = self.arxml_events(comp, run)
        focus = self.check_task(res, task, sites, ax)
        self.check_trigger(res, row, focus, ax)
        self.check_timing(res, row, focus, ax)
        self.check_modes(res, row, focus, ax)
        if ax:
            self.check_consistency(res, focus, [e for e in ax if not task or not e["task"] or
                                                e["task"].lower() == task.lower()])
        fired = sorted({f"{self.rte.comp_of(f)[0]}:{self.rte.comp_of(f)[1]}" for s in focus for f in s["fired_by"]})
        if fired:
            self.add(res, "Triggered by RTE APIs", INFO, "", ", ".join(fired),
                     "Runnable is started by events set in these RTE APIs.")
        self.table(res, "RTE call sites", ["Function", "Line", "Trigger", "Events", "Cycle [ms]", "Offset [ms]",
                                           "Task", "Source", "Mode conditions", "Fired by"],
                   [[s["func"], s["line"], s["trigger"], ", ".join(s["events"]), fmt_num(s["cycle"]),
                     fmt_num(s["offset"]), s["task"], s.get("source", ""), " && ".join(s["modes"]),
                     ", ".join(s["fired_by"])] for s in sites])
        if ax:
            self.table(res, "ARXML RTE events", ["SWC", "Event", "Kind", "Period [ms]", "Offset [ms]", "Mapped task",
                                                 "Position", "Disabled modes", "Target"],
                       [[e["swc"], e["name"], e["kind"], fmt_num(e["period_ms"]), fmt_num(e["offset_ms"]), e["task"],
                         e["position"], ", ".join(e["modes"]), e["target"]] for e in ax])

    def check_task(self, res, task: str, sites, ax) -> List[Dict[str, Any]]:
        tasks = list(dict.fromkeys(s["task"] for s in sites if s["task"] and not s["task"].startswith("(")))
        ax_tasks = {e["task"] for e in ax if e["task"]}
        if not task:
            self.add(res, "Scheduled in OS task", INFO, "", ", ".join(tasks) or "-")
            return sites
        in_task = [s for s in sites if s["task"].lower() == task.lower()]
        ev = []
        for s in in_task[:3]:
            e = self.func_ev(s["func"], f"{s['func']}: {s['trigger']}", s["line"])
            if e:
                a = max(1, s["line"] - self.s.context_lines - 6)
                e.snippet = self.idx.snippet(self.idx.fid_by_rel[e.file], a, s["line"], 2)
                ev.append(e)
        others = [t for t in tasks if t.lower() != task.lower()]
        note = f"Also invoked in: {', '.join(others)}" if others else ""
        if in_task:
            self.add(res, "Scheduled in OS task", PASS, task, f"{len(in_task)} call site(s) in {in_task[0]['func']}",
                     note, ev)
            return in_task
        if task.lower() in {t.lower() for t in ax_tasks}:
            self.add(res, "Scheduled in OS task", REVIEW, task, f"mapped in ECUC, but no call site found in {task}",
                     note or "Generated task body not found / not parsed.")
        else:
            self.add(res, "Scheduled in OS task", FAIL, task, f"invoked in: {', '.join(tasks) or 'no task'}",
                     "Runnable is not scheduled in the given task.")
        return sites

    def collect_sites(self, run: str) -> List[Dict[str, Any]]:
        out = []
        for fname, line in self.rte.call_sites(run):
            s = {"func": fname, "line": line, "events": [], "modes": [], "task": "", "trigger": "",
                 "cycle": None, "offset": None, "fired_by": [], "context": [], "source": ""}
            if fname.startswith("alias:"):
                _, c, short = fname.split(":", 2)
                s.update(trigger="OPERATION_INVOKED", task="(caller context)", source=f"direct call via {short}")
                s["fired_by"].append(fname)
                out.append(s)
                continue
            ctx = self.rte.call_context(fname, line)
            s["context"] = ctx
            joined = " ".join(ctx)
            s["events"] = sorted(set(re.findall(r"\bRte_Ev\w+", joined)))
            s["modes"] = [h for h in ctx if re.search(r"Rte_ModeMachine|RTE_MODE_|Rte_Mode\w*|ModeDisabled", h)]
            an = self.rte.funcs.get(fname, {})
            if fname.startswith("TASK("):
                task = fname[5:-1].strip()
                s["task"] = task
                if s["events"]:
                    kinds = {classify_event(e) for e in s["events"]}
                    s["trigger"] = "/".join(sorted(kinds))
                    for e in s["events"]:
                        if classify_event(e) == "CYCLIC":
                            al = self.rte.alarm_for_event(e)
                            if al and al.get("cycle_ms") is not None:
                                s["cycle"], s["offset"] = al["cycle_ms"], al["offset_ms"]
                                s["source"] = f"alarm {al['alarm']}"
                            else:
                                s["offset"], s["cycle"] = event_name_timing(e)
                                s["source"] = f"event name {e}"
                        for f, t, l in self.rte.event_setters.get(e, []):
                            if not f.startswith("TASK(") and f not in s["fired_by"]:
                                s["fired_by"].append(f)
                        if not s["source"]:
                            s["source"] = f"event {e}"
                else:
                    waits = [l for o, a, l in an.get("os", []) if o in ("WaitEvent", "Rte_WaitGetClearEvent")]
                    tl = task.lower()
                    if waits and line < min(waits):
                        s["trigger"], s["source"] = "INIT", "called before the task event loop"
                    elif "init" in tl:
                        s["trigger"], s["source"] = "INIT", "init task"
                    elif any(k in tl for k in ("bg", "background", "idle")):
                        s["trigger"], s["source"] = "BACKGROUND", "background task"
                    else:
                        al = self.rte.alarm_for_task(task)
                        if al:
                            s["trigger"], s["cycle"], s["offset"] = "CYCLIC", al["cycle_ms"], al["offset_ms"]
                            s["source"] = f"alarm {al['alarm']} activates task"
                        elif waits:
                            s["trigger"] = "EVENT (unguarded)"
                        else:
                            s["trigger"] = "TASK_ACTIVATION"
                            s["fired_by"] = [f for f, _ in self.rte.task_activators.get(task, [])]
            elif INIT_FUNC_RE.match(fname):
                s["trigger"], s["source"] = "INIT", fname
            else:
                k = api_kind(self.rte.comp_of(fname)[1] or fname)
                s["trigger"] = {"Call": "OPERATION_INVOKED", "Write": "DATA_RECEIVED", "Send": "DATA_RECEIVED",
                                "Switch": "MODE_SWITCH"}.get(k, "RTE_API")
                s["fired_by"].append(fname)
                s["task"] = "(caller context)"
                s["source"] = f"direct call in {fname}"
            out.append(s)
        return out

    def arxml_events(self, comp: str, run: str) -> List[Dict[str, Any]]:
        ax = self.ctx.arxml
        if not ax.swcs:
            return []
        out = []
        for e in ax.events_for_runnable(comp, run):
            maps = ax.rte_event_mapping(e["path"], e["name"])
            m = maps[0] if maps else None
            off = to_float(ax.p(m, "RteActivationOffset"))
            e2 = dict(e)
            e2["period_ms"] = e["period"] * 1000.0 if e.get("period") is not None else None
            e2["offset_ms"] = (off * 1000.0 if off is not None else
                               (e["offset"] * 1000.0 if e.get("offset") is not None else None))
            e2["task"] = last_seg(ax.r(m, "RteMappedToTaskRef")[0]) if m and ax.r(m, "RteMappedToTaskRef") else ""
            e2["position"] = ax.p(m, "RtePositionInTask")
            out.append(e2)
        return out

    @staticmethod
    def describe(s: Dict[str, Any]) -> str:
        t = s["trigger"] or "?"
        if "CYCLIC" in t:
            t += f" {fmt_num(s['cycle'])} ms, offset {fmt_num(s['offset'])} ms"
        if s["fired_by"] and t in ("DATA_RECEIVED", "MODE_SWITCH", "OPERATION_INVOKED", "TASK_ACTIVATION"):
            t += " fired by " + ", ".join(f.replace("alias:", "").replace("macro:", "") for f in s["fired_by"][:2])
        if s.get("source") and "fired by" not in t:
            t += f" ({s['source']})"
        return t

    def check_trigger(self, res, row, sites, ax):
        actual = {t for s in sites for t in s["trigger"].split("/") if t}
        axk = {e["kind"] for e in ax}
        desc = "; ".join(dict.fromkeys(self.describe(s) for s in sites)) or "-"
        if axk:
            desc += f" | ARXML: {', '.join(sorted(axk))}"
        exp = norm_trigger(row.trigger) if row.trigger else ""
        if exp:
            ok = exp in actual or exp in axk
            self.add(res, "Trigger condition", PASS if ok else FAIL, exp, desc)
            return
        determined = bool(sites) and all(
            any(t in self.DETERMINED for t in s["trigger"].split("/")) and
            ("CYCLIC" not in s["trigger"] or s["cycle"] is not None) for s in sites)
        if determined:
            self.add(res, "Trigger condition", PASS, "trigger condition determined", desc,
                     "Derived from the generated RTE" + (" and cross-checked with ARXML." if axk else
                                                         " (no ARXML event available for cross-check)."))
        else:
            self.add(res, "Trigger condition", REVIEW, "trigger condition determined", desc,
                     "Trigger could not be fully derived - confirm against the software design.")

    def check_timing(self, res, row, sites, ax):
        if not (row.cycle or row.offset):
            return
        cs = [s for s in sites if "CYCLIC" in s["trigger"]]
        ca = [e for e in ax if e["kind"] == "CYCLIC"]
        for name, exp_txt, code, axv in (("Cycle time", row.cycle, [s["cycle"] for s in cs], [e["period_ms"] for e in ca]),
                                         ("Offset", row.offset, [s["offset"] for s in cs], [e["offset_ms"] for e in ca])):
            exp = to_float(exp_txt)
            if exp is None:
                continue
            vals = {v for v in code + axv if v is not None}
            actual = ", ".join(fmt_num(v) for v in sorted(vals)) or "not determinable"
            if not vals:
                self.add(res, name, REVIEW, f"{fmt_num(exp)} ms", actual)
            else:
                self.add(res, name, PASS if all(abs(v - exp) < 1e-6 for v in vals) else FAIL, f"{fmt_num(exp)} ms", actual)

    def check_modes(self, res, row, sites, ax):
        modes = [m for s in sites for m in s["modes"]]
        axm = [m for e in ax for m in e["modes"]]
        if not modes and not axm:
            self.add(res, "Mode dependency", PASS, "scheduling verified for all modes", "not mode dependent")
            return
        actual = "; ".join(sorted(set(modes))) + (f" | ARXML disabled: {', '.join(sorted(set(axm)))}" if axm else "")
        ev = []
        for s in [x for x in sites if x["modes"]][:2]:
            e = self.func_ev(s["func"], f"mode condition around {s['func']}:{s['line']}", s["line"])
            if e:
                a = max(1, s["line"] - self.s.context_lines - 6)
                e.snippet = self.idx.snippet(self.idx.fid_by_rel[e.file], a, s["line"], 2)
                ev.append(e)
        if row.mode:
            exp = split_list(row.mode)
            missing = [m for m in exp if m.lower() not in actual.lower()]
            self.add(res, "Mode dependency", PASS if not missing else FAIL, ", ".join(exp), actual,
                     f"Not found: {missing}" if missing else "", ev)
        else:
            self.add(res, "Mode dependency", REVIEW, "scheduling verified for all modes", actual,
                     "Triggers depend on modes - verify scheduling for all modes (Rte_Switch, mode switch in the "
                     "task containing the mode switch).", ev)

    def check_consistency(self, res, sites, ax):
        diffs = []
        kinds = {t for s in sites for t in s["trigger"].split("/") if t}
        for e in ax:
            if e["kind"] in ("CYCLIC", "INIT", "BACKGROUND", "DATA_RECEIVED", "MODE_SWITCH") \
                    and kinds and e["kind"] not in kinds:
                diffs.append(f"ARXML {e['kind']} event {e['name']} not seen in code")
            if e["kind"] == "CYCLIC" and e["period_ms"] is not None:
                cs = [s["cycle"] for s in sites if s["cycle"] is not None]
                if cs and all(abs(c - e["period_ms"]) > 1e-6 for c in cs):
                    diffs.append(f"period {fmt_num(e['period_ms'])} ms vs code {fmt_num(cs[0])} ms")
            if e["kind"] == "CYCLIC" and e["offset_ms"] is not None:
                os_ = [s["offset"] for s in sites if s["offset"] is not None]
                if os_ and all(abs(o - e["offset_ms"]) > 1e-6 for o in os_):
                    diffs.append(f"offset {fmt_num(e['offset_ms'])} ms vs code {fmt_num(os_[0])} ms")
            if e["task"]:
                ts = [s["task"] for s in sites if s["task"] and not s["task"].startswith("(")]
                if ts and e["task"] not in ts:
                    diffs.append(f"ARXML task {e['task']} vs code {ts[0]}")
        if not ax:
            return
        self.add(res, "Code vs ARXML configuration", FAIL if diffs else PASS, "generated code matches configuration",
                 "; ".join(diffs) or "consistent")


# =============================================================================
#  SMI-2065 inter-ECU communication
# =============================================================================
class ExternalAnalyzer(BaseAnalyzer):
    key = "SMI-2065"
    E2E_SRC_RE = r"\b(E2E_P\d+\w*(?:Protect|Check)\w*|E2EPW_\w+|E2E_SM\w*Check\w*|E2EXf_\w+|Rte_\w*E2E\w*)\b"
    STATUS_RE = r"\b(RTE_E_NEVER_RECEIVED|RTE_E_MAX_AGE_EXCEEDED|Rte_IsUpdated_\w+|Rte_IStatus_\w+|RTE_E_COM_STOPPED|RTE_E_TIMEOUT|RTE_E_INVALID)\b"

    def com_paths(self, R: ApiRes) -> List[Tuple[str, str, str, int]]:
        out = []
        an = self.rte.funcs.get(R.func, {})
        for cf, h, line in an.get("com", []):
            out.append((R.func, cf, h, line))
        if not out and R.func:
            w, r = self.rte.buffers_of(R.func, R.kind)
            for b in w + r:
                for wf, _ in self.rte.writers.get(b, []):
                    for cf, h, line in self.rte.funcs.get(wf, {}).get("com", []):
                        if wf != R.func:
                            out.append((wf, cf, h, line))
                for rf in self.rte.readers.get(b, []):
                    for cf, h, line in self.rte.funcs.get(rf, {}).get("com", []):
                        if rf != R.func and (rf, cf, h, line) not in out:
                            out.append((rf, cf, h, line))
        return out

    def analyze(self, row: RowInput, res: AnalysisResult):
        comp, api = row.component, row.api
        if not api:
            self.add(res, "Input", ERROR, note="RTE_API is required")
            return
        R = self.resolve_with_checks(res, comp, api)
        if not R.found:
            return
        comp = R.comp or comp
        an = self.rte.funcs.get(R.func, {})
        coms = self.com_paths(R)
        handles = sorted({h for _, _, h, _ in coms if h})
        signals = [sig_from_handle(h) for h in handles]
        ev = [self.func_ev(f, f"{cf}({h})", l) for f, cf, h, l in coms[:4]]
        self.add(res, "Data routed to communication stack", PASS if coms else FAIL, "Com/LdCom API call on data path",
                 ", ".join(f"{cf}({h})" for _, cf, h, _ in coms[:4]) or "none",
                 "" if coms else "No COM call found - not an inter-ECU port or not routed to the network.", ev)
        if row.signal:
            ok = any(row.signal.lower() in s.lower() or s.lower().startswith(row.signal.lower()) for s in signals)
            self.add(res, "Expected COM signal", PASS if ok else FAIL, row.signal, ", ".join(signals) or "-")
        props = self.signal_props(res, handles)
        self.routing(res, row, handles, props)
        self.representation(res, row, R, props)
        xf = an.get("xf", [])
        if any(x[0].startswith("ComXf_") for x in xf) or any("SignalGroupArray" in c[1] for c in coms):
            self.add(res, "Data representation: serialization", INFO, "same serialization on both ECUs",
                     "ComXf transformer: " + ", ".join(sorted({x[0] for x in xf})), "Verify with SMI-62933.")
        elif coms:
            self.add(res, "Data representation: serialization", PASS, "same serialization on both ECUs",
                     "COM signal packing per configuration (no transformer)")
        self.e2e(res, row, R, comp, coms, props)
        self.forbidden(res, row, R, comp, coms, props)
        left = [f"{comp}\n{R.api}"]
        sig_txt = "\n".join(signals[:2]) or "COM ?"
        right = []
        for pr in props:
            d = pr.get("dbc")
            if d:
                right.append(f"{d['msg']} (0x{d['msg_id']:X})\nTX {d['tx']} -> RX {', '.join(d['rx'][:3]) or '-'}")
            elif pr.get("pdu"):
                right.append(f"PDU {pr['pdu']}")
        right = right or ["Network"]
        if R.kind in READ_KINDS:   # reception: network -> component
            left, right = right, left
        res.diagrams.append({"type": "connection", "title": f"SMI-2065 inter-ECU: {R.api}", "left": left,
                             "center": sig_txt, "right": right, "highlight": comp})

    def signal_props(self, res, handles: List[str]) -> List[Dict[str, Any]]:
        out = []
        ax = self.ctx.arxml
        dbc = self.ctx.dbc
        rows = []
        for h in handles:
            sname = sig_from_handle(h)
            pr = {"handle": h, "signal": sname, "ecuc": None, "dbc": None, "pdu": "", "define": None}
            md = self.idx.macros.get(h)
            if md:
                pr["define"] = md[0]
            c = None
            if ax.ecuc:
                for d in ("ComSignal", "ComGroupSignal", "ComSignalGroup"):
                    c = ax.ecuc_find(d, sname)
                    if c:
                        break
            pr["ecuc"] = c
            if c:
                for ip in ax.ecuc_defs("ComIPdu"):
                    if any(last_seg(r) == c["name"] for k, v in ip["refs"].items() for r in v):
                        pr["pdu"] = ip["name"]
                        pr["direction"] = ax.p(ip, "ComIPduDirection")
                        break
            pr["dbc"] = dbc.find_signal(sname) if dbc.signals else None
            out.append(pr)
            rows.append([h, sname, "yes" if md else "no", ax.p(c, "ComBitPosition"), ax.p(c, "ComBitSize"),
                         ax.p(c, "ComSignalEndianness"), ax.p(c, "ComSignalType"), pr["pdu"],
                         ax.p(c, "ComDataInvalidAction") or ax.p(c, "ComSignalDataInvalidValue"),
                         pr["dbc"]["msg"] if pr["dbc"] else "",
                         f"{pr['dbc']['start']}|{pr['dbc']['length']}@{'1' if pr['dbc']['endian'] == 'LITTLE' else '0'}"
                         f"{'-' if pr['dbc']['signed'] else '+'}" if pr["dbc"] else ""])
        self.table(res, "COM signal configuration", ["Handle", "Signal", "ComConf define", "ComBitPosition", "ComBitSize",
                                                     "Endianness", "ComSignalType", "IPdu", "Invalid cfg", "DBC message",
                                                     "DBC start|len@endian sign"], rows)
        if handles:
            ev = [self.idx.ev(p["define"][0], p["define"][1], title=f"#define {p['handle']}") for p in out if p["define"]]
            have = [p for p in out if p["define"] or p["ecuc"]]
            self.add(res, "Signal configured in COM", PASS if len(have) == len(out) else REVIEW,
                     "ComConf handle / ECUC ComSignal", f"{len(have)}/{len(out)} signal(s) found in COM configuration",
                     "" if len(have) == len(out) else "Some handles have no ComConf define / ECUC container.", ev)
        return out

    def routing(self, res, row, handles, props):
        users = defaultdict(set)
        for h in handles:
            for fid, line in self.idx.token_hits(h):
                if self.idx.files[fid].is_rte:
                    f = self.idx.func_at(fid, line)
                    if f:
                        users[h].add(f[2])
        lines = []
        for p in props:
            d = p.get("dbc")
            u = sorted(users.get(p["handle"], []))
            txt = f"{p['signal']}: RTE users {len(u)}"
            if d:
                txt += f", frame {d['msg']} TX={d['tx']} RX={','.join(d['rx']) or '-'}"
            if p.get("pdu"):
                txt += f", IPdu {p['pdu']} {p.get('direction', '')}"
            lines.append(txt)
        st = INFO
        note = "1:1 / 1:N / N:1 routing and reception of partial signal data must be verified (integration test)."
        if row.ecu and props:
            ok = False
            for p in props:
                d = p.get("dbc")
                if d and (row.ecu in d["rx"] or row.ecu == d["tx"]):
                    ok = True
            st = PASS if ok else (FAIL if any(p.get("dbc") for p in props) else REVIEW)
            note = "" if ok else "Expected ECU not found as transmitter/receiver of the frame (DBC)."
        self.add(res, "Routing to the correct ECU", st, row.ecu or "routing per communication matrix",
                 " | ".join(lines) or "-", note)

    def representation(self, res, row, R: ApiRes, props):
        ti = type_info(R.data_type, self.rte.typedefs())
        issues, facts = [], [f"RTE: {type_desc(ti)}"]
        ax = self.ctx.arxml
        for p in props:
            c, d = p["ecuc"], p["dbc"]
            st = ax.p(c, "ComSignalType").upper()
            if st:
                facts.append(f"COM: {st}")
                ci = COM_SIGNAL_TYPES.get(st)
                if ci and ti.get("bits") and st != "BOOLEAN" and not st.startswith("UINT8_"):
                    if ci[0] != ti["bits"] or ci[1] != ti["signed"]:
                        issues.append(f"RTE {ti['base']} vs COM {st}")
            bs = to_float(ax.p(c, "ComBitSize"))
            if bs and ti.get("bits") and bs > ti["bits"]:
                issues.append(f"COM bit size {fmt_num(bs)} > RTE type width {ti['bits']}")
            if d:
                facts.append(f"DBC: {d['length']} bit {'signed' if d['signed'] else 'unsigned'}")
                if ti.get("bits") and d["length"] > ti["bits"]:
                    issues.append(f"DBC length {d['length']} > RTE width {ti['bits']}")
                if ti.get("signed") is not None and not ti.get("float") and d["signed"] != ti["signed"]:
                    issues.append("signedness RTE vs DBC differs")
        if row.datatype:
            if _tn(row.datatype).lower() not in (_tn(R.data_type).lower(), ti.get("base", "").lower()) and \
                    row.datatype.upper() not in [f.split(": ")[-1] for f in facts]:
                issues.append(f"expected {row.datatype}")
        known = len(facts) > 1 or row.datatype
        self.add(res, "Data representation: datatype", FAIL if issues else (PASS if known else REVIEW),
                 row.datatype or "same datatype on both ECUs", "; ".join(facts),
                 "; ".join(issues) if issues else ("" if known else "Only the RTE type is known."))
        ends = {}
        for p in props:
            v = norm_endian(ax.p(p["ecuc"], "ComSignalEndianness"))
            if v:
                ends["COM"] = v
            if p["dbc"]:
                ends["DBC"] = p["dbc"]["endian"]
            if ax.pdus:
                pm = ax.pdu_mapping(signal_path=re.split(r"_o[A-Z]", p["signal"])[0])
                if pm and pm[1].get("byte_order"):
                    ends["ARXML"] = norm_endian(pm[1]["byte_order"])
        if row.endianness:
            ends["Expected"] = norm_endian(row.endianness)
        vals = set(ends.values())
        txt = ", ".join(f"{k}={endian_label(v)}" for k, v in ends.items()) or "-"
        if not ends:
            self.add(res, "Data representation: endianness", REVIEW, "same endianness", txt, "No source found.")
        elif len(vals) == 1 and len(ends) >= 2:
            self.add(res, "Data representation: endianness", PASS, "same endianness", txt)
        elif len(vals) == 1:
            self.add(res, "Data representation: endianness", REVIEW, "same endianness", txt,
                     "Only one source - cannot cross-check.")
        else:
            self.add(res, "Data representation: endianness", FAIL, "same endianness", txt)

    def e2e(self, res, row, R: ApiRes, comp: str, coms, props):
        ev, found = [], []
        an = self.rte.funcs.get(R.func, {})
        e2exf = [x for x in an.get("xf", []) if x[0].startswith("E2EXf_")]
        for name, line in e2exf:
            found.append(f"E2EXf {name}")
            e = self.func_ev(R.func, f"E2E transformer {name}", line)
            if e:
                ev.append(e)
        fids = self.comp_fids(comp) or []
        for fid, line, txt in self.idx.grep(self.E2E_SRC_RE, fids, limit=6):
            found.append(f"{self.idx.basename(fid)}:{line}")
            ev.append(self.idx.ev(fid, line, title="E2E in application"))
        ax = self.ctx.arxml
        if ax.swcs:
            port, de = self.split_port_de(comp, R.api)
            p = ax.port(comp, port)
            if p and any(cs.get("e2e") == "true" for cs in p["comspecs"]):
                found.append("ARXML USES-END-TO-END-PROTECTION")
        for pr in props:
            g = ax.find("isignal_groups", pr["signal"]) if ax.isignal_groups else None
            if g and g[1].get("e2e"):
                found.append(f"E2E transformation on {g[1]['name']}")
        if not row.is_safety():
            self.add(res, "E2E protection (safety-related signal)", NA, "E2E for safety-related signals",
                     ", ".join(found) or "-", "Row marked as not safety related.")
        elif found:
            self.add(res, "E2E protection (safety-related signal)", PASS, "E2E protection", "; ".join(found[:5]),
                     evidence=ev[:4])
        else:
            self.add(res, "E2E protection (safety-related signal)", FAIL, "E2E protection", "none found",
                     "Vector requires E2E protection for safety-related signals.")
        st_hits = self.idx.grep(self.STATUS_RE, fids, limit=4)
        if st_hits and not found and row.is_safety():
            self.add(res, "COM status is not the only safety mechanism", FAIL, "E2E in addition to COM status",
                     f"only COM/RTE status evaluated ({len(st_hits)} place(s))",
                     "Only evaluating COM status (update, alive timeout, invalidation) is no sufficient safety mechanism.",
                     [self.idx.ev(f, l, title="status evaluation") for f, l, _ in st_hits[:2]])
        else:
            self.add(res, "COM status is not the only safety mechanism", PASS, "E2E in addition to COM status",
                     "E2E present" if found else "no status-only evaluation found")

    def forbidden(self, res, row, R: ApiRes, comp: str, coms, props):
        k = R.kind
        an = self.rte.funcs.get(R.func, {})
        sd = self.dev_status() if row.is_safety() else REVIEW
        ax = self.ctx.arxml
        ext = bool(coms)

        def chk(name, bad, actual, note=""):
            self.add(res, name, sd if bad else PASS, "not used for safety-related signals", actual, note if bad else "")

        chk("No inter-ECU client/server", ext and k in ("Call", "Result"), f"API kind {k}")
        trig = ext and (k in ("Trigger", "IrTrigger") or any("Trigger" in c[1] for c in coms))
        chk("No inter-ECU trigger communication", trig, "trigger" if trig else "no trigger")
        chk("No implicit communication", k in IMPLICIT_KINDS, "implicit" if k in IMPLICIT_KINDS else "explicit")
        blocking = k in ("Receive", "Send") and any(o in ("WaitEvent", "Rte_WaitGetClearEvent") for o, _, _ in an.get("os", []))
        chk("No blocking queued communication", blocking, "blocking" if blocking else ("queued" if k in ("Send", "Receive") else "non-queued"))
        ldtt = [c for c in coms if c[1].startswith("LdCom_")] + \
               [(f, "", "", 0) for f in self.rte.funcs if "TriggerTransmit" in f and any(
                   sig_from_handle(h).lower() in f.lower() for h in [p["signal"] for p in props] if h)]
        chk("No LDCOM trigger transmit", bool(ldtt), ", ".join({c[0] for c in ldtt}) or "not used")
        tp = k in ("Send", "Receive") and any(("Dyn" in c[1] or "TP" in c[2]) for c in coms)
        chk("No queued communication with TP signals", tp, "TP/dynamic" if tp else "no TP signal")
        inv = [c for c in coms if "Invalidate" in c[1]]
        inv_cfg = [p["signal"] for p in props if p["ecuc"] and (ax.p(p["ecuc"], "ComDataInvalidAction") or
                                                                ax.p(p["ecuc"], "ComSignalDataInvalidValue"))]
        inv_api = k in ("Invalidate", "IInvalidate")
        inv_use = self.idx.grep(r"\bRte_I?Invalidate_\w+", self.comp_fids(comp) or [], limit=3)
        bad_inv = bool(inv or inv_cfg or inv_api)
        chk("No invalidation", bad_inv, ", ".join(filter(None, [
            "Com_InvalidateSignal" if inv else "", f"ComDataInvalidAction on {inv_cfg}" if inv_cfg else "",
            "Rte_Invalidate API" if inv_api else "", f"Rte_Invalidate used in SWC ({len(inv_use)})" if inv_use else ""]))
            or "not used")
        hints = self.conv_hints([R.func] + [c[0] for c in coms])
        self.add(res, "No scaling", sd if hints else PASS, "not used for safety-related signals",
                      "; ".join(h[2] for h in hints[:2]) or "no scaling code", "" if not hints else
                      "RTE applies scaling/offset between application and network representation.",
                      self.conv_evidence(hints))


# =============================================================================
#  Shared element comparison (SMI-62933 / SMI-105506)
# =============================================================================
class _ElementCompare:
    """Collects per-element facts from several sources and evaluates them."""

    def __init__(self, members: List[Dict[str, Any]], typedefs):
        self.rows = []
        self.typedefs = typedefs
        for m in members:
            ti = type_info(m["type"], typedefs)
            arr = to_float(m.get("array") or "") if m.get("array") else None
            bits = ti.get("bits")
            if bits and arr:
                bits = int(bits * arr)
            self.rows.append({"element": m["name"], "ctype": m["type"], "cbits": bits, "csigned": ti.get("signed"),
                              "cfloat": ti.get("float"), "src": {}})

    def put(self, i: int, source: str, **kw):
        self.rows[i]["src"].setdefault(source, {}).update({k: v for k, v in kw.items() if v not in (None, "")})

    @staticmethod
    def _expect(text: str, elem: str):
        g, d = parse_kv_expect(text)
        return d.get(elem.lower(), g) if (g is not None or d) else None

    def evaluate(self, row: RowInput) -> Dict[str, Tuple[str, str, List[str]]]:
        out = {}
        dt_bad, bp_bad, en_bad, ln_bad = [], [], [], []
        dt_n, bp_n, en_n, ln_n = 0, 0, 0, 0
        for r in self.rows:
            e = r["element"]
            exp_dt, exp_bp = self._expect(row.datatype, e), self._expect(row.bitpos, e)
            exp_en, exp_ln = self._expect(row.endianness, e), self._expect(row.length, e)
            if exp_bp is not None:
                r["src"].setdefault("Expected", {})["pos"] = {to_float(exp_bp)}
            if exp_en:
                r["src"].setdefault("Expected", {})["endian"] = norm_endian(exp_en)
            if exp_ln:
                r["src"].setdefault("Expected", {})["length"] = to_float(exp_ln)
            # datatype ---------------------------------------------------
            facts = 0
            for s, v in r["src"].items():
                t = v.get("type")
                if not t:
                    continue
                facts += 1
                ci = COM_SIGNAL_TYPES.get(str(t).upper())
                if ci and r["cbits"] and str(t).upper() not in ("BOOLEAN",) and not str(t).upper().startswith("UINT8_"):
                    if ci[0] != r["cbits"] or (r["csigned"] is not None and ci[1] != r["csigned"]):
                        dt_bad.append(f"{e}: C {r['ctype']} vs {s} {t}")
                if s == "DBC" and r["csigned"] is not None and v.get("signed") is not None \
                        and not r["cfloat"] and v["signed"] != r["csigned"]:
                    dt_bad.append(f"{e}: signedness C vs DBC")
            for s, v in r["src"].items():
                ln = v.get("length")
                if ln and r["cbits"] and ln > r["cbits"]:
                    dt_bad.append(f"{e}: {s} length {fmt_num(ln)} > C width {r['cbits']}")
            if exp_dt:
                facts += 1
                if _tn(exp_dt).lower() != _tn(r["ctype"]).lower() and \
                        exp_dt.upper() not in [str(v.get("type", "")).upper() for v in r["src"].values()]:
                    dt_bad.append(f"{e}: expected {exp_dt}, C type {r['ctype']}")
            if facts and r["cbits"]:
                dt_n += 1
            # bit position ----------------------------------------------
            sets = {s: v["pos"] for s, v in r["src"].items() if v.get("pos")}
            if len(sets) >= 2:
                bp_n += 1
                inter = None
                for s, st in sets.items():
                    st2 = {x for x in st if x is not None}
                    inter = st2 if inter is None else inter & st2
                if not inter:
                    bp_bad.append(f"{e}: " + ", ".join(f"{s}={'/'.join(fmt_num(x) for x in sorted(v))}" for s, v in sets.items()))
            # endianness -------------------------------------------------
            ends = {s: v["endian"] for s, v in r["src"].items() if v.get("endian")}
            if len(ends) >= 2:
                en_n += 1
                if len(set(ends.values())) > 1:
                    en_bad.append(f"{e}: " + ", ".join(f"{s}={v}" for s, v in ends.items()))
            # length ---------------------------------------------------------
            lens = {s: v["length"] for s, v in r["src"].items() if v.get("length")}
            if len(lens) >= 2:
                ln_n += 1
                if len({round(x, 6) for x in lens.values()}) > 1:
                    ln_bad.append(f"{e}: " + ", ".join(f"{s}={fmt_num(v)}" for s, v in lens.items()))
        n = len(self.rows)
        for key, bad, cnt in (("datatype", dt_bad, dt_n), ("bitpos", bp_bad, bp_n), ("endian", en_bad, en_n),
                              ("length", ln_bad, ln_n)):
            if bad:
                out[key] = (FAIL, f"{len(bad)} mismatch(es)", bad)
            elif n and cnt == n:
                out[key] = (PASS, f"{cnt}/{n} elements consistent across sources", [])
            elif cnt:
                out[key] = (REVIEW, f"{cnt}/{n} elements cross-checked", [])
            else:
                out[key] = (REVIEW, "not enough independent sources", [])
        return out

    def table_rows(self) -> Tuple[List[str], List[List[Any]]]:
        srcs = []
        for r in self.rows:
            for s in r["src"]:
                if s not in srcs:
                    srcs.append(s)
        headers = ["Element", "C type", "C bits"]
        for s in srcs:
            headers += [f"{s} name", f"{s} type", f"{s} pos", f"{s} len", f"{s} endian"]
        rows = []
        for r in self.rows:
            line = [r["element"], r["ctype"], r["cbits"] or ""]
            for s in srcs:
                v = r["src"].get(s, {})
                pos = v.get("pos")
                line += [v.get("name", ""), v.get("type", ""),
                         "/".join(fmt_num(x) for x in sorted(x for x in pos if x is not None)) if pos else "",
                         fmt_num(v.get("length")) if v.get("length") else "", v.get("endian", "")]
            rows.append(line)
        return headers, rows

    def bit_elements(self) -> List[Dict[str, Any]]:
        out = []
        pref = ("Code", "ECUC", "ARXML", "DBC", "DCM", "DiagExtract", "Expected")
        for r in self.rows:
            for s in pref:
                v = r["src"].get(s)
                if v and v.get("bits"):
                    out.append({"name": r["element"], "bits": v["bits"], "source": s})
                    break
                if v and v.get("pos") and v.get("length"):
                    p = min(x for x in v["pos"] if x is not None)
                    ln = int(v["length"])
                    end = v.get("endian", "LITTLE")
                    if end == "BIG" and s in ("DBC",):
                        p = v.get("msb", p)
                        bits, pos = [], int(p)
                        for _ in range(ln):
                            bits.append(pos)
                            pos = pos + 15 if pos % 8 == 0 else pos - 1
                    else:
                        bits = list(range(int(p), int(p) + ln))
                    out.append({"name": r["element"], "bits": bits, "source": s})
                    break
        return out


def map_elements(members: List[Dict[str, Any]], names: List[str], explicit: Dict[str, str] = None) -> Tuple[List[int], str]:
    """Return index list (member i -> names[idx] or -1) and method."""
    explicit = explicit or {}
    res = [-1] * len(members)
    used = set()
    method = "name"
    if explicit:
        for i, m in enumerate(members):
            t = explicit.get(m["name"])
            if t and t in names:
                res[i] = names.index(t)
                used.add(res[i])
        method = "ARXML record mapping"
    for i, m in enumerate(members):
        if res[i] >= 0:
            continue
        best, bj = 0.0, -1
        for j, n in enumerate(names):
            if j in used:
                continue
            sc = similarity(m["name"], re.split(r"_o[A-Z]", n)[0])
            if sc > best:
                best, bj = sc, j
        if bj >= 0 and best >= 0.6:
            res[i] = bj
            used.add(bj)
    if any(x < 0 for x in res) and len(members) == len(names):
        if all(x < 0 for x in res):
            res = list(range(len(names)))
            method = "order"
        else:
            free = [j for j in range(len(names)) if j not in used]
            for i in range(len(res)):
                if res[i] < 0 and free:
                    res[i] = free.pop(0)
            method += "+order"
    return res, method


# =============================================================================
#  SMI-62933 ComXf
# =============================================================================
class ComXfAnalyzer(BaseAnalyzer):
    key = "SMI-62933"

    def analyze(self, row: RowInput, res: AnalysisResult):
        comp, api = row.component, row.api
        xf_calls: List[Tuple[str, str, int]] = []   # (rte_func, xf_name, line)
        handles: List[str] = []
        R = None
        if api:
            R = self.resolve_with_checks(res, comp, api)
            if R.found and R.func:
                funcs = [R.func]
                w, r = self.rte.buffers_of(R.func, R.kind)
                for b in w + r:
                    funcs += [f for f, _ in self.rte.writers.get(b, [])] + self.rte.readers.get(b, [])
                for f in dict.fromkeys(funcs):
                    an = self.rte.funcs.get(f, {})
                    xf_calls += [(f, x, l) for x, l in an.get("xf", []) if x.startswith("ComXf_")]
                    handles += [h for c, h, l in an.get("com", []) if "SignalGroup" in c or "ComSignalGroup" in h]
        if row.signal and not xf_calls:
            for name in self.idx.funcdefs:
                if name.startswith("ComXf_") and row.signal.lower() in name.lower():
                    xf_calls.append(("", name, 0))
        xf_names = sorted({x for _, x, _ in xf_calls})
        ev = [self.func_ev(f, f"{x} call", l) for f, x, l in xf_calls[:3] if f]
        if not xf_calls:
            self.add(res, "ComXf transformer used on data path", REVIEW, "ComXf_<...> call", "none found",
                     "No ComXf call found for this API/signal - SMI-62933 may not apply.")
            return
        self.add(res, "ComXf transformer used on data path", PASS, "ComXf_<...> call", ", ".join(xf_names), evidence=ev)
        gen = [(n, self.idx.funcdefs.get(n, [None])[0]) for n in xf_names]
        gev = [self.idx.ev(d[0], d[1], d[2], f"{n}() generated", hl=(d[1],), ctx=0) for n, d in gen if d]
        for e in gev:
            e.snippet = self.idx.snippet(self.idx.fid_by_rel[e.file], e.line, min(e.end_line, e.line + 30), 0)
        self.add(res, "ComXf (de)serializer generated", PASS if len(gev) == len(gen) else FAIL,
                 "function definition in ComXf generated code", f"{len(gev)}/{len(gen)} found", evidence=gev)
        # record type --------------------------------------------------------
        rtype = R.data_type if R else ""
        if not rtype:
            for n, d in gen:
                if d:
                    for p in parse_params(d[4]):
                        ti = type_info(p["type"], self.rte.typedefs())
                        if ti["struct"]:
                            rtype = p["type"]
        ti = type_info(rtype, self.rte.typedefs())
        members = ti["members"] if ti["struct"] else ([{"name": "value", "type": rtype}] if rtype else [])
        if not members:
            self.add(res, "Record type of data element", REVIEW, "record type", rtype or "unknown")
            return
        self.add(res, "Record type of data element", INFO, "", type_desc(ti))
        cmp_ = _ElementCompare(members, self.rte.typedefs())
        # COM ECUC -----------------------------------------------------------
        ax = self.ctx.arxml
        gname = sig_from_handle(handles[0]) if handles else (row.signal or "")
        if not gname and xf_names:
            gname = re.sub(r"^ComXf_(?:Inv_)?(?:ComXf_)?", "", xf_names[0])
        gsigs = []
        gcont = ax.ecuc_find("ComSignalGroup", gname) if ax.ecuc and gname else None
        if gcont:
            gsigs = ax.children(gcont, "ComGroupSignal")
        names = [g["name"] for g in gsigs]
        # ARXML I-Signal group -------------------------------------------------
        isg = ax.find("isignal_groups", re.split(r"_o[A-Z]", gname)[0]) if ax.isignal_groups and gname else None
        isigs = [ax.get("isignals", s) for s in (isg[1]["signals"] if isg else [])]
        isigs = [s for s in isigs if s]
        if not names and isigs:
            names = [s["name"] for s in isigs]
        if not names:
            names = [m["name"] for m in members]
        explicit = {}
        for sm in ax.sr_maps:
            for el in sm.get("elements", []):
                for s in isigs:
                    if s.get("sys") and el["sys"] and last_seg(s["sys"]) == last_seg(el["sys"]):
                        explicit[el["element"]] = s["name"]
        idxmap, method = map_elements(members, names, explicit)
        mapped = sum(1 for x in idxmap if x >= 0)
        self.add(res, "Record elements mapped to group signals", PASS if mapped == len(members) and
                 len(members) == len(names) else (REVIEW if mapped else FAIL),
                 f"{len(members)} elements <-> group signals", f"{mapped}/{len(members)} mapped by {method}; "
                 f"{len(names)} signals in group {gname or '?'}")
        # fill sources ---------------------------------------------------------
        dbc = self.ctx.dbc
        for i, j in enumerate(idxmap):
            if j < 0:
                continue
            sname = names[j]
            gc = next((g for g in gsigs if g["name"] == sname), None) or (ax.ecuc_find("ComGroupSignal", sname) if ax.ecuc else None)
            if gc:
                pos = to_float(ax.p(gc, "ComBitPosition"))
                cmp_.put(i, "ECUC", name=gc["name"], type=ax.p(gc, "ComSignalType"),
                         pos={pos} if pos is not None else None, length=to_float(ax.p(gc, "ComBitSize")),
                         endian=norm_endian(ax.p(gc, "ComSignalEndianness")))
            base = re.split(r"_o[A-Z]", sname)[0]
            isig = next((s for s in isigs if s["name"] in (sname, base)), None) or \
                (ax.find("isignals", base, fuzzy=False) or (None, None))[1]
            if isig:
                pm = ax.pdu_mapping(signal_path=isig["name"])
                cmp_.put(i, "ARXML", name=isig["name"], length=isig.get("length"),
                         pos={pm[1]["start"]} if pm and pm[1].get("start") is not None else None,
                         endian=norm_endian(pm[1]["byte_order"]) if pm else "")
            d = dbc.find_signal(sname) if dbc.signals else None
            if d:
                cmp_.put(i, "DBC", name=d["name"], length=float(d["length"]), pos={float(d["lsb"]), float(d["msb"])},
                         endian=d["endian"], signed=d["signed"], msb=d["msb"])
        lay = {}
        for n, d in gen:
            if d and not lay:
                body = "\n".join(self.idx.clean_segment(d[0], d[1], d[2]))
                lay = parse_xf_layout(body)
        for i, m in enumerate(members):
            L = lay.get(m["name"])
            if L:
                cmp_.put(i, "Code", name=m["name"], pos={float(L["lsb"]), float(L["msb"]), float(min(L["bits"].values()) // 8 * 8)},
                         length=float(L["length"]), endian=L["endian"], bits=sorted(L["bits"].values()))
        self.emit(res, row, cmp_, "group signal")
        pdu_len = None
        if isg:
            pm = ax.pdu_mapping(group_path=isg[0]) or (ax.pdu_mapping(signal_path=isigs[0]["name"]) if isigs else None)
            pdu_len = pm[0].get("length") if pm else None
        res.diagrams.append({"type": "bits", "title": f"SMI-62933 {gname or rtype} layout",
                             "elements": cmp_.bit_elements(), "length": int(pdu_len) if pdu_len else None})

    def emit(self, res, row, cmp_: _ElementCompare, what: str):
        ev = cmp_.evaluate(row)
        h, rows = cmp_.table_rows()
        self.table(res, "Element layout per source", h, rows)
        names = {"datatype": "Data type per element", "bitpos": "Bit position per element",
                 "endian": "Endianness per element", "length": "Length per element"}
        for k, title in names.items():
            st, actual, bad = ev[k]
            self.add(res, title, st, f"consistent for every {what}", actual, "; ".join(bad[:6]))


# =============================================================================
#  SMI-105506 DiagXf
# =============================================================================
class DiagXfAnalyzer(ComXfAnalyzer):
    key = "SMI-105506"

    def derive_did(self, texts: List[str]) -> Tuple[str, str]:
        """DID from names (DID_F190, Did0xF190) or from the DCM configuration (DcmDspData name in API)."""
        for t in texts:
            m = re.search(r"(?i)(?:did|dataidentifier)_?(?:0x)?([0-9a-f]{4})(?![0-9a-f])", t or "")
            if m:
                return m.group(1).upper(), f"from name {t}"
        ax = self.ctx.arxml
        if ax.ecuc:
            low = " ".join(t.lower() for t in texts if t)
            for didc in ax.ecuc_defs("DcmDspDid"):
                for sc in ax.children(didc, "DcmDspDidSignal"):
                    dname = last_seg((ax.r(sc, "DcmDspDidDataRef") or [""])[0])
                    if dname and dname.lower() in low:
                        ident = to_float(ax.p(didc, "DcmDspDidIdentifier"))
                        if ident is not None:
                            return f"{int(ident):04X}", f"DcmDspData {dname} in {didc['name']}"
        return "", ""

    def analyze(self, row: RowInput, res: AnalysisResult):
        comp, api, did = row.component, row.api, (row.did or "").strip()
        R = None
        xf_calls: List[Tuple[str, str, int]] = []
        if api:
            R = self.resolve_with_checks(res, comp, api)
            if comp and R.comp and R.comp != comp and res.checks and res.checks[0].status == REVIEW:
                res.checks[0].status = INFO
                res.checks[0].note = f"API belongs to {R.comp} (DCM side) - not called by {comp}."
            if R.found and R.func:
                xf_calls += [(R.func, x, l) for x, l in self.rte.funcs.get(R.func, {}).get("xf", [])
                             if x.startswith("DiagXf_")]
            target = R.direct_target if R else ""
            if not xf_calls:
                tokens = [t for t in (api, target, did) if t]
                for f, an in self.rte.funcs.items():
                    dx = [(x, l) for x, l in an.get("xf", []) if x.startswith("DiagXf_")]
                    if not dx:
                        continue
                    callees = {c for c, _ in an.get("calls", [])}
                    if (api in callees or target in callees or any(t.lower() in f.lower() for t in tokens) or
                            any(any(t.lower() in x.lower() for t in tokens if t) for x, _ in dx)):
                        xf_calls += [(f, x, l) for x, l in dx]
        if did and not xf_calls:
            for f, an in self.rte.funcs.items():
                for x, l in an.get("xf", []):
                    if x.startswith("DiagXf_") and did.lower() in (x + f).lower():
                        xf_calls.append((f, x, l))
        xf_names = sorted({x for _, x, _ in xf_calls})
        if not did:
            did, how = self.derive_did([api, (R.direct_target if R else "")] + xf_names + [f for f, _, _ in xf_calls])
            if did:
                self.add(res, "DID identified", INFO, "", f"DID {did} ({how})")
        if not xf_calls:
            self.add(res, "DiagXf transformer used on data path", REVIEW, "DiagXf_<...> call", "none found",
                     "No DiagXf call found for this API/DID - SMI-105506 may not apply.")
            return
        ev = [self.func_ev(f, f"{x} call in {f}", l) for f, x, l in xf_calls[:3]]
        self.add(res, "DiagXf transformer used on data path", PASS, "DiagXf_<...> call", ", ".join(xf_names), evidence=ev)
        gen = [(n, self.idx.funcdefs.get(n, [None])[0]) for n in xf_names]
        gev = [self.idx.ev(d[0], d[1], d[2], f"{n}() generated", hl=(d[1],), ctx=0) for n, d in gen if d]
        for e in gev:
            e.snippet = self.idx.snippet(self.idx.fid_by_rel[e.file], e.line, min(e.end_line, e.line + 30), 0)
        self.add(res, "DiagXf (de)serializer generated", PASS if len(gev) == len(gen) else FAIL,
                 "function definition in DiagXf generated code", f"{len(gev)}/{len(gen)} found", evidence=gev)
        rtype = ""
        for n, d in gen:
            if d:
                for p in parse_params(d[4]):
                    if type_info(p["type"], self.rte.typedefs())["struct"]:
                        rtype = p["type"]
        if not rtype and R and R.direct_target:
            for p in R.params:
                if type_info(p["type"], self.rte.typedefs())["struct"]:
                    rtype = p["type"]
        ti = type_info(rtype, self.rte.typedefs())
        members = ti["members"] if ti["struct"] else []
        if not members:
            self.add(res, "Record type of data element", REVIEW, "record type", rtype or "unknown")
            return
        self.add(res, "Record type of data element", INFO, "", type_desc(ti))
        cmp_ = _ElementCompare(members, self.rte.typedefs())
        ax = self.ctx.arxml
        # DCM ECUC ----------------------------------------------------------
        dcm_sigs = []
        didc = None
        if ax.ecuc and did:
            dv = to_float(did if did.lower().startswith("0x") else ("0x" + did if re.fullmatch(r"[0-9A-Fa-f]{4}", did) else did))
            for c in ax.ecuc_defs("DcmDspDid"):
                ident = to_float(ax.p(c, "DcmDspDidIdentifier"))
                if (dv is not None and ident == dv) or did.lower() in c["name"].lower():
                    didc = c
                    break
        if didc:
            for sc in ax.children(didc, "DcmDspDidSignal"):
                dref = (ax.r(sc, "DcmDspDidDataRef") or [""])[0]
                data = ax.ecuc.get(dref) or ax.ecuc_find("DcmDspData", last_seg(dref))
                pos = to_float(ax.p(sc, "DcmDspDidDataPos"))
                if pos is None and ax.p(sc, "DcmDspDidByteOffset"):
                    pos = to_float(ax.p(sc, "DcmDspDidByteOffset")) * 8
                size = to_float(ax.p(data, "DcmDspDataSize"))
                if size is None and ax.p(data, "DcmDspDataByteSize"):
                    size = to_float(ax.p(data, "DcmDspDataByteSize")) * 8
                dcm_sigs.append({"name": data["name"] if data else last_seg(dref), "pos": pos, "size": size,
                                 "type": ax.p(data, "DcmDspDataType"),
                                 "endian": norm_endian(ax.p(data, "DcmDspDataEndianness")), "c": sc})
            self.add(res, "DCM DID configuration found", PASS, f"DcmDspDid {did}",
                     f"{didc['name']}: {len(dcm_sigs)} signal(s)")
        elif did:
            self.add(res, "DCM DID configuration found", REVIEW, f"DcmDspDid {did}", "not found in ECUC")
        # Diagnostic extract -------------------------------------------------
        dparams = []
        if ax.diag_dids and did:
            for p, d in ax.diag_dids.items():
                ident = to_float(d["id"])
                dv = to_float("0x" + did if re.fullmatch(r"[0-9A-Fa-f]{4}", did) else did)
                if (ident is not None and ident == dv) or did.lower() in d["name"].lower():
                    dparams = d["params"]
                    break
        # map + fill ------------------------------------------------------------
        if dcm_sigs:
            idxm, method = map_elements(members, [s["name"] for s in dcm_sigs])
            for i, j in enumerate(idxm):
                if j >= 0:
                    s = dcm_sigs[j]
                    cmp_.put(i, "DCM", name=s["name"], type=s["type"], pos={s["pos"]} if s["pos"] is not None else None,
                             length=s["size"], endian=s["endian"] if s["endian"] != "OPAQUE" else "")
            self.add(res, "Record elements mapped to DCM signals", PASS if all(x >= 0 for x in idxm) and
                     len(members) == len(dcm_sigs) else REVIEW, f"{len(members)} record elements",
                     f"{sum(1 for x in idxm if x >= 0)} mapped by {method}; {len(dcm_sigs)} DCM signals")
        if dparams:
            idxm, method = map_elements(members, [p["name"] for p in dparams])
            for i, j in enumerate(idxm):
                if j >= 0:
                    p = dparams[j]
                    bt = ax.base_type_info(p["base"]) or {}
                    ln = bt.get("size")
                    if ln and p.get("max_elems"):
                        ln = ln * p["max_elems"]
                    cmp_.put(i, "DiagExtract", name=p["name"], pos={p["bit_offset"]} if p["bit_offset"] is not None else None,
                             length=ln, endian=norm_endian(bt.get("byte_order")),
                             type=(bt.get("native") or "").upper() if bt.get("native") else "")
        lay = {}
        for n, d in gen:
            if d and not lay:
                lay = parse_xf_layout("\n".join(self.idx.clean_segment(d[0], d[1], d[2])))
        for i, m in enumerate(members):
            L = lay.get(m["name"])
            if L:
                cmp_.put(i, "Code", name=m["name"], pos={float(L["lsb"]), float(L["msb"]), float(min(L["bits"].values()) // 8 * 8)}, length=float(L["length"]),
                         endian=L["endian"], bits=sorted(L["bits"].values()))
        self.emit(res, row, cmp_, "record element")
        total = sum((r["cbits"] or 0) for r in cmp_.rows)
        res.diagrams.append({"type": "bits", "title": f"SMI-105506 DID {did or rtype} record layout",
                             "elements": cmp_.bit_elements(), "length": max(1, (total + 7) // 8) if total else None})


# =============================================================================
#  SMI-1055 / CREQ-1055 Rte_Mode
# =============================================================================
class ModeAnalyzer(BaseAnalyzer):
    key = "SMI-1055"

    def analyze(self, row: RowInput, res: AnalysisResult):
        comp, api = row.component, row.api
        if not api and row.mode_group and comp:
            cands = [a for a in self.rte.comp_apis(comp) if a.startswith("Rte_Mode_") and a.endswith("_" + row.mode_group)]
            api = cands[0] if cands else ""
        if not api:
            self.add(res, "Input", ERROR, note="RTE_API (Rte_Mode_<port>_<group>) or Component + Mode group required")
            return
        R = self.resolve_with_checks(res, comp, api)
        if not R.found:
            return
        comp = R.comp or comp
        an = self.rte.funcs.get(R.func, {})
        mparams = an.get("params", "") if an else ""
        n = len([p for p in split_top(mparams) if p.strip() and p.strip() != "void"]) if mparams else len(R.params)
        variant = "CREQ-1052 (current, previous, next mode)" if n >= 2 else "CREQ-1055 (current mode)"
        self.add(res, "RTE provides Rte_Mode service", PASS, "service returning the active mode", variant)
        mm = [r for r in an.get("reads", []) if self.rte.is_global(r) and "mode" in r.lower()]
        if mm:
            self.add(res, "Returns mode machine state", PASS, "returns RTE mode machine instance", ", ".join(mm),
                     evidence=[self.func_ev(R.func, f"{R.api} -> {mm[0]}")])
        else:
            self.add(res, "Returns mode machine state", REVIEW, "returns RTE mode machine instance",
                     "mode machine variable not identified")
        mgrs, seenf = [], set()
        for v in mm:
            for f, line in self.rte.writers.get(v, []):
                if INIT_FUNC_RE.match(f) or f.startswith("TASK(") or f in seenf:
                    continue
                seenf.add(f)
                mgrs.append((f, line, v))
        mgr_comps = sorted({self.rte.comp_of(f)[0] for f, _, _ in mgrs})
        ev = [self.func_ev(f, f"mode switch in {f}", l) for f, l, _ in mgrs[:3]]
        if mgrs:
            self.add(res, "Mode manager switches the mode (Rte_Switch)", PASS, "Rte_Switch writes the mode machine",
                     ", ".join(f"{self.rte.comp_of(f)[0]}:{self.rte.comp_of(f)[1]}" for f, _, _ in mgrs[:4]), evidence=ev)
        else:
            self.add(res, "Mode manager switches the mode (Rte_Switch)", FAIL, "Rte_Switch writes the mode machine",
                     "no writer found", "Mode never switched - Rte_Mode would always return the initial mode.")
        if row.src_component:
            ok = row.src_component.lower() in [c.lower() for c in mgr_comps]
            self.add(res, "Expected mode manager", PASS if ok else FAIL, row.src_component, ", ".join(mgr_comps) or "-")
        groups = self.rte.mode_groups_of(comp)
        group = row.mode_group if row.mode_group in groups else ""
        if not group and groups:
            group = max(groups, key=lambda g: (api.endswith("_" + g), similarity(api.split("_")[-1], g)))
        trans = f"RTE_TRANSITION_{group}" if group else "RTE_TRANSITION_"
        tfuncs = [f for f in [R.func] + [m[0] for m in mgrs]
                  if trans in " ".join(self.rte.funcs.get(f, {}).get("reads", []))]
        self.add(res, "Mode transition handling", PASS if tfuncs else INFO, f"{trans} handled",
                 ", ".join(tfuncs) or "not referenced in Rte_Mode/Rte_Switch",
                 "" if tfuncs else "During a transition Rte_Mode may return the transition value.")
        uv = self.rte.mode_values(comp, group) if group else {}
        rows = []
        for mc in mgr_comps:
            if mc not in self.rte.components:
                continue
            mv = self.rte.mode_values(mc, group)
            allm = sorted(set(uv) | set(mv))
            for m in allm:
                rows.append([group, m, uv.get(m, ("-",))[0], mv.get(m, ("-",))[0],
                             "OK" if m in uv and m in mv and uv[m][0] == mv[m][0] else "DIFF"])
            diff = [r for r in rows if r[-1] == "DIFF"]
            if not uv or not mv:
                self.add(res, "Mode declaration group consistent", REVIEW, f"{group} identical in {comp} and {mc}",
                         f"user {len(uv)} modes, manager {len(mv)} modes")
            else:
                self.add(res, "Mode declaration group consistent", FAIL if diff else PASS,
                         f"{group} identical in {comp} and {mc}",
                         f"{len(uv)} modes" + (f", {len(diff)} differ" if diff else ""),
                         evidence=[self.idx.ev(v[1], v[2], title=f"RTE_MODE_{group}_{k}") for k, v in list(uv.items())[:1]])
        self.table(res, "Mode values (user vs manager)", ["Group", "Mode", f"{comp}", "Manager", "Result"], rows)
        if row.mode:
            exp = split_list(row.mode)
            missing = [m for m in exp if m not in uv]
            self.add(res, "Expected modes defined", PASS if not missing else FAIL, ", ".join(exp),
                     ", ".join(sorted(uv)) or "-", f"missing {missing}" if missing else "")
        ax = self.ctx.arxml
        if ax.mode_groups and group:
            g = ax.find("mode_groups", group, fuzzy=False)
            if g:
                names = {m for m, _ in g[1]["modes"]}
                miss = names ^ set(uv)
                self.add(res, "ARXML mode declaration group", FAIL if miss and uv else PASS,
                         f"{len(names)} modes in ARXML", f"{len(uv)} modes in RTE", f"difference {sorted(miss)}" if miss else "")
        res.diagrams.append({"type": "connection", "title": f"CREQ-1055 Rte_Mode: {R.api}",
                             "left": [f"{c}\nRte_Switch" for c in mgr_comps] or ["?"],
                             "center": "\n".join(mm[:1]) or "mode machine", "right": [f"{comp}\n{R.api}"],
                             "highlight": comp})


