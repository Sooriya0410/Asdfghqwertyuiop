        def _smi_key(self) -> str:
            v = self.cb_smi.get()
            return v.split("  -  ")[0].strip() if v else "SMI-324_NQ"

        def _smi_changed(self):
            key = self._smi_key()
            spec = SMI_SPECS[key]
            self.txt_req.configure(state="normal")
            self.txt_req.delete("1.0", "end")
            self.txt_req.insert("end", spec.requirement + "\n\n" + spec.guidance)
            self.txt_req.configure(state="disabled")
            for w in self.fields_frame.winfo_children():
                w.destroy()
            self.field_widgets = {}
            row_i = 0
            for fld in spec.fields:
                row_i = self._add_field(fld, spec, row_i)
            if spec.optional:
                if not hasattr(self, "var_adv"):
                    self.var_adv = tk.BooleanVar(value=False)
                ttk.Checkbutton(self.fields_frame, text="Optional expectations (turn REVIEW into PASS/FAIL)",
                                variable=self.var_adv, command=self._smi_changed).grid(
                    row=row_i, column=0, columnspan=2, sticky="w", pady=(10, 2))
                row_i += 1
                if self.var_adv.get():
                    for fld in spec.optional:
                        row_i = self._add_field(fld, spec, row_i)
            self._refresh_choices()

        def _add_field(self, fld: str, spec: SmiSpec, row_i: int) -> int:
            lbl, hint = FIELD_LABELS[fld]
            req = any(fld in r.split("|") for r in spec.required)
            ttk.Label(self.fields_frame, text=lbl + (" *" if req else "")).grid(row=row_i, column=0, sticky="w", pady=(4, 0))
            var = self.field_vars[fld]
            if fld in ("component", "src_component", "dst_component", "api", "src_api", "dst_api", "runnable", "task",
                       "call_target"):
                w = FilterCombobox(self.fields_frame, textvariable=var)
                w.bind("<<ComboboxSelected>>", lambda e: self._refresh_choices())
                w.bind("<FocusOut>", lambda e: self._refresh_choices())
            elif fld == "trigger":
                w = ttk.Combobox(self.fields_frame, textvariable=var, values=TRIGGER_CHOICES)
            elif fld == "endianness":
                w = ttk.Combobox(self.fields_frame, textvariable=var, values=["", "Intel (Little)", "Motorola (Big)"])
            elif fld == "safety":
                w = ttk.Combobox(self.fields_frame, textvariable=var, values=["Yes", "No"], state="readonly")
                if not var.get():
                    var.set("Yes")
            else:
                w = ttk.Entry(self.fields_frame, textvariable=var)
            w.grid(row=row_i, column=1, sticky="ew", pady=(4, 0), padx=(8, 0))
            ttk.Label(self.fields_frame, text=hint, style="Muted.TLabel", font=(self.f_base[0], 8)).grid(
                row=row_i + 1, column=1, sticky="w", padx=(8, 0))
            self.field_widgets[fld] = w
            return row_i + 2

        def _refresh_choices(self):
            """Fill every dropdown from the indexed sandbox, depending on SMI and already selected values."""
            ctx = self.engine.ctx
            if not ctx:
                return
            rte = ctx.rte
            key = self._smi_key()
            comps = sorted(rte.components)
            v = {f: self.field_vars[f].get().strip() for f in self.field_vars}

            def apis_of(comp, kinds=None):
                lst = rte.comp_apis(comp) if comp in rte.components else \
                    sorted({a for c in rte.components for a in rte.comp_apis(c)})
                return [a for a in lst if not kinds or api_kind(a) in kinds] or lst

            def setv(fld, vals):
                w = self.field_widgets.get(fld)
                if isinstance(w, FilterCombobox):
                    w.set_values(vals)

            for f in ("component", "src_component", "dst_component"):
                setv(f, comps)
            if key == "SMI-324_NQ":
                setv("src_api", apis_of(v["src_component"], {"Write", "IWrite", "IWriteRef"}))
                setv("dst_api", apis_of(v["dst_component"], {"Read", "IRead", "DRead"}))
                if v["src_api"] and not v["dst_component"] and v["src_component"] in rte.components:
                    P = rte.sr_partners(rte.resolve(v["src_component"], v["src_api"]))
                    setv("dst_component", list(dict.fromkeys(p.comp for p in P["receivers"])) + comps)
            elif key == "SMI-324_CS":
                setv("api", apis_of(v["src_component"], {"Call", "Result"}))
                if v["api"]:
                    R = rte.resolve(v["src_component"], v["api"])
                    T = rte.server_targets(R)
                    an = rte.funcs.get(R.func, {})
                    cands = T["servers"] + [c for c, _ in T["calls"] if not c.startswith(("Rte_", "Suspend", "Resume"))]
                    cands += [g for g in an.get("reads", []) if rte.is_global(g)]
                    setv("call_target", list(dict.fromkeys(cands)))
            elif key == "SMI-2063":
                runs = sorted(rte.runnables.get(v["component"], {})) if v["component"] in rte.components \
                    else sorted(rte.runnable_owner)
                setv("runnable", runs)
                tasks = sorted(rte.tasks)
                if v["runnable"]:
                    called = [f[5:-1].strip() for f, _ in rte.call_sites(v["runnable"]) if f.startswith("TASK(")]
                    tasks = list(dict.fromkeys(called + tasks))
                setv("task", tasks)
            elif key == "SMI-1055":
                setv("api", apis_of(v["component"], {"Mode"}))
            elif key == "SMI-105506":
                setv("api", apis_of(v["component"]) + sorted(rte.runnables.get(v["component"], {})))
            elif key == "SMI-2123":
                first = split_list(v["component"])[0] if v["component"] else ""
                setv("api", apis_of(first, READ_KINDS | WRITE_KINDS) + sorted(ctx.idx.rte_globals))
            else:
                setv("api", apis_of(v["component"]))

        def _row_from_form(self) -> RowInput:
            r = RowInput(row_id=f"S{len(self.results) + 1:03d}")
            key = self._smi_key()
            spec = SMI_SPECS[key]
            r.smi, r.smi_raw = key, key
            flds = list(spec.fields) + (list(spec.optional) if getattr(self, "var_adv", None) is not None
                                        and self.var_adv.get() else [])
            for fld in flds:
                setattr(r, fld, self.field_vars[fld].get().strip())
            if r.endianness:
                r.endianness = "Big" if "big" in r.endianness.lower() or "motorola" in r.endianness.lower() else "Little"
            return r

