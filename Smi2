PALETTE = [(78, 121, 167), (242, 142, 43), (225, 87, 89), (118, 183, 178), (89, 161, 79), (237, 201, 72),
           (176, 122, 161), (255, 157, 167), (156, 117, 95), (186, 176, 172), (31, 119, 180), (148, 103, 189)]
_FONT_DIRS = [os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts"), "/usr/share/fonts/truetype/dejavu",
              "/usr/share/fonts/truetype/liberation", "/usr/share/fonts/TTF", "/usr/share/fonts",
              "/Library/Fonts", "/System/Library/Fonts"]


class PictureRenderer:
    def __init__(self):
        self.mono = self._font(["consola.ttf", "DejaVuSansMono.ttf", "LiberationMono-Regular.ttf", "cour.ttf"], 14)
        self.mono_b = self._font(["consolab.ttf", "DejaVuSansMono-Bold.ttf", "LiberationMono-Bold.ttf", "courbd.ttf"], 14)
        self.sans = self._font(["segoeui.ttf", "arial.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"], 15)
        self.sans_s = self._font(["segoeui.ttf", "arial.ttf", "DejaVuSans.ttf", "LiberationSans-Regular.ttf"], 13)
        self.sans_b = self._font(["segoeuib.ttf", "arialbd.ttf", "DejaVuSans-Bold.ttf", "LiberationSans-Bold.ttf"], 15)
        self.title = self._font(["segoeuib.ttf", "arialbd.ttf", "DejaVuSans-Bold.ttf", "LiberationSans-Bold.ttf"], 21)

    @staticmethod
    def _font(names, size):
        for n in names:
            try:
                return ImageFont.truetype(n, size)
            except Exception:
                pass
        for d in _FONT_DIRS:
            if not os.path.isdir(d):
                continue
            for root, _, files in os.walk(d):
                low = {f.lower(): f for f in files}
                for n in names:
                    if n.lower() in low:
                        try:
                            return ImageFont.truetype(os.path.join(root, low[n.lower()]), size)
                        except Exception:
                            pass
                if root.count(os.sep) - d.count(os.sep) > 2:
                    break
        try:
            return ImageFont.load_default(size=size)
        except TypeError:  # Pillow < 10.1
            return ImageFont.load_default()

    @staticmethod
    def _w(text: str, font) -> float:
        try:
            return font.getlength(text)
        except Exception:
            return len(text) * 8

    def _h(self, font) -> int:
        try:
            b = font.getbbox("Ag|")
            return b[3] - b[1]
        except Exception:
            return 14

    @staticmethod
    def _save(img, path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            img.quantize(colors=128, method=Image.Quantize.FASTOCTREE).save(path, compress_level=6)
        except Exception:
            img.save(path)

    def _pill(self, d, x, y, status):
        col = STATUS_RGB.get(status, (120, 120, 120))
        w = self._w(status, self.sans_b) + 22
        d.rounded_rectangle([x, y, x + w, y + 26], radius=13, fill=col)
        d.text((x + 11, y + 4), status, font=self.sans_b, fill="white")
        return w

    def _clip(self, text: str, font, maxw: float) -> str:
        if self._w(text, font) <= maxw:
            return text
        while text and self._w(text + "...", font) > maxw:
            text = text[:-1]
        return text + "..."

    # ------------------------------------------------------------ code
    _TOK = re.compile(r"(//.*$|/\*.*?(?:\*/|$)|\bRte_\w+|\bRTE_\w+|\b(?:Com|ComXf|DiagXf|E2EXf|E2E|Dcm)_\w+|"
                      r"\b(?:if|else|for|while|return|switch|case|void|static|extern|const|TASK|FUNC|VAR|"
                      r"P2VAR|P2CONST|define|include)\b|\"[^\"]*\")")

    def code_snippet(self, ev: Evidence, path: str, status: str, title: str):
        lines = ev.snippet or []
        if not lines:
            return None
        lh = self._h(self.mono) + 7
        maxlen = max((self._w(t, self.mono) for _, t in lines), default=400)
        gut = 72
        W = int(max(960, min(2200, gut + maxlen + 40)))
        H = 78 + lh * len(lines) + 16
        img = Image.new("RGB", (W, H), (252, 252, 253))
        d = ImageDraw.Draw(img)
        d.rectangle([0, 0, W, 66], fill=(31, 41, 55))
        d.text((16, 8), self._clip(title, self.title, W - 220), font=self.title, fill="white")
        sub = f"{ev.file}  (line {ev.line}{'-' + str(ev.end_line) if ev.end_line and ev.end_line != ev.line else ''})"
        d.text((16, 40), self._clip(f"{ev.title}   |   {sub}", self.sans_s, W - 220), font=self.sans_s, fill=(203, 213, 225))
        self._pill(d, W - 120, 20, status)
        y = 74
        d.rectangle([0, 70, gut - 8, H], fill=(238, 240, 243))
        hl = set(ev.highlight or ())
        for n, text in lines:
            if n in hl:
                d.rectangle([gut - 8, y - 2, W, y + lh - 3], fill=(255, 239, 160))
                d.rectangle([gut - 8, y - 2, gut - 4, y + lh - 3], fill=STATUS_RGB.get(status, (219, 154, 4)))
            ns = str(n)
            d.text((gut - 16 - self._w(ns, self.mono), y), ns, font=self.mono, fill=(140, 148, 160))
            x = gut + 4
            pos = 0
            for m in self._TOK.finditer(text):
                if m.start() > pos:
                    seg = text[pos:m.start()]
                    d.text((x, y), seg, font=self.mono, fill=(30, 30, 30))
                    x += self._w(seg, self.mono)
                tok = m.group(0)
                if tok.startswith(("//", "/*")):
                    col, f = (34, 139, 34), self.mono
                elif tok.startswith('"'):
                    col, f = (163, 21, 21), self.mono
                elif tok.startswith(("Rte_", "RTE_")):
                    col, f = (111, 66, 193), self.mono_b
                elif "_" in tok:
                    col, f = (0, 110, 160), self.mono_b
                else:
                    col, f = (0, 70, 200), self.mono_b
                d.text((x, y), tok, font=f, fill=col)
                x += self._w(tok, f)
                pos = m.end()
            if pos < len(text):
                d.text((x, y), text[pos:], font=self.mono, fill=(30, 30, 30))
            y += lh
        self._save(img, path)
        return path

    # ------------------------------------------------------------ summary card
