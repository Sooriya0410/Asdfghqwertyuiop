        ws.add_data_validation(dv)
        dv.add("B2:B5000")
    except Exception:
        pass
    for j, (c, _) in enumerate(TEMPLATE_COLUMNS, 1):
        ws.column_dimensions[get_column_letter(j)].width = max(16, len(c) + 4)
    for col in ("D", "F", "H"):
