def run_selftest(keep: bool = False, out: str = "") -> int:
    print(f"{TOOL_NAME} {TOOL_VERSION} self test  (lxml={HAVE_LXML}, Pillow={HAVE_PIL})")
    tmp = tempfile.mkdtemp(prefix="smi_selftest_")
    sandbox = os.path.join(tmp, "sandbox")
    out = out or os.path.join(tmp, "results")
    build_selftest_sandbox(sandbox)
    req = os.path.join(tmp, "requests.xlsx")
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.append([h for h, _ in SELFTEST_HEADERS])
    for rid, smi, inp, _ in SELFTEST_ROWS:
        vals = dict(inp, id=rid, smi=smi, remarks="selftest")
        ws.append([vals.get(f, "") for _, f in SELFTEST_HEADERS])
    wb.save(req)
    rows, mapping, warns = read_request_excel(req)
    assert len(rows) == len(SELFTEST_ROWS), "batch reader row count"
    for fld, hdr in (("smi", "SMI Type"), ("component", "Components"), ("api", "RTE"), ("src_api", "Write API"),
                     ("dst_api", "Read API"), ("call_target", "Call function or variable"), ("task", "Task")):
        assert mapping.get(fld) == hdr, f"column mapping {fld}: {mapping.get(fld)}"
    # alternative layout: one sheet per SMI, no SMI column
    req2 = os.path.join(tmp, "requests_per_sheet.xlsx")
    wb2 = openpyxl.Workbook()
    w1 = wb2.active
    w1.title = "SMI-2063"
    w1.append(["Runnable", "Task"])
    w1.append(["RE_Speed_10ms", "OsTask_App_10ms"])
    w2 = wb2.create_sheet("324 Non Queued")
    w2.append(["Component Source", "Write API", "Component Destination", "Read API"])
    w2.append(["CtApSpeed", "Rte_Write_PpSpeed_DeSpeed", "CtApDisplay", "Rte_Read_RpSpeed_DeSpeed"])
    wb2.save(req2)
    rows2, _, _ = read_request_excel(req2)
    assert [r.smi for r in rows2] == ["SMI-2063", "SMI-324_NQ"], [r.smi for r in rows2]
    assert rows2[1].src_api == "Rte_Write_PpSpeed_DeSpeed" and rows2[1].dst_component == "CtApDisplay"
    s = Settings(workers=2, use_cache=False, strict=True)
    logs = []
    eng = SmiEngine(s, log=lambda lvl, msg: logs.append((lvl, msg)))
    t0 = time.perf_counter()
    st = eng.load(sandbox)
    assert st["components"] >= 10, f"components found: {st['components']}"
    run = eng.run(rows + rows2, out)
    dt = time.perf_counter() - t0
    fails = 0
    expected = [e for *_, e in SELFTEST_ROWS] + [PASS, PASS]
    ids = [r[0] for r in SELFTEST_ROWS] + ["S01", "S02"]
    print(f"\n{'ID':<5} {'SMI':<11} {'Item':<62} {'Expected':<8} {'Got':<8}")
    for res, rid, exp in zip(run["results"], ids, expected):
        ok = res.status == exp
        fails += 0 if ok else 1
        print(f"{rid:<5} {res.smi:<11} {res.row.label()[:62]:<62} {exp:<8} {res.status:<8} {'ok' if ok else '<-- MISMATCH'}")
        if not ok:
            for c in res.checks:
                print(f"        {c.status:<7} {c.name}: {c.actual} {c.note}")
    pics = sum(len(r.pictures) for r in run["results"])
    for smi, p in run["workbooks"].items():
        assert os.path.isfile(p), p
    assert os.path.isfile(run["master"])
    tpl = os.path.join(tmp, "template.xlsx")
    write_template(tpl)
    trows, _, _ = read_request_excel(tpl)
    assert len(trows) == 8 and all(r.smi for r in trows), "template round trip"
    folders = sorted(d for d in os.listdir(out) if os.path.isdir(os.path.join(out, d)))
    print(f"\nFolders: {folders}")
    print(f"Pictures: {pics}   Workbooks: {len(run['workbooks'])}   Time: {dt:.1f}s   Index: {st}")
    warn = [m for l, m in logs if l in ("WARN", "ERROR")]
    if warn:
        print("Warnings:\n  " + "\n  ".join(warn[:10]))
    print(f"\nRESULT: {'PASSED' if not fails else f'FAILED ({fails} mismatches)'}   output: {out}")
    if not keep and not fails:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0 if not fails else 1


# =============================================================================
#  CLI
# =============================================================================
def main(argv: Optional[List[str]] = None) -> int:
    multiprocessing.freeze_support()
    ap = argparse.ArgumentParser(prog="smi_analyzer", description=f"{TOOL_NAME} {TOOL_VERSION} - MICROSAR Safe SMI "
                                                                  f"verification (offline)")
    ap.add_argument("--sandbox", help="sandbox root folder")
    ap.add_argument("--out", help="output folder (one sub folder per SMI is created)")
    ap.add_argument("--excel", help="batch request Excel (needs an SMI type column)")
    ap.add_argument("--sheet", help="sheet name of the request Excel")
    ap.add_argument("--smi", help="single check: SMI type (e.g. SMI-324_NQ, 2063, 324-client-server)")
    for f in FIELD_LABELS:
        ap.add_argument(f"--{f.replace('_', '-')}", dest=f, default="")
    ap.add_argument("--strict", choices=["on", "off"], default=None, help="deviations from Vector recommendations -> FAIL")
    ap.add_argument("--no-pictures", action="store_true")
    ap.add_argument("--no-cache", action="store_true")
    ap.add_argument("--workers", type=int, default=0)
    ap.add_argument("--template", help="write a batch request template to this .xlsx and exit")
    ap.add_argument("--selftest", action="store_true", help="run the built-in self test")
    ap.add_argument("--keep", action="store_true", help="keep self test files")
    ap.add_argument("--gui", action="store_true", help="force GUI")
    a = ap.parse_args(argv)
    if not HAVE_OPENPYXL:
        print("openpyxl is required:  pip install openpyxl pillow")
        return 2
    if a.selftest:
        return run_selftest(a.keep, a.out or "")
    if a.template:
        write_template(a.template)
        print(f"Template written: {a.template}")
        return 0
    if a.gui or not (a.sandbox and a.out and (a.excel or a.smi)):
        return launch_gui()
    s = Settings.load()
    if a.strict:
        s.strict = a.strict == "on"
    if a.no_pictures:
        s.pictures = False
    if a.no_cache:
        s.use_cache = False
    if a.workers:
        s.workers = a.workers

    def log(lvl, msg):
        print(f"[{lvl:<6}] {msg}", flush=True)
    eng = SmiEngine(s, log=log, progress=lambda d, t, m: None)
    eng.load(a.sandbox)
    if a.excel:
        rows, mapping, warns = read_request_excel(a.excel, a.sheet)
        for w in warns:
            log("WARN", w)
        log("INFO", f"Column mapping: {mapping}")
    else:
        r = RowInput(row_id="S001", smi_raw=a.smi)
        for f in FIELD_LABELS:
            setattr(r, f, getattr(a, f) or "")
        r.smi = normalize_smi(a.smi, r.api)
        rows = [r]
    res = eng.run(rows, a.out)
    print(f"Master report: {res['master']}")
    return 0 if not res["counts"].get(ERROR) else 3


if __name__ == "__main__":
    sys.exit(main())
